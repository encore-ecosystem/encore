import core::fmt::Debug
import core::io::eprint
import core::io::eprintln

fn esc() -> str { ret "\x1b[" }
fn reset_code() -> str { ret esc() + "0m" }

pub fn reset() -> str {
    ret reset_code()
}

pub fn code(raw: str) -> str {
    ret esc() + raw + "m"
}

pub fn style(text: str, raw: str) -> str {
    ret code(raw) + text + reset_code()
}

pub fn bold(text: str) -> str { ret style(text, "1") }
pub fn dim(text: str) -> str { ret style(text, "2") }
pub fn italic(text: str) -> str { ret style(text, "3") }
pub fn underline(text: str) -> str { ret style(text, "4") }

pub fn black(text: str) -> str { ret style(text, "30") }
pub fn red(text: str) -> str { ret style(text, "31") }
pub fn green(text: str) -> str { ret style(text, "32") }
pub fn yellow(text: str) -> str { ret style(text, "33") }
pub fn blue(text: str) -> str { ret style(text, "34") }
pub fn magenta(text: str) -> str { ret style(text, "35") }
pub fn cyan(text: str) -> str { ret style(text, "36") }
pub fn white(text: str) -> str { ret style(text, "37") }

pub fn bg_red(text: str) -> str { ret style(text, "41") }
pub fn bg_green(text: str) -> str { ret style(text, "42") }
pub fn bg_yellow(text: str) -> str { ret style(text, "43") }
pub fn bg_blue(text: str) -> str { ret style(text, "44") }

pub fn rgb(text: str, r: u8, g: u8, b: u8) -> str {
    let raw = "38;2;" + Debug::fmt(r) + ";" + Debug::fmt(g) + ";" + Debug::fmt(b)
    ret style(text, raw)
}

pub fn eprintln_error(message: str) -> () {
    eprintln(red("error: ") + message)
    ret ()
}

pub fn eprintln_note(message: str) -> () {
    eprintln(cyan("note: ") + message)
    ret ()
}

pub fn eprint_error(message: str) -> () {
    eprint(red("error: ") + message)
    ret ()
}
