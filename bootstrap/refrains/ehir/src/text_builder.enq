import std::vec::Vec
import core::option::Option

pub struct EhirTextBuilder {
    lines: Vec[str]
}

impl for EhirTextBuilder {
    pub fn new() -> EhirTextBuilder {
        ret EhirTextBuilder{Vec[str]::new()}
    }

    pub fn line(self: EhirTextBuilder, value: str) -> EhirTextBuilder {
        ret EhirTextBuilder{self.lines.push(value)}
    }

    pub fn empty_line(self: EhirTextBuilder) -> EhirTextBuilder {
        ret self.line("")
    }

    pub fn label(self: EhirTextBuilder, name: str) -> EhirTextBuilder {
        ret self.line("  $" + name + ":")
    }

    pub fn instr(self: EhirTextBuilder, value: str) -> EhirTextBuilder {
        ret self.line("    " + value)
    }

    pub fn append(self: EhirTextBuilder, other: EhirTextBuilder) -> EhirTextBuilder {
        let mut out = self
        let mut i = 0_usize
        loop {
            match other.lines.get(i) {
                Option[str]::Some(line) => {
                    out = out.line(line)
                    i = i + 1_usize
                }
                Option[str]::None => {
                    break
                }
            }
        }
        ret out
    }

    pub fn finish(self: EhirTextBuilder) -> str {
        let mut out = ""
        let mut i = 0_usize
        loop {
            match self.lines.get(i) {
                Option[str]::Some(line) => {
                    out = out + line + "\n"
                    i = i + 1_usize
                }
                Option[str]::None => {
                    break
                }
            }
        }
        ret out
    }
}
