import std::path::Path
import core::fmt::Debug

pub enum TargetType {
    AUTO
    EXECUTABLE
    OBJECT
    SHARED
}

impl Debug for TargetType {
    pub fn fmt(self: TargetType) -> str {
        ret match self {
            AUTO => "auto"
            EXECUTABLE => "executable"
            OBJECT => "object"
            SHARED => "shared"
        }
    }
}

pub struct Refrain {
    name: str
    path: Path
    target: TargetType
}

impl for Refrain {
    pub fn new(name: str, path: Path, target: TargetType) -> Refrain {
        ret Refrain{name, path, target}
    }
}
