import std::path::Path
import core::option::Option
import std::vec::Vec

pub struct CacheEntry {
    key: str
    artifact_path: Path
}

pub struct BuildCache {
    entries: Vec[CacheEntry]
}

impl for BuildCache {
    pub fn new() -> BuildCache {
        ret BuildCache{Vec[CacheEntry]::new()}
    }

    pub fn get(self, key: str) -> Option[Path] {
        let mut index = 0_usize
        loop {
            match self.entries.get(index) {
                Option[CacheEntry]::Some(entry) => {
                    if entry.key == key {
                        ret Option[Path]::Some(entry.artifact_path)
                    }
                    index = index + 1_usize
                }
                Option[CacheEntry]::None => {
                    break
                }
            }
        }
        ret Option[Path]::None
    }

    pub fn put(mut self, key: str, artifact_path: Path) -> BuildCache {
        self.entries = self.entries.push(CacheEntry{key, artifact_path})
        ret self
    }
}
