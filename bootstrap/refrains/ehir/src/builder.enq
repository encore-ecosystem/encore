import std::path::Path
import core::option::Option
import mod::refrain::Refrain

pub struct BuildRequest {
    project_root: Path
    output_dir: Path
    use_cache: bool
}

pub struct BuildOutput {
    success: bool
    executable: Option[Path]
}

pub struct Builder {}

impl for Builder {
    pub fn new() -> Builder {
        ret Builder{}
    }

    pub fn build(self, request: BuildRequest, main_refrain: Refrain) -> BuildOutput {
        if request.use_cache && main_refrain.name == "" {
            ret BuildOutput{false, Option[Path]::None}
        }
        // Stage 1: contracts only. Full Python parity is implemented incrementally.
        ret BuildOutput{false, Option[Path]::None}
    }
}
