import std::path::Path
import core::option::Option
import mod::refrain::Refrain

pub struct BuildRequest {
    project_root: Path
    output_dir: Path
    use_cache: bool
}

pub struct PipelineBuildOutput {
    success: bool
    executable: Option[Path]
}

pub struct PipelineBuilder {}

impl for PipelineBuilder {
    pub fn new() -> PipelineBuilder {
        ret PipelineBuilder{}
    }

    pub fn build(self, request: BuildRequest, main_refrain: Refrain) -> PipelineBuildOutput {
        if request.use_cache && main_refrain.name == "" {
            ret PipelineBuildOutput{false, Option[Path]::None}
        }
        // Stage 1: contracts only. Full Python parity is implemented incrementally.
        ret PipelineBuildOutput{false, Option[Path]::None}
    }
}
