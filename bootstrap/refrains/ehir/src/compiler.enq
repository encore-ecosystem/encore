import mod::builder::Builder
import mod::builder::BuildRequest
import mod::builder::BuildOutput
import mod::refrain::Refrain
import mod::cache::BuildCache

pub struct ProjectCompiler {
    builder: Builder
    cache: BuildCache
}

impl for ProjectCompiler {
    pub fn new() -> ProjectCompiler {
        ret ProjectCompiler{Builder::new(), BuildCache::new()}
    }

    pub fn compile(self, request: BuildRequest, root_refrain: Refrain) -> BuildOutput {
        ret self.builder.build(request, root_refrain)
    }
}
