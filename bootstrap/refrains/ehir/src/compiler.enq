import mod::builder::PipelineBuilder
import mod::builder::BuildRequest
import mod::builder::PipelineBuildOutput
import mod::refrain::Refrain
import mod::cache::BuildCache

pub struct ProjectCompiler {
    builder: PipelineBuilder
    cache: BuildCache
}

impl for ProjectCompiler {
    pub fn new() -> ProjectCompiler {
        ret ProjectCompiler{PipelineBuilder::new(), BuildCache::new()}
    }

    pub fn compile(self, request: BuildRequest, root_refrain: Refrain) -> PipelineBuildOutput {
        ret self.builder.build(request, root_refrain)
    }
}
