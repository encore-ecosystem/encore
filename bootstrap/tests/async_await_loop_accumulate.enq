import core::testing::*
import std::asyncio
import core::time

async fn main() -> u32 {
    let seq_start = time::perf_counter_ms()
    await asyncio::sleep(25_u64)
    await asyncio::sleep(25_u64)
    let seq_elapsed = time::perf_counter_ms() - seq_start

    let par_start = time::perf_counter_ms()
    await asyncio::parallel_sleep(25_u64, 25_u64)
    let par_elapsed = time::perf_counter_ms() - par_start

    if !assert(seq_elapsed >= 44_u64) {
        ret 1_u32
    }
    if !assert(par_elapsed >= 20_u64) {
        ret 1_u32
    }
    if !assert(par_elapsed + 10_u64 < seq_elapsed) {
        ret 1_u32
    }
    ret 0_u32
}
