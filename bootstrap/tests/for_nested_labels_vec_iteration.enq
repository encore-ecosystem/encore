import core::testing::*
import core::vec::Vec

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(4_u32)
    values.push(5_u32)
    values.push(6_u32)

    let mut weighted = 0_u32
    let mut weight = 0_u32
    for item in values {
        weighted = weighted + item * weight
        weight = weight + 1_u32
    }
    if !assert(weighted == 17_u32) {
        ret 1_u32
    }

    let mut seen = 0_usize
    let mut sum = 0_usize
    for<'outer> x in 0..4 {
        for y in 0..4 {
            if x == 1_usize && y == 0_usize {
                continue<'outer>
            }
            if x == 2_usize && y == 1_usize {
                break<'outer>
            }
            seen = seen + 1_usize
            sum = sum + x * 10_usize + y
        }
    }

    if !assert(seen == 5_usize) {
        ret 1_u32
    }
    if !assert(sum == 26_usize) {
        ret 1_u32
    }
    ret 0_u32
}
