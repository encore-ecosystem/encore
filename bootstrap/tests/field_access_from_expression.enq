import core::testing::*

struct Pair(u32, u32)

fn make_pair(left: u32, right: u32) -> Pair {
    ret Pair { left, right }
}

fn main() -> u32 {
    let first = (make_pair(20_u32, 22_u32)).0
    let second = (if first == 20_u32 { make_pair(1_u32, 2_u32) } else { make_pair(3_u32, 4_u32) }).1

    if !assert(first + second == 22_u32) {
        ret 1_u32
    }
    ret 0_u32
}
