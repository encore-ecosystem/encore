import core::testing::*
import core::vec::Vec

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(3_u32)
    values.push(5_u32)
    values.push(8_u32)

    let mut sum = 0_u32
    for item in values {
        sum = sum + item
    }

    if !assert(sum == 16_u32) {
        ret 1_u32
    }
    ret 0_u32
}
