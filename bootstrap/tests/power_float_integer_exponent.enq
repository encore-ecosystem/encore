import core::testing::*

fn cos_series_term(x_n: f32) -> f32 {
    ret -1 + (x_n ** 2) / 2 - (x_n ** 4) / 24 + (x_n ** 6) / 720
}

fn main() -> u32 {
    let x = 2.0_f32
    let square = x ** 2
    let cube = x ** 3
    let reciprocal = x ** -2

    if !assert(square == 4.0_f32) {
        ret 1_u32
    }
    if !assert(cube == 8.0_f32) {
        ret 1_u32
    }
    if !assert(reciprocal == 0.25_f32) {
        ret 1_u32
    }
    if !assert(cos_series_term(0.0_f32) == -1.0_f32) {
        ret 1_u32
    }
    ret 0_u32
}
