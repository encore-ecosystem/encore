import core::testing::*

macro_rules! sum3 {
    ($( $x:expr ),+) => ( $($x)+* );
}

macro_rules! make_pair_sum {
    ($a:ident, $b:ident) => ($a + $b);
}

fn main() -> u32 {
    let a = 10_u32
    let b = 12_u32
    let c = 20_u32
    let s = sum3!(a, b, c)
    if !assert(s == 42_u32) {
        ret 1_u32
    }
    let p = make_pair_sum!(a, b)
    if !assert(p == 22_u32) {
        ret 1_u32
    }
    ret 0_u32
}
