import core::testing::*

macro_rules! add_one {
    ($x:expr) => ($x + 1_u32);
}

macro_rules! twice_ident {
    ($x:ident) => ($x + $x);
}

fn main() -> u32 {
    let forty_one = 41_u32
    let answer = add_one!(forty_one)
    if !assert(answer == 42_u32) {
        ret 1_u32
    }

    let value = 21_u32
    let doubled = twice_ident!(value)
    if !assert(doubled == 42_u32) {
        ret 1_u32
    }

    ret 0_u32
}
