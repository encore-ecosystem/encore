import core::testing::*
import core::option::Option

fn unwrap_or(opt: Option[u32], default: u32) -> u32 {
    match opt {
        Some(value) => {
            ret value
        }
        None => {
            ret default
        }
    }
}

fn main() -> u32 {
    let lhs = unwrap_or(Option[u32]::Some(9_u32), 0_u32)
    let rhs = unwrap_or(Option[u32]::None, 4_u32)

    if !assert(lhs + rhs == 13_u32) {
        ret 1_u32
    }
    ret 0_u32
}
