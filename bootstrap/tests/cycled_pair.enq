enum Option[T] {
    Some(T)
    None
}

struct Node {
    index : usize
    next  : Option[Box[Node]]
}

impl Node {
    pub fn new(index: usize) -> Box[Self] {
        ret Box::wraph(Node(index, Option::None)
    }
}

fn main() -> usize {
    let mut node_1 = Node::new(1)
    let mut node_2 = Node::new(2)

    node_1.next = Option::Some(node_2)
    node_2.next = Option::Some(node_1)

    ret node_1.index + node_2.index
}
