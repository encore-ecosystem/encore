import core::option::Option
import core::testing::*
import core::vec::Vec

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(10_u32)
    values.push(20_u32)

    let iter = values.iter()
    let step = iter.next()

    match step.1 {
        Option::Some(value) => {
            if !assert(value == 10_u32) {
                ret 1_u32
            }
        }
        Option::None => {
            ret 1_u32
        }
    }
    ret 0_u32
}
