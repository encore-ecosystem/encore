import core::testing::*

let SCALE: i32 = 10000
let STEP: i32 = 200
let BASE: u32 = 40

fn projection_y() -> i32 {
    ret 15
}

fn scaled(v: i32) -> i32 {
    ret (v * SCALE + STEP) / SCALE
}

fn plus_base(v: u32) -> u32 {
    ret v + BASE
}

fn main() -> u32 {
    let a = projection_y()
    if !assert(a == 15_i32) {
        ret 1_u32
    }

    let b = scaled(10000)
    if !assert(b == 10000_i32) {
        ret 1_u32
    }

    let c = plus_base(2)
    if !assert(c == 42_u32) {
        ret 1_u32
    }

    ret 0_u32
}
