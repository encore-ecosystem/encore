import core::testing::*
import core::option::Option

enum Slot[T] {
    Filled(T)
    Empty
}

fn option_value(opt: Option[u32], fallback: u32) -> u32 {
    match opt {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
            ret fallback
        }
    }
}

fn slot_value(slot: Slot[i32]) -> i32 {
    match slot {
        Slot::Filled(value) => {
            ret value
        }
        Slot::Empty => {
            ret 0_i32
        }
    }
}

fn main() -> u32 {
    let a = option_value(Option[u32]::Some(37_u32), 5_u32)
    let b = option_value(Option[u32]::None, 5_u32)
    let c = slot_value(Slot[i32]::Filled(11_i32))
    let d = slot_value(Slot[i32]::Empty)

    if !assert(a + b == 42_u32) {
        ret 1_u32
    }
    if !assert(c + d == 11_i32) {
        ret 1_u32
    }
    ret 0_u32
}
