import core::testing::*

fn main() -> u32 {
    let result = unsafe {
        unsafe ehir {
            base: u32* = halloc u32
            value: u32 = lcpos 11_u32
            store value: u32, base: u32*
            idx: usize = lcpos 0_usize
            elem_ptr: u32* = gep base: u32*, idx: usize
            loaded: u32 = load elem_ptr: u32*
            hfree base: u32*
        }
        loaded
    }

    if !assert(result == 11_u32) {
        ret 1_u32
    }
    ret 0_u32
}
