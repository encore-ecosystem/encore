import core::testing::*

fn main() -> u32 {
    let a = 7_u32
    let b = 35_u32

    let s1 = format!("sum={} a={a} b={#b}", a + b)
    if !assert(s1 == "sum=42 a=7 b=35") {
        ret 1_u32
    }

    let s2 = f"sum={a + b} a={a} b={#b}"
    if !assert(s2 == "sum=42 a=7 b=35") {
        ret 1_u32
    }

    ret 0_u32
}

