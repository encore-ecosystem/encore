import core::testing::*

fn main() -> u32 {
    let a = 7_u16
    let b = a as u32
    let c = b as usize
    let d = c as i32

    if !assert(b == 7_u32) {
        ret 1_u32
    }
    if !assert(c == 7_usize) {
        ret 1_u32
    }
    if !assert(d == 7_i32) {
        ret 1_u32
    }
    ret 0_u32
}

