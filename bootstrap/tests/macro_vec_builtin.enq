import core::testing::*
import core::vec::Vec

fn main() -> u32 {
    let v = vec![3_u32, 5_u32, 8_u32]
    if !assert(v.len() == 3_usize) {
        ret 1_u32
    }
    let mut sum = 0_u32
    for x in v {
        sum = sum + x
    }
    if !assert(sum == 16_u32) {
        ret 1_u32
    }
    ret 0_u32
}
