import core::testing::*
import core::time
import std::asyncio

async fn main() -> u32 {
    let start = time::perf_counter_ms()

    await asyncio::sleep(20_u64)
    await asyncio::sleep(20_u64)

    let elapsed = time::perf_counter_ms() - start

    if !assert(elapsed >= 36_u64) {
        ret 1_u32
    }
    ret 0_u32
}
