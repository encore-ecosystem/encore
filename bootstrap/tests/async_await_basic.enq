import core::testing::*
import core::time
import std::asyncio

async fn delayed_plus_one(x: u32, delay_ms: u64) -> u32 {
    await asyncio::sleep(delay_ms)
    ret x + 1_u32
}

async fn main() -> u32 {
    let start = time::perf_counter_ms()
    let value = await delayed_plus_one(41_u32, 20_u64)
    let elapsed = time::perf_counter_ms() - start

    if !assert(value == 42_u32) {
        ret 1_u32
    }
    if !assert(elapsed >= 18_u64) {
        ret 1_u32
    }
    ret 0_u32
}
