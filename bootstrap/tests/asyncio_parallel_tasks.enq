import core::testing::*
import core::time
import std::asyncio

async fn main() -> u32 {
    let start = time::perf_counter_ms()

    let first = asyncio::spawn_sleep(40_u64)
    let second = asyncio::spawn_sleep(70_u64)
    asyncio::join2(first, second)

    let elapsed = time::perf_counter_ms() - start

    if !assert(elapsed >= 60_u64) {
        ret 1_u32
    }
    if !assert(elapsed < 110_u64) {
        ret 1_u32
    }
    ret 0_u32
}
