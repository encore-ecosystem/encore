import core::testing::*

fn main() -> u32 {
    let s = "a\"b\\c\n"

    if !assert(s.len() == 6_usize) {
        ret 1_u32
    }
    if !assert(s.byte_at(1_usize) == 34_u8) {
        ret 1_u32
    }
    if !assert(s.byte_at(3_usize) == 92_u8) {
        ret 1_u32
    }
    if !assert(s.byte_at(5_usize) == 10_u8) {
        ret 1_u32
    }

    ret 0_u32
}
