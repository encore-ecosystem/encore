import core::fmt::Debug
import core::testing::*
import std::vec::Vec

struct Point {
    x: u32
    y: u32
}

impl Debug for Point {
    pub fn fmt(self: Point) -> str {
        if self.x == 3_u32 && self.y == 4_u32 {
            ret "Point(3,4)"
        }
        ret "Point(?)"
    }
}

fn main() -> u32 {
    let a: str = Debug::fmt(42_u32)
    let b: str = Debug::fmt(false)
    let p = Point{3_u32, 4_u32}
    let c: str = Debug::fmt(p)
    let vec = Vec[u32]::new().push(1_u32).push(2_u32)
    let d: str = Debug::fmt(vec)

    if !assert(a == "42") {
        ret 1_u32
    }
    if !assert(b == "false") {
        ret 1_u32
    }
    if !assert(c == "Point(3,4)") {
        ret 1_u32
    }
    if !assert(d == "[1, 2]") {
        ret 1_u32
    }
    ret 0_u32
}
