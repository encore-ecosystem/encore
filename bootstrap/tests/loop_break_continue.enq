import core::testing::*

fn main() -> u32 {
    let mut i: u32 = 0_u32
    let mut acc: u32 = 0_u32

    loop {
        i = i + 1_u32
        if i == 2_u32 {
            continue
        }
        if i == 6_u32 {
            break
        }
        acc = acc + i
    }

    if !assert(acc == 13_u32) {
        ret 1_u32
    }
    ret 0_u32
}
