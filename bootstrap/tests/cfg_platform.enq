import core::testing::*

#cfg(target_os = "linux")
fn selected() -> u32 {
    ret 42_u32
}

#cfg(windows)
fn selected() -> u32 {
    ret 7_u32
}

#cfg(all(unix, not(windows)))
fn platform_family() -> u32 {
    ret 1_u32
}

#cfg(windows)
fn platform_family() -> u32 {
    ret 2_u32
}

fn main() -> u32 {
    if !assert(selected() == 42_u32) {
        ret 1_u32
    }
    if !assert(platform_family() == 1_u32) {
        ret 1_u32
    }
    ret 0_u32
}
