import core::io::print
import std::vec::Vec

import colorterm::Color
import colorterm::Style
import colorterm::paint


pub struct BuildProgress {
    tick: usize
    rendered_lines: usize
    completed: Vec[str]
    current_refrain: str
    current_file: str
}

impl for BuildProgress {
    pub fn new() -> BuildProgress {
        ret BuildProgress{0_usize, 0_usize, Vec[str]::new(), "", ""}
    }

    pub fn show(self: BuildProgress, refrain: str, file: str) -> BuildProgress {
        ret render(
            BuildProgress{
                self.tick + 1_usize,
                self.rendered_lines,
                self.completed,
                refrain,
                file
            }
        )
    }

    pub fn refrain_done(self: BuildProgress, refrain: str) -> BuildProgress {
        let mut completed = self.completed
        if !contains(completed, refrain) {
            completed = Vec[str]::push(completed, refrain)
        }
        ret render(
            BuildProgress{
                self.tick,
                self.rendered_lines,
                completed,
                "",
                ""
            }
        )
    }

    pub fn finish(self: BuildProgress) -> BuildProgress {
        ret render(
            BuildProgress{
                self.tick,
                self.rendered_lines,
                self.completed,
                "",
                ""
            }
        )
    }
}

fn render(state: BuildProgress) -> BuildProgress {
    clear_render(state.rendered_lines)

    let mut completed_lines = 0_usize
    let mut i = 0_usize
    loop {
        match Vec[str]::get(state.completed, i) {
            Some(refrain) => {
                let line = "[" + refrain + "]: Compiled"
                print(paint(line, Color::BrightGreen, Style::Bold) + "\n")
                completed_lines = completed_lines + 1_usize
                i = i + 1_usize
            }
            None => {
                break
            }
        }
    }

    let mut spinner_lines = 0_usize
    if state.current_refrain != "" {
        let frame = spinner_frame(state.tick)
        let first_line = frame + " " + state.current_refrain
        let second_line = "  " + state.current_file
        print("\n")
        print(first_line + "\n")
        print(second_line + "\n")
        spinner_lines = 3_usize
    }

    ret BuildProgress{
        state.tick,
        completed_lines + spinner_lines,
        state.completed,
        state.current_refrain,
        state.current_file
    }
}

fn clear_render(lines: usize) -> () {
    let mut i = 0_usize
    loop {
        if i >= lines {
            break
        }
        print("\x1b[1F")
        print("\x1b[2K")
        i = i + 1_usize
    }
    ret ()
}

fn contains(items: Vec[str], target: str) -> bool {
    let mut i = 0_usize
    loop {
        match Vec[str]::get(items, i) {
            Some(item) => {
                if item == target {
                    ret true
                }
                i = i + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret false
}

fn spinner_frame(tick: usize) -> str {
    let phase = tick % 4_usize
    if phase == 0_usize {
        ret "|"
    }
    if phase == 1_usize {
        ret "/"
    }
    if phase == 2_usize {
        ret "-"
    }
    ret "\\"
}
