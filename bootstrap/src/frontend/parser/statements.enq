import core::option::Option
import std::vec::Vec


pub struct FunctionParam {
    name: str
    typ: Option[str]
}

pub struct NamedField {
    name: str
    typ: str
}

pub struct TraitBound {
    path: str
    args: Vec[str]
}

pub struct GenericParam {
    name: str
    bounds: Vec[TraitBound]
}

pub struct ParsedEnumVariant {
    name: str
    generics: Vec[GenericParam]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[str]
    is_tuple: bool
    is_unit: bool
}

pub struct ImportStmt {
    is_public: bool
    path: str
}

pub struct StructStmt {
    is_public: bool
    name: str
    generics: Vec[GenericParam]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[str]
    is_tuple: bool
    is_unit: bool
}

pub struct EnumStmt {
    is_public: bool
    name: str
    generics: Vec[GenericParam]
    variants: Vec[ParsedEnumVariant]
}

pub struct FunctionItem {
    attrs: Vec[str]
    is_public: bool
    is_extern: bool
    name: str
    generics: Vec[GenericParam]
    params: Vec[FunctionParam]
    ret_type: Option[str]
    body: Option[ParsedBlock]
}

pub struct TraitStmt {
    is_public: bool
    name: str
    generics: Vec[GenericParam]
    bases: Vec[str]
    methods: Vec[FunctionItem]
}

pub struct ImplStmt {
    generics: Vec[GenericParam]
    trait_name: Option[str]
    trait_args: Vec[str]
    target: str
    methods: Vec[FunctionItem]
}

pub struct MatchPattern {
    kind: str
    value: Option[str]
    binding: Option[str]
}

pub struct ExprNode {
    value: Expr
}

pub struct ParsedBlock {
    statements: Vec[Statement]
}

pub struct LetStmt {
    name: str
    typ: Option[str]
    expr: ExprNode
    is_mut: bool
}

pub struct AssignmentStmt {
    target: ExprNode
    operator: str
    expr: ExprNode
}

pub struct IfBranch {
    condition: ExprNode
    body: ParsedBlock
}

pub struct IfStmt {
    branches: Vec[IfBranch]
    else_body: Option[ParsedBlock]
}

pub enum MatchArmBody {
    Block(ParsedBlock)
    Expr(ExprNode)
}

pub struct ParsedMatchArm {
    pattern: MatchPattern
    body: MatchArmBody
}

pub struct MatchStmt {
    expr: ExprNode
    arms: Vec[ParsedMatchArm]
}

pub struct WhileStmt {
    label: Option[str]
    condition: ExprNode
    body: ParsedBlock
}

pub struct LoopStmt {
    label: Option[str]
    body: ParsedBlock
}

pub struct DoWhileStmt {
    body: ParsedBlock
    condition: ExprNode
}

pub struct EhirStmt {
    is_unsafe: bool
    body: str
}

pub struct UnaryExpr {
    operator: str
    expr: ExprNode<H>
}

pub struct BinaryExpr {
    lhs: ExprNode<H>
    operator: str
    rhs: ExprNode<H>
}

pub struct CallExpr {
    callee: ExprNode<H>
    generics: Vec[str]
    args: Vec[ExprNode]
}

pub struct FieldExpr {
    base: ExprNode<H>
    field: str
}

pub struct MethodCallExpr {
    receiver: ExprNode<H>
    method: str
    generics: Vec[str]
    args: Vec[ExprNode]
}

pub struct MatchExprArm {
    pattern: MatchPattern
    expr: ExprNode
}

pub struct MatchExpr {
    expr: ExprNode<H>
    arms: Vec[MatchExprArm]
}

pub struct StructInitExpr {
    path: str
    values: Vec[ExprNode]
}

pub struct TupleLiteralExpr {
    items: Vec[ExprNode]
}

pub struct ArrayLiteralExpr {
    items: Vec[ExprNode]
}

pub struct ArrayRepeatExpr {
    value: ExprNode<H>
    size: str
}

pub struct BlockExpr {
    statements: Vec[Statement]
    tail: ExprNode<H>
}

pub struct IfExprBranch {
    condition: ExprNode
    body: ExprNode
}

pub struct IfExpr {
    branches: Vec[IfExprBranch]
    else_body: ExprNode<H>
}

pub struct IndexExpr {
    base: ExprNode<H>
    index: ExprNode<H>
}

pub enum Statement {
    Import(ImportStmt)
    EnumItem(EnumStmt)
    Struct(StructStmt)
    Trait(TraitStmt)
    Impl(ImplStmt)
    Function(FunctionItem)
    Let(LetStmt)
    Ret(ExprNode)
    Expr(ExprNode)
    If(IfStmt)
    Match(MatchStmt)
    Assignment(AssignmentStmt)
    While(WhileStmt)
    Loop(LoopStmt)
    DoWhile(DoWhileStmt)
    Unsafe(ParsedBlock)
    Ehir(EhirStmt)
    Break(Option[str])
    Continue(Option[str])
}

pub enum Expr {
    Path(str)
    Boolean(bool)
    Integer(str)
    Float(str)
    StringLiteral(str)
    Parenthesized(ExprNode<H>)
    TupleLiteral(TupleLiteralExpr)
    ArrayLiteral(ArrayLiteralExpr)
    ArrayRepeat(ArrayRepeatExpr)
    Block(BlockExpr)
    Unary(UnaryExpr)
    Binary(BinaryExpr)
    Call(CallExpr)
    Field(FieldExpr)
    MethodCall(MethodCallExpr)
    Match(MatchExpr)
    If(IfExpr)
    StructInit(StructInitExpr)
    Index(IndexExpr)
    Try(ExprNode<H>)
    Unsafe(ParsedBlock)
}
