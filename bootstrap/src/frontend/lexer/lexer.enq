import mod::token::Token
import mod::token::TokenType

import core::option::Option
import std::vec::Vec

import std::io::println
import std::io::print
import core::fmt::Debug

pub struct Lexer {
    line: usize
    column: usize
    consumed: usize
    program: str
    tokens: Vec[Token]
    token_val: str
}


impl for Lexer {
    pub fn new() -> Lexer {
        ret Lexer{0_usize, 0_usize, 0_usize, "", Vec[Token]::new(), ""}
    }

    pub fn tokenize(mut self, p: str) -> Vec[Token] {
        self.line = 0_usize
        self.column = 0_usize
        self.consumed = 0_usize
        self.program = p
        self.tokens = Vec[Token]::new()
        self.token_val = ""


        loop {
            if self.is_at_end() {
                break
            }

            let curr_char = self.peek_curr()
            match curr_char {
                " " => {
                    self.consume_and_push(TokenType::WHITESPACE)
                }
                "\n" => {
                    self.line = self.line + 1_usize
                    self.column = 0_usize
                    self.consume_and_push(TokenType::NEWLINE)
                }
                "+" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::PLUS_EQUAL)
                    }
                    elif self.peek_curr() == "+" {
                        self.consume_and_push(TokenType::INCREMENT)
                    }
                    else {
                        self.push_token(TokenType::PLUS)
                    }
                }
                "-" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::MINUS_EQUAL)
                    }
                    elif self.peek_curr() == ">" {
                        self.consume_and_push(TokenType::ARROW)
                    }
                    elif self.peek_curr() == "-" {
                        self.consume_and_push(TokenType::DECREMENT)
                    }
                    else {
                        self.push_token(TokenType::MINUS)
                    }
                }
                "*" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::ASTERISK_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::ASTERISK)
                    }
                }
                "/" => {
                    self.consume()
                    if self.peek_curr() == "/" {
                        self.consume()
                        loop {
                            if self.is_at_end() || is_newline_char(self.peek_curr()) {
                                break
                            }
                            self.consume()
                        }
                        self.push_token(TokenType::ONE_LINE_COMMENT)
                    }
                    elif self.peek_curr() == "*" {
                        self.consume()
                        loop {
                            if self.is_at_end() {
                                break
                            }
                            if self.peek_curr() == "*" && self.peek_next() == "/" {
                                break
                            }
                            self.consume()
                        }

                        if self.is_at_end() {
                            self.push_token(TokenType::UNKNOWN)
                        }
                        else {
                            self.consume()
                            self.consume_and_push(TokenType::MULTI_LINE_COMMENT)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::SLASH_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::SLASH)
                    }
                }
                "%" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::PERCENT_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::PERCENT)
                    }
                }
                "<" => {
                    self.consume()
                    if self.peek_curr() == "<" {
                        self.consume()
                        if self.peek_curr() == "=" {
                            self.consume_and_push(TokenType::LEFT_SHIFT_EQUAL)
                        }
                        else {
                            self.push_token(TokenType::LEFT_SHIFT)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::LESS_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::LESS)
                    }
                }
                ">" => {
                    self.consume()
                    if self.peek_curr() == ">" {
                        self.consume()
                        if self.peek_curr() == "=" {
                            self.consume_and_push(TokenType::RIGHT_SHIFT_EQUAL)
                        }
                        else {
                            self.push_token(TokenType::RIGHT_SHIFT)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::GREATER_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::GREATER)
                    }
                }
                "(" => { self.consume_and_push(TokenType::LEFT_PAREN) }
                ")" => { self.consume_and_push(TokenType::RIGHT_PAREN) }
                "[" => { self.consume_and_push(TokenType::LEFT_BRACKET) }
                "]" => { self.consume_and_push(TokenType::RIGHT_BRACKET) }
                "{" => { self.consume_and_push(TokenType::LEFT_BRACE) }
                "}" => { self.consume_and_push(TokenType::RIGHT_BRACE) }
                ":" => {
                    self.consume()
                    if self.peek_curr() == ":" {
                        self.consume_and_push(TokenType::SCOPE)
                    }
                    else {
                        self.push_token(TokenType::COLON)
                    }
                }
                "." => { self.consume_and_push(TokenType::DOT) }
                "," => { self.consume_and_push(TokenType::COMMA) }
                ";" => { self.consume_and_push(TokenType::SEMICOLON) }
                "=" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::EQUAL_EQUAL)
                    }
                    elif self.peek_curr() == ">" {
                        self.consume_and_push(TokenType::FAT_ARROW)
                    }
                    else {
                        self.push_token(TokenType::ASSIGN)
                    }
                }
                "!" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::BANG_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::BANG)
                    }
                }
                "&" => {
                    self.consume()
                    if self.peek_curr() == "&" {
                        self.consume_and_push(TokenType::AND_AND)
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::AMPERSAND_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::AMPERSAND)
                    }
                }
                "|" => {
                    self.consume()
                    if self.peek_curr() == "|" {
                        self.consume_and_push(TokenType::PIPE_PIPE)
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::PIPE_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::PIPE)
                    }
                }
                "^" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::CARET_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::CARET)
                    }
                }
                "~" => { self.consume_and_push(TokenType::TILDE) }
                "?" => { self.consume_and_push(TokenType::QUESTION) }
                "\"" => {
                    self.consume()
                    loop {
                        if self.is_at_end() {
                            break
                        }
                        if self.peek_curr() == "\\" {
                            self.consume()
                            if self.is_at_end() {
                                break
                            }
                            self.consume()
                            continue
                        }
                        if self.peek_curr() == "\"" {
                            break
                        }
                        self.consume()
                    }
                    if self.is_at_end() {
                        self.push_token(TokenType::UNKNOWN)
                    }
                    else {
                        self.consume_and_push(TokenType::STRING)
                    }
                }
                "'" => { self.consume_and_push(TokenType::QUOTE) }
                _ => {
                    if is_digit_char(curr_char) {
                        self.parse_number()
                    }
                    elif is_identifier_start_char(curr_char) {
                        self.parse_identifier()
                    }
                    else {
                        self.consume()
                        self.push_token(TokenType::UNKNOWN)
                    }
                }
            }
        }

        ret self.tokens
    }

    fn parse_number(mut self) -> () {
        let mut is_float = false

        loop {
            if !is_digit_char(self.peek_curr()) {
                break
            }
            self.consume()
        }

        if self.peek_curr() == "." && is_digit_char(self.peek_next()) {
            is_float = true
            self.consume()
            loop {
                if !is_digit_char(self.peek_curr()) {
                    break
                }
                self.consume()
            }
        }

        if is_float {
            self.push_token(TokenType::FLOAT)
            ret ()
        }
        self.push_token(TokenType::INTEGER)
        ret ()
    }

    fn parse_identifier(mut self) -> () {
        loop {
            let curr = self.peek_curr()
            if !(is_alnum_char(curr) || curr == "_") {
                break
            }
            self.consume()
        }

        let raw = self.token_val
        let token_type = identifier_token_type(raw)
        self.push_token(token_type)
        ret ()
    }

    fn consume(mut self) -> () {
        let curr_char = self.peek_curr()
        if curr_char == "" {
            ret ()
        }

        self.token_val = self.token_val + curr_char
        self.consumed = self.consumed + 1_usize
        ret ()
    }

    fn consume_and_push(mut self, token_type: TokenType) -> () {
        self.consume()
        self.push_token(token_type)
        ret ()
    }

    fn push_token(mut self, token_type: TokenType) -> () {
        match token_type {
            TokenType::NEWLINE => {
                self.token_val = ""
                ret ()
            }
            TokenType::WHITESPACE => {
                self.token_val = ""
                ret ()
            }
            TokenType::ONE_LINE_COMMENT => {
                self.token_val = ""
                ret ()
            }
            TokenType::MULTI_LINE_COMMENT => {
                self.token_val = ""
                ret ()
            }
            _ => {}
        }

        let token = Token::new(
            token_type,
            self.token_val,
            self.line,
            self.column
        )
        self.tokens = self.tokens.push(token)
        self.token_val = ""
        ret ()
    }

    fn is_at_end(self) -> bool {
        ret self.consumed >= self.program.len()
    }

    fn peek_curr(self) -> str {
        ret self.peek_nth(0_usize)
    }

    fn peek_next(self) -> str {
        ret self.peek_nth(1_usize)
    }

    fn peek_nth(self, nth: usize) -> str {
        let index = self.consumed + nth
        match self.program.get(index) {
            Option[str]::Some(s) => {
                ret s
            }
            Option[str]::None => {
                ret ""
            }
        }
    }
}


fn identifier_token_type(raw: str) -> TokenType {
    if raw == "fn" { ret TokenType::KW_FN }
    if raw == "struct" { ret TokenType::KW_STRUCT }
    if raw == "enum" { ret TokenType::KW_ENUM }
    if raw == "trait" { ret TokenType::KW_TRAIT }
    if raw == "impl" { ret TokenType::KW_IMPL }
    if raw == "for" { ret TokenType::KW_FOR }
    if raw == "let" { ret TokenType::KW_LET }
    if raw == "mut" { ret TokenType::KW_MUT }
    if raw == "ret" { ret TokenType::KW_RET }
    if raw == "while" { ret TokenType::KW_WHILE }
    if raw == "do" { ret TokenType::KW_DO }
    if raw == "break" { ret TokenType::KW_BREAK }
    if raw == "continue" { ret TokenType::KW_CONTINUE }
    if raw == "loop" { ret TokenType::KW_LOOP }
    if raw == "if" { ret TokenType::KW_IF }
    if raw == "elif" { ret TokenType::KW_ELIF }
    if raw == "else" { ret TokenType::KW_ELSE }
    if raw == "match" { ret TokenType::KW_MATCH }
    if raw == "pub" { ret TokenType::KW_PUB }
    if raw == "import" { ret TokenType::KW_IMPORT }
    if raw == "as" { ret TokenType::KW_AS }
    if raw == "extern" { ret TokenType::KW_EXTERN }
    if raw == "unsafe" { ret TokenType::KW_UNSAFE }
    if raw == "ehir" { ret TokenType::KW_EHIR }
    if raw == "not" { ret TokenType::BANG }
    if raw == "true" || raw == "false" { ret TokenType::BOOLEAN }
    ret TokenType::IDENTIFIER
}

fn is_digit_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    let code = ch.byte_at(0_usize)
    ret code >= 48_u8 && code <= 57_u8
}

fn is_alpha_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    let code = ch.byte_at(0_usize)
    ret (code >= 65_u8 && code <= 90_u8) || (code >= 97_u8 && code <= 122_u8)
}

fn is_alnum_char(ch: str) -> bool {
    ret is_alpha_char(ch) || is_digit_char(ch)
}

fn is_identifier_start_char(ch: str) -> bool {
    ret is_alpha_char(ch) || ch == "_"
}

fn is_newline_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    ret ch.byte_at(0_usize) == 10_u8
}

fn is_double_quote_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    ret ch.byte_at(0_usize) == 34_u8
}
