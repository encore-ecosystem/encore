import core::option::Option
import core::fmt::Debug
import std::vec::Vec

import refrain::frontend::parser::statements::EnumStmt
import refrain::frontend::parser::statements::Expr
import refrain::frontend::parser::statements::ExprNode
import refrain::frontend::parser::statements::FunctionItem
import refrain::frontend::parser::statements::FunctionParam
import refrain::frontend::parser::statements::IfBranch
import refrain::frontend::parser::statements::IfStmt
import refrain::frontend::parser::statements::ImportStmt
import refrain::frontend::parser::statements::LoopStmt
import refrain::frontend::parser::statements::NamedField
import refrain::frontend::parser::statements::DoWhileStmt
import refrain::frontend::parser::statements::ParsedBlock
import refrain::frontend::parser::statements::ParsedEnumVariant
import refrain::frontend::parser::statements::Statement
import refrain::frontend::parser::statements::StructStmt
import refrain::frontend::parser::statements::WhileStmt
import refrain::frontend::parser::statements::AssignmentStmt
import refrain::frontend::parser::statements::LetStmt
import refrain::frontend::parser::statements::EhirStmt
import refrain::frontend::parser::statements::BinaryExpr
import refrain::frontend::parser::statements::CallExpr
import refrain::frontend::parser::statements::StructInitExpr
import refrain::frontend::parser::statements::MatchStmt
import refrain::frontend::parser::statements::MatchPattern
import refrain::frontend::parser::statements::ParsedMatchArm
import refrain::frontend::parser::statements::MatchArmBody
import ehirlib::EhirTextBuilder

struct LoweredExpr {
    code: EhirTextBuilder
    value: str
    typ: str
}

pub fn translate_to_ehir(ast: Vec[Statement]) -> str {
    let mut builder = EhirTextBuilder::new()
    for stmt in ast {
        match stmt {
            Statement::Import(imp_item) => {
                builder = builder.line(translate_import(imp_item))
            }
            Statement::Struct(struct_item) => {
                builder = builder.append(translate_struct(struct_item))
            }
            Statement::EnumItem(enum_item) => {
                builder = builder.append(translate_enum(enum_item))
            }
            Statement::Function(fn_item) => {
                builder = builder.append(translate_function(fn_item))
            }
            _ => {}
        }
        builder = builder.empty_line()
    }
    ret builder.finish()
}

fn translate_import(imp: ImportStmt) -> str {
    ret "imp " + imp.path + "\n"
}

fn translate_struct(item: StructStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    builder = builder.line("struct " + item.name + " {")
    if item.is_tuple {
        let mut i = 0_usize
        for field_t in item.tuple_fields {
            builder = builder.line("  _" + Debug::fmt(i) + ": " + field_t)
            i = i + 1_usize
        }
    }
    else {
        for field in item.named_fields {
            builder = builder.line("  " + field.name + ": " + field.typ)
        }
    }
    builder = builder.line("}")
    ret builder
}

fn translate_enum(item: EnumStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    builder = builder.line("enum " + item.name + " {")
    for variant in item.variants {
        if variant.is_unit {
            builder = builder.line("  " + variant.name)
        }
        elif variant.is_tuple {
            builder = builder.line("  " + variant.name + "(" + join_strs(variant.tuple_fields, ", ") + ")")
        }
        else {
            let mut fields = Vec[str]::new()
            for field in variant.named_fields {
                fields.push(field.typ)
            }
            builder = builder.line("  " + variant.name + "(" + join_strs(fields, ", ") + ")")
        }
    }
    builder = builder.line("}")
    ret builder
}

fn translate_function(fn_item: FunctionItem) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    builder = builder.line("fn " + fn_item.name + "(" + translate_params(fn_item) + ") -> " + function_ret_type(fn_item) + " {")
    builder = builder.label("entry")

    match fn_item.body {
        Option[ParsedBlock]::Some(body) => {
            builder = builder.append(translate_statements(
                body.statements,
                function_ret_type(fn_item),
                "entry",
                Option[str]::None,
                Option[str]::None
            ))
        }
        Option[ParsedBlock]::None => {
            builder = builder.append(translate_default_ret(function_ret_type(fn_item)))
        }
    }

    builder = builder.line("}")
    ret builder
}

fn translate_statements(
    statements: Vec[Statement],
    ret_type: str,
    prefix: str,
    break_label: Option[str],
    continue_label: Option[str]
) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let mut saw_ret = false
    let mut i = 0_usize
    for stmt in statements {
        match stmt {
            Statement::Ret(expr) => {
                builder = builder.append(translate_ret_expr(expr, ret_type))
                saw_ret = true
            }
            Statement::If(if_stmt) => {
                builder = builder.append(translate_if_stmt(if_stmt, ret_type, prefix, i, break_label, continue_label))
            }
            Statement::While(while_stmt) => {
                builder = builder.append(translate_while_stmt(while_stmt, ret_type, prefix, i))
            }
            Statement::Loop(loop_stmt) => {
                builder = builder.append(translate_loop_stmt(loop_stmt, ret_type, prefix, i))
            }
            Statement::DoWhile(do_stmt) => {
                builder = builder.append(translate_do_while_stmt(do_stmt, ret_type, prefix, i))
            }
            Statement::Let(let_stmt) => {
                builder = builder.append(translate_let_stmt(let_stmt, prefix, i))
            }
            Statement::Assignment(assign_stmt) => {
                builder = builder.append(translate_assignment_stmt(assign_stmt, prefix, i))
            }
            Statement::Expr(expr_stmt) => {
                builder = builder.append(translate_expr_stmt(expr_stmt, prefix, i))
            }
            Statement::Ehir(ehir_stmt) => {
                builder = builder.append(translate_ehir_stmt(ehir_stmt))
            }
            Statement::Match(match_stmt) => {
                builder = builder.append(translate_match_stmt(match_stmt, ret_type, prefix, i, break_label, continue_label))
            }
            Statement::Break(_) => {
                match break_label {
                    Option[str]::Some(target) => {
                        builder = builder.instr("br $" + target)
                    }
                    Option[str]::None => {}
                }
            }
            Statement::Continue(_) => {
                match continue_label {
                    Option[str]::Some(target) => {
                        builder = builder.instr("br $" + target)
                    }
                    Option[str]::None => {}
                }
            }
            _ => {}
        }
        i = i + 1_usize
    }
    if !saw_ret {
        builder = builder.append(translate_default_ret(ret_type))
    }
    ret builder
}

fn translate_let_stmt(let_stmt: LetStmt, prefix: str, idx: usize) -> EhirTextBuilder {
    let lowered = lower_expr(let_stmt.expr, prefix + "_let", idx)
    let mut builder = lowered.code
    let typ = unwrap_type_or_usize(let_stmt.typ)
    builder = builder.instr(let_stmt.name + ": " + typ + " = " + lowered.value)
    ret builder
}

fn translate_assignment_stmt(assign_stmt: AssignmentStmt, prefix: str, idx: usize) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let target = expr_path_or_empty(assign_stmt.target)
    if target == "" {
        ret builder.instr("; TODO: complex assignment target is not implemented")
    }

    if assign_stmt.operator == "=" {
        let lowered = lower_expr(assign_stmt.expr, prefix + "_assign", idx)
        builder = builder.append(lowered.code)
        builder = builder.instr(target + " = " + lowered.value)
        ret builder
    }

    let lowered = lower_expr(assign_stmt.expr, prefix + "_assign", idx)
    builder = builder.append(lowered.code)
    let op = assignment_op_to_ehir(assign_stmt.operator)
    if op == "" {
        ret builder.instr("; TODO: unsupported assignment operator: " + assign_stmt.operator)
    }
    let tmp_name = prefix + "_assign_tmp_" + Debug::fmt(idx)
    builder = builder.instr(tmp_name + " = " + op + " " + target + ", " + lowered.value)
    builder = builder.instr(target + " = " + tmp_name)
    ret builder
}

fn translate_expr_stmt(expr_stmt: ExprNode, prefix: str, idx: usize) -> EhirTextBuilder {
    let lowered = lower_expr(expr_stmt, prefix + "_expr", idx)
    ret lowered.code
}

fn translate_ehir_stmt(stmt: EhirStmt) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    if stmt.is_unsafe {
        builder = builder.instr("; unsafe ehir")
    }
    builder = builder.instr(stmt.body)
    ret builder
}

fn expr_path_or_empty(expr: ExprNode) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        _ => {
            ret ""
        }
    }
    ret ""
}

fn assignment_op_to_ehir(op: str) -> str {
    if op == "+=" { ret "add" }
    if op == "-=" { ret "sub" }
    if op == "*=" { ret "mul" }
    if op == "/=" { ret "div" }
    if op == "%=" { ret "mod" }
    ret ""
}

fn lower_expr(expr: ExprNode, prefix: str, idx: usize) -> LoweredExpr {
    match expr.value {
        Expr::Integer(v) => {
            let name = prefix + "_int_" + Debug::fmt(idx)
            let typ = "usize"
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(v, typ))
            ret LoweredExpr{code, name, typ}
        }
        Expr::Float(v) => {
            let name = prefix + "_float_" + Debug::fmt(idx)
            let typ = "f64"
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": " + typ + " = capprim " + with_numeric_suffix(v, typ))
            ret LoweredExpr{code, name, typ}
        }
        Expr::StringLiteral(v) => {
            let name = prefix + "_str_" + Debug::fmt(idx)
            let typ = "str"
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": str = capprim \"" + escape_str(v) + "\"_str")
            ret LoweredExpr{code, name, typ}
        }
        Expr::Boolean(v) => {
            let name = prefix + "_bool_" + Debug::fmt(idx)
            let mut lit = "0_u1"
            if v {
                lit = "1_u1"
            }
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": bool = capprim " + lit)
            ret LoweredExpr{code, name, "bool"}
        }
        Expr::Path(name) => {
            ret LoweredExpr{EhirTextBuilder::new(), name, "usize"}
        }
        Expr::Binary(bin) => {
            let name = prefix + "_bin_" + Debug::fmt(idx)
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": usize = capprim 0_usize")
            code = code.instr("; TODO: binary lowering requires ExprNode/ExprNode<H> unification")
            ret LoweredExpr{code, name, "usize"}
        }
        Expr::Call(call) => {
            let name = prefix + "_call_" + Debug::fmt(idx)
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": usize = capprim 0_usize")
            code = code.instr("; TODO: call lowering requires ExprNode/ExprNode<H> unification")
            ret LoweredExpr{code, name, "usize"}
        }
        Expr::StructInit(init_expr) => {
            let name = prefix + "_struct_" + Debug::fmt(idx)
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": usize = capprim 0_usize")
            code = code.instr("; TODO: struct init lowering requires ExprNode/ExprNode<H> unification")
            ret LoweredExpr{code, name, "usize"}
        }
        _ => {
            let name = prefix + "_zero_" + Debug::fmt(idx)
            let mut code = EhirTextBuilder::new()
            code = code.instr(name + ": usize = capprim 0_usize")
            code = code.instr("; TODO: expression lowering fallback")
            ret LoweredExpr{code, name, "usize"}
        }
    }
}

fn binary_op_to_ehir(op: str) -> str {
    if op == "+" { ret "add" }
    if op == "-" { ret "sub" }
    if op == "*" { ret "mul" }
    if op == "/" { ret "div" }
    if op == "%" { ret "mod" }
    if op == "==" { ret "eq" }
    if op == "!=" { ret "ne" }
    if op == "<" { ret "lt" }
    if op == ">" { ret "gt" }
    if op == "<=" { ret "le" }
    if op == ">=" { ret "ge" }
    if op == "&&" { ret "and" }
    if op == "||" { ret "or" }
    ret ""
}

fn lower_binary_expr(bin: BinaryExpr, prefix: str, idx: usize) -> LoweredExpr {
    let lhs = expr_h_path_or_empty(bin.lhs)
    let rhs = expr_h_path_or_empty(bin.rhs)
    let out_name = prefix + "_bin_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let op = binary_op_to_ehir(bin.operator)

    if lhs == "" || rhs == "" {
        code = code.instr(out_name + ": usize = capprim 0_usize")
        code = code.instr("; TODO: binary lowering currently supports Path/Path operands only")
        ret LoweredExpr{code, out_name, "usize"}
    }

    if op == "" {
        code = code.instr(out_name + " = " + lhs)
        code = code.instr("; TODO: unsupported binary operator: " + bin.operator)
        ret LoweredExpr{code, out_name, "usize"}
    }

    code = code.instr(out_name + " = " + op + " " + lhs + ", " + rhs)
    ret LoweredExpr{code, out_name, "usize"}
}

fn lower_call_expr(call: CallExpr, prefix: str, idx: usize) -> LoweredExpr {
    let callee = expr_h_path_or_empty(call.callee)
    let out_name = prefix + "_call_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let mut arg_values = Vec[str]::new()
    let mut i = 0_usize

    for arg in call.args {
        let lowered = lower_expr(arg, prefix + "_arg", idx + i + 1_usize)
        code = code.append(lowered.code)
        arg_values.push(lowered.value)
        i = i + 1_usize
    }

    if callee == "" {
        code = code.instr(out_name + ": usize = capprim 0_usize")
        code = code.instr("; TODO: non-path callee is not implemented")
        ret LoweredExpr{code, out_name, "usize"}
    }

    code = code.instr(out_name + " = call " + callee + "(" + join_strs(arg_values, ", ") + ")")
    ret LoweredExpr{code, out_name, "usize"}
}

fn lower_struct_init_expr(init_expr: StructInitExpr, prefix: str, idx: usize) -> LoweredExpr {
    let out_name = prefix + "_struct_" + Debug::fmt(idx)
    let mut code = EhirTextBuilder::new()
    let mut values = Vec[str]::new()
    let mut i = 0_usize
    for item in init_expr.values {
        let lowered = lower_expr(item, prefix + "_field", idx + i + 1_usize)
        code = code.append(lowered.code)
        values.push(lowered.value)
        i = i + 1_usize
    }
    code = code.instr(out_name + " = capstruct " + init_expr.path + "(" + join_strs(values, ", ") + ")")
    ret LoweredExpr{code, out_name, init_expr.path}
}

fn expr_h_path_or_empty(expr: ExprNode<H>) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        Expr::Parenthesized(inner) => {
            ret expr_h_path_or_empty(inner)
        }
        _ => {
            ret ""
        }
    }
    ret ""
}

fn translate_match_stmt(
    match_stmt: MatchStmt,
    ret_type: str,
    prefix: str,
    idx: usize,
    break_label: Option[str],
    continue_label: Option[str]
) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    let cond = lower_expr(match_stmt.expr, prefix + "_match_expr", idx)
    builder = builder.append(cond.code)

    let end_label = prefix + "_match_end_" + Debug::fmt(idx)
    let mut next_label = prefix + "_match_next_" + Debug::fmt(idx) + "_0"
    let mut arm_idx = 0_usize
    for arm in match_stmt.arms {
        let body_label = prefix + "_match_body_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx)
        let fail_label = prefix + "_match_next_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx + 1_usize)
        let test = lower_match_pattern_test(cond.value, cond.typ, arm.pattern, prefix, idx, arm_idx)
        builder = builder.append(test.code)
        if test.is_always_true {
            builder = builder.instr("br $" + body_label)
        }
        else {
            builder = builder.instr("cbr " + test.cond_value + ", $" + body_label + ", $" + fail_label)
        }
        builder = builder.label(body_label)
        builder = builder.append(translate_match_arm_body(arm, ret_type, prefix + "_match_arm_" + Debug::fmt(arm_idx), break_label, continue_label))
        builder = builder.instr("br $" + end_label)
        next_label = fail_label
        builder = builder.label(next_label)
        arm_idx = arm_idx + 1_usize
    }

    builder = builder.instr("; no pattern matched")
    builder = builder.instr("br $" + end_label)
    builder = builder.label(end_label)
    ret builder
}

struct LoweredPatternTest {
    code: EhirTextBuilder
    cond_value: str
    is_always_true: bool
}

fn lower_match_pattern_test(
    subject_value: str,
    subject_typ: str,
    pattern: MatchPattern,
    prefix: str,
    idx: usize,
    arm_idx: usize
) -> LoweredPatternTest {
    let mut code = EhirTextBuilder::new()
    if pattern.kind == "wildcard" {
        ret LoweredPatternTest{code, "", true}
    }

    let cond_name = prefix + "_match_cond_" + Debug::fmt(idx) + "_" + Debug::fmt(arm_idx)
    match pattern.value {
        Option[str]::Some(value) => {
            if pattern.kind == "integer" {
                let lit = with_numeric_suffix(value, subject_typ)
                code = code.instr(cond_name + " = eq " + subject_value + ", " + lit)
                ret LoweredPatternTest{code, cond_name, false}
            }
            if pattern.kind == "float" {
                let lit = with_numeric_suffix(value, subject_typ)
                code = code.instr(cond_name + " = eq " + subject_value + ", " + lit)
                ret LoweredPatternTest{code, cond_name, false}
            }
            if pattern.kind == "bool" {
                let mut lit = "0_u1"
                if value == "true" {
                    lit = "1_u1"
                }
                code = code.instr(cond_name + " = eq " + subject_value + ", " + lit)
                ret LoweredPatternTest{code, cond_name, false}
            }
            if pattern.kind == "string" {
                code = code.instr(cond_name + " = eq " + subject_value + ", \"" + escape_str(value) + "\"_str")
                ret LoweredPatternTest{code, cond_name, false}
            }
            if pattern.kind == "path" {
                code = code.instr(cond_name + " = eq " + subject_value + ", " + value)
                ret LoweredPatternTest{code, cond_name, false}
            }
        }
        Option[str]::None => {}
    }

    code = code.instr(cond_name + ": bool = capprim 0_u1")
    code = code.instr("; TODO: unsupported match pattern kind: " + pattern.kind)
    ret LoweredPatternTest{code, cond_name, false}
}

fn translate_match_arm_body(
    arm: ParsedMatchArm,
    ret_type: str,
    prefix: str,
    break_label: Option[str],
    continue_label: Option[str]
) -> EhirTextBuilder {
    match arm.body {
        MatchArmBody::Block(block) => {
            ret translate_statements(block.statements, ret_type, prefix, break_label, continue_label)
        }
        MatchArmBody::Expr(expr) => {
            ret translate_expr_stmt(expr, prefix, 0_usize)
        }
    }
    ret EhirTextBuilder::new()
}

fn lower_cond(expr: ExprNode, temp_name: str) -> EhirTextBuilder {
    let lowered = lower_expr(expr, temp_name, 0_usize)
    let mut builder = lowered.code
    builder = builder.instr(temp_name + ": bool = " + lowered.value)
    ret builder
}

fn translate_if_stmt(
    if_stmt: IfStmt,
    ret_type: str,
    prefix: str,
    idx: usize,
    break_label: Option[str],
    continue_label: Option[str]
) -> EhirTextBuilder {
    let then_label = prefix + "_if_then_" + Debug::fmt(idx)
    let else_label = prefix + "_if_else_" + Debug::fmt(idx)
    let end_label = prefix + "_if_end_" + Debug::fmt(idx)
    let cond_name = prefix + "_if_cond_" + Debug::fmt(idx)

    let mut builder = EhirTextBuilder::new()
    let branches = if_stmt.branches
    match branches.get(0_usize) {
        Option[IfBranch]::Some(branch0) => {
            builder = builder.append(lower_cond(branch0.condition, cond_name))
            builder = builder.instr("cbr " + cond_name + ", $" + then_label + ", $" + else_label)
            builder = builder.label(then_label)
            builder = builder.append(translate_statements(
                branch0.body.statements,
                ret_type,
                then_label,
                break_label,
                continue_label
            ))
            builder = builder.instr("br $" + end_label)
        }
        Option[IfBranch]::None => {
            ret builder
        }
    }

    builder = builder.label(else_label)
    match if_stmt.else_body {
        Option[ParsedBlock]::Some(else_block) => {
            builder = builder.append(translate_statements(
                else_block.statements,
                ret_type,
                else_label,
                break_label,
                continue_label
            ))
        }
        Option[ParsedBlock]::None => {
            builder = builder.instr("br $" + end_label)
        }
    }
    builder = builder.instr("br $" + end_label)
    builder = builder.label(end_label)
    ret builder
}

fn translate_while_stmt(while_stmt: WhileStmt, ret_type: str, prefix: str, idx: usize) -> EhirTextBuilder {
    let cond_label = prefix + "_while_cond_" + Debug::fmt(idx)
    let body_label = prefix + "_while_body_" + Debug::fmt(idx)
    let end_label = prefix + "_while_end_" + Debug::fmt(idx)
    let cond_name = prefix + "_while_condv_" + Debug::fmt(idx)

    let mut builder = EhirTextBuilder::new()
    builder = builder.instr("br $" + cond_label)
    builder = builder.label(cond_label)
    builder = builder.append(lower_cond(while_stmt.condition, cond_name))
    builder = builder.instr("cbr " + cond_name + ", $" + body_label + ", $" + end_label)
    builder = builder.label(body_label)
    builder = builder.append(translate_statements(
        while_stmt.body.statements,
        ret_type,
        body_label,
        Option[str]::Some(end_label),
        Option[str]::Some(cond_label)
    ))
    builder = builder.instr("br $" + cond_label)
    builder = builder.label(end_label)
    ret builder
}

fn translate_loop_stmt(loop_stmt: LoopStmt, ret_type: str, prefix: str, idx: usize) -> EhirTextBuilder {
    let body_label = prefix + "_loop_body_" + Debug::fmt(idx)
    let end_label = prefix + "_loop_end_" + Debug::fmt(idx)
    let mut builder = EhirTextBuilder::new()
    builder = builder.instr("br $" + body_label)
    builder = builder.label(body_label)
    builder = builder.append(translate_statements(
        loop_stmt.body.statements,
        ret_type,
        body_label,
        Option[str]::Some(end_label),
        Option[str]::Some(body_label)
    ))
    builder = builder.instr("br $" + body_label)
    builder = builder.label(end_label)
    ret builder
}

fn translate_do_while_stmt(do_stmt: DoWhileStmt, ret_type: str, prefix: str, idx: usize) -> EhirTextBuilder {
    let body_label = prefix + "_do_body_" + Debug::fmt(idx)
    let cond_label = prefix + "_do_cond_" + Debug::fmt(idx)
    let end_label = prefix + "_do_end_" + Debug::fmt(idx)
    let cond_name = prefix + "_do_condv_" + Debug::fmt(idx)
    let mut builder = EhirTextBuilder::new()
    builder = builder.instr("br $" + body_label)
    builder = builder.label(body_label)
    builder = builder.append(translate_statements(
        do_stmt.body.statements,
        ret_type,
        body_label,
        Option[str]::Some(end_label),
        Option[str]::Some(cond_label)
    ))
    builder = builder.instr("br $" + cond_label)
    builder = builder.label(cond_label)
    builder = builder.append(lower_cond(do_stmt.condition, cond_name))
    builder = builder.instr("cbr " + cond_name + ", $" + body_label + ", $" + end_label)
    builder = builder.label(end_label)
    ret builder
}

fn translate_params(fn_item: FunctionItem) -> str {
    let mut out = ""
    let mut i = 0_usize
    for param in fn_item.params {
        if i > 0_usize {
            out = out + ", "
        }
        let t = unwrap_type_or_usize(param.typ)
        out = out + param.name + ": " + t
        i = i + 1_usize
    }
    ret out
}

fn function_ret_type(fn_item: FunctionItem) -> str {
    match fn_item.ret_type {
        Option[str]::Some(rt) => { ret rt }
        Option[str]::None => { ret "void" }
    }
    ret "void"
}

fn unwrap_type_or_usize(typ: Option[str]) -> str {
    match typ {
        Option[str]::Some(value) => { ret value }
        Option[str]::None => { ret "usize" }
    }
    ret "usize"
}

fn translate_ret_expr(expr: ExprNode, ret_type: str) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    match expr.value {
        Expr::Integer(v) => {
            builder = builder.instr("_ret: " + ret_type + " = capprim " + with_numeric_suffix(v, ret_type))
            ret builder.instr("ret _ret: " + ret_type)
        }
        Expr::Float(v) => {
            builder = builder.instr("_ret: " + ret_type + " = capprim " + with_numeric_suffix(v, ret_type))
            ret builder.instr("ret _ret: " + ret_type)
        }
        Expr::StringLiteral(v) => {
            builder = builder.instr("_ret: str = capprim \"" + escape_str(v) + "\"_str")
            ret builder.instr("ret _ret: str")
        }
        Expr::Boolean(v) => {
            let mut lit = "0_u1"
            if v {
                lit = "1_u1"
            }
            builder = builder.instr("_ret: bool = capprim " + lit)
            ret builder.instr("ret _ret: bool")
        }
        Expr::Path(name) => {
            ret builder.instr("ret " + name + ": " + ret_type)
        }
        _ => {
            ret translate_default_ret(ret_type)
        }
    }
}

fn translate_default_ret(ret_type: str) -> EhirTextBuilder {
    let mut builder = EhirTextBuilder::new()
    if ret_type == "void" {
        ret builder
    }
    if ret_type == "str" {
        builder = builder.instr("_ret: str = capprim \"\"_str")
        ret builder.instr("ret _ret: str")
    }
    if ret_type == "bool" {
        builder = builder.instr("_ret: bool = capprim 0_u1")
        ret builder.instr("ret _ret: bool")
    }
    builder = builder.instr("_ret: " + ret_type + " = capprim " + with_numeric_suffix("0", ret_type))
    ret builder.instr("ret _ret")
}

fn with_numeric_suffix(value: str, typ: str) -> str {
    if ends_with(typ, "usize") {
        ret value + "_usize"
    }
    if ends_with(typ, "isize") {
        ret value + "_isize"
    }
    if starts_with(typ, "u") {
        ret value + "_" + typ
    }
    if starts_with(typ, "i") {
        ret value + "_" + typ
    }
    if starts_with(typ, "f") {
        ret value + "_" + typ
    }
    ret value + "_usize"
}

fn join_strs(items: Vec[str], sep: str) -> str {
    let mut out = ""
    let mut i = 0_usize
    for item in items {
        if i > 0_usize {
            out = out + sep
        }
        out = out + item
        i = i + 1_usize
    }
    ret out
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() {
        ret false
    }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn ends_with(value: str, suffix: str) -> bool {
    if suffix.len() > value.len() {
        ret false
    }
    let start = value.len() - suffix.len()
    ret value.slice(start, suffix.len()) == suffix
}

fn escape_str(value: str) -> str {
    let mut out = ""
    let mut i = 0_usize
    loop {
        match value.get(i) {
            Option[str]::Some(ch) => {
                if ch == "\\" {
                    out = out + "\\\\"
                }
                elif ch == "\"" {
                    out = out + "\\\""
                }
                elif ch == "\n" {
                    out = out + "\\n"
                }
                else {
                    out = out + ch
                }
                i = i + 1_usize
            }
            Option[str]::None => { break }
        }
    }
    ret out
}
