import core::option::Option
import std::os::argc
import std::os::argv
import std::process::run

import mod::build::run_frontend_build

pub fn run_build() -> u32 {
    ret run_encore_py_mode("build", 2_usize)
}

pub fn run_run() -> u32 {
    ret run_encore_py_mode("run", 2_usize)
}

pub fn run_test() -> u32 {
    ret run_encore_py_mode("test", 2_usize)
}

pub fn run_add() -> u32 {
    ret run_encore_py_mode("add", 2_usize)
}

pub fn run_sync() -> u32 {
    ret run_encore_py_mode("sync", 2_usize)
}

pub fn run_update() -> u32 {
    ret run_encore_py_mode("update", 2_usize)
}

pub fn run_init() -> u32 {
    ret run_encore_py_mode("init", 2_usize)
}

pub fn run_install() -> u32 {
    ret run_encore_py_mode("install", 2_usize)
}

pub fn run_lsp() -> u32 {
    ret run_encore_py_mode("lsp", 2_usize)
}

pub fn run_bootstrap_frontend_build() -> u32 {
    ret run_frontend_build()
}

fn run_encore_py_mode(mode: str, first_arg: usize) -> u32 {
    let command = build_encore_py_command(mode, first_arg)
    let code = run(command)
    if code < 0_i32 {
        ret 1_u32
    }
    ret code as u32
}

fn build_encore_py_command(mode: str, first_arg: usize) -> str {
    let mut command = "encore-py " + shell_quote(mode)
    let mut index = first_arg
    while index < argc() {
        match argv(index) {
            Option[str]::Some(arg) => {
                command = command + " " + shell_quote(arg)
            }
            Option[str]::None => {
                break
            }
        }
        index = index + 1_usize
    }
    ret command
}

fn shell_quote(value: str) -> str {
    if value.len() == 0_usize {
        ret "''"
    }

    let mut out = "'"
    let mut index = 0_usize
    while index < value.len() {
        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch == "'" {
                    out = out + "'\\''"
                }
                else {
                    out = out + ch
                }
            }
            Option[str]::None => {
                break
            }
        }
        index = index + 1_usize
    }
    ret out + "'"
}
