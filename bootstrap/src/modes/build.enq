import std::path::Path
import std::os::read_file
import std::io::println
import core::option::Option
import core::panic::panic
import rich::Spinner
import rich::status
import rich::status_ok
import rich::status_fail

pub fn run_build() -> u32 {
    match find_project_root(Path::cwd()) {
        Option[Path]::Some(root) => {
            ret compile_project(root)
        }
        Option[Path]::None => {
            panic("Unable to find encore.toml in current directory or parents")
            ret 1_u32
        }
    }
}

fn compile_project(root: Path) -> u32 {
    let manifest_path = root.join("encore.toml")
    let manifest_source = read_file(manifest_path.as_str())
    if !contains_substring(manifest_source, "[project]") {
        println(status_fail("Unable to parse manifest: missing [project] section"))
        ret 1_u32
    }

    let source_path = root.join("src").join("main.enq")
    let source = read_file(source_path.as_str())

    println(status(Spinner::dots(), 0_usize, "Bootstrap lexer"))
    if !emit_tokens(source) {
        ret 1_u32
    }
    ret 0_u32
}

fn contains_substring(haystack: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > haystack.len() {
        ret false
    }

    let mut start = 0_usize
    while start + needle.len() <= haystack.len() {
        let mut matched = true
        let mut i = 0_usize
        while i < needle.len() {
            match haystack.get(start + i) {
                Option[str]::Some(lhs) => {
                    match needle.get(i) {
                        Option[str]::Some(rhs) => {
                            if lhs != rhs {
                                matched = false
                                break
                            }
                        }
                        Option[str]::None => {
                            matched = false
                            break
                        }
                    }
                }
                Option[str]::None => {
                    matched = false
                    break
                }
            }
            i = i + 1_usize
        }
        if matched {
            ret true
        }
        start = start + 1_usize
    }

    ret false
}

fn emit_tokens(source: str) -> bool {
    let mut index = 0_usize
    let mut line = 1_usize
    let mut column = 1_usize
    let mut token_line = 1_usize
    let mut token_column = 1_usize
    let mut token_start = 0_usize
    let mut curr = ""
    let mut has_unknown = false
    while index < source.len() {
        match source.get(index) {
            Option[str]::Some(ch) => {
                if is_space(ch) {
                    flush_token(curr, token_line, token_column)
                    curr = ""
                    if ch == "\n" {
                        line = line + 1_usize
                        column = 1_usize
                    }
                    else {
                        column = column + 1_usize
                    }
                    index = index + 1_usize
                    continue
                }

                if is_punct(ch) {
                    flush_token(curr, token_line, token_column)
                    curr = ""
                    println("Token(PUNCT, " + ch + ", " + usz(token_line) + ":" + usz(token_column) + ")")
                    column = column + 1_usize
                    index = index + 1_usize
                    continue
                }

                if is_unknown_symbol(ch) {
                    flush_token(curr, token_line, token_column)
                    curr = ""
                    has_unknown = true
                    render_unknown_trace(source, line, column)
                    column = column + 1_usize
                    index = index + 1_usize
                    continue
                }

                if curr.len() == 0_usize {
                    token_line = line
                    token_column = column
                    token_start = index
                    let _ = token_start
                }
                curr = curr + ch
                column = column + 1_usize
                index = index + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }
    flush_token(curr, token_line, token_column)
    if has_unknown {
        println(status_fail("Lexing failed"))
        ret false
    }
    println(status_ok("Lexing complete"))
    ret true
}

fn flush_token(raw: str, line: usize, column: usize) -> () {
    if raw.len() == 0_usize {
        ret ()
    }
    if is_keyword(raw) {
        println("Token(KEYWORD, " + raw + ", " + usz(line) + ":" + usz(column) + ")")
    }
    elif is_integer(raw) {
        println("Token(INTEGER, " + raw + ", " + usz(line) + ":" + usz(column) + ")")
    }
    else {
        println("Token(IDENTIFIER, " + raw + ", " + usz(line) + ":" + usz(column) + ")")
    }
    ret ()
}

fn is_space(ch: str) -> bool {
    if ch == " " {
        ret true
    }
    if ch.len() != 1_usize {
        ret false
    }
    let b = ch.byte_at(0_usize)
    if b == 10_u8 || b == 9_u8 || b == 13_u8 {
        ret true
    }
    ret false
}

fn is_punct(ch: str) -> bool {
    if ch == "(" || ch == ")" || ch == "{" || ch == "}" {
        ret true
    }
    if ch == "[" || ch == "]" || ch == ":" || ch == ";" {
        ret true
    }
    if ch == "," || ch == "." {
        ret true
    }
    if ch == "+" || ch == "-" || ch == "*" || ch == "/" || ch == "=" {
        ret true
    }
    if ch == "<" || ch == ">" || ch == "!" || ch == "&" || ch == "|" {
        ret true
    }
    if ch == "'" || ch == "\"" || ch == "?" || ch == "%" || ch == "^" || ch == "~" {
        ret true
    }
    ret false
}

fn is_unknown_symbol(ch: str) -> bool {
    if is_space(ch) || is_punct(ch) {
        ret false
    }

    if ch == "_" {
        ret false
    }
    match ch.get_byte(0_usize) {
        Option[u8]::Some(code) => {
            if code >= 48_u8 && code <= 57_u8 {
                ret false
            }
            if code >= 65_u8 && code <= 90_u8 {
                ret false
            }
            if code >= 97_u8 && code <= 122_u8 {
                ret false
            }
            ret true
        }
        Option[u8]::None => {
            ret true
        }
    }
}

fn is_keyword(raw: str) -> bool {
    if raw == "fn" || raw == "import" || raw == "match" || raw == "ret" {
        ret true
    }
    if raw == "let" || raw == "mut" || raw == "pub" || raw == "as" {
        ret true
    }
    ret false
}

fn is_integer(raw: str) -> bool {
    let mut i = 0_usize
    if raw.len() == 0_usize {
        ret false
    }
    while i < raw.len() {
        match raw.get_byte(i) {
            Option[u8]::Some(code) => {
                if code < 48_u8 || code > 57_u8 {
                    ret false
                }
            }
            Option[u8]::None => {
                ret false
            }
        }
        i = i + 1_usize
    }
    ret true
}

fn usz(value: usize) -> str {
    ret usize_to_str(value)
}

fn usize_to_str(value: usize) -> str {
    if value == 0_usize {
        ret "0"
    }

    let mut n = value
    let mut rev = ""
    while n > 0_usize {
        let d = n % 10_usize
        rev = rev + digit_to_char(d)
        n = n / 10_usize
    }

    let mut out = ""
    let mut i = rev.len()
    while i > 0_usize {
        match rev.get(i - 1_usize) {
            Option[str]::Some(ch) => {
                out = out + ch
            }
            Option[str]::None => {}
        }
        i = i - 1_usize
    }
    ret out
}

fn digit_to_char(value: usize) -> str {
    if value == 0_usize { ret "0" }
    if value == 1_usize { ret "1" }
    if value == 2_usize { ret "2" }
    if value == 3_usize { ret "3" }
    if value == 4_usize { ret "4" }
    if value == 5_usize { ret "5" }
    if value == 6_usize { ret "6" }
    if value == 7_usize { ret "7" }
    if value == 8_usize { ret "8" }
    ret "9"
}

fn render_unknown_trace(source: str, line: usize, column: usize) -> () {
    println(status_fail("Unknown token at " + usz(line) + ":" + usz(column)))

    let line_start = find_line_start(source, line, column)
    let line_end = find_line_end(source, line, column)
    let text = source.slice(line_start, line_end - line_start)
    println("  " + text)
    println("  " + repeat(" ", column - 1_usize) + "^")
    ret ()
}

fn find_line_start(source: str, line: usize, column: usize) -> usize {
    ret abs_index_from_line_col(source, line, column) - (column - 1_usize)
}

fn find_line_end(source: str, line: usize, column: usize) -> usize {
    let mut i = abs_index_from_line_col(source, line, column)
    while i < source.len() {
        match source.get_byte(i) {
            Option[u8]::Some(b) => {
                if b == 10_u8 {
                    break
                }
            }
            Option[u8]::None => {
                break
            }
        }
        i = i + 1_usize
    }
    ret i
}

fn abs_index_from_line_col(source: str, target_line: usize, target_col: usize) -> usize {
    let mut i = 0_usize
    let mut line = 1_usize
    let mut col = 1_usize
    while i < source.len() {
        if line == target_line && col == target_col {
            ret i
        }
        match source.get_byte(i) {
            Option[u8]::Some(b) => {
                if b == 10_u8 {
                    line = line + 1_usize
                    col = 1_usize
                }
                else {
                    col = col + 1_usize
                }
            }
            Option[u8]::None => {
                break
            }
        }
        i = i + 1_usize
    }
    ret i
}

fn repeat(ch: str, times: usize) -> str {
    let mut out = ""
    let mut i = 0_usize
    while i < times {
        out = out + ch
        i = i + 1_usize
    }
    ret out
}

fn find_project_root(path: Path) -> Option[Path] {
    if Path::exists(path.join("encore.toml")) {
        ret Option[Path]::Some(path)
    }

    match Path::parent(path) {
        Option[Path]::Some(parent) => {
            ret find_project_root(parent)
        }
        Option[Path]::None => {
            ret Option[Path]::None
        }
    }
}
