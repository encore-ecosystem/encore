enum Command {
    Halt
    Load(u32)
    Store(u32)
}

fn eval(command: Command, acc: u32) -> u32 {
    ret match command {
        Halt => acc
        Load(value) => value
        Store(value) => acc + value
    }
}

fn main() -> u32 {
    let load = Command::Load(5_u32)
    let store = Command::Store(7_u32)
    let halt = Command::Halt

    ret eval(load, 0_u32) + eval(store, 3_u32) + eval(halt, 2_u32)
}
