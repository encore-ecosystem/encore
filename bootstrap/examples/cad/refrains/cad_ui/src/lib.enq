    ret Theme {
        "graphite dark",
        rgb(18_u32, 20_u32, 24_u32),
        rgb(30_u32, 35_u32, 42_u32),
        rgb(38_u32, 43_u32, 50_u32),
        rgb(78_u32, 87_u32, 96_u32),
        rgb(22_u32, 25_u32, 30_u32),
        rgb(46_u32, 52_u32, 60_u32),
        rgb(78_u32, 89_u32, 100_u32),
        rgb(230_u32, 92_u32, 86_u32),
        rgb(108_u32, 164_u32, 246_u32),
        rgb(45_u32, 210_u32, 172_u32),
        rgb(25_u32, 159_u32, 132_u32),
        rgb(236_u32, 174_u32, 71_u32),
        rgb(235_u32, 239_u32, 244_u32),
        rgb(163_u32, 172_u32, 184_u32),
        rgb(235_u32, 239_u32, 244_u32),
        rgb(30_u32, 35_u32, 42_u32)
    }
}

pub fn theme_blueprint() -> Theme {
    ret Theme {
        "blueprint",
        rgb(16_u32, 43_u32, 72_u32),
        rgb(11_u32, 31_u32, 53_u32),
        rgb(20_u32, 55_u32, 89_u32),
        rgb(78_u32, 130_u32, 170_u32),
        rgb(18_u32, 49_u32, 82_u32),
        rgb(36_u32, 77_u32, 112_u32),
        rgb(77_u32, 137_u32, 180_u32),
        rgb(247_u32, 130_u32, 113_u32),
        rgb(108_u32, 178_u32, 246_u32),
        rgb(78_u32, 232_u32, 195_u32),
        rgb(130_u32, 221_u32, 242_u32),
        rgb(255_u32, 190_u32, 90_u32),
        rgb(235_u32, 246_u32, 255_u32),
        rgb(171_u32, 204_u32, 226_u32),
        rgb(235_u32, 246_u32, 255_u32),
        rgb(11_u32, 31_u32, 53_u32)
    }
}

impl for Theme {
    pub fn name(self: Theme) -> str { ret self.name }
    pub fn background(self: Theme) -> u32 { ret self.background }
    pub fn toolbar(self: Theme) -> u32 { ret self.toolbar }
    pub fn panel(self: Theme) -> u32 { ret self.panel }
    pub fn panel_line(self: Theme) -> u32 { ret self.panel_line }
    pub fn viewport(self: Theme) -> u32 { ret self.viewport }
    pub fn grid_minor(self: Theme) -> u32 { ret self.grid_minor }
    pub fn grid_major(self: Theme) -> u32 { ret self.grid_major }
    pub fn axis_x(self: Theme) -> u32 { ret self.axis_x }
    pub fn axis_y(self: Theme) -> u32 { ret self.axis_y }
    pub fn accent(self: Theme) -> u32 { ret self.accent }
    pub fn accent_dark(self: Theme) -> u32 { ret self.accent_dark }
    pub fn warning(self: Theme) -> u32 { ret self.warning }
    pub fn ink(self: Theme) -> u32 { ret self.ink }
    pub fn muted(self: Theme) -> u32 { ret self.muted }
    pub fn text_on_toolbar(self: Theme) -> u32 { ret self.text_on_toolbar }
    pub fn status(self: Theme) -> u32 { ret self.status }
}

impl for Window {
    pub fn create(title: str, width: u32, height: u32) -> Window {
        let handle = unsafe {
            cad_gui_window_create(title, width, height)
        }
        ret Window { handle, width, height }
    }

    pub fn available(self: Window) -> bool {
        ret self.handle != 0_usize
    }

    pub fn is_open(self: Window) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_is_open(self.handle)
        }
    }

    pub fn poll(self: Window) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_poll(self.handle)
        }
    }

    pub fn clear(self: Window, color: u32) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_clear(self.handle, color)
        }
    }

    pub fn rect(self: Window, x: i32, y: i32, width: u32, height: u32, color: u32) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_fill_rect(self.handle, x, y, width, height, color)
        }
    }

    pub fn line(self: Window, x0: i32, y0: i32, x1: i32, y1: i32, color: u32) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_line(self.handle, x0, y0, x1, y1, color)
        }
    }

    pub fn text(self: Window, x: i32, y: i32, value: str, color: u32) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_text(self.handle, x, y, value, color)
        }
    }

    pub fn set_font(self: Window, value: str) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_set_font(self.handle, value)
        }
    }

    pub fn event_kind(self: Window) -> u32 {
        if self.handle == 0_usize {
            ret event_none()
        }
        unsafe {
            ret cad_gui_window_event_kind(self.handle)
        }
    }

    pub fn event_x(self: Window) -> i32 {
        if self.handle == 0_usize {
            ret 0_i32
        }
        unsafe {
            ret cad_gui_window_event_x(self.handle)
        }
    }

    pub fn event_y(self: Window) -> i32 {
        if self.handle == 0_usize {
            ret 0_i32
        }
        unsafe {
            ret cad_gui_window_event_y(self.handle)
        }
    }

    pub fn event_key(self: Window) -> u32 {
        if self.handle == 0_usize {
            ret 0_u32
        }
        unsafe {
            ret cad_gui_window_event_key(self.handle)
        }
    }

    pub fn present(self: Window) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_present(self.handle)
        }
    }

    pub fn destroy(self: Window) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret cad_gui_window_destroy(self.handle)
        }
    }
}
