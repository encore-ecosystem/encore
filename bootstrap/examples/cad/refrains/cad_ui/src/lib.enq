extern fn cad_gui_window_create(title: str, width: u32, height: u32) -> usize
extern fn cad_gui_window_is_open(handle: usize) -> bool
extern fn cad_gui_window_poll(handle: usize) -> bool
extern fn cad_gui_window_clear(handle: usize, color: u32) -> bool
extern fn cad_gui_window_fill_rect(handle: usize, x: i32, y: i32, width: u32, height: u32, color: u32) -> bool
extern fn cad_gui_window_line(handle: usize, x0: i32, y0: i32, x1: i32, y1: i32, color: u32) -> bool
extern fn cad_gui_window_text(handle: usize, x: i32, y: i32, value: str, color: u32) -> bool
extern fn cad_gui_window_set_font(handle: usize, value: str) -> bool
extern fn cad_gui_window_event_kind(handle: usize) -> u32
extern fn cad_gui_window_event_x(handle: usize) -> i32
extern fn cad_gui_window_event_y(handle: usize) -> i32
extern fn cad_gui_window_event_key(handle: usize) -> u32
extern fn cad_gui_window_present(handle: usize) -> bool
extern fn cad_gui_window_destroy(handle: usize) -> bool

pub struct Window {
    handle: usize
    width: u32
    height: u32
}

pub struct Theme {
    name: str
    background: u32
    toolbar: u32
    panel: u32
    panel_line: u32
    viewport: u32
    grid_minor: u32
    grid_major: u32
    axis_x: u32
    axis_y: u32
    accent: u32
    accent_dark: u32
    warning: u32
    ink: u32
    muted: u32
    text_on_toolbar: u32
    status: u32
}

pub fn rgb(red: u32, green: u32, blue: u32) -> u32 {
    ret ((red & 255_u32) << 16_u32) | ((green & 255_u32) << 8_u32) | (blue & 255_u32)
}

pub fn event_none() -> u32 { ret 0_u32 }
pub fn event_key() -> u32 { ret 1_u32 }
pub fn event_mouse_down() -> u32 { ret 2_u32 }
pub fn event_mouse_up() -> u32 { ret 3_u32 }
pub fn event_mouse_move() -> u32 { ret 4_u32 }

pub fn white() -> u32 { ret rgb(255_u32, 255_u32, 255_u32) }
pub fn black() -> u32 { ret rgb(12_u32, 14_u32, 18_u32) }
pub fn graphite() -> u32 { ret rgb(34_u32, 38_u32, 46_u32) }
pub fn panel() -> u32 { ret rgb(246_u32, 248_u32, 250_u32) }
pub fn panel_line() -> u32 { ret rgb(206_u32, 212_u32, 218_u32) }
pub fn viewport() -> u32 { ret rgb(252_u32, 253_u32, 255_u32) }
pub fn grid_minor() -> u32 { ret rgb(226_u32, 232_u32, 238_u32) }
pub fn grid_major() -> u32 { ret rgb(184_u32, 194_u32, 204_u32) }
pub fn accent() -> u32 { ret rgb(18_u32, 168_u32, 138_u32) }
pub fn accent_dark() -> u32 { ret rgb(9_u32, 117_u32, 96_u32) }
pub fn amber() -> u32 { ret rgb(225_u32, 153_u32, 42_u32) }
pub fn ink() -> u32 { ret rgb(28_u32, 32_u32, 38_u32) }
pub fn muted() -> u32 { ret rgb(95_u32, 105_u32, 118_u32) }

pub fn theme_light() -> Theme {
    ret Theme {
        "precision light",
        white(),
        graphite(),
        panel(),
        panel_line(),
        viewport(),
        grid_minor(),
        grid_major(),
        rgb(198_u32, 76_u32, 76_u32),
        rgb(70_u32, 126_u32, 204_u32),
        accent(),
        accent_dark(),
        amber(),
        ink(),
        muted(),
        white(),
        rgb(238_u32, 242_u32, 246_u32)
    }
}

