enum Direction {
    Up
    Down
    Left
    Right
}

fn score(direction: Direction) -> u32 {
    ret match direction {
        Up => 1_u32
        Down => 2_u32
        Left => 4_u32
        Right => 8_u32
    }
}

fn main() -> u32 {
    let lhs = Direction::Left
    let rhs = Direction::Up
    ret score(lhs) + score(rhs)
}
