import std::option::Option
import std::vec::Vec

fn unwrap_or_zero(opt: Option[usize]) -> usize {
    ret match opt {
        Some(value) => value
        None => 0_usize
    }
}

fn main() -> usize {
    let mut vec: Vec[usize] = Vec[usize]::new()
    vec = vec.push(5_usize)
    vec = vec.push(7_usize)

    let first = unwrap_or_zero(vec.get(0_usize))
    let second = unwrap_or_zero(vec.get(1_usize))
    let meta = vec.len() + vec.capacity()

    vec.free()
    ret first + second + meta
}
