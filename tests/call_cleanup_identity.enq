//! Separate calls in one block must not reuse cleanup SSA names.
struct Payload {
    text: str
}
impl for Payload {
    fn new(text: str) -> Self {
        ret Self {
            text
        }
    }
    fn length(self: mut Self) -> usize {
        ret self.text.len()
    }
}
fn main() -> u32 {
    let first = Payload::new("first").length()
    let second = Payload::new("second").length()
    if first != 5 || second != 6 {
        ret 1
    }
    ret 0
}
