import core::future::{Context, Future, Poll, context}

struct Never {
    value: str
}

impl Future[u32] for Never {
    fn poll(self: Never, context: Context) -> Poll[Never, u32] {
        ret Poll[Never, u32]::Pending(self)
    }
}

fn poll_once[T, F: Future[T]](future: F) -> Poll[F, T] {
    ret future.poll(context(0_usize))
}

async fn suspended(future: Never, label: str) -> u32 {
    let offset = 1_u32
    let value = await future
    if label == "owned" { ret value + offset }
    ret value
}

fn main() -> u32 {
    let future = suspended(Never{"child"}, "owned")
    let step = poll_once[u32, __encore_future_suspended](future)
    match step {
        Poll[__encore_future_suspended, u32]::Pending(cancelled) => { ret 0_u32 }
        Poll[__encore_future_suspended, u32]::Ready(_) => { ret 1_u32 }
    }
}
