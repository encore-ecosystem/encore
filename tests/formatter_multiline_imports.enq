//! Sorting imports must move complete declarations, not their opening lines.
import refrain::formatter::{FormatConfig, format_source}
import std::io::eprintln

fn main() -> u32 {
    let source = "import core::option::Option\nimport core::fmt::{Debug,\n}\nfn main() -> u32 { ret 0 }\n"
    let expected = "import core::fmt::Debug\nimport core::option::Option\nfn main() -> u32 {\n    ret 0\n}\n"
    let first = format_source(source, FormatConfig::new())
    if !first.is_valid() || first.text() != expected {
        eprintln("Actual:\n" + first.text() + "Expected:\n" + expected)
        ret 1
    }
    let repeated = format_source(first.text(), FormatConfig::new())
    ret if repeated.is_valid() && !repeated.is_changed() { 0 } else { 2 }
}
