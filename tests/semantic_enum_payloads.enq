//! Editor inference follows enum declarations, imports and interface edits.
import refrain::frontend::analysis_database::{AnalysisDatabase, SymbolId}
import refrain::frontend::semantic::SemanticBody
import std::io::eprintln
fn clean(database: mut AnalysisDatabase) -> bool {
    let symbol = database.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    let body = database.semantic_body(symbol).unwrap_or(SemanticBody::empty())
    for diagnostic in body.diagnostics {
        if diagnostic.severity == 1 {
            eprintln(diagnostic.message) ret false
        }
    }
    let mut found = false
    for site in body.scoped_bindings {
        if site.binding.name == "selected" {
            found = true
        }
        if site.binding.name == "selected" && site.binding.typ != "str" {
            eprintln(site.binding.typ) ret false
        }
    }
    ret found
}
fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("model", "model.enq", "pub enum Choice[A, B] { Value(B) Other(A) }\n")
    database.set_module("app", "app.enq", "import model::Choice as Alias\nfn sample(item: Alias[u32, str]) -> usize { ret match item { Alias::Value(value) => { let selected = value selected.byte_len() } Alias::Other(other) => other as usize } }\n")
    if !clean(database) {
        ret 1
    }
    // Keep the same nominal enum identity while changing only its payload.
    database.set_module("model", "model.enq", "pub enum Choice[A, B] { Value(A) Other(A) }\n")
    let symbol = database.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    let body = database.semantic_body(symbol).unwrap_or(SemanticBody::empty())
    let mut refreshed = false
    for site in body.scoped_bindings {
        if site.binding.name == "selected" && site.binding.typ == "u32" {
            refreshed = true
        }
    }
    if !refreshed {
        ret 2
    }
    database.set_module("model", "model.enq", "pub enum Choice[A, B] { Value(B) Other(A) }\n")
    if !clean(database) {
        ret 3
    }
    ret 0
}
