//! Signature matching preserves both inline-place and owning-node arguments.
import core::vec::Vec

struct Entry {
    value: u32
}
struct Delta {
    patches: Vec[Entry]
    enabled: bool
}
struct Counter {
    value: u32
}

fn collect(next: mut Vec[Entry], delta: mut Delta&) ->() {
    delta.patches.push(Entry { 7 })
    next.push(Entry { 42 })
    ret()
}
fn increment(counter: mut Counter, delta: mut Delta&) ->() {
    counter.value += 1
    delta.enabled = false
    ret()
}

fn main() -> u32 {
    let mut next = Vec[Entry]::new()
    let mut stack = Delta<S>{ Vec[Entry]::new(), true }
    collect(next, stack)
    let mut heap = Delta<H>{ Vec[Entry]::new(), true }
    collect(next,(heap))
    let fallback = Entry { 0 }
    if next.len() != 2 || next.get(1).unwrap_or(fallback).value != 42 ||
    stack.patches.len() != 1 || heap.patches.len() != 1 {
        ret 1
    }
    let mut counter = Counter { 41 }
    increment(counter, heap)
    ret if counter.value == 42 && !heap.enabled {
        0
    } else {
        2
    }
}
