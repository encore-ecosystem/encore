import core::testing::*

#cfg(any(target_os = "linux", target_os = "macos"))
fn selected() -> u32 {
    ret 42_u32
}

#cfg(windows)
fn selected() -> u32 {
    ret 7_u32
}

#cfg(all(unix, not(windows)))
fn platform_family() -> u32 {
    ret 1_u32
}

#cfg(windows)
fn platform_family() -> u32 {
    ret 2_u32
}

#cfg(unix)
fn expected_selected() -> u32 {
    ret 42_u32
}

#cfg(windows)
fn expected_selected() -> u32 {
    ret 7_u32
}

#cfg(unix)
fn expected_platform_family() -> u32 {
    ret 1_u32
}

#cfg(windows)
fn expected_platform_family() -> u32 {
    ret 2_u32
}

fn main() -> u32 {
    if !assert(selected() == expected_selected()) {
        ret 1_u32
    }
    if !assert(platform_family() == expected_platform_family()) {
        ret 1_u32
    }
    ret 0_u32
}
