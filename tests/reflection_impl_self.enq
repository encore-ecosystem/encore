//! Regression for issue #161.
import core::future::{Future, Poll, Context, context}
import core::reflect
struct Reflected[T] {
    value: T
}

impl[T] Future[T] for Reflected[T] {
    pub fn poll(self: Self, ctx: Context) -> Poll[Self, T] {
        let name = reflect::type_info[T]().name()
        ret Poll[Self, T]::Ready(self.value)
    }
}
fn main() -> u32 {
    let future = Reflected[u32] { 42_u32 }
    ret match future.poll(context(0_usize)) {
        Poll::Ready(value) => if value == 42_u32 {
            0_u32
        } else {
            1_u32
        }
        Poll::Pending(_) => 2_u32
    }
}
