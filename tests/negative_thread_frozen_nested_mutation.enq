// @expect.compile_error=is not available through frozen region 'inner'
import core::option::Option
import core::vec::Vec

fn mutate(values: frozen Vec[Vec[str]]) -> usize {
    match values.get(0_usize) {
        Option::Some(inner) => {
            inner.push("forbidden")
            ret inner.len()
        }
        Option::None => { ret 0_usize }
    }
}

fn main() -> u32 {
    ret mutate(Vec[Vec[str]]::new()) as u32
}
