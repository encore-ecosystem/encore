struct Counter {
    value: u32
}

fn read_counter(counter: Counter&) -> u32 {
    ret counter.value
}

impl for Counter {
    fn read(self: Self&) -> u32 {
        ret read_counter(self)
    }
}

fn main() -> i32 {
    let counter = Counter<S> { 42_u32 }
    if counter.read() != 42_u32 {
        ret 1
    }
    ret 0
}
