//! Associated calls specialize declared parameters and results, not their name.

import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    let declarations = "pub struct Box[Element] { value: Element }\nimpl[Element] for Box[Element] { pub fn new(value: Element) -> Self { ret Self { value } } pub fn label() -> str { ret \"box\" } pub fn read(self: Self) -> Element { ret self.value } }\n"
    db.set_module("model", "model.enq", declarations)
    db.set_module("app", "app.enq", "import model::Box\nfn sample() { let boxed = Box[u32]::new(1_u32) let label = Box[u32]::label() let value = boxed.read() let contextual = Box[u16]::new(1) }\nfn invalid() { let wrong = Box[u32]::new(\"no\") let missing = Box[u32]::absent() }")
    let id = db.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    let body = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(body.binding_type("boxed").unwrap_or("") == "Box[u32]") { ret 1_u32 }
    if !assert(body.binding_type("label").unwrap_or("") == "str") { ret 2_u32 }
    if !assert(body.binding_type("value").unwrap_or("") == "u32") { ret 3_u32 }
    if !assert(body.binding_type("contextual").unwrap_or("") == "Box[u16]") { ret 10_u32 }
    db.semantic_body(id)
    if !assert(db.semantic_body_count(id) == 1_usize) { ret 4_u32 }
    let invalid_id = db.symbol_id("app", "invalid").unwrap_or(SymbolId::invalid())
    let invalid = db.semantic_body(invalid_id).unwrap_or(SemanticBody::empty())
    if !assert(invalid.binding_type("wrong").unwrap_or("") == "") { ret 5_u32 }
    if !assert(invalid.binding_type("missing").unwrap_or("") == "") { ret 6_u32 }
    for member in db.members_for_type("app", "Box[u32]") {
        if !assert(member.name != "new" && member.name != "label") { ret 7_u32 }
    }
    db.set_module("model", "model.enq", "pub struct Box[Element] { value: Element }\nimpl[Element] for Box[Element] { pub fn new(value: Element) -> Self { ret Self { value } } pub fn label() -> bool { ret true } pub fn read(self: Self) -> Element { ret self.value } }")
    let changed = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(changed.binding_type("label").unwrap_or("") == "bool") { ret 8_u32 }
    if !assert(db.semantic_body_count(id) == 2_usize) { ret 9_u32 }
    let mut aliases = AnalysisDatabase::new()
    aliases.set_module("model", "same-file.enq", declarations)
    aliases.set_module("mirror", "same-file.enq", declarations)
    aliases.set_module("app", "app.enq", "import model::Box\nimport mirror::Box as Mirror\nfn main() {}")
    let details = aliases.associated_member_details("app", "Box[u32]", "new")
    if !assert(details.is_some()) { ret 11_u32 }
    let original = aliases.associated_member_definition("model", "Box[u32]", "new")
    let mirror = aliases.associated_member_definition("mirror", "Box[u32]", "new")
    match original {
        Some(first) => {
            match mirror {
                Some(second) => { if !assert(first.source_identity().key() == second.source_identity().key()) { ret 12_u32 } }
                None => { ret 13_u32 }
            }
        }
        None => { ret 14_u32 }
    }
    let mut separate = AnalysisDatabase::new()
    separate.set_module("left", "left.enq", "pub struct Box[T] {}\nimpl[T] for Box[T] { pub fn new() -> u32 { ret 1_u32 } pub fn left() -> bool { ret true } }")
    separate.set_module("right", "right.enq", "pub struct Box[T] {}\nimpl[T] for Box[T] { pub fn new() -> str { ret \"right\" } pub fn right() -> bool { ret true } }")
    separate.set_module("use", "use.enq", "import left::Box as Left\nimport right::Box as Right\nfn main() {}")
    let left = separate.associated_members_for_type("use", "Left[u32]")
    let right = separate.associated_members_for_type("use", "Right[u32]")
    if !assert(left.len() == 2_usize && right.len() == 2_usize) { ret 15_u32 }
    for member in left {
        if !assert(member.name != "right") { ret 16_u32 }
        if member.name == "new" && !assert(member.typ == "u32") { ret 17_u32 }
    }
    for member in right {
        if !assert(member.name != "left") { ret 18_u32 }
        if member.name == "new" && !assert(member.typ == "str") { ret 19_u32 }
    }
    if !assert(separate.associated_member_details("use", "left::Box[u32]", "new").is_some()) { ret 20_u32 }
    if !assert(separate.associated_member_definition("use", "Right[u32]", "new").is_some()) { ret 21_u32 }
    separate.set_module("extension", "extension.enq", "import left::Box as Imported\nimpl[T] for Imported[T] { pub fn extra() -> u16 { ret 1_u16 } }\npub fn marker() {}")
    separate.set_module("use", "use.enq", "import left::Box as Left\nimport right::Box as Right\nimport extension::marker\nfn main() {}")
    if !assert(separate.associated_member_details("use", "Left[u32]", "extra").is_some()) { ret 22_u32 }
    if !assert(separate.associated_member_details("use", "Right[u32]", "extra").is_none()) { ret 23_u32 }
    ret 0_u32
}
