//! Unit arguments use a typed unit value in free, method and enum calls.
struct Receiver {
}

impl for Receiver {
    fn read(self: Self, unit:()) -> u32 {
        ret 13_u32
    }
}
enum UnitChoice {
    Item(())
    Empty
}
fn unit() ->() {
    ret()
}
fn accept(value:(), number: u32) -> u32 {
    ret number
}
fn main() -> u32 {
    if accept(unit(), 7_u32) != 7_u32 {
        ret 1_u32
    }
    let receiver = Receiver {}
    if receiver.read(()) != 13_u32 {
        ret 2_u32
    }
    let choice = UnitChoice::Item(())
    let result = match choice {
        Item(value) => accept(value, 17_u32) Empty => 0_u32
    }
    if result != 17_u32 {
        ret 3_u32
    }
    ret 0_u32
}
