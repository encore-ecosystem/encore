//! Editor analysis and lowering agree on placement-aware generic inference.
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    let declarations = "struct Counter { value: u32 }\nstruct Holder[Item] { item: Item }\n"
    + "fn identity[Value](value: Value) -> Value { ret value }\n"
    + "fn heap[Value](value: Value<H>, flag: bool) -> Value<H> { ret value }\n"
    + "fn erased[Value](value: Value&) -> Value& { ret value }\n"
    + "fn nested[Value](value: Holder[Value]<H>) -> Value { ret value.item }\n"
    database.set_module("placed", "placed.enq", declarations
        + "fn sample() {\n let node = Counter<H>{ 1 }\n let local = Counter<S>{ 2 }\n"
        + " let copied = identity(node)\n let selected = heap(node, false)\n let reference = erased(local)\n"
        + " let holder = Holder[Counter<H>]<H>{ node }\n let item = nested(holder)\n}\n",)
    let id = database.symbol_id("placed", "sample").unwrap_or(SymbolId::invalid())
    let body = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    if body.diagnostics.len() != 0 {
        ret 1
    }
    if body.binding_type("copied").unwrap_or("") != "Counter<H>" {
        ret 2
    }
    if body.binding_type("selected").unwrap_or("") != "Counter<H>" {
        ret 3
    }
    if body.binding_type("reference").unwrap_or("") != "Counter&" {
        ret 4
    }
    if body.binding_type("item").unwrap_or("") != "Counter<H>" {
        ret 5
    }
    database.set_module("placed", "placed.enq", declarations
        + "fn sample() { let node = Counter<S>{ 1 } let bad = heap(node, false) }\n",)
    let changed = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    ret if changed.diagnostics.len() > 0 {
        0
    } else {
        6
    }
}
