import core::future::{Context, Future, Poll}
import std::future::block_on

struct Once {
    pending: bool
    value: u32
}

impl Future[u32] for Once {
    fn poll(self: Once, context: Context) -> Poll[Once, u32] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, u32]::Pending(Once{false, self.value})
        }
        ret Poll[Once, u32]::Ready(self.value)
    }
}

async fn combine(first: Once, second: Once, include_second: bool) -> u32 {
    let base = 10_u32
    let left = await first
    if include_second {
        let right = await second
        ret base + left + right
    }
    ret base + left
}

fn main() -> u32 {
    let pending = combine(Once{true, 2_u32}, Once{true, 3_u32}, true)
    let value = block_on[u32, __encore_future_combine](pending)
    if value != 15_u32 { ret 1_u32 }
    let short = combine(Once{true, 2_u32}, Once{true, 99_u32}, false)
    let short_value = block_on[u32, __encore_future_combine](short)
    if short_value == 12_u32 { ret 0_u32 }
    ret 1_u32
}
