// @expect.compile_error=thread-transfer-requires-sending
import core::result::Result
import std::sync::{Receiver, bounded}
fn consume(input: Receiver[u32]) -> u32 {
    ret input.try_receive().unwrap_or(0_u32)
}
fn main() -> u32 {
    let pair = match bounded[u32](1_usize) {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let worker = spawn consume(pair.1)
    ret worker.join()
}
