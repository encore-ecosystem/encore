import std::path::Path
import refrain::project::manifest::{read_project_manifest, project_manifest_dependencies}

fn main() -> u32 {
    let manifest = read_project_manifest(Path::new("."))
    let count = manifest.dependencies.len()
    for dependency in manifest.dependencies {
        if dependency == "sys@core" { ret 1_u32 }
    }
    let first = project_manifest_dependencies(manifest)
    let second = project_manifest_dependencies(manifest)
    if first.len() != count + 1_usize { ret 2_u32 }
    if second.len() != first.len() { ret 3_u32 }
    if manifest.dependencies.len() != count { ret 4_u32 }
    ret 0_u32
}
