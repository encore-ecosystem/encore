//! Entering a context copies a named inline owner; returning a field keeps it alive.
import core::ops::ContextManager

struct Resource {
    text: str
}
impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret true
    }
}

fn field(resource: Resource) -> str {
    with resource as entered {
        ret entered.text
    }
}

fn copied() -> Resource {
    with Resource {
        "owned " + "resource"
    }
    as entered {
        ret entered
    }
}

fn main() -> u32 {
    for index in 0..100 {
        let copy = copied()
        if copy.text != "owned resource" {
            ret 5_u32
        }
        let resource = Resource {
            "owned " + "resource"
        }
        let text = field(resource)
        if text != "owned resource" {
            ret 1_u32
        }
        if resource.text != "owned resource" {
            ret 2_u32
        }
        with resource as entered {
            if entered.text != text {
                ret 3_u32
            }
        }
        if resource.text != text {
            ret 4_u32
        }
    }
    ret 0_u32
}
