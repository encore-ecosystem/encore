import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source =
    "struct EHIRLLVMBackend { value: u32 }\n" +
    "struct Bucket[T] { value: T }\n" +
    "impl[T] for Bucket[T] {\n" +
    "  fn new(value: T) -> Bucket[T] { ret Bucket[T]{value} }\n" +
    "  fn singleton(value: T) -> Bucket[T] {\n" +
    "    let mut out = Bucket[T]::new(value)\n" +
    "    ret out\n" +
    "  }\n" +
    "}\n" +
    "fn backend() -> EHIRLLVMBackend { ret EHIRLLVMBackend{7_u32} }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("generic_qualified_static_call.enq")
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if !output.contains("out_0: Bucket[T]* = salloc Bucket[T]") { ret 1_u32 }
    if !output.contains("call Bucket::new[T](value)") { ret 2_u32 }
    if output.contains("mut EHIRLLVMBackend") { ret 3_u32 }
    ret 0_u32
}
