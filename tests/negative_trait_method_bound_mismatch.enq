// @expect.compile_error=error[trait-method-bound-mismatch]: generic parameter 'U' of method 'identity' adds bound 'Marker' not required by the trait

trait Marker {}

trait Identity {
    fn identity[T](self: Self, value: T) -> T
}

struct Value {}

impl Identity for Value {
    fn identity[U:Marker](self: Self, value: U) -> U {
        ret value
    }
}

fn main() -> u32 {
    ret 0_u32
}
