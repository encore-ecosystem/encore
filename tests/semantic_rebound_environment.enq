//! Rechecked bodies must use the rebound environment, not saved dense ordinals.
import core::option::Option
import core::testing::assert

import std::vec::Vec

import json::Json

import refrain::frontend::AnalysisDatabase
import refrain::frontend::analysis_database::check_prepared_safety_module
import refrain::frontend::hir::TypeId
import refrain::frontend::semantic_index::PackageSemanticIndex
import refrain::frontend::semantic_rebind::rebind_semantic_replay
import refrain::target::host_target

fn database(source: str) -> AnalysisDatabase {
    let mut db = AnalysisDatabase::new()
    db.set_module("api", "api.enq", "pub struct Data { value: u32 }\npub fn make() -> Data { ret Data{42_u32} }\n")
    db.set_module("app", "app.enq", source)
    for module in vec!["api", "app"] {
        db.configure_safety(module, host_target(), Vec[str]::new())
    }
    ret db
}

fn main() -> u32 {
    let before = "import api::Data\nfn sample() -> u32 { let first = api::make() ret first.value }\n"
    let after = "import api::Data\nfn sample() -> u32 { let second = api::make() ret second.value }\n"
    let modules = vec!["api", "app"]
    let mut cold = database(before)
    let identity = cold.semantic_package_identity(modules)
    cold.prepare_package_semantics(modules, identity, Option[PackageSemanticIndex]::None)
    let checked = cold.prepare_module_safety_with_replay("app", host_target(), Vec[str]::new(), Json::Null, before)
    let replay = cold.finalize_semantic_replay("app", checked.replay)
    let snapshot = cold.package_semantic_index().unwrap_or(PackageSemanticIndex::empty())
    let mut warm = database(after)
    warm.semantic_type_rebinding(vec![TypeId::named("unrelated:first", "Unrelated")])
    let warm_identity = warm.semantic_package_identity(modules)
    warm.prepare_package_semantics(modules, warm_identity, Option[PackageSemanticIndex]::None)
    let mapping = warm.semantic_type_rebinding(snapshot.types)
    let rebound = rebind_semantic_replay(replay, mapping)
    let observed = warm.prepare_module_safety_with_replay("app", host_target(), Vec[str]::new(), rebound, after)
    if !assert(observed.diagnostics.is_empty()) {
        ret 1_u32
    }
    match observed.functions.get(0_usize) {
        Some(function) => {
            if !assert(function.body.binding_type("second").unwrap_or("") == "Data") {
                ret 2_u32
            }
        }
        None => {
            ret 3_u32
        }
    }
    ret 0_u32
}
