//! Nested commas must not change a grouped expression into a one-element tuple.
import core::option::Option
import refrain::formatter::{FormatConfig, format_source}
import refrain::frontend::{Lexer, Parser, Statement}
import refrain::frontend::parser::statements::Expr

fn grouped_match_argument(source: str) -> bool {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    for statement in parser.parse(lexer.tokenize(source)) {
        match statement {
            Statement::Function(item) => {
                if item.name != "main" {
                    continue
                }
                match item.body {
                    Option::Some(body) => {
                        for statement in body.statements {
                            match statement {
                                Statement::Ret(expression) => {
                                    match expression.value {
                                        Expr::Call(call) => {
                                            match call.args.get(0) {
                                                Option::Some(argument) => {
                                                    match argument.value {
                                                        Expr::Parenthesized(inner) => {
                                                            match inner.value {
                                                                Expr::Match(_) => {
                                                                    ret true
                                                                }
                                                                _ => {
                                                                }
                                                            }
                                                        }
                                                        Expr::Match(_) => {
                                                            ret true
                                                        }
                                                        _ => {
                                                        }
                                                    }
                                                }
                                                Option::None => {
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    Option::None => {
                    }
                }
            }
            _ => {
            }
        }
    }
    ret false
}

fn main() -> u32 {
    let source = "fn identity(value: u32, other: str) -> u32 { ret value }\nfn abandon[T, U]() -> u32 { ret 1_u32 }\nfn main() -> u32 { ret identity((match true { true => 0_u32 false => { ret abandon[u32, str]() } }), \"test\") }\n"
    if !grouped_match_argument(source) {
        ret 1
    }
    for style in vec!["vertical", "always", "never"] {
        let config = FormatConfig::new().with_trailing_comma(style)
        let formatted = format_source(source, config)
        if !formatted.is_valid() || !grouped_match_argument(formatted.text()) {
            ret 2
        }
        let repeated = format_source(formatted.text(), config)
        if !repeated.is_valid() || repeated.is_changed() {
            ret 3
        }
    }
    ret 0
}
