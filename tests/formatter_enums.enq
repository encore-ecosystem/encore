//! Enum variants have vertical layout regardless of payload or source newlines.
import refrain::formatter::{FormatConfig, format_source}
import std::io::eprintln

fn layout(source: str, expected: str, config: FormatConfig) -> bool {
    let first = format_source(source, config)
    if !first.is_valid() || first.text() != expected {
        eprintln("Actual:\n" + first.text() + "Expected:\n" + expected)
        ret false
    }
    let second = format_source(first.text(), config)
    ret second.is_valid() && !second.is_changed() && second.text() == expected
}

fn main() -> u32 {
    let config = FormatConfig::new()
    if !layout("pub enum DecimalError {\n    InvalidNumber InvalidScale Overflow DivisionByZero Inexact\n}\n",
        "pub enum DecimalError {\n    InvalidNumber\n    InvalidScale\n    Overflow\n    DivisionByZero\n    Inexact\n}\n", config,) {
        ret 1
    }
    if !layout("enum Choice { None Some(u32) Pair(u32, str) Named { value: u32 label: str } End }\n",
        "enum Choice {\n    None\n    Some(u32)\n    Pair(u32, str)\n    Named {\n        value: u32\n        label: str\n    }\n    End\n}\n", config,) {
        ret 2
    }
    if !layout("enum Choice { First, Second(u32), Third, }\n",
        "enum Choice {\n    First,\n    Second(u32),\n    Third,\n}\n", config,) {
        ret 3
    }
    if !layout("enum Choice { First /// Second variant.\nSecond(u32) /// Last variant.\nLast }\n",
        "enum Choice {\n    First\n    /// Second variant.\n    Second(u32)\n    /// Last variant.\n    Last\n}\n", config,) {
        ret 4
    }
    if !layout("enum Choice { First // Keep the explanation.\nSecond }\n",
        "enum Choice {\n    First // Keep the explanation.\n    Second\n}\n", config,) {
        ret 5
    }
    if !layout("enum Box[T] { Empty Value(T) Other[T](T) }\n",
        "enum Box[T] {\n    Empty\n    Value(T)\n    Other[T](T)\n}\n", config,) {
        ret 6
    }
    if !layout("enum Empty {}\nenum Single { Only }\n",
        "enum Empty {\n}\nenum Single {\n    Only\n}\n", config,) {
        ret 7
    }
    let windows = FormatConfig::new().with_indent_width(2).with_newline_style("crlf")
    if !layout("enum Choice { A B }\n", "enum Choice {\r\n  A\r\n  B\r\n}\r\n", windows) {
        ret 8
    }
    let invalid = "enum Broken { Value( }\n"
    let rejected = format_source(invalid, config)
    ret if !rejected.is_valid() && !rejected.is_changed() && rejected.text() == invalid {
        0
    } else {
        9
    }
}
