import core::option::Option
import core::testing::assert
import std::thread::JoinHandle

fn worker() -> str {
    ret "thread-result"
}

fn main() -> u32 {
    let mut pending = Option[JoinHandle[str]]::None
    pending = Option[JoinHandle[str]]::Some(spawn worker())
    match pending {
        Option::Some(handle) => {
            let result = handle.join()
            if !assert(result == "thread-result") { ret 1_u32 }
        }
        Option::None => { ret 2_u32 }
    }
    pending = Option[JoinHandle[str]]::None
    ret 0_u32
}
