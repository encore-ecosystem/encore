import core::testing:: *

trait Action {
    fn run(self: Self, amount: u32) ->()
}

struct Counter {
    value: u32
}

impl for Counter {
    fn add(self: mut Self &, amount: u32) ->() {
        self.value += amount
        ret()
    }
    fn get(self: Self &) -> u32 {
        ret self.value
    }
}

fn dispatch(action: dyn Action) ->() {
    action.run(2_u32)
    ret()
}

fn main() -> u32 {
    let counter = Counter < H > {
        0_u32
    }
    let action: dyn Action = | amount | {
        counter.add(amount)
        counter.add(amount)
    }
    dispatch(action)
    ret if assert(counter.get() == 4_u32) {
        0_u32
    } else {
        1_u32
    }
}
