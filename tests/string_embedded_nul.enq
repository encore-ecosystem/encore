fn main() -> u32 {
    let nul = "\x00"
    let middle = "a\x00b"
    let unicode_nul = "\u{0}"
    if nul.byte_len() != 1_usize || nul.byte_at(0_usize) != 0_u8 ||
    unicode_nul.byte_len() != 1_usize || unicode_nul.byte_at(0_usize) != 0_u8 {
        ret 1
    }
    if middle.byte_len() != 3_usize || middle.char_len() != 3_usize ||
    middle.byte_at(0_usize) != 97_u8 || middle.byte_at(1_usize) != 0_u8 || middle.byte_at(2_usize) != 98_u8 {
        ret 2
    }
    let joined = nul + "x"
    if joined.byte_len() != 2_usize || joined.byte_at(1_usize) != 120_u8 || "\\x00".byte_len() != 4_usize {
        ret 3
    }
    ret 0
}
