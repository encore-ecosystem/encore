//! The reader's typed metadata tokens and builders survive full EHIR validation.
import ehirlib::{parse_module_text, prepare_module, PreparationOutcome}
import refrain::frontend::translator::translate_to_ehir
import refrain::frontend::{Lexer, Parser}
import std::io::eprintln
fn main() -> u32 {
    let source = "enum Option[T] { Some(T) None }\n" +
    "enum Result[T, E] { Ok(T) Err(E) }\n" +
    "enum BuildError { MissingField(str) }\n" +
    "struct TypeInfo[T] {}\n" +
    "struct Pair { a: u32 b: u32 }\n" +
    "fn read[T](info: TypeInfo[T]) -> Result[T, BuildError] { " +
    "let mut builder = reflect::Builder[T]::new() " +
    "for field in info.fields() { builder.set(field, 42_u32) } ret builder.finish() }\n" +
    "fn main() -> u32 { match read[Pair](reflect::type_info[Pair]()) { Ok(value) => { ret value.a + value.b } Err(_) => { ret 1 } } }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("reflection-builder")
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if output.contains("Builder[") || output.contains("type_info") {
        ret 1
    }
    match prepare_module(parse_module_text("reflection-builder", output)) {
        PreparationOutcome::Ready(_) => {
            ret 0
        }
        PreparationOutcome::Error(message) => {
            eprintln(message) ret 2
        }
    }
}
