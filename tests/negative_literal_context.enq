//! Unary numeric literals use the same context at every invocation boundary.
import core::option::Option

struct Offset {
    x: f32
    y: f32
}

impl for Offset {
    fn new(x: f32, y: f32) -> Self {
        ret Self { x, y }
    }
    fn moved(self: Self, dx: f32, dy: f32) -> Self {
        ret Self { self.x + dx, self.y + dy }
    }
    fn move_mut(self: mut Self, dx: f32) ->() {
        self.x += dx
    }
}
fn add(a: f32, b: f32) -> f32 {
    ret a + b
}
fn double(value: f64) -> f64 {
    ret value
}
fn byte(value: i8) -> i8 {
    ret value
}
fn word(value: i16) -> i16 {
    ret value
}
fn integer(value: i32) -> i32 {
    ret value
}
fn wide(value: i64) -> i64 {
    ret value
}
fn contextual_return() -> f32 {
    ret - 7
}

fn main() -> u32 {
    let moved = Offset::new(0, 0).moved( - 7, - 9)
    if moved.x != - 7.0_f32 || moved.y != - 9.0_f32 {
        ret 1
    }
    if add( - 7, - 9) != - 16.0_f32 || double( - 7) != - 7.0_f64 {
        ret 2
    }
    let chained = moved.moved( - 2, - 3).moved( - 1, - 2)
    if chained.x != - 10.0_f32 || chained.y != - 14.0_f32 {
        ret 3
    }
    let mut changed = Offset::new( - 7, - 9)
    changed.move_mut( - 3)
    if changed.x != - 10.0_f32 {
        ret 4
    }
    let value: f32 = - 7
    let array:[f32;
        2] =[ - 7, - 9]
    let fields = Offset { - 7, - 9 }
    if value != - 7.0_f32 || array[1] != - 9.0_f32 || fields.x != - 7.0_f32 || contextual_return() != value {
        ret 5
    }
    match Option[f32]::Some( - 7) {
        Some(payload) => {
            if payload != value {
                ret 6
            }
        }
        None => {
            ret 7
        }
    }
    if byte( - 128) != - 128_i8 || word( - 32768) != - 32768_i16 {
        ret 8
    }
    if integer( - 2147483648) != - 2147483648_i32 || wide( - 9223372036854775808) != - 9223372036854775808_i64 {
        ret 9
    }
    let explicit = Offset::new(0, 0).moved( - 7_f32, - 9_f32)
    if explicit.x != value || explicit.y != - 9.0_f32 {
        ret 10
    }
    if byte( - 0x80) != - 128_i8 || byte( - 0b10000000) != - 128_i8 || word( - 0o100000) != - 32768_i16 {
        ret 11
    }
    let scale = 2.0_f32
    let arithmetic = Offset::new(0, 0).moved(1 / scale, 62 + scale * 28)
    if arithmetic.x != 0.5_f32 || arithmetic.y != 118.0_f32 {
        ret 12
    }
    if add(scale + 1.0,(1 + 2)) != 6.0_f32 {
        ret 13
    }
    ret 0
}
