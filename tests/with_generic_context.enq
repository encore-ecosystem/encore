//! Generic context methods keep their concrete type arguments on every exit.
import core::ops::ContextManager
struct Scope[T] {
    value: T
}

impl[T] ContextManager for Scope[T] {
    pub fn with_enter(self: Self) -> Self {
        ret self
    }
    pub fn with_exit(self: Self) -> bool {
        ret true
    }
}
fn early() -> u32 {
    with Scope[u32] { 7_u32 } as scoped {
        ret scoped.value
    }
}
fn main() -> u32 {
    with Scope[str] { "generic" } as scoped {
        if scoped.value != "generic" {
            ret 1_u32
        }
    }
    ret if early() == 7_u32 {
        0_u32
    } else {
        2_u32
    }
}
