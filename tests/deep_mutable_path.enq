import core::vec::Vec

struct Values {
    items: Vec[str]
}

struct State {
    values: Values
}

impl for State {
    fn add(self: mut State, value: str) -> () {
        self.values.items.push(value)
    }
}

fn main() -> u32 {
    let mut state = State{Values{Vec[str]::new()}}
    state.values.items.push("direct")
    state.add("method")
    ret if state.values.items.len() == 2_usize { 0_u32 } else { 1_u32 }
}
