//! Lexical block exits restore declarations, not values stored through outer slots (#95).
import core::vec::Vec

extern fn encore_node_debug_live_count() -> usize

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

fn values(enabled: bool) -> Vec[u32] {
    let mut row = Vec[u32]::new()
    row.push(1)
    if enabled {
        let mut row = Vec[u32]::new()
        row.push(99)
    }
    row.push(2)
    ret row
}

fn branches(choice: u32) -> u32 {
    let row = "outer"
    let mut result = 0_u32
    if choice == 0 {
        let row = 11_u32
        result = row
    } elif choice == 1 {
        let row = 22_u32
        result = row
    } else {
        result = row.byte_len() as u32
    }
    ret result + row.byte_len() as u32
}

fn loops() -> u32 {
    let row = "outer"
    let mut result = 0_u32
    let mut count = 0_u32
    while count < 3 {
        let row = "inner" + "row"
        count += 1
        if count == 1 {
            continue
        }
        result += row.byte_len() as u32
    }
    for row in vec![2_u32, 3_u32] {
        result += row
    }
    loop {
        let row = "break" + "row"
        result += row.byte_len() as u32
        break
    }
    do {
        let row = "do" + "row"
        result += row.byte_len() as u32
    }
    while false
    ret result + row.byte_len() as u32
}

fn expression(enabled: bool) -> str {
    let row = "out" + "er"
    let picked = if enabled {
        let row = "in" + "ner"
        row
    } else {
        row
    }
    ret row + ":" + picked
}

#attr(safe)
fn unsafe_scope() -> str {
    let row = "out" + "er"
    unsafe {
        let row = "unused" + "local"
        if row.byte_len() != 11 {
            ret "bad"
        }
    }
    let picked = unsafe {
        let row = "in" + "ner"
        row
    }
    ret row + ":" + picked
}

struct Resource {
    value: u32
}

impl for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret true
    }
}

fn resource_scope() -> usize {
    let row = "outer"
    let mut result = 0_usize
    with Resource { 7 } as row {
        result = row.value as usize
        let local = "owned" + "local"
        result += local.byte_len()
    }
    ret result + row.byte_len()
}

fn exercise() -> u32 {
    for enabled in vec![false, true] {
        let row = values(enabled)
        if row.len() != 2 || row.get(0).unwrap_or(0) != 1 || row.get(1).unwrap_or(0) != 2 {
            ret 1
        }
        let expected = if enabled {
            "outer:inner"
        } else {
            "outer:outer"
        }
        if expression(enabled) != expected {
            ret 2
        }
    }
    if branches(0) != 16 || branches(1) != 27 || branches(2) != 10 {
        ret 3
    }
    if loops() != 39 {
        ret 4
    }
    if unsafe_scope() != "outer:inner" {
        ret 5
    }
    if resource_scope() != 22 {
        ret 6
    }
    ret 0
}

fn main() -> u32 {
    let before = live_nodes()
    for _index in 0_usize..32_usize {
        let status = exercise()
        if status != 0 {
            ret status
        }
    }
    if live_nodes() != before {
        ret 7
    }
    ret 0
}
