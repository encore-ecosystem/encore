//! Native proxies are safe calls; ordinary dyn traits and user types keep their effects.
import refrain::frontend::{AnalysisDatabase, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("platform::plugin", "sdk.enq", "pub struct Binding[I] {}\npub struct Resource[I] {}\npub struct PluginError {}\npub fn load() -> u32 { unsafe { ret 0_u32 } }")
    db.set_module("api", "api.enq", "#attr(plugin_interface) pub trait Counter { fn value(self: Self, input:u32) -> u32 }")
    db.set_module("app", "app.enq", "import platform::plugin::{Binding as Handle, Resource, PluginError, load}\nimport api::Counter\n" +
        "fn typed_call(value: Handle[dyn Counter]) -> Result[u32,PluginError] { ret value.value(1_u32) }\n" +
        "fn resource_call(value: Resource[dyn Counter]) -> Result[u32,PluginError] { ret value.value(1_u32) }\n" +
        "fn ordinary_call(value: dyn Counter) -> u32 { ret value.value(1_u32) }\n" +
        "fn native_load() -> u32 { ret load() }\n" +
        "struct Binding {}\nimpl for Binding { pub fn value(self:Self) -> u32 { unsafe { ret 0_u32 } } }\n" +
        "fn shadowed(value: Binding) -> u32 { ret value.value() }\n" +
        "fn unsafe_argument(value: Handle[dyn Counter]) -> Result[u32,PluginError] { ret value.value(load()) }\n",)
    for name in vec!["typed_call", "resource_call"] {
        if db.function_is_unsafe(db.symbol_id("app", name).unwrap_or(SymbolId::invalid())) {
            ret 1_u32
        }
    }
    for name in vec!["ordinary_call", "native_load", "shadowed", "unsafe_argument"] {
        if !db.function_is_unsafe(db.symbol_id("app", name).unwrap_or(SymbolId::invalid())) {
            ret 2_u32
        }
    }
    ret 0_u32
}
