//! Import-derived candidates preserve graph-order namespace lookup and aliases.
import core::testing::assert
import std::vec::Vec
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}
import refrain::frontend::import_paths::{import_namespace_target, namespace_import_candidates}

fn main() -> u32 {
    let modules = vec!["a::b", "a", "a::c", "a::nested::d", "pkg::mod", "mod", "core::vec", "a::*", "refrain::child", "пример::модуль", "a::b as chosen", "a as z::b", "a::as chosen"]
    let paths = vec!["a", "a::b", "a::b as chosen", "a::{b,c}", "a::{b as chosen,c as chosen}",
        "a::{nested::{d as deep},b}", "a::*", "a::{*,b as chosen}", "pkg::mod", "pkg::mod as picked",
        " core::vec as list ", "refrain::child as local", "пример::{модуль as имя}", "missing", "",
        "a::{b,c", "a:: b as chosen", "a::\tb as chosen", "a as z::b as chosen", "a as z::b", "a::{b as chosen,c", "a::", "a:: as chosen"]
    let requests = vec!["a", "b", "c", "chosen", "chosen::inner", "deep", "mod", "picked::nested", "list", "local", "имя", "unknown", "b as chosen", "*", "as chosen"]
    for path in paths {
        let candidates = namespace_import_candidates(path).unwrap_or(modules)
        for requested in requests {
            let mut reference = ""
            let mut indexed = ""
            for module in modules {
                let result = import_namespace_target(path, module, requested)
                if !result.is_empty() {
                    let mut present = false
                    for candidate in candidates { if candidate == module { present = true } }
                    if !assert(present) { ret 1_u32 }
                    if reference.is_empty() { reference = result }
                }
                let mut present = false
                for candidate in candidates { if candidate == module { present = true } }
                if present && indexed.is_empty() { indexed = import_namespace_target(path, module, requested) }
            }
            if !assert(reference == indexed) { ret 2_u32 }
        }
    }
    if !assert(namespace_import_candidates("a::{b as chosen,nested::{d}}").is_some()) { ret 5_u32 }
    if !assert(namespace_import_candidates("a::{b,c").is_none()) { ret 6_u32 }
    if !assert(namespace_import_candidates("a:: b as chosen").is_none()) { ret 7_u32 }
    if !assert(namespace_import_candidates("a as z::b as chosen").is_none()) { ret 8_u32 }
    if !assert(namespace_import_candidates("a::").is_none()) { ret 9_u32 }
    // Recovery for duplicate grouped aliases retains graph order rather than
    // silently switching to the order of spellings inside the import group.
    let mut database = AnalysisDatabase::new()
    database.set_module("pkg::second", "second.enq", "pub fn value() -> str { ret \"second\" }\n")
    database.set_module("pkg::first", "first.enq", "pub fn value() -> u32 { ret 1_u32 }\n")
    database.set_module("app", "app.enq", "import pkg::{first as picked,second as picked}\nfn sample() { let result = picked::value() }\n")
    let body = database.semantic_body(database.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    if !assert(body.binding_type("result").unwrap_or("") == "str") { ret 3_u32 }
    database.set_module("app", "app.enq", "import pkg::first as picked\nfn sample() { let result = picked::value() }\n")
    let changed = database.semantic_body(database.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    if !assert(changed.binding_type("result").unwrap_or("") == "u32") { ret 4_u32 }
    ret 0_u32
}
