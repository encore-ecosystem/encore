//! Exercises the shared analyzer rule engine.

import core::testing::assert
import refrain::analyzer::{AnalyzerConfig, RuleLevel, analyze_document}
import refrain::frontend::analyze_source

fn count_code(source: str, code: str) -> usize {
    let document = analyze_source(source)
    let config = AnalyzerConfig::new()
    let mut count = 0_usize
    for diagnostic in analyze_document("src/lib.enq", document, config) {
        if diagnostic.code == code { count += 1_usize }
    }
    ret count
}

fn main() -> u32 {
    let documented = "//! Values.\n/// A value.\npub struct Value {\n/// Stored data.\ndata: u32\n}\n"
    if !assert(count_code(documented, "missing-module-docstring") == 0_usize) { ret 1_u32 }
    if !assert(count_code(documented, "missing-public-docstring") == 0_usize) { ret 2_u32 }

    let missing = "pub struct Packet { payload: u32 }\npub enum State { Ready }\npub trait Service { fn call(self: Self) -> u32 }\n"
    if !assert(count_code(missing, "missing-module-docstring") == 1_usize) { ret 3_u32 }
    if !assert(count_code(missing, "missing-public-docstring") >= 6_usize) { ret 4_u32 }

    let document = analyze_source(missing)
    let mut config = AnalyzerConfig::new()
    config.set_level("missing-module-docstring", RuleLevel::Allow)
    config.set_level("missing-public-docstring", RuleLevel::Deny)
    let diagnostics = analyze_document("src/lib.enq", document, config)
    for diagnostic in diagnostics {
        if !assert(diagnostic.code == "missing-public-docstring") { ret 5_u32 }
        if !assert(diagnostic.severity == RuleLevel::Deny) { ret 6_u32 }
        if !assert(diagnostic.path == "src/lib.enq") { ret 7_u32 }
    }
    ret 0_u32
}
