//! Call-scoped owners survive operand evaluation and are released exactly once.
import core::result::Result
import core::vec::Vec
import std::io::println

extern fn encore_node_debug_live_count() -> usize

struct Holder {
    values: Vec[usize]
}

impl for Holder {
    fn values(self: Self) -> Vec[usize] {
        ret self.values
    }

    #attr(borrowed_self)
    fn count(self: Self, extra: usize) -> usize {
        ret self.values.len() + extra
    }

    #attr(borrowed_self)
    #attr(borrowed_return)
    fn peek(self: Self) -> Vec[usize] {
        ret self.values
    }

    #attr(borrowed_return)
    fn owned_peek(self: Self) -> Vec[usize] {
        ret self.values
    }

    fn consume(self: Self, extra: usize) -> usize {
        ret self.values.len() + extra
    }

    fn append(self: mut Self, value: usize) -> usize {
        self.values.push(value)
        ret self.values.len()
    }
}

struct Node {
    value: usize
}

struct Bundle {
    values:[Holder;
        2]
}

impl for Node {
    #attr(borrowed_self)
    fn read(self: Self < H >) -> usize {
        ret self.value
    }

    #attr(borrowed_self)
    fn erased(self: Self &) -> usize {
        ret self.value
    }
}

struct Generic[T] {
    value: T
}
impl[T] for Generic[T] {
    #attr(borrowed_self)
    #attr(borrowed_return)
    fn peek(self: Self) -> T {
        ret self.value
    }
}

fn holder(size: usize) -> Holder {
    let mut values = Vec[usize]::new()
    for index in 0_usize..size {
        values.push(index)
    }
    ret Holder {
        values
    }
}

fn named() -> bool {
    let value = holder(3_usize)
    let values = value.values()
    let node = Node < H > {
        7_usize
    }
    ret values.len() == 3_usize && value.count(2_usize) == 5_usize &&
    node.erased() == 7_usize && Node::erased(node) == 7_usize && node.read() == 7_usize
}

fn temporary() -> bool {
    ret holder(3_usize).values().len() == 3_usize &&
    holder(0_usize).values().is_empty() &&
    holder(3_usize).count(2_usize) == 5_usize &&
    Holder::count(holder(3_usize), 2_usize) == 5_usize &&
    Node < H > {
        7_usize
    }
    .read() == 7_usize && Node < H > {
        8_usize
    }
    .erased() == 8_usize &&
    Vec[usize]::len(holder(2_usize).values()) == 2_usize
}

fn projections() -> bool {
    let source = holder(2_usize)
    let copies =[source, source]
    let repeated =[source;
        2]
    let empty =[holder(9_usize);
        0]
    let bundle = Bundle < H > {
        [holder(4_usize), holder(6_usize)]
    }
    let projected = bundle.values
    ret holder(3_usize).values.len() == 3_usize &&
    (holder(3_usize), 0_usize).0.values.len() == 3_usize &&
    [holder(3_usize), holder(4_usize)][0_usize].values.len() == 3_usize &&
    [holder(5_usize);
        2][1_usize].count(0_usize) == 5_usize &&
    copies[0_usize].count(0_usize) == 2_usize &&
    repeated[1_usize].count(0_usize) == 2_usize && source.count(0_usize) == 2_usize &&
    projected[1_usize].count(0_usize) == 6_usize &&
    (if true {
            holder(3_usize)
        } else {
            holder(0_usize)
        }
    ).count(0_usize) == 3_usize
}

fn borrowed_result() -> bool {
    let values = holder(3_usize).peek()
    let mut replacement = Vec[usize]::new()
    replacement = holder(2_usize).peek()
    let mut nested = Vec[Vec[usize]]::new()
    nested.push(holder(4_usize).peek())
    let shared = holder(7_usize)
    let survivor = shared.peek()
    let generic = Generic[Vec[usize]] {
        holder(8_usize).values()
    }
    .peek()
    let owned = holder(9_usize).owned_peek()
    ret values.len() == 3_usize && replacement.len() == 2_usize &&
    holder(5_usize).peek().len() == 5_usize &&
    Holder::peek(holder(6_usize)).len() == 6_usize &&
    nested.get(0_usize).unwrap_or(Vec[usize]::new()).len() == 4_usize &&
    survivor.len() == 7_usize && shared.count(0_usize) == 7_usize && generic.len() == 8_usize &&
    owned.len() == 9_usize && Holder::owned_peek(holder(10_usize)).len() == 10_usize
}

fn fail() -> Result[usize, usize] {
    ret Result::Err(7_usize)
}
fn succeed() -> Result[usize, usize] {
    ret Result::Ok(2_usize)
}

fn interrupted(which: usize) -> Result[usize, usize] {
    let value = match which {
        0_usize => holder(3_usize).count(fail()?)
        1_usize => Holder::count(holder(3_usize), fail()?)
        2_usize => holder(3_usize).consume(fail()?)
        3_usize => Holder::consume(holder(3_usize), fail()?)
        _ => holder(3_usize).append(fail()?)
    }
    ret Result::Ok(value)
}

fn transfer_paths() -> bool {
    for which in 0_usize..5_usize {
        match interrupted(which) {
            Err(error) => {
                if error != 7_usize {
                    ret false
                }
            }
            Ok(_) => {
                ret false
            }
        }
    }
    ret holder(3_usize).append(5_usize) == 4_usize &&
    holder(3_usize).consume(2_usize) == 5_usize
}

fn success_path() -> Result[usize, usize] {
    ret Result::Ok(holder(3_usize).count(succeed()?))
}

fn early_return() -> usize {
    ret holder(3_usize).count( {
            ret 9_usize
            0_usize
        }
    )
}

fn early_binding() -> usize {
    let unreachable = Holder::count(holder(3_usize), {
            ret 7_usize
            0_usize
        }
        ,)
    ret unreachable
}

fn control_flow() -> bool {
    let mut seen = 0_usize
    for index in 0_usize..4_usize {
        seen += holder(1_usize).count(if index == 0_usize {
                continue
                0_usize
            } elif index == 2_usize {
                break
                0_usize
            } else {
                0_usize
            }
        )
    }
    if false && holder(3_usize).count(0_usize) > 0_usize {
        ret false
    }
    let early = early_return()
    if seen != 1_usize || early != 9_usize {
        println(f "flow: seen={seen}, early={early}")
    }
    ret seen == 1_usize && early == 9_usize && early_binding() == 7_usize
}

fn exercise(which: usize) -> bool {
    for index in 0_usize..100_usize {
        let ok = match which {
            0_usize => named()
            1_usize => temporary()
            2_usize => projections()
            3_usize => borrowed_result()
            4_usize => transfer_paths()
            _ => control_flow()
        }
        if !ok {
            ret false
        }
    }
    match success_path() {
        Ok(value) => {
            ret value == 5_usize
        }
        Err(_) => {
            ret false
        }
    }
}

fn main() -> u32 {
    for which in 0_usize..6_usize {
        let before = unsafe {
            encore_node_debug_live_count()
        }
        if !exercise(which) {
            println(f "wrong result in case {which}")
            ret 1_u32
        }
        let after = unsafe {
            encore_node_debug_live_count()
        }
        if after != before {
            println(f "case {which}: live nodes {before} -> {after}")
            ret 2_u32
        }
    }
    ret 0_u32
}
