//! Structured dependency bodies resolve imports under their portable module ID.
import core::vec::Vec
import refrain::frontend::translator::{TranslationModule, translate_modules_to_ehir_bundle}
import refrain::frontend::{Lexer, Parser}
import refrain::target::host_target
fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut numbers = Parser::new_for_source("numbers@lib.enq")
    let mut caller = Parser::new_for_source("caller@main.enq")
    let numbers_ast = numbers.parse(lexer.tokenize(
            "enum Result[T, E] { Ok(T) Err(E) }\n" +
            "pub fn read() -> Result[u32, str] { ret Result::Ok(42_u32) }\n"))
    let caller_ast = caller.parse(lexer.tokenize(
            "import numbers::read as read_number\n" +
            "fn main() -> u32 { match read_number() { Ok(value) => { ret value } Err(_) => { ret 1 } } }\n"))
    let mut imports = Vec[str]::new()
    imports.push("numbers@lib.enq")
    let mut modules = Vec[TranslationModule]::new()
    modules.push(TranslationModule::new("numbers@lib.enq", "/virtual/numbers/src/lib.enq", Vec[str]::new(), numbers_ast, Vec[str]::new()))
    modules.push(TranslationModule::new("caller@main.enq", "/virtual/caller/src/main.enq", imports, caller_ast, Vec[str]::new()))
    let output = translate_modules_to_ehir_bundle(modules, host_target(), "caller@main.enq")
    if output.contains("call read_number") || !output.contains("Result[u32, str]") {
        ret 1
    }
    ret 0
}
