//! Trait contracts retain declaration-owned nominal types in flattened validation.
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::{Parser, Statement}
import refrain::frontend::translator::{TranslationModule, translate_modules_to_ehir_bundle}
import refrain::target::host_target
fn parsed(name: str, source: str) -> Vec[Statement] {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source(name)
    ret parser.parse(lexer.tokenize(source))
}
fn main() -> u32 {
    let contract = parsed("contract.enq",
        "pub struct Error { code:u32 }\n" +
        "pub trait Codec[Output] { fn serialize(self:Self, error:Error)->Output fn failure(self:Self)->Error }\n",)
    let consumer = parsed("consumer.enq",
        "import contract::{Codec, Error as CodecError}\n" +
        "struct Error { other:u64 }\nstruct Writer {}\n" +
        "impl Codec[u32] for Writer { fn serialize(self:Self, error:CodecError)->u32 { ret error.code } fn failure(self:Self)->CodecError { ret CodecError{7_u32} } }\n",)
    let mut modules = Vec[TranslationModule]::new()
    modules.push(TranslationModule::new("contract", "contract.enq", Vec[str]::new(), contract, Vec[str]::new()))
    let mut imports = Vec[str]::new() imports.push("contract")
    modules.push(TranslationModule::new("consumer", "consumer.enq", imports, consumer, Vec[str]::new()))
    let output = translate_modules_to_ehir_bundle(modules, host_target(), "consumer")
    if !output.contains("__encore_t636f6e7472616374__Error") {
        ret 1
    }
    ret 0
}
