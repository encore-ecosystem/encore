import core::option::Option

import std::vec::Vec

import refrain::frontend::{AnalysisDatabase, Lexer, Parser, ProjectConstants, Statement, project_constant_literal}
import refrain::frontend::parser::statements::Expr

fn literal(project: ProjectConstants, expression: str, expected: str) -> bool {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new().with_project_constants(project)
    let ast = parser.parse(lexer.tokenize("fn value() -> str { ret " + expression + " }"))
    ret ast_literal(ast, expected)
}

fn ast_literal(ast: Vec[Statement], expected: str) -> bool {
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                let block = match item.body {
                    Some(value) => value
                    None => {
                        ret false
                    }
                }
                for body in block.statements {
                    match body {
                        Statement::Ret(value) => {
                            match value.value {
                                Expr::StringLiteral(text) => {
                                    ret text == project_constant_literal(expected)
                                }
                                _ => {
                                    ret false
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret false
}

fn metadata_change_invalidates_unchanged_source() -> bool {
    let mut database = AnalysisDatabase::new()
    let source = "fn value() -> str { ret __version__ }"
    database.configure_project("sample", ProjectConstants { "sample", "1.0.0" })
    database.set_module("sample", "sample.enq", source)
    match database.document("sample") {
        Some(document) => {
            if !ast_literal(document.ast, "1.0.0") {
                ret false
            }
        }
        None => {
            ret false
        }
    }
    let previous = database.revision()
    database.configure_project("sample", ProjectConstants { "sample", "1.0.0" })
    if database.revision() != previous {
        ret false
    }
    database.configure_project("sample", ProjectConstants { "sample", "1.1.0" })
    if database.revision() <= previous {
        ret false
    }
    match database.document("sample") {
        Some(document) => {
            ret ast_literal(document.ast, "1.1.0")
        }
        None => {
            ret false
        }
    }
}

fn main() -> u32 {
    let project = ProjectConstants { "sample", "1.2.3" }
    ret if literal(project, "__version__", "1.2.3") &&
    literal(project, "__project_name__", "sample") &&
    literal(project, "\"__version__\"", "__version__") &&
    literal(ProjectConstants { "sample", "β\"\\\n\t" }, "__version__", "β\"\\\n\t") &&
    metadata_change_invalidates_unchanged_source() {
        0_u32
    } else {
        1_u32
    }
}
