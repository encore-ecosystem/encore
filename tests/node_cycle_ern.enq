import core::option::Option

extern fn encore_node_debug_live_count() -> usize

struct Node {
    next: Option[Node<H>]
}

impl for Node {
    fn link(self: Self&, next: Option[Node<H>]) -> () {
        self.next = next
    }
}

fn build_cycle() -> () {
    let first = Node<H>{Option[Node<H>]::None}
    let second = Node<H>{Option[Node<H>]::Some(first)}
    first.link(Option[Node<H>]::Some(second))
    ret ()
}

fn main() -> u32 {
    let before = unsafe { encore_node_debug_live_count() }
    build_cycle()
    let after = unsafe { encore_node_debug_live_count() }
    ret if after == before { 0_u32 } else { 1_u32 }
}
