//! Unit joins carry control flow without allocating a void result slot.
import core::result::Result
struct Counter {
    value: u32
}
fn choose(flag: bool, counter: mut Counter) ->() {
    ret if flag {
        counter.value += 1_u32
    } else {
        counter.value += 2_u32
    }
}
fn checked(flag: bool, counter: mut Counter) -> Result[(), str] {
    match flag {
        true => {
            choose(true, counter)
        }
        false => {
            ret Result::Err("stopped")
        }
    }
    ret Result::Ok(())
}
fn main() -> u32 {
    let mut counter = Counter { 0_u32 }
    choose(false, counter)
    match checked(true, counter) {
        Ok(_) => {
        }
        Err(_) => {
            ret 1
        }
    }
    match checked(false, counter) {
        Err(_) => {
        }
        Ok(_) => {
            ret 2
        }
    }
    if counter.value != 3_u32 {
        ret 3
    }
    ret 0
}
