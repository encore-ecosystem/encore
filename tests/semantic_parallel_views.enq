//! Workers read one frozen catalog and syntax facts without changing the owner.
import core::option::Option
import core::testing::assert
import std::vec::Vec
import json::{Json, stringify}
import refrain::frontend::{AnalysisDatabase, FrontendDocument}
import refrain::frontend::metadata_ast::encode_metadata_ast
import refrain::frontend::analysis_database::check_prepared_safety_module
import refrain::frontend::semantic_index::PackageSemanticIndex
import refrain::target::host_target
fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    let source = "struct Data { value: u32 }\nimpl for Data { pub fn read(self: Self) -> u32 { ret self.value } }\n" +
        "fn compute(value: Data) -> u32 { let result = value.read() ret result }\n"
    let target = host_target()
    for module in vec!["left", "right"] {
        database.set_module(module, module + ".enq", source)
        database.configure_safety(module, target, Vec[str]::new())
    }
    let modules = vec!["left", "right"]
    let identity = database.semantic_package_identity(modules)
    database.prepare_package_semantics(modules, identity, Option[PackageSemanticIndex]::None)
    let before = database.package_semantic_index().unwrap_or(PackageSemanticIndex::empty()).encode().unwrap_or("")
    let before_syntax = stringify(encode_metadata_ast(database.document("left").unwrap_or(FrontendDocument::empty()).ast))
    let first = database.prepare_module_safety_job("left", target, Vec[str]::new(), Json::Null, true)
    let second = database.prepare_module_safety_job("right", target, Vec[str]::new(), Json::Null, true)
    let left = spawn check_prepared_safety_module(first)
    let right = spawn check_prepared_safety_module(second)
    let checked_left = left.join()
    let checked_right = right.join()
    if !assert(checked_left.diagnostics.is_empty() && checked_right.diagnostics.is_empty() && checked_left.checked == 2_usize && checked_right.checked == 2_usize) { ret 1_u32 }
    let after = database.package_semantic_index().unwrap_or(PackageSemanticIndex::empty()).encode().unwrap_or("")
    if !assert(!before.is_empty() && before == after && database.source_text("left").unwrap_or("") == source) { ret 2_u32 }
    let after_syntax = stringify(encode_metadata_ast(database.document("left").unwrap_or(FrontendDocument::empty()).ast))
    if !assert(before_syntax == after_syntax) { ret 3_u32 }
    ret 0_u32
}
