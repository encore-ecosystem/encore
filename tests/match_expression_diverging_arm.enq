import core::option::Option
import core::testing::assert

fn unwrap_or_return(value: Option[u32]) -> u32 {
    let unwrapped = match value {
        Some(inner) => inner
        None => { ret 41_u32 }
    }
    ret unwrapped
}

fn main() -> u32 {
    if !assert(unwrap_or_return(Option[u32]::Some(7_u32)) == 7_u32) { ret 1_u32 }
    if !assert(unwrap_or_return(Option[u32]::None) == 41_u32) { ret 2_u32 }
    ret 0_u32
}
