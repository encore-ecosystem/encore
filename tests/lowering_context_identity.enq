//! Lowering reuse must track compile-time bodies, not ordinary runtime edits.
import json::stringify
import refrain::frontend::lexer::Lexer
import refrain::frontend::metadata_ast::encode_codegen_context_ast
import refrain::frontend::parser::Parser

fn identity(source: str) -> str {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("context-test.enq")
    ret stringify(encode_codegen_context_ast(parser.parse(lexer.tokenize(source))))
}

fn main() -> u32 {
    let ordinary = identity("fn value() -> u32 { ret 1 }")
    if ordinary != identity("\n/// New documentation\nfn value() -> u32 { ret 2 }") {
        ret 1
    }
    if ordinary == identity("fn value() -> u64 { ret 1 }") {
        ret 2
    }
    if identity("fn value[T](item: T) -> T { ret item }") ==
    identity("fn value[T](item: T) -> T { let copy = item ret copy }") {
        ret 3
    }
    if identity("struct Value {} impl for Value { fn value(self: Self) -> u32 { ret 1 } }") !=
    identity("struct Value {} impl for Value { fn value(self: Self) -> u32 { ret 2 } }") {
        ret 5
    }
    if identity("struct Value[T] {} impl[T] for Value[T] { fn value(self: Self) -> u32 { ret 1 } }") ==
    identity("struct Value[T] {} impl[T] for Value[T] { fn value(self: Self) -> u32 { ret 2 } }") {
        ret 6
    }
    if identity("async fn value() -> u32 { ret 1 }") == identity("async fn value() -> u32 { ret 2 }") {
        ret 7
    }
    ret 0
}
