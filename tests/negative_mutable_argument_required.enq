// expect.compile_error=error[mutable-argument-required]: parameter 1 of 'consume' requires a mutable argument; declare 'value' with 'let mut'

struct Value {
    count: u32
}

fn consume(value: mut Value) -> () {
    value.count = 1_u32
}

fn main() -> u32 {
    let value = Value {0_u32}
    consume(value)
    ret 0_u32
}
