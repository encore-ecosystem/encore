// @expect.compile_error=must use an immutable self receiver
import core::vec::Vec

trait Inspect {
    fn inspect(self: Self) -> usize
}

struct Holder {
    values: Vec[str]
}

impl Inspect for Holder {
    fn inspect(self: mut Holder) -> usize {
        self.values.push("mutation")
        ret self.values.len()
    }
}

fn main() -> u32 {
    ret 0_u32
}
