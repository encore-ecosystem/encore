//! Scope-local normalization is equivalent to querying the complete environment.

import core::testing::assert
import core::fmt::Debug
import core::vec::Vec
import refrain::frontend::type_scope::{TypeNameBinding, scope_type, scope_type_indexed, type_scope_index, display_type, names_in_scope}

fn main() -> u32 {
    let mut names = Vec[TypeNameBinding]::new()
    names.push(TypeNameBinding {
            "left", "Item", "@1", "Left", "Item"
        }
        ,
    )
    names.push(TypeNameBinding {
            "right", "Item", "@10", "Right", "Item"
        }
        ,
    )
    names.push(TypeNameBinding {
            "left", "Box", "@2", "Box", "Box"
        }
        ,
    )
    names.push(TypeNameBinding {
            "right", "Box", "@20", "Box", "Box"
        }
        ,
    )
    names.push(TypeNameBinding {
            "left", "T", "@3", "T", "T"
        }
        ,
    )
    let mut generics = Vec[str]::new()
    generics.push("T")
    let selected = names_in_scope(names, "left")
    if !assert(selected.len() == 3_usize) {
        ret 1_u32
    }
    let typ = "(Box[Item], [T; 2], Missing, Item&)"
    let all = scope_type(typ, "left", names, generics)
    if !assert(all == "(@2[@1], [T; 2], Missing, @1&)") {
        ret 2_u32
    }
    if !assert(scope_type(typ, "left", selected, generics) == all) {
        ret 3_u32
    }
    if !assert(scope_type(typ, "absent", names_in_scope(names, "absent"), generics) == typ) {
        ret 4_u32
    }
    if !assert(scope_type("Item", "right", names_in_scope(names, "right"), generics) == "@10") {
        ret 5_u32
    }
    if !assert(display_type("(u32, str, [bool; 2])", names) == "(u32, str, [bool; 2])") {
        ret 6_u32
    }
    if !assert(display_type("@1, @10, @100", names) == "Left, Right, @100") {
        ret 7_u32
    }
    if !assert(display_type("Пример: @1", names) == "Пример: Left") {
        ret 8_u32
    }
    names.push(TypeNameBinding {
            "left", "Элемент", "@4", "Элемент", "Элемент"
        }
        ,
    )
    if !assert(scope_type("Box[Элемент]", "left", names, generics) == "@2[@4]") {
        ret 9_u32
    }
    if !assert(display_type("@2[@4]", names) == "Box[Элемент]") {
        ret 10_u32
    }
    // Duplicate local entries keep the first binding; an explicit declaration
    // also wins over the core-prelude fallback and generic names stay local.
    names.push(TypeNameBinding { "left", "Item", "@99", "Later", "Item" })
    names.push(TypeNameBinding { "", "Item", "@50", "Prelude", "Item" })
    names.push(TypeNameBinding { "", "Vec", "@51", "Vec", "Vec" })
    names.push(TypeNameBinding { "left", "ns::Item", "@52", "Qualified", "Item" })
    let indexed = type_scope_index(names)
    for scope in vec!["left", "right", "absent", ""] {
        for value in vec![typ, "Vec[Box[Элемент]]", "ns::Item", "dyn Item<S>&", "(Item, T, @1)", ""] {
            if !assert(scope_type_indexed(value, scope, indexed, generics) == scope_type(value, scope, names, generics)) {
                ret 11_u32
            }
        }
    }
    // Force a larger table and collisions without relying on hash values.
    for number in 0_usize..1000_usize {
        let suffix = number.fmt()
        names.push(TypeNameBinding { "many", "Type" + suffix, "@" + suffix, suffix, suffix })
    }
    let large = type_scope_index(names)
    for number in 0_usize..1000_usize {
        let value = "Vec[Type" + number.fmt() + "]"
        if !assert(scope_type_indexed(value, "many", large, generics) == scope_type(value, "many", names, generics)) {
            ret 12_u32
        }
    }
    ret 0_u32
}
