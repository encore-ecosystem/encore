// @expect.compile_error=is not a supported transferable region

struct PointerRegion {
    address: u8 *
}

fn consume(value: sending PointerRegion) -> u32 {
    ret 0
}

fn main() -> u32 {
    unsafe {
        let value = PointerRegion {
            0_usize as u8 *
        }
        let worker = spawn consume(value)
        ret worker.join()
    }
}
