import core::future::{Context, Future, Poll}
import std::future::block_on

struct Once {
    pending: bool
    value: u32
}

impl Future[u32] for Once {
    fn poll(self: Once, context: Context) -> Poll[Once, u32] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, u32]::Pending(Once{false, self.value})
        }
        ret Poll[Once, u32]::Ready(self.value)
    }
}

trait Producer {
    async fn produce(self: Self) -> u32
}

struct Number {
    value: u32
}

impl Producer for Number {
    async fn produce(self: Number) -> u32 {
        ret await Once{true, self.value}
    }
}

fn main() -> u32 {
    let pending = Number{42_u32}.produce()
    let value = block_on[u32, __encore_future_Number__produce](pending)
    if value == 42_u32 { ret 0_u32 }
    ret 1_u32
}
