import core::vec::Vec

struct Payload {
    available: bool
    value: u32
}

struct Entry {
    payload: Payload
}

fn payload_valid(payload: Payload) -> bool {
    ret payload.available && payload.value == 42_u32
}

fn main() -> u32 {
    let mut entries = Vec[Entry<H>]::new()
    entries.push(Entry<H> {
            Payload {
                true, 42_u32
            }
        }
    )
    for entry in entries {
        // Inline fields are copied as ordinary EHIR values. Only explicit
        // node handles use placement-erased `T&` parameters.
        if !payload_valid(entry.payload) {
            ret 1_u32
        }
    }
    ret 0_u32
}
