struct Counter {
    value: u32
}

impl for Counter {
    fn increment(self: mut Self) -> u32 {
        self.value += 1_u32
        ret self.value
    }
}

fn counter(value: u32) -> Counter {
    ret Counter{value}
}

fn main() -> u32 {
    if counter(41_u32).increment() != 42_u32 {
        ret 1_u32
    }
    ret 0_u32
}
