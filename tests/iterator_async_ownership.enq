//! An owning iterator survives real Pending/Ready suspensions without leaks.
import core::future::{Context, Future, Poll}
import core::vec::Vec
import std::future::block_on
extern fn encore_node_debug_live_count() -> usize

struct Once {
    pending: bool value: usize
}
impl Future[usize] for Once {
    fn poll(self: Self, context: Context) -> Poll[Once, usize] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, usize]::Pending(Once {
                    false, self.value
                }
                ,
            )
        }
        ret Poll[Once, usize]::Ready(self.value)
    }
}
async fn sum(early: bool) -> usize {
    let mut values = Vec[usize]::new()
    values.push(3_usize) values.push(5_usize)
    let mut total = 0_usize
    for value in values {
        total += await Once {
            true, value
        }
        if early {
            ret total
        }
    }
    ret total
}
fn run(early: bool) -> usize {
    ret block_on[usize, __encore_future_sum](sum(early))
}
fn main() -> u32 {
    let before = unsafe {
        encore_node_debug_live_count()
    }
    if run(false) != 8_usize {
        ret 1_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 11_u32
    }
    if run(true) != 3_usize {
        ret 2_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 12_u32
    }
    ret 0_u32
}
