import core::vec::Vec
import core::option::Option

struct Resource {
    values: Vec[u32]
}

impl for Resource {
    fn first(self: Self&) -> u32 {
        match self.values.get(0_usize) {
            Option::Some(value) => { ret value }
            Option::None => { ret 0_u32 }
        }
    }
}

struct Owner {
    resource: Resource<H>
}

fn main() -> i32 {
    let mut values = Vec[u32]::new()
    values.push(42_u32)
    let owner = Owner { Resource<H> { values } }
    let mut iteration = 0_usize
    while iteration < 1000_usize {
        if owner.resource.first() != 42_u32 {
            ret 1
        }
        iteration += 1_usize
    }
    ret 0
}
