//! Declaration-owned defaults survive package imports, warm caches and edits.
import std::io::eprintln
import std::vec::Vec
import refrain::ci_helpers::{Fixture, std_dependencies}

#attr(test)
fn integration_language_call_metadata() -> bool {
    let fixture = Fixture::new("language-call-metadata")
    let provider = Fixture { fixture.root.join("provider"), fixture.compiler }
    provider.manifest("call_provider", std_dependencies())
    let body = "pub fn values(count: usize = 2_usize) -> usize { yield count yield count + 1_usize }\npub trait Scaled { fn scaled(self: Self, factor: u32 = 2_u32) -> u32 }\npub struct Multiplier { value: u32 }\nimpl Scaled for Multiplier { pub fn scaled(self: Self, local_factor: u32) -> u32 { ret self.value * local_factor } }\n"
    provider.put("src/lib.enq", "pub fn weighted(x: u32, y: u32 = 2_u32, z: u32 = 3_u32) -> u32 { ret x * 100_u32 + y * 10_u32 + z }\n" + body)
    let consumer = Fixture { fixture.root.join("consumer"), fixture.compiler }
    let dependencies = std_dependencies()
    consumer.manifest("call_consumer", dependencies.slice_bytes(0_usize, dependencies.byte_len() - 1_usize) + ",\"path@../provider\"]")
    consumer.put("src/main.enq", "import call_provider::{weighted, values, Scaled, Multiplier}\nfn main() -> u32 { let multiplier = Multiplier{2_u32} if multiplier.scaled() != 4_u32 || multiplier.scaled(factor: 3_u32) != 6_u32 { ret 1_u32 } let mut total = 0_usize for value in values() { total += value } ret weighted(z: 9_u32, x: 1_u32) + total as u32 }\n")
    for _ in 0_usize..2_usize {
        let output = consumer.command(vec!["run"])
        if output.code() != 134_i32 { eprintln(output.text()) ret fixture.failure("cold/warm imported defaults or generator defaults differ") }
    }
    provider.put("src/lib.enq", "pub fn weighted(x: u32, y: u32 = 7_u32, z: u32 = 3_u32) -> u32 { ret x * 100_u32 + y * 10_u32 + z }\n" + body)
    for _ in 0_usize..2_usize {
        let output = consumer.command(vec!["run"])
        if output.code() != 184_i32 { eprintln(output.text()) ret fixture.failure("changed default reused stale caller metadata") }
    }
    provider.put("src/lib.enq", "pub fn weighted(first: u32, y: u32 = 7_u32, z: u32 = 3_u32) -> u32 { ret first * 100_u32 + y * 10_u32 + z }\n" + body)
    let renamed = consumer.command(vec!["check"])
    if renamed.success() || !renamed.text().contains("unknown-argument") { eprintln(renamed.text()) ret fixture.failure("renamed parameter did not invalidate a named call") }
    ret fixture.finish(true)
}
