//! Interactive standard input checked through actual operating-system pipes.

import refrain::ci_helpers::{Fixture, std_dependencies}
import std::vec::Vec

extern fn encore_ci_input(binary: str) -> i32

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn integration_standard_input_contract() -> bool {
    let fixture = Fixture::new("standard-input")
    fixture.manifest("input_probe", std_dependencies())
    fixture.put("src/main.enq", "import std::io::{input, try_input, println, IoErrorKind}\nimport core::result::Result\n" +
        "fn main() -> u32 { println(input(\"name> \")) match try_input(\"next> \") {\n" +
        "Result::Ok(line) => { println(line) ret 0 }\nResult::Err(error) => { match error.kind {\n" +
        "IoErrorKind::UnexpectedEof => { println(\"EOF\") ret 2 } _ => { println(\"IO error\") ret 3 } } } } }\n")
    if !fixture.command(vec!["build", "--jobs", "2"]).success() { ret fixture.finish(false) }
    let result = unsafe { encore_ci_input(fixture.binary("input_probe", "dev").as_str()) }
    ret fixture.finish(result == 0)
}
