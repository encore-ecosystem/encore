//! Exercises production CI helpers offline, without a Python test runner.

// POSIX orchestration probes use shell scripts as mock executable binaries.
// Native compiler/runtime integration contracts run separately on every OS.
import std::io::eprintln
import std::os::env
import std::process::Command

fn probe(mode: str) -> bool {
    let root = env("ENCORE_TEST_REPOSITORY").unwrap_or("")
    if root == "" {
        ret false
    }
    let output = Command::new("bash").arg(root + "/tests/ci/pipeline.sh").arg(mode).output()
    if !output.success() {
        eprintln("CI helper probe " + mode + ": " + output.text())
    }
    ret output.success()
}

#cfg(unix)
#attr(test)
fn ci_candidate_exact_trunk_contract() -> bool {
    ret probe("exact")
}
