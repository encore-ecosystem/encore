//! One executable regression contract for each audited compiler issue.
import refrain::ci_helpers::{Fixture, repository, std_dependencies}
import std::os::{is_directory, read_dir, read_file}
import std::path::Path
import std::vec::Vec

fn copy_sources(fixture: Fixture, source: Path, relative: str) {
    for name in read_dir(source.as_str()) {
        if name == "target" {
            continue
        }
        let path = source / name
        let destination = if relative == "" {
            name
        } else {
            relative + "/" + name
        }
        if is_directory(path.as_str()) {
            copy_sources(fixture, path, destination)
        } else {
            fixture.put(destination, read_file(path.as_str()))
        }
    }
}

fn regression(number: str, standalone: bool) -> bool {
    let label = if number == "173" {
        "open-issue173-данные📦"
    } else {
        "open-issue" + number
    }
    let fixture = Fixture::new(label)
    copy_sources(fixture, repository() / "tests/fixtures/compiler_issues" /("issue" + number), "")
    let dependencies = if number == "166" {
        "[\"path@dep\"]"
    } elif number == "168" || number == "173" || number == "174" {
        "[\"path@" +(repository() / "packages/std").as_str() + "\"]"
    } else {
        "[]"
    }
    fixture.manifest("issue_" + number, dependencies)
    if !fixture.succeeds(vec!["check"]) {
        ret fixture.finish(false)
    }
    if number == "169" && !fixture.succeeds(vec!["check", "src/main.enq"]) {
        ret fixture.finish(false)
    }
    if !fixture.succeeds(vec!["build", "--jobs", "2"]) {
        ret fixture.finish(false)
    }
    let execution = fixture.tool(fixture.binary("issue_" + number, "dev").as_str(), Vec[str]::new())
    if !execution.success() {
        ret fixture.failure(execution.text())
    }
    if standalone && !fixture.succeeds(vec!["test", "--jobs", "1"]) {
        ret fixture.finish(false)
    }
    ret fixture.finish(true)
}

#attr(test)
fn open_issue_166_qualified_unsuffixed_argument() -> bool {
    ret regression("166", false)
}
