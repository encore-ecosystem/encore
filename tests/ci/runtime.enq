//! Native runtime contracts compiled by the ordinary Encore test harness.

extern fn encore_ci_heap_capacity(mode: i32) -> i32
extern fn encore_ci_environment_threads() -> i32
extern fn encore_ci_build_queue() -> i32
extern fn encore_ci_build_identity() -> i32
extern fn encore_ci_jobserver(directory: str) -> i32
extern fn encore_ci_artifact(directory: str) -> i32
extern fn encore_ci_artifact_snapshot(directory: str) -> i32

import refrain::ci_helpers::Fixture

#attr(test)
#attr(safe)
fn native_artifact_snapshot_contract() -> bool {
    let fixture = Fixture::new("artifact-snapshot")
    ret fixture.finish(unsafe { encore_ci_artifact_snapshot(fixture.root.as_str()) } == 0)
}

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn native_jobserver_process_contract() -> bool {
    let fixture = Fixture::new("jobserver")
    ret fixture.finish(unsafe {
            encore_ci_jobserver(fixture.root.as_str())
        }
        == 0)
}

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn native_artifact_transaction_contract() -> bool {
    let fixture = Fixture::new("artifact")
    ret fixture.finish(unsafe {
            encore_ci_artifact(fixture.root.as_str())
        }
        == 0)
}

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn native_heap_capacity_contract() -> bool {
    ret unsafe {
        encore_ci_heap_capacity(0)
    }
    == 0
}

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn native_heap_count_overflow_contract() -> bool {
    ret unsafe {
        encore_ci_heap_capacity(1)
    }
    == 0
}

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn native_heap_header_overflow_contract() -> bool {
    ret unsafe {
        encore_ci_heap_capacity(2)
    }
    == 0
}

