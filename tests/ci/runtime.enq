//! Native runtime contracts compiled by the ordinary Encore test harness.

extern fn encore_ci_heap_capacity(mode: i32) -> i32
extern fn encore_ci_environment_threads() -> i32
extern fn encore_ci_build_queue() -> i32
extern fn encore_ci_build_identity() -> i32
extern fn encore_ci_jobserver(directory: str) -> i32
extern fn encore_ci_artifact(directory: str) -> i32
extern fn encore_ci_artifact_snapshot(directory: str) -> i32
extern fn encore_ci_cache_payload(directory: str) -> i32

import std::os::read_file
import std::vec::Vec

import refrain::ci_helpers::{Fixture, repository, std_dependencies}

#attr(test)
fn integration_nested_aggregate_call_abi_contract() -> bool {
    let fixture = Fixture::new("nested-aggregate-abi")
    fixture.manifest("nested_aggregate_abi", std_dependencies())
    fixture.put("src/main.enq", read_file(repository().join("tests/nested_aggregate_call_abi.enq").as_str()))
    for profile in vec!["dev", "debug"] {
        if !fixture.succeeds(vec!["run", "--profile", profile, "--jobs", "2"]) {
            ret fixture.finish(false)
        }
    }
    ret fixture.finish(true)
}

#attr(test)
#attr(safe)
fn native_cache_payload_contract() -> bool {
    let fixture = Fixture::new("cache-payload")
    ret fixture.finish(unsafe {
            encore_ci_cache_payload(fixture.root.as_str())
        }
        == 0)
}

