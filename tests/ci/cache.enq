import refrain::frontend::semantic_index::decode_semantic_module
//! Public build/cache contracts: inspect receipts and execute real artifacts.

import core::panic::panic

import std::os::{file_exists, file_sha256, read_dir, read_file, remove_dir_all, remove_file, write_file}
import std::path::Path
import std::process::Command
import std::vec::Vec

import json::{Json, stringify}

import refrain::cache_identity::compiler_content_digest
import refrain::ci_helpers::{Fixture, flag, json, modified_ns, number, replace, repository, set_env, text}
import refrain::modes::cache_payload::{read_packed_payload, write_payload}

fn prepare(fixture: Fixture) ->() {
    fixture.manifest("cache_application", "[\"path@dependency\"]")
    fixture.put("dependency/encore.toml", "[project]\nname=\"cache_dependency\"\nversion=\"0.0.0\"\ndependencies=[]\n")
    fixture.put("dependency/src/lib.enq", "pub fn cached_value() -> u32 { ret 41 }\n")
    fixture.put("src/main.enq", "import core::option::Option as Opt\nimport cache_dependency::cached_value\n" +
        "fn main() -> u32 { let value = Opt[u64]::Some(cached_value() as u64) ret if value.unwrap_or(0) == 41 { 0 } else { 1 } }\n",)
}

fn build(fixture: Fixture, jobs: str, profile: str) -> Json {
    let output = fixture.command(vec!["build", "--jobs", jobs, "--profile", profile, "--timings"])
    if !output.success() {
        panic("build failed in " + fixture.root.as_str() + "\n" + output.text())
    }
    let report = json(fixture.read("target/" + profile + "/encore-timings.json"))
    if number(report, "schema") != "1" {
        panic("missing build timings")
    }
    ret report
}

fn unit(report: Json, name: str) -> Json {
    for value in report.get("units").unwrap_or(Json::Null).as_array().unwrap_or(Vec[Json]::new()) {
        if text(value, "unit") == name {
            ret value
        }
    }
    panic("missing package in build report: " + name)
    ret Json::Null
}

fn all_cached(report: Json) -> bool {
    let units = report.get("units").unwrap_or(Json::Null).as_array().unwrap_or(Vec[Json]::new())
    if units.is_empty() {
        ret false
    }
    for value in units {
        if !flag(value, "cache_hit") {
            ret false
        }
    }
    ret true
}

fn executes(fixture: Fixture, profile: str) -> bool {
    ret Command::new(fixture.binary("cache_application", profile).as_str()).output().success()
}

#attr(test)
fn integration_module_namespace_dispatch_contract() -> bool {
    let fixture = Fixture::new("module-namespace")
    fixture.manifest("module_namespace", "[]")
    fixture.put("src/left.enq", "pub fn value()->u32 {ret 11_u32} pub fn identity[T](value:T)->T {ret value}\n")
    fixture.put("src/nested/mod.enq", "pub import mod::other\n")
    fixture.put("src/nested/other.enq", "pub fn value()->u32 {ret 22_u32} pub fn identity[T](value:T)->T {ret value}\n")
    let source = "import mod::left\nimport mod::nested\nfn main()->u32 {ret if left::value()==11_u32 && nested::other::value()==22_u32 && left::identity[u32](73_u32)==73_u32 {0_u32} else {1_u32}}\n"
    fixture.put("src/main.enq", source)
    fixture.put("tests/namespaces.enq", "import refrain::left\nimport refrain::nested\nfn main()->u32 {ret if left::value()==11_u32 && nested::other::value()==22_u32 {0_u32} else {1_u32}}\n")
    for profile in vec!["dev", "release"] {
        if !fixture.succeeds(vec!["build", "--profile", profile]) ||
        !Command::new(fixture.binary("module_namespace", profile).as_str()).output().success() {
            ret fixture.finish(false)
        }
    }
    ret fixture.finish(fixture.succeeds(vec!["test", "--jobs", "1"]))
}

