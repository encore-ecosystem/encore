//! Real HTTP/file API resolution, origin selection, offline locks and git@.

import core::panic::panic
import std::os::{file_sha256, write_file, read_file, remove_file, remove_dir_all, file_exists, home_dir}
import std::string::String
import std::path::Path
import std::vec::Vec
import refrain::ci_helpers::{Fixture, set_env, unset_env, replace}

extern fn encore_ci_registry_start(directory: str) -> usize
extern fn encore_ci_registry_stop() -> ()

fn archive(fixture: Fixture, source: str, destination: str, name: str, dependencies: str) -> () {
    fixture.put(source + "/encore.toml", "[project]\nname=\"" + name + "\"\nversion=\"1.0.0\"\ndependencies=" + dependencies +
        "\n[registry]\nindex=\"file:///nonexistent-dependency-override\"\n")
    fixture.put(source + "/src/lib.enq", "pub fn value() -> u32 { ret 42 }\n")
    let result = fixture.tool("tar", vec!["-czf", fixture.root.join(destination).as_str(), "-C", source, "encore.toml", "src"])
    if !result.success() { panic(result.text()) }
}

fn metadata(name: str, url: str, checksum: str) -> str {
    ret "{\"name\":\"" + name + "\",\"versions\":[{\"version\":\"1.0.0\",\"archive\":\"" + url + "\",\"checksum\":\"" + checksum + "\",\"yanked\":false}]}"
}

#cfg(target_os = "linux")
#attr(test)
#attr(safe)
fn integration_registry_http_api_contract() -> bool {
    let fixture = Fixture::new("registry-api")
    fixture.manifest("consumer", "[]")
    fixture.put("src/main.enq", "fn main() -> u32 { ret 0 }\n")
    archive(fixture, "package", "archive.tar.gz", "probe", "[]")
    fixture.put("config.json", "{\"schema\":1,\"api\":\"/api/v1\"}")
    fixture.put("mode", "valid")
    let port = unsafe { encore_ci_registry_start(fixture.root.as_str()) }
    let base = f"http://127.0.0.1:{port}"
    fixture.put("api/v1/packages/probe", metadata("probe", base + "/archive.tar.gz", file_sha256(fixture.root.join("archive.tar.gz").as_str())))
    set_env("ENCORE_DEFAULT_INDEX", base + "/index")
    let mut passed = fixture.command(vec!["add", "probe"]).success() && String::from_str(fixture.read("encore.toml")).contains("index@probe")
    let locked = fixture.read("encore.lock")
    passed = passed && String::from_str(locked).contains("registry = \"" + base + "/index\"") &&
        String::from_str(fixture.read("requests")).contains("/api/v1/packages/probe") && !String::from_str(fixture.read("requests")).contains("/index/pr/probe.json")
    for mode in vec!["cross-origin", "schema", "missing", "redirect", "invalid"] {
        fixture.put("mode", mode)
        if fixture.command(vec!["update"]).success() || fixture.read("encore.lock") != locked ||
            String::from_str(fixture.read("requests")).contains("/must-not-follow") { passed = false }
    }
    fixture.put("mode", "valid")
    if !fixture.command(vec!["update"]).success() { passed = false }
    let requests = fixture.read("requests")
    if !fixture.command(vec!["sync"]).success() || fixture.read("requests") != requests { passed = false }
    unsafe { encore_ci_registry_stop() }
    if !fixture.command(vec!["sync"]).success() { passed = false }
    unset_env("ENCORE_DEFAULT_INDEX")
    ret fixture.finish(passed && fixture.command(vec!["sync"]).success() && fixture.read("encore.lock") == locked)
}

#cfg(target_os = "linux")
#attr(test)
fn integration_registry_source_selection_contract() -> bool {
    let fixture = Fixture::new("registry-sources")
    fixture.put("src/main.enq", "fn main() -> u32 { ret 0 }\n")
    for label in vec!["first", "second"] {
        fixture.put(label + "/config.json", "{\"schema\":1,\"api\":\"/api/v1\"}")
        for package in vec!["probe", "leaf"] {
            let dependencies = if package == "probe" { "[\"index@leaf\"]" } else { "[]" }
            archive(fixture, label + "/" + package + "-source", label + "/" + package + ".tar.gz", package, dependencies)
            let path = fixture.root.join(label + "/" + package + ".tar.gz")
            fixture.put(label + "/api/v1/packages/" + package, metadata(package, "file://" + path.as_str(), file_sha256(path.as_str())))
        }
    }
    let first = "file://" + fixture.root.join("first").as_str()
    let second = "file://" + fixture.root.join("second").as_str()
    fixture.manifest("consumer", "[\"index@probe\"]")
    let manifest = fixture.read("encore.toml")
    fixture.put("encore.toml", manifest + "\n[registry]\nindex=\"" + first + "\"\n")
    for invalid in vec!["https://user:secret@example.org/index", "https://example.org/index?token=secret", "https://example.org/index#x", "http://example.org/index", "https://example.org/a/../index", "https://example.org/a/./index", "https://example.org/%2e/index", "https://example.org/\nindex"] {
        set_env("ENCORE_INDEX_URL", invalid)
        let result = fixture.command(vec!["sync"])
        if result.success() || !String::from_str(result.text()).contains("Invalid registry index URL") { ret fixture.finish(false) }
    }
    unset_env("ENCORE_INDEX_URL")
    if !fixture.command(vec!["sync"]).success() { ret fixture.finish(false) }
    let first_lock = fixture.read("encore.lock")
    if !String::from_str(first_lock).contains("registry = \"" + first + "\"") || !String::from_str(first_lock).contains("name = \"leaf\"") || String::from_str(first_lock).contains("nonexistent-dependency-override") { ret fixture.finish(false) }
    fixture.put("encore.toml", manifest + "\n[registry]\nindex=\"" + second + "\"\n")
    let changed = fixture.command(vec!["sync"])
    if changed.success() || !String::from_str(changed.text()).contains("encore update") || fixture.read("encore.lock") != first_lock { ret fixture.finish(false) }
    if !fixture.command(vec!["update"]).success() { ret fixture.finish(false) }
    let second_lock = fixture.read("encore.lock")
    if first_lock == second_lock || !String::from_str(second_lock).contains("registry = \"" + second + "\"") { ret fixture.finish(false) }
    set_env("ENCORE_INDEX_URL", first)
    if !fixture.command(vec!["update"]).success() || fixture.read("encore.lock") != first_lock { ret fixture.finish(false) }
    unset_env("ENCORE_INDEX_URL")
    fixture.put("encore.toml", manifest)
    set_env("ENCORE_DEFAULT_INDEX", second + "/")
    if !fixture.command(vec!["update"]).success() || fixture.read("encore.lock") != second_lock { ret fixture.finish(false) }
    set_env("ENCORE_DEFAULT_INDEX", first)
    if fixture.command(vec!["sync"]).success() || fixture.read("encore.lock") != second_lock { ret fixture.finish(false) }
    set_env("ENCORE_INDEX_URL", first)
    set_env("ENCORE_DEFAULT_INDEX", second)
    if !fixture.command(vec!["update"]).success() || fixture.read("encore.lock") != first_lock { ret fixture.finish(false) }
    unset_env("ENCORE_INDEX_URL")
    for invalid in vec![" ", "http://example.org/index", "https://user:secret@example.org/index", "file://" + fixture.root.join("unavailable").as_str()] {
        set_env("ENCORE_DEFAULT_INDEX", invalid)
        let result = fixture.command(vec!["update"])
        if result.success() || fixture.read("encore.lock") != first_lock || String::from_str(result.text()).contains("raw.githubusercontent.com") { ret fixture.finish(false) }
    }
    fixture.put("encore.toml", manifest + "\n[registry]\nindex=\"" + first + "\"\n")
    set_env("ENCORE_DEFAULT_INDEX", second)
    if !fixture.command(vec!["update"]).success() || fixture.read("encore.lock") != first_lock { ret fixture.finish(false) }
    set_env("ENCORE_INDEX_URL", "")
    set_env("ENCORE_DEFAULT_INDEX", "")
    if !fixture.command(vec!["sync"]).success() { ret fixture.finish(false) }
    if !fixture.tool("mv", vec!["first", "offline-first"]).success() || !fixture.command(vec!["sync"]).success() ||
        !fixture.tool("mv", vec!["offline-first", "first"]).success() { ret fixture.finish(false) }
    let mut legacy = ""
    for line in String::from_str(first_lock).split_char("\n") { if !line.starts_with("registry = ") { legacy = legacy + line.as_str() + "\n" } }
    fixture.put("encore.lock", legacy)
    if !fixture.command(vec!["sync"]).success() || String::from_str(fixture.read("encore.lock")).contains("registry = ") { ret fixture.finish(false) }
    ret fixture.finish(fixture.command(vec!["update"]).success() && String::from_str(fixture.read("encore.lock")).contains("registry = "))
}

#cfg(target_os = "linux")
#attr(test)
fn integration_direct_git_without_registry_contract() -> bool {
    let fixture = Fixture::new("direct-git")
    fixture.manifest("consumer", "[]")
    fixture.put("src/main.enq", "fn main() -> u32 { ret 0 }\n")
    let git = Fixture { fixture.root.join("gitprobe"), fixture.compiler }
    git.manifest("gitprobe", "[]")
    git.put("src/lib.enq", "pub fn value() -> u32 { ret 7 }\n")
    if !git.tool("git", vec!["init"]).success() || !git.tool("git", vec!["add", "."]).success() ||
        !git.tool("git", vec!["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-m", "fixture"]).success() { ret fixture.finish(false) }
    let reference = "git@file://" + git.root.as_str()
    // The resolver uses URL owner/repository components for its Git cache.
    let owner = fixture.root.file_name().unwrap_or("")
    if !String::from_str(owner).starts_with("direct-git-") { ret fixture.finish(false) }
    let cache = Path::new(home_dir()).join(".cache/encore/git").join(owner).join("gitprobe")
    if file_exists(cache.as_str()) { ret fixture.finish(false) }
    let passed = fixture.command(vec!["add", reference]).success() && String::from_str(fixture.read("encore.toml")).contains(reference) &&
        String::from_str(fixture.read("encore.lock")).contains(reference) && fixture.command(vec!["sync"]).success()
    remove_dir_all(cache.as_str())
    ret fixture.finish(passed)
}
