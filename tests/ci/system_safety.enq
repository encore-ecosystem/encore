//! Exercises exact core operator bodies, including every primitive guard.

import core::panic::panic
import std::os::read_file
import std::string::String
import std::process::Command
import std::vec::Vec
import refrain::ci_helpers::{Fixture, repository, std_dependencies, replace}

fn find(source: str, needle: str, start: usize) -> usize {
    let mut index = start
    while index + needle.byte_len() <= source.byte_len() {
        if source.slice_bytes(index, needle.byte_len()) == needle { ret index }
        index += 1
    }
    ret source.byte_len()
}

fn operator(source: str, operation: str, typ: str, name: str) -> str {
    let implementation = find(source, "impl " + operation + "[" + typ + "] for " + typ + " {", 0)
    let start = find(source, "pub fn op", implementation)
    let opening = find(source, "{", start)
    if opening == source.byte_len() { panic("missing operator implementation") }
    let mut index = opening + 1
    let mut depth = 1_u32
    while index < source.byte_len() && depth > 0 {
        let byte = source.byte_at(index)
        if byte == 123 { depth += 1 }
        if byte == 125 { depth -= 1 }
        index += 1
    }
    if depth != 0 { panic("unclosed operator implementation") }
    ret replace(source.slice_bytes(start, index - start), "pub fn op", "fn " + name)
}

#attr(test)
fn integration_primitive_safety_boundaries_contract() -> bool {
    let fixture = Fixture::new("primitive-safety")
    fixture.manifest("system_safety", std_dependencies())
    let operators = read_file(repository().join("packages/core/src/ops/mod.enq").resolve().as_str())
    let mut sources = "import core::panic::panic\nimport core::vec::Vec\nimport std::os::argv\n"
    let mut valid = ""
    let mut invalid = Vec[(str, str)]::new()
    let mut modes = ""
    let mut valid_count = 0_u32
    for operation in vec!["Div", "Rem", "Shl", "Shr"] {
        for typ in vec!["u8", "u16", "u32", "u64", "usize", "i8", "i16", "i32", "i64", "isize"] {
            let name = "checked_" + operation + "_" + typ
            sources = sources + operator(operators, operation, typ, name) + "\n"
            let values = match operation {
                "Div" => ("12", "3", "4") "Rem" => ("12", "5", "2") "Shl" => ("1", "3", "8") _ => ("8", "3", "1")
            }
            valid = valid + "if " + name + "(" + values.0 + "_" + typ + ", " + values.1 + "_" + typ + ") != " + values.2 + "_" + typ + " { ret 2 }\n"
            valid_count += 1
            let signed = String::from_str(typ).starts_with("i")
            if operation == "Div" || operation == "Rem" {
                let mode = name + "_zero"
                modes = modes + "\"" + mode + "\" => { let ignored = " + name + "(1_" + typ + ", 0_" + typ + ") ret 99 }\n"
                invalid.push((mode, "integer division by zero"))
                if signed && operation == "Div" {
                    let minimum = match typ {
                        "i8" => "-128_i8" "i16" => "-32768_i16" "i32" => "-2147483648_i32" "i64" => "-9223372036854775808_i64"
                        _ => "((1_usize << (word_bits() - 1_usize)) as isize)"
                    }
                    let mode = name + "_overflow"
                    modes = modes + "\"" + mode + "\" => { let ignored = " + name + "(" + minimum + ", -1_" + typ + ") ret 99 }\n"
                    invalid.push((mode, "integer division overflow"))
                }
                if signed && operation == "Rem" {
                    valid = valid + "if " + name + "(-12_" + typ + ", -1_" + typ + ") != 0_" + typ + " { ret 3 }\n"
                    valid_count += 1
                }
            } else {
                let width = if String::from_str(typ).ends_with("size") { "(word_bits() as " + typ + ")" } else { typ.slice_bytes(1, typ.byte_len() - 1) + "_" + typ }
                let mode = name + "_wide"
                modes = modes + "\"" + mode + "\" => { let ignored = " + name + "(1_" + typ + ", " + width + ") ret 99 }\n"
                invalid.push((mode, "integer shift out of range"))
                if signed {
                    let mode = name + "_negative"
                    modes = modes + "\"" + mode + "\" => { let ignored = " + name + "(1_" + typ + ", -1_" + typ + ") ret 99 }\n"
                    invalid.push((mode, "integer shift out of range"))
                }
            }
        }
    }
    if valid_count != 45 || invalid.len() != 55 { ret fixture.finish(false) }
    sources = sources + "extern fn encore_word_bits() -> usize\n#attr(safe)\nfn word_bits() -> usize { unsafe { ret encore_word_bits() } }\n"
    fixture.put("src/main.enq", sources + "fn main() -> u32 { let mode = argv(1_usize).unwrap_or(\"ok\") match mode {\n" +
        "\"vec_capacity\" => { let ignored = Vec[u64]::with_capacity(0_usize - 1_usize) ret 99 }\n" +
        "\"vec_reserve\" => { let mut vec = Vec[u8]::singleton(1_u8) vec.reserve(0_usize - 1_usize) ret 99 }\n" + modes + "_ => {} }\n" + valid + "ret 0 }\n")
    if !fixture.command(vec!["build", "--jobs", "2"]).success() { ret fixture.finish(false) }
    let binary = fixture.binary("system_safety", "dev")
    if !Command::new(binary.as_str()).output().success() { ret fixture.finish(false) }
    invalid.push(("vec_capacity", "Vec capacity overflow")) invalid.push(("vec_reserve", "Vec capacity overflow"))
    for entry in invalid {
        let output = Command::new(binary.as_str()).arg(entry.0).output()
        if output.code() != 1 || !String::from_str(output.text()).contains(entry.1) { ret fixture.finish(false) }
    }
    ret fixture.finish(true)
}
