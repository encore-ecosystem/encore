// @expect.compile_error=plugin handle storage is opaque outside its SDK
import std::plugin::Plugin
fn tamper(plugin: mut Plugin) {
    plugin.lease.token = 0_usize
}
fn main() -> u32 {
    match unsafe {
        Plugin::load("unused")
    }
    {
        Ok(plugin) => {
            let mut owned = plugin tamper(owned)
        }
        Err(_) => {
        }
    }
    ret 0
}
