//! Cast operands infer their own branch type before the destination conversion.

fn pick(first: bool, left: u32, right: u32) -> usize {
    ret(if first {
            left
        } else {
            right
        }
    ) as usize
}

fn narrow(first: bool, left: u32, right: u32) -> u8 {
    ret(if first {
            left
        } else {
            right
        }
    ) as u8
}

fn signed(first: bool, left: i32, right: i32) -> i64 {
    ret(if first {
            left
        } else {
            right
        }
    ) as i64
}

fn floating(first: bool, left: f32, right: f32) -> i32 {
    ret(if first {
            left
        } else {
            right
        }
    ) as i32
}

fn matched(first: bool, left: u32, right: u32) -> usize {
    ret(match first {
            true => left false => right
        }
    ) as usize
}

fn nested(first: bool, left: u32, right: u32) -> u64 {
    let result: u64 =( {
            (if first {
                    left
                } else {
                    right
                }
            ) as u8
        }
    ) as u64
    ret result
}

fn literal_sibling(first: bool, value: f32) -> i32 {
    ret(if first {
            3.5
        } else {
            value
        }
    ) as i32
}

fn accept(left: usize, right: u16) -> usize {
    ret left + right as usize
}

fn early(first: bool, value: u32) -> usize {
    ret(if first {
            ret 7
        } else {
            value
        }
    ) as usize
}

fn main() -> u32 {
    if pick(true, 0x1234, 0x4567) != 0x1234 ||
    pick(false, 0x1234, 0x4567) != 0x4567 {
        ret 1
    }
    if narrow(true, 0x1234, 0x4567) != 0x34 ||
    narrow(false, 0x1234, 0x4567) != 0x67 {
        ret 2
    }
    if signed(true, - 3_i32, 42) != - 3_i64 ||
    signed(false, - 3_i32, 42) != 42 {
        ret 3
    }
    if floating(true, 3.75, - 2.75_f32) != 3 ||
    floating(false, 3.75, - 2.75_f32) != - 2_i32 {
        ret 4
    }
    if matched(true, 123, 456) != 123 || matched(false, 123, 456) != 456 {
        ret 5
    }
    if nested(true, 0x1234, 0x4567) != 0x34 ||
    nested(false, 0x1234, 0x4567) != 0x67 {
        ret 6
    }
    if literal_sibling(true, 8.5) != 3 || literal_sibling(false, 8.5) != 8 {
        ret 7
    }
    // The cast must restore the caller's context for subsequent arguments.
    if accept((if true {
                3_u32
            } else {
                4_u32
            }
        ) as usize, 5000) != 5003 {
        ret 8
    }
    if early(true, 123) != 7 || early(false, 123) != 123 {
        ret 9
    }
    ret 0
}
