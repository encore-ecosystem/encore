//! Unrelated imports must not hide compiler-created JoinHandle methods.
import core::fmt::Debug

fn work() -> u32 {
    ret 42_u32
}

fn main() -> u32 {
    let handle = spawn work()
    let finished: bool = handle.is_finished()
    let _description = Debug::fmt(finished)
    ret if handle.join() == 42_u32 {
        0_u32
    } else {
        1_u32
    }
}
