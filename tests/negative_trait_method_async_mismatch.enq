// @expect.compile_error=error[trait-method-async-mismatch]: method 'value' is synchronous, but the trait requires async

trait AsyncValue {
    async fn value(self: Self) -> u32
}

struct Value {}

impl AsyncValue for Value {
    fn value(self: Self) -> u32 {
        ret 1_u32
    }
}

fn main() -> u32 {
    ret 0_u32
}
