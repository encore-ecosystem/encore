//! Dense module selections contain ordinals, not full declaration records.
//! A valid shared index must fit the scalar allocation budget and round-trip.
import core::fmt::Debug
import core::testing::assert

import std::vec::Vec

import ehirlib::prepared_bytes_payload

import refrain::frontend::hir::TypeId
import refrain::frontend::semantic::{SemanticCallable, SemanticField, SemanticMethod, SemanticVariant}
import refrain::frontend::semantic_artifact::{CallableBinding, ModuleSemanticView, SemanticIndexArtifact}
import refrain::frontend::semantic_codec::encode_snapshot_SemanticIndexArtifact
import refrain::frontend::semantic_index::PackageSemanticIndex
import refrain::frontend::type_scope::TypeNameBinding

fn main() -> u32 {
    let mut selection = Vec[usize]::with_capacity(24576_usize)
    for _index in 0_usize..24576_usize {
        selection.push(0_usize)
    }
    let mut modules = Vec[ModuleSemanticView]::new()
    for index in 0_usize..64_usize {
        modules.push(ModuleSemanticView {
                "slice-" + Debug::fmt(index), "checked", selection,
                Vec[usize]::new(), Vec[usize]::new(), Vec[usize]::new(), Vec[usize]::new(), Vec[str]::new(), Vec[str]::new()
            }
        )
    }
    let artifact = SemanticIndexArtifact {
        2_u32, "dense-selections", Vec[TypeId]::new(),
        vec![SemanticCallable::new("api", "value", Vec[str]::new(), "u32")],
        vec![CallableBinding { 0_usize, "value", "api", 0_u64 }],
        Vec[SemanticField]::new(), Vec[SemanticMethod]::new(), Vec[SemanticVariant]::new(), Vec[TypeNameBinding]::new(), modules
    }
    let bytes = match encode_snapshot_SemanticIndexArtifact(artifact, "semantic-index-2") {
        Ok(bytes) => bytes Err(_) => {
            ret 1_u32
        }
    }
    let decoded = match PackageSemanticIndex::decode(prepared_bytes_payload(bytes), "dense-selections") {
        Ok(value) => value Err(_) => {
            ret 2_u32
        }
    }
    let view = match decoded.module("slice-63") {
        Some(value) => value None => {
            ret 3_u32
        }
    }
    if !assert(decoded.modules.len() == 64_usize && decoded.callables_for(view).len() == 24576_usize) {
        ret 4_u32
    }
    ret 0_u32
}
