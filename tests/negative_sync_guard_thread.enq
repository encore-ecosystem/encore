// @expect.compile_error=thread-unsafe-type
import core::result::Result
import std::sync::{Mutex, MutexGuard}
fn consume(guard: MutexGuard[u64]) -> u32 {
    guard.release() ret 0_u32
}
fn main() -> u32 {
    let mutex = Mutex[u64]::new(0_u64)
    let guard = match mutex.lock() {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let worker = spawn consume(guard)
    ret worker.join()
}
