//! Authentication never accepts browser credentials or remote plaintext URLs.
import refrain::modes::registry_auth::{registry_origin, valid_registry_token}

fn main() -> u32 {
    if registry_origin("https://example.org/index") != "https://example.org" {
        ret 1_u32
    }
    if registry_origin("http://localhost:8137/index") != "http://localhost:8137" {
        ret 2_u32
    }
    if registry_origin("http://localhost.evil/index") != "" {
        ret 3_u32
    }
    if registry_origin("https://user@example.org/index") != "" {
        ret 4_u32
    }
    if registry_origin("file:///tmp/index") != "" {
        ret 5_u32
    }
    let suffix = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    if !valid_registry_token("end_" + suffix) || !valid_registry_token("enc_" + suffix) {
        ret 6_u32
    }
    if valid_registry_token("ens_" + suffix) || valid_registry_token("enc_" + suffix + "\n") {
        ret 7_u32
    }
    ret 0_u32
}
