import core::testing::assert
import core::vec::Vec

struct Node { value: u32 children: Vec[Node] }
struct Item { value: u32 label: str }

impl for Node {
    fn leaf(value: u32) -> Node { ret Node { value, Vec[Node]::new() } }
    fn branch(value: u32, children: Vec[Node]) -> Node { ret Node { value, children } }
    fn value(self: Self) -> u32 { ret self.value }
    fn children(self: Self) -> Vec[Node] { ret self.children }
}

fn sum_tree(node: Node) -> u32 {
    let value = node.value()
    let children = node.children()
    let mut total = value
    for child in children { total = total + sum_tree(child) }
    ret total
}

fn flatten_tree(node: Node) -> Vec[Item] {
    let children = node.children()
    let mut items = Vec[Item]::new()
    items.push(Item { node.value(), "node" })
    for child in children {
        let nested = flatten_tree(child)
        for item in nested { items.push(item) }
    }
    ret items
}

fn main() -> u32 {
    let mut children = Vec[Node]::new()
    children.push(Node::leaf(2_u32))
    children.push(Node::leaf(3_u32))
    let root = Node::branch(1_u32, children)
    if !assert(sum_tree(root) == 6_u32) { ret 1_u32 }
    let items = flatten_tree(root)
    if !assert(items.len() == 3_usize) { ret 2_u32 }
    match items.get(2_usize) {
        Some(item) => { if !assert(item.value == 3_u32 && item.label == "node") { ret 3_u32 } }
        None => { ret 4_u32 }
    }
    ret 0_u32
}
