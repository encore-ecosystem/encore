//! Regression for issue #162.
import core::future::{Future, Poll, Context}
import core::result::Result

import std::future::block_on
struct State[T] {
    value: T
}

impl[T] Future[Result[T, str]] for State[T] {
    fn poll(self: Self, ctx: Context) -> Poll[Self, Result[T, str]] {
        ret Poll[Self, Result[T, str]]::Ready(Result::Ok(self.value))
    }
}
async fn run() -> Result[u32, str] {
    ret await State[u32] { 42_u32 }
}
fn main() -> u32 {
    ret if block_on[Result[u32, str], __encore_future_run](run()).unwrap_or(0_u32) == 42_u32 {
        0_u32
    } else {
        1_u32
    }
}
