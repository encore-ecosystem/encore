//! Typed interning must retain the exact equivalence classes of the JSON keys.
import core::fmt::Debug
import core::option::Option
import core::testing::assert
import std::vec::Vec
import json::{Json, stringify}
import refrain::frontend::hir::TypeId
import refrain::frontend::semantic::{SemanticCallable, SemanticField, SemanticMethod, SemanticVariant}
import refrain::frontend::semantic_environment::{StoredSemanticEnvironment, encode_callable, encode_field, encode_method, encode_variant}
import refrain::frontend::semantic_index::SemanticIndexBuilder
import refrain::frontend::semantic_record_index::SemanticRecord
import refrain::frontend::type_scope::TypeNameBinding

fn name_key(value: TypeNameBinding) -> Json {
    ret Json::Array(vec![Json::String(value.scope), Json::String(value.name), Json::String(value.identity),
        Json::String(value.display), Json::String(value.declaration)])
}
// Deliberately independent reference: linear lookup of the former JSON keys.
fn intern(keys: mut Vec[str], key: str) -> usize {
    for index in 0_usize..keys.len() { if keys.get_unchecked_borrowed(index) == key { ret index } }
    let result = keys.len()
    keys.push(key)
    ret result
}
fn positions_match(left: Vec[usize], right: Vec[usize]) -> bool {
    if left.len() != right.len() { ret false }
    for index in 0_usize..left.len() { if left.get_unchecked_borrowed(index) != right.get_unchecked_borrowed(index) { ret false } }
    ret true
}

fn callable(change: usize) -> SemanticCallable {
    ret SemanticCallable {
        if change == 1_usize { "module:\nИмя" } else { "module" },
        if change == 2_usize { "other" } else { "alias" },
        if change == 3_usize { vec!["ab", "c"] } else { vec!["a", "bc"] },
        if change == 4_usize { "str" } else { "u32" },
        if change == 5_usize { 8_u64 } else { 7_u64 },
        if change == 6_usize { "another" } else { "original" },
        if change == 7_usize { "other\nconsumer" } else { "consumer" },
        if change == 8_usize { 24_u64 } else { 23_u64 },
        if change == 9_usize { vec!["T", ""] } else { vec!["T"] },
        if change == 10_usize { true } else { false }
    }
}

fn field(change: usize) -> SemanticField {
    ret SemanticField {
        if change == 1_usize { "other" } else { "module" },
        if change == 2_usize { "Other" } else { "Owner" },
        if change == 3_usize { "va\0lue" } else { "value" },
        if change == 4_usize { "str" } else { "u32" },
        if change == 5_usize { 8_u64 } else { 7_u64 },
        if change == 6_usize { Vec[str]::new() } else { vec!["T"] },
        if change == 7_usize { "Other[T]" } else { "Owner[T]" }
    }
}

fn method(change: usize) -> SemanticMethod {
    ret SemanticMethod {
        if change == 1_usize { "other" } else { "module" },
        if change == 2_usize { "Other" } else { "Owner" },
        if change == 3_usize { "r\"ead" } else { "read" },
        if change == 4_usize { vec!["ab", "c"] } else { vec!["a", "bc"] },
        if change == 5_usize { "str" } else { "u32" },
        if change == 6_usize { 8_u64 } else { 7_u64 },
        if change == 7_usize { "Other[T]" } else { "Owner[T]" },
        if change == 8_usize { Vec[str]::new() } else { vec!["T"] },
        if change == 9_usize { true } else { false },
        if change == 10_usize { true } else { false },
        if change == 11_usize { vec!["U", ""] } else { vec!["U"] }
    }
}

fn variant(change: usize) -> SemanticVariant {
    ret SemanticVariant {
        if change == 1_usize { "Other" } else { "Choice" },
        if change == 2_usize { "other" } else { "Some" },
        if change == 3_usize { "str" } else { "u32" },
        if change == 4_usize { Vec[str]::new() } else { vec!["T"] }
    }
}

fn name(change: usize) -> TypeNameBinding {
    ret TypeNameBinding {
        if change == 1_usize { "other" } else { "module" },
        if change == 2_usize { "Итем" } else { "Item" },
        if change == 3_usize { "@1" } else { "@0" },
        if change == 4_usize { "I\\tem" } else { "Item" },
        if change == 5_usize { "It\nem" } else { "Item" }
    }
}

fn equality_matches_json() -> bool {
    for left in 0_usize..12_usize {
        for right in 0_usize..12_usize {
            let a = callable(left)
            let b = callable(right)
            let equal = stringify(encode_callable(a)) == stringify(encode_callable(b))
            if a.same_record(b) != equal || (equal && a.record_hash() != b.record_hash()) { ret false }
        }
    }
    for left in 0_usize..9_usize {
        for right in 0_usize..9_usize {
            let a = field(left)
            let b = field(right)
            let equal = stringify(encode_field(a)) == stringify(encode_field(b))
            if a.same_record(b) != equal || (equal && a.record_hash() != b.record_hash()) { ret false }
        }
    }
    for left in 0_usize..13_usize {
        for right in 0_usize..13_usize {
            let a = method(left)
            let b = method(right)
            let equal = stringify(encode_method(a)) == stringify(encode_method(b))
            if a.same_record(b) != equal || (equal && a.record_hash() != b.record_hash()) { ret false }
        }
    }
    for left in 0_usize..6_usize {
        for right in 0_usize..6_usize {
            let a = variant(left)
            let b = variant(right)
            let equal = stringify(encode_variant(a)) == stringify(encode_variant(b))
            if a.same_record(b) != equal || (equal && a.record_hash() != b.record_hash()) { ret false }
        }
    }
    for left in 0_usize..7_usize {
        for right in 0_usize..7_usize {
            let a = name(left)
            let b = name(right)
            let equal = stringify(name_key(a)) == stringify(name_key(b))
            if a.same_record(b) != equal || (equal && a.record_hash() != b.record_hash()) { ret false }
        }
    }
    ret true
}

fn main() -> u32 {
    if !assert(equality_matches_json()) { ret 1_u32 }
    let mut builder = SemanticIndexBuilder::new("test-index")
    let mut expected_declarations = Vec[str]::new()
    let mut expected_bindings = Vec[str]::new()
    let mut expected_callables = Vec[str]::new()
    let mut expected_fields = Vec[str]::new()
    let mut expected_methods = Vec[str]::new()
    let mut expected_variants = Vec[str]::new()
    let mut expected_names = Vec[str]::new()
    let mut selected_callables = Vec[Vec[usize]]::new()
    let mut selected_fields = Vec[Vec[usize]]::new()
    let mut selected_methods = Vec[Vec[usize]]::new()
    let mut selected_variants = Vec[Vec[usize]]::new()
    let mut selected_names = Vec[Vec[usize]]::new()
    for round in 0_usize..3_usize {
        let mut callables = Vec[SemanticCallable]::new()
        let mut callables_positions = Vec[usize]::new()
        for offset in 0_usize..12_usize {
            let change = if round == 1_usize { 11_usize - offset } else { offset }
            let value = callable(change)
            callables.push(value)
            let declaration = value.in_scope(value.declaration_name, value.module_name, 0_u64)
            let ordinal = intern(expected_declarations, stringify(encode_callable(declaration)))
            let binding_key = stringify(Json::Array(vec![Json::String(Debug::fmt(ordinal + 1_usize)), Json::String(value.name),
                Json::String(value.lookup_module), Json::String(Debug::fmt(value.binding_identity))]))
            let before = expected_bindings.len()
            let binding = intern(expected_bindings, binding_key)
            if binding == before { expected_callables.push(stringify(encode_callable(value))) }
            callables_positions.push(binding)
        }
        selected_callables.push(callables_positions)
        let mut fields = Vec[SemanticField]::new()
        let mut fields_positions = Vec[usize]::new()
        for offset in 0_usize..9_usize {
            let change = if round == 1_usize { 8_usize - offset } else { offset }
            let value = field(change)
            fields.push(value)
            fields_positions.push(intern(expected_fields, stringify(encode_field(value))))
        }
        selected_fields.push(fields_positions)
        let mut methods = Vec[SemanticMethod]::new()
        let mut methods_positions = Vec[usize]::new()
        for offset in 0_usize..13_usize {
            let change = if round == 1_usize { 12_usize - offset } else { offset }
            let value = method(change)
            methods.push(value)
            methods_positions.push(intern(expected_methods, stringify(encode_method(value))))
        }
        selected_methods.push(methods_positions)
        let mut variants = Vec[SemanticVariant]::new()
        let mut variants_positions = Vec[usize]::new()
        for offset in 0_usize..6_usize {
            let change = if round == 1_usize { 5_usize - offset } else { offset }
            let value = variant(change)
            variants.push(value)
            variants_positions.push(intern(expected_variants, stringify(encode_variant(value))))
        }
        selected_variants.push(variants_positions)
        let mut names = Vec[TypeNameBinding]::new()
        let mut names_positions = Vec[usize]::new()
        for offset in 0_usize..7_usize {
            let change = if round == 1_usize { 6_usize - offset } else { offset }
            let value = name(change)
            names.push(value)
            names_positions.push(intern(expected_names, stringify(name_key(value))))
        }
        selected_names.push(names_positions)
        builder.include("module-" + Debug::fmt(round), "context-" + Debug::fmt(round), StoredSemanticEnvironment {
            callables, fields, methods, vec!["@0", "@0"], vec!["@0::Some"], variants, names
        })
    }
    let index = builder.finish(vec![TypeId::named("first", "First"), TypeId::named("second", "Second")])
    if !assert(index.declarations.len() == expected_declarations.len()) { ret 2_u32 }
    for ordinal in 0_usize..index.declarations.len() {
        if !assert(stringify(encode_callable(index.declarations.get_unchecked_borrowed(ordinal))) == expected_declarations.get_unchecked_borrowed(ordinal)) { ret 2_u32 }
    }
    if !assert(index.callables.len() == expected_callables.len()) { ret 3_u32 }
    for ordinal in 0_usize..index.callables.len() {
        if !assert(stringify(encode_callable(index.callables.get_unchecked_borrowed(ordinal))) == expected_callables.get_unchecked_borrowed(ordinal)) { ret 3_u32 }
    }
    if !assert(index.fields.len() == expected_fields.len()) { ret 4_u32 }
    for ordinal in 0_usize..index.fields.len() {
        if !assert(stringify(encode_field(index.fields.get_unchecked_borrowed(ordinal))) == expected_fields.get_unchecked_borrowed(ordinal)) { ret 4_u32 }
    }
    if !assert(index.methods.len() == expected_methods.len()) { ret 5_u32 }
    for ordinal in 0_usize..index.methods.len() {
        if !assert(stringify(encode_method(index.methods.get_unchecked_borrowed(ordinal))) == expected_methods.get_unchecked_borrowed(ordinal)) { ret 5_u32 }
    }
    if !assert(index.variants.len() == expected_variants.len()) { ret 6_u32 }
    for ordinal in 0_usize..index.variants.len() {
        if !assert(stringify(encode_variant(index.variants.get_unchecked_borrowed(ordinal))) == expected_variants.get_unchecked_borrowed(ordinal)) { ret 6_u32 }
    }
    if !assert(index.names.len() == expected_names.len()) { ret 7_u32 }
    for ordinal in 0_usize..index.names.len() {
        if !assert(stringify(name_key(index.names.get_unchecked_borrowed(ordinal))) == expected_names.get_unchecked_borrowed(ordinal)) { ret 7_u32 }
    }
    for round in 0_usize..3_usize {
        let view = match index.module("module-" + Debug::fmt(round)) { Some(value) => value None => { ret 8_u32 } }
        if !assert(positions_match(view.callables, selected_callables.get_unchecked_borrowed(round)) &&
            positions_match(view.fields, selected_fields.get_unchecked_borrowed(round)) &&
            positions_match(view.methods, selected_methods.get_unchecked_borrowed(round)) &&
            positions_match(view.variants, selected_variants.get_unchecked_borrowed(round)) &&
            positions_match(view.names, selected_names.get_unchecked_borrowed(round))) { ret 9_u32 }
        if !assert(view.context == "context-" + Debug::fmt(round) && view.aggregates.len() == 2_usize && view.constructors.len() == 1_usize) { ret 10_u32 }
    }
    ret 0_u32
}
