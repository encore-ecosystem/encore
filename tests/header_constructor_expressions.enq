//! Nested constructors in control-flow headers survive complete compilation.
struct Value {
    number: u32
}
fn accepted(value: Value) -> bool {
    ret value.number == 42
}
fn pair(values:(Value, Value)) -> bool {
    ret values.0.number == 41 && values.1.number == 42
}
fn array(values:[Value;
        2]) -> bool {
    ret values[0].number == 41 && values[1].number == 42
}

fn main() -> u32 {
    let enabled = true
    if !accepted(Value {
            42
        }
    ) || !enabled {
        ret 1
    }
    if (Value {
            42
        }
    ).number != 42 {
        ret 2
    }
    if !pair((Value {
                41
            }
            , Value {
                42
            }
            ,
        )) {
        ret 3
    }
    if !array([Value {
                41
            }
            , Value {
                42
            }
        ],) {
        ret 4
    }
    let mut count = 0
    while accepted(Value {
            42
        }
    ) && count < 2 {
        count += 1
    }
    if count != 2 {
        ret 5
    }
    match accepted(Value {
            42
        }
    ) {
        true => {
        }
        false => {
            ret 6
        }
    }
    ret 0
}
