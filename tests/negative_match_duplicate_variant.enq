//@expect.compile_error=:6:11: error[duplicate-match-arm]: duplicate match arm for variant 'Some'
import core::option::Option

fn main() -> u32 {
    let value = Option[u32]::Some(1_u32)
    match value {
        Option::Some(x) => {
            ret x
        }
        Option::Some(y) => {
            ret y
        }
        Option::None => {
            ret 0_u32
        }
    }
}
