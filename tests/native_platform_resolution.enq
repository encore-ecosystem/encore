//! Native workspaces resolve the bundled platform package without a target kit.

import std::os::file_exists
import std::path::Path
import refrain::project::system_platform_root
import refrain::target::{host_target, target_is_host}

fn main() -> u32 {
    let target = host_target()
    if !target_is_host(target) { ret 1_u32 }
    let platform = system_platform_root(Path::new("."), target)
    if !file_exists(platform.join("encore.toml").as_str()) { ret 2_u32 }
    if !file_exists(platform.join("src").join("lib.enq").as_str()) { ret 3_u32 }
    ret 0_u32
}
