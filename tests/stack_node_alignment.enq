//! Stack nodes created after control flow keep the native 16-byte stack ABI.

extern fn encore_node_debug_live_count() -> usize

struct Four {
    value: u32
}
struct Eight {
    value: u64
}
struct Twelve {
    first: u32
    second: u32
    third: u32
}
struct TwentyFour {
    first: u64
    second: u64
    third: u64
}

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

fn exercise(branch: u32) -> u32 {
    if branch == 0_u32 {
        let mut value = Four<S>{ 11_u32 }
        value.value += 1_u32
        if value.value != 12_u32 {
            ret 1_u32
        }
    } elif branch == 1_u32 {
        let mut value = Eight<S>{ 13_u64 }
        value.value += 1_u64
        if value.value != 14_u64 {
            ret 2_u32
        }
    } elif branch == 2_u32 {
        let mut value = Twelve<S>{ 3_u32, 5_u32, 7_u32 }
        value.third += 1_u32
        if value.first + value.second + value.third != 16_u32 {
            ret 3_u32
        }
    } else {
        let mut value = TwentyFour<S>{ 17_u64, 19_u64, 23_u64 }
        value.third += 1_u64
        if value.first + value.second + value.third != 60_u64 {
            ret 4_u32
        }
    }
    ret 0_u32
}

fn main() -> u32 {
    let before = live_nodes()
    for index in 0_usize..32_usize {
        let result = exercise((index % 4_usize) as u32)
        if result != 0_u32 {
            ret result
        }
        if live_nodes() != before {
            ret 5_u32
        }
    }
    ret 0_u32
}
