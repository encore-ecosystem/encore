// @expect.compile_error=error[cannot-infer-enum-type]: cannot infer generic arguments for enum 'Option'

pub struct Holder {
    value: Option[u32]
}
import core::option::Option
pub fn choose(input: Option[u32]) -> Holder {
    let output = match input {
        Option::Some(value) => {
            if value == 0_u32 {
                Option::None
            } else {
                Option::Some(value)
            }
        }
        Option::None => Option::None
    }
    ret Holder { output }
}

fn main() -> u32 {
    ret 0
}
