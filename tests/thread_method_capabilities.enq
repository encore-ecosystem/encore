import core::vec::Vec

struct Reader {}

impl for Reader {
    fn count(self: Reader, values: frozen Vec[str]) -> usize {
        ret values.len()
    }

    fn consume(self: Reader, values: sending Vec[str]) -> usize {
        ret values.len()
    }
}

fn shared_count(values: frozen Vec[str]) -> usize {
    let reader = Reader{}
    ret reader.count(values)
}

fn main() -> u32 {
    let mut shared = Vec[str]::new()
    shared.push("one")
    shared.push("two")
    let first = spawn shared_count(shared)
    let second = spawn shared_count(shared)

    let mut owned = Vec[str]::new()
    owned.push("moved")
    let consumed = Reader{}.consume(owned)
    ret if first.join() == 2_usize && second.join() == 2_usize && consumed == 1_usize {
        0_u32
    } else {
        1_u32
    }
}
