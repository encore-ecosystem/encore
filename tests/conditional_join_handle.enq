//! Mutually exclusive branch consumption preserves the sibling's environment (#98).
import std::thread::JoinHandle
fn work() -> u32 {
    ret 42
}
fn consume(handle: JoinHandle[u32]) -> u32 {
    ret handle.join()
}
fn original(handle: JoinHandle[u32]) -> u32 {
    ret if handle.is_finished() {
        consume(handle)
    } else {
        consume(handle)
    }
}
fn selected(handle: JoinHandle[u32], first: bool) -> u32 {
    let result = if first {
        consume(handle)
    } else {
        consume(handle)
    }
    ret result
}
fn statements(handle: JoinHandle[u32], first: bool) -> u32 {
    let mut result = 0_u32
    if first {
        result = consume(handle)
    } else {
        result = consume(handle)
    }
    ret result
}
fn main() -> u32 {
    for first in vec![true, false] {
        if original(spawn work()) != 42 {
            ret 1
        }
        if selected(spawn work(), first) != 42 {
            ret 2
        }
        if statements(spawn work(), first) != 42 {
            ret 3
        }
    }
    ret 0
}
