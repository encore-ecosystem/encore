//! Pooled body records preserve every JSON variant and legacy checkpoints.
import core::testing::assert
import std::vec::Vec

import binary
import ehirlib::prepared_bytes_payload
import json::{Json, stringify}

import refrain::cache_identity::compiler_content_digest
import refrain::frontend::semantic_index::{SemanticModuleRecord, decode_semantic_module, encode_semantic_module}

fn main() -> u32 {
    let mut rows = Vec[Json]::new()
    for _index in 0_usize..3000_usize {
        rows.push(Json::Array(vec![Json::Null, Json::Bool(true), Json::Number("42"), Json::String("повторяемое имя\0тело"),
                    Json::Object(vec![("field", Json::String("повторяемое имя\0тело")),("field", Json::String("duplicate"))])]))
    }
    let replay = Json::Array(rows)
    let index = compiler_content_digest("same nominal pool")
    let payload = encode_semantic_module(index, replay).unwrap_or("")
    let legacy = prepared_bytes_payload(binary::encode(SemanticModuleRecord { 1_u32, index, replay }).unwrap_or(Vec[u8]::new()))
    if !assert(payload.byte_len() > 8_usize && payload.slice_bytes(0_usize, 8_usize) == "ENQSR001" && payload.byte_len() < legacy.byte_len()) {
        ret 1_u32
    }
    let decoded = match decode_semantic_module(payload) {
        Ok(value) => value Err(_) => {
            ret 2_u32
        }
    }
    if !assert(decoded.index == index && stringify(decoded.replay) == stringify(replay) &&
        stringify(decode_semantic_module(legacy).unwrap_or(SemanticModuleRecord {
                    0_u32, "", Json::Null
                }
            ).replay) == stringify(replay)) {
        ret 3_u32
    }
    if !assert(decode_semantic_module(payload.slice_bytes(0_usize, payload.byte_len() - 1_usize)).is_err() &&
        decode_semantic_module("invalid semantic checkpoint").is_err()) {
        ret 4_u32
    }
    ret 0_u32
}
