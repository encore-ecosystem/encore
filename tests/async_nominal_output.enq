//! Generated futures preserve the lexical identity of nominal output types.
import core::result::Result
import std::future::block_on

struct Payload {
    value: u32
}
struct Failure {
    message: str
}
async fn make(fail: bool) -> Result[Payload, Failure] {
    ret if fail {
        Result[Payload, Failure]::Err(Failure { "expected" })
    } else {
        Result[Payload, Failure]::Ok(Payload { 42_u32 })
    }
}
async fn forward(fail: bool) -> Result[u32, str] {
    ret match await make(fail) {
        Result::Ok(payload) => Result[u32, str]::Ok(payload.value)
        Result::Err(error) => Result[u32, str]::Err(error.message)
    }
}
async fn generic[T](value: T) -> T {
    ret value
}
async fn scenario() -> bool {
    let success = await forward(false)
    let failure = await forward(true)
    let saved = generic[Payload](Payload { 73_u32 })
    let payload = await saved
    ret success.unwrap_or(0_u32) == 42_u32 && failure.unwrap_err_or("") == "expected" && payload.value == 73_u32
}
fn main() -> u32 {
    ret if block_on[bool, __encore_future_scenario](scenario()) {
        0_u32
    } else {
        1_u32
    }
}
