import core::option::Option
import core::vec::Vec

struct Slot {
    values: Vec[u32]
    width: u32
}

fn main() -> u32 {
    let mut initial = Vec[u32]::new()
    initial.push(1_u32)
    let mut target = Slot{initial, 1_u32}
    let mut replacement = Vec[u32]::new()
    replacement.push(2_u32)
    let maybe = Option[Slot]::Some(Slot{replacement, 2_u32})
    match maybe {
        Option::Some(slot) => {
            let before = slot.width
            target = slot
            if before != 2_u32 || target.width != 2_u32 || target.values.len() != 1_usize {
                ret 1_u32
            }
        }
        Option::None => { ret 2_u32 }
    }
    ret 0_u32
}
