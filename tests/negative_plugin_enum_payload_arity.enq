// @expect.compile_error=plugin enum variants accept one DTO payload
import std::plugin::Plugin

enum Choice {
    Pair(u32, str)
}
#attr(plugin_interface)
trait Bad {
    fn echo(self: Self, value: Choice) -> Choice
}
fn main() -> u32 {
    match unsafe {
        Plugin::load("unused")
    }
    {
        Ok(plugin) => {
            let binding = plugin.bind[dyn Bad]("bad")
        }
        Err(_) => {
        }
    }
    ret 0
}
