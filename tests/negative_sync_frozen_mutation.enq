// @expect.compile_error=frozen-region-mutation
import core::vec::Vec
import std::sync::Frozen
fn main() -> u32 {
    let mut values = Vec[str]::new()
    values.push("snapshot")
    let snapshot = Frozen[Vec[str]]::new(values)
    let mut borrowed = snapshot.get()
    borrowed.push("mutation")
    ret 0_u32
}
