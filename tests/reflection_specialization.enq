//! Type substitution preserves member names, strings and mutable runtime locals.
import ehirlib::{parse_module_text, prepare_module, PreparationOutcome}
import refrain::frontend::translator::translate_to_ehir
import refrain::frontend::{Lexer, Parser}
import std::io::eprintln
fn main() -> u32 {
    let source = "struct Record { T: u32 }\n" +
    "fn inspect[T](value: T) -> u32 { let info = reflect::type_info[T]() " +
    "let mut flag = false flag = true if flag { ret value.T } ret 0 }\n" +
    "fn label[T](value: T) -> str { let info = reflect::type_info[T]() ret \"T\" }\n" +
    "fn main() -> u32 { let value = Record { 42_u32 } let text = label[Record](value) ret inspect[Record](value) }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("reflection-specialization")
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if !output.contains("\"T\"_str") || output.contains("type_info") {
        ret 1
    }
    match prepare_module(parse_module_text("reflection-specialization", output)) {
        PreparationOutcome::Ready(_) => {
            ret 0
        }
        PreparationOutcome::Error(message) => {
            eprintln(message) ret 2
        }
    }
}
