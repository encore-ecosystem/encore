//! Generic-bound methods are shared by inference and member queries.

import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    let declarations = "trait Get[ResultType] { fn get(self: Self) -> ResultType }\n"
    database.set_module("bounds", "bounds.enq", declarations
        + "fn sample[T: Get[str]](value: T) { let result = value.get() }\n")
    let id = database.symbol_id("bounds", "sample").unwrap_or(SymbolId::invalid())
    let body = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(body.binding_type("result").unwrap_or("") == "str") { ret 1_u32 }
    let again = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(again.binding_type("result").unwrap_or("") == "str") { ret 2_u32 }
    if !assert(database.semantic_body_count(id) == 1_usize) { ret 3_u32 }
    database.set_module("bounds", "bounds.enq", declarations
        + "fn sample[T: Get[u32]](value: T) { let result = value.get() }\n")
    let changed = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(changed.binding_type("result").unwrap_or("") == "u32") { ret 4_u32 }
    database.set_module("bounds", "bounds.enq", declarations
        + "fn sample[T](value: T) {\n value.\n}\n")
    if !assert(database.members_at("bounds", 2_usize, 7_usize).len() == 0_usize) { ret 5_u32 }
    database.set_module("bounds", "bounds.enq", declarations
        + "fn sample[T: Get[str]](value: T) {\n value.\n}\n")
    let members = database.members_at("bounds", 2_usize, 7_usize)
    if !assert(members.len() == 1_usize) { ret 6_u32 }
    for member in members {
        if !assert(member.name == "get" && member.typ == "str") { ret 7_u32 }
    }
    let impl_prefix = "trait Root { fn read(self: Self) -> u32 }\nstruct Holder[T] { item: T }\n"
    let impl_body = " for Holder[T] {\n fn sample(self: Self) {\n self.item.\n }\n}\n"
    database.set_module("impl_bounds", "impl_bounds.enq", impl_prefix + "impl[T]" + impl_body)
    if !assert(database.members_at("impl_bounds", 4_usize, 11_usize).len() == 0_usize) { ret 8_u32 }
    database.set_module("impl_bounds", "impl_bounds.enq", impl_prefix + "impl[T: Root]" + impl_body)
    let impl_members = database.members_at("impl_bounds", 4_usize, 11_usize)
    if !assert(impl_members.len() == 1_usize) { ret 9_u32 }
    for member in impl_members { if !assert(member.name == "read") { ret 10_u32 } }
    ret 0_u32
}
