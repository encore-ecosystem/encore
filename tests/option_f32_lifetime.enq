import core::option::Option
import core::vec::Vec

fn main() -> u32 {
    let mut values = Vec[f32]::new()
    values.push(3.5_f32)
    let first = match values.get(0_usize) {
        Option::Some(value) => value
        Option::None => 0.0_f32
    }
    let missing = values.get(3_usize).unwrap_or(2.25_f32)
    ret if first == 3.5_f32 && missing == 2.25_f32 { 0_u32 } else { 1_u32 }
}
