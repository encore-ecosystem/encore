struct Counter {
    value: u32
}

impl for Counter {
    fn read(self: Self&) -> u32 { ret self.value }
    fn increment(self: Self&) -> () { self.value += 1_u32 }
}

fn main() -> u32 {
    let counter = Counter<H>{41_u32}
    let mut iteration = 0_usize
    while iteration < 100000_usize {
        if counter.read() != 41_u32 + iteration as u32 { ret 1_u32 }
        counter.increment()
        iteration += 1_usize
    }
    ret if counter.read() == 100041_u32 { 0_u32 } else { 2_u32 }
}
