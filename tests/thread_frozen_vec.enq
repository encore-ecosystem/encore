import core::option::Option
import core::vec::Vec

fn checksum(values: frozen Vec[str]) -> u32 {
    let mut total = 0_u32
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option::Some(value) => { total += value.len() as u32 }
            Option::None => { ret 0_u32 }
        }
        index += 1_usize
    }
    ret total
}

fn main() -> u32 {
    let mut values = Vec[str]::new()
    values.push("alpha")
    values.push("beta")

    let first = spawn checksum(values)
    let second = spawn checksum(values)
    let local = checksum(values)
    ret if first.join() == 9_u32 && second.join() == 9_u32 && local == 9_u32 {
        0_u32
    } else {
        1_u32
    }
}
