//! Borrowed results acquire ownership before a call-scoped receiver is dropped.
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source = "struct Owner { text: str }\n" +
    "impl for Owner {\n#attr(borrowed_self)\n#attr(borrowed_return)\n" +
    "fn peek(self: Self) -> str { ret self.text }\n}\n" +
    "fn make() -> Owner { ret Owner{\"owned\"} }\n" +
    "fn dotted() -> str { ret make().peek() }\n" +
    "fn qualified() -> str { ret Owner::peek(make()) }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if !output.contains("call Owner::peek(entry_ret_0_expr_recv_call_1)\n    retain entry_ret_0_expr_method_0: str\n    drop entry_ret_0_expr_recv_call_1: Owner") {
        ret 1_u32
    }
    if !output.contains("call Owner::peek(entry_ret_0_expr_arg_0_call_1)\n    retain entry_ret_0_expr_call_0: str\n    drop entry_ret_0_expr_arg_0_call_1: Owner") {
        ret 2_u32
    }
    // The borrowed-return definition itself must not create an extra owner.
    if output.contains("retain entry_ret_0_expr_field_0: str") {
        ret 3_u32
    }
    ret 0_u32
}
