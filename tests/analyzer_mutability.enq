//! Mutable receiver uses must be discovered at every expression depth.
import refrain::analyzer::{AnalyzerConfig, analyze_document}
import refrain::frontend::analyze_source
import std::io::eprintln

fn warnings(body: str) -> usize {
    let source = "struct Counter { value: u32 }\nimpl for Counter { fn next(self: mut Self) -> u32 { self.value += 1 ret self.value } }\n" +
    "fn probe() -> u32 { let mut counter = Counter { 0_u32 }\n" + body + "\nret 0_u32 }\n"
    let document = analyze_source(source)
    if !document.parsed || document.diagnostics.len() != 0 {
        eprintln("Invalid test source: " + source) ret 999
    }
    let mut count = 0_usize
    for diagnostic in analyze_document("probe.enq", document, AnalyzerConfig::new()) {
        if diagnostic.code == "unused-mut" {
            count += 1
        }
    }
    ret count
}

fn main() -> u32 {
    for body in vec![
        "if counter.next() != 1 { ret 1 }",
        "if false { ret 1 } elif counter.next() != 1 { ret 2 }",
        "output(counter.next(), 1_u32)",
        "output(counter.next()).is_err()",
        "let value = counter.next()",
        "ret counter.next()",
        "while counter.next() < 3 {}",
        "do {} while counter.next() < 3",
        "for value in counter.next() {}",
        "with counter.next() as value {}",
        "match counter.next() { 1 => { ret 0 } _ => { ret 1 } }",
        "match true { true => { counter.next() } false => { ret 0 } }",
        "let value = match true { true => counter.next() false => 0_u32 }",
        "let value = if true { counter.next() } else { 0_u32 }",
        "let value = { counter.next() }",
        "let value = (counter.next(), 0_u32)",
        "let value = [counter.next(), 0_u32]",
        "let value = vec![counter.next()]",
        "let value = Holder { counter.next() }",
        "let value = [counter.next(); 3]",
        "let value = counter.next() as u64",
        "let value = !counter.next()",
        "let value = items[counter.next()]",
        "let value = | value | counter.next()",
        "let value = counter.next()?",
        "let value = await counter.next()",
        "let value = spawn counter.next()",
        "let value = f\"{counter.next()}\"",
        "counter.value = 1_u32",
        "unsafe { counter.next() }",
        "loop { counter.next() break }",
    ] {
        if warnings(body) != 0 {
            eprintln("False unused-mut: " + body) ret 1
        }
    }
    for body in vec![
        "let value = counter.value",
        "output(counter)",
        "let counter = Counter { 1_u32 } counter.next()",
        "if true { let counter = Counter { 1_u32 } counter.next() }",
        "let closure = | counter | counter.next()",
    ] {
        if warnings(body) != 1 {
            eprintln("Missing unused-mut: " + body) ret 2
        }
    }
    ret 0
}
