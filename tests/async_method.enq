import core::future::{Context, Future, Poll}
import std::future::block_on

struct Once {
    pending: bool
    value: u32
}

impl Future[u32] for Once {
    fn poll(self: Once, context: Context) -> Poll[Once, u32] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, u32]::Pending(Once{false, self.value})
        }
        ret Poll[Once, u32]::Ready(self.value)
    }
}

struct Worker {}

impl for Worker {
    async fn add(self: Worker, value: u32) -> u32 {
        let increment = await Once{true, 1_u32}
        ret value + increment
    }
}

fn main() -> u32 {
    let pending = Worker{}.add(41_u32)
    let value = block_on[u32, __encore_future_Worker__add](pending)
    if value == 42_u32 { ret 0_u32 }
    ret 1_u32
}
