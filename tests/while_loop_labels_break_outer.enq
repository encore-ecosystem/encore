import core::testing::*

fn main() -> u32 {
    let mut a: u32 = 0_u32
    let mut b: u32 = 0_u32

    while<'outer> a < 5_u32 {
        while<'inner> b < 10_u32 {
            if b == 5_u32 {
                break<'outer>
            }
            a = a + 2_u32
            b = b + 1_u32
        }
    }

    if !assert(a == 10_u32 && b == 5_u32) {
        ret 1_u32
    }
    ret 0_u32
}
