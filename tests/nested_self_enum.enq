//! Self must resolve inside generic enum constructors, not only return annotations.

import core::option::Option
import core::testing::assert

struct Item { value: u32 }

impl for Item {
    fn empty() -> Option[Self] {
        ret Option[Self]::None
    }
    fn present(self: Self) -> Option[Self] {
        ret Option[Self]::Some(self)
    }
    fn nested() -> Option[Option[Self]] {
        ret Option[Option[Self]]::Some(Option[Self]::None)
    }
}

fn main() -> u32 {
    if !assert(Item::empty().is_none()) { ret 1_u32 }
    let item = Item { 7_u32 }
    match item.present() {
        Some(value) => { if !assert(value.value == 7_u32) { ret 2_u32 } }
        None => { ret 3_u32 }
    }
    match Item::nested() {
        Some(value) => { if !assert(value.is_none()) { ret 4_u32 } }
        None => { ret 5_u32 }
    }
    ret 0_u32
}
