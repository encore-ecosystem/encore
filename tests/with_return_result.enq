//! Returns through contexts must not be replaced by a synthetic default return.
import core::ops::ContextManager
import core::result::Result

struct Resource {
    value: u32
}
struct Pair {
    first: u32 second: u32
}

impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret true
    }
}

fn compute() -> Result[bool, u32] {
    with Resource {
        7_u32
    }
    as resource {
        ret Result[bool, u32]::Ok(resource.value == 7_u32)
    }
}

fn scalar() -> u32 {
    with Resource {
        11_u32
    }
    as outer {
        with Resource {
            12_u32
        }
        as inner {
            ret outer.value + inner.value
        }
        ret 99_u32
    }
}

fn aggregate(flag: bool) -> Pair {
    if flag {
        with Resource {
            13_u32
        }
        as resource {
            ret Pair {
                resource.value, 14_u32
            }
        }
    } else {
        unsafe {
            with Resource {
                15_u32
            }
            as resource {
                ret Pair {
                    resource.value, 16_u32
                }
            }
        }
    }
}

fn error() -> Result[bool, u32] {
    with Resource {
        17_u32
    }
    as resource {
        ret Result[bool, u32]::Err(resource.value)
    }
}

fn main() -> u32 {
    match compute() {
        Ok(value) => {
            if !value {
                ret 1_u32
            }
        }
        Err(_) => {
            ret 2_u32
        }
    }
    if scalar() != 23_u32 {
        ret 3_u32
    }
    let a = aggregate(true)
    let b = aggregate(false)
    if a.first != 13_u32 || a.second != 14_u32 {
        ret 4_u32
    }
    if b.first != 15_u32 || b.second != 16_u32 {
        ret 5_u32
    }
    match error() {
        Err(code) => {
            if code != 17_u32 {
                ret 6_u32
            }
        }
        Ok(_) => {
            ret 7_u32
        }
    }
    ret 0_u32
}
