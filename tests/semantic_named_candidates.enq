//! Candidate ranges preserve all original ordinals and are safe to share.
import core::fmt::Debug
import core::testing::assert

import std::thread::JoinHandle
import std::vec::Vec

import refrain::frontend::semantic_slice::SemanticNameIndex

fn verify(index: frozen SemanticNameIndex, names: frozen Vec[str]) -> bool {
    for name in names {
        let range = index.range(name)
        let mut cursor = range.0
        for ordinal in 0_usize..names.len() {
            if names.get_unchecked_borrowed(ordinal) == name {
                if cursor >= range.1 || index.position(cursor) != ordinal {
                    ret false
                }
                cursor += 1_usize
            }
        }
        if cursor != range.1 {
            ret false
        }
    }
    let missing = index.range("absent")
    ret missing.0 == missing.1
}
fn main() -> u32 {
    let empty = SemanticNameIndex::new(Vec[str]::new()).range("")
    if !assert(empty.0 == empty.1) {
        ret 1_u32
    }
    // These two distinct names collide in the resulting 1,024-slot key table.
    let mut names = vec!["", "read", "модуль::читать", "read", "", "Read", "self::read", "collision_3", "collision_120"]
    for ordinal in 0_usize..256_usize {
        names.push("name_" +(ordinal % 19_usize).fmt())
    }
    let index = SemanticNameIndex::new(names)
    let mut handles = Vec[JoinHandle[bool]]::new()
    for _ in 0_usize..4_usize {
        handles.push(spawn verify(index, names))
    }
    for handle in handles {
        if !assert(handle.join()) {
            ret 2_u32
        }
    }
    ret 0_u32
}
