//! #112: await specializes generic Future outputs, including nested containers.
import core::future::{Context, Future, Poll}
import core::option::Option
import core::result::Result
import std::future::block_on

async fn identity[T](value: T) -> T {
    ret value
}

async fn relay[T](value: T) -> T {
    ret await identity[T](value)
}

async fn result[T](value: T, fail: bool) -> Result[T, str] {
    ret if fail {
        Result[T, str]::Err("expected error")
    } else {
        Result[T, str]::Ok(value)
    }
}

async fn tried(fail: bool) -> Result[u32, str] {
    let value =(await result[u32](42_u32, fail))?
    ret Result[u32, str]::Ok(value)
}

// The impl's generic order differs from the target's order.
struct Ready[A, B] {
    value: A
    marker: B
    pending: bool
}

impl[B, A] Future[A] for Ready[A, B] {
    fn poll(self: Self, context: Context) -> Poll[Self, A] {
        if self.pending {
            context.waker.wake()
            ret Poll[Self, A]::Pending(Ready[A, B] { self.value, self.marker, false })
        }
        ret Poll[Self, A]::Ready(self.value)
    }
}

async fn scenario() -> bool {
    let direct = await identity[u32](42_u32)
    let pending = relay[u64](73_u64)
    let saved: u64 = await pending
    let nested = await identity[Option[Result[u32, str]]](Option[Result[u32, str]]::Some(Result[u32, str]::Ok(19_u32)))
    let success = await tried(false)
    let failure = await tried(true)
    let ready = await Ready[u32, i64] { 37_u32, - 1_i64, true }
    ret direct == 42_u32 && saved == 73_u64 &&
    nested.unwrap_or(Result[u32, str]::Err("missing")).unwrap_or(0_u32) == 19_u32 &&
    success.unwrap_or(0_u32) == 42_u32 && failure.unwrap_err_or("") == "expected error" &&
    ready == 37_u32
}

fn main() -> u32 {
    ret if block_on[bool, __encore_future_scenario](scenario()) {
        0_u32
    } else {
        1_u32
    }
}
