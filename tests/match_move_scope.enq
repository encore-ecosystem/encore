//! Arm scopes restore shadowed bindings, but never resurrect consumed outer owners.
import core::option::Option
import core::vec::Vec
import std::io::eprintln
import std::thread::JoinHandle

extern fn encore_node_debug_live_count() -> usize
#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

fn task() -> u32 {
    ret 7
}

fn join_branches(first: bool) -> u32 {
    let handle = spawn task()
    ret match first {
        true => handle.join() false => handle.join()
    }
}

fn join_statements(first: bool) -> u32 {
    let handle = spawn task()
    let mut count = 0_u32
    match first {
        true => {
            count = handle.join()
        }
        false => {
            count = handle.join()
        }
    }
    ret count
}

fn join_shadowed() -> u32 {
    let handle = spawn task()
    let item = Option[JoinHandle[u32]]::Some(spawn task())
    let count = match item {
        Some(handle) => handle.join() None => 0_u32
    }
    ret count + handle.join()
}

fn consume(values: sending Vec[str]) -> usize {
    ret values.len()
}

fn send_branches(first: bool) -> usize {
    let values = Vec[str]::new()
    ret match first {
        true => consume(values) false => consume(values)
    }
}

fn partial_send(first: bool) -> usize {
    let values = vec!["owned"]
    ret match first {
        true => consume(values) false => 0_usize
    }
}

fn partial_send_statement(first: bool) -> usize {
    let values = vec!["owned"]
    let mut count = 0_usize
    match first {
        true => {
            count = consume(values)
        }
        false => {
        }
    }
    ret count
}

fn local_after_move(first: bool) -> usize {
    let values = vec!["owned"]
    ret match first {
        true => {
            let local = "scope" + "local"
            let count = consume(values)
            count + local.byte_len()
        }
        false => 0_usize
    }
}

fn main() -> u32 {
    for first in vec![true, false] {
        if join_branches(first) != 7 || join_statements(first) != 7 {
            ret 1
        }
        if send_branches(first) != 0 {
            ret 2
        }
    }
    if join_shadowed() != 14 {
        ret 3
    }
    let before = live_nodes()
    for _index in 0_usize..32_usize {
        if partial_send(true) != 1 || partial_send(false) != 0 {
            ret 4
        }
        if partial_send_statement(true) != 1 || partial_send_statement(false) != 0 {
            ret 6
        }
        if local_after_move(true) != 11 || local_after_move(false) != 0 {
            ret 7
        }
    }
    let after = live_nodes()
    if after != before {
        eprintln(f "match partial-move cleanup: live nodes before={before}, after={after}")
        ret 5
    }
    ret 0
}
