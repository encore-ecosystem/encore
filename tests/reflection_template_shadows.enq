//! Local bindings and unrelated trait methods do not become compile-time templates.
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::{Parser, Statement}
import refrain::frontend::reflection::{function_uses_reflection, mark_reflection_templates, reflection_template_names}
fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("shadows.enq")
    let ast = parser.parse(lexer.tokenize(
            "#attr(reflection_template) fn boxed[T](value:T)->T{ret value}\n" +
            "fn from_parameter[T](boxed:T)->T{ret boxed}\n" +
            "fn from_local[T](value:T)->T{let boxed=value ret boxed}\n" +
            "struct Plain[T]{value:T}\n" +
            "impl[T] Future[T] for Plain[T]{pub fn poll(self:Self,context:Context)->Poll[Self,T]{ret Poll::Ready(self.value)}}\n" +
            "struct Reflective[T]{value:T}\n" +
            "impl[T] Future[T] for Reflective[T]{pub fn poll(self:Self,context:Context)->Poll[Self,T]{let info=reflect::type_info[T]() ret Poll::Ready(self.value)}}\n"))
    let names = reflection_template_names(ast)
    for name in names {
        if name == "from_parameter" || name == "from_local" {
            ret 1_u32
        }
    }
    for statement in mark_reflection_templates(ast, names) {
        match statement {
            Statement::Impl(item) => {
                if item.target == "Plain[T]" {
                    for method in item.methods {
                        if function_uses_reflection(method) {
                            ret 2_u32
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret 0_u32
}
