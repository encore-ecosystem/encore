import core::vec::Vec

struct Inner {
    values: Vec[u32]
    updates: u32
}

fn mutate(value: Inner&) -> () {
    value.updates += 1_u32
}

fn forward(value: Inner&) -> () {
    mutate(value)
}

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(41_u32)
    let value = Inner<H>{values, 0_u32}
    let mut iteration = 0_usize
    while iteration < 100000_usize {
        forward(value)
        iteration += 1_usize
    }
    ret if value.updates == 100000_u32 && value.values.len() == 1_usize {
        0_u32
    } else {
        1_u32
    }
}
