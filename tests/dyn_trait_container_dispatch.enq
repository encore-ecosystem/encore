import core::testing::*
import core::fmt::Debug
import std::io::println
import core::vec::Vec

trait Score {
    fn score(self: Self) -> usize
}

struct Fixed {
    value: usize
}

struct Bonus {
    value: usize
    bonus: usize
}

impl Score for Fixed {
    fn score(self: Fixed) -> usize {
        ret self.value
    }
}

impl Score for Bonus {
    fn score(self: Bonus) -> usize {
        ret self.value + self.bonus
    }
}

fn total(values: Vec[dyn Score]) -> usize {
    let mut out = 0_usize
    for item in values {
        out = out + item.score()
    }
    ret out
}

fn main() -> u32 {
    let mut values = Vec[dyn Score]::new()
    values.push(Fixed{3_usize} as dyn Score)
    values.push(Bonus{4_usize, 5_usize} as dyn Score)

    let actual = total(values)
    if !assert(actual == 12_usize) {
        println("dyn container total mismatch: " + Debug::fmt(actual))
        ret 1_u32
    }
    ret 0_u32
}
