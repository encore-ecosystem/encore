// @expect.compile_error=plugin module handles cannot cross the data boundary
import std::plugin::Plugin
#attr(plugin_interface)
trait Bad {
    fn transfer(self: Self, plugin: Plugin) -> Plugin
}
fn main() -> u32 {
    match unsafe {
        Plugin::load("unused")
    }
    {
        Ok(plugin) => {
            let binding = plugin.bind[dyn Bad]("bad")
        }
        Err(_) => {
        }
    }
    ret 0
}
