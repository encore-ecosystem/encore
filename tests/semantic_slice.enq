//! Projections preserve lookup order and isolate per-body generic overlays.
import core::testing::assert
import std::vec::Vec
import refrain::frontend::semantic_slice::SemanticSlice
fn main() -> u32 {
    let records = vec![11_u32, 22_u32, 33_u32]
    let left = SemanticSlice[u32]::project(records, vec![2_usize, 0_usize])
    let extended = left.with_overlay(vec![44_u32])
    let mut seen = Vec[u32]::new()
    for value in extended { seen.push(value) }
    if !assert(seen.len() == 3_usize && seen.get(0).unwrap_or(0_u32) == 33_u32 &&
        seen.get(1).unwrap_or(0_u32) == 11_u32 && seen.get(2).unwrap_or(0_u32) == 44_u32) { ret 1_u32 }
    if !assert(left.len() == 2_usize && records.len() == 3_usize && left.get(2_usize).is_none()) { ret 2_u32 }
    let empty = SemanticSlice[u32]::project(records, Vec[usize]::new())
    if !assert(empty.is_empty() && empty.get(0_usize).is_none()) { ret 3_u32 }
    ret 0_u32
}
