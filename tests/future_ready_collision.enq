//! #113: a local Ready type must not replace core's type or Poll's variant tag.
import core::future::{Future, Poll, context, ready}

struct Ready {
    unused: bool
}

fn main() -> u32 {
    let step = ready[u32](42_u32).poll(context(0_usize))
    ret match step {
        Poll::Ready(value) => value - 42_u32
        Poll::Pending(_) => 1_u32
    }
}
