//! Artifact kinds must not be interpreted as architecture triples.
import refrain::modes::build_output::{build_artifact_name, build_import_library_name, shared_library_exports}
import refrain::project::manifest::{project_manifest_target, project_build_kind, try_parse_project_manifest}
import refrain::target::parse_target
import std::path::Path

fn main() -> u32 {
    let root = Path::new("target/missing-output-kind-fixture")
    for kind in vec!["auto", "executable", "static_lib", "shared_lib"] {
        let source = "[project]\nname=\"kind_probe\"\nversion=\"0.0.0\"\ntarget=\"" + kind + "\"\n"
        let manifest = match try_parse_project_manifest(source, root.join("encore.toml")) {
            Ok(value) => value Err(_) => {
                ret 6
            }
        }
        if project_manifest_target(manifest) != "auto" {
            ret 1
        }
        if project_build_kind(root, manifest) != if kind == "auto" {
            "static_lib"
        } else {
            kind
        }
        {
            ret 2
        }
    }
    let manifest = match try_parse_project_manifest("[project]\nname=\"kind_probe\"\ntarget=\"aarch64-apple-darwin\"\n", root.join("encore.toml")) {
        Ok(value) => value Err(_) => {
            ret 6
        }
    }
    if project_manifest_target(manifest) != "aarch64-apple-darwin" {
        ret 3
    }
    let linux = parse_target("x86_64-unknown-linux-gnu")
    let mac = parse_target("aarch64-apple-darwin")
    let windows = parse_target("x86_64-pc-windows-msvc")
    let gnu = parse_target("x86_64-w64-windows-gnu")
    if build_artifact_name(linux, "probe", "static_lib") != "libprobe.a" ||
    build_artifact_name(linux, "probe", "shared_lib") != "libprobe.so" ||
    build_artifact_name(mac, "probe", "shared_lib") != "libprobe.dylib" ||
    build_artifact_name(windows, "probe", "static_lib") != "probe.lib" ||
    build_artifact_name(gnu, "probe", "static_lib") != "libprobe.a" ||
    build_artifact_name(windows, "probe", "shared_lib") != "probe.dll" ||
    build_artifact_name(windows, "probe", "executable") != "probe.exe" {
        ret 4
    }
    if build_import_library_name(windows, "probe", "shared_lib") != "probe.lib" ||
    build_import_library_name(gnu, "probe", "shared_lib") != "libprobe.dll.a" ||
    build_import_library_name(linux, "probe", "shared_lib") != "" ||
    build_import_library_name(windows, "probe", "static_lib") != "" {
        ret 7
    }
    let symbols = "one.erlib[member.o]:\nanswer T 0000 4\nanswer T 0000 4\nunused U 0000 0\nmain T 0010 4\nvalue D 0020 4\nlocal t 0030 4\n"
    if shared_library_exports(symbols) != "EXPORTS\n  answer\n  value DATA\n" {
        ret 5
    }
    ret 0
}
