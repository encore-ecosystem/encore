import core::vec::Vec

struct Layout {
    children: Vec[u32]
    width: u32
    height: u32
}

impl for Layout {
    fn width(self: Self) -> u32 { ret self.width }
    fn height(self: Self) -> u32 { ret self.height }
    fn child_count(self: Self) -> usize { ret self.children.len() }
}

fn main() -> u32 {
    let mut children = Vec[u32]::new()
    children.push(1_u32)
    let layout = Layout{children, 640_u32, 480_u32}
    let mut iteration = 0_usize
    while iteration < 100000_usize {
        if layout.width() != 640_u32 || layout.height() != 480_u32 ||
        layout.child_count() != 1_usize {
            ret 1_u32
        }
        iteration += 1_usize
    }
    ret 0_u32
}
