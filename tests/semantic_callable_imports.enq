//! Callable lookup uses exact import bindings and tracks re-export identity.

import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("one", "one.enq", "pub fn original() -> u32 { ret 1_u32 }\nfn secret() -> str { ret \"private\" }")
    db.set_module("two", "two.enq", "pub fn original() -> str { ret \"second\" }")
    db.set_module("facade", "facade.enq", "pub import one::original as exported")
    db.set_module("app", "app.enq", "import facade::exported as chosen\nfn sample() { let value = chosen() }\nfn unrelated() { let hidden = secret() let unimported = original() }")
    let id = db.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    let first = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(first.binding_type("value").unwrap_or("") == "u32") { ret 1_u32 }
    db.semantic_body(id)
    if !assert(db.semantic_body_count(id) == 1_usize) { ret 2_u32 }
    let other_id = db.symbol_id("app", "unrelated").unwrap_or(SymbolId::invalid())
    let other = db.semantic_body(other_id).unwrap_or(SemanticBody::empty())
    if !assert(other.binding_type("hidden").unwrap_or("") == "") { ret 3_u32 }
    if !assert(other.binding_type("unimported").unwrap_or("") == "") { ret 4_u32 }
    // The original still exists with an unchanged signature. Only the public
    // binding changes, so validating the old declaration alone is insufficient.
    db.set_module("facade", "facade.enq", "pub import two::original as exported")
    let switched = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(switched.binding_type("value").unwrap_or("") == "str") { ret 5_u32 }
    if !assert(db.semantic_body_count(id) == 2_usize) { ret 6_u32 }
    db.set_module("two", "two.enq", "pub fn original() -> bool { ret true }")
    let changed = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(changed.binding_type("value").unwrap_or("") == "bool") { ret 7_u32 }
    if !assert(db.semantic_body_count(id) == 3_usize) { ret 8_u32 }
    db.set_module("facade", "facade.enq", "")
    let removed = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(removed.binding_type("value").unwrap_or("") == "") { ret 9_u32 }
    ret 0_u32
}
