//! A generic address adds a pointer layer to T, including raw and node handles.
import core::vec::Vec

fn pointer(bits: usize) -> u8* {
    unsafe {
        unsafe ehir {
            value: u8 * = pcast bits: usize, u8 *
        }
        ret value
    }
}
fn address(value: u8*) -> usize {
    unsafe {
        unsafe ehir {
            bits: usize = pcast value: u8 *, usize
        }
        ret bits
    }
}
struct Entry {
    a: u64
    b: u64
    c: u64
    d: u64
}

fn main() -> u32 {
    let mut pointers = Vec[u8*]::new()
    pointers.push(pointer(4660_usize))
    pointers.push(pointer(22136_usize))
    match pointers.get(0) {
        Some(value) => {
            if address(value) != 4660_usize {
                ret 1
            }
        }
        None => {
            ret 2
        }
    }
    match pointers.get(1) {
        Some(value) => {
            if address(value) != 22136_usize {
                ret 3
            }
        }
        None => {
            ret 4
        }
    }
    pointers.set(0, pointer(39612_usize))
    match pointers.get(0) {
        Some(value) => {
            if address(value) != 39612_usize {
                ret 5
            }
        }
        None => {
            ret 6
        }
    }
    let mut nodes = Vec[Entry<H>]::new()
    nodes.push(Entry<H>{ 1_u64, 2_u64, 3_u64, 4_u64 })
    nodes.push(Entry<H>{ 5_u64, 6_u64, 7_u64, 8_u64 })
    match nodes.get(1) {
        Some(value) => {
            if value.d != 8_u64 {
                ret 7
            }
        }
        None => {
            ret 8
        }
    }
    ret 0
}
