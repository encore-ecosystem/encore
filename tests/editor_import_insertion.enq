//! Autoimport edits preserve newline style and documentation attachment.

import core::option::Option
import core::testing::assert
import refrain::frontend::{plan_import_insertion, ImportInsertion}

fn matches(source: str, line: usize, column: usize, text: str) -> bool {
    match plan_import_insertion(source, "std::io::println") {
        Some(edit) => { ret edit.line == line && edit.column == column && edit.text == text }
        None => { ret false }
    }
}

fn main() -> u32 {
    if !assert(matches("", 0_usize, 0_usize, "import std::io::println\n")) { ret 1_u32 }
    if !assert(matches("//! Модуль 🌍\r\n\r\n/// Main docs\r\nfn main() {}\r\n",
        2_usize, 0_usize, "import std::io::println\r\n")) { ret 2_u32 }
    if !assert(matches("//! Module\nimport core::{\n Option,\n Result\n}\n\n/// Function docs\nfn main() {}\n",
        5_usize, 0_usize, "import std::io::println\n")) { ret 3_u32 }
    if !assert(matches("/* license\n text */\n//! Module\nfn main() {}", 3_usize, 0_usize,
        "import std::io::println\n")) { ret 4_u32 }
    if !assert(matches("import core::option::Option", 0_usize, 27_usize,
        "\nimport std::io::println\n")) { ret 5_u32 }
    if !assert(plan_import_insertion("import core::{", "std::io::println").is_none()) { ret 6_u32 }
    ret 0_u32
}
