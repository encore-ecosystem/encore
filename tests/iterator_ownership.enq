//! For-loop slots transfer ownership, including nested owning iterator fields.
import core::iter::enumerate
import core::result::Result
import core::vec::{Vec, VecIter}

extern fn encore_node_debug_live_count() -> usize

fn numbers(count: usize) -> Vec[usize] {
    let mut out = Vec[usize]::new()
    let mut i = 0_usize
    while i < count {
        out.push(i) i += 1_usize
    }
    ret out
}

fn wrapped(count: usize) -> Result[Vec[usize], u32] {
    ret Result[Vec[usize], u32]::Ok(numbers(count))
}

fn extracted(count: usize, early: bool) -> Result[bool, u32] {
    let values = wrapped(count)?
    let mut seen = 0_usize
    for value in values {
        if early {
            ret Result[bool, u32]::Ok(value == 0_usize)
        }
        seen += 1_usize
    }
    ret Result[bool, u32]::Ok(seen == count && values.len() == count)
}

fn temporary() -> bool {
    let mut sum = 0_usize
    for value in numbers(4_usize) {
        sum += value
    }
    ret sum == 6_usize
}

fn owned_items() -> bool {
    let mut rows = Vec[Vec[usize]]::new()
    rows.push(numbers(3_usize))
    rows.push(numbers(2_usize))
    let mut count = 0_usize
    for row in rows {
        for value in row {
            count += value
        }
    }
    ret count == 4_usize && rows.len() == 2_usize
}

fn first_row() -> Vec[usize] {
    let mut rows = Vec[Vec[usize]]::new()
    rows.push(numbers(3_usize))
    for row in rows {
        ret row
    }
    ret Vec[usize]::new()
}

fn returned_item() -> bool {
    let row = first_row()
    ret row.len() == 3_usize
}

fn transfers() -> bool {
    let values = numbers(4_usize)
    let mut count = 0_usize
    for value in values {
        if value == 0_usize {
            continue
        }
        count += 1_usize
        if value == 2_usize {
            break
        }
    }
    for < 'outer > value in values {
        for other in numbers(3_usize) {
            if value == 0_usize {
                continue < 'outer >
            }
            if other == 1_usize {
                break < 'outer >
            }
            count += 1_usize
        }
    }
    ret count == 3_usize && values.len() == 4_usize
}

fn fail() -> Result[bool, u32] {
    ret Result[bool, u32]::Err(7_u32)
}

fn propagated() -> Result[bool, u32] {
    for value in numbers(2_usize) {
        let ok = fail()?
        if ok {
            ret Result[bool, u32]::Ok(value == 0_usize)
        }
    }
    ret Result[bool, u32]::Ok(false)
}

fn adapters() -> bool {
    let values = numbers(4_usize)
    let iterator = values.iter()
    let mut sum = 0_usize
    for value in iterator {
        sum += value
    }
    for entry in enumerate[usize, VecIter[usize]](values.iter()) {
        if entry.0 != entry.1 {
            ret false
        }
        sum += entry.1
    }
    ret sum == 12_usize && values.len() == 4_usize
}

fn main() -> u32 {
    let before = unsafe {
        encore_node_debug_live_count()
    }
    for count in 0_usize..8_usize {
        match extracted(count, false) {
            Ok(ok) => {
                if !ok {
                    ret 1_u32
                }
            }
            Err(e) => {
                ret e
            }
        }
        match extracted(count, true) {
            Ok(ok) => {
                if !ok {
                    ret 2_u32
                }
            }
            Err(e) => {
                ret e
            }
        }
        if unsafe {
            encore_node_debug_live_count()
        }
        != before {
            ret 10_u32
        }
    }
    if !temporary() {
        ret 3_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 11_u32
    }
    if !owned_items() {
        ret 4_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 12_u32
    }
    if !transfers() {
        ret 5_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 13_u32
    }
    match propagated() {
        Err(e) => {
            if e != 7_u32 {
                ret 6_u32
            }
        }
        Ok(ok) => {
            ret 7_u32
        }
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 14_u32
    }
    if !adapters() {
        ret 8_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 15_u32
    }
    if !returned_item() {
        ret 9_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 16_u32
    }
    ret 0_u32
}
