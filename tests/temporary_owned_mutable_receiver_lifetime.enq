//! An owning temporary moved into mutable receiver storage remains alive.

struct Builder { value: str }

impl for Builder {
    fn append(self: mut Self, suffix: str) -> Self {
        self.value += suffix
        ret self
    }
}

fn builder(value: str) -> Builder { ret Builder{value} }

fn main() -> u32 {
    let value = builder("safe").append(" receiver")
    if value.value != "safe receiver" { ret 1_u32 }
    ret 0_u32
}
