//! Replacing owning fields preserves placement, aliases and owner counts.
extern fn encore_node_debug_live_count() -> usize
#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}
struct History {
    value: u32
}
struct View {
    history: History<H>
}
struct Erased {
    history: History&
}
fn replace(view: mut View, history: History<H>) ->() {
    view.history = history
}

impl for View {
    fn replace(self: mut Self&, history: History<H>) ->() {
        self.history = history
    }
}
fn exercise() -> u32 {
    let mut view = View {
        History<H>{ 0 }
    }
    let previous = view.history
    view.history = History<H>{ 1 }
    if previous.value != 0 || view.history.value != 1 {
        ret 1
    }
    let borrowed = History<H>{ 2 }
    replace(view, borrowed)
    if borrowed.value != 2 || view.history.value != 2 {
        ret 2
    }
    let mut owning = View<H> {
        History<H>{ 3 }
    }
    owning.replace(History<H>{ 4 })
    if owning.history.value != 4 {
        ret 3
    }
    let mut erased = Erased {
        History<H>{ 5 }
    }
    erased.history = History<H>{ 6 }
    if erased.history.value != 6 {
        ret 4
    }
    for index in 0..32 {
        view.history = History<H>{ index as u32 }
    }
    ret if view.history.value == 31 {
        0_u32
    } else {
        5_u32
    }
}
fn main() -> u32 {
    let before = live_nodes()
    let result = exercise()
    if result != 0 {
        ret result
    }
    ret if live_nodes() == before {
        0_u32
    } else {
        6_u32
    }
}
