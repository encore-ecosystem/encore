//! Equality compares the active payload, not only the enum discriminant.
import core::option::Option
import core::result::Result

extern fn encore_node_debug_live_count() -> usize
#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

struct Record {
    number: u32
    label: str
}
struct Node {
    value: u32
}
enum Choice {
    Left(u32) Right(u32) Empty
}
fn equal[Value](left: Value, right: Value) -> bool {
    ret left == right
}
fn capitalized(Left: Option[u32], Right: Option[u32]) -> bool {
    ret Left == Right
}

fn exercise() -> u32 {
    let one = Option[usize]::Some(1)
    let two = Option[usize]::Some(2)
    let empty = Option[usize]::None
    if one == two || !(one != two) || one == empty || !equal(one, one) {
        ret 1
    }
    if empty != Option[usize]::None {
        ret 2
    }
    if !capitalized(Option[u32]::Some(1), Option[u32]::Some(1)) ||
    capitalized(Option[u32]::Some(1), Option[u32]::Some(2)) {
        ret 14
    }
    if Choice::Left(1) == Choice::Right(1) || Choice::Left(1) == Choice::Left(2) {
        ret 3
    }
    if Choice::Empty != Choice::Empty {
        ret 4
    }
    let text = "pay" + "load"
    if Option[str]::Some(text) != Option[str]::Some("payload") ||
    Option[str]::Some(text) == Option[str]::Some("different") {
        ret 5
    }
    if Option[f32]::Some(0.0) != Option[f32]::Some( - 0.0) ||
    Option[f32]::Some(1.25) == Option[f32]::Some(2.5) {
        ret 6
    }
    let nan = 0.0_f32 / 0.0_f32
    if Option[f32]::Some(nan) == Option[f32]::Some(nan) {
        ret 7
    }
    let record = Record { 1, text }
    if Option[Record]::Some(record) != Option[Record]::Some(Record {
            1, "payload"
        }
        ,
    ) ||
    Option[Record]::Some(record) == Option[Record]::Some(Record {
            1, "other"
        }
        ,
    ) {
        ret 8
    }
    let tuple = Option[(u32, str)]::Some((1, text))
    if tuple != Option[(u32, str)]::Some((1, "payload")) ||
    tuple == Option[(u32, str)]::Some((2, "payload")) {
        ret 9
    }
    let array = Option[[u32;
            2]]::Some([1, 2])
    if array != Option[[u32;
            2]]::Some([1, 2]) || array == Option[[u32;
            2]]::Some([1, 3]) {
        ret 10
    }
    let nested = Option[Result[Option[u32], str]]::Some(Result[Option[u32], str]::Ok(Option[u32]::Some(1)))
    if !equal(nested, nested) || nested == Option[Result[Option[u32], str]]::Some(
        Result[Option[u32], str]::Ok(Option[u32]::Some(2)),) {
        ret 11
    }
    let node = Node < H > {
        7
    }
    let handle = Option[Node < H >]::Some(node)
    if handle != Option[Node < H >]::Some(node) || handle == Option[Node < H >]::Some(Node < H > {
            7
        }
    ) {
        ret 12
    }
    ret 0
}

fn main() -> u32 {
    let before = live_nodes()
    for iteration in 0..32 {
        let status = exercise()
        if status != 0 {
            ret status
        }
        if live_nodes() != before {
            ret 13
        }
    }
    ret 0
}
