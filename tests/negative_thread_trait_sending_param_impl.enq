// @expect.compile_error=but the trait requires sending
import core::vec::Vec

trait Consume {
    fn consume(self: Self, values: sending Vec[str]) -> usize
}

struct Consumer {}

impl Consume for Consumer {
    fn consume(self: Consumer, values: Vec[str]) -> usize {
        ret values.len()
    }
}

fn main() -> u32 {
    ret 0_u32
}
