//! Direct calls use callable grammar for owner and method generic spellings.
import core::option::Option
import core::testing::assert

import ehirlib::*

import refrain::frontend::translator::ir::{LoweringBuilder, LoweringScope, Operand, reference}

fn main() -> u32 {
    let scalar = plain_type("u8", Vec[Type]::new())
    let scope = LoweringScope::new(Vec[Parameter]::new())
    // Exercise cache hits as well as independent value-type interning.
    for _ in 0_usize..2_usize {
        let owner = scope.callable("Vec[u8]::new")
        let method = scope.callable("Vec::new[u8]")
        let nested = scope.callable("module::Factory[Vec[u8]]::make")
        if !assert(owner.0 == "Vec::new" && method.0 == owner.0 && owner.1.len() == 1_usize && method.1.len() == 1_usize) {
            ret 1_u32
        }
        if !assert(owner.1.get_unchecked_borrowed(0_usize).name == "u8" && nested.0 == "module::Factory::make") {
            ret 2_u32
        }
        if !assert(scope.typ("Vec[u8]").name == "Vec" && scope.typ("Vec[u8]").generics.get_unchecked_borrowed(0_usize).name == scalar.name) {
            ret 3_u32
        }
    }
    let signature = FnDirective {
        "make", Vec[Type]::new(), Vec[Parameter]::new(), scope.typ("Vec[u8]"), Vec[Block]::new(), false, false
    }
    let builder = LoweringBuilder::new(scope).function_start(signature).label("entry")
    .call("values", "Vec[u8]", "Vec[u8]::new", Vec[Operand]::new(), false)
    .return_value(reference("values")).function_end()
    let direct = match module_from_ir_items("calls", Vec[EhirImport]::new(), Option[str]::None, builder.finish_items()) {
        Ok(value) => value Err(_) => {
            ret 4_u32
        }
    }
    let parsed = parse_module_text("calls", "fn make() -> Vec[u8] {\n$entry:\nvalues: Vec[u8] = call Vec[u8]::new()\nret values: Vec[u8]\n}\n")
    if !assert(module_to_string(direct) == module_to_string(parsed)) {
        ret 5_u32
    }
    ret 0_u32
}
