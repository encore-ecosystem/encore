//! A submodule method returns the defining package's root type in every view.
import core::fmt::Debug
import core::option::Option
import core::testing::assert

import std::io::eprintln

import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("spatial_math", "math/lib.enq", "pub import mod::precision::DVec3\npub struct Vec3 { x: f32 }\nimpl for Vec3 { pub fn new(x: f32) -> Self { ret Self{x} } }\n")
    db.set_module("spatial_math::precision", "math/precision.enq", "import refrain::Vec3\npub struct DVec3 { x: f64 }\nimpl for DVec3 { pub fn new(x: f64) -> Self { ret Self{x} } pub fn to_vec3(self: Self) -> Vec3 { ret Vec3::new(self.x as f32) } }\n")
    db.set_module("spatial_app", "app/lib.enq", "pub import mod::region::local\n")
    db.set_module("spatial_app::region", "app/region.enq", "import spatial_math::{Vec3, DVec3}\npub fn local() -> Vec3 { let n = DVec3::new(1_f64).to_vec3() ret n }\n")
    let id = db.symbol_id("spatial_app::region", "local").unwrap_or(SymbolId::invalid())
    let body = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !body.diagnostics.is_empty() {
        for diagnostic in body.diagnostics {
            eprintln(diagnostic.message)
        }
        for binding in body.type_names {
            eprintln(binding.scope + "::" + binding.name + " => " + binding.identity)
        }
        for binding in body.bindings {
            eprintln(binding.name + " => " + binding.typ)
        }
    }
    ret if assert(body.diagnostics.is_empty() && body.binding_type("n").unwrap_or("") == "Vec3") {
        0_u32
    } else {
        1_u32
    }
}
