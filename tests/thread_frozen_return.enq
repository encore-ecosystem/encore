import core::vec::Vec

fn publish(values: sending Vec[str]) -> frozen Vec[str] {
    ret values
}

fn forward(values: frozen Vec[str]) -> frozen Vec[str] {
    ret values
}

fn inspect(values: frozen Vec[str]) -> usize {
    ret values.len()
}

fn main() -> u32 {
    let mut owned = Vec[str]::new()
    owned.push("published")
    let published = publish(owned)
    let forwarded = forward(published)
    ret if inspect(forwarded) == 1_usize { 0_u32 } else { 1_u32 }
}
