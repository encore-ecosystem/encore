import core::future::{Context, Future, Poll}
import std::future::block_on

struct Immediate {}

impl Future[u32] for Immediate {
    fn poll(self: Immediate, context: Context) -> Poll[Immediate, u32] {
        ret Poll[Immediate, u32]::Ready(2_u32)
    }
}

async fn invalid() -> u32 {
    let mut value = 1_u32
    let awaited = await Immediate{}
    ret value + awaited
}

fn main() -> u32 {
    let pending = invalid()
    let value = block_on[u32, __encore_future_invalid](pending)
    if value == 3_u32 { ret 0_u32 }
    ret 1_u32
}
