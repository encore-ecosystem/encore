// @expect.compile_error=is not available through frozen region 'values'
import core::vec::Vec

fn inspect(values: frozen Vec[str]) -> usize {
    ret values.len()
}

fn main() -> u32 {
    let mut values = Vec[str]::new()
    values.push("before")
    let worker = spawn inspect(values)
    values.push("after")
    ret worker.join() as u32
}
