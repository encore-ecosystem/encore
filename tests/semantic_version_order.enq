import encore::project::{registry_version_is_newer, registry_version_matches, registry_version_requirement_valid}

fn main() -> u32 {
    if !registry_version_is_newer("1.10.0", "1.9.9") { ret 1_u32 }
    if !registry_version_is_newer("2.0.0", "1.99.99") { ret 2_u32 }
    if !registry_version_is_newer("1.0.0", "1.0.0-rc.1") { ret 3_u32 }
    if registry_version_is_newer("1.0.0-rc.1", "1.0.0") { ret 4_u32 }
    if registry_version_is_newer("01.0.0", "0.9.0") { ret 5_u32 }
    if !registry_version_matches("1.8.4", "^1.2.0") { ret 6_u32 }
    if registry_version_matches("2.0.0", "^1.2.0") { ret 7_u32 }
    if !registry_version_matches("0.4.9", "^0.4.2") { ret 8_u32 }
    if registry_version_matches("0.5.0", "^0.4.2") { ret 9_u32 }
    if !registry_version_matches("1.2.9", "~1.2.3") { ret 10_u32 }
    if registry_version_matches("1.3.0", "~1.2.3") { ret 11_u32 }
    if !registry_version_matches("1.2.3", "1.2.3") { ret 12_u32 }
    if !registry_version_is_newer("1.0.0-rc.10", "1.0.0-rc.2") { ret 13_u32 }
    if !registry_version_is_newer("1.0.0-beta.1", "1.0.0-alpha.9") { ret 14_u32 }
    if !registry_version_is_newer("1.0.0-beta", "1.0.0-1") { ret 15_u32 }
    if registry_version_is_newer("1.0.0-alpha", "1.0.0-alpha.1") { ret 16_u32 }
    if registry_version_matches("1.2.3-rc.2", "1.2.3-rc.1") { ret 17_u32 }
    if !registry_version_matches("1.2.3+build.9", "1.2.3+build.1") { ret 18_u32 }
    if registry_version_is_newer("1.0.0-01", "1.0.0-1") { ret 19_u32 }
    if !registry_version_matches("1.7.2", ">=1.5.0, <2.0.0") { ret 20_u32 }
    if registry_version_matches("2.0.0", ">=1.5.0, <2.0.0") { ret 21_u32 }
    if !registry_version_matches("1.5.0", ">=1.5.0") { ret 22_u32 }
    if registry_version_matches("1.5.0", ">1.5.0") { ret 23_u32 }
    if !registry_version_matches("1.5.0", "<=1.5.0") { ret 24_u32 }
    if registry_version_matches("1.5.1", "<1.5.1") { ret 25_u32 }
    if !registry_version_matches("1.0.0-rc.2", ">=1.0.0-rc.1, <1.0.0") { ret 26_u32 }
    if registry_version_matches("1.0.0-rc.2", ">=0.9.0, <1.0.0") { ret 27_u32 }
    if registry_version_matches("1.0.0+build.2", "=1.0.0+build.1") == false { ret 28_u32 }
    if !registry_version_matches("1.9.7", "1") { ret 29_u32 }
    if registry_version_matches("2.0.0", "1") { ret 30_u32 }
    if !registry_version_matches("1.2.9", "1.2") { ret 31_u32 }
    if registry_version_matches("1.3.0", "1.2") { ret 32_u32 }
    if !registry_version_matches("1.8.0", "1.*") { ret 33_u32 }
    if registry_version_matches("2.0.0", "1.x") { ret 34_u32 }
    if !registry_version_matches("1.2.99", "1.2.*") { ret 35_u32 }
    if registry_version_matches("1.3.0", "1.2.X") { ret 36_u32 }
    if registry_version_matches("1.2.3", "1.*.3") { ret 37_u32 }
    if !registry_version_requirement_valid("1.2.*") { ret 38_u32 }
    if !registry_version_requirement_valid(">=1.2.0, <2.0.0") { ret 39_u32 }
    if registry_version_requirement_valid("1.*.3") { ret 40_u32 }
    if registry_version_requirement_valid(">=") { ret 41_u32 }
    if registry_version_requirement_valid(">=1.2") { ret 42_u32 }
    if registry_version_requirement_valid("^1.2.3,") { ret 43_u32 }
    ret 0_u32
}
