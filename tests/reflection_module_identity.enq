//! Same-named format helpers keep their selected declaration during specialization.
import core::vec::Vec
import ehir_llvm_backend::codegen::{prepare_unit_codegen, emit_unit_codegen}
import ehirlib::core::{make_module_bundle, Module}
import ehirlib::parse_module_bundle_text
import refrain::frontend::translator::{TranslationModule, translate_modules_to_ehir_bundle}
import refrain::frontend::{Lexer, Parser}
import refrain::target::host_target
fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut first = Parser::new_for_source("first@lib.enq")
    let mut second = Parser::new_for_source("second@lib.enq")
    let mut app = Parser::new_for_source("app@main.enq")
    let first_ast = first.parse(lexer.tokenize("struct State { number: u32 } pub fn initial() -> State { ret State { 1_u32 } } pub fn encode[T](value: T, state: State) -> State { let info = reflect::type_info[T]() ret State { 111_u32 } }"))
    let second_ast = second.parse(lexer.tokenize("struct State { number: u32 } pub fn initial() -> State { ret State { 1_u32 } } pub fn encode[T](value: T, state: State) -> State { let info = reflect::type_info[T]() ret State { 222_u32 } }"))
    let app_ast = app.parse(lexer.tokenize("import first import second fn main() -> u32 { ret first::encode(1_u32, first::initial()).number + second::encode(1_u32, second::initial()).number }"))
    let mut imports = Vec[str]::new()
    imports.push("first@lib.enq") imports.push("second@lib.enq")
    let mut modules = Vec[TranslationModule]::new()
    modules.push(TranslationModule::new("first@lib.enq", "/virtual/first/src/lib.enq", Vec[str]::new(), first_ast, Vec[str]::new()))
    modules.push(TranslationModule::new("second@lib.enq", "/virtual/second/src/lib.enq", Vec[str]::new(), second_ast, Vec[str]::new()))
    modules.push(TranslationModule::new("app@main.enq", "/virtual/app/src/main.enq", imports, app_ast, Vec[str]::new()))
    let output = translate_modules_to_ehir_bundle(modules, host_target(), "app@main.enq")
    if !output.contains("111_u32") || !output.contains("222_u32") {
        ret 1
    }
    if output.contains("state: State") {
        ret 2
    }
    let target = host_target()
    let prepared = prepare_unit_codegen(parse_module_bundle_text("app@main.enq", output), make_module_bundle("", Vec[Module]::new()), target.triple, target.pointer_width, 1)
    let emitted = emit_unit_codegen(prepared, target.triple, target.pointer_width)
    if emitted.is_empty() {
        ret 3
    }
    ret 0
}
