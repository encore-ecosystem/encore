//! Mutable inline receivers can update scalar fields of their owned nodes.

struct WindowState {
    dx: f32 ticks: u32
}
struct Window {
    state: WindowState < H >
}

impl for WindowState {
    fn tick(self: mut Self &) ->() {
        self.ticks += 1 ret()
    }
    fn count(self: Self &) -> u32 {
        ret self.ticks
    }
}

impl for Window {
    fn poll(self: mut Self) ->() {
        self.state.dx = 0.0
        self.state.ticks += 1
        ret()
    }
}

fn create_window() -> Window {
    let mut state = WindowState < H > {
        2.0, 0
    }
    state.dx = 3.0
    ret Window {
        state
    }
}

fn main() -> u32 {
    let mut window = create_window()
    window.poll()
    if window.state.dx != 0.0 || window.state.ticks != 1 {
        ret 1
    }
    window.poll()
    if window.state.ticks != 2 {
        ret 2
    }
    window.state.tick()
    if window.state.count() != 3 {
        ret 3
    }
    let mut heap = WindowState < H > {
        1.0, 0
    }
    heap.tick()
    if heap.count() != 1 {
        ret 4
    }
    let mut stack = WindowState < S > {
        1.0, 0
    }
    stack.tick()
    if stack.count() != 1 {
        ret 5
    }
    ret 0
}
