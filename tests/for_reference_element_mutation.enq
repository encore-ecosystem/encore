import core::vec::Vec

struct Entry {
    ready: bool
    value: u32
}

fn main() -> u32 {
    let mut values = Vec[Entry<H>]::new()
    values.push(Entry<H>{false, 7_u32})
    for entry in values {
        entry.ready = true
        entry.value += 1_u32
    }
    for entry in values {
        if !entry.ready || entry.value != 8_u32 { ret 1_u32 }
    }
    ret 0_u32
}
