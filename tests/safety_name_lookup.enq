//! Name filtering preserves aliases, overload order, projections and overlays.
import core::testing::assert
import std::vec::Vec
import refrain::frontend::safety_lookup::SafetyNameLookup
import refrain::frontend::semantic::{SemanticCallable, SemanticMethod}
import refrain::frontend::semantic_slice::SemanticSlice

fn verify(callables: SemanticSlice[SemanticCallable], methods: SemanticSlice[SemanticMethod]) -> bool {
    let lookup = SafetyNameLookup::new(callables, methods)
    let mut valid = true
    for name in vec!["chosen", "other", "имя", "absent", ""] {
        let mut expected = 0_usize
        for position in 0_usize..callables.len() {
            match callables.get(position) {
                Some(value) => { if value.name == name { expected = position + 1_usize break } }
                None => { break }
            }
        }
        if lookup.callable(name) != expected { valid = false }
    }
    for name in vec!["read", "write", "читать", "absent", ""] {
        let mut expected = Vec[SemanticMethod]::new()
        for method in methods { if name.is_empty() || method.name == name { expected.push(method) } }
        let mut actual = Vec[SemanticMethod]::new()
        for method in lookup.methods_named(name) { actual.push(method) }
        if actual.len() != expected.len() { valid = false }
        else {
            for position in 0_usize..expected.len() {
                let left = actual.get_unchecked_borrowed(position)
                let right = expected.get_unchecked_borrowed(position)
                if left.signature != right.signature || left.module_name != right.module_name ||
                    left.receiver_type != right.receiver_type || left.name != right.name { valid = false }
            }
        }
    }
    for position in 0_usize..methods.len() + 2_usize {
        if methods.contains_index(position) != methods.get(position).is_some() { valid = false }
    }
    lookup.close()
    ret valid
}
fn main() -> u32 {
    let functions = vec![SemanticCallable::new("first", "chosen", vec!["u32"], "u32"),
        SemanticCallable::new("second", "chosen", vec!["str"], "str"),
        SemanticCallable::new("third", "имя", Vec[str]::new(), "bool")]
    let methods = vec![SemanticMethod::new("first", "Box[T]", "read", Vec[str]::new(), "T").with_generics(vec!["T"]),
        SemanticMethod::new("second", "Other", "read", Vec[str]::new(), "str"),
        SemanticMethod::new("third", "Other", "write", vec!["u32"], "void").with_static(true),
        SemanticMethod::new("fourth", "Other", "читать", Vec[str]::new(), "u32")]
    let callables = SemanticSlice::from_vec(functions)
    if !assert(verify(callables, SemanticSlice::from_vec(methods))) { ret 1_u32 }
    let selected = SemanticSlice::project(methods, vec![1_usize, 0_usize, 3_usize])
    let extended = selected.with_overlay(vec![SemanticMethod::new("overlay", "Box[u32]", "read", Vec[str]::new(), "bool")])
    if !assert(verify(SemanticSlice::project(functions, vec![1_usize, 0_usize, 2_usize]), extended)) { ret 2_u32 }
    if !assert(verify(callables, SemanticSlice::project(methods, vec![0_usize, 999_usize, 1_usize]))) { ret 3_u32 }
    if !assert(verify(SemanticSlice::project(functions, vec![1_usize, 999_usize, 0_usize]), selected)) { ret 4_u32 }
    if !assert(verify(SemanticSlice::project(functions, Vec[usize]::new()), SemanticSlice::project(methods, Vec[usize]::new()).with_overlay(methods))) { ret 5_u32 }
    ret 0_u32
}
