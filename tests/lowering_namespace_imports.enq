//! Grouped and repeated namespace aliases resolve calls and nested type paths.
import std::{time as Clock, path as Paths}
import std::time as SecondClock

fn main() -> u32 {
    let first = Clock::perf_counter_ms()
    let second = SecondClock::perf_counter_ms()
    if second < first {
        ret 1_u32
    }
    let path = Paths::Path::new("leaf")
    ret if path.as_str() == "leaf" {
        0_u32
    } else {
        2_u32
    }
}
