//! The small import parser and the established analysis API agree.
import refrain::frontend::import_paths
import refrain::frontend::analysis_database

fn main() -> u32 {
    for path in vec!["models::{Fish as Рыба, Tree, Камень as Rock}", "models::*", "models::Fish as Animal"] {
        let direct = import_paths::import_binding_names(path, "models")
        let compatible = analysis_database::import_binding_names(path, "models")
        if direct.len() != compatible.len() {
            ret 1
        }
        for position in 0..direct.len() {
            let left = direct.get(position).unwrap_or(("", "", false))
            let right = compatible.get(position).unwrap_or(("", "", true))
            if left.0 != right.0 || left.1 != right.1 || left.2 != right.2 {
                ret 2
            }
        }
    }
    let namespace = import_paths::import_namespace_target("пакет::модель as Model", "пакет::модель", "Model::value")
    if namespace != "пакет::модель::value" || namespace != analysis_database::import_namespace_target(
        "пакет::модель as Model", "пакет::модель", "Model::value",) {
        ret 3
    }
    if import_paths::normalized_import_target("пакет::модель", "refrain::other") != "пакет::other" {
        ret 4
    }
    if import_paths::normalized_import_target("пакет::модель", "mod::item") != "пакет::модель::item" {
        ret 5
    }
    if import_paths::import_namespace_target("models::{child as Alias}", "models::child", "Alias::make") != "models::child::make" {
        ret 6
    }
    ret 0
}
