import core::testing::*
import core::vec::Vec

fn main() -> u32 {
    let mut values = Vec[str]::with_capacity(8_usize)
    values.push("alpha")
    values.push("beta")

    let snapshot = values
    // Capacity is deliberately not exhausted: every mutator must still split
    // the shared buffer before writing.
    values.push("gamma")

    if !assert(snapshot.len() == 2_usize) { ret 1_u32 }
    if !assert(values.len() == 3_usize) { ret 2_u32 }
    match snapshot.last() {
        Some(value) => { if !assert(value == "beta") { ret 3_u32 } }
        None => { ret 4_u32 }
    }

    let before_set = values
    values.set(0_usize, "changed")
    match before_set.first() {
        Some(value) => { if !assert(value == "alpha") { ret 5_u32 } }
        None => { ret 6_u32 }
    }

    let before_pop = values
    match values.pop() {
        Some(value) => { if !assert(value == "gamma") { ret 7_u32 } }
        None => { ret 8_u32 }
    }
    if !assert(before_pop.len() == 3_usize) { ret 9_u32 }
    if !assert(values.len() == 2_usize) { ret 10_u32 }

    let before_clear = values
    values.clear()
    if !assert(before_clear.len() == 2_usize) { ret 11_u32 }
    if !assert(values.len() == 0_usize) { ret 12_u32 }
    ret 0_u32
}
