//! Tokenized inline EHIR may put spaces before a generic argument list.
struct Wrapper[Value] {
    item: Value
}

impl[Value] for Wrapper[Value] {
    pub fn get(self: Self) -> Value {
        ret self.item
    }
}
fn read(value: mut Wrapper[u32]) -> u32 {
    unsafe {
        unsafe ehir {
            address: usize = pcast value: mut Wrapper[u32], usize
            instance: mut Wrapper[u32] = pcast address: usize, mut Wrapper[u32]
        }
        ret instance.get()
    }
}
fn main() -> u32 {
    let mut value = Wrapper[u32] { 42_u32 }
    if read(value) != 42_u32 {
        ret 1
    }
    ret 0
}
