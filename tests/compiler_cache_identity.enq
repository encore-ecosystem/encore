//! Compiler artifact caches follow the binary that performed the lowering.

import core::fmt::Debug
import std::os::{remove_file, write_file}
import std::path::Path
import std::time::perf_counter_ms
import refrain::cache_identity::compiler_binary_identity

fn main() -> u32 {
    let path = Path::new("target/compiler-cache-identity-" +
        Debug::fmt(perf_counter_ms()) + ".fixture").resolve()
    let copy = Path::new(path.as_str() + ".copy")
    if write_file(path.as_str(), "bootstrap-a") != 0_i32 { ret 1_u32 }
    if write_file(copy.as_str(), "bootstrap-a") != 0_i32 {
        remove_file(path.as_str())
        ret 2_u32
    }
    let first = compiler_binary_identity(path.as_str())
    let relocated = compiler_binary_identity(copy.as_str())
    if write_file(path.as_str(), "bootstrap-b") != 0_i32 {
        remove_file(path.as_str())
        remove_file(copy.as_str())
        ret 3_u32
    }
    let second = compiler_binary_identity(path.as_str())
    remove_file(path.as_str())
    remove_file(copy.as_str())
    ret if first == relocated && first != second { 0_u32 } else { 4_u32 }
}
