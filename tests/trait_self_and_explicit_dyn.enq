//! Substituting Self must preserve explicitly named dyn trait types.
import core::vec::Vec

trait Provider {
    fn value(self: Self) -> u32
    fn children(self: Self, values: Vec[dyn Provider]) -> Vec[dyn Provider]
}
struct Item {
    number: u32
}

impl Provider for Item {
    fn value(self: Self) -> u32 {
        ret self.number
    }
    fn children(self: Self, values: Vec[dyn Provider]) -> Vec[dyn Provider] {
        ret values
    }
}
fn through_bound[T: Provider](value: T, children: Vec[dyn Provider]) -> Vec[dyn Provider] {
    ret value.children(children)
}
fn main() -> u32 {
    let item = Item { 17_u32 }
    let mut children = Vec[dyn Provider]::new()
    children.push(item as dyn Provider)
    let output = through_bound(item, children)
    if output.len() != 1_usize {
        ret 1
    }
    match output.get(0_usize) {
        Some(child) => {
            if child.value() != 17_u32 {
                ret 2
            }
        }
        None => {
            ret 3
        }
    }
    ret 0
}
