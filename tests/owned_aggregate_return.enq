struct OwnedText {
    value: str
}

enum MaybeText {
    Some(str)
    None
}

fn wrap_struct() -> OwnedText {
    let text = "struct payload"
    ret OwnedText{text}
}

fn wrap_enum() -> MaybeText {
    let text = "enum payload"
    ret MaybeText::Some(text)
}

fn main() -> u32 {
    let wrapped = wrap_struct()
    if wrapped.value != "struct payload" { ret 1_u32 }
    match wrap_enum() {
        MaybeText::Some(value) => {
            if value != "enum payload" { ret 2_u32 }
        }
        MaybeText::None => { ret 3_u32 }
    }
    ret 0_u32
}
