import core::iter::enumerate
import core::testing::*
import core::vec::Vec

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(10_u32)
    values.push(20_u32)
    values.push(30_u32)

    let mut weighted = 0_u32
    for pair in enumerate(values.iter()) {
        weighted = weighted + (pair.0 as u32) * pair.1
    }

    if !assert(weighted == 80_u32) {
        ret 1_u32
    }
    ret 0_u32
}
