//! Type completion works in incomplete annotations, not ordinary expressions.

import core::testing::assert
import refrain::frontend::{Lexer, cursor_expects_type, cursor_symbol_path}

fn expects(source: str) -> bool {
    let mut lexer = Lexer::new()
    ret cursor_expects_type(lexer.tokenize(source), 0_usize, source.char_len())
}

fn main() -> u32 {
    if !assert(expects("fn main() { let a: us")) { ret 1_u32 }
    if !assert(expects("fn f(a: us")) { ret 2_u32 }
    if !assert(expects("fn f() -> us")) { ret 3_u32 }
    if !assert(expects("pub struct S { field: us")) { ret 4_u32 }
    if !assert(expects("fn f() { let a: Vec[us")) { ret 5_u32 }
    if !assert(expects("fn f() { let a: (u32, us")) { ret 6_u32 }
    if !assert(!expects("fn f() { let a: usize = us")) { ret 7_u32 }
    if !assert(!expects("fn f() { let a = S { field: us")) { ret 8_u32 }
    if !assert(!expects("fn f() { us")) { ret 9_u32 }
    if !assert(!expects("fn f(first: u32, second")) { ret 11_u32 }
    if !assert(expects("fn f(first: u32, second: us")) { ret 12_u32 }
    if !assert(expects("fn f(first: Pair[u32, us")) { ret 13_u32 }
    if !assert(!expects("fn f(first: (u32, u32), second")) { ret 14_u32 }
    if !assert(!expects("fn f(first: Pair[u32, u32], second")) { ret 15_u32 }
    let mut lexer = Lexer::new()
    if !assert(cursor_symbol_path(lexer.tokenize("io::println(\"hi\")"), 0_usize, 6_usize) == "io::println") {
        ret 10_u32
    }
    let grouped = lexer.tokenize("import refrain::helper::{\n first as local,\n second,\n}\nfn sample() { local() }")
    if !assert(cursor_symbol_path(grouped, 1_usize, 2_usize) == "refrain::helper::first") { ret 16_u32 }
    if !assert(cursor_symbol_path(grouped, 1_usize, 11_usize) == "local") { ret 17_u32 }
    if !assert(cursor_symbol_path(grouped, 2_usize, 2_usize) == "refrain::helper::second") { ret 18_u32 }
    if !assert(cursor_symbol_path(grouped, 4_usize, 15_usize) == "local") { ret 19_u32 }
    ret 0_u32
}
