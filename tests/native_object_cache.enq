//! Native object entries must survive relocation and reject partial/corrupt data.
import core::result::Result
import std::os::{cwd, mkdir_all, read_file, remove_dir_all, remove_file, write_file}
import std::path::Path
import std::time::perf_counter_ns

import refrain::modes::build_object_cache::{commit_native_object, commit_prepared_object, native_object_key, prepared_object_key, restore_native_object, restore_prepared_object}

fn exercise(root: Path) -> Result[bool, str] {
    let cache = root.join("cache")
    let source = root.join("source.o")
    let destination = root.join("relocated.o")
    let key = native_object_key("llvm-body", "x86_64", "compiler-flags")
    if key == native_object_key("changed-body", "x86_64", "compiler-flags") ||
    key == native_object_key("llvm-body", "aarch64", "compiler-flags") ||
    key == native_object_key("llvm-body", "x86_64", "changed-flags") {
        ret Result[bool, str]::Ok(false)
    }
    if restore_native_object(cache, key, destination)? {
        ret Result[bool, str]::Ok(false)
    }
    if write_file(source.as_str(), "object-payload") != 0 {
        ret Result[bool, str]::Ok(false)
    }
    commit_native_object(cache, key, source)?
    if !restore_native_object(cache, key, destination)? || read_file(destination.as_str()) != "object-payload" {
        ret Result[bool, str]::Ok(false)
    }
    let entry = cache.join(key)
    write_file(entry.join("object.o").as_str(), "corrupt")
    if restore_native_object(cache, key, destination)? {
        ret Result[bool, str]::Ok(false)
    }
    commit_native_object(cache, key, source)?
    remove_file(entry.join("commit").as_str())
    if restore_native_object(cache, key, destination)? {
        ret Result[bool, str]::Ok(false)
    }
    commit_native_object(cache, key, source)?
    if !restore_native_object(cache, key, destination)? {
        ret Result::Ok(false)
    }
    let early = root / "early"
    let prepared = prepared_object_key("normalized-module", "compiler-target-context")
    if prepared == prepared_object_key("changed-module", "compiler-target-context") ||
    prepared == prepared_object_key("normalized-module", "changed-context") ||
    restore_prepared_object(early, prepared, destination)? {
        ret Result::Ok(false)
    }
    commit_native_object(early / "objects-v1", key, source)?
    commit_prepared_object(early, prepared, key)?
    if !restore_prepared_object(early, prepared, destination)? || read_file(destination.as_str()) != "object-payload" {
        ret Result::Ok(false)
    }
    remove_dir_all((early / "objects-v1" / key).as_str())
    ret Result::Ok(!restore_prepared_object(early, prepared, destination)?)
}

fn main() -> u32 {
    let root = Path::new(cwd()).join("target").join(f"object-cache-test-{perf_counter_ns()}")
    if mkdir_all(root.as_str()) != 0 {
        ret 1
    }
    let passed = exercise(root).unwrap_or(false)
    let cleaned = remove_dir_all(root.as_str()) == 0
    ret if passed && cleaned {
        0
    } else {
        1
    }
}
