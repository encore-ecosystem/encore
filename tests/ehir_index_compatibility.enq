//! Legacy index module paths resolve to the current shared EHIR types.
import core::testing::assert
import ehirlib::string_index::{string_index_get, string_index_insert, string_index_with_capacity}
import ehirlib::string_set::{string_set_contains, string_set_contains_or_insert, string_set_with_capacity}

fn main() -> u32 {
    let mut index = string_index_with_capacity(1_usize)
    string_index_insert(index, "sdk", 7_usize)
    if !assert(string_index_get(index, "sdk") == 8_usize) {
        ret 1_u32
    }
    let mut names = string_set_with_capacity(1_usize)
    if !assert(!string_set_contains_or_insert(names, "sdk")) {
        ret 2_u32
    }
    if !assert(string_set_contains(names, "sdk")) {
        ret 3_u32
    }
    ret 0_u32
}
