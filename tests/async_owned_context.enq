//! Every generated parent poll retains its Context across child polls and
//! releases it on both Pending and Ready, including a body without await.
import core::future::{Context, Future, Poll}
import std::future::block_on

extern fn encore_async_waker_retain(token: usize) -> bool
extern fn encore_async_waker_release(token: usize) ->()

struct Probe {
    pending: bool
}

impl Future[usize] for Probe {
    fn poll(self: Self, context: Context) -> Poll[Self, usize] {
        if self.pending {
            context.waker.wake()
            ret Poll::Pending(Probe { false })
        }
        ret Poll::Ready(context.waker.raw_token())
    }
}

async fn empty() -> u32 {
    ret 42_u32
}
async fn nested(pending: bool) -> usize {
    let first = await Probe { pending }
    let second = await Probe { pending }
    ret if first == second {
        second
    } else {
        0_usize
    }
}
async fn outer(pending: bool) -> usize {
    let first = await nested(pending)
    let second = await nested(pending)
    ret if first == second {
        second
    } else {
        0_usize
    }
}

fn main() -> u32 {
    if block_on[u32, __encore_future_empty](empty()) != 42_u32 {
        ret 1_u32
    }
    for pending in vec![false, true] {
        let token = block_on[usize, __encore_future_outer](outer(pending))
        if token == 0_usize {
            ret 2_u32
        }
        if unsafe {
            encore_async_waker_retain(token)
        }
        {
            unsafe {
                encore_async_waker_release(token)
            }
            ret 3_u32
        }
    }
    ret 0_u32
}
