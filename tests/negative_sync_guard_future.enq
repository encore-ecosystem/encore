// @expect.compile_error=mutex-guard-in-future
import core::future::{Future, Context, Poll}
import std::sync::MutexGuard
struct Held {
    guard: MutexGuard[u64]
}

impl Future[()] for Held {
    pub fn poll(self: Self, context: Context) -> Poll[Self,()] {
        ret Poll::Pending(self)
    }
}
fn main() -> u32 {
    ret 0_u32
}
