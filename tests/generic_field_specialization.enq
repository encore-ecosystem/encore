//! Projected fields specialize their declaration's parameters recursively.

struct T {
    value: u32
}
struct Leaf[Item] {
    value: Item
}
struct Holder[Item] {
    fixed: T
    nested: Leaf[Item]<H>
}
struct Pair[Left, Right] {
    left: Leaf[Left]<H>
    right: Leaf[Right]<H>
}
struct Tuple[First, Second](Leaf[First]<H>, Second)

fn main() -> u32 {
    let holder = Holder[u32] {
        T { 9 }, Leaf[u32]<H> { 42 }
    }
    // A nominal T is not the Holder's differently named generic parameter.
    if holder.fixed.value != 9 {
        ret 1
    }
    if holder.nested.value != 42 {
        ret 2
    }
    let pair = Pair[u32, str] {
        Leaf[u32]<H> { 7 }, Leaf[str]<H> { "nested" }
    }
    if pair.left.value != 7 {
        ret 3
    }
    if pair.right.value != "nested" {
        ret 4
    }
    let tuple = Tuple[u32, str] {
        Leaf[u32]<H> { 11 }, "tuple"
    }
    if tuple.0.value != 11 {
        ret 5
    }
    if tuple.1 != "tuple" {
        ret 6
    }
    ret 0
}
