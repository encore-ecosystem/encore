import core::option::Option
import core::vec::Vec

struct Resource {
    values: Vec[u32]
    generation: u32
}

fn main() -> u32 {
    let mut payload = Vec[u32]::new()
    payload.push(77_u32)
    let mut resources = Vec[Resource]::new()
    resources.push(Resource{payload, 0_u32})
    let mut iteration = 0_usize
    while iteration < 10000_usize {
        match resources.get(0_usize) {
            Option::Some(previous) => {
                resources.set(0_usize, Resource{previous.values, previous.generation + 1_u32})
            }
            Option::None => { ret 1_u32 }
        }
        iteration += 1_usize
    }
    match resources.get(0_usize) {
        Option::Some(value) => {
            ret if value.values.len() == 1_usize && value.generation == 10000_u32 {
                0_u32
            } else {
                2_u32
            }
        }
        Option::None => { ret 3_u32 }
    }
}
