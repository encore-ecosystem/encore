//! Library workspaces retain the complete implicit core prelude graph.

import std::path::Path
import refrain::project::workspace::load_library_workspace

fn main() -> u32 {
    let workspace = load_library_workspace(Path::new("."))
    let mut core_ops = false
    for module in workspace.loaded_modules() {
        if module.analysis_module_id().key() == "core::ops" {
            core_ops = true
        }
    }
    if !core_ops {
        ret 1_u32
    }
    // This call is intentionally intrinsic at the source level.  Its
    // implementation must come from the preloaded core::ops module.
    if "Yanti".char_len() != 5_usize {
        ret 2_u32
    }
    ret 0_u32
}
