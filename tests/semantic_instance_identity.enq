//! Instance inference distinguishes declarations and invalidates redirected aliases.

import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("left", "left.enq", "pub struct Item { value: u32 }\nimpl for Item { pub fn read(self: Self) -> u32 { ret self.value } }\npub fn make() -> Item { ret Item { 1_u32 } }")
    db.set_module("right", "right.enq", "pub struct Item { value: str }\nimpl for Item { pub fn read(self: Self) -> str { ret self.value } }\npub fn make() -> Item { ret Item { \"right\" } }")
    db.set_module("api", "api.enq", "pub import left::Item as Selected")
    db.set_module("app", "app.enq", "import api::Selected\nimport left::{Item as Left, make as make_left}\nimport right::{Item as Right, make as make_right}\nfn sample(left: Left, right: Right, selected: Selected) {\n let a = left.read()\n let b = right.read()\n let c = make_left().read()\n let d = make_right().read()\n let field = selected.value\n}\nfn only_type(selected: Selected) { let copied = selected }")
    let id = db.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    let type_id = db.symbol_id("app", "only_type").unwrap_or(SymbolId::invalid())
    let body = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(body.binding_type("a").unwrap_or("") == "u32") { ret 1_u32 }
    if !assert(body.binding_type("b").unwrap_or("") == "str") { ret 2_u32 }
    if !assert(body.binding_type("c").unwrap_or("") == "u32") { ret 3_u32 }
    if !assert(body.binding_type("d").unwrap_or("") == "str") { ret 4_u32 }
    if !assert(body.binding_type("field").unwrap_or("") == "u32") { ret 5_u32 }
    db.semantic_body(type_id)
    db.set_module("api", "api.enq", "pub import right::Item as Selected")
    let changed = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(changed.binding_type("field").unwrap_or("") == "str") { ret 6_u32 }
    db.semantic_body(type_id)
    if !assert(db.semantic_body_count(type_id) == 2_usize) { ret 7_u32 }
    db.set_module("left", "left.enq", "pub struct Item { value: u32 }\nimpl for Item { pub fn read(self: Self) -> u32 { ret 2_u32 } }\npub fn make() -> Item { ret Item { 2_u32 } }")
    db.semantic_body(type_id)
    if !assert(db.semantic_body_count(type_id) == 2_usize) { ret 8_u32 }
    let mut collections = AnalysisDatabase::new()
    collections.set_module("library", "library.enq", "pub struct Vec[T] {}\npub enum Result[T, E] { Ok(T), Err(E) }\npub struct T {}\npub fn identity[T](value: T) -> T { ret value }")
    collections.set_module("consumer", "consumer.enq", "import library::{Vec as List, Result as Outcome, identity}\nfn sample(items: List[u32], result: Outcome[u32, str]) {\n let indexed = items[0_usize]\n let inferred = identity(true)\n for entry in items { let copy = entry }\n match result { Outcome[u32, str]::Ok(value) => { let ok = value } Outcome[u32, str]::Err(error) => { let failed = error } }\n}")
    let collection_id = collections.symbol_id("consumer", "sample").unwrap_or(SymbolId::invalid())
    let collection_body = collections.semantic_body(collection_id).unwrap_or(SemanticBody::empty())
    if !assert(collection_body.binding_type("indexed").unwrap_or("") == "u32") { ret 9_u32 }
    if !assert(collection_body.binding_type("inferred").unwrap_or("") == "bool") { ret 10_u32 }
    let mut saw_item = false
    let mut saw_error = false
    for site in collection_body.scoped_bindings {
        if site.binding.name == "copy" { saw_item = site.binding.typ == "u32" }
        if site.binding.name == "failed" { saw_error = site.binding.typ == "str" }
    }
    if !assert(saw_item && saw_error) { ret 11_u32 }
    ret 0_u32
}
