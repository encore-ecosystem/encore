import std::path::Path
import std::os::path_separator
import refrain::project::workspace::load_binary_workspace

fn main() -> u32 {
    let workspace = load_binary_workspace(Path::new("."))
    let modules = workspace.loaded_modules()
    let mut vec_id = ""
    let mut vec_analysis_id = ""
    let mut codegen_imports = Vec[str]::new()
    let sep = path_separator()

    for module in modules {
        if module.path().contains(sep + "index" + sep + "std" + sep + "src" + sep + "vec" + sep + "mod.enq") {
            vec_id = module.id()
            vec_analysis_id = module.analysis_module_id().key()
        }
        if module.path().contains(sep + "index" + sep + "ehir-llvm-backend" + sep + "src" + sep + "codegen" + sep + "mod.enq") {
            codegen_imports = module.resolved_import_ids()
        }
    }

    if vec_id == "" { ret 1_u32 }
    if vec_analysis_id != "std::vec" { ret 3_u32 }
    for imported in codegen_imports {
        if imported == vec_id { ret 0_u32 }
    }
    ret 2_u32
}
