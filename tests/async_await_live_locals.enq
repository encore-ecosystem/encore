import core::future::{Future, Poll}
import std::future::block_on

struct Once {
    pending: bool
    value: u32
}

impl Future[u32] for Once {
    fn poll(self: Once) -> Poll[Once, u32] {
        if self.pending {
            ret Poll[Once, u32]::Pending(Once{false, self.value})
        }
        ret Poll[Once, u32]::Ready(self.value)
    }
}

async fn add_after_wait(future: Once, label: str) -> u32 {
    let base = 40_u32
    let value = await future
    if label == "ok" {
        ret base + value
    }
    ret 1_u32
}

fn main() -> u32 {
    let future = add_after_wait(Once{true, 2_u32}, "ok")
    let value = block_on[u32, __encore_future_add_after_wait](future)
    if value == 42_u32 { ret 0_u32 }
    ret 1_u32
}
