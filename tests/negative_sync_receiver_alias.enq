// @expect.compile_error=aliased-region-transfer
import core::result::Result
import std::sync::{Receiver, bounded}
fn consume(input: sending Receiver[u32]) -> u32 {
    ret input.try_receive().unwrap_or(0_u32)
}
fn main() -> u32 {
    let pair = match bounded[u32](1_usize) {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let receiver = pair.1
    let worker = spawn consume(receiver)
    ret worker.join()
}
