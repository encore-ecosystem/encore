// @expect.compile_error=error[trait-method-generic-arity-mismatch]: method 'identity' declares 0 generic parameter(s), but trait 'Identity' requires 1

trait Identity {
    fn identity[T](self: Self, value: T) -> T
}

struct Value {}

impl Identity for Value {
    fn identity(self: Self, value: u32) -> u32 {
        ret value
    }
}

fn main() -> u32 {
    ret 0_u32
}
