// @expect.compile_error=unknown variable 'values'
import core::vec::Vec
fn consume(values: sending Vec[str]) -> usize {
    ret values.len()
}
fn main() -> u32 {
    let values = Vec[str]::new()
    let count = match true {
        true => consume(values) false => 0_usize
    }
    ret(count + values.len()) as u32
}
