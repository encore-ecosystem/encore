//! Inferred statics preserve heap placement and forward dependency identity.
struct Counter {
    value: u32
}
static COUNTER: Counter<H> = Counter<H>{ 0_u32 }

impl for Counter {
    pub fn new() -> Counter<H> {
        let mut counter = COUNTER
        counter.value += 1_u32
        ret Counter<H>{ counter.value }
    }
}

static FORWARD: Counter<H> = configuration
static configuration = Counter::new()

fn main() -> u32 {
    if FORWARD.value != 1_u32 || configuration.value != 1_u32 {
        ret 1_u32
    }
    let mut first = configuration
    first.value = 42_u32
    if FORWARD.value != 42_u32 || configuration.value != 42_u32 {
        ret 2_u32
    }
    if COUNTER.value != 1_u32 {
        ret 3_u32
    }
    ret 0_u32
}
