// @expect.compile_error=plugin values cannot contain pointers, nodes, capabilities or unwrapped dyn objects
import std::plugin::{Plugin, Resource}
#attr(plugin_interface)
trait Counter {
    fn value(self: Self) -> u32
}
#attr(plugin_interface)
trait Bad {
    fn get(self: Self) -> Resource[dyn Counter]&
}
fn main() -> u32 {
    match unsafe {
        Plugin::load("unused")
    }
    {
        Ok(plugin) => {
            let binding = plugin.bind[dyn Bad]("bad")
        }
        Err(_) => {
        }
    }
    ret 0
}
