//! Typed snapshots preserve real functions, methods, docs and SSA representations.
import core::option::Option
import ehirlib::{decode_typed_module, encode_typed_module, module_to_string, parse_module_text, prepared_bytes_payload, prepared_payload_bytes}

fn main() -> u32 {
    let source = "struct Pair {\nvalue: u32\n}\n" +
    "/// A typed function.\nfn answer(value: u32) -> u32 {\n$entry:\nret value: u32\n}\n" +
    "impl Pair {\nfn read(self: Pair) -> u32 {\n$entry:\nv: u32 = capprim 42_u32\nret v: u32\n}\n}\n"
    let module = parse_module_text("artifact", source)
    let payload = encode_typed_module(module, "checked-context-and-source").unwrap_or("")
    if payload.is_empty() {
        ret 1
    }
    let restored = match decode_typed_module(payload, "checked-context-and-source") {
        Ok(value) => value Err(_) => {
            ret 2
        }
    }
    if module_to_string(restored) != module_to_string(module) {
        ret 3
    }
    if decode_typed_module(payload, "different-context").is_ok() ||
    decode_typed_module(payload.slice_bytes(0_usize, payload.byte_len() - 1_usize), "checked-context-and-source").is_ok() {
        ret 4
    }
    let bytes = "\0raw bytes\0Привет"
    if prepared_bytes_payload(prepared_payload_bytes(bytes)) != bytes {
        ret 5
    }
    ret 0
}
