//! Trait bounds preserve immutable receivers and frozen argument capabilities.
import core::testing::assert
import std::vec::Vec

trait Inspect {
    fn inspect(self: Self, values: frozen Vec[str]) -> usize
}
struct Reader {}
impl Inspect for Reader {
    fn inspect(self: Self, values: frozen Vec[str]) -> usize { ret values.len() }
}
fn inspect[T: Inspect](reader: frozen T, values: frozen Vec[str]) -> usize {
    ret reader.inspect(values)
}
fn worker[T: Inspect](reader: frozen T, values: frozen Vec[str]) -> usize {
    ret inspect[T](reader, values)
}
fn main() -> u32 {
    let reader = Reader {}
    let values = vec!["one", "two"]
    let first = spawn worker[Reader](reader, values)
    let second = spawn worker[Reader](reader, values)
    if !assert(first.join() == 2_usize && second.join() == 2_usize) { ret 1_u32 }
    ret 0_u32
}
