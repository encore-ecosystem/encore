// @expect.compile_error=use of moved future

import core::future::{Context, Future, Poll}

struct Immediate {}

impl Future[u32] for Immediate {
    fn poll(self: Immediate, context: Context) -> Poll[Immediate, u32] {
        ret Poll[Immediate, u32]::Ready(1_u32)
    }
}

async fn invalid(future: Immediate) -> u32 {
    let first = await future
    let second = await future
    ret first + second
}

fn main() -> u32 {
    ret 0_u32
}
