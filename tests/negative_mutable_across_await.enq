// @expect.compile_error=error[borrow-across-await]: mutable local 'value' cannot cross await

import core::future::{Future, Poll}

struct Immediate {}

impl Future[u32] for Immediate {
    fn poll(self: Immediate) -> Poll[Immediate, u32] {
        ret Poll[Immediate, u32]::Ready(2_u32)
    }
}

async fn invalid() -> u32 {
    let mut value = 1_u32
    let awaited = await Immediate{}
    ret value + awaited
}

fn main() -> u32 {
    ret 0_u32
}
