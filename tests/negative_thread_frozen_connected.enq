// @expect.compile_error=cannot freeze 'values' because its region may be reachable
import core::vec::Vec

fn connect(values: mut Vec[Vec[str]], inner: Vec[str]) -> () {
    values.push(inner)
    ret ()
}

fn inspect(values: frozen Vec[Vec[str]]) -> usize {
    ret values.len()
}

fn main() -> u32 {
    let mut values = Vec[Vec[str]]::new()
    let inner = Vec[str]::new()
    connect(values, inner)
    ret inspect(values) as u32
}
