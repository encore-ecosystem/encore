//! Resource constructors do not make unrelated new methods reflective.
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::reflection::reflection_template_names

fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("associated_templates.enq")
    let ast = parser.parse(lexer.tokenize(
            "import std::plugin::Resource as Handle\n" +
            "struct Resource[I] {}\n" +
            "impl[I] for Resource[I] { #attr(reflection_template) #attr(plugin_resource_constructor) fn new[T](value:T) -> T { ret value } }\n" +
            "fn wrapped[T](value:T) -> T { ret Resource[dyn api::Counter]::new(value) }\n" +
            "fn qualified[T](value:T) -> T { ret platform::plugin::Resource[dyn api::Counter]::new(value) }\n" +
            "fn aliased[T](value:T) -> T { ret Handle[dyn api::Counter]::new(value) }\n" +
            "fn ordinary[T]() -> Vec[T] { ret Vec[T]::new() }\n"))
    let names = reflection_template_names(ast)
    let mut constructor = false
    let mut wrapped = false
    let mut qualified = false
    let mut aliased = false
    for name in names {
        if name == "new" || name == "ordinary" {
            ret 1
        }
        if name == "Resource::new" {
            constructor = true
        }
        if name == "wrapped" {
            wrapped = true
        }
        if name == "aliased" {
            aliased = true
        }
        if name == "qualified" {
            qualified = true
        }
    }
    if !constructor || !wrapped || !qualified || !aliased {
        ret 2
    }
    ret 0
}
