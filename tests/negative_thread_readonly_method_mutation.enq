// @expect.compile_error=requires a mutable receiver
import core::vec::Vec

struct Holder {
    values: Vec[str]
}

impl for Holder {
    fn mutate(self: Holder) -> () {
        self.values.push("forbidden")
        ret()
    }
}

fn main() -> u32 {
    let holder = Holder{Vec[str]::new()}
    holder.mutate()
    ret 0_u32
}
