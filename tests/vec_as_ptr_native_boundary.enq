//! Vec raw-pointer access remains valid through complete lowering.

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(17_u32)
    values.push(29_u32)
    let pointer = values.as_ptr()
    if pointer as usize == 0_usize { ret 1_u32 }
    if values.len() != 2_usize { ret 2_u32 }
    ret 0_u32
}
