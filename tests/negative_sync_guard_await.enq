// @expect.compile_error=mutex-guard-across-await
import core::result::Result
import core::future::ready

import std::sync::Mutex
async fn hold() -> u32 {
    let mutex = Mutex[u64]::new(1_u64)
    let guard = match mutex.lock() {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let result = await ready(0_u32)
    guard.release()
    ret result
}
fn main() -> u32 {
    ret 0_u32
}
