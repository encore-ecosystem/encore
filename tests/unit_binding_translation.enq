//! Unit locals retain effects and scope, but never allocate void registers.
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source = "fn touch() -> () { ret () }\n" +
    "fn relay() -> () { let value = unsafe { touch() } let alias: () = value ret alias }\n" +
    "fn main() -> u32 { let mut value: () = touch() value = unsafe { touch() } let copied = value relay() ret 0 }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("unit-bindings.enq")
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if output.contains("_letvar_") || output.contains("salloc ()") || output.contains("salloc void") ||
    output.contains(": void = copy") {
        ret 1
    }
    if !output.contains("call ") {
        ret 2
    }
    ret 0
}
