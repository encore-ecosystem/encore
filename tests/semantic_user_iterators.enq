//! Loop bindings use user-defined iterator methods, including generic substitution.
import refrain::frontend::{AnalysisDatabase, SymbolId, SemanticBody}

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("sample", "sample.enq",
        "struct Cursor[T] {}\nimpl[T] for Cursor[T] { fn next(self: Self) -> (Self, Option[T]) { ret (self, Option[T]::None) } }\nstruct Rows[T] {}\nimpl[T] for Rows[T] { fn into_iter(self: Self) -> Cursor[T] { ret Cursor[T] {} } }\nfn direct(cursor: Cursor[str]) {\n for word in cursor {\n  let selected = word\n }\n}\nfn converted(rows: Rows[u32]) {\n for number in rows {\n  let selected = number\n }\n}\n",)
    let direct = database.semantic_body(database.symbol_id("sample", "direct").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    let converted = database.semantic_body(database.symbol_id("sample", "converted").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    let mut word_ok = false
    for binding in direct.bindings_at(6, 20) {
        if binding.name == "word" {
            word_ok = binding.typ == "str"
        }
    }
    let mut number_ok = false
    for binding in converted.bindings_at(11, 20) {
        if binding.name == "number" {
            number_ok = binding.typ == "u32"
        }
    }
    if !word_ok {
        ret 1
    }
    if !number_ok {
        ret 2
    }
    database.set_module("effects", "effects.enq",
        "struct Cursor {}\nimpl for Cursor { fn next(self: Self) -> (Self, Option[u32]) { unsafe { ret (self, Option[u32]::None) } } }\nfn consume(cursor: Cursor) { for value in cursor {} }\nstruct Rows {}\nimpl for Rows { fn into_iter(self: Self) -> Cursor { ret Cursor {} } }\nfn convert(rows: Rows) { for value in rows {} }\n",)
    if !database.function_is_unsafe(database.symbol_id("effects", "consume").unwrap_or(SymbolId::invalid())) {
        ret 3
    }
    if !database.function_is_unsafe(database.symbol_id("effects", "convert").unwrap_or(SymbolId::invalid())) {
        ret 4
    }
    database.set_module("cursor", "cursor.enq",
        "pub struct Cursor {}\npub impl for Cursor { pub fn next(self: Self) -> (Self, Option[str]) { ret (self, Option[str]::None) } }\n",)
    database.set_module("consumer", "consumer.enq",
        "import cursor::Cursor\nfn consume(value: Cursor) {\n for item in value {\n  let saved = item\n }\n}\n",)
    let consumer_id = database.symbol_id("consumer", "consume").unwrap_or(SymbolId::invalid())
    let before = database.semantic_body(consumer_id).unwrap_or(SemanticBody::empty())
    let mut saw_string = false
    for binding in before.bindings_at(3, 15) {
        if binding.name == "item" {
            saw_string = binding.typ == "str"
        }
    }
    if !saw_string {
        ret 5
    }
    database.set_module("cursor", "cursor.enq",
        "pub struct Cursor {}\npub impl for Cursor { pub fn next(self: Self) -> (Self, Option[u32]) { ret (self, Option[u32]::None) } }\n",)
    let after = database.semantic_body(consumer_id).unwrap_or(SemanticBody::empty())
    let mut saw_integer = false
    for binding in after.bindings_at(3, 15) {
        if binding.name == "item" {
            saw_integer = binding.typ == "u32"
        }
    }
    if !saw_integer {
        ret 6
    }
    ret 0
}
