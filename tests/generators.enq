//! Lazy generators share one cursor across aliases and implement ordinary Iterator.
import core::iter::{Generator, Iterator, enumerate}
import core::option::Option
import core::testing::assert

fn fibonacci(count: usize) -> usize {
    let mut previous = 0_usize
    let mut current = 1_usize
    for _ in 0..count {
        let value = previous + current
        yield value
        previous = current
        current = value
    }
}
fn twice[T](value: T) -> T {
    yield value
    yield value
}
fn empty() -> usize {
    if false {
        yield 1_usize
    }
}
fn early() -> usize {
    yield 7_usize
    ret()
    yield 100_usize
}
fn sum(values: Generator[usize]) -> usize {
    let mut result = 0_usize
    for value in values {
        result += value
    }
    ret result
}
struct Numbers {
    count: usize
}

impl for Numbers {
    pub fn values(self: Self) -> usize {
        for value in 0..self.count {
            yield value
        }
    }
}
fn branching() -> usize {
    let mut index = 0_usize
    while index < 5_usize {
        index += 1_usize
        if index == 2_usize {
            continue
        }
        if index == 4_usize {
            break
        }
        yield index
        if index == 1_usize {
            yield 10_usize
        }
    }
}
fn endless() -> usize {
    let mut index = 0_usize
    loop {
        yield index index += 1_usize
    }
}
fn first_owned() -> str {
    for value in twice("owned " + "result") {
        ret value
    }
    ret ""
}
extern fn encore_node_debug_live_count() -> usize
fn main() -> u32 {
    let values: Generator[usize] = fibonacci(5)
    let alias = values
    for value in values {
        if !assert(value == 1_usize) {
            ret 1_u32
        }
        break
    }
    if !assert(sum(alias) == 18_usize) {
        ret 2_u32
    }
    if !assert(sum(values) == 0_usize) {
        ret 3_u32
    }
    if !assert(sum(fibonacci(5)) == 19_usize) {
        ret 4_u32
    }
    if !assert(sum(empty()) == 0_usize && sum(early()) == 7_usize) {
        ret 5_u32
    }
    let generated = twice("owned " + "item")
    let step = generated.next()
    match step.1 {
        Some(value) => {
            if !assert(value == "owned item") {
                ret 6_u32
            }
        }
        None => {
            ret 7_u32
        }
    }
    let mut count = 0_usize
    for value in generated {
        count += value.len()
    }
    if !assert(count == 10_usize) {
        ret 8_u32
    }
    if !assert(sum(Numbers { 4_usize }.values()) == 6_usize) {
        ret 9_u32
    }
    let mut indexed = 0_usize
    for pair in enumerate[usize, Generator[usize]](fibonacci(3)) {
        indexed += pair.0 + pair.1
    }
    if !assert(indexed == 9_usize) {
        ret 10_u32
    }
    if !assert(sum(branching()) == 14_usize) {
        ret 11_u32
    }
    let infinite = endless()
    for value in infinite {
        if !assert(value == 0_usize) {
            ret 12_u32
        }
        break
    }
    for value in infinite {
        if !assert(value == 1_usize) {
            ret 13_u32
        }
        break
    }
    let before = unsafe {
        encore_node_debug_live_count()
    }
    for _ in 0..30 {
        if !assert(first_owned() == "owned result") {
            ret 14_u32
        }
    }
    let after = unsafe {
        encore_node_debug_live_count()
    }
    if !assert(before == after) {
        ret 15_u32
    }
    ret 0_u32
}
