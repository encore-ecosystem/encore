import core::time::{perf_counter_ms, sleep_ms}

fn worker(value: u32) -> u32 {
    sleep_ms(500_u64)
    ret value * value
}

fn main() -> u32 {
    let started = perf_counter_ms()
    let left = spawn worker(6_u32)
    let right = spawn worker(8_u32)
    let left_value = left.join()
    let right_value = right.join()
    let elapsed = perf_counter_ms() - started
    if left_value != 36_u32 { ret 1_u32 }
    if right_value != 64_u32 { ret 2_u32 }
    if elapsed >= 900_u64 { ret 3_u32 }
    ret 0_u32
}
