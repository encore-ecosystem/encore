//! Context exits run exactly once, from inner to outer, on every transfer.
import core::ops::ContextManager
import core::result::Result
import std::os::{read_file, write_file_atomic, remove_file}

struct Resource {
    name: str
}

impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret write_file_atomic("target/tests/with-cleanup-paths.txt",
            read_file("target/tests/with-cleanup-paths.txt") + self.name,) == 0_i32
    }
}

fn returned() -> Result[bool, u32] {
    with Resource {
        "a"
    }
    as outer {
        unsafe {
            with Resource {
                "b"
            }
            as inner {
                ret Result[bool, u32]::Ok(true)
            }
        }
    }
}

fn failed() -> Result[bool, u32] {
    with Resource {
        "c"
    }
    as outer {
        with Resource {
            "d"
        }
        as inner {
            let failure = Result[bool, u32]::Err(7_u32)
            let value = failure?
            ret Result[bool, u32]::Ok(value)
        }
    }
}

fn main() -> u32 {
    if write_file_atomic("target/tests/with-cleanup-paths.txt", "") != 0_i32 {
        ret 1_u32
    }
    match returned() {
        Ok(value) => {
            if !value {
                ret 2_u32
            }
        }
        Err(_) => {
            ret 3_u32
        }
    }
    if read_file("target/tests/with-cleanup-paths.txt") != "ba" {
        ret 4_u32
    }
    match failed() {
        Ok(_) => {
            ret 5_u32
        }
        Err(code) => {
            if code != 7_u32 {
                ret 6_u32
            }
        }
    }
    if read_file("target/tests/with-cleanup-paths.txt") != "badc" {
        ret 7_u32
    }
    with Resource {
        "e"
    }
    as enclosing {
        for item in 0..3 {
            with Resource {
                "f"
            }
            as iteration {
                if item == 0_usize {
                    continue
                } else {
                    break
                }
            }
            // Neither this code nor enclosing.with_exit may run on loop transfer.
            ret 8_u32
        }
        if read_file("target/tests/with-cleanup-paths.txt") != "badcff" {
            ret 9_u32
        }
    }
    if read_file("target/tests/with-cleanup-paths.txt") != "badcffe" {
        ret 10_u32
    }
    if remove_file("target/tests/with-cleanup-paths.txt") != 0_i32 {
        ret 11_u32
    }
    ret 0_u32
}
