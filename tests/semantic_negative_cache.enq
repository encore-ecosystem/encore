//! Failed lookups are invalidated when the visible declaration set changes.

import core::option::Option
import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("dep", "dep.enq", "pub fn existing() -> u32 { ret 1 }")
    database.set_module("app", "app.enq", "import dep::*\nfn sample() { let value = added()\n value\n}")
    let id = database.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    database.semantic_body(id)
    database.semantic_body(id)
    if !assert(database.semantic_body_count(id) == 1_usize) { ret 1_u32 }
    database.set_module("unrelated", "unrelated.enq", "pub fn other() -> u32 { ret 1 }")
    database.semantic_body(id)
    if !assert(database.semantic_body_count(id) == 1_usize) { ret 4_u32 }
    database.set_module("dep", "dep.enq", "pub fn existing() -> u32 { ret 2 }")
    database.semantic_body(id)
    if !assert(database.semantic_body_count(id) == 1_usize) { ret 8_u32 }
    database.set_module("dep", "dep.enq", "pub fn added() -> str { ret \"ready\" }")
    let updated = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(updated.binding_type("value").unwrap_or("") == "str") { ret 2_u32 }
    if !assert(database.semantic_body_count(id) == 2_usize) { ret 3_u32 }
    let mut fields = AnalysisDatabase::new()
    fields.set_module("dep", "dep.enq", "pub struct Data {}")
    fields.set_module("app", "app.enq", "import dep::Data\nfn sample(data: Data) { let value = data.added\n value\n}")
    let field_id = fields.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    fields.semantic_body(field_id)
    fields.semantic_body(field_id)
    if !assert(fields.semantic_body_count(field_id) == 1_usize) { ret 5_u32 }
    fields.set_module("dep", "dep.enq", "pub struct Data { added: u64 }")
    let added = fields.semantic_body(field_id).unwrap_or(SemanticBody::empty())
    if !assert(added.binding_type("value").unwrap_or("") == "u64") { ret 6_u32 }
    if !assert(fields.semantic_body_count(field_id) == 2_usize) { ret 7_u32 }
    let mut methods = AnalysisDatabase::new()
    methods.set_module("dep", "dep.enq", "pub struct Data {}")
    methods.set_module("app", "app.enq", "import dep::Data\nfn sample(data: Data) { let value = data.added()\n value\n}")
    let method_id = methods.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    methods.semantic_body(method_id)
    methods.set_module("dep", "dep.enq", "pub struct Data {}\nimpl for Data { pub fn added(self) -> str { ret \"ready\" } }")
    let added_method = methods.semantic_body(method_id).unwrap_or(SemanticBody::empty())
    if !assert(added_method.binding_type("value").unwrap_or("") == "str") { ret 9_u32 }
    ret 0_u32
}
