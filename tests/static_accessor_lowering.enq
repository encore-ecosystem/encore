//! Static accessors preserve the value's complete memory representation.
import std::io::eprintln
import ehirlib::{parse_module_text, validate_module}

import refrain::frontend::translator::static_value::{static_accessor, static_runtime_declarations}

fn main() -> u32 {
    for typ in vec!["u32", "str", "u8*", "Service<H>", "Service", "()"] {
        let owns = typ == "str" || typ == "Service<H>" || typ == "Service"
        let source = "struct Service {\n  label: str\n}\n" +
        "extern fn initialize() -> " + typ + "\n" + static_runtime_declarations().finish() +
        static_accessor("STATIC", "initialize", typ, owns).finish()
        match validate_module(parse_module_text("static-storage", source)) {
            Ok(_) => {
            }
            Err(error) => {
                eprintln(error) ret 1
            }
        }
    }
    ret 0
}
