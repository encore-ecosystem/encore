//! User iterators, distinct source/iterator generics, and owning item lifetimes.
import core::iter::{Iterator, IntoIterator, enumerate}
import core::option::Option
import core::vec::Vec
extern fn encore_node_debug_live_count() -> usize

struct Countdown {
    value: usize
}
impl Iterator[usize] for Countdown {
    fn next(self: Self) ->(Self, Option[usize]) {
        if self.value == 0 {
            ret(self, Option[usize]::None)
        }
        ret(Self {
                self.value - 1
            }
            , Option[usize]::Some(self.value),)
    }
}
struct Rows[T] {
    values: Vec[T]
}
struct Cursor[T] {
    values: Vec[T] index: usize
}
struct Tagged[T, Tag] {
    values: Vec[T] tag: Tag
}
impl[T, Tag] IntoIterator[T, Cursor[T]] for Tagged[T, Tag] {
    fn into_iter(self: Self) -> Cursor[T] {
        ret Cursor[T] {
            self.values, 0
        }
    }
}
impl[T] IntoIterator[T, Cursor[T]] for Rows[T] {
    fn into_iter(self: Self) -> Cursor[T] {
        ret Cursor[T] {
            self.values, 0
        }
    }
}
impl[T] Iterator[T] for Cursor[T] {
    fn next(self: Self) ->(Self, Option[T]) {
        ret(Self {
                self.values, self.index + 1
            }
            , self.values.get(self.index),)
    }
}
fn total[I: Iterator[usize]](iter: I) -> usize {
    let mut sum = 0_usize
    for value in iter {
        sum += value
    }
    ret sum
}
fn enumerated[I: Iterator[usize]](iter: I) -> usize {
    let mut sum = 0_usize
    for pair in enumerate[usize, I](iter) {
        sum += pair.1
    }
    ret sum
}
fn first(rows: Rows[str]) -> str {
    for value in rows {
        ret value
    }
    ret ""
}
fn generic_collection[Items: IntoIterator[str, Iter], Iter: Iterator[str]](rows: Items) -> usize {
    let mut count = 0_usize
    for value in rows {
        count += value.len()
    }
    ret count
}
fn owned_pass() -> usize {
    let mut values = Vec[str]::new()
    values.push("iteration " + "payload")
    let rows = Rows[str] {
        values
    }
    let mut length = 0_usize
    for value in rows {
        length += value.len()
    }
    ret length
}
fn temporary_rows() -> Rows[str] {
    let mut values = Vec[str]::new()
    values.push("temporary " + "item")
    ret Rows[str] {
        values
    }
}
fn temporary_first() -> str {
    for value in temporary_rows() {
        ret value
    }
    ret ""
}
fn main() -> u32 {
    owned_pass()
    let before = unsafe {
        encore_node_debug_live_count()
    }
    for index in 0..100 {
        if owned_pass() != 17 {
            ret 9
        }
        if temporary_first() != "temporary item" {
            ret 12
        }
    }
    let after = unsafe {
        encore_node_debug_live_count()
    }
    if before != after {
        ret 10
    }
    let four = Countdown {
        4
    }
    if total(four) != 10 {
        ret 1
    }
    if enumerated(four) != 10 {
        ret 11
    }
    let mut sum = 0_usize
    let five = Countdown {
        5
    }
    for value in five {
        if value == 4 {
            continue
        }
        if value == 1 {
            break
        }
        sum += value
    }
    if sum != 10 {
        ret 2
    }
    let mut values = Vec[str]::new()
    values.push("owned " + "first")
    values.push("second")
    let rows = Rows[str] {
        values
    }
    if first(rows) != "owned first" {
        ret 3
    }
    let mut count = 0_usize
    for value in rows {
        if value.len() == 0 {
            ret 4
        }
        count += 1
    }
    if count != 2 || values.len() != 2 {
        ret 5
    }
    let tag = 7_u32
    let tagged = Tagged[str, u32] {
        values, tag
    }
    let mut tagged_count = 0_usize
    for value in tagged {
        tagged_count += 1
    }
    if tagged_count != 2 {
        ret 6
    }
    if generic_collection[Rows[str], Cursor[str]](rows) != 17 {
        ret 8
    }
    let empty = Countdown {
        0
    }
    for value in empty {
        ret 7
    }
    ret 0
}
