//! Verifies lossless syntax and deterministic formatting queries.

import core::testing::assert
import refrain::formatter::{FormatConfig, format_source}
import refrain::frontend::{AnalysisDatabase, SyntaxDocument}

fn main() -> u32 {
    let source = "//! Module docs.\r\n/// Adds values.\r\nfn add(lhs:u32,rhs:u32)->u32{ret lhs+rhs}\r\n"
    let syntax = SyntaxDocument::parse(source)
    if !assert(syntax.is_valid()) { ret 1_u32 }
    if !assert(syntax.text() == source) { ret 2_u32 }
    if !assert(syntax.reconstructed_text() == source) { ret 3_u32 }

    let result = format_source(source, FormatConfig::new())
    if !assert(result.is_valid()) { ret 4_u32 }
    if !assert(result.is_changed()) { ret 5_u32 }
    let expected = "//! Module docs.\n/// Adds values.\nfn add(lhs: u32, rhs: u32) -> u32 {\n    ret lhs + rhs\n}\n"
    if !assert(result.text() == expected) { ret 6_u32 }

    let repeated = format_source(result.text(), FormatConfig::new())
    if !assert(repeated.is_valid()) { ret 7_u32 }
    if !assert(!repeated.is_changed()) { ret 8_u32 }
    if !assert(repeated.text() == expected) { ret 9_u32 }

    let fluent = "fn view() -> Widget {\n    ret Widget::label(\"Settings persistence comes with workspace state.\").with_flex(44.0_f32, 0.0_f32).with_style(Style::default().with_foreground(muted()))\n}\n"
    let fluent_result = format_source(fluent, FormatConfig::new())
    if !assert(fluent_result.is_valid()) { ret 20_u32 }
    let fluent_repeated = format_source(fluent_result.text(), FormatConfig::new())
    if !assert(fluent_repeated.is_valid()) { ret 21_u32 }
    if !assert(!fluent_repeated.is_changed()) { ret 22_u32 }

    let invalid = "fn broken( {\n"
    let rejected = format_source(invalid, FormatConfig::new())
    if !assert(!rejected.is_valid()) { ret 10_u32 }
    if !assert(!rejected.is_changed()) { ret 11_u32 }
    if !assert(rejected.text() == invalid) { ret 12_u32 }

    let mut database = AnalysisDatabase::new()
    database.set_module("fixture", "fixture.enq", source)
    if !assert(database.module_syntax_count("fixture") == 0_usize) { ret 13_u32 }
    match database.syntax_document("fixture") {
        Option::Some(cached) => {
            if !assert(cached.reconstructed_text() == source) { ret 14_u32 }
        }
        Option::None => { ret 15_u32 }
    }
    if !assert(database.module_syntax_count("fixture") == 1_usize) { ret 16_u32 }
    let _again = database.syntax_document("fixture")
    if !assert(database.module_syntax_count("fixture") == 1_usize) { ret 17_u32 }
    database.set_module("fixture", "fixture.enq", expected)
    if !assert(database.module_syntax_count("fixture") == 1_usize) { ret 18_u32 }
    let _updated = database.syntax_document("fixture")
    if !assert(database.module_syntax_count("fixture") == 2_usize) { ret 19_u32 }

    let grouped_imports =
        "import refrain::layout::{WidgetLayout, LayoutTree}\n" +
        "import std::os::{file_exists, read_file}\n" +
        "import refrain::font::FontManager\n\n" +
        "fn imports_compile() -> bool { ret true }\n"
    let grouped_result = format_source(grouped_imports, FormatConfig::new())
    if !assert(grouped_result.is_valid()) { ret 23_u32 }
    if !assert(grouped_result.text().contains("import std::os::")) { ret 24_u32 }
    if !assert(grouped_result.text().contains("import refrain::font::FontManager\n")) { ret 25_u32 }
    if !assert(!grouped_result.text().contains("    import ")) { ret 29_u32 }
    let grouped_syntax = SyntaxDocument::parse(grouped_result.text())
    if !assert(grouped_syntax.is_valid()) { ret 26_u32 }
    let grouped_repeated = format_source(grouped_result.text(), FormatConfig::new())
    if !assert(grouped_repeated.is_valid()) { ret 27_u32 }
    if !assert(!grouped_repeated.is_changed()) { ret 28_u32 }

    let decorator =
        "#attr(decorator)\n" +
        "fn profile[Args](func:Callable[Args,u32],args:Args,label:str)->u32{ret func(args)}\n" +
        "@profile(\"draw_frame\")\n" +
        "fn draw_frame(value:u32)->u32{ret value}\n"
    let decorator_result = format_source(decorator, FormatConfig::new())
    if !assert(decorator_result.is_valid()) { ret 30_u32 }
    if !assert(decorator_result.text().contains("#attr(decorator)\n")) { ret 31_u32 }
    if !assert(decorator_result.text().contains("@profile(\"draw_frame\")\n")) { ret 32_u32 }
    let decorator_repeated = format_source(decorator_result.text(), FormatConfig::new())
    if !assert(decorator_repeated.is_valid()) { ret 33_u32 }
    if !assert(!decorator_repeated.is_changed()) { ret 34_u32 }

    let multiline_imports =
        "import refrain::frontend::{\n" +
        "    DiagnosticLabelKind, FrontendDocument\n" +
        "}\n" +
        "import refrain::frontend::parser::Documentation\n\n" +
        "fn imports_stay_top_level() -> bool { ret true }\n"
    let multiline_result = format_source(multiline_imports, FormatConfig::new())
    if !assert(multiline_result.is_valid()) { ret 35_u32 }
    if !assert(!multiline_result.text().contains("    import ")) { ret 36_u32 }
    if !assert(multiline_result.text().contains(
        "import refrain::frontend::{DiagnosticLabelKind, FrontendDocument}\n"
    )) { ret 39_u32 }
    let multiline_repeated = format_source(multiline_result.text(), FormatConfig::new())
    if !assert(multiline_repeated.is_valid()) { ret 37_u32 }
    if !assert(!multiline_repeated.is_changed()) { ret 38_u32 }
    ret 0_u32
}
