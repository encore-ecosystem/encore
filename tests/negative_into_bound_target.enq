// @expect.compile_error=generic-bound-not-satisfied
import core::convert::{From, Into}
struct UserId { value: u32 }
impl From[u32] for UserId { fn from(value: u32) -> Self { ret Self{value} } }
fn convert[S: Into[T], T](value: S) -> T { ret value.into() }
fn main() -> u32 { let invalid: str = convert[u32, str](1_u32) ret 0_u32 }
