import core::future::{Context, Future, Poll}
import std::future::block_on

struct Once {
    pending: bool
    value: u32
}

impl Future[u32] for Once {
    fn poll(self: Once, context: Context) -> Poll[Once, u32] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, u32]::Pending(Once{false, self.value})
        }
        ret Poll[Once, u32]::Ready(self.value)
    }
}

async fn yield_value(value: u32) -> u32 {
    ret await Once{true, value}
}

async fn sum_values() -> u32 {
    let mut index = 0_u32
    let mut total = 0_u32
    while index < 3_u32 {
        total = total + await yield_value(index + 1_u32)
        index = index + 1_u32
    }
    ret total
}

fn main() -> u32 {
    let pending = sum_values()
    let value = block_on[u32, __encore_future_sum_values](pending)
    if value == 6_u32 { ret 0_u32 }
    ret 1_u32
}
