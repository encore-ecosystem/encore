// @expect.compile_error=is not available through frozen region 'holder'
import core::vec::Vec

struct Holder {
    values: Vec[str]
}

impl for Holder {
    fn attach(self: mut Holder, values: Vec[str]) -> () {
        self.values = values
        ret()
    }
}

fn inspect(values: frozen Vec[str]) -> usize {
    ret values.len()
}

fn main() -> u32 {
    let mut holder = Holder{Vec[str]::new()}
    let values = Vec[str]::new()
    holder.attach(values)
    let count = inspect(values)
    holder.values.push("late mutation")
    ret count as u32
}
