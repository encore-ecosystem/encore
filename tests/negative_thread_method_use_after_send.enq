// @expect.compile_error=unknown variable 'values'
import core::vec::Vec

struct Consumer {}

impl for Consumer {
    fn consume(self: Consumer, values: sending Vec[str]) -> usize {
        ret values.len()
    }
}

fn main() -> u32 {
    let values = Vec[str]::new()
    let count = Consumer{}.consume(values)
    ret (count + values.len()) as u32
}
