// @expect.compile_error=cannot assign through immutable path 'counter'

struct Counter {
    value: u32
}
trait Writer {
    fn write(self: Self, value: u32) -> u32
}

fn main() -> u32 {
    let mut counter = Counter<H>{ 0 }
    let writer: dyn Writer = | value | {
        counter.value = value ret value
    }
    ret writer.write(42)
}
