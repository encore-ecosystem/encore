//! Unit remains zero-sized data in generic aggregates while calls keep a void ABI.
import core::vec::Vec
struct Packet[T] {
    value: T
    sequence: u32
}
struct Counter {
    value: u32
}
fn touch(counter: mut Counter) ->() {
    counter.value += 1_u32
}
fn pair[T](value: T) ->(u32, T) {
    ret(42_u32, value)
}
fn unit_worker(value:(), answer: u32) -> u32 {
    ret answer
}
fn main() -> u32 {
    let mut counter = Counter { 0_u32 }
    let tuple = pair[()](touch(counter))
    let packet = Packet[()] {(), 7_u32 }
    let empty:[();
        2] =[();
        2]
    let mut units = Vec[()]::new()
    units.push(touch(counter))
    if units.pop().is_none() || units.len() != 0_usize {
        ret 1_u32
    }
    let worker = spawn unit_worker(touch(counter), 7_u32)
    if worker.join() != 7_u32 {
        ret 3_u32
    }
    let ignored = tuple.1
    let other = packet.value
    ret if tuple.0 == 42_u32 && packet.sequence == 7_u32 && counter.value == 3_u32 {
        0_u32
    } else {
        2_u32
    }
}
