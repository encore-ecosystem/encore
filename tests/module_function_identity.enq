import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::{
    TranslationModule, translate_modules_to_ehir, translate_modules_to_ehir_bundle,
    translate_modules_to_ehir_bundle_typed
}
import refrain::target::host_target

fn main() -> u32 {
    let mut lexer_a = Lexer::new()
    let mut parser_a = Parser::new_for_source("alpha.enq")
    let ast_a = parser_a.parse(lexer_a.tokenize(
            "fn label() -> u32 { ret 11_u32 }\n" +
            "pub fn collision() -> u32 { ret 33_u32 }\n" +
            "struct Bucket[T] { value: T }\n" +
            "struct Vec[T] { value: T }\n" +
            "fn number(value: f32, next: usize, valid: bool) -> f32 { ret value }\n" +
            "fn append[T](left: Vec[T], right: Vec[T]) -> Vec[T] { ret left }\n" +
            "fn singleton[T](value: T) -> Bucket[T] { ret Bucket[T]{value} }\n" +
            "fn alpha_value() -> u32 { let parsed = number(1.5_f32, 0_usize, true) let values = singleton(\"ok\") ret label() }"))
    let mut lexer_b = Lexer::new()
    let mut parser_b = Parser::new_for_source("beta.enq")
    let ast_b = parser_b.parse(lexer_b.tokenize(
            "import alpha::{collision}\nimport gamma::{append}\n" +
            "fn label() -> u32 { ret 22_u32 }\nfn number(value: str) -> str { ret value }\n" +
            "fn beta_value(values: Vec[u32]) -> u32 { let value = number(\"ok\") let combined = append(values, values) let selected = collision() ret label() }"))
    let mut lexer_c = Lexer::new()
    let mut parser_c = Parser::new_for_source("gamma.enq")
    let ast_c = parser_c.parse(lexer_c.tokenize(
            "pub fn collision() -> u32 { ret 44_u32 }\n" +
            "fn append[T](left: Vec[T], right: Vec[T]) -> Vec[T] { ret right }"))

    let mut alpha_imports = Vec[str]::new()
    let mut beta_imports = Vec[str]::new()
    beta_imports.push("alpha")
    beta_imports.push("gamma")
    let mut gamma_imports = Vec[str]::new()
    let mut modules = Vec[TranslationModule]::new()
    modules.push(TranslationModule::new("alpha", "alpha.enq", alpha_imports, ast_a, Vec[str]::new()))
    modules.push(TranslationModule::new("beta", "beta.enq", beta_imports, ast_b, Vec[str]::new()))
    modules.push(TranslationModule::new("gamma", "gamma.enq", gamma_imports, ast_c, Vec[str]::new()))
    let output = translate_modules_to_ehir(modules, host_target())
    let alpha = "__encore_m616c706861__"
    let beta = "__encore_m62657461__"
    let gamma = "__encore_m67616d6d61__"
    if !output.contains("fn " + alpha + "label() -> u32") {
        ret 1_u32
    }
    if !output.contains("fn " + beta + "label() -> u32") {
        ret 2_u32
    }
    if !output.contains("call " + alpha + "label(") {
        ret 3_u32
    }
    if !output.contains("call " + beta + "label(") {
        ret 4_u32
    }
    if !output.contains("call " + alpha + "number(") {
        ret 5_u32
    }
    if !output.contains("call " + beta + "number(") {
        ret 6_u32
    }
    if !output.contains("call " + alpha + "singleton[str](") {
        ret 7_u32
    }
    if !output.contains("call " + gamma + "append[u32](") {
        ret 8_u32
    }
    if !output.contains("call " + alpha + "collision(") ||
    output.contains("call " + gamma + "collision(") {
        ret 14_u32
    }
    let bundle = translate_modules_to_ehir_bundle(modules, host_target(), "beta")
    if !bundle.contains("entry beta") {
        ret 11_u32
    }
    if !bundle.contains("module beta {") {
        ret 12_u32
    }
    if !bundle.contains("import alpha") {
        ret 13_u32
    }
    let mut reordered = Vec[TranslationModule]::new()
    reordered.push(TranslationModule::new("gamma", "gamma.enq", gamma_imports, ast_c, Vec[str]::new()))
    reordered.push(TranslationModule::new("alpha", "alpha.enq", alpha_imports, ast_a, Vec[str]::new()))
    reordered.push(TranslationModule::new("beta", "beta.enq", beta_imports, ast_b, Vec[str]::new()))
    let reordered_output = translate_modules_to_ehir(reordered, host_target())
    if !reordered_output.contains("fn " + alpha + "label() -> u32") {
        ret 9_u32
    }
    if !reordered_output.contains("fn " + beta + "label() -> u32") {
        ret 10_u32
    }
    let mut typed_lexer = Lexer::new()
    let mut typed_parser = Parser::new_for_source("typed.enq")
    let typed_ast = typed_parser.parse(typed_lexer.tokenize("fn answer() -> u32 { ret 42_u32 }"))
    let mut typed_modules = Vec[TranslationModule]::new()
    typed_modules.push(TranslationModule::new("typed", "typed.enq", Vec[str]::new(), typed_ast, Vec[str]::new()))
    let typed_bundle = translate_modules_to_ehir_bundle_typed(typed_modules, host_target(), "typed")
    if typed_bundle.entry_module != "typed" || typed_bundle.modules.len() != 1_usize {
        ret 15_u32
    }
    // Workspace discovery and the parser can spell the same Windows source
    // with different separators. Methods must still use the stable module
    // identity for both their definitions and call sites.
    let mut windows_lexer = Lexer::new()
    let mut windows_parser = Parser::new_for_source("D:\\a\\project\\src\\counter.enq")
    let windows_ast = windows_parser.parse(windows_lexer.tokenize(
        "struct Counter { value: u32 }\n" +
        "impl for Counter { fn read(self: Self) -> u32 { ret self.value } }\n" +
        "fn inspect(value: Counter) -> u32 { ret value.read() }"))
    let mut windows_modules = Vec[TranslationModule]::new()
    windows_modules.push(TranslationModule::new(
        "windows-module", "D:/a/project/src/counter.enq", Vec[str]::new(), windows_ast,
        Vec[str]::new()))
    let windows_output = translate_modules_to_ehir(windows_modules, host_target())
    let windows_prefix = "__encore_m77696e646f77732d6d6f64756c65__"
    if !windows_output.contains(windows_prefix) || !windows_output.contains("read(") {
        ret 16_u32
    }
    if windows_output.contains("__encore_m443a") { ret 17_u32 }
    ret 0_u32
}
