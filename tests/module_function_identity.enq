import core::fmt::Debug
import std::dict::Hashable
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let mut lexer_a = Lexer::new()
    let mut parser_a = Parser::new_for_source("alpha.enq")
    let mut ast = parser_a.parse(lexer_a.tokenize(
        "fn label() -> u32 { ret 11_u32 }\n" +
        "struct Bucket[T] { value: T }\n" +
        "fn number(value: f32, next: usize, valid: bool) -> f32 { ret value }\n" +
        "fn singleton[T](value: T) -> Bucket[T] { ret Bucket[T]{value} }\n" +
        "fn alpha_value() -> u32 { let parsed = number(1.5_f32, 0_usize, true) let values = singleton(\"ok\") ret label() }"))
    let mut lexer_b = Lexer::new()
    let mut parser_b = Parser::new_for_source("beta.enq")
    ast.extend(parser_b.parse(lexer_b.tokenize(
        "fn label() -> u32 { ret 22_u32 }\nfn number(value: str) -> str { ret value }\n" +
        "fn beta_value() -> u32 { let value = number(\"ok\") ret label() }")))

    let output = translate_to_ehir(ast)
    let alpha = "__encore_m" + Debug::fmt("alpha.enq".hash()) + "__"
    let beta = "__encore_m" + Debug::fmt("beta.enq".hash()) + "__"
    if !output.contains("fn " + alpha + "label() -> u32") { ret 1_u32 }
    if !output.contains("fn " + beta + "label() -> u32") { ret 2_u32 }
    if !output.contains("call " + alpha + "label(") { ret 3_u32 }
    if !output.contains("call " + beta + "label(") { ret 4_u32 }
    if !output.contains("call " + alpha + "number(") { ret 5_u32 }
    if !output.contains("call " + beta + "number(") { ret 6_u32 }
    if !output.contains("call " + alpha + "singleton[str](") { ret 7_u32 }
    ret 0_u32
}
