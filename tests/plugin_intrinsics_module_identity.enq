//! Internal SDK helper names must not intercept ordinary user functions.
import std::plugin::Plugin

fn __function_address(value: usize) -> usize {
    ret value
}
fn __resource_create[Interface, Value](value: usize) -> usize {
    ret value + 1_usize
}
fn __validate_implementation[Interface, Value]() -> usize {
    ret 9_usize
}
fn main() -> u32 {
    if __function_address(7_usize) != 7_usize {
        ret 1
    }
    if __resource_create[u32, str](7_usize) != 8_usize {
        ret 2
    }
    if __validate_implementation[u32, str]() != 9_usize {
        ret 3
    }
    ret 0
}
