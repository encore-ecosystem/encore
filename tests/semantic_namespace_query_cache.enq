//! Namespace misses and aliases must expire after source or resolution changes.
import core::testing::assert
import std::vec::Vec
import refrain::frontend::{AnalysisDatabase, ModuleImportTarget, SemanticBody, SymbolId}

fn value(database: mut AnalysisDatabase) -> str {
    let body = database.semantic_body(database.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    ret body.binding_type("value").unwrap_or("")
}
fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("provider::tools", "provider.enq", "pub fn original() -> u32 { ret 1_u32 }\n")
    database.set_module("replacement::tools", "replacement.enq", "pub fn original() -> str { ret \"value\" }\n")
    database.set_module("app", "app.enq", "fn sample() { let value = service::original() }\n")
    if !assert(value(database) == "") { ret 1_u32 }
    database.set_module("app", "app.enq", "import provider::tools as service\nfn sample() { let value = service::original() }\n")
    if !assert(value(database) == "u32") { ret 2_u32 }
    database.set_module_import_targets("app", vec![ModuleImportTarget { "provider::tools", "replacement::tools" }])
    if !assert(value(database) == "str") { ret 3_u32 }
    database.set_module("app", "app.enq", "fn sample() { let value = service::original() }\n")
    if !assert(value(database) == "") { ret 4_u32 }
    ret 0_u32
}
