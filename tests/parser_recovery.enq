//! Parser errors must be values, including during incremental editor input.

import core::result::Result
import core::testing::assert
import core::vec::Vec
import refrain::frontend::{Lexer, Parser, Statement, Expr, ParseFailure}

fn main() -> u32 {
    let valid = "fn main() -> u32 { let a = 52 ret a }"
    let mut end = 0_usize
    while end <= valid.char_len() {
        let mut lexer = Lexer::new()
        let mut parser = Parser::new()
        let result = parser.parse_result(lexer.tokenize(valid.slice(0_usize, end)))
        let _partial = parser.parse_recovering(lexer.tokenize(valid.slice(0_usize, end)))
        if end == valid.char_len() {
            match result {
                Result[Vec[Statement], ParseFailure]::Ok(statements) => {
                    if !assert(statements.len() == 1_usize) {
                        ret 1_u32
                    }
                }
                Result[Vec[Statement], ParseFailure]::Err(_) => {
                    ret 2_u32
                }
            }
        }
        end += 1_usize
    }
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("broken.enq")
    match parser.parse_result(lexer.tokenize("i")) {
        Result[Vec[Statement], ParseFailure]::Ok(_) => {
            ret 3_u32
        }
        Result[Vec[Statement], ParseFailure]::Err(failure) => {
            if !assert(failure.source_name == "broken.enq" && failure.line == 0_usize) {
                ret 4_u32
            }
        }
    }
    // The same instance remains reusable after an error.
    match parser.parse_result(lexer.tokenize(valid)) {
        Result[Vec[Statement], ParseFailure]::Ok(statements) => {
            if !assert(statements.len() == 1_usize) {
                ret 5_u32
            }
        }
        Result[Vec[Statement], ParseFailure]::Err(_) => {
            ret 6_u32
        }
    }
    let partial = parser.parse_recovering(lexer.tokenize(
            "fn broken() -> u32 { let a =\nlet b = 1 ret b }\nfn good() -> u32 { ret 2 }"))
    if !assert(partial.failures.len() > 0_usize && partial.statements.len() == 2_usize) {
        ret 7_u32
    }
    let recovered = parser.parse_recovering(lexer.tokenize("i\nfn good() -> u32 { ret 2 }"))
    if !assert(recovered.failures.len() == 1_usize && recovered.statements.len() == 1_usize) {
        ret 8_u32
    }
    let unfinished = parser.parse_recovering(lexer.tokenize("fn editing() { let value = 1_u32\nvalue."))
    if !assert(unfinished.failures.len() > 0_usize && unfinished.statements.len() == 1_usize) {
        ret 9_u32
    }
    for statement in unfinished.statements {
        match statement {
            Statement::Function(item) => {
                match item.body {
                    Some(body) => {
                        if !assert(body.statements.len() == 2_usize) {
                            ret 10_u32
                        }
                        match body.statements.get(1_usize) {
                            Some(statement) => {
                                match statement {
                                    Statement::Expr(expr) => {
                                        match expr.value {
                                            Expr::Field(field) => {
                                                if !assert(field.field == "" && expr.line == 1_usize && expr.column == 6_usize) {
                                                    ret 13_u32
                                                }
                                                match field.base.value {
                                                    Expr::Path(name) => {
                                                        if !assert(name == "value") {
                                                            ret 14_u32
                                                        }
                                                    }
                                                    _ => {
                                                        ret 15_u32
                                                    }
                                                }
                                            }
                                            _ => {
                                                ret 16_u32
                                            }
                                        }
                                    }
                                    _ => {
                                        ret 19_u32
                                    }
                                }
                            }
                            _ => {
                                ret 17_u32
                            }
                        }
                    }
                    None => {
                        ret 11_u32
                    }
                }
            }
            _ => {
                ret 12_u32
            }
        }
    }
    match parser.parse_result(lexer.tokenize("fn editing() { value. }")) {
        Result[Vec[Statement], ParseFailure]::Ok(_) => {
            ret 18_u32
        }
        Result[Vec[Statement], ParseFailure]::Err(_) => {
        }
    }
    let mut calls = Vec[str]::new()
    calls.push("fn editing() { value.read(")
    calls.push("fn editing() { value.read(1, ")
    calls.push("fn editing() { value.read(1 +")
    for source in calls {
        match parser.parse_result(lexer.tokenize(source)) {
            Result[Vec[Statement], ParseFailure]::Ok(_) => { ret 20_u32 }
            Result[Vec[Statement], ParseFailure]::Err(_) => {}
        }
        let report = parser.parse_recovering(lexer.tokenize(source))
        if !assert(report.failures.len() > 0_usize && report.statements.len() == 1_usize) { ret 21_u32 }
        for statement in report.statements {
            match statement {
                Statement::Function(item) => {
                    match item.body {
                        Some(body) => {
                            if !assert(body.statements.len() == 1_usize) { ret 22_u32 }
                            for statement in body.statements {
                                match statement {
                                    Statement::Expr(expr) => {
                                        match expr.value {
                                            Expr::MethodCall(call) => {
                                                if !assert(call.method == "read") { ret 23_u32 }
                                            }
                                            _ => { ret 24_u32 }
                                        }
                                    }
                                    _ => { ret 25_u32 }
                                }
                            }
                        }
                        None => { ret 26_u32 }
                    }
                }
                _ => { ret 27_u32 }
            }
        }
    }
    ret 0_u32
}
