fn quadrant(level: u32, depth: usize, x: u32, y: u32) -> usize {
    let index = if depth == 0_usize {
        0_usize
    } else {
        let shift = level - depth as u32
        (((y >> shift) & 1_u32) * 2_u32 +((x >> shift) & 1_u32)) as usize
    }
    ret index
}

fn main() -> u32 {
    ret if quadrant(2_u32, 1_usize, 2_u32, 3_u32) == 3_usize {
        0_u32
    } else {
        1_u32
    }
}
