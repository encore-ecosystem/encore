//! A module import cannot shadow an explicit type binding or expose private names.
import core::option::Option
import core::testing::assert
import refrain::frontend::AnalysisDatabase
import refrain::frontend::hir::DefinitionNamespace

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("left", "left.enq", "pub struct Config { channels: str }")
    db.set_module("right", "right.enq", "pub struct Config { token: str }")
    for source in vec![
        "import right\nimport right::Config as OtherConfig\nimport left::Config\nfn read(config: Config, other: OtherConfig) -> str { ret config.channels + other.token }",
        "import left::Config\nimport right::Config as OtherConfig\nimport right\nfn read(config: Config, other: OtherConfig) -> str { ret config.channels + other.token }"
    ] {
        db.set_module("app", "app.enq", source)
        if !assert(db.module_semantic_diagnostics("app").is_empty()) {
            ret 1_u32
        }
    }
    db.set_module("bare", "bare.enq", "import right\nfn main() -> u32 { ret 0_u32 }")
    let map = match db.module_def_map("bare") {
        Option::Some(value) => value
        Option::None => {
            ret 2_u32
        }
    }
    if !assert(map.resolve("Config", DefinitionNamespace::Type).is_none()) {
        ret 2_u32
    }
    db.set_module("wildcard", "wildcard.enq", "import right::*\nfn read(config: Config) -> str { ret config.token }")
    if !assert(db.module_semantic_diagnostics("wildcard").is_empty()) {
        ret 3_u32
    }
    ret 0_u32
}
