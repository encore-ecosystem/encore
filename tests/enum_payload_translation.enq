//! Declared enum payloads provide context all the way down to their literals.
import ehirlib::{parse_module_text, prepare_module, PreparationOutcome}
import refrain::frontend::translator::translate_to_ehir
import refrain::frontend::{Lexer, Parser}

fn main() -> u32 {
    let source = "enum Maybe[Item] { Some(Item) None }\n"
    + "fn number() -> Maybe[f32] { ret Maybe[f32]::Some(1.25) }\n"
    + "fn negative() -> Maybe[f32] { ret Maybe[f32]::Some(-1.25) }\n"
    + "fn tuple() -> Maybe[(u8, f32)] { ret Maybe[(u8, f32)]::Some((42, 2.5)) }\n"
    + "fn array() -> Maybe[[u16; 2]] { ret Maybe[[u16; 2]]::Some([41, 42]) }\n"
    + "fn repeated() -> Maybe[[u16; 2]] { ret Maybe[[u16; 2]]::Some([42; 2]) }\n"
    + "fn unit() -> Maybe[()] { ret Maybe[()]::Some(()) }\n"
    + "fn bit() -> Maybe[u1] { ret Maybe[u1]::Some(true) }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if !output.contains("f32 = capprim 1.25_f32") || !output.contains("u8 = capprim 42_u8") {
        ret 1
    }
    if !output.contains("f32 = capprim 2.5_f32") || !output.contains("u16 = capprim 41_u16") {
        ret 2
    }
    if output.contains("f64 = capprim") || output.contains("usize = capprim 42_usize") {
        ret 3
    }
    ret match prepare_module(parse_module_text("enum_payload_translation", output)) {
        PreparationOutcome::Ready(_) => 0
        PreparationOutcome::Error(_) => 4
    }
}
