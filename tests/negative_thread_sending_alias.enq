// @expect.compile_error=live aliases reach its region
import core::vec::Vec

fn count(values: sending Vec[str]) -> usize {
    ret values.len()
}

fn main() -> u32 {
    let mut values = Vec[str]::new()
    values.push("alpha")
    let alias = values
    let worker = spawn count(values)
    ret (worker.join() + alias.len()) as u32
}
