//! #111: awaiting a generated future preserves its complete output and errors.
import core::future::{Context, Future, Poll}
import core::option::Option
import core::result::Result
import std::future::block_on

struct Once {
    pending: bool
}

impl Future[bool] for Once {
    fn poll(self: Self, context: Context) -> Poll[Self, bool] {
        if self.pending {
            context.waker.wake() ret Poll[Self, bool]::Pending(Once { false })
        }
        ret Poll[Self, bool]::Ready(true)
    }
}
async fn value(fail: bool) -> Result[bool, str] {
    let ready = await Once { true }
    ret if fail {
        Result[bool, str]::Err("expected error")
    } else {
        Result[bool, str]::Ok(ready)
    }
}
async fn direct(fail: bool) -> Result[bool, str] {
    ret await value(fail)
}
async fn bound(fail: bool) -> Result[bool, str] {
    let future = value(fail)
    let output: Result[bool, str] = await future
    ret output
}
async fn inferred(fail: bool) -> Result[bool, str] {
    let output = await value(fail) ret output
}
async fn tried(fail: bool) -> Result[bool, str] {
    let ready =(await value(fail))? ret Result::Ok(ready)
}
async fn optional() -> Option[u32] {
    ret Option[u32]::Some(42_u32)
}
struct Worker {
}

impl for Worker {
    async fn get(self: Self, fail: bool) -> Result[bool, str] {
        ret await value(fail)
    }
    async fn create(fail: bool) -> Result[bool, str] {
        ret await value(fail)
    }
}
async fn scenario(fail: bool) -> Result[bool, str] {
    let a = await direct(fail)
    let b = await bound(fail)
    let c = await inferred(fail)
    let d = await tried(fail)
    let worker = Worker {}
    let e = await worker.get(fail)
    let f = await Worker::create(fail)
    let maybe = await optional()
    if maybe.unwrap_or(0_u32) != 42_u32 {
        ret Result::Ok(false)
    }
    if fail {
        ret Result::Ok(a.unwrap_err_or("") == "expected error" && b.unwrap_err_or("") == "expected error" && c.unwrap_err_or("") == "expected error" && d.unwrap_err_or("") == "expected error" && e.unwrap_err_or("") == "expected error" && f.unwrap_err_or("") == "expected error")
    }
    ret Result::Ok(a.unwrap_or(false) && b.unwrap_or(false) && c.unwrap_or(false) && d.unwrap_or(false) && e.unwrap_or(false) && f.unwrap_or(false))
}
fn main() -> u32 {
    let success = block_on[Result[bool, str], __encore_future_scenario](scenario(false))
    let failure = block_on[Result[bool, str], __encore_future_scenario](scenario(true))
    ret if success.unwrap_or(false) && failure.unwrap_or(false) {
        0_u32
    } else {
        1_u32
    }
}
