//! Mutable capabilities preserve owning node ABI through calls and closures.

extern fn encore_node_debug_live_count() -> usize

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

struct Counter {
    value: u32
}

fn read_counter(counter: mut Counter<H>) -> u32 {
    ret counter.value
}

fn increment(counter: mut Counter<H>) -> u32 {
    counter.value += 1
    ret read_counter(counter)
}

trait Value {
    fn evaluate(self: Self) -> u32
}
struct Number {
}

impl Value for Number {
    fn evaluate(self: Self) -> u32 {
        ret 42
    }
}

struct BoundCounter {
    value: u32
    binding: dyn Value
}

impl for BoundCounter {
    fn refresh(self: mut Self&) -> u32 {
        self.value = self.binding.evaluate()
        ret self.value
    }
}

struct Boxed {
    value: u32
}

impl for Boxed {
    fn read(self: Self&) -> u32 {
        ret self.value
    }
}
struct Leaf {
    boxed: Boxed<H>
}

impl for Leaf {
    fn boxed(self: Self&) -> Boxed<H> {
        ret self.boxed
    }
}
struct Holder[T] {
    leaf: Leaf<H>
    value: T
}

impl[T] for Holder[T] {
    fn read(self: mut Self&) -> u32 {
        let boxed = self.leaf.boxed()
        let value = boxed.read()
        ret value + self.leaf.boxed().read()
    }
}

trait Reader {
    fn read(self: Self, counter: mut Counter&) -> u32
}
trait ConcreteReader {
    fn read(self: Self, counter: mut Counter<H>) -> u32
}
trait CapturedReader {
    fn read(self: Self, ignored: u32) -> u32
}

fn exercise() -> u32 {
    let mut bound = BoundCounter<H> {
        0, Number {} as dyn Value
    }
    if bound.refresh() != 42 {
        ret 1
    }
    let mut counter = Counter<H>{ 41 }
    if increment(counter) != 42 {
        ret 2
    }
    if counter.value != 42 {
        ret 3
    }

    let leaf = Leaf<H> {
        Boxed<H>{ 21 }
    }
    let mut holder = Holder[u32]<H> { leaf, 0 }
    if holder.read() != 42 {
        ret 4
    }

    let reader: dyn Reader = | value | value.value
    if reader.read(counter) != 42 {
        ret 5
    }
    let concrete: dyn ConcreteReader = | value | {
        value.value += 1 ret value.value
    }
    if concrete.read(counter) != 43 {
        ret 6
    }
    if counter.value != 43 {
        ret 7
    }

    let captured: dyn CapturedReader = | ignored | counter.value
    counter = Counter<H>{ 99 }
    if captured.read(0) != 43 {
        ret 8
    }
    if counter.value != 99 {
        ret 9
    }
    ret 0
}

fn main() -> u32 {
    let before = live_nodes()
    let mut iteration = 0
    while iteration < 16 {
        let status = exercise()
        if status != 0 {
            ret status
        }
        if live_nodes() != before {
            ret 10
        }
        iteration += 1
    }
    ret 0
}
