//! Normal lowering must construct the typed graph without a text round trip.
import core::testing::assert
import std::vec::Vec
import ehirlib::{Directive, module_bundle_to_string, parse_module_bundle_text}
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::{TranslatedModuleChunk, TranslationModule, assemble_typed_ehir_module_bundle, translate_modules_to_ehir_bundle_typed, translate_selected_modules_to_ehir_chunks}
import refrain::target::host_target

extern fn ehir_debug_bundle_parse_count() -> usize
extern fn ehir_debug_reset_bundle_parse_count() -> ()

fn main() -> u32 {
    let source = "struct Data { value: u32 }\nimpl for Data { pub fn read(self: Self) -> u32 { ret self.value } }\n" +
        "fn calculate(value: Data) -> u32 { let mut result = value.read() while result < 4_u32 { result += 1_u32 } ret result }\n" +
        "enum Choice { Some(u32) None }\nfn choose(value: Choice) -> u32 { let result = match value { Some(item) => item + 1_u32 None => 0_u32 } ret result }\n" +
        "fn text(flag: bool) -> str { let result = if flag { \"yes\" } else { \"no\" } ret result }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("direct.enq")
    let modules = vec![TranslationModule::new("direct@lib.enq", "direct.enq", Vec[str]::new(),
        parser.parse(lexer.tokenize(source)), Vec[str]::new())]
    unsafe { ehir_debug_reset_bundle_parse_count() }
    let bundle = translate_modules_to_ehir_bundle_typed(modules, host_target(), "direct@lib.enq")
    if !assert(unsafe { ehir_debug_bundle_parse_count() } == 0_usize) { ret 1_u32 }
    if !assert(bundle.modules.len() == 1_usize && bundle.modules.get_unchecked_borrowed(0_usize).directives.len() >= 3_usize) { ret 2_u32 }
    let text = module_bundle_to_string(bundle)
    if !assert(!text.contains("_type_probe")) { ret 4_u32 }
    let parsed = parse_module_bundle_text("direct@lib.enq", text)
    if !assert(unsafe { ehir_debug_bundle_parse_count() } > 0_usize && module_bundle_to_string(parsed) == text) { ret 3_u32 }
    // Persistent caches retain their existing text format; only restored
    // records are decoded, while freshly lowered chunks remain typed.
    let chunks = translate_selected_modules_to_ehir_chunks(modules, host_target(), vec![0_usize])
    let cached = TranslatedModuleChunk::new(0_usize, chunks.get_unchecked_borrowed(0_usize).as_text())
    if !assert(module_bundle_to_string(assemble_typed_ehir_module_bundle(vec![cached], 1_usize, "direct@lib.enq")) ==
        module_bundle_to_string(assemble_typed_ehir_module_bundle(chunks, 1_usize, "direct@lib.enq"))) { ret 5_u32 }
    ret 0_u32
}
