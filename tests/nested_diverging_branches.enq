//! A nested all-diverging if must not synthesize an empty value-join block (#87).
import core::result::Result
fn read() -> Result[str, str] {
    ret Result::Err("disconnected")
}
fn reconnect() -> u32 {
    let mut attempt = 0_u32
    loop {
        let text = match read() {
            Result::Ok(value) => value
            Result::Err(error) => {
                let _error = error
                if attempt == 2 {
                    ret 0
                } else {
                    attempt += 1 continue
                }
            }
        }
        let _text = text
        ret 1
    }
}
fn numeric_hint() -> u32 {
    let mut count = 0_u32
    loop {
        let value: u32 = if count == 2 {
            break
        } else {
            count += 1 continue
        }
        ret value
    }
    ret count
}
fn main() -> u32 {
    if reconnect() != 0 || numeric_hint() != 2 {
        ret 1
    }
    ret 0
}
