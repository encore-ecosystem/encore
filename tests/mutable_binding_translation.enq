//! Ownership-bearing mutable locals get distinct slots even for a path RHS.
import ehirlib::{parse_module_text, prepare_module, PreparationOutcome}
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source = "import core::vec::Vec\nfn swap() { let mut first = Vec[u8]::new() let mut second = Vec[u8]::new() let mut saved = first first = second second = saved }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("mutable_binding_translation.enq")
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if !output.contains("_letvar_first_") || !output.contains("_letvar_second_") ||
    !output.contains("_letvar_saved_") {
        ret 1
    }
    let nodes = "struct Cell { value: u32 }\nfn copy() { let mut first = Cell<H>{1} let mut second = first let mut erased: Cell& = Cell<H>{2} let mut erased_copy = erased }\n"
    let node_output = translate_to_ehir(parser.parse(lexer.tokenize(nodes)))
    if !node_output.contains("_letvar_second_") || !node_output.contains("_letvar_erased_copy_") ||
    node_output.contains("salloc Cell&") {
        ret 2
    }
    if !node_output.contains("retain entry_let_handle_load_") {
        ret 3
    }
    match prepare_module(parse_module_text("mutable-node-bindings", node_output)) {
        PreparationOutcome::Ready(_) => {
        }
        PreparationOutcome::Error(_) => {
            ret 4
        }
    }
    ret 0
}
