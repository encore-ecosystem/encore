// @expect.compile_error=cannot pass frozen region 'values'
import core::vec::Vec

fn mutate(values: mut Vec[str]) -> () {
    values.push("forbidden")
    ret()
}

fn inspect(values: frozen Vec[str]) -> usize {
    mutate(values)
    ret values.len()
}

fn main() -> u32 {
    ret inspect(Vec[str]::new()) as u32
}
