//! Match payloads and arm-local declarations cannot escape into sibling/outer scopes (#88).
import core::option::Option
import core::result::Result

extern fn encore_node_debug_live_count() -> usize

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

// The issue's exact parameter-shadowing case.
fn length(value: str) -> usize {
    let count = match Option[usize]::Some(2) {
        Some(value) => value
        None => {
            ret 0
        }
    }
    ret value.byte_len() + count
}

fn siblings(value: str, present: bool) -> usize {
    let item = if present {
        Option[usize]::Some(2)
    } else {
        Option[usize]::None
    }
    let count = match item {
        Some(value) => value
        None => value.byte_len()
    }
    ret value.byte_len() + count
}

fn reversed(value: str, present: bool) -> usize {
    let item = if present {
        Option[usize]::Some(2)
    } else {
        Option[usize]::None
    }
    let count = match item {
        None => value.byte_len()
        Some(value) => value
    }
    ret value.byte_len() + count
}

fn statements(value: str, present: bool) -> usize {
    let item = if present {
        Option[usize]::Some(2)
    } else {
        Option[usize]::None
    }
    let mut count = 0_usize
    match item {
        Some(value) => {
            count = value
        }
        None => {
            count = value.byte_len()
        }
    }
    // The mutable count is still the outer slot; restoring lexical lookup
    // must not undo writes performed by the selected arm.
    ret value.byte_len() + count
}

fn nested(value: str) -> usize {
    let count = match Option[Option[usize]]::Some(Option[usize]::Some(2)) {
        Some(value) => {
            let inner = match value {
                Some(value) => value
                None => 0_usize
            }
            inner + value.unwrap_or(0)
        }
        None => value.byte_len()
    }
    ret value.byte_len() + count
}

fn local_declaration(value: str) -> usize {
    let count = match Option[usize]::Some(2) {
        Some(number) => {
            let value = number + 1 value
        }
        None => value.byte_len()
    }
    ret value.byte_len() + count
}

fn result_payload(value: str, success: bool) -> usize {
    let item = if success {
        Result[usize, str]::Ok(2)
    } else {
        Result[usize, str]::Err("error")
    }
    let count = match item {
        Result::Ok(value) => value
        Result::Err(value) => value.byte_len()
    }
    ret value.byte_len() + count
}

struct Entry {
    value: u32
}

fn mutable_outer(value: mut Entry&, present: bool) -> u32 {
    let item = if present {
        Option[usize]::Some(2)
    } else {
        Option[usize]::None
    }
    match item {
        Some(value) => {
        }
        None => {
        }
    }
    value.value += 1
    ret value.value
}

fn owning_payload(value: Entry<H>, present: bool) -> u32 {
    let item = if present {
        Option[Entry<H>]::Some(Entry<H>{ 7 })
    } else {
        Option[Entry<H>]::None
    }
    let picked = match item {
        Some(value) => value None => value
    }
    ret picked.value + value.value
}

fn string_payload(value: str, present: bool) -> str {
    let item = if present {
        Option[str]::Some("in" + "ner")
    } else {
        Option[str]::None
    }
    let picked = match item {
        Some(value) => value None => value
    }
    ret value + ":" + picked
}

fn exercise() -> u32 {
    if length("abc") != 5 {
        ret 1
    }
    for present in vec![true, false] {
        let expected = if present {
            5_usize
        } else {
            6_usize
        }
        if siblings("abc", present) != expected || reversed("abc", present) != expected ||
        statements("abc", present) != expected {
            ret 2
        }
        if result_payload("abc", present) != if present {
            5_usize
        } else {
            8_usize
        }
        {
            ret 3
        }
        if owning_payload(Entry<H>{ 13 }, present) != if present {
            20_u32
        } else {
            26_u32
        }
        {
            ret 4
        }
        if string_payload("out" + "er", present) != if present {
            "outer:inner"
        } else {
            "outer:outer"
        }
        {
            ret 5
        }
    }
    if nested("abc") != 7 || local_declaration("abc") != 6 {
        ret 6
    }
    let mut counter = Entry<H>{ 10 }
    if mutable_outer(counter, true) != 11 || mutable_outer(counter, false) != 12 || counter.value != 12 {
        ret 8
    }
    ret 0
}

fn main() -> u32 {
    let before = live_nodes()
    for _index in 0_usize..64_usize {
        let result = exercise()
        if result != 0 {
            ret result
        }
    }
    if live_nodes() != before {
        ret 7
    }
    ret 0
}
