//! Target selection and malformed metadata are checked before linking (#96).
import refrain::modes::build_scripts::parse_native_build_metadata
import refrain::target::parse_target
import std::path::Path
import core::vec::Vec
fn main() -> u32 {
    let source = "{\"native\":{\"libraries\":[{\"name\":\"linux_only\",\"cfg\":\"linux\"},{\"name\":\"windows_only\",\"cfg\":\"windows\"}],\"search_paths\":[\"native libs\"],\"frameworks\":[\"Network\"],\"link_args\":[\"-custom-flag\"]}}"
    let root = Path::new(".").resolve()
    let linux = parse_target("x86_64-unknown-linux-gnu")
    let windows = parse_target("x86_64-pc-windows-msvc")
    let mac = parse_target("aarch64-apple-darwin")
    let selected = match parse_native_build_metadata(source, root, linux, Vec[str]::new()) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let args = selected.link_arguments(linux)
    if args.len() != 3 || args.get(0).unwrap_or("") != "-L" + root.join("native libs").as_str() || args.get(1).unwrap_or("") != "-llinux_only" {
        ret 2
    }
    match parse_native_build_metadata(source, root, windows, Vec[str]::new()) {
        Ok(value) => {
            if value.link_arguments(windows).get(1).unwrap_or("") != "-lwindows_only" {
                ret 3
            }
        }
        Err(_) => {
            ret 4
        }
    }
    match parse_native_build_metadata(source, root, mac, Vec[str]::new()) {
        Ok(value) => {
            if value.link_arguments(mac).get(1).unwrap_or("") != "-framework" {
                ret 5
            }
        }
        Err(_) => {
            ret 6
        }
    }
    for invalid in vec!["{}", "{\"native\":[]}", "{\"native\":{\"libraries\":\"bad\"}}", "{\"native\":{\"libraries\":[{}]}}", "{\"native\":{\"libraries\":[{\"path\":\"does-not-exist.c\"}]}}"] {
        if parse_native_build_metadata(invalid, root, linux, Vec[str]::new()).is_ok() {
            ret 7
        }
    }
    ret 0
}
