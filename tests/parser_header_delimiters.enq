//! Delimited expressions suspend header ambiguity without leaking parser state.
import refrain::frontend::{Lexer, Parser}

fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    let prefix = "struct Value { number: u32 }\nfn test() {\n"
    for header in vec![
        "if accept(Value { 42 }) && flag { action() }",
        "while accept(Value<H>{ 42 }) && flag { break }",
        "if (Value { 42 }).number == 42 { action() }",
        "if accept((Value { 1 }, Value { 2 })) { action() }",
        "if accept([Value { 1 }, Value { 2 }]) { action() }",
        "if accept(vec![Value { 1 }, Value { 2 }]) { action() }",
        "match accept(Value { 42 }) { true => action() false => action() }",
        "match (Value { 42 }).number { 42 => action() _ => action() }",
        "if accept(if flag { Value { 42 } } else { Value { 0 } }) && flag { action() }",
        "if flag { action() } elif accept(Value { 42 }) { action() }",
    ] {
        let source = prefix + header + "\n}\n"
        if parser.parse_result(lexer.tokenize(source)).is_err() {
            ret 1
        }
        if parser.parse_recovering(lexer.tokenize(source)).failures.len() != 0 {
            ret 2
        }
    }
    let incomplete = prefix + "if accept(Value {"
    if parser.parse_result(lexer.tokenize(incomplete)).is_ok() {
        ret 3
    }
    if parser.parse_recovering(lexer.tokenize(incomplete)).failures.len() == 0 {
        ret 4
    }
    ret if parser.parse_result(lexer.tokenize(prefix + "if flag { action() }\n}\n")).is_ok() {
        0
    } else {
        5
    }
}
