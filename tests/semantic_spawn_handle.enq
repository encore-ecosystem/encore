//! Spawn inference agrees with the runtime handle, including nested generics.

import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("runtime", "runtime.enq", "pub struct JoinHandle[T] {}\npub struct Vec[T] {}\nimpl[T] for Vec[T] { pub fn push(self: mut Self, value: T) {} }\n")
    db.set_module("app", "app.enq", "import runtime::{JoinHandle, Vec}\nfn work() -> Vec[u32] { ret Vec[u32] {} }\nfn sample(pending: mut Vec[JoinHandle[Vec[u32]]]) {\n let handle = spawn work()\n pending.push(handle)\n pending.push(spawn work())\n}\n")
    let id = db.symbol_id("app", "sample").unwrap_or(SymbolId::invalid())
    let body = db.semantic_body(id).unwrap_or(SemanticBody::empty())
    if !assert(body.binding_type("handle").unwrap_or("") == "JoinHandle[Vec[u32]]") { ret 1_u32 }
    if !assert(body.diagnostics.len() == 0_usize) { ret 2_u32 }
    ret 0_u32
}
