struct Packet {
    tag: u8
    length: u16
}

fn accept_u8(value: u8) -> u8 { ret value }
fn accept_u16(value: u16) -> u16 { ret value }
fn accept_u32(value: u32) -> u32 { ret value }
fn accept_i64(value: i64) -> i64 { ret value }

fn contextual_return() -> u16 { ret 5000 }

fn main() -> u32 {
    let binary: u8 = 0b101010
    let octal: u16 = 0o755
    let hexadecimal: u32 = 0xdeadbeef
    let explicit = 0xCAFE_u16
    let packet = Packet{0xff, 5000}
    let repeated: [u8; 0b100] = [3_u8; 0b100]

    if accept_u8(255) != binary + 213_u8 { ret 1_u32 }
    if accept_u16(5000) != contextual_return() { ret 2_u32 }
    if accept_u32(0xffffffff) != hexadecimal + 559038736_u32 { ret 3_u32 }
    if accept_i64(0x7fffffffffffffff) != 9223372036854775807_i64 { ret 4_u32 }
    if explicit != 51966_u16 || octal != 493_u16 { ret 5_u32 }
    if packet.tag != 255_u8 || packet.length != 5000_u16 { ret 6_u32 }
    if repeated[3_usize] != 3_u8 { ret 7_u32 }
    ret 0_u32
}
