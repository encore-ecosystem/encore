import ehirlib::parse_module_text
import ehirlib::parse_type_text

fn main() -> u32 {
    let typ = parse_type_text("Result[Option[u32], Vec[str]]<H>")
    if typ.name != "Result" { ret 1_u32 }

    let source = "fn identity(value: u32) -> u32 {\n  $entry:\n    ret value: u32\n}\n"
    let module = parse_module_text("lifetime", source)
    if module.directives.len() != 1_usize { ret 2_u32 }
    ret 0_u32
}
