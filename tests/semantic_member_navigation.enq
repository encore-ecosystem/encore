//! Member declarations keep owner identity, exact spans and inherited origins.

import core::testing::assert
import refrain::frontend::AnalysisDatabase

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("members", "members.enq",
        "struct First { value: u32 }\nstruct Second { value: str }\nimpl for First { fn read(self: Self) -> u32 { ret self.value } }\nimpl for Second { fn read(self: Self) -> str { ret self.value } }\ntrait Parent[T] { fn get(self: Self) -> T }\ntrait Child[X] < Parent[X] {}\nfn sample(a: First, b: Second, c: dyn Child[First]) {\n a.value\n b.value\n a.read()\n b.read()\n c.get().value\n}\n")
    match database.member_definition_at("members", "value", 7_usize, 3_usize) {
        Some(value) => {
            if !assert(value.line() == 0_usize && value.column() == 15_usize) { ret 1_u32 }
            match database.member_declaration_at("members", "value", 0_usize, 15_usize) {
                Some(declaration) => { if !assert(value.id().key() == declaration.id().key()) { ret 2_u32 } }
                None => { ret 3_u32 }
            }
        }
        None => { ret 4_u32 }
    }
    match database.member_definition_at("members", "value", 8_usize, 3_usize) {
        Some(value) => { if !assert(value.line() == 1_usize && value.column() == 16_usize) { ret 5_u32 } }
        None => { ret 6_u32 }
    }
    match database.member_definition_at("members", "read", 9_usize, 3_usize) {
        Some(value) => { if !assert(value.line() == 2_usize && value.column() == 20_usize) { ret 7_u32 } }
        None => { ret 8_u32 }
    }
    match database.member_definition_at("members", "read", 10_usize, 3_usize) {
        Some(value) => { if !assert(value.line() == 3_usize && value.column() == 21_usize) { ret 9_u32 } }
        None => { ret 10_u32 }
    }
    match database.member_definition_at("members", "get", 11_usize, 3_usize) {
        Some(value) => { if !assert(value.line() == 4_usize && value.column() == 21_usize) { ret 11_u32 } }
        None => { ret 12_u32 }
    }
    match database.member_definition_at("members", "value", 11_usize, 9_usize) {
        Some(value) => { if !assert(value.line() == 0_usize) { ret 13_u32 } }
        None => { ret 14_u32 }
    }
    if !assert(database.member_definition_at("members", "missing", 7_usize, 3_usize).is_none()) { ret 15_u32 }
    ret 0_u32
}
