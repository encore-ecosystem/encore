//! Probes retain their captured SSA bindings without observing later writes.
import core::testing::assert
import std::vec::Vec

import ehirlib::{Parameter, ValueKind, enum_tag}

import refrain::frontend::translator::ir::{LoweringScope, annotated, reference}

extern fn encore_node_debug_live_count() -> usize

fn escaped_probe() -> LoweringScope {
    let parent = LoweringScope::new(Vec[Parameter]::new())
    let _ = parent.output("escaped", "u64")
    ret parent.fork()
}

fn exercise() -> bool {
    let parent = LoweringScope::new(Vec[Parameter]::new())
    let _ = parent.output("Shared", "u32")
    let _ = parent.output("void", "()")
    parent.remember(enum_tag("RememberedTag"))
    let probe = parent.fork()
    let _ = parent.output("Shared", "bool")
    let _ = parent.output("Future", "u64")
    if probe.bind(reference("Shared")).typ.name != "u32" ||
    parent.bind(reference("Shared")).typ.name != "bool" {
        ret false
    }
    if probe.comparison(reference("Shared"), "ieq").kind != ValueKind::Ssa ||
    probe.comparison(reference("Future"), "ieq").kind != ValueKind::EnumTag ||
    probe.bind(reference("void")).kind != ValueKind::Unit {
        ret false
    }
    if parent.bind(reference("RememberedTag")).kind != ValueKind::EnumTag ||
    probe.bind(reference("RememberedTag")).kind != ValueKind::Ssa {
        ret false
    }
    let _ = probe.output("Shared", "str")
    let nested = probe.fork()
    let _ = probe.output("Shared", "bool")
    for index in 0_usize..128_usize {
        let _ = parent.output("later_" + index.fmt(), "usize")
        let _ = parent.output("Shared", "u64")
    }
    if nested.bind(reference("Shared")).typ.name != "str" ||
    probe.bind(reference("Shared")).typ.name != "bool" {
        ret false
    }
    if nested.bind(annotated("Shared", "f32")).typ.name != "f32" {
        ret false
    }
    let retained = escaped_probe()
    if retained.bind(reference("escaped")).typ.name != "u64" {
        ret false
    }
    let mut deep = retained
    for _ in 0_usize..64_usize {
        deep = deep.fork()
    }
    ret deep.bind(reference("escaped")).typ.name == "u64"
}

fn main() -> u32 {
    let before = unsafe {
        encore_node_debug_live_count()
    }
    if !assert(exercise()) {
        ret 1_u32
    }
    if !assert(unsafe {
            encore_node_debug_live_count()
        }
        == before) {
        ret 2_u32
    }
    ret 0_u32
}
