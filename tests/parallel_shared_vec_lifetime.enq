import core::option::Option
import core::vec::Vec

fn read_shared(values: Vec[str], rounds: usize) -> u32 {
    let mut checksum = 0_u32
    let mut round = 0_usize
    while round < rounds {
        let mut index = 0_usize
        while index < values.len() {
            match values.get(index) {
                Option::Some(value) => {
                    checksum += value.len() as u32
                }
                Option::None => {
                    ret 0_u32
                }
            }
            index += 1_usize
        }
        round += 1_usize
    }
    ret checksum
}

fn main() -> u32 {
    let mut values = Vec[str]::new()
    values.push("alpha")
    values.push("beta")
    values.push("gamma")
    values.push("delta")

    let first = spawn read_shared(values, 20000_usize)
    let second = spawn read_shared(values, 20000_usize)
    let third = spawn read_shared(values, 20000_usize)
    let fourth = spawn read_shared(values, 20000_usize)
    let expected = 19_u32 * 20000_u32
    if first.join() != expected || second.join() != expected ||
    third.join() != expected || fourth.join() != expected {
        ret 1_u32
    }
    ret if values.len() == 4_usize { 0_u32 } else { 2_u32 }
}
