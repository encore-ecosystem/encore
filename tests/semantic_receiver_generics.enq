//! Receiver specialization uses declared generic identities, not capitalization.

import core::testing::assert
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("types", "types.enq",
        "struct Concrete { value: u32 }\nstruct Box[Element] { value: Element }\nstruct Pair[Left, Right] {}\nimpl[Element] for Box[Element] { fn read(self: Self) -> Element { ret self.value } }\nimpl for Box[Concrete] { fn concrete(self: Self) -> Concrete { ret self.value } }\nimpl[Element] for Box[Box[Element]] { fn nested(self: Self) -> Element { ret self.value.value } }\nimpl[Element] for Pair[Element, Element] { fn same(self: Self, value: Element) -> Element { ret value } }\nfn sample(value: Box[str]) { let result = value.read() }\n")
    let mut saw_field = false
    let mut saw_method = false
    for member in database.members_for_type("types", "Box[str]") {
        if member.name == "value" { saw_field = true if !assert(member.typ == "str") { ret 1_u32 } }
        if member.name == "read" { saw_method = true if !assert(member.typ == "str") { ret 2_u32 } }
        if member.name == "concrete" || member.name == "nested" { ret 3_u32 }
    }
    if !assert(saw_field && saw_method) { ret 4_u32 }
    let mut concrete = false
    for member in database.members_for_type("types", "Box[Concrete]") {
        if member.name == "concrete" { concrete = true if !assert(member.typ == "Concrete") { ret 5_u32 } }
    }
    if !assert(concrete) { ret 6_u32 }
    let mut nested = false
    for member in database.members_for_type("types", "Box[Box[str]]") {
        if member.name == "nested" { nested = true if !assert(member.typ == "str") { ret 7_u32 } }
    }
    if !assert(nested) { ret 8_u32 }
    if !assert(database.members_for_type("types", "Pair[str,u32]").len() == 0_usize) { ret 9_u32 }
    let same = database.members_for_type("types", "Pair[str,str]")
    if !assert(same.len() == 1_usize) { ret 10_u32 }
    for member in same { if !assert(member.typ == "str") { ret 11_u32 } }
    let first = database.semantic_binding_type("types", "result", 7_usize)
    let second = database.semantic_binding_type("types", "result", 7_usize)
    if !assert(first.unwrap_or("") == "str" && second.unwrap_or("") == "str") { ret 12_u32 }
    let id = database.symbol_id("types", "sample").unwrap_or(SymbolId::invalid())
    if !assert(database.semantic_body_count(id) == 1_usize) { ret 13_u32 }
    let head = "struct Element {}\nstruct Box[Value] { value: Value }\n"
    let tail = " for Box[Element] { fn read(self: Self) -> Element { ret self.value } }\nfn sample(value: Box[str]) { let result = value.read() }\n"
    database.set_module("changed", "changed.enq", head + "impl[Element]" + tail)
    let changed_id = database.symbol_id("changed", "sample").unwrap_or(SymbolId::invalid())
    let generic = database.semantic_body(changed_id).unwrap_or(SemanticBody::empty())
    if !assert(generic.binding_type("result").unwrap_or("") == "str") { ret 14_u32 }
    database.set_module("changed", "changed.enq", head + "impl" + tail)
    let concrete_only = database.semantic_body(changed_id).unwrap_or(SemanticBody::empty())
    if !assert(concrete_only.binding_type("result").unwrap_or("") == "") { ret 15_u32 }
    if !assert(database.semantic_body_count(changed_id) == 2_usize) { ret 16_u32 }
    ret 0_u32
}
