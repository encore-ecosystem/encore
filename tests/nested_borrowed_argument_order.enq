import core::vec::Vec
import core::option::Option

fn first_u32(values: Vec[u32]) -> u32 {
    match values.get(0_usize) {
        Option::Some(value) => { ret value }
        Option::None => { ret 0_u32 }
    }
}

fn first_f32(values: Vec[f32]) -> f32 {
    match values.get(0_usize) {
        Option::Some(value) => { ret value }
        Option::None => { ret 0.0_f32 }
    }
}

fn verify(first_value: u32, first_len: usize,
    second_value: f32, second_len: usize,) -> bool {
    ret first_value == 1_u32 && second_value == 1.0_f32 &&
        first_len == 2_usize && second_len == 3_usize
}

fn main() -> u32 {
    let mut first = Vec[u32]::new()
    first.push(1_u32)
    first.push(2_u32)
    let mut second = Vec[f32]::new()
    second.push(1.0_f32)
    second.push(2.0_f32)
    second.push(3.0_f32)
    let nested = verify(first_u32(first), first.len(), first_f32(second), second.len())
    let first_value = first_u32(first)
    let first_length = first.len()
    let second_value = first_f32(second)
    let second_length = second.len()
    let materialized = verify(first_value, first_length, second_value, second_length)
    ret if nested && materialized { 0_u32 } else { 1_u32 }
}
