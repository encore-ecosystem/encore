//! Loop transfers close only contexts entered inside the target loop.
import core::ops::ContextManager
import std::os::{read_file, write_file_atomic, remove_file}

struct Resource {
    name: str
}
impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret write_file_atomic("target/tests/with-transfer-boundaries.txt",
            read_file("target/tests/with-transfer-boundaries.txt") + self.name,) == 0_i32
    }
}

fn main() -> u32 {
    if write_file_atomic("target/tests/with-transfer-boundaries.txt", "") != 0_i32 {
        ret 1_u32
    }
    with Resource {
        "a"
    }
    as root {
        let mut count = 0_u32
        while < 'outer > count < 3_u32 {
            count += 1_u32
            with Resource {
                "b"
            }
            as middle {
                loop {
                    with Resource {
                        "c"
                    }
                    as inner {
                        unsafe {
                            match count == 1_u32 {
                                true => {
                                    continue < 'outer >
                                }
                                false => {
                                    break < 'outer >
                                }
                            }
                        }
                        ret 2_u32
                    }
                }
            }
        }
        if count != 2_u32 {
            ret 3_u32
        }
        if read_file("target/tests/with-transfer-boundaries.txt") != "cbcb" {
            ret 4_u32
        }
        do {
            with Resource {
                "d"
            }
            as iteration {
                break
            }
            ret 5_u32
        }
        while true
        if read_file("target/tests/with-transfer-boundaries.txt") != "cbcbd" {
            ret 6_u32
        }
    }
    if read_file("target/tests/with-transfer-boundaries.txt") != "cbcbda" {
        ret 7_u32
    }
    if remove_file("target/tests/with-transfer-boundaries.txt") != 0_i32 {
        ret 8_u32
    }
    ret 0_u32
}
