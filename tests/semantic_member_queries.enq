//! Member queries use expression inference, including recoverable trailing dots.

import core::testing::assert
import refrain::frontend::AnalysisDatabase

fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("members", "members.enq",
        "struct Item { value: u32 }\nfn make() -> Item { ret Item { 1_u32 } }\nfn sample() {\n make().\n}\n")
    if !assert(database.member_receiver_at("members", 3_usize, 8_usize) == "Item") { ret 1_u32 }
    database.set_module("members", "members.enq",
        "struct Other { text: str }\nfn make() -> Other { ret Other { \"new\" } }\nfn sample() {\n make().\n}\n")
    if !assert(database.member_receiver_at("members", 3_usize, 8_usize) == "Other") { ret 7_u32 }
    database.set_module("members", "members.enq",
        "struct Item { value: u32 }\nfn sample(items: [Item; 2]) {\n items[0_usize].\n}\n")
    if !assert(database.member_receiver_at("members", 2_usize, 16_usize) == "Item") { ret 2_u32 }
    database.set_module("members", "members.enq",
        "struct Item { value: u32 }\nfn sample(pair: (Item, u32)) {\n pair.0.\n}\n")
    if !assert(database.member_receiver_at("members", 2_usize, 8_usize) == "Item") { ret 3_u32 }
    let members = database.members_for_type("members", "(Item, u32)")
    if !assert(members.len() == 2_usize) { ret 4_u32 }
    for member in members {
        if member.name == "0" && !assert(member.typ == "Item") { ret 5_u32 }
        if member.name == "1" && !assert(member.typ == "u32") { ret 6_u32 }
    }
    ret 0_u32
}
