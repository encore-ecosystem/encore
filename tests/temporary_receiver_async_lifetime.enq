//! A call-scoped receiver survives Pending/Ready while its argument is evaluated.
import core::future::{Context, Future, Poll}
import core::result::Result
import core::vec::Vec
import std::future::block_on

extern fn encore_node_debug_live_count() -> usize

struct Once {
    pending: bool fail: bool
}
impl Future[Result[usize, usize]] for Once {
    fn poll(self: Self, context: Context) -> Poll[Once, Result[usize, usize]] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, Result[usize, usize]]::Pending(Once {
                    false, self.fail
                }
                ,
            )
        }
        ret Poll[Once, Result[usize, usize]]::Ready(if self.fail {
                Result[usize, usize]::Err(7_usize)
            } else {
                Result[usize, usize]::Ok(2_usize)
            }
            ,
        )
    }
}

struct Holder {
    values: Vec[usize]
}
impl for Holder {
    #attr(borrowed_self)
    fn count(self: Self, extra: usize) -> usize {
        ret self.values.len() + extra
    }
}
fn make() -> Holder {
    let mut values = Vec[usize]::new()
    values.push(3_usize)
    ret Holder {
        values
    }
}
async fn suspended(fail: bool) -> Result[usize, usize] {
    let pending = Once {
        true, fail
    }
    ret Result::Ok(make().count((await pending)?))
}
fn run(fail: bool) -> bool {
    match block_on[Result[usize, usize], __encore_future_suspended](suspended(fail)) {
        Ok(value) => {
            ret !fail && value == 3_usize
        }
        Err(error) => {
            ret fail && error == 7_usize
        }
    }
}
fn main() -> u32 {
    let before = unsafe {
        encore_node_debug_live_count()
    }
    for index in 0_usize..100_usize {
        if !run(false) || !run(true) {
            ret 1_u32
        }
        if unsafe {
            encore_node_debug_live_count()
        }
        != before {
            ret 2_u32
        }
    }
    ret 0_u32
}
