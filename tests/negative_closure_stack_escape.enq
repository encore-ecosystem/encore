// @expect.compile_error=error[stack-node-closure-escape]: closure environment escapes, so it cannot capture stack node 'state' of type 'State<S>'; allocate it as <H>

trait Handler {
    fn handle(self: Self) -> u32
}

struct State {
    value: u32
}

fn main() -> u32 {
    let state = State < S > {
        1_u32
    }
    let _handler: dyn Handler = || state.value
    ret 0_u32
}
