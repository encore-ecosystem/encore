import core::testing::assert
import core::vec::Vec

struct Cursor {
    source: str
    index: usize
}

fn advance(cursor: Cursor) -> Cursor {
    ret Cursor { cursor.source, cursor.index + 1_usize }
}

fn make_values(label: str) -> Vec[str] {
    let mut values = Vec[str]::new()
    values.push(label + "-first")
    values.push(label + "-second")
    ret values
}

fn main() -> u32 {
    let mut values = make_values("owned")
    if !assert(values.len() == 2_usize) { ret 1_u32 }
    match values.get(1_usize) {
        Some(value) => { if !assert(value == "owned-second") { ret 2_u32 } }
        None => { ret 3_u32 }
    }
    values = make_values("replacement")
    match values.get(0_usize) {
        Some(value) => { if !assert(value == "replacement-first") { ret 4_u32 } }
        None => { ret 5_u32 }
    }
    let mut cursor = Cursor { "persistent source", 0_usize }
    let mut index = 0_usize
    while index < 128_usize {
        cursor = advance(cursor)
        index += 1_usize
    }
    if !assert(cursor.index == 128_usize) { ret 6_u32 }
    if !assert(cursor.source == "persistent source") { ret 7_u32 }
    if !assert(cursor.source.byte_len() == 17_usize) { ret 8_u32 }
    ret 0_u32
}
