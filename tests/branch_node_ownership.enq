//! Branch joins preserve selected node handles and release their owning edges.
import core::option::Option

extern fn encore_node_debug_live_count() -> usize

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

struct Counter {
    value: u32
}
struct Cache {
    index: Option[Counter<H>]
}

fn step(cache: mut Cache&) -> bool {
    let mut counter = match cache.index {
        Some(value) => value
        None => {
            ret false
        }
    }
    counter.value += 1
    ret true
}

fn choose(left: Counter&, right: Counter&, first: bool) -> Counter& {
    ret if first {
        left
    } else {
        right
    }
}

fn exercise(first: bool) -> u32 {
    let mut cache = Cache<H> {
        Option[Counter<H>]::Some(Counter<H>{ 41 })
    }
    if !step(cache) {
        ret 1
    }
    let selected = match cache.index {
        Some(value) => value
        None => {
            ret 2
        }
    }
    if selected.value != 42 {
        ret 3
    }
    let fresh = if first {
        Counter<H>{ 12 }
    } else {
        Counter<H>{ 13 }
    }
    if fresh.value != if first {
        12
    } else {
        13
    }
    {
        ret 4
    }
    let nested = match first {
        true => {
            let node = Counter<H>{ 21 } node
        }
        false => Counter<H>{ 22 }
    }
    if nested.value != if first {
        21
    } else {
        22
    }
    {
        ret 5
    }
    let mut local = Counter<S>{ 5 }
    let mut other = Counter<S>{ 6 }
    let stack = if first {
        local
    } else {
        other
    }
    if stack.value != if first {
        5
    } else {
        6
    }
    {
        ret 6
    }
    let erased = choose(local, other, first)
    if erased.value != stack.value {
        ret 7
    }
    let mut empty = Cache<H>{ Option[Counter<H>]::None }
    if step(empty) {
        ret 8
    }
    ret 0
}

fn main() -> u32 {
    let before = live_nodes()
    for iteration in 0..32 {
        let status = exercise(iteration % 2 == 0)
        if status != 0 {
            ret status
        }
        if live_nodes() != before {
            ret 9
        }
    }
    ret 0
}
