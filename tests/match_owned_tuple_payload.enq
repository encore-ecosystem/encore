import core::result::Result
import core::testing::assert

struct Cursor {
    source: str
    index: usize
}

fn make_pair() -> Result[(str, Cursor), str] {
    let pair = ("payload", Cursor { "source", 7_usize })
    ret Result[(str, Cursor), str]::Ok(pair)
}

fn main() -> u32 {
    match make_pair() {
        Result[(str, Cursor), str]::Ok(pair) => {
            if !assert(pair.0 == "payload") { ret 1_u32 }
            if !assert(pair.1.source == "source") { ret 1_u32 }
            if !assert(pair.1.index == 7_usize) { ret 1_u32 }
        }
        Result[(str, Cursor), str]::Err(_) => { ret 1_u32 }
    }
    ret 0_u32
}
