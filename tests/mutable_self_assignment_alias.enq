import core::vec::Vec

struct RetainedEntry {
    values: Vec[str]
}

struct RetainedState {
    paths: Vec[str]
    entries: Vec[RetainedEntry]
    generation: usize
}

fn update_in_place(state: mut RetainedState, value: str) -> RetainedState {
    let mut values = Vec[str]::new()
    values.push(value)
    let mut entries = Vec[RetainedEntry]::new()
    entries.push(RetainedEntry { values })
    // Replacing a nested owner is the important case: a shallow snapshot of
    // `state` taken before this call would point at the released old vectors.
    state.entries = entries
    state.paths.push(value)
    state.generation += 1_usize
    ret state
}

fn main() -> u32 {
    let mut state = RetainedState {
        Vec[str]::new(), Vec[RetainedEntry]::new(), 0_usize
    }
    let mut index = 0_usize
    while index < 512_usize {
        state = update_in_place(state, "path")
        if state.paths.len() != index + 1_usize ||
        state.entries.len() != 1_usize ||
        state.generation != index + 1_usize {
            ret 1_u32
        }
        index += 1_usize
    }
    ret if state.paths.get(511_usize).unwrap_or("") == "path" {
        0_u32
    } else {
        2_u32
    }
}
