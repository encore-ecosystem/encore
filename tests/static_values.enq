//! Statics retain one process-lifetime value, including nested owning fields.
import core::option::Option

struct Counter {
    value: u32
}
struct Service {
    value: u32
    label: str
}
static COUNTER: Counter<H> = Counter<H>{ 0_u32 }

fn next() -> u32 {
    let mut counter = COUNTER
    counter.value += 1_u32
    ret counter.value
}

fn create() -> Service<H> {
    ret Service<H>{ next(), "shared" + " value" }
}

static INSTANCE: Service<H> = create()
static NUMBER: u32 = next()
static NESTED: u32 = NUMBER + 1_u32
static MESSAGE: str = "hello" + " static"
static OPTIONAL: Option[str] = Option[str]::Some("option" + " static")
static config: Service = Service { 7_u32, "inline" + " static" }
static UNIT:() = initialize_unit()

fn initialize_unit() ->() {
    next()
}
fn read_config() -> str {
    ret config.label
}
fn worker() -> u32 {
    ret INSTANCE.value
}

fn main() -> u32 {
    let mut first = INSTANCE
    if first.value != 1_u32 {
        ret 1
    }
    first.value = 99_u32
    let second = INSTANCE
    if second.value != 99_u32 || second.label != "shared value" {
        ret 2
    }
    // Each read returns its own owning copy; releasing it leaves the root alive.
    for index in 0_usize..100_usize {
        let text = MESSAGE
        if text != "hello static" {
            ret 3
        }
        match OPTIONAL {
            Some(value) => {
                if value != "option static" {
                    ret 4
                }
            }
            None => {
                ret 5
            }
        }
    }
    if NUMBER != 2_u32 || NUMBER != 2_u32 || NESTED != 3_u32 {
        ret 6
    }
    let one = UNIT
    let two = UNIT
    if COUNTER.value != 3_u32 {
        ret 7
    }
    if read_config() != "inline static" {
        ret 8
    }
    let config = "local shadow"
    if config != "local shadow" {
        ret 9
    }
    let left = spawn worker()
    let right = spawn worker()
    if left.join() != 99_u32 || right.join() != 99_u32 {
        ret 10
    }
    ret 0
}
