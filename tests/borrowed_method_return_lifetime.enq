import core::option::Option
import core::vec::Vec

enum Route {
    Plaintext
    Json
}

struct Entry {
    pattern: str
    route: Option[Route]
}

struct State {
    entries: Vec[Entry]
}

fn main() -> u32 {
    let mut entries = Vec[Entry]::new()
    entries.push(Entry{"/plaintext", Option::Some(Route::Plaintext)})
    entries.push(Entry{"/json", Option::Some(Route::Json)})
    let state = State{entries}

    // The borrowed result does not carry ownership out of Vec. The caller
    // must retain its local copy before dropping it at the end of each loop.
    let mut iteration = 0_usize
    while iteration < 10000_usize {
        let first = state.entries.get_unchecked_borrowed(0_usize)
        let second = state.entries.get_unchecked_borrowed(1_usize)
        if first.pattern != "/plaintext" || second.pattern != "/json" {
            ret 1_u32
        }
        if !first.route.is_some() { ret 2_u32 }
        if !second.route.is_some() { ret 3_u32 }
        iteration += 1_usize
    }
    ret if state.entries.len() == 2_usize { 0_u32 } else { 4_u32 }
}
