//! A mutable slot preserves the complete pointer value during write and read.
import std::io::eprintln
import ehirlib::{parse_module_text, validate_module}

import refrain::frontend::{Lexer, Parser}
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source = "fn choose(first: u8*, second: u8*) -> u8* { let mut selected = first selected = second ret selected }"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    let module = parse_module_text("mutable-pointer", output)
    match validate_module(module) {
        Ok(_) => {
            ret 0
        }
        Err(error) => {
            eprintln(error) ret 1
        }
    }
}
