//! Generic dynamic interfaces retain their specialization through a mut field.

trait Value[T] {
    fn evaluate(self: Self) -> T
}
struct Number {
    value: u32
}

impl Value[u32] for Number {
    fn evaluate(self: Self) -> u32 {
        ret self.value
    }
}
struct Text {
    value: str
}

impl Value[str] for Text {
    fn evaluate(self: Self) -> str {
        ret self.value
    }
}
struct Holder[T] {
    value: T
    binding: dyn Value[T]
}

impl[T] for Holder[T] {
    fn refresh(self: mut Self&) -> T {
        self.value = self.binding.evaluate()
        ret self.value
    }
}

fn main() -> u32 {
    let mut number = Holder[u32]<H> {
        0, Number { 42 } as dyn Value[u32]
    }
    let mut text = Holder[str]<H> {
        "", Text { "forty-two" } as dyn Value[str]
    }
    if number.refresh() != 42 {
        ret 1
    }
    if text.refresh() != "forty-two" {
        ret 2
    }
    // Copies retain the appropriate specialized interface and boxed payload.
    let copy = text.binding
    if copy.evaluate() != "forty-two" {
        ret 3
    }
    if number.refresh() != 42 {
        ret 4
    }
    ret 0
}
