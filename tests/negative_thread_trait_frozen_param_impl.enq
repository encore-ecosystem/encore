// @expect.compile_error=but the trait requires frozen
import core::vec::Vec

trait Inspect {
    fn inspect(self: Self, values: frozen Vec[str]) -> usize
}

struct Reader {}

impl Inspect for Reader {
    fn inspect(self: Reader, values: Vec[str]) -> usize {
        values.push("mutation")
        ret values.len()
    }
}

fn main() -> u32 {
    ret 0_u32
}
