import core::option::Option
import core::vec::Vec

struct Resource {
    values: Vec[u32]
    touches: u32
}

struct Entry {
    resource: Resource<H>
    ready: bool
}

impl for Entry {
    fn mark_ready(self: mut Self&) -> () {
        self.ready = true
        ret ()
    }
}

struct Owner {
    entries: Vec[Entry<H>]
    ready: Vec[bool]
    slots: Vec[u32]
}

fn touch(resource: mut Resource&) -> () {
    resource.touches += 1_u32
    ret ()
}

fn score(resource: Resource&) -> u32 {
    ret resource.values.len() as u32 + resource.touches
}

fn main() -> u32 {
    let mut payload = Vec[u32]::new()
    payload.push(5_u32)
    let resource = Resource<H>{payload, 0_u32}
    let mut entries = Vec[Entry<H>]::new()
    entries.push(Entry<H>{resource, false})
    let mut ready = Vec[bool]::new()
    ready.push(false)
    let mut slots = Vec[u32]::new()
    slots.push(0_u32)
    let owner = Owner<H>{entries, ready, slots}
    let mut iteration = 0_usize
    while iteration < 100000_usize {
        match owner.entries.get(0_usize) {
            Option::Some(entry) => {
                touch(entry.resource)
                if score(entry.resource) != entry.resource.touches + 1_u32 { ret 1_u32 }
                entry.mark_ready()
            }
            Option::None => { ret 2_u32 }
        }
        iteration += 1_usize
    }
    match owner.entries.get(0_usize) {
        Option::Some(entry) => {
            ret if entry.ready && entry.resource.touches == 100000_u32 &&
                owner.ready.len() == 1_usize && owner.slots.len() == 1_usize {
                0_u32
            } else {
                3_u32
            }
        }
        Option::None => { ret 4_u32 }
    }
}
