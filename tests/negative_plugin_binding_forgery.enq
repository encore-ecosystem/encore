// @expect.compile_error=plugin handle storage is opaque outside its SDK
import std::plugin::{Plugin, Binding}
#attr(plugin_interface)
trait Original {
    fn value(self: Self) -> u32
}
#attr(plugin_interface)
trait Other {
    fn value(self: Self) -> str
}
fn main() -> u32 {
    match unsafe {
        Plugin::load("unused")
    }
    {
        Ok(plugin) => {
            match plugin.bind[dyn Original]("original") {
                Ok(binding) => {
                    let forged = Binding[dyn Other] { binding.lease }
                }
                Err(_) => {
                }
            }
        }
        Err(_) => {
        }
    }
    ret 0
}
