//! Shared flow classification gives editor/prepared checking the same branch types.
import refrain::frontend::analysis_database::{AnalysisDatabase, SymbolId, check_prepared_semantic_module}
import refrain::frontend::semantic::SemanticBody
import refrain::target::host_target
import std::io::eprintln

fn valid(body: str, expected: str) -> bool {
    let mut database = AnalysisDatabase::new()
    database.set_module("flow", "flow.enq", "fn sample(flag: bool) -> u32 { for index in 0_u32..3_u32 { " + body + " } ret 0 }\n")
    let id = database.symbol_id("flow", "sample").unwrap_or(SymbolId::invalid())
    let checked = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    for diagnostic in checked.diagnostics {
        if diagnostic.severity == 1 {
            eprintln(diagnostic.message) ret false
        }
    }
    let mut actual = ""
    for site in checked.scoped_bindings {
        if site.binding.name == "selected" {
            actual = site.binding.typ
        }
    }
    if actual != expected {
        eprintln("selected=" + actual + " expected=" + expected + " body=" + body)
        ret false
    }
    for diagnostic in check_prepared_semantic_module(database.prepare_module_semantic_check_for_target(
            "flow", host_target(), Vec[str]::new(),)) {
        if diagnostic.severity == 1 {
            eprintln(diagnostic.message) ret false
        }
    }
    ret true
}
fn main() -> u32 {
    for exit in vec!["continue", "break", "ret 0_u32"] {
        if !valid("let selected = match flag { true => { " + exit + " } false => 7_u32 }", "u32") {
            ret 1
        }
        if !valid("let selected = match flag { true => 7_u32 false => { " + exit + " } }", "u32") {
            ret 2
        }
        if !valid("let selected = if flag { " + exit + " } else { 7_u32 }", "u32") {
            ret 3
        }
        if !valid("let selected = match flag { true => { { " + exit + " } } false => 7_u32 }", "u32") {
            ret 4
        }
        if !valid("let selected = match flag { true => { " + exit + " \"unreachable\" } false => 7_u32 }", "u32") {
            ret 5
        }
    }
    if !valid("let selected = match flag { true => { loop { break } 7_u32 } false => 9_u32 }", "u32") {
        ret 6
    }
    // A conditional exit without else still falls through and produces void.
    let mut database = AnalysisDatabase::new()
    database.set_module("flow", "flow.enq", "fn sample(flag: bool) -> u32 { for index in 0_u32..3_u32 { " +
        "let selected = match flag { true => unsafe { if flag { continue } } false => 7_u32 } } ret 0 }\n",)
    let id = database.symbol_id("flow", "sample").unwrap_or(SymbolId::invalid())
    let checked = database.semantic_body(id).unwrap_or(SemanticBody::empty())
    for diagnostic in checked.diagnostics {
        if diagnostic.code == "branch-type-mismatch" {
            ret 0
        }
    }
    ret 7
}
