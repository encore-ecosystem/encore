//! Registry URL identities must be stable and cannot contain credentials.
import refrain::project::registry::normalize_registry_url

fn main() -> u32 {
    if normalize_registry_url("HTTPS://PACKAGES.EXAMPLE:443/index/") != "https://packages.example/index" { ret 1_u32 }
    if normalize_registry_url("http://localhost:80/index/") != "http://localhost/index" { ret 2_u32 }
    if normalize_registry_url("http://127.0.0.1:8137/index") != "http://127.0.0.1:8137/index" { ret 3_u32 }
    if normalize_registry_url("https://user:password@example.org/index") != "" { ret 4_u32 }
    if normalize_registry_url("https://example.org/index?token=x") != "" { ret 5_u32 }
    if normalize_registry_url("https://example.org/index#fragment") != "" { ret 6_u32 }
    if normalize_registry_url("http://example.org/index") != "" { ret 7_u32 }
    if normalize_registry_url("https://example.org/a/../index") != "" { ret 8_u32 }
    if normalize_registry_url("https://example.org/%2e/index") != "" { ret 9_u32 }
    if normalize_registry_url("https://example.org/\nindex") != "" { ret 10_u32 }
    ret 0_u32
}
