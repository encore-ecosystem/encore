//! Diverging match-expression arms preserve the enclosing loop's control flow.

import core::option::Option
import core::iter::range
import core::testing::assert

fn break_case() -> u32 {
    let mut count = 0_u32
    let mut option = Option[u32]::Some(1_u32)
    while count < 2_u32 {
        let value = match option {
            Some(value) => value
            None => {
                break
            }
        }
        count += value
        option = Option[u32]::None
    }
    ret count
}

fn continue_case() -> u32 {
    let mut count = 0_u32
    let mut sum = 0_u32
    while count < 3_u32 {
        count += 1_u32
        let value = match count {
            2 => {
                continue
            }
            _ => count
        }
        sum += value
    }
    ret sum
}

fn return_case() -> u32 {
    let value = match Option[u32]::None {
        Some(value) => value
        None => {
            ret 7_u32
        }
    }
    ret value
}

fn labelled_case() -> u32 {
    let mut count = 0_u32
    while < 'outer > count < 3_u32 {
        count += 1_u32
        loop {
            let value = match Option[u32]::None {
                Some(value) => value
                None => {
                    break < 'outer >
                }
            }
            count += value
        }
    }
    ret count
}

fn for_case() -> u32 {
    let mut sum = 0_u32
    for item in 1..6 {
        let value = match item {
            2 => {
                continue
            }
            4 => {
                break
            }
            _ => item
        }
        sum += value as u32
    }
    ret sum
}

fn literal_patterns(value: f64, flag: bool) -> u32 {
    let number = match value {
        1.5 => 9_u32
        _ => 0_u32
    }
    let boolean = match flag {
        true => 1_u32
        false => 0_u32
    }
    ret number + boolean
}

fn main() -> u32 {
    if !assert(break_case() == 1_u32) {
        ret 1_u32
    }
    if !assert(continue_case() == 4_u32) {
        ret 2_u32
    }
    if !assert(return_case() == 7_u32) {
        ret 3_u32
    }
    if !assert(labelled_case() == 1_u32) {
        ret 4_u32
    }
    if !assert(for_case() == 4_u32) {
        ret 5_u32
    }
    if !assert(literal_patterns(1.5_f64, true) == 10_u32) { ret 6_u32 }
    if !assert(literal_patterns(2.5_f64, false) == 0_u32) { ret 7_u32 }
    ret 0_u32
}
