trait Identity {
    fn identity[T](self: Self, value: T) -> T
}

struct Value {}

impl Identity for Value {
    fn identity[U](self: Self, value: U) -> U {
        ret value
    }
}

fn main() -> u32 {
    let value = Value{}
    if value.identity[u32](7_u32) != 7_u32 {
        ret 1_u32
    }
    ret 0_u32
}
