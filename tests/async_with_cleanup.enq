//! Owned context and Result values survive a Pending/Ready suspension cycle.
import core::future::{Context, Future, Poll}
import core::ops::ContextManager
import core::result::Result
import std::future::block_on
import std::os::{read_file, write_file_atomic, remove_file}

struct Once {
    pending: bool value: str
}
impl Future[str] for Once {
    fn poll(self: Self, context: Context) -> Poll[Once, str] {
        if self.pending {
            context.waker.wake()
            ret Poll[Once, str]::Pending(Once {
                    false, self.value
                }
                ,
            )
        }
        ret Poll[Once, str]::Ready(self.value)
    }
}

struct Resource {
    name: str
}
impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret write_file_atomic("target/tests/async-with-cleanup.txt",
            read_file("target/tests/async-with-cleanup.txt") + self.name,) == 0_i32
    }
}

async fn scoped(future: Once, label: str) -> Result[str, str] {
    with Resource {
        label
    }
    as resource {
        let value = await future
        let result = Result[str, str]::Ok(value)
        let extracted = result?
        ret Result[str, str]::Ok(extracted)
    }
}

fn main() -> u32 {
    if write_file_atomic("target/tests/async-with-cleanup.txt", "") != 0_i32 {
        ret 1_u32
    }
    let future = scoped(Once {
            true, "owned " + "value"
        }
        , "ex" + "it",)
    let result = block_on[Result[str, str], __encore_future_scoped](future)
    match result {
        Ok(value) => {
            if value != "owned value" {
                ret 2_u32
            }
        }
        Err(_) => {
            ret 3_u32
        }
    }
    if read_file("target/tests/async-with-cleanup.txt") != "exit" {
        ret 4_u32
    }
    if remove_file("target/tests/async-with-cleanup.txt") != 0_i32 {
        ret 5_u32
    }
    ret 0_u32
}
