import core::testing::*
import std::io::println

struct Counter {
    value: usize
}

impl for Counter {
    pub fn new(value: usize) -> Self {
        ret Self{value}
    }

    pub fn add(mut self, delta: usize) -> Self {
        self.value = self.value + delta
        ret self
    }

    pub fn inc(mut self) -> Self {
        self.value = self.value + 1_usize
        ret self
    }

    pub fn get(self) -> usize {
        ret self.value
    }
}

fn main() -> u32 {
    let mut c = Counter::new(0_usize)
    c.inc()
    c.add(4_usize)
    if !assert(c.get() == 5_usize) {
        println("mut self callvoid/update failed")
        ret 1_u32
    }

    let mut chained = Counter::new(10_usize).inc().add(2_usize)
    if !assert(chained.get() == 13_usize) {
        println("chained mut self return failed")
        ret 1_u32
    }

    let explicit = Counter::add(chained, 7_usize)
    if !assert(Counter::get(explicit) == 20_usize) {
        println("static mutable self call failed")
        ret 1_u32
    }

    ret 0_u32
}
