//! Monotone plans preserve both effect bits, sharing and deeply nested joins.
import core::testing::assert
import std::vec::Vec
import refrain::frontend::safety_plan::SafetyPlanBuilder

extern fn encore_node_debug_live_count() -> usize

fn evaluate(always: bool, sources: Vec[usize], mask: usize) -> bool {
    if always { ret true }
    for source in sources { if (mask & (1_usize << source)) != 0_usize { ret true } }
    ret false
}
fn exercise() -> bool {
    let mut arena = SafetyPlanBuilder::new()
    let body = arena.source(0_usize)
    let returned = arena.source(1_usize)
    let other = arena.source(2_usize)
    let shared = arena.join(body, returned)
    let executed = arena.join(shared, arena.join(shared, other))
    let result = arena.join(returned, other)
    let plan = arena.finish(executed, result, vec![("dependency", "Box", "call")])
    for mask in 0_usize..8_usize {
        if evaluate(plan.body_true, plan.body_sources, mask) != (mask != 0_usize) { ret false }
        if evaluate(plan.returned_true, plan.returned_sources, mask) != ((mask & 6_usize) != 0_usize) { ret false }
    }
    if plan.dependencies.len() != 1_usize { ret false }
    let constant = arena.finish(arena.join(1_usize, shared), arena.join(0_usize, returned), Vec[(str, str, str)]::new())
    if !constant.body_true || !constant.body_sources.is_empty() { ret false }
    for mask in 0_usize..4_usize {
        if evaluate(constant.returned_true, constant.returned_sources, mask) != ((mask & 2_usize) != 0_usize) { ret false }
    }
    // A long sequence of statements creates a deep formula without recursive
    // flattening or exponential expansion when local values are reused.
    let mut chain = 0_usize
    for index in 0_usize..20000_usize { chain = arena.join(chain, arena.source(index % 3_usize)) }
    let deep = arena.finish(chain, 0_usize, Vec[(str, str, str)]::new())
    for mask in 0_usize..8_usize {
        if evaluate(deep.body_true, deep.body_sources, mask) != (mask != 0_usize) { ret false }
    }
    let invalid = arena.finish(999999_usize, 0_usize, Vec[(str, str, str)]::new())
    ret invalid.body_true && !invalid.returned_true
}
fn main() -> u32 {
    let before = unsafe { encore_node_debug_live_count() }
    if !assert(exercise()) { ret 1_u32 }
    if !assert(unsafe { encore_node_debug_live_count() } == before) { ret 2_u32 }
    ret 0_u32
}
