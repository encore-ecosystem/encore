//! Multiple local values survive diamonds, loops and canonicalized early exits.
fn sum(limit: u32) -> u32 {
    let mut total = 0_u32
    let mut index = 0_u32
    while index < limit {
        let mut amount = index
        if index % 2_u32 == 0_u32 {
            amount *= 2_u32
        }
        total += amount
        index += 1_u32
    }
    ret total
}

fn early(flag: bool) -> u32 {
    let mut left = 5_u32
    let mut right = 7_u32
    if flag {
        left += right ret left
    }
    while right > 0_u32 {
        right -= 1_u32 left += 2_u32
    }
    ret left
}

fn text(limit: u32) -> str {
    let mut value = "initial"
    let mut index = 0_u32
    while index < limit {
        if index % 2_u32 == 0_u32 {
            value = "even"
        } else {
            value = "odd"
        }
        index += 1_u32
    }
    ret value
}

fn main() -> u32 {
    if sum(0_u32) != 0_u32 || sum(10_u32) != 65_u32 {
        ret 1
    }
    if early(true) != 12_u32 || early(false) != 19_u32 {
        ret 2
    }
    if text(0_u32) != "initial" || text(1_u32) != "even" || text(2_u32) != "odd" {
        ret 3
    }
    ret 0
}
