//! Unsuffixed elements follow the first element or the expected Vec type (#158).
import core::vec::Vec
fn main() -> u32 {
    let integers = vec![16_u32, 17, 13]
    if integers.get(0).unwrap_or(0_u32) != 16_u32 ||
    integers.get(1).unwrap_or(0_u32) != 17_u32 || integers.get(2).unwrap_or(0_u32) != 13_u32 {
        ret 1_u32
    }
    let floats = vec![1_f32, 0, 0, 2]
    if floats.get(0).unwrap_or( - 1_f32) != 1_f32 || floats.get(1).unwrap_or( - 1_f32) != 0_f32 ||
    floats.get(2).unwrap_or( - 1_f32) != 0_f32 || floats.get(3).unwrap_or( - 1_f32) != 2_f32 {
        ret 2_u32
    }
    let expected: Vec[f64] = vec![0, 1, 2]
    if expected.get(2).unwrap_or( - 1_f64) != 2_f64 {
        ret 3_u32
    }
    ret 0_u32
}
