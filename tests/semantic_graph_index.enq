//! Cached adjacency keeps import order, cycles and revision invalidation.
import core::testing::assert
import std::vec::Vec
import refrain::frontend::{AnalysisDatabase, ModuleImportTarget}
fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("a", "a.enq", "import b::B\npub struct A {}")
    db.set_module("b", "b.enq", "import c::C\npub struct B {}")
    db.set_module("c", "c.enq", "import a::A\npub struct C {}")
    let modules = db.reachable_semantic_modules("a")
    if !assert(modules.len() == 3_usize && modules.get(0_usize).unwrap_or("") == "a" && modules.get(1_usize).unwrap_or("") == "b" && modules.get(2_usize).unwrap_or("") == "c") { ret 1_u32 }
    if !assert(db.reachable_semantic_modules("a").len() == 3_usize) { ret 2_u32 }
    let before = db.semantic_replay_context("a")
    db.set_module("b", "b.enq", "pub struct B {}")
    if !assert(db.reachable_semantic_modules("a").len() == 2_usize && db.semantic_replay_context("a") != before) { ret 3_u32 }
    db.remove_module("b")
    if !assert(db.reachable_semantic_modules("a").len() == 1_usize && db.source_text("c").unwrap_or("").contains("struct C")) { ret 4_u32 }
    db.set_module("real", "real.enq", "pub struct B {}")
    db.set_module_import_targets("a", vec![ModuleImportTarget { "b", "real" }])
    if !assert(db.reachable_semantic_modules("a").len() == 2_usize) { ret 5_u32 }
    ret 0_u32
}
