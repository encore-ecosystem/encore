//! Conditional lexical restoration must not resurrect transferred outer owners.
import core::vec::Vec

extern fn encore_node_debug_live_count() -> usize
#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

fn consume(values: sending Vec[str]) -> usize {
    ret values.len()
}

fn partial(first: bool) -> usize {
    let values = vec!["owned"]
    let mut count = 0_usize
    if first {
        count = consume(values)
    }
    ret count
}

fn expression(first: bool) -> usize {
    let values = vec!["owned"]
    ret if first {
        consume(values)
    } else {
        0_usize
    }
}

fn siblings(first: bool) -> usize {
    let values = vec!["owned"]
    ret if first {
        consume(values)
    } else {
        consume(values)
    }
}

fn statements(first: bool) -> usize {
    let values = vec!["owned"]
    let mut count = 0_usize
    if first {
        count = consume(values)
    } else {
        count = consume(values)
    }
    ret count
}

fn main() -> u32 {
    let before = live_nodes()
    for _index in 0_usize..32_usize {
        if partial(true) != 1 || partial(false) != 0 {
            ret 1
        }
        if expression(true) != 1 || expression(false) != 0 {
            ret 2
        }
        if siblings(true) != 1 || siblings(false) != 1 {
            ret 3
        }
        if statements(true) != 1 || statements(false) != 1 {
            ret 4
        }
    }
    if live_nodes() != before {
        ret 5
    }
    ret 0
}
