// @expect.compile_error=error[generic-bound-not-satisfied]: type 'str' does not satisfy bound 'NumericValue' for generic parameter 'T' of 'Value::identity'

trait NumericValue {}
impl NumericValue for u32 {}

struct Value {}

impl for Value {
    fn identity[T:NumericValue](self: Self, value: T) -> T {
        ret value
    }
}

fn main() -> u32 {
    let value = Value{}
    let invalid = value.identity[str]("text")
    ret 0_u32
}
