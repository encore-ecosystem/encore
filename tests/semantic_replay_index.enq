//! Indexed checkpoint lookups preserve JSON's first-key and exact-string rules.
import core::fmt::Debug
import core::testing::assert

import std::vec::Vec

import json::Json

import refrain::frontend::replay_index::ReplayIndex

fn main() -> u32 {
    let mut entries = Vec[(str, Json)]::new()
    for index in 0_usize..4096_usize {
        entries.push(("body-" + Debug::fmt(index), Json::Number(Debug::fmt(index))))
    }
    entries.push(("body-0", Json::Number("wrong duplicate")))
    entries.push(("", Json::String("empty")))
    entries.push(("метод\0тело", Json::String("unicode and NUL")))
    let indexed = ReplayIndex::new(Json::Object(entries))
    for index in 0_usize..4096_usize {
        if !assert(indexed.get("body-" + Debug::fmt(index)).unwrap_or(Json::Null).as_number().unwrap_or("") == Debug::fmt(index)) {
            ret 1_u32
        }
    }
    if !assert(indexed.get("absent").is_none() && indexed.get("метод").is_none() &&
        indexed.get("").unwrap_or(Json::Null).as_str().unwrap_or("") == "empty" &&
        indexed.get("метод\0тело").unwrap_or(Json::Null).as_str().unwrap_or("") == "unicode and NUL" &&
        ReplayIndex::new(Json::Null).get("body-0").is_none()) {
        ret 2_u32
    }
    ret 0_u32
}
