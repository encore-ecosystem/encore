import core::thread::available_parallelism
import core::time::{perf_counter_ms, sleep_ms}

fn delayed() -> () {
    sleep_ms(200_u64)
    ret ()
}

fn scoped_thread() -> () {
    let handle = spawn delayed()
    ret ()
}

fn main() -> u32 {
    if available_parallelism() == 0_usize { ret 1_u32 }
    let direct = spawn delayed()
    direct.join()
    let started = perf_counter_ms()
    scoped_thread()
    if perf_counter_ms() - started < 180_u64 { ret 2_u32 }
    ret 0_u32
}
