import core::testing::*
import core::ops::ContextManager

struct Dummy {
    value: usize
}

impl ContextManager for Dummy {
    fn with_enter(self: Dummy) -> Dummy {
        ret self
    }

    fn with_exit(self: Dummy) -> bool {
        ret true
    }
}

fn early_return(flag: bool) -> usize {
    with Dummy{11_usize} as resource {
        if flag {
            ret resource.value
        }
    }
    ret 0_usize
}

fn main() -> u32 {
    let mut sum = 0_usize
    for item in 0..5 {
        with Dummy{item} as resource {
            if item == 1_usize {
                continue
            }
            if item == 4_usize {
                break
            }
            sum = sum + resource.value
        }
    }

    if !assert(sum == 5_usize) {
        ret 1_u32
    }
    if !assert(early_return(true) == 11_usize) {
        ret 1_u32
    }
    ret 0_u32
}
