// @expect.compile_error=not a supported immutable region
import std::vec::Vec
import ehirlib::Parameter

import refrain::frontend::translator::ir::LoweringScope

fn inspect(_scope: frozen LoweringScope) -> u32 {
    ret 0_u32
}

fn main() -> u32 {
    let scope = LoweringScope::new(Vec[Parameter]::new()).fork()
    let worker = spawn inspect(scope)
    ret worker.join()
}
