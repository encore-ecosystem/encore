// @expect.compile_error=is not available through frozen region
import core::vec::Vec
struct Source {
}

impl for Source {
    pub fn snapshot(self: Self) -> frozen Vec[str] {
        let mut values = Vec[str]::new()
        values.push("immutable")
        ret values
    }
}
fn main() -> u32 {
    let source = Source {}
    let mut values = source.snapshot()
    values.push("mutation")
    ret 0_u32
}
