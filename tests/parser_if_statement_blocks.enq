//! Ordinary branch statements remain valid before the tail of a value block.
import core::result::Result
import refrain::frontend::{Lexer, Parser}

fn main() -> u32 {
    let valid = "fn probe(flag: bool) -> u32 { let value = match flag { true => { if flag { ret 1_u32 } 2_u32 } false => { if flag { ret 3_u32 } elif flag { ret 4_u32 } 5_u32 } } ret value }\n" +
    "fn tail(flag: bool) -> u32 { ret { if flag { ret 6_u32 } if flag { 7_u32 } else { 8_u32 } } }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new()
    match parser.parse_result(lexer.tokenize(valid)) {
        Result::Ok(statements) => {
            if statements.len() != 2 {
                ret 1
            }
        }
        Result::Err(_) => {
            ret 2
        }
    }
    let invalid = "fn probe(flag: bool) -> u32 { let value = if flag { 1_u32 } ret value }"
    let mut invalid_parser = Parser::new()
    match invalid_parser.parse_result(lexer.tokenize(invalid)) {
        Result::Ok(_) => {
            ret 3
        }
        Result::Err(error) => {
            if !error.message.contains("else") {
                ret 4
            }
        }
    }
    ret 0
}
