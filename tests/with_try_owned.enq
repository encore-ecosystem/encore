//! Error payloads survive cleanup of their local Result owner, including async.
import core::ops::ContextManager
import core::result::Result
import std::future::block_on
import std::os::{read_file, write_file_atomic, remove_file}

struct Resource {
    name: str
}
impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret write_file_atomic("target/tests/with-try-owned.txt",
            read_file("target/tests/with-try-owned.txt") + self.name,) == 0_i32
    }
}

fn failure() -> Result[bool, str] {
    ret Result[bool, str]::Err("owned " + "error")
}

fn propagated(named: bool) -> Result[bool, str] {
    with Resource {
        "a"
    }
    as resource {
        if named {
            let result = failure()
            let value = result?
            ret Result[bool, str]::Ok(value)
        }
        let value = failure()?
        ret Result[bool, str]::Ok(value)
    }
}

async fn async_failure() -> Result[bool, str] {
    with Resource {
        "b"
    }
    as resource {
        let value = failure()?
        ret Result[bool, str]::Ok(value)
    }
}

fn success() -> Result[str, str] {
    ret Result[str, str]::Ok("owned " + "success")
}

fn extracted(named: bool) -> Result[str, str] {
    with Resource {
        "c"
    }
    as resource {
        if named {
            let result = success()
            let value = result?
            ret Result[str, str]::Ok(value)
        }
        let value = success()?
        ret Result[str, str]::Ok(value)
    }
}

fn main() -> u32 {
    if write_file_atomic("target/tests/with-try-owned.txt", "") != 0_i32 {
        ret 1_u32
    }
    match propagated(true) {
        Err(message) => {
            if message != "owned error" {
                ret 2_u32
            }
        }
        Ok(_) => {
            ret 3_u32
        }
    }
    match propagated(false) {
        Err(message) => {
            if message != "owned error" {
                ret 4_u32
            }
        }
        Ok(_) => {
            ret 5_u32
        }
    }
    let future = async_failure()
    let result = block_on[Result[bool, str], __encore_future_async_failure](future)
    match result {
        Err(message) => {
            if message != "owned error" {
                ret 6_u32
            }
        }
        Ok(_) => {
            ret 7_u32
        }
    }
    match extracted(true) {
        Ok(message) => {
            if message != "owned success" {
                ret 10_u32
            }
        }
        Err(_) => {
            ret 11_u32
        }
    }
    match extracted(false) {
        Ok(message) => {
            if message != "owned success" {
                ret 12_u32
            }
        }
        Err(_) => {
            ret 13_u32
        }
    }
    if read_file("target/tests/with-try-owned.txt") != "aabcc" {
        ret 8_u32
    }
    if remove_file("target/tests/with-try-owned.txt") != 0_i32 {
        ret 9_u32
    }
    ret 0_u32
}
