//! Mutable capability removal preserves the stored raw pointer type.
fn pointer(bits: usize) -> u8* {
    unsafe {
        unsafe ehir {
            value: u8 * = pcast bits: usize, u8 *
        }
        ret value
    }
}
fn address(value: u8*) -> usize {
    unsafe {
        unsafe ehir {
            bits: usize = pcast value: u8 *, usize
        }
        ret bits
    }
}
fn choose(first: u8*, second: u8*) -> u8* {
    let mut selected = first
    selected = second
    ret selected
}
fn main() -> u32 {
    ret if address(choose(pointer(1_usize), pointer(2_usize))) == 2_usize {
        0
    } else {
        1
    }
}
