//! Regression for issue #149.
import core::option::Option
fn choose(value: Option[u32]) -> u32 {
    let mut selected = match value {
        Some(previous) => {
            if previous == 0_u32 {
                ret 0_u32
            }
            previous
        }
        None => {
            ret 1_u32
        }
    }
    selected += 1_u32
    ret selected
}
fn main() -> u32 {
    ret choose(Option[u32]::Some(1_u32)) - 2_u32
}
