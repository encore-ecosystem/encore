import core::option::Option
import core::result::Result
import core::testing::*
import core::vec::Vec

struct Holder[T] {
    value: T
}

impl[T] for Holder[T] {
    pub fn new(value: T) -> Self {
        ret Self{value}
    }

    pub fn get(self) -> T {
        ret self.value
    }
}

fn identity[T](value: T) -> T {
    ret value
}

fn none[T]() -> Option[T] {
    ret Option::None
}

fn ok[T, E](value: T) -> Result[T, E] {
    ret Result::Ok(value)
}

fn main() -> u32 {
    let n: Option[u32] = none()
    if !assert(n.is_none()) {
        ret 1_u32
    }

    let r: Result[u32, str] = ok(9_u32)
    match r {
        Result::Ok(value) => {
            if !assert(value == 9_u32) {
                ret 1_u32
            }
        }
        Result::Err(_) => {
            ret 1_u32
        }
    }

    let mut items = Vec[Holder[u32]]::new()
    items.push(Holder::new(identity(3_u32)))
    items.push(Holder::new(4_u32))
    let mut sum = 0_u32
    for item in items {
        sum = sum + item.get()
    }

    if !assert(sum == 7_u32) {
        ret 1_u32
    }
    ret 0_u32
}
