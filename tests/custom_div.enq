import core::ops::{Add, Div}

struct Number {
    value: u32
}

impl Add[u32] for Number {
    fn op(self: Self, other: u32) -> Self {
        ret Number { self.value + other }
    }
}

impl Div[u32] for Number {
    fn op(self: Self, other: u32) -> Self {
        ret Number { self.value / other }
    }
}

fn main() -> u32 {
    let original = Number { 120_u32 }
    let divided = original / 3_u32 / 4_u32
    let added = original + 3_u32
    if divided.value != 10_u32 || original.value != 120_u32 || added.value != 123_u32 {
        ret 1
    }
    if 120_u32 / 3_u32 / 4_u32 != 10_u32 {
        ret 2
    }
    ret 0
}
