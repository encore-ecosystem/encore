//! Active contexts close in reverse order, without resuming an abandoned body.
import core::iter::Generator
import core::ops::ContextManager
import core::testing::assert
import std::os::{read_file, write_file_atomic, remove_file}

struct Resource { label: str }
impl ContextManager for Resource {
    fn with_enter(self: Self) -> Self {
        write_file_atomic("target/tests/generator-resources.txt",
            read_file("target/tests/generator-resources.txt") + "+" + self.label)
        ret self
    }
    fn with_exit(self: Self) -> bool {
        ret write_file_atomic("target/tests/generator-resources.txt",
            read_file("target/tests/generator-resources.txt") + "-" + self.label) == 0_i32
    }
}
#attr(safe)
fn numbers() -> usize {
    with Resource{"a"} as outer {
        with Resource{"b"} as inner {
            yield 1_usize
            yield 2_usize
            write_file_atomic("target/tests/generator-resources.txt", "body resumed")
        }
    }
}
fn abandon() {
    let values = numbers()
    for value in values { break }
}
fn main() -> u32 {
    write_file_atomic("target/tests/generator-resources.txt", "")
    let never_started = numbers()
    if !assert(read_file("target/tests/generator-resources.txt") == "") { ret 1_u32 }
    abandon()
    if !assert(read_file("target/tests/generator-resources.txt") == "+a+b-b-a") { ret 2_u32 }
    remove_file("target/tests/generator-resources.txt")
    ret 0_u32
}
