import core::vec::Vec

struct Bag {
    values: Vec[u32]
}

struct Helper {
    marker: u32
}

impl for Helper {
    fn append(self: Self, values: mut Vec[u32], value: u32) ->() {
        if self.marker == 1_u32 {
            values.push(value)
        }
        ret()
    }
}

fn append(values: mut Vec[u32], value: u32) ->() {
    values.push(value)
    ret()
}

fn main() -> u32 {
    let mut bag = Bag {
        Vec[u32]::new()
    }
    append(bag.values, 7_u32)
    let helper = Helper {
        1_u32
    }
    helper.append(bag.values, 9_u32)
    ret if bag.values.len() == 2_usize &&
    bag.values.get(0_usize).unwrap_or(0_u32) == 7_u32 &&
    bag.values.get(1_usize).unwrap_or(0_u32) == 9_u32 {
        0_u32
    } else {
        1_u32
    }
}
