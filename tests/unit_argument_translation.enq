//! Calls preserve unit types without introducing an SSA register for unit.
import ehirlib::{parse_module_text, prepare_module, PreparationOutcome}
import refrain::frontend::translator::translate_to_ehir
import refrain::frontend::{Lexer, Parser}
import std::io::eprintln
fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("unit-argument")
    let output = translate_to_ehir(parser.parse(lexer.tokenize("fn take(value: ()) -> u32 { ret 0_u32 } fn main() -> u32 { ret take(()) }")))
    if !output.contains("void: ()") {
        ret 1
    }
    match prepare_module(parse_module_text("unit-argument", output)) {
        PreparationOutcome::Ready(_) => {
            ret 0
        }
        PreparationOutcome::Error(message) => {
            eprintln(message) ret 2
        }
    }
}
