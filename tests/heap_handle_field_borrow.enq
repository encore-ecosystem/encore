struct Inner {
    value: u32
}

struct Outer {
    prefix: u32
    first: Inner<H>
    middle: u64
    second: Inner<H>
}

fn increment(value: Inner&) -> () {
    value.value += 1_u32
}

fn main() -> u32 {
    // Keep both non-leading heap fields in the runtime regression.
    let outer = Outer<H>{9_u32, Inner<H>{10_u32}, 11_u64, Inner<H>{20_u32}}
    increment(outer.first)
    increment(outer.second)
    ret if outer.first.value == 11_u32 && outer.second.value == 21_u32 {
        0_u32
    } else {
        1_u32
    }
}
