// @expect.compile_error=operator-implementation
import core::ops::Add
struct Number { value: u32 }
impl Add[u32, u32] for Number {
    fn op(self: Self, other: u32) -> u32 { ret other }
}
impl Add[u32, u64] for Number {
    fn op(self: Self, other: u32) -> u64 { ret other as u64 }
}
fn main() -> u32 {
    let invalid = Number{1_u32} + 2_u32
    ret 0_u32
}
