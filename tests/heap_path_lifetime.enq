import core::testing::*
import std::os::path_separator
import std::path::Path

fn check_path(value: str, expected: str) -> bool {
    let path = Path::new(value)
    ret path.as_str() == expected
}

fn check_normalize(value: str, expected: str) -> bool {
    let path = Path::new(value).normalize()
    ret path.as_str() == expected
}

fn main() -> u32 {
    let sep = path_separator()
    if !assert(check_path("alpha/beta/gamma", "alpha" + sep + "beta" + sep + "gamma")) {
        ret 1_u32
    }
    if !assert(check_path("/tmp/example.txt", sep + "tmp" + sep + "example.txt")) {
        ret 1_u32
    }
    if !assert(check_normalize("alpha/./beta/../gamma", "alpha" + sep + "gamma")) {
        ret 1_u32
    }
    ret 0_u32
}
