import core::option::Option

struct Holder {
    value: Option[u32]
}

fn choose(input: Option[u32]) -> Holder {
    let output: Option[u32] = match input {
        Option::Some(value) => {
            if value == 0_u32 {
                Option::None
            } else {
                Option::Some(value)
            }
        }
        Option::None => Option::None
    }
    ret Holder { output }
}

fn main() -> u32 {
    if choose(Option[u32]::None).value.is_some() {
        ret 1
    }
    if choose(Option[u32]::Some(0_u32)).value.is_some() {
        ret 2
    }
    if choose(Option[u32]::Some(42_u32)).value.unwrap_or(0_u32) != 42_u32 {
        ret 3
    }
    ret 0
}
