fn must_not_run() -> bool {
    let zero = 0_u32
    ret (1_u32 / zero) == 0_u32
}

fn main() -> u32 {
    if false && must_not_run() { ret 1_u32 }
    if !(true || must_not_run()) { ret 2_u32 }
    if !(true && true) { ret 3_u32 }
    if !(false || true) { ret 4_u32 }
    let nested = false && must_not_run() || true
    if !nested { ret 5_u32 }
    ret 0_u32
}
