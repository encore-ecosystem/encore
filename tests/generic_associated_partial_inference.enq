//! Owner arguments are explicit; the method's own arguments come from values.
struct Box[Tag, Value] {
    tag: Tag
    value: Value
}
struct Factory[Tag] {
}

impl[Tag] for Factory[Tag] {
    pub fn make[Value](tag: Tag, value: Value) -> Box[Tag, Value] {
        ret Box[Tag, Value] { tag, value }
    }
}
fn main() -> u32 {
    let first = Factory[str]::make("label", 42_u32)
    if first.tag != "label" || first.value != 42_u32 {
        ret 1
    }
    let second = Factory[bool]::make(true, "owned" + " value")
    if !second.tag || second.value != "owned value" {
        ret 2
    }
    ret 0
}
