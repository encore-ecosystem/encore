// @expect.compile_error=cannot pass frozen region 'values'
import core::vec::Vec

struct Reader {}

impl for Reader {
    fn mutate(self: Reader, values: mut Vec[str]) -> () {
        values.push("forbidden")
        ret()
    }
}

fn inspect(values: frozen Vec[str]) -> () {
    Reader{}.mutate(values)
    ret()
}

fn main() -> u32 {
    inspect(Vec[str]::new())
    ret 0_u32
}
