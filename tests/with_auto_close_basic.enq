import core::testing::*
import core::ops::ContextManager

struct Dummy {
    value: u32
}

impl ContextManager for Dummy {
    fn with_enter(self: Dummy) -> Dummy {
        ret self
    }

    fn with_exit(self: Dummy) -> bool {
        ret true
    }
}

fn main() -> u32 {
    let mut seen = 0_u32
    with Dummy{7_u32} as resource {
        seen = resource.value
    }

    if !assert(seen == 7_u32) {
        ret 1_u32
    }
    ret 0_u32
}
