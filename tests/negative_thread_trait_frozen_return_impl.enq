// @expect.compile_error=trait requires a frozen return
import core::vec::Vec

trait Snapshot {
    fn snapshot(self: Self) -> frozen Vec[str]
}

struct Source {}

impl Snapshot for Source {
    fn snapshot(self: Source) -> Vec[str] {
        ret Vec[str]::new()
    }
}

fn main() -> u32 {
    ret 0_u32
}
