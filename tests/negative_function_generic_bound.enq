// @expect.compile_error=error[generic-bound-not-satisfied]: type 'str' does not satisfy bound 'NumericValue' for generic parameter 'T' of 'identity'

trait NumericValue {}
impl NumericValue for u32 {}

fn identity[T:NumericValue](value: T) -> T {
    ret value
}

fn main() -> u32 {
    let invalid = identity[str]("text")
    ret 0_u32
}
