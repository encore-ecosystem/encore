//! Call results do not inherit their receiver's mutable storage address.

import core::option::Option
import std::vec::Vec

struct Snapshot {
    values: Vec[u32]
}

impl for Snapshot {
    fn empty() -> Self {
        ret Self{Vec[u32]::new()}
    }
}

struct State {
    snapshot: Snapshot
    reads: usize
}

impl for State {
    fn read(self: mut Self) -> Option[Snapshot] {
        self.reads += 1
        ret Option[Snapshot]::Some(self.snapshot)
    }
}

fn main() -> u32 {
    let mut state = State{Snapshot{Vec[u32]::new()}, 0}
    state.snapshot.values.push(7)
    if state.snapshot.values.len() != 1 { ret 1 }
    // Keep this chained form: the field belongs to a temporary aggregate,
    // not to the mutable slot holding state, even inside a logical RHS.
    if state.reads == 0 && state.read().unwrap_or(Snapshot::empty()).values.len() == 1 {
        ret if state.reads == 1 && state.snapshot.values.len() == 1 { 0 } else { 2 }
    }
    ret 3
}
