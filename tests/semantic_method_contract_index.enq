//! Trait contract preparation preserves private members and generic impls.
import core::option::Option
import core::testing::assert
import std::vec::Vec
import refrain::frontend::AnalysisDatabase
import refrain::frontend::semantic_index::PackageSemanticIndex

fn source(with_read: bool) -> str {
    let parent = if with_read { "pub trait Parent[T] { fn read(self:Self) -> T }\n" } else { "pub trait Parent[T] {}\n" }
    ret parent + "pub trait Child[T] < Parent[T] { fn extra(self:Self) -> T }\n" +
        "pub struct Left {}\npub struct Right {}\npub struct Third {}\n" +
        "impl Child[u32] for Left { fn read(self:Self) -> u32 { ret 1_u32 } fn extra(self:Self) -> u32 { ret 2_u32 } fn secret(self:Self) -> bool { ret false } pub fn visible(self:Self) -> bool { ret true } }\n" +
        "impl Child[u32] for Right { fn read(self:Self) -> u32 { ret 1_u32 } fn extra(self:Self) -> u32 { ret 2_u32 } fn secret(self:Self) -> bool { ret false } pub fn visible(self:Self) -> bool { ret true } }\n" +
        "impl Child[str] for Third { fn read(self:Self) -> str { ret \"one\" } fn extra(self:Self) -> str { ret \"two\" } fn secret(self:Self) -> bool { ret false } pub fn visible(self:Self) -> bool { ret true } }\n"
}
fn verify(database: mut AnalysisDatabase, with_read: bool) -> bool {
    let identity = database.semantic_package_identity(vec!["traits"])
    database.prepare_package_semantics(vec!["traits"], identity, Option[PackageSemanticIndex]::None)
    let snapshot = database.package_semantic_index().unwrap_or(PackageSemanticIndex::empty())
    let view = match snapshot.module("traits") { Some(value) => value None => { ret false } }
    let mut count = 0_usize
    for method in snapshot.methods_for(view) {
        if method.declaration_receiver != "Left" && method.declaration_receiver != "Right" && method.declaration_receiver != "Third" { continue }
        count += 1_usize
        let expected = if method.name == "read" { with_read } else { method.name == "extra" || method.name == "visible" }
        if method.is_public != expected { ret false }
    }
    ret count == 12_usize
}
fn main() -> u32 {
    let mut database = AnalysisDatabase::new()
    database.set_module("traits", "traits.enq", source(true))
    if !assert(verify(database, true)) { ret 1_u32 }
    database.set_module("traits", "traits.enq", source(false))
    if !assert(verify(database, false)) { ret 2_u32 }
    ret 0_u32
}
