//! Canonical type keys preserve declaration identity through aliases and nesting.

import core::testing::assert
import core::vec::Vec
import refrain::frontend::AnalysisDatabase
import refrain::frontend::semantic::{SemanticField, SemanticMethod, semantic_members}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    let left = "pub struct Box[T] {}\npub struct Item {}"
    db.set_module("left", "left.enq", left)
    db.set_module("mirror", "left.enq", left)
    db.set_module("right", "right.enq", "pub struct Box[T] {}\npub struct Item {}")
    db.set_module("api", "api.enq", "pub import left::Box as Exported")
    db.set_module("app", "app.enq", "import left::Box as Left\nimport right::Box as Right\nimport mirror::Box as Mirror\nimport api::Exported\nimport left::Item as LeftItem\nimport right::Item as RightItem")
    let none = Vec[str]::new()
    let first = db.resolve_type_identity("app", "Left[u32]", "", none)
    if !assert(first.value() != 0_u64 && first.display_name() == "Left[u32]") { ret 1_u32 }
    if !assert(first.key() != db.resolve_type_identity("app", "Right[u32]", "", none).key()) { ret 2_u32 }
    if !assert(first.key() == db.resolve_type_identity("app", "Mirror[u32]", "", none).key()) { ret 3_u32 }
    if !assert(first.key() == db.resolve_type_identity("app", "Exported[ u32 ]", "", none).key()) { ret 4_u32 }
    if !assert(first.key() == db.resolve_type_identity("app", "left::Box[u32]", "", none).key()) { ret 5_u32 }
    if !assert(db.resolve_type_identity("app", "Left[LeftItem]", "", none).key()
        != db.resolve_type_identity("app", "Left[RightItem]", "", none).key()) { ret 6_u32 }
    if !assert(db.resolve_type_identity("app", "(Left[u32], [RightItem; 2])", "", none).value() != 0_u64) { ret 7_u32 }
    if !assert(db.resolve_type_identity("app", "Left[Missing]", "", none).value() == 0_u64) { ret 8_u32 }
    if !assert(db.resolve_type_identity("app", "Left[u32", "", none).value() == 0_u64) { ret 9_u32 }
    if !assert(db.resolve_type_identity("app", "Left[u32)", "", none).value() == 0_u64) { ret 10_u32 }
    let mut generics = Vec[str]::new()
    generics.push("Left")
    let parameter = db.resolve_type_identity("app", "Left", "fn:first", generics)
    if !assert(parameter.value() != 0_u64) { ret 11_u32 }
    if !assert(parameter.key() != db.resolve_type_identity("app", "Left", "fn:second", generics).key()) { ret 12_u32 }
    if !assert(parameter.key() != db.resolve_type_identity("app", "Left", "", none).key()) { ret 13_u32 }
    db.set_module("api", "api.enq", "pub import right::Box as Exported")
    if !assert(first.key() != db.resolve_type_identity("app", "Exported[u32]", "", none).key()) { ret 14_u32 }
    if !assert(db.resolve_type_identity("app", "Self", "", none).value() == 0_u64) { ret 15_u32 }
    let mut parameters = Vec[str]::new()
    parameters.push("T")
    let field = SemanticField::new("left", "Box[T]", "value", "T").with_generics(parameters)
    let scoped = field.in_receiver_scope("Alias[T]", "T")
    let mut fields = Vec[SemanticField]::new()
    fields.push(scoped)
    let members = semantic_members("Alias[u32]", fields, Vec[SemanticMethod]::new())
    match members.get(0_usize) {
        Some(member) => {
            if !assert(member.typ == "u32" && member.declaration_owner == "Box") { ret 16_u32 }
        }
        None => { ret 17_u32 }
    }
    if !assert(scoped.signature == field.signature && scoped.declaration_owner == "Box[T]") { ret 18_u32 }
    match db.qualified_type_definition("app", "Left") {
        Some(definition) => {
            if !assert(definition.typ().key() == db.resolve_type_identity("app", "Left", "", none).key()) { ret 19_u32 }
        }
        None => { ret 20_u32 }
    }
    ret 0_u32
}
