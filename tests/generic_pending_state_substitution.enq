//! Regression for issue #159.
import core::future::{Future, Poll, Context, context}
import core::result::Result
struct Payload[T] {
    value: T
}
struct State[T] {
    pending: bool
}

impl[T] Future[Result[Payload[T], str]] for State[T] {
    fn poll(self: Self, ctx: Context) -> Poll[Self, Result[Payload[T], str]] {
        if self.pending {
            ret Poll[Self, Result[Payload[T], str]]::Pending(Self { false })
        }
        ret Poll[Self, Result[Payload[T], str]]::Ready(Result::Err("no value"))
    }
}
fn main() -> u32 {
    let state = State[u32] { true } let _step = state.poll(context(0_usize)) ret 0_u32
}
