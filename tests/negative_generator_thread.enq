// @expect.compile_error=cannot cross a thread boundary
import core::iter::Generator
fn values() -> usize { yield 1_usize }
fn consume(items: Generator[usize]) -> usize {
    for item in items { ret item }
    ret 0_usize
}
fn main() -> u32 {
    let worker = spawn consume(values())
    ret worker.join() as u32
}
