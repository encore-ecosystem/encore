//! From, reciprocal Into, contextual targets and error propagation.
import core::convert::{From, Into}
import core::result::Result
import core::testing::assert

struct UserId {
    value: u32
}

impl From[u32] for UserId {
    fn from(value: u32) -> Self {
        ret Self { value }
    }
}
struct SourceError {
    code: u32
}
struct AppError {
    code: u32
}

impl From[SourceError] for AppError {
    fn from(value: SourceError) -> Self {
        ret Self { value.code + 1_u32 }
    }
}
fn fail() -> Result[u32, SourceError] {
    ret Result::Err(SourceError { 9_u32 })
}
fn propagate() -> Result[u32, AppError] {
    ret Result::Ok(fail()?)
}
fn consume(id: UserId) -> u32 {
    ret id.value
}
fn generic_into[S: Into[T], T](value: S) -> T {
    ret value.into()
}
fn wrapped_into[S: Into[T], T](value: S) -> T {
    ret generic_into[S, T](value)
}
fn converted_return(value: u32) -> UserId {
    ret value.into()
}
fn generic_from[T: From[S], S](value: S) -> T {
    ret T::from(value)
}
fn main() -> u32 {
    let generic_float: f64 = wrapped_into[u32, f64](101_u32)
    if !assert(generic_float == 101.0_f64) {
        ret 8_u32
    }
    let constructed: UserId = generic_from[UserId, u32](49_u32)
    if !assert(constructed.value == 49_u32) {
        ret 7_u32
    }
    let direct = UserId::from(42_u32)
    let generic: UserId = generic_into[u32, UserId](47_u32)
    if !assert(generic.value == 47_u32) {
        ret 6_u32
    }
    let inferred: UserId = 43_u32.into()
    let explicit = Into[UserId]::into(44_u32)
    if !assert(direct.value == 42_u32 && inferred.value == 43_u32 && explicit.value == 44_u32) {
        ret 1_u32
    }
    if !assert(consume(45_u32.into()) == 45_u32 && converted_return(46_u32).value == 46_u32) {
        ret 2_u32
    }
    let wide: u32 = 255_u8.into()
    let precise: f64 = 123_u32.into()
    if !assert(wide == 255_u32 && precise == 123.0_f64) {
        ret 3_u32
    }
    match propagate() {
        Ok(_) => {
            ret 4_u32
        }
        Err(error) => {
            if !assert(error.code == 10_u32) {
                ret 5_u32
            }
        }
    }
    ret 0_u32
}
