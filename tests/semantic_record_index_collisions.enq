//! Hash collisions and table growth must preserve exact records and ordinals.
import core::fmt::Debug
import core::testing::assert
import refrain::frontend::semantic_record_index::{SemanticRecord, SemanticRecordIndex}
extern fn encore_node_debug_live_count() -> usize

struct Collision { name: str, salt: u64 }
impl SemanticRecord for Collision {
    pub fn record_hash(self: Self) -> u64 { ret 7_u64 }
    pub fn same_record(self: Self, other: Self) -> bool { ret self.name == other.name && self.salt == other.salt }
}
fn exercise() -> bool {
    let mut index = SemanticRecordIndex[Collision]::new()
    for value in 0_usize..768_usize {
        if index.intern(Collision { "key-" + Debug::fmt(value), value as u64 }) != value { ret false }
    }
    for offset in 0_usize..768_usize {
        let value = 767_usize - offset
        if index.intern(Collision { "key-" + Debug::fmt(value), value as u64 }) != value { ret false }
    }
    if index.len() != 768_usize || index.intern(Collision { "key-0", 1000_u64 }) != 768_usize { ret false }
    if index.intern(Collision { "key-0", 0_u64 }) != 0_usize { ret false }
    let values = index.values()
    ret values.len() == 769_usize && values.get_unchecked_borrowed(0_usize).salt == 0_u64 &&
        values.get_unchecked_borrowed(768_usize).salt == 1000_u64
}
fn main() -> u32 {
    let before = unsafe { encore_node_debug_live_count() }
    if !assert(exercise()) { ret 1_u32 }
    if !assert(unsafe { encore_node_debug_live_count() } == before) { ret 2_u32 }
    ret 0_u32
}
