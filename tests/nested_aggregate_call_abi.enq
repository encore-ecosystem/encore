//! Mixed-width aggregate arguments must agree across native function calls.
import core::option::Option
import core::testing::assert

import std::vec::Vec

// Mirror the shape of a parsed function followed by checked semantic facts.
// The small fields must not shift subsequent owning pointers in stack arguments.
struct Header {
    attributes: Vec[str]
    decorators: Vec[str]
    public: bool
    asynchronous: bool
    external: bool
    name: str
    documentation: Option[str]
    generics: Vec[str]
    parameters: Vec[str]
    return_type: Option[str]
    variadic: bool
    borrowed: bool
    body: Option[str]
    owner: str
    line: usize
    column: usize
}
struct Selection {
    values: Vec[str]
    ordinals: Vec[usize]
    indirect: bool
    overlay: Vec[str]
}
struct Facts {
    bindings: Vec[str]
    diagnostics: Vec[str]
    dependencies: Vec[str]
    return_type: str
    scoped: Vec[str]
    receivers: Vec[str]
    methods: Vec[str]
    names: Selection
    implicit: Vec[str]
    index: str
}
struct Checked {
    header: Header
    owner: str
    facts: Facts
}

fn make_checked() -> Checked {
    let header = Header {
        vec!["safe"], vec!["marker"], true, false, true, "compute",
        Option[str]::Some("documentation"), vec!["T"], vec!["value"],
        Option[str]::Some("u32"), false, true, Option[str]::Some("body"),
        "module", 20_usize, 7_usize
    }
    let selection = Selection { vec!["Data"], vec![0_usize], true, vec!["Extra"] }
    ret Checked {
        header, "app", Facts {
            vec!["value"], Vec[str]::new(), vec!["api"], "u32", vec!["local"],
            vec!["Data"], vec!["read"], selection, vec!["for"], "type-index"
        }
    }
}

fn inspect(value: Checked) -> bool {
    ret value.owner == "app" && value.header.owner == "module" &&
    value.header.name == "compute" && value.header.line == 20_usize &&
    value.header.column == 7_usize && value.header.public &&
    !value.header.asynchronous && value.header.external &&
    !value.header.variadic && value.header.borrowed &&
    value.facts.return_type == "u32" && value.facts.names.indirect &&
    value.facts.names.values.get(0_usize).unwrap_or("") == "Data" &&
    value.facts.index == "type-index"
}

fn main() -> u32 {
    let values = vec![make_checked()]
    // Boxing a boolean makes older GlobalISel fall back for this caller while
    // the aggregate retain helper remains on GlobalISel. Their ABIs must agree.
    let enabled = Option[bool]::Some(!values.is_empty())
    if !assert(enabled.unwrap_or(false)) {
        ret 3_u32
    }
    match values.get(0_usize) {
        Some(value) => {
            // Keep the loaded record live through another owning call.
            if !assert(inspect(value) && value.owner == "app") {
                ret 1_u32
            }
        }
        None => {
            ret 2_u32
        }
    }
    ret 0_u32
}
