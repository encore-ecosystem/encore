//! Cached equality requirements survive encoding and reject incomplete records.
import core::option::Option
import ehirlib::codegen::{CodegenRequirements, GenericRequirement}
import ehirlib::{Type, RepresentationKind, make_type, type_to_string}
import json::{Json, stringify}
import refrain::modes::build_metadata::MetadataContext
import refrain::modes::build_requirements::UnitRequirements
import std::vec::Vec

fn main() -> u32 {
    let digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let context = MetadataContext {
        "sample", digest, "x86_64-unknown-linux-gnu", "dev", digest, Vec[str]::new()
    }
    let argument = make_type("u16", Vec[Type]::new(), RepresentationKind::Inline)
    let equality = make_type("Option", vec![argument], RepresentationKind::Inline)
    let original = UnitRequirements {
        context, CodegenRequirements {
            Vec[GenericRequirement]::new(), Vec[Type]::new(), vec![equality]
        }
    }
    let encoded = original.encode().unwrap_or("")
    let restored = match UnitRequirements::decode(encoded, context) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let typ = restored.requirements.equality_types.get(0).unwrap_or(argument)
    if type_to_string(typ) != "Option[u16]" || restored.encode().unwrap_or("") != encoded {
        ret 2
    }
    let prefix = "{\"schema\":2,\"context\":" + stringify(context.encode().unwrap_or(Json::Null))
    + ",\"calls\":[],\"types\":[]"
    if UnitRequirements::decode(prefix + "}", context).is_ok() ||
    UnitRequirements::decode(prefix + ",\"equality\":{}}", context).is_ok() ||
    UnitRequirements::decode("{\"schema\":1}", context).is_ok() {
        ret 3
    }
    let wrong = MetadataContext {
        context.unit, context.compiler_digest, "aarch64-apple-darwin",
        context.profile, context.input_digest, context.features
    }
    ret if UnitRequirements::decode(encoded, wrong).is_err() {
        0
    } else {
        4
    }
}
