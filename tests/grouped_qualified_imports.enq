//! Regression for issue #142.
import core::{option::{Option as Maybe, Option as Extra}, result::Result as Outcome}
import core::option as option_namespace
fn make() -> Maybe[u32] {
    ret Maybe[u32]::Some(0_u32)
}
fn main() -> u32 {
    if make().unwrap_or(1_u32) != 0_u32 {
        ret 1_u32
    }
    let value: Extra[u32] = Extra[u32]::Some(7_u32)
    let result: Outcome[u32, str] = Outcome[u32, str]::Ok(value.unwrap_or(0_u32))
    if result.unwrap_or(0_u32) != 7_u32 {
        ret 2_u32
    }
    let namespace_value = option_namespace::Option[u32]::Some(9_u32)
    ret if namespace_value.unwrap_or(0_u32) == 9_u32 {
        0_u32
    } else {
        3_u32
    }
}
