struct ProfileManager {
    bias: u32
}

impl for ProfileManager {
    #attr(decorator)
    fn profile[Args](
        self: Self,
        func: Callable[Args, u32],
        args: Args,
        label: str
    ) -> u32 {
        let result = func(args)
        if label == "draw_frame" {
            ret result + self.bias
        }
        ret result
    }
}

static OUTER_PROFILE: ProfileManager = ProfileManager{1_u32}
static INNER_PROFILE: ProfileManager = ProfileManager{2_u32}

@OUTER_PROFILE.profile("draw_frame")
@INNER_PROFILE.profile("draw_frame")
fn draw_frame(base: u32) -> u32 {
    ret base
}

fn main() -> u32 {
    if draw_frame(39_u32) != 42_u32 {
        ret 1_u32
    }
    ret 0_u32
}
