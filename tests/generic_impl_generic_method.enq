struct Wrapper[T] {
    value: T
}

impl[T] for Wrapper[T] {
    fn pair[U](self: Self, other: U) -> (T, U) {
        ret (self.value, other)
    }
}

fn main() -> u32 {
    let wrapper = Wrapper[u32]{7_u32}
    let pair = wrapper.pair[str]("value")
    if pair.0 != 7_u32 {
        ret 1_u32
    }
    if pair.1 != "value" {
        ret 2_u32
    }
    ret 0_u32
}
