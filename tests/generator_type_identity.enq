import core::iter::Generator as Cursor
import core::testing::assert

// An unrelated local type must not shadow the implicit core cursor result.
struct Generator {
    marker: usize
}

fn values() -> usize {
    yield 2_usize
    yield 3_usize
}

fn total(cursor: core::iter::Generator[usize]) -> usize {
    let mut result = 0_usize
    for value in cursor { result += value }
    ret result
}

fn main() -> u32 {
    let marker = Generator { 7_usize }
    let cursor: Cursor[usize] = values()
    ret if assert(marker.marker == 7_usize && total(cursor) == 5_usize) { 0_u32 } else { 1_u32 }
}
