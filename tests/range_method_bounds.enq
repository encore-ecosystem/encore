struct Count {
    value: usize
}

impl for Count {
    fn count(self: Self) -> usize {
        ret self.value
    }
}
struct Narrow {
    value: u32
}

impl for Narrow {
    fn count(self: Self) -> u32 {
        ret self.value
    }
}
// A local name must not change the implicit core range contract.
fn range(left: u32, right: u32) -> u32 {
    ret left + right
}
fn main() -> u32 {
    let count = Count { 2 }
    let narrow = Narrow { 2 }
    let mut result = 0_usize
    for slot in 0..count.count() {
        result += slot
    }
    for slot in 0.. = count.count() {
        result += slot
    }
    for slot in 0..(narrow.count() as usize) {
        result += slot
    }
    ret if result == 5_usize {
        0_u32
    } else {
        1_u32
    }
}
