import core::vec::Vec
import core::option::Option

struct Cache {
    values: Vec[u32]
    updates: u32
}

fn read_value(values: Vec[u32], index: usize) -> u32 {
    match values.get(index) {
        Option::Some(value) => { ret value }
        Option::None => { ret 0_u32 }
    }
}

fn read_cache_value(cache: Cache&, index: usize) -> u32 {
    ret read_value(cache.values, index)
}

fn inspect(cache: Cache&) -> u32 {
    ret cache.values.len() as u32 + cache.updates
}

fn update(cache: mut Cache&) {
    cache.updates += 1_u32
}

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(41_u32)
    values.push(7_u32)
    if read_value(values, 0_usize) != 41_u32 ||
    read_value(values, 1_usize) != 7_u32 {
        ret 3_u32
    }
    let immutable = values
    if read_value(immutable, 0_usize) != 41_u32 ||
    read_value(immutable, 1_usize) != 7_u32 {
        ret 5_u32
    }
    let cache = Cache<H>{values, 0_u32}
    if read_cache_value(cache, 0_usize) != 41_u32 ||
    read_cache_value(cache, 1_usize) != 7_u32 {
        ret 4_u32
    }
    let mut iteration = 0_usize
    while iteration < 100000_usize {
        update(cache)
        if inspect(cache) != cache.updates + 2_u32 {
            ret 1_u32
        }
        iteration += 1_usize
    }
    ret if cache.updates == 100000_u32 &&
        cache.values.len() == 2_usize {
        0_u32
    } else {
        2_u32
    }
}
