import core::testing::assert

fn classify(value: str) -> u32 {
    ret match value {
        "alpha" => 1_u32
        "beta" => 2_u32
        _ => 0_u32
    }
}

fn main() -> u32 {
    let mut total = 0_u32
    for _ in 0..1000 {
        total = total + classify("beta")
    }
    ret if assert(total == 2000_u32) { 0_u32 } else { 1_u32 }
}
