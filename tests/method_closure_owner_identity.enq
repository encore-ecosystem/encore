//! Same-named methods in different impls own distinct closure environments.
trait Handler {
    fn handle(self: Self, value: u32) -> u32
}
struct Left {
    value: u32
}
struct Right {
    value: str
}

impl for Left {
    pub fn read(self: Self) -> u32 {
        let handler: dyn Handler = | value | self.value + value
        ret handler.handle(3_u32)
    }
}

impl for Right {
    pub fn read(self: Self) -> u32 {
        let handler: dyn Handler = | value | self.value.len() as u32 + value
        ret handler.handle(3_u32)
    }
}
fn main() -> u32 {
    let left = Left { 39_u32 }
    let right = Right { "hello" }
    if left.read() != 42_u32 || right.read() != 8_u32 {
        ret 1_u32
    }
    ret 0_u32
}
