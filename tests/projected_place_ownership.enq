//! Inline mutable projections retain their enclosing node's graph ownership.

import core::option::Option
import core::vec::Vec

extern fn encore_node_debug_live_count() -> usize

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

struct Rows {
    values: Vec[u32]
}
struct Nested {
    marker: u32
    rows: Rows
}
struct Owner {
    id: u64
    nested: Nested
}

impl for Rows {
    fn replace(self: mut Self) ->() {
        self.values = Vec[u32]::new()
        ret()
    }
}

fn replace_slot(values: mut Vec[u32]) ->() {
    values = Vec[u32]::new()
    ret()
}

fn forward_slot(values: mut Vec[u32]) ->() {
    replace_slot(values)
    ret()
}

fn replace_rows(rows: mut Rows) ->() {
    let mut next = Vec[u32]::new()
    next.push(17)
    rows = Rows { next }
    ret()
}

fn forward_rows(rows: mut Rows) ->() {
    rows.replace()
    ret()
}

struct Cell {
    value: u32
}
struct Links {
    selected: Option[Cell<H>]
}
struct Graph {
    links: Links
}

fn replace_link(links: mut Links, keep: bool) ->() {
    links.selected = if keep {
        Option[Cell<H>]::Some(Cell<H>{ 42 })
    } else {
        Option[Cell<H>]::None
    }
    ret()
}

fn exercise() -> u32 {
    let mut heap = Owner<H> {
        9,
        Nested {
            3,
            Rows { Vec[u32]::new() }
        }
    }
    let mut stack = Owner<S> {
        9,
        Nested {
            3,
            Rows { Vec[u32]::new() }
        }
    }
    let mut local = Owner {
        9,
        Nested {
            3,
            Rows { Vec[u32]::new() }
        }
    }
    let mut graph = Graph<H> {
        Links { Option[Cell<H>]::None }
    }
    for step in 0..100 {
        heap.nested.rows.values.push(42)
        heap.nested.rows.replace()
        if heap.nested.rows.values.len() != 0 {
            ret 1
        }
        heap.nested.rows.values.push(43)
        forward_slot(heap.nested.rows.values)
        if heap.nested.rows.values.len() != 0 {
            ret 2
        }
        replace_rows(heap.nested.rows)
        if heap.nested.rows.values.len() != 1 {
            ret 3
        }
        forward_rows(heap.nested.rows)
        if heap.nested.rows.values.len() != 0 {
            ret 4
        }
        stack.nested.rows.values.push(44)
        forward_rows(stack.nested.rows)
        replace_rows(stack.nested.rows)
        forward_slot(stack.nested.rows.values)
        if stack.nested.rows.values.len() != 0 {
            ret 5
        }
        local.nested.rows.values.push(45)
        forward_rows(local.nested.rows)
        replace_rows(local.nested.rows)
        forward_slot(local.nested.rows.values)
        if local.nested.rows.values.len() != 0 {
            ret 6
        }
        replace_link(graph.links, true)
        match graph.links.selected {
            Option::Some(cell) => {
                if cell.value != 42 { ret 7 }
            }
            Option::None => { ret 8 }
        }
        replace_link(graph.links, false)
    }
    ret 0
}

fn main() -> u32 {
    let before = live_nodes()
    let status = exercise()
    if status != 0 {
        ret status
    }
    ret if live_nodes() == before {
        0
    } else {
        9
    }
}
