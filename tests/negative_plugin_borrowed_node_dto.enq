// @expect.compile_error=plugin values cannot contain pointers, nodes, capabilities or unwrapped dyn objects
import std::plugin::Plugin
struct Record {
    value: u32
}
#attr(plugin_interface)
trait Bad {
    fn get(self: Self) -> Record&
}
fn main() -> u32 {
    match unsafe {
        Plugin::load("unused")
    }
    {
        Ok(plugin) => {
            let binding = plugin.bind[dyn Bad]("bad")
        }
        Err(_) => {
        }
    }
    ret 0
}
