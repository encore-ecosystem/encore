import core::option::Option
import core::vec::Vec

fn inspect(values: frozen Vec[Vec[str]]) -> usize {
    match values.get(0_usize) {
        Option::Some(inner) => { ret inner.len() }
        Option::None => { ret 0_usize }
    }
}

fn main() -> u32 {
    let mut inner = Vec[str]::new()
    inner.push("nested")
    let mut values = Vec[Vec[str]]::new()
    values.push(inner)

    let worker = spawn inspect(values)
    let local = inspect(values)
    ret if worker.join() == 1_usize && local == 1_usize { 0_u32 } else { 1_u32 }
}
