import ehirlib::{Directive, Instruction, RepresentationKind, parse_module_text}

import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source =
    "struct Bag { committed: u32 }\n" +
    "impl for Bag { fn push(self: mut Self) -> () { self.committed += 1_u32 ret () } }\n" +
    "struct Owner { bag: Bag }\n" +
    "impl for Owner { fn push(self: mut Self&) -> () { self.bag.push() ret () } }\n" +
    "struct State { dx: f32 }\nstruct Window { state: State<H> }\n" +
    "impl for Window { fn reset(self: mut Self) -> () { self.state.dx = 0.0 ret () } }\n" +
    "fn make_window() -> Window { let mut state = State<H>{1.0} state.dx = 2.0 ret Window{state} }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source(
        "node_field_mutable_receiver_translation.enq",)
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    let module = parse_module_text("node-field", output)
    let mut mutable_bag = false
    let mut heap_state = false
    for declaration in module.directives {
        match declaration {
            Directive::Impl(implementation) => {
                for function in implementation.methods {
                    for block in function.blocks {
                        for instruction in block.instructions {
                            match instruction {
                                Instruction::GetFieldPtr(value) => {
                                    if implementation.for_type.name == "Owner" && value.src.name == "self" && value.field.name == "0" {
                                        mutable_bag = true
                                    }
                                }
                                Instruction::GetField(value) => {
                                    if implementation.for_type.name == "Window" && value.src.name == "self" && value.field.name == "0" && value.out.typ.name == "State" {
                                        match value.out.typ.representation {
                                            RepresentationKind::NodeHeap => {
                                                heap_state = true
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    if implementation.for_type.name == "Owner" && function.name == "push" && output.contains("recv_storage") {
                        ret 2_u32
                    }
                }
            }
            _ => {
            }
        }
    }
    if !mutable_bag {
        ret 1_u32
    }
    if !heap_state {
        ret 3_u32
    }
    if !output.contains("setfield entry_assign_field_base_node_any_") {
        ret 4_u32
    }
    if output.contains("mut_handle ") {
        ret 5_u32
    }
    ret 0_u32
}
