import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_to_ehir

fn main() -> u32 {
    let source =
    "struct Bag { committed: u32 }\n" +
    "impl for Bag { fn push(self: mut Self) -> () { self.committed += 1_u32 ret () } }\n" +
    "struct Owner { bag: Bag }\n" +
    "impl for Owner { fn push(self: Self&) -> () { self.bag.push() ret () } }\n"
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source(
        "node_field_mutable_receiver_translation.enq",)
    let output = translate_to_ehir(parser.parse(lexer.tokenize(source)))
    if !output.contains("getfieldptr self > 0") { ret 1_u32 }
    if output.contains("Owner::push") && output.contains("recv_storage") {
        ret 2_u32
    }
    ret 0_u32
}
