import core::option::Option

fn payload_first(input: Option[i32]) -> i32 {
    let result = match input {
        Some(value) => value None => 1
    }
    ret result
}

fn literal_first(input: Option[i32]) -> i32 {
    let result = match input {
        None => {
            ( - 1)
        }
        Some(value) => value
    }
    ret result
}

fn float_join(input: Option[f32]) -> f32 {
    let result = match input {
        None => {
            let marker = 1_u32 0.25
        }
        Some(value) => value
    }
    ret result
}

fn byte_join(input: Option[u8]) -> u8 {
    let result = match input {
        None => 1 Some(value) => value
    }
    ret result
}

fn nested(input: Option[i32], other: Option[i32]) -> i32 {
    let result = match input {
        Some(value) => value
        None => match other {
            None =>( - 1) Some(value) => value
        }
    }
    ret result
}

fn explicit_context(flag: bool) -> f32 {
    let result: f32 = match flag {
        true => {
            let marker = 2_u32 0.25
        }
        false => {
            let marker = 3_u32
            0.5
        }
    }
    ret result
}

fn nested_literals(flag: bool, value: u8) -> u8 {
    let result = match flag {
        true => match flag {
            true => 1 false => 2
        }
        false => value
    }
    ret result
}

fn match_inside_if(flag: bool, value: u8) -> u8 {
    let result = if flag {
        match flag {
            true => 1 false => 2
        }
    } else {
        value
    }
    ret result
}

fn typed_match_in_condition(input: Option[i32]) -> u32 {
    ret if (match input {
            Some(value) => value None => 1_i32
        }
    ) == 1_i32 {
        0
    } else {
        1
    }
}

fn literal_match_in_condition(input: Option[i32]) -> u32 {
    ret if (match input {
            Some(value) => value None => 1
        }
    ) == 1_i32 {
        0
    } else {
        1
    }
}

fn match_scrutinee(input: Option[i32]) -> u32 {
    let result: u32 = match (match input {
            Some(value) => value None => 1_i32
        }
    ) {
        1_i32 => 0_u32
        _ => 1_u32
    }
    ret result
}

fn main() -> u32 {
    if payload_first(Option[i32]::None) != 1_i32 {
        ret 1
    }
    if payload_first(Option[i32]::Some(42_i32)) != 42_i32 {
        ret 2
    }
    if literal_first(Option[i32]::None) != - 1_i32 {
        ret 3
    }
    if literal_first(Option[i32]::Some(42_i32)) != 42_i32 {
        ret 4
    }
    if float_join(Option[f32]::None) != 0.25_f32 {
        ret 5
    }
    if float_join(Option[f32]::Some(1.5_f32)) != 1.5_f32 {
        ret 6
    }
    if byte_join(Option[u8]::None) != 1_u8 {
        ret 7
    }
    if byte_join(Option[u8]::Some(42_u8)) != 42_u8 {
        ret 8
    }
    if nested(Option[i32]::None, Option[i32]::None) != - 1_i32 {
        ret 9
    }
    if nested(Option[i32]::None, Option[i32]::Some(42_i32)) != 42_i32 {
        ret 10
    }
    if explicit_context(true) != 0.25_f32 || explicit_context(false) != 0.5_f32 {
        ret 11
    }
    if nested_literals(true, 42_u8) != 1_u8 || nested_literals(false, 42_u8) != 42_u8 {
        ret 12
    }
    if match_inside_if(true, 42_u8) != 1_u8 || match_inside_if(false, 42_u8) != 42_u8 {
        ret 13
    }
    if typed_match_in_condition(Option[i32]::None) != 0_u32 || typed_match_in_condition(Option[i32]::Some(2_i32)) != 1_u32 {
        ret 14
    }
    if literal_match_in_condition(Option[i32]::None) != 0_u32 || literal_match_in_condition(Option[i32]::Some(2_i32)) != 1_u32 {
        ret 15
    }
    if match_scrutinee(Option[i32]::None) != 0_u32 || match_scrutinee(Option[i32]::Some(2_i32)) != 1_u32 {
        ret 16
    }
    ret 0
}
