//! Value blocks evaluate ordinary statements and preserve their final value.
struct Counter { value: u32 }
impl for Counter {
    fn touch(self: mut Self&) -> u32 { self.value += 1 ret self.value }
}
fn main() -> u32 {
    let mut counter = Counter<H>{ 0 }
    let value = {
        counter.touch()
        let result = 41
        counter.touch()
        result + 1
    }
    if value != 42 || counter.value != 2 { ret 1 }
    let selected = match value {
        42 => {
            counter.touch()
            let result = 50
            counter.touch()
            result + 2
        }
        _ => 0
    }
    if selected != 52 || counter.value != 4 { ret 2 }
    let conditional = { if selected == 52 { 7 } else { 9 } }
    if conditional != 7 { ret 3 }
    let looped = {
        let mut count = 0_u32
        for _index in 0..3 { count += 1 }
        count
    }
    ret if looped == 3 { 0 } else { 4 }
}
