//! New locals share nested nodes, never another local's rebindable slot (#102).
import core::vec::Vec

extern fn encore_node_debug_live_count() -> usize

#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}

fn vector(value: u32) -> Vec[u32] {
    let mut values = Vec[u32]::new()
    values.push(value)
    ret values
}

struct Bag {
    marker: u32
    values: Vec[u32]
}
struct Cell {
    value: u32
}

fn swap_rows() -> bool {
    let mut first = vector(1)
    let mut second = vector(2)
    for index in 0..32 {
        let mut saved = first
        first = second
        second = saved
        let expected = if index % 2 == 0 {
            2_u32
        } else {
            1_u32
        }
        if first.get(0).unwrap_or(0) != expected || second.get(0).unwrap_or(0) != 3 - expected {
            ret false
        }
    }
    second.set(0, 9)
    ret first.get(0).unwrap_or(0) == 1 && second.get(0).unwrap_or(0) == 9
}

fn shared_elements_independent_rebinding() -> bool {
    let mut first = vector(1)
    let mut second = first
    second.push(2)
    if first.len() != 2 {
        ret false
    }
    second = vector(7)
    if first.len() != 2 || first.get(0).unwrap_or(0) != 1 {
        ret false
    }
    first = vector(8)
    first = first
    ret first.get(0).unwrap_or(0) == 8 && second.get(0).unwrap_or(0) == 7
}

fn independent_inline_payloads() -> bool {
    let mut first = Bag { 1, vector(3) }
    let mut second = first
    second.marker = 2
    second.values.push(4)
    if first.marker != 1 || first.values.len() != 2 {
        ret false
    }
    second.values = vector(9)
    if first.values.len() != 2 {
        ret false
    }
    first = Bag { 8, vector(10) }
    ret second.marker == 2 && second.values.get(0).unwrap_or(0) == 9
}

fn replace_argument(values: mut Vec[u32]) -> Vec[u32] {
    let mut saved = values
    values = vector(7)
    saved.set(0, 9)
    ret saved
}

fn independent_parameter_copy() -> bool {
    let mut values = vector(3)
    let saved = replace_argument(values)
    ret values.get(0).unwrap_or(0) == 7 && saved.get(0).unwrap_or(0) == 9
}

fn independent_node_bindings() -> bool {
    let mut first = Cell<H>{ 1 }
    let mut second = first
    second.value = 2
    if first.value != 2 {
        ret false
    }
    second = Cell<H>{ 3 }
    if first.value != 2 || second.value != 3 {
        ret false
    }
    let mut erased: Cell& = Cell<H>{ 4 }
    let mut erased_copy = erased
    erased_copy.value = 5
    if erased.value != 5 {
        ret false
    }
    erased_copy = Cell<H>{ 6 }
    if erased.value != 5 || erased_copy.value != 6 {
        ret false
    }
    let mut stack = Cell<S>{ 7 }
    let mut stack_copy = stack
    stack_copy.value = 8
    if stack.value != 8 {
        ret false
    }
    stack_copy = Cell<S>{ 9 }
    ret stack.value == 8 && stack_copy.value == 9
}

fn exercise() -> u32 {
    if !swap_rows() {
        ret 1
    }
    if !shared_elements_independent_rebinding() {
        ret 2
    }
    if !independent_inline_payloads() {
        ret 3
    }
    if !independent_parameter_copy() {
        ret 4
    }
    if !independent_node_bindings() {
        ret 5
    }
    ret 0
}

fn main() -> u32 {
    let initial = exercise()
    if initial != 0 {
        ret initial
    }
    let before = live_nodes()
    for _ in 0..32 {
        let result = exercise()
        if result != 0 {
            ret result
        }
    }
    ret if live_nodes() == before {
        0
    } else {
        6
    }
}
