fn main() -> u32 {
    let maximum = 4294967295_u32
    if !(maximum > 0_u32) { ret 1_u32 }
    if !(0_u32 < maximum) { ret 2_u32 }
    if maximum <= 2147483647_u32 { ret 3_u32 }

    let negative = -9_i32
    if negative / 2_i32 != -4_i32 { ret 4_u32 }
    if negative % 2_i32 != -1_i32 { ret 5_u32 }
    if (-8_i32 >> 2_i32) != -2_i32 { ret 6_u32 }
    ret 0_u32
}
