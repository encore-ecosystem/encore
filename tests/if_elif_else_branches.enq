import core::testing::*

fn classify(x: u32) -> u32 {
    if x < 5_u32 {
        ret 1_u32
    } elif x < 10_u32 {
        ret 2_u32
    } else {
        ret 3_u32
    }
}

fn main() -> u32 {
    let a = classify(3_u32)
    let b = classify(7_u32)
    let c = classify(15_u32)

    if !assert(a + b + c == 6_u32) {
        ret 1_u32
    }
    ret 0_u32
}
