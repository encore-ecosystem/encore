//! Regression for issue #146.
import ehirlib::{parse_module_bundle_text, module_bundle_to_string}
import core::option::Option

import std::io::println
fn main() -> u32 {
    let original = parse_module_bundle_text("app@tests/пример.enq", "module app@tests/пример.enq {\n}\n")
    let bundle = parse_module_bundle_text("app@tests/пример.enq", module_bundle_to_string(original))
    match bundle.modules.get(0_usize) {
        Option::Some(value) => {
            println(value.name) ret if value.name == "app@tests/пример.enq" {
                0_u32
            } else {
                1_u32
            }
        }
        Option::None => {
            ret 2_u32
        }
    }
}
