//! Borrowing Vec storage must not retain a raw pointer to an owned tuple.
struct Storage {
    data:(str, str)*
}
fn observe(pointer:(str, str)*) -> usize {
    unsafe {
        ret pointer as usize
    }
}
fn forward(storage: Storage) -> usize {
    unsafe {
        ret observe(storage.data)
    }
}
fn main() -> u32 {
    let pointer = unsafe {
        42_usize as(str, str)*
    }
    if forward(Storage { pointer }) != 42_usize {
        ret 2_u32
    }
    let mut values = Vec[(str, str)]::new()
    values.push(("first", "second"))
    values.push(("third", "fourth"))
    let mut copied = Vec[(str, str)]::new()
    for pair in values {
        copied.push(pair)
    }
    let first = copied.get(0_usize).unwrap_or(("", ""))
    let second = copied.get(1_usize).unwrap_or(("", ""))
    ret if copied.len() == 2_usize && first.0 == "first" && first.1 == "second" &&
    second.0 == "third" && second.1 == "fourth" {
        0_u32
    } else {
        1_u32
    }
}
