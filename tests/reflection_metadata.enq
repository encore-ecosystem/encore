//! Field annotations survive structured metadata, and editor bindings keep scopes.
import core::vec::Vec
import refrain::frontend::metadata_ast::{encode_metadata_ast, decode_metadata_ast}
import refrain::frontend::parser::Statement
import refrain::frontend::reflection::reflection_binding_sites
import refrain::frontend::{Lexer, Parser}
fn main() -> u32 {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("reflection-metadata")
    let source = "struct Asset { #serialize(rename = \"old_name\") name: str }\n" +
    "fn inspect[T](value: T) -> u32 {\n" +
    "let info = reflect::type_info[T]()\n" +
    "for field in info.fields() { field.name() }\n" +
    "ret 0\n}\n"
    let ast = parser.parse(lexer.tokenize(source))
    let restored = match decode_metadata_ast(encode_metadata_ast(ast)) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let mut attribute = false
    let mut info_binding = false
    let mut field_binding = false
    for statement in restored {
        match statement {
            Statement::Struct(item) => {
                let field = match item.named_fields.get(0) {
                    Some(value) => value None => {
                        ret 2
                    }
                }
                match field.attributes.get(0) {
                    Some(value) => {
                        attribute = value.0 == "serialize.rename" && value.1 == "old_name"
                    }
                    None => {
                        ret 3
                    }
                }
            }
            Statement::Function(item) => {
                for site in reflection_binding_sites(item) {
                    if site.name == "info" && site.typ == "core::reflect::TypeInfo[T]" {
                        info_binding = true
                    }
                    if site.name == "field" && site.typ == "core::reflect::FieldInfo[T, _]" {
                        field_binding = site.scope.0 == 3 && site.scope.2 == 3
                    }
                }
            }
            _ => {
            }
        }
    }
    if !attribute {
        ret 4
    }
    if !info_binding {
        ret 5
    }
    if !field_binding {
        ret 6
    }
    ret 0
}
