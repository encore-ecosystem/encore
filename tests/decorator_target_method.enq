struct ProfileManager {
    bias: u32
}

impl for ProfileManager {
    #attr(decorator)
    fn profile[Args](
        self: Self,
        func: Callable[Args, u32],
        args: Args,
        label: str
    ) -> u32 {
        let result = func(args)
        if label == "draw_frame" {
            ret result + self.bias
        }
        ret result
    }
}

static RENDER_PROFILE: ProfileManager = ProfileManager{2_u32}

struct Renderer {
    base: u32
}

impl for Renderer {
    @RENDER_PROFILE.profile("draw_frame")
    fn draw_frame(self: Self, add: u32) -> u32 {
        ret self.base + add
    }
}

fn main() -> u32 {
    let renderer = Renderer{40_u32}
    if renderer.draw_frame(0_u32) != 42_u32 {
        ret 1_u32
    }
    ret 0_u32
}
