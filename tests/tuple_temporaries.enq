//! Adjacent and nested tuples keep distinct temporaries and field values (#110).
import core::vec::Vec

fn adjacent(first:(str, str), second:(str, str)) -> bool {
    ret first.0 == "a" && first.1 == "b" && second.0 == "c" && second.1 == "d"
}

fn main() -> u32 {
    let mut joined = ""
    let mut count = 0_usize
    for pair in vec![("a", "b"),("c", "d")] {
        joined = joined + pair.0 + pair.1
        count = count + 1_usize
    }
    if joined != "abcd" || count != 2_usize {
        ret 1
    }
    if !adjacent(("a", "b"),("c", "d")) {
        ret 2
    }

    let mut nested_joined = ""
    for group in vec![(("e", "f"),("g", "h")),(("i", "j"),("k", "l"))] {
        let first = group.0
        let second = group.1
        nested_joined = nested_joined + first.0 + first.1 + second.0 + second.1
    }
    if nested_joined != "efghijkl" {
        ret 3
    }

    let numbers: Vec[(u8, f32)] = vec![(1, 1.5),(2, 2.5)]
    let mut integer_sum = 0_u32
    let mut float_sum = 0.0_f32
    for pair in numbers {
        integer_sum = integer_sum + pair.0 as u32
        float_sum = float_sum + pair.1
    }
    if integer_sum != 3_u32 || float_sum != 4.0_f32 {
        ret 4
    }

    let left = "left" + " value"
    let right = "right" + " value"
    let mut borrowed_joined = ""
    for pair in vec![(left, right),(right, left)] {
        borrowed_joined = borrowed_joined + pair.0 + pair.1
    }
    if borrowed_joined != "left valueright valueright valueleft value" || left != "left value" || right != "right value" {
        ret 5
    }
    ret 0
}
