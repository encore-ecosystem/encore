//! Defaults and named calls preserve source evaluation order and declaration ABI.
import core::testing::assert

fn weighted(x: u32, y: u32 = 2, z: u32 = 3) -> u32 {
    ret x * 100_u32 + y * 10_u32 + z
}
fn label(value: str = "default", enabled: bool = true, scale: f64 = -1.5) -> str {
    if enabled && scale < 0.0 { ret value }
    ret "disabled"
}
struct Calculator { base: u32 }
impl for Calculator {
    fn add(self: Self, value: u32 = 2) -> u32 { ret self.base + value }
}
fn mark(trace: mut u32, value: u32) -> u32 {
    trace = trace * 10_u32 + value
    ret value
}
fn literal_defaults(low: i8 = -128, high: u8 = 255, enabled: bool = false, text: str = "строка\nцитата: \"ok\"") -> bool {
    ret low == -128_i8 && high == 255_u8 && !enabled && text == "строка\nцитата: \"ok\""
}
fn generic_default[T](value: T, count: usize = 2_usize) -> usize {
    ret count
}
fn empty_default(text: str = "") -> bool { ret text == "" }
fn main() -> u32 {
    if !assert(literal_defaults() && empty_default() && generic_default("owned") == 2_usize && generic_default(3_u32, count: 4_usize) == 4_usize) { ret 10_u32 }
    let multiplier = Multiplier{7_u32}
    if !assert(multiplier.scaled() == 14_u32 && multiplier.scaled(factor: 3_u32) == 21_u32) { ret 9_u32 }
    if !assert(weighted(1) == 123_u32) { ret 1_u32 }
    if !assert(weighted(z: 9, x: 1) == 129_u32) { ret 2_u32 }
    if !assert(weighted(1, z: 8) == 128_u32) { ret 3_u32 }
    if !assert(label() == "default" && label(enabled: false) == "disabled") { ret 4_u32 }
    if !assert(Calculator{4_u32}.add() == 6_u32) { ret 5_u32 }
    let mut trace = 0_u32
    let result = weighted(z: mark(trace, 3), x: mark(trace, 1), y: mark(trace, 2))
    if !assert(trace == 312_u32 && result == 123_u32) { ret 6_u32 }
    ret 0_u32
}


trait Scaled {
    fn scaled(self: Self, factor: u32 = 2_u32) -> u32
}
struct Multiplier { value: u32 }
impl Scaled for Multiplier {
    fn scaled(self: Self, local_factor: u32) -> u32 { ret self.value * local_factor }
}
