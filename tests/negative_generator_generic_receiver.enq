// @expect.compile_error=generator-stack-node-escape
struct State { value: usize }
struct Holder[T] { state: T }

impl[T] for Holder[T] {
    pub fn values(self: Self) -> usize {
        yield 1_usize
        yield 2_usize
    }
}

fn main() -> u32 {
    let holder = Holder[State<S>]{State<S>{3_usize}}
    for value in holder.values() {}
    ret 0_u32
}
