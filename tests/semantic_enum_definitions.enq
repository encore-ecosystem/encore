//! Enum variants keep exact positions and identities outside the module namespace.

import core::testing::assert
import refrain::frontend::AnalysisDatabase
import refrain::frontend::hir::{DefinitionKind, DefinitionNamespace}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    let source = "pub enum Choice[T] {\n    Empty,\n    Value(T),\n    Named { item: T }\n}\npub enum Other { Empty }\nenum Private { Hidden }\n"
    db.set_module("model", "model.enq", source)
    db.set_module("api", "api.enq", "pub import model::Choice as Exported")
    db.set_module("app", "app.enq", "import api::Exported as Alias\nimport model::Other")
    let variant = match db.enum_variant_definition("app", "Alias[u32]", "Value") {
        Some(value) => value
        None => { ret 1_u32 }
    }
    if !assert(variant.kind() == DefinitionKind::Variant) { ret 2_u32 }
    if !assert(variant.source_name() == "model.enq" && variant.line() == 2_usize
        && variant.column() == 4_usize && variant.length() == 5_usize) { ret 3_u32 }
    match db.module_def_map("model") {
        Some(map) => {
            if !assert(map.named_definition("Value", DefinitionNamespace::Value).is_none()) { ret 4_u32 }
        }
        None => { ret 5_u32 }
    }
    let empty = match db.enum_variant_definition("app", "Alias[u32]", "Empty") {
        Some(value) => value
        None => { ret 6_u32 }
    }
    match db.enum_variant_definition("app", "Other", "Empty") {
        Some(other) => { if !assert(other.id().key() != empty.id().key()) { ret 7_u32 } }
        None => { ret 8_u32 }
    }
    if !assert(db.enum_variant_definition("app", "model::Private", "Hidden").is_none()) { ret 9_u32 }
    if !assert(db.enum_variant_definition("app", "Alias[u32]", "Missing").is_none()) { ret 10_u32 }
    match db.member_declaration_at("model", "Value", 2_usize, 4_usize) {
        Some(declaration) => {
            if !assert(declaration.id().key() == variant.id().key()) { ret 11_u32 }
        }
        None => { ret 12_u32 }
    }
    db.set_module("model", "model.enq", "\n" + source)
    match db.enum_variant_definition("app", "Alias[u32]", "Value") {
        Some(moved) => {
            if !assert(moved.id().key() == variant.id().key() && moved.line() == 3_usize) { ret 13_u32 }
        }
        None => { ret 14_u32 }
    }
    db.set_module("model", "model.enq", "pub enum Choice[T] { Empty }\npub enum Other { Empty }")
    if !assert(db.enum_variant_definition("app", "Alias[u32]", "Value").is_none()) { ret 15_u32 }
    ret 0_u32
}
