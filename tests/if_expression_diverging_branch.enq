//! A diverging early branch must not hide a later value-producing branch.

fn choose(leave: bool) -> i32 {
    let value = if leave { ret 7_i32 } else { 9_i32 }
    ret value
}

fn main() -> u32 {
    if choose(false) != 9_i32 { ret 1_u32 }
    if choose(true) != 7_i32 { ret 2_u32 }
    ret 0_u32
}
