//! Shared native archives are checked by content; missing versions are misses.
import core::fmt::Debug
import core::result::Result
import core::testing::assert

import std::os::{mkdir_all, remove_dir_all, remove_file, write_file}
import std::path::Path
import std::time::perf_counter_ns

import refrain::cache_identity::compiler_content_digest
import refrain::modes::build_archive_ref::{archive_reference, read_archive_payload}

fn contract(root: Path) -> Result[bool, str] {
    let unit = root.join(compiler_content_digest("unit"))
    let slot = compiler_content_digest("native context")
    let native = root.join("objects-v1").join(slot)
    mkdir_all(unit.as_str()) mkdir_all(native.as_str())
    let bytes = "!<arch>\nfixture\0bytes"
    let digest = compiler_content_digest(bytes)
    let stored = native.join(digest + ".erlib")
    write_file(stored.as_str(), bytes)
    write_file(unit.join("unit.erlib").as_str(), archive_reference(slot, digest))
    if !assert(read_archive_payload(unit, digest)? == bytes && read_archive_payload(unit, compiler_content_digest("wrong")).is_err()) {
        ret Result::Ok(false)
    }
    remove_file(stored.as_str())
    if !assert(read_archive_payload(unit, digest).is_err()) {
        ret Result::Ok(false)
    }
    write_file(stored.as_str(), "corrupt archive")
    if !assert(read_archive_payload(unit, digest).is_err()) {
        ret Result::Ok(false)
    }
    write_file(stored.as_str(), bytes)
    write_file(unit.join("unit.erlib").as_str(), "ENQAR001../" + slot + digest)
    if !assert(read_archive_payload(unit, digest).is_err()) {
        ret Result::Ok(false)
    }
    write_file(unit.join("unit.erlib").as_str(), bytes)
    if !assert(read_archive_payload(unit, digest)? == bytes) {
        ret Result::Ok(false)
    }
    write_file(unit.join("unit.erlib").as_str(), "")
    if !assert(read_archive_payload(unit, compiler_content_digest(""))?.is_empty()) {
        ret Result::Ok(false)
    }
    remove_file(unit.join("unit.erlib").as_str())
    ret Result::Ok(assert(read_archive_payload(unit, compiler_content_digest("")).is_err()))
}
fn main() -> u32 {
    let root = Path::new("target/archive-reference-" + Debug::fmt(perf_counter_ns())).resolve()
    let result = contract(root).unwrap_or(false)
    remove_dir_all(root.as_str())
    ret if result {
        0_u32
    } else {
        1_u32
    }
}
