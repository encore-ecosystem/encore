//! A separately compiled extension package using only the common backend API.
import core::result::Result
import std::vec::Vec

import ehir_core::{Backend, BackendOutput, CompileOptions, CompilerDiagnostic, GeneratedModule, PreparedProgram}

pub struct InspectionBackend {
}

impl Backend for InspectionBackend {
    pub fn name(self: Self) -> str {
        ret "inspection"
    }
    pub fn version(self: Self) -> str {
        ret "1"
    }
    pub fn supports(self: Self, options: CompileOptions) -> bool {
        ret options.target == "inspection-target"
    }
    pub fn generate(self: Self, program: PreparedProgram, options: CompileOptions) -> Result[BackendOutput, CompilerDiagnostic] {
        let mut output = Vec[GeneratedModule]::new()
        for module in program.program.modules {
            output.push(GeneratedModule { module.name, "visited " + module.name })
        }
        ret Result::Ok(BackendOutput { "inspection", "inspection-text", output })
    }
}
