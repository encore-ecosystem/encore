//! Compiled against the next SDK contract by the published-release bridge.
import core::ops::{Add, Sub, Mul, Div, Rem, Pow, BitAnd, BitOr, BitXor, Shl, Shr, Eq}
import core::testing::assert

struct Length { value: i32 }
impl Add[i32, Length] for Length {
    fn op(self: Self, other: i32) -> Length { ret Length{self.value + other} }
}
impl Add[Length, i64] for Length {
    fn op(self: Self, other: Length) -> i64 { ret self.value as i64 + other.value as i64 }
}
impl Sub[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 - other as i64 }
}
impl Mul[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 * other as i64 }
}
impl Div[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 / other as i64 }
}
impl Rem[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 % other as i64 }
}
impl Pow[u32, i64] for Length {
    fn op(self: Self, other: u32) -> i64 { ret self.value as i64 ** other as i64 }
}
impl BitAnd[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 & other as i64 }
}
impl BitOr[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 | other as i64 }
}
impl BitXor[i32, i64] for Length {
    fn op(self: Self, other: i32) -> i64 { ret self.value as i64 ^ other as i64 }
}
impl Shl[u8, i64] for Length {
    fn op(self: Self, other: u8) -> i64 { ret self.value as i64 << other as i64 }
}
impl Shr[u8, i64] for Length {
    fn op(self: Self, other: u8) -> i64 { ret self.value as i64 >> other as i64 }
}
impl Eq[i32] for Length {
    fn op(self: Self, other: i32) -> bool { ret self.value == other }
}
struct Boxed[T] { value: T }
impl[T] Add[Boxed[T], usize] for Boxed[T] {
    fn op(self: Self, other: Boxed[T]) -> usize { ret 9_usize }
}
fn bounded[L: Add[R, O], R, O](lhs: L, rhs: R) -> O { ret lhs + rhs }
fn mark(counter: mut u32) -> bool { counter += 1_u32 ret true }
fn main() -> u32 {
    let length = Length{12_i32}
    let shifted: Length = length + 3_i32
    let total: i64 = length + Length{5_i32}
    if !assert(shifted.value == 15_i32 && total == 17_i64) { ret 1_u32 }
    if !assert(length - 2_i32 == 10_i64 && length * 3_i32 == 36_i64) { ret 2_u32 }
    if !assert(length / 3_i32 == 4_i64 && length % 5_i32 == 2_i64) { ret 3_u32 }
    if !assert(length ** 2_u32 == 144_i64) { ret 4_u32 }
    if !assert((length & 7_i32) == 4_i64 && (length | 3_i32) == 15_i64 && (length ^ 7_i32) == 11_i64) { ret 5_u32 }
    if !assert((length << 1_u8) == 24_i64 && (length >> 1_u8) == 6_i64) { ret 6_u32 }
    if !assert(length == 12_i32) { ret 7_u32 }
    let generic: Length = bounded[Length, i32, Length](length, 4_i32)
    if !assert(generic.value == 16_i32 && Boxed{1_u32} + Boxed{2_u32} == 9_usize) { ret 8_u32 }
    let mut counter = 0_u32
    let first = false && mark(counter)
    let second = true || mark(counter)
    if !assert(!first && second && counter == 0_u32) { ret 9_u32 }
    ret 0_u32
}
