import core::option::Option
import core::reflect
import core::vec::Vec
pub struct Asset {
    #serialize(rename = "stored_name")
    name: str
    serial: u64
    samples: Vec[u32]
}
pub fn sample() -> Asset {
    ret Asset {
        "Asset", 18446744073709551615_u64, vec![1_u32, 2_u32, 3_u32]
    }
}
pub fn field_count[T](value: T) -> usize {
    let info = reflect::type_info[T]()
    let mut count = 0_usize
    for field in info.fields() {
        count += 1
    }
    ret count
}
pub struct Config {
    #serialize(rename = "stored_name")
    name: str
    count: i64
    samples: Vec[u32]
    optional: Option[str]
}
pub fn sample_config() -> Config {
    ret Config {
        "external-config", -42_i64,
        vec![1_u32, 2_u32, 4294967295_u32], Option::Some("present")
    }
}
pub fn valid_config(value: Config) -> bool {
    ret value.name == "external-config" && value.count == -42_i64
    && value.samples.len() == 3_usize
    && value.samples.get(0_usize).unwrap_or(0_u32) == 1_u32
    && value.samples.get(1_usize).unwrap_or(0_u32) == 2_u32
    && value.samples.get(2_usize).unwrap_or(0_u32) == 4294967295_u32
    && value.optional.unwrap_or("") == "present"
}
