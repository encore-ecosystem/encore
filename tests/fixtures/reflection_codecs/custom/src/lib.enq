import core::fmt::Debug
import core::reflect
import core::reflect::{Kind, BuildError}
import core::result::Result
import serialize::{Serializer, Deserializer, Error, ErrorKind}
import std::num::parse as parse_integer
struct Encoder[T] {
    value: T
}
struct Decoder[T] {
    source: str
}

impl[T] Serializer[str] for Encoder[T] {
    pub fn serialize(self: Self) -> Result[str, Error] {
        let info = reflect::type_info[T]()
        let mut output = ""
        let mut index = 0_usize
        for field in info.fields() {
            if index != 0 {
                output = output + ","
            }
            match field.type().kind() {
                Kind::U32 => {
                    output = output + Debug::fmt(field.get(self.value))
                }
                _ => {
                    ret Result::Err(Error::new(ErrorKind::UnsupportedType, "comma supports u32 fields"))
                }
            }
            index += 1
        }
        ret Result::Ok(output)
    }
}

impl[T] Deserializer[T] for Decoder[T] {
    pub fn deserialize(self: Self) -> Result[T, Error] {
        let info = reflect::type_info[T]()
        let mut builder = reflect::Builder[T]::new()
        let mut start = 0_usize
        for field in info.fields() {
            let mut end = start
            while end < self.source.byte_len() && self.source.byte_at(end) != 44_u8 {
                end += 1
            }
            match field.type().kind() {
                Kind::U32 => {
                    match parse_integer[u32](self.source.slice_bytes(start, end - start)) {
                        Ok(value) => {
                            builder.set(field, value)
                        }
                        Err(_) => {
                            ret Result::Err(Error::new(ErrorKind::InvalidData, "invalid number"))
                        }
                    }
                }
                _ => {
                    ret Result::Err(Error::new(ErrorKind::UnsupportedType, "comma supports u32 fields"))
                }
            }
            start = end + 1
        }
        if start != self.source.byte_len() + 1 {
            ret Result::Err(Error::new(ErrorKind::InvalidData, "extra fields"))
        }
        match builder.finish() {
            Ok(value) => {
                ret Result::Ok(value)
            }
            Err(_) => {
                ret Result::Err(Error::new(ErrorKind::MissingField, "missing field"))
            }
        }
    }
}
pub fn encode[T](value: T) -> Result[str, Error] {
    ret Encoder[T] { value }.serialize()
}
pub fn decode[T](source: str) -> Result[T, Error] {
    ret Decoder[T] { source }.deserialize()
}
