import core::result::Result

import std::io::eprintln

import binary
import binary::{BinaryDeserializer, BinarySerializer}
import codec_model::{Asset, Config, field_count, sample, sample_config, valid_config}
import comma_codec
import json
import json::{JsonDeserializer, JsonSerializer}
import serialize::{Deserializer, Serializer}
import toml
import toml::{TomlDeserializer, TomlSerializer}
struct Pair {
    left: u32
    right: u32
}
fn main() -> u32 {
    let asset = sample()
    if field_count(asset) != 3 {
        ret 1
    }
    let text = match json::encode(asset) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path())
            ret 2
        }
    }
    if !text.contains("stored_name") {
        ret 3
    }
    let decoded = match json::decode[Asset](text) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path())
            ret 4
        }
    }
    if decoded.serial != asset.serial || decoded.name != asset.name || decoded.samples.len() != 3 {
        ret 5
    }
    let bytes = match binary::encode(asset) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path())
            ret 6
        }
    }
    let restored = match binary::decode[Asset](bytes) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path())
            ret 7
        }
    }
    if restored.serial != asset.serial || restored.name != asset.name || restored.samples.len() != 3 {
        ret 8
    }
    let csv = match comma_codec::encode(Pair { 10_u32, 20_u32 }) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path())
            ret 9
        }
    }
    if csv != "10,20" {
        ret 10
    }
    let point = match comma_codec::decode[Pair](csv) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path())
            ret 11
        }
    }
    if point.left != 10_u32 || point.right != 20_u32 {
        ret 12
    }
    let json_trait = match Serializer::serialize(JsonSerializer::new(asset)) {
        Ok(value) => value Err(error) => {
            eprintln(error.message()) ret 13
        }
    }
    match JsonDeserializer[Asset]::new(json_trait).deserialize() {
        Ok(value) => {
            if value.name != asset.name || value.serial != asset.serial {
                ret 14
            }
        }
        Err(error) => {
            eprintln(error.message()) ret 15
        }
    }
    let binary_trait = match Serializer::serialize(BinarySerializer::new(asset)) {
        Ok(value) => value Err(error) => {
            eprintln(error.message()) ret 16
        }
    }
    match BinaryDeserializer[Asset]::new(binary_trait).deserialize() {
        Ok(value) => {
            if value.name != asset.name || value.serial != asset.serial {
                ret 17
            }
        }
        Err(error) => {
            eprintln(error.message()) ret 18
        }
    }
    ret config_roundtrips()
}
fn config_roundtrips() -> u32 {
    let config = sample_config()
    let toml_text = match toml::encode(config) {
        Ok(value) => value Err(error) => {
            eprintln("TOML Config encode: " + error.message() + " at " + error.path())
            ret 19
        }
    }
    if !toml_text.contains("stored_name") {
        eprintln("TOML Config encode lost renamed field")
        ret 20
    }
    let toml_config = match toml::decode[Config](toml_text) {
        Ok(value) => value Err(error) => {
            eprintln("TOML Config decode: " + error.message() + " at " + error.path())
            ret 21
        }
    }
    if !valid_config(toml_config) {
        eprintln("TOML Config roundtrip changed values")
        ret 22
    }
    let toml_trait = match Serializer::serialize(TomlSerializer[Config]::new(config)) {
        Ok(value) => value Err(error) => {
            eprintln("TOML Config trait serialize: " + error.message() + " at " + error.path())
            ret 23
        }
    }
    if !toml_trait.contains("stored_name") {
        eprintln("TOML Config trait serialize lost renamed field")
        ret 24
    }
    match TomlDeserializer[Config]::new(toml_trait).deserialize() {
        Ok(value) => {
            if !valid_config(value) {
                eprintln("TOML Config trait roundtrip changed values")
                ret 25
            }
        }
        Err(error) => {
            eprintln("TOML Config trait deserialize: " + error.message() + " at " + error.path())
            ret 26
        }
    }
    let json_text = match json::encode(config) {
        Ok(value) => value Err(error) => {
            eprintln("JSON Config encode: " + error.message() + " at " + error.path())
            ret 27
        }
    }
    if !json_text.contains("stored_name") {
        eprintln("JSON Config encode lost renamed field")
        ret 28
    }
    let json_config = match json::decode[Config](json_text) {
        Ok(value) => value Err(error) => {
            eprintln("JSON Config decode: " + error.message() + " at " + error.path())
            ret 29
        }
    }
    if !valid_config(json_config) {
        eprintln("JSON Config roundtrip changed values")
        ret 30
    }
    let config_bytes = match binary::encode(config) {
        Ok(value) => value Err(error) => {
            eprintln("binary Config encode: " + error.message() + " at " + error.path())
            ret 31
        }
    }
    let binary_config = match binary::decode[Config](config_bytes) {
        Ok(value) => value Err(error) => {
            eprintln("binary Config decode: " + error.message() + " at " + error.path())
            ret 32
        }
    }
    if !valid_config(binary_config) {
        eprintln("binary Config roundtrip changed values")
        ret 33
    }
    ret 0
}
