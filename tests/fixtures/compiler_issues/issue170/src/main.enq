import refrain::{data, session}
import refrain::data::Value
struct Store {
    value: Value
}

impl for Store {
    pub fn new(root: str) -> Self {
        let saved = session::restore(root)
        ret Self { saved }
    }
}
fn main() -> u32 {
    let store = Store::new("restored")
    ret match store.value {
        Value::Text(value) => if value == "restored" {
            0_u32
        } else {
            1_u32
        }
        _ => 2_u32
    }
}
