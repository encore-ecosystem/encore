import core::testing::assert

import std::path::Path

fn main() -> u32 {
    let path = Path::new("каталог/📁/данные.имя.расш")
    let parent = Path::new("каталог/📁")
    if !assert(path.parent().unwrap_or(Path::new("")).as_str() == parent.as_str()) {
        ret 1
    }
    if !assert(path.name().unwrap_or("") == "данные.имя.расш") {
        ret 2
    }
    if !assert(path.stem().unwrap_or("") == "данные.имя") {
        ret 3
    }
    if !assert(path.suffix().unwrap_or("") == ".расш") {
        ret 4
    }
    if !assert(path.extension().unwrap_or("") == "расш") {
        ret 5
    }
    if !assert(path.with_suffix(".txt").name().unwrap_or("") == "данные.имя.txt") {
        ret 6
    }
    if !assert(path.with_name("новое.json").parent().unwrap_or(Path::new("")).as_str() == parent.as_str()) {
        ret 7
    }
    let drive = Path::new("C:/каталог/данные.env")
    if !assert(drive.parent().unwrap_or(Path::new("")).as_str() == Path::new("C:/каталог").as_str()) {
        ret 8
    }
    if !assert(drive.name().unwrap_or("") == "данные.env") {
        ret 9
    }
    if !assert((parent / "новый.env").name().unwrap_or("") == "новый.env") {
        ret 10
    }
    ret 0
}
