//! Field postfix brackets are array indexing unless followed by a generic call.
struct Values {
    items:[u32;
        3]
}
fn main() -> u32 {
    let values = Values {[3_u32, 5_u32, 7_u32] }
    if values.items[0_u32] + values.items[2_u32] != 10_u32 {
        ret 1
    }
    if values.items[1_u32] < 4_u32 {
        ret 2
    }
    ret 0
}
