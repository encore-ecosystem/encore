import core::vec::Vec
struct Packet {
    shaders: Vec[(str, Vec[u32])]
}
fn empty() -> sending Packet {
    ret Packet { Vec[(str, Vec[u32])]::new() }
}
fn packet() -> sending Packet {
    ret Packet { vec![("shader", vec![7_u32, 11_u32])] }
}
fn consume(value: sending Packet) -> u32 {
    let entry = value.shaders.get(0_usize).unwrap_or(("", Vec[u32]::new()))
    if entry.0 != "shader" {
        ret 0_u32
    }
    ret entry.1.get(0_usize).unwrap_or(0_u32) + entry.1.get(1_usize).unwrap_or(0_u32)
}
fn main() -> u32 {
    let vacant = empty()
    if vacant.shaders.len() != 0_usize {
        ret 1_u32
    }
    let value = packet()
    let worker = spawn consume(value)
    ret if worker.join() == 18_u32 {
        0_u32
    } else {
        2_u32
    }
}
