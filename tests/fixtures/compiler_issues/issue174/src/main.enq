//! A block without a tail still releases its local owners on normal exit.
import core::vec::Vec
import std::io::println
extern fn encore_node_debug_live_count() -> usize
#attr(safe)
fn live_nodes() -> usize {
    ret unsafe {
        encore_node_debug_live_count()
    }
}
fn exercise() ->() {
    let done = {
        let mut values = vec!["owned value"]
        let count = values.len()
    }
    let second = {
        let mut values = vec!["another value"]
        let count = values.len()
    }
}
fn main() -> u32 {
    let before = live_nodes()
    exercise()
    let after = live_nodes()
    if after != before {
        println("unit block leaked a local owner") ret 1
    }
    ret 0
}
