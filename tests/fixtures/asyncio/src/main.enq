import core::option::Option
import core::result::Result

import asyncio

async fn later(value: u32, delay: usize) -> u32 {
    let waited = await asyncio::sleep(delay)
    ret if waited.is_ok() {
        value
    } else {
        0_u32
    }
}

@asyncio.main
async fn main() -> u32 {
    let runtime = match asyncio::current() {
        Option::Some(handle) => handle
        Option::None => {
            ret 1_u32
        }
    }
    let slow = match asyncio::spawn_task[u32, __encore_future_later](runtime, later(11_u32, 5000_usize)) {
        Result::Ok(handle) => handle
        Result::Err(_) => {
            ret 2_u32
        }
    }
    let fast = match asyncio::spawn_task[u32, __encore_future_later](runtime, later(22_u32, 20_usize)) {
        Result::Ok(handle) => handle
        Result::Err(_) => {
            ret 3_u32
        }
    }
    let answer = await fast
    slow.cancel()
    let cancelled = await slow
    ret if answer.unwrap_or(0_u32) == 22_u32 && cancelled.is_err() {
        0_u32
    } else {
        4_u32
    }
}
