import log::{LogLevel, Formatter, Logger}
import json::parse
import rich::json_render::{render_json, render_json_source}
import rich::logging::colored_formatter
import rich::json_console::Console

fn main() -> u32 {
    let formatter = colored_formatter(Formatter::plain()).with_newline(false)
    if !formatter.format(LogLevel::Info, "sdk", "palette").contains("\x1b[") {
        ret 1
    }
    if formatter.for_terminal(false).format(LogLevel::Info, "sdk", "plain").contains("\x1b[") {
        ret 2
    }
    let value = match parse("{\"answer\":42,\"escaped\":\"quote\\\" and comma, colon: and slash\\\\\",\"empty\":[]}") {
        Ok(value) => value
        Err(_) => { ret 3 }
    }
    let rendered = render_json(value)
    if !rendered.contains("\"answer\": 42") || !rendered.contains("\n") { ret 4 }
    let source_rendered = render_json_source(value.stringify())
    match parse(source_rendered) {
        Ok(restored) => { if restored.stringify() != value.stringify() { ret 5 } }
        Err(_) => { ret 6 }
    }
    Logger::console_with_formatter("sdk", colored_formatter(Formatter::plain())).info("adapter-ready")
    let console = Console::new()
    console.json(value)
    console.json_source(value.stringify())
    console.info("console-ready")
    ret 0
}
