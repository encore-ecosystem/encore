import log::LogLevel
import rich::logging::{colored_formatter, console_logger}
import rich::json_render::render_json_source
import rich::presentation::Console

fn main() -> u32 {
    let formatter = colored_formatter().with_newline(false)
    if !formatter.format(LogLevel::Info, "sdk", "palette").contains("\x1b[") { ret 1 }
    if formatter.for_terminal(false).format(LogLevel::Info, "sdk", "plain").contains("\x1b[") { ret 2 }
    match render_json_source("{\"answer\":42}") {
        Ok(value) => { if !value.contains("answer") { ret 3 } }
        Err(_) => { ret 4 }
    }
    console_logger("sdk").info("adapter-ready")
    Console::new().info("console-ready")
    ret 0
}
