import json::parse
import log::{Formatter, LogLevel, Logger}
import rich::json_console::Console
import rich::json_render::{render_json, render_json_source}
import rich::logging::level_labels

fn main() -> u32 {
    let formatter = Formatter::colored().with_labels(level_labels()).with_newline(false)
    if !formatter.format(LogLevel::Info, "sdk", "palette").contains("\x1b[") {
        ret 1
    }
    if formatter.for_terminal(false).format(LogLevel::Info, "sdk", "plain").contains("\x1b[") {
        ret 2
    }
    let value = match parse("{\"answer\":42,\"escaped\":\"quote\\\" and comma, colon: and slash\\\\\",\"empty\":[]}") {
        Ok(value) => value
        Err(_) => {
            ret 3
        }
    }
    let rendered = render_json(value.stringify())
    if !rendered.contains("\"answer\": 42") || !rendered.contains("\n") {
        ret 4
    }
    let source_rendered = render_json_source(value.stringify())
    match parse(source_rendered) {
        Ok(restored) => {
            if restored.stringify() != value.stringify() {
                ret 5
            }
        }
        Err(_) => {
            ret 6
        }
    }
    Logger::console_with_formatter("sdk", Formatter::colored().with_labels(level_labels())).info("adapter-ready")
    let console = Console::new()
    console.json(value.stringify())
    console.json_source(value.stringify())
    console.info("console-ready")
    ret 0
}
