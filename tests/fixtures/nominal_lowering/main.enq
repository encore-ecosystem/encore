//! Isolates lowering of real workspace modules with large import lists.
import core::fmt::Debug
import std::io::println
import std::os::env
import std::path::Path
import std::time::perf_counter_ms
import std::vec::Vec

import json::{Json, stringify}

import refrain::cache_identity::compiler_content_digest
import refrain::frontend::translator::{TranslationModule, filter_ast_for_target, translate_compilation_unit_to_ehir_chunks}
import refrain::project::workspace::load_library_workspace
import refrain::target::host_target

fn main() -> u32 {
    let root = env("ENCORE_NOMINAL_BENCH_PROJECT").unwrap_or("")
    if root.is_empty() {
        ret 0_u32
    }
    let started = perf_counter_ms()
    let workspace = load_library_workspace(Path::new(root))
    let target = host_target()
    let mut modules = Vec[TranslationModule]::new()
    let mut selected = Vec[usize]::new()
    for module in workspace.modules {
        if module.owner_name == workspace.root_name &&
        (module.module_id == workspace.root_name + "@lib.enq" ||
            module.module_id == workspace.root_name + "@preview.enq") {
            selected.push(modules.len())
        }
        modules.push(TranslationModule {
                module.module_id, module.module_path.as_str(), module.source,
                module.documentation, module.resolved_imports,
                filter_ast_for_target(module.ast, target, module.enabled_features),
                module.enabled_features, module.source.len()
            }
        )
    }
    if selected.is_empty() {
        ret 1_u32
    }
    let loaded = perf_counter_ms()
    let chunks = translate_compilation_unit_to_ehir_chunks(modules, target, selected)
    let lowered = perf_counter_ms()
    let mut fingerprints = Vec[Json]::new()
    for chunk in chunks {
        fingerprints.push(Json::String(compiler_content_digest(chunk.as_text())))
    }
    println(stringify(Json::Object(vec![
                    ("workspace_ms", Json::Number(Debug::fmt(loaded - started))),
                    ("lowering_ms", Json::Number(Debug::fmt(lowered - loaded))),
                    ("modules", Json::Number(Debug::fmt(selected.len()))),
                    ("module_sha256", Json::Array(fingerprints))
                ])))
    ret 0_u32
}
