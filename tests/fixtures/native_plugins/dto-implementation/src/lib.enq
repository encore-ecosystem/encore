import core::result::Result

import dto_api::{Echo, Envelope, Marker}

static LABEL: str = "provider" + " static"
struct EchoImpl[Tag] {
    tag: Tag
}

impl[Tag] Echo[Envelope] for EchoImpl[Tag] {
    pub fn echo(self: Self, value: Envelope) -> Result[Envelope, str] {
        ret Result::Ok(value)
    }
    pub fn fail(self: Self) -> Result[Envelope, str] {
        ret Result::Err("application failure")
    }
    pub fn ping(self: Self) {
    }
    pub fn label(self: Self) -> str {
        ret LABEL
    }
}
fn create_echo() -> Result[EchoImpl[bool], str] {
    ret Result::Ok(EchoImpl[bool] { true })
}

impl[Tag] Marker[u32] for EchoImpl[Tag] {
    pub fn marker(self: Self) -> u64 {
        ret 42_u64
    }
}
