import core::result::Result
import core::vec::Vec

import std::plugin::{Resource, StateSnapshot}

import counter_api::Counter

struct StateCounter {
    count: u64
    name: str
}
struct LeafCounter[Tag] {
    count: u64
}

impl Counter for StateCounter {
    pub fn add(mut self: Self, amount: u64) -> u64 {
        self.count += amount
        ret self.count + __OFFSET___u64
    }
    pub fn label(self: Self) -> str {
        ret self.name
    }
    pub fn fork(self: Self) -> Resource[dyn Counter] {
        ret Resource[dyn Counter]::new(LeafCounter[bool] { self.count })
    }
    pub fn use_child(self: Self, child: Resource[dyn Counter], amount: u64) -> u64 {
        match child.add(amount) {
            Ok(value) => {
                ret value
            }
            Err(_) => {
                ret 0_u64
            }
        }
    }
}

impl[Tag] Counter for LeafCounter[Tag] {
    pub fn add(mut self: Self, amount: u64) -> u64 {
        self.count += amount
        ret self.count + __OFFSET___u64
    }
    pub fn label(self: Self) -> str {
        ret "leaf __REV__"
    }
    pub fn fork(self: Self) -> Resource[dyn Counter] {
        ret Resource[dyn Counter]::new(LeafCounter[Tag] { self.count })
    }
    pub fn use_child(self: Self, child: Resource[dyn Counter], amount: u64) -> u64 {
        match child.add(amount) {
            Ok(value) => {
                ret value
            }
            Err(_) => {
                ret 0_u64
            }
        }
    }
}
fn create_counter() -> Result[StateCounter, str] {
    ret Result::Ok(StateCounter {
            0_u64, "root __REV__"
        }
    )
}
fn save_counter(value: StateCounter) -> Result[StateSnapshot, str] {
    let mut bytes = Vec[u8]::new()
    let mut index = 0_usize
    while index < 8_usize {
        bytes.push(((value.count >>(index * 8_usize)) & 255_u64) as u8)
        index += 1_usize
    }
    ret Result::Ok(StateSnapshot { 1_u32, bytes })
}
fn restore_counter(state: StateSnapshot) -> Result[StateCounter, str] {
    if __BAD_STATE__ {
        ret Result::Err("deliberate restore failure")
    }
    if state.version != 1_u32 || state.data.len() != 8_usize {
        ret Result::Err("invalid snapshot")
    }
    let mut value = 0_u64
    let mut index = 0_usize
    while index < 8_usize {
        value = value |((state.data.get(index).unwrap_or(0_u8) as u64) <<(index * 8_usize))
        index += 1_usize
    }
    ret Result::Ok(StateCounter { value, "root __REV__" })
}
