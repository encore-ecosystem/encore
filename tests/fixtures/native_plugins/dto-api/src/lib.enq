import core::option::Option
import core::result::Result
import core::vec::Vec

pub enum Status {
    Empty
    Count(u64)
    Text(str)
}
pub struct Envelope {
    name: str
    bytes: Vec[u8]
    numbers: Vec[u64]
    fixed:[u32;
        3]
    pair:(i64, bool)
    optional: Option[str]
    status: Status
    fraction: f64
    small: f32
}
#attr(plugin_interface)
pub trait Echo[Item] {
    fn echo(self: Self, value: Item) -> Result[Item, str]
    fn fail(self: Self) -> Result[Item, str]
    fn ping(self: Self)
    fn label(self: Self) -> str
}

#attr(plugin_interface)
pub trait Marker[Key] {
    fn marker(self: Self) -> u64
}
