struct Counter {
    value: u32
}
fn touch(counter: mut Counter) ->() {
    counter.value += 1_u32 ret()
}
fn consume(value:(), number: u32) -> u32 {
    ret number
}
struct Receiver {
    value: u32
}

impl for Receiver {
    fn accept(self: Self, value:()) -> u32 {
        ret self.value
    }
}
fn main() -> u32 {
    let mut counter = Counter { 0_u32 }
    let result = consume(touch(counter), 42_u32)
    if result != 42_u32 || counter.value != 1_u32 {
        ret 1
    }
    let receiver = Receiver { 7_u32 }
    if receiver.accept(touch(counter)) != 7_u32 || counter.value != 2_u32 {
        ret 2
    }
    ret 0
}
