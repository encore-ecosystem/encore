//! Regression for issue #154.
import core::vec::Vec
import std::io::println

trait Source {
    fn source(self: Self) -> str
}
struct Link {
    url: str
}

impl Source for Link {
    fn source(self: Self) -> str {
        ret self.url
    }
}
fn main() -> u32 {
    let mut adapters = Vec[dyn Source]::new()
    for name in vec!["youritjob", "opento_dev", "remote_ai_jobs"] {
        let adapter = Link { f"https://t.me/s/{name}" }
        println(f"before=[{adapter.source()}]")
        adapters.push(adapter as dyn Source)
    }
    for adapter in adapters {
        let dynamic = adapter.source()
        println(f"dynamic=[{dynamic}] bytes={dynamic.byte_len()}")
    }
    ret 0_u32
}
