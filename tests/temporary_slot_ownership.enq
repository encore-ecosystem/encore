//! Synthetic slots obey the same retain/transfer rules as mutable bindings.
import core::vec::Vec
extern fn encore_node_debug_live_count() -> usize

struct Holder {
    values: Vec[usize]
}
impl for Holder {
    fn clear(self: mut Self) -> usize {
        let size = self.values.len()
        self.values.clear()
        ret size
    }
}
fn make() -> Holder {
    let mut values = Vec[usize]::new()
    values.push(3_usize)
    ret Holder {
        values
    }
}
fn literal() -> bool {
    let values = vec![1_usize, 2_usize, 3_usize]
    ret values.len() == 3_usize
}
fn literal_owned() -> bool {
    let text = "owned " + "element"
    let values = vec![text, "fresh " + "element"]
    ret values.len() == 2_usize && text == "owned element"
}
fn receiver() -> bool {
    ret make().clear() == 1_usize
}
fn choices(flag: bool) -> bool {
    let value = if flag {
        make()
    } else {
        make()
    }
    let other = match flag {
        true => make() false => make()
    }
    ret value.values.len() == 1_usize && other.values.len() == 1_usize
}
fn main() -> u32 {
    let before = unsafe {
        encore_node_debug_live_count()
    }
    if !receiver() {
        ret 2_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 12_u32
    }
    if !literal() {
        ret 1_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 11_u32
    }
    if !choices(true) || !choices(false) {
        ret 3_u32
    }
    if !literal_owned() {
        ret 4_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 14_u32
    }
    if unsafe {
        encore_node_debug_live_count()
    }
    != before {
        ret 13_u32
    }
    ret 0_u32
}
