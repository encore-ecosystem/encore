//! Editor analysis agrees with the numeric invocation and suffix contracts.
import refrain::frontend::{AnalysisDatabase, SemanticBody, SymbolId}

fn main() -> u32 {
    let mut db = AnalysisDatabase::new()
    db.set_module("app", "app.enq", "struct Offset {}\nimpl for Offset { fn shifted(self: Self, x: f32) -> f32 { ret x } fn byte(self: Self, x: i8) -> i8 { ret x } }\nfn add(x: f32) -> f32 { ret x }\nfn valid() { let index = 0 let signed = -1 let offset = Offset{} let moved = offset.shifted(-7) let minimum = offset.byte(-128) let direct = add(-9) }\nfn invalid() { let offset = Offset{} let wrong = offset.shifted(-7_i32) }\nfn overflow() { let offset = Offset{} let wrong = offset.byte(-129) }\n")
    let valid = db.semantic_body(db.symbol_id("app", "valid").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    if valid.diagnostics.len() != 0 {
        ret 1
    }
    if valid.binding_type("index").unwrap_or("") != "usize" || valid.binding_type("signed").unwrap_or("") != "isize" {
        ret 5
    }
    if valid.binding_type("moved").unwrap_or("") != "f32" || valid.binding_type("minimum").unwrap_or("") != "i8" {
        ret 2
    }
    let invalid = db.semantic_body(db.symbol_id("app", "invalid").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    let mut mismatch = false
    for diagnostic in invalid.diagnostics {
        if diagnostic.code == "method-argument-type-mismatch" {
            mismatch = true
        }
    }
    if !mismatch {
        ret 3
    }
    let overflow = db.semantic_body(db.symbol_id("app", "overflow").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    db.set_module("arithmetic", "arithmetic.enq", "struct Offset {}\nimpl for Offset { fn shifted(self: Self, x: f32) -> f32 { ret x } }\nfn add(x: f32) -> f32 { ret x }\nfn valid() { let offset = Offset{} let scale = 2.0_f32 let divided = offset.shifted(1 / scale) let mixed = offset.shifted(62 + scale * 28) let contextual = offset.shifted(scale + 1.0) let direct = add(10 / scale) let integer = add((1 + 2)) }\n")
    let arithmetic = db.semantic_body(db.symbol_id("arithmetic", "valid").unwrap_or(SymbolId::invalid())).unwrap_or(SemanticBody::empty())
    if arithmetic.diagnostics.len() != 0 {
        ret 6
    }
    if arithmetic.binding_type("divided").unwrap_or("") != "f32" || arithmetic.binding_type("contextual").unwrap_or("") != "f32" {
        ret 7
    }
    for diagnostic in overflow.diagnostics {
        if diagnostic.code == "integer-literal-out-of-range" {
            ret 0
        }
    }
    ret 4
}
