//! Import-list splitting preserves UTF-8 and explicit aliases without character rescans.
import refrain::frontend::analysis_database::import_binding_names
fn main() -> u32 {
    let items = import_binding_names("models::{Fish as Рыба, Tree, Камень as Rock}", "models")
    if items.len() != 3 {
        ret 1
    }
    let first = items.get(0).unwrap_or(("", "", false))
    let second = items.get(1).unwrap_or(("", "", true))
    let third = items.get(2).unwrap_or(("", "", false))
    if first.0 != "Fish" || first.1 != "Рыба" || !first.2 {
        ret 2
    }
    if second.0 != "Tree" || second.1 != "Tree" || second.2 {
        ret 3
    }
    if third.0 != "Камень" || third.1 != "Rock" || !third.2 {
        ret 4
    }
    let single = import_binding_names("модели::Рыба as Fish", "модели").get(0).unwrap_or(("", "", false))
    if single.0 != "Рыба" || single.1 != "Fish" || !single.2 {
        ret 5
    }
    let mut path = "library::{"
    for index in 0..100 {
        path += "LongImportedName" + index.fmt() + " as Local" + index.fmt() + ","
    }
    path += "}"
    for _ in 0..100 {
        if import_binding_names(path, "library").len() != 100 {
            ret 6
        }
    }
    ret 0
}
