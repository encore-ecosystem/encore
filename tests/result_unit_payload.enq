//! Unit enum payloads have a discriminant but no storage or SSA value.
import core::option::Option
import core::result::Result

fn success() -> Result[(), str] {
    ret Result[(), str]::Ok(())
}
fn forward() -> Result[(), str] {
    success()? ret Result[(), str]::Ok(())
}
fn failure() -> Result[u32,()] {
    ret Result[u32,()]::Err(())
}
fn propagate_failure() -> Result[u32,()] {
    let value = failure()?
    ret Result[u32,()]::Ok(value)
}
fn main() -> u32 {
    if forward().is_err() {
        ret 1
    }
    let value = Option[()]::Some(())
    match value {
        Option::Some(unit) => {
        }
        Option::None => {
            ret 2
        }
    }
    if !propagate_failure().is_err() {
        ret 3
    }
    let empty = Option[()]::None
    if !empty.is_none() {
        ret 4
    }
    ret 0
}
