//! An owned field used as a mutable method receiver has one balanced root.

import core::vec::Vec

struct Bag {
    values: Vec[u32]
    committed: u32
}

impl for Bag {
    fn push(self: mut Self, value: u32) -> () {
        self.values.push(value)
        self.committed += 1_u32
        ret ()
    }
}

struct Owner { bag: Bag }

impl for Owner {
    fn push(self: Self&, value: u32) -> () {
        self.bag.push(value)
        ret ()
    }

    fn len(self: Self&) -> usize {
        ret self.bag.values.len()
    }

    fn committed(self: Self&) -> u32 { ret self.bag.committed }
}

fn main() -> u32 {
    let owner = Owner<H>{Bag{Vec[u32]::new(), 0_u32}}
    owner.push(41_u32)
    owner.push(42_u32)
    if owner.len() != 2_usize { ret 1_u32 }
    if owner.committed() != 2_u32 { ret 2_u32 }
    ret 0_u32
}
