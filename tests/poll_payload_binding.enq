//! Poll and ordinary enums specialize the declared payload, not generic zero (#97).
import core::future::{Context, Future, Poll, context}
import core::vec::Vec

struct State {
    marker: u32
}
struct Output {
    value: u32
}

impl Future[Output] for State {
    fn poll(self: State, ctx: Context) -> Poll[State, Output] {
        let _ctx = ctx
        ret Poll[State, Output]::Ready(Output { self.marker })
    }
}
enum Reordered[Left, Right] {
    Value(Right)
    Waiting(Left)
}
enum Nested[Left, Right] {
    Values(Vec[Right])
    Waiting(Left)
}
fn ready() -> u32 {
    let step = State { 42 }.poll(context(0))
    ret match step {
        Poll[State, Output]::Ready(value) => value.value Poll[State, Output]::Pending(state) => state.marker
    }
}
fn pending() -> u32 {
    let step: Poll[State, Output] = Poll[State, Output]::Pending(State { 7 })
    ret match step {
        Poll::Ready(value) => value.value Poll::Pending(state) => state.marker
    }
}
fn reordered(item: Reordered[str, Output]) -> u32 {
    ret match item {
        Reordered::Value(output) => output.value Reordered::Waiting(text) => text.byte_len() as u32
    }
}
fn nested(item: Nested[str, Output]) -> usize {
    ret match item {
        Nested::Values(outputs) => outputs.len() Nested::Waiting(text) => text.byte_len()
    }
}
fn main() -> u32 {
    if ready() != 42 || pending() != 7 {
        ret 1
    }
    if reordered(Reordered[str, Output]::Value(Output { 12 })) != 12 {
        ret 2
    }
    if reordered(Reordered[str, Output]::Waiting("wait")) != 4 {
        ret 3
    }
    if nested(Nested[str, Output]::Values(vec![Output { 1 }])) != 1 {
        ret 4
    }
    ret 0
}
