import core::vec::Vec

fn count(values: sending Vec[str]) -> usize {
    ret values.len()
}

fn make_values() -> sending Vec[str] {
    let mut values = Vec[str]::new()
    values.push("alpha")
    values.push("beta")
    ret values
}

fn main() -> u32 {
    let values = make_values()
    let worker = spawn count(values)
    ret if worker.join() == 2_usize { 0_u32 } else { 1_u32 }
}
