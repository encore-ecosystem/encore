//! Contextual literals produce the exact declared payload layout.
import core::option::Option
import core::result::Result
import core::vec::Vec

fn main() -> u32 {
    let value = Option[f32]::Some(1.25)
    if value.unwrap_or(0.0_f32) != 1.25_f32 {
        ret 1
    }
    let negative = Option[f32]::Some( - 1.25)
    if negative.unwrap_or(0.0_f32) != - 1.25_f32 {
        ret 2
    }
    let tuple = Option[(u8, f32)]::Some((42, 2.5)).unwrap_or((0_u8, 0.0_f32))
    if tuple.0 != 42 || tuple.1 != 2.5_f32 {
        ret 3
    }
    let array = Option[[u16;
            2]]::Some([41, 42]).unwrap_or([0_u16, 0_u16])
    if array[0] != 41 || array[1] != 42 {
        ret 4
    }
    let repeated = Option[[u16;
            2]]::Some([42;
            2]).unwrap_or([0_u16, 0_u16])
    if repeated[0] != 42 || repeated[1] != 42 {
        ret 5
    }
    let vector = Option[Vec[u16]]::Some(vec![41, 42]).unwrap_or(Vec[u16]::new())
    if vector.get(0).unwrap_or(0) != 41 || vector.get(1).unwrap_or(0) != 42 {
        ret 6
    }
    let success = Result[(), str]::Ok(())
    if !success.is_ok() {
        ret 7
    }
    if Option[u1]::Some(true) == Option[u1]::Some(false) {
        ret 8
    }
    ret 0
}
