//! Mutable argument aliases still return owned values, not borrowed copies.
import core::vec::Vec
import std::io::println

extern fn encore_node_debug_live_count() -> usize

fn identity(values: mut Vec[u32]) -> Vec[u32] {
    ret values
}
fn generic_identity[T](values: mut Vec[T]) -> Vec[T] {
    ret values
}

fn replace(values: mut Vec[u32]) -> Vec[u32] {
    values = Vec[u32]::new()
    values.push(9)
    ret values
}

fn unrelated(values: mut Vec[u32]) -> Vec[u32] {
    values.push(2)
    let mut result = Vec[u32]::new()
    result.push(7)
    ret result
}

struct Holder {
    values: Vec[u32]
}

struct Node {
    value: u32
}

fn node_identity(node: mut Node<H>) -> Node<H> {
    ret node
}

impl for Holder {
    fn update(self: mut Self) -> Self {
        self.values.push(2)
        ret self
    }
}

fn exercise(mode: usize) -> bool {
    let mut values = Vec[u32]::new()
    values.push(1)
    if mode == 0 {
        values = identity(values)
    } elif mode == 1 {
        values = generic_identity[u32](values)
    } elif mode == 2 {
        values =(identity(values))
    } elif mode == 3 {
        values = {
            identity(values)
        }
    } elif mode == 4 {
        values = replace(values)
    } elif mode == 5 {
        values = unrelated(values)
    } elif mode == 6 {
        let mut holder = Holder { values }
        holder = holder.update()
        ret holder.values.len() == 2
    } elif mode == 7 {
        let holder = Holder { values }
        values = holder.values
    } else {
        let mut node = Node<H>{ 42 }
        node = node_identity(node)
        ret node.value == 42
    }
    let expected = if mode == 4 {
        9_u32
    } elif mode == 5 {
        7_u32
    } else {
        1_u32
    }
    ret values.len() == 1 && values.get(0).unwrap_or(0) == expected
}

fn main() -> u32 {
    for mode in 0_usize..9_usize {
        if !exercise(mode) {
            ret 2
        }
    }
    let before = encore_node_debug_live_count()
    for _ in 0..32 {
        for mode in 0_usize..9_usize {
            if !exercise(mode) {
                ret 3
            }
        }
    }
    let after = encore_node_debug_live_count()
    if after != before {
        println(f "mutable call return leaked nodes: {before} -> {after}")
        ret 1
    }
    ret 0
}
