//! Call cursor queries preserve callee identity and nested argument boundaries.

import core::testing::assert
import refrain::frontend::Lexer
import refrain::frontend::editor_queries::cursor_call_context
import refrain::frontend::editor_queries::cursor_associated_owner
import refrain::frontend::editor_queries::cursor_associated_context

fn completion(source: str, owner: str, prefix: str) -> bool {
    let mut lexer = Lexer::new()
    match cursor_associated_context(lexer.tokenize(source), 0_usize, source.char_len()) {
        Some(context) => { ret context.0 == owner && context.1 == prefix }
        None => { ret owner == "" }
    }
}

fn owner(source: str) -> str {
    let mut lexer = Lexer::new()
    ret cursor_associated_owner(lexer.tokenize(source), 0_usize, source.char_len() - 1_usize)
}

fn matches(source: str, name: str, active: usize) -> bool {
    let mut lexer = Lexer::new()
    match cursor_call_context(lexer.tokenize(source), 0_usize, source.char_len()) {
        Some(context) => { ret context.0.value == name && context.1 == active }
        None => { ret false }
    }
}

fn main() -> u32 {
    if !assert(matches("object.read(", "read", 0_usize)) { ret 1_u32 }
    if !assert(matches("api::read(1, ", "read", 1_usize)) { ret 2_u32 }
    if !assert(matches("read[Pair[u32, str]](1, ", "read", 1_usize)) { ret 3_u32 }
    if !assert(matches("read((1, 2), [3, 4], Item { 5, 6 }, ", "read", 3_usize)) { ret 4_u32 }
    if !assert(matches("read(other(1, ", "other", 1_usize)) { ret 5_u32 }
    if !assert(matches("read((", "read", 0_usize)) { ret 6_u32 }
    let mut lexer = Lexer::new()
    if !assert(cursor_call_context(lexer.tokenize("fn read(value: "), 0_usize, 15_usize).is_none()) { ret 7_u32 }
    if !assert(cursor_call_context(lexer.tokenize("read()"), 0_usize, 6_usize).is_none()) { ret 8_u32 }
    if !assert(owner("Box[u32]::new") == "Box[u32]") { ret 9_u32 }
    if !assert(owner("let value = api::Box[Pair[u32,str]]::new") == "api::Box[Pair[u32,str]]") { ret 10_u32 }
    if !assert(owner("object.read") == "") { ret 11_u32 }
    if !assert(owner("Box[dyn Trait]::new") == "Box[dyn Trait]") { ret 12_u32 }
    if !assert(owner("new") == "") { ret 13_u32 }
    if !assert(owner("import std::vec::Vec") == "") { ret 14_u32 }
    if !assert(completion("Box[u32]::", "Box[u32]", "")) { ret 15_u32 }
    if !assert(completion("Box[u32]::ne", "Box[u32]", "ne")) { ret 16_u32 }
    if !assert(completion("api::Box[Pair[u32,str]]::", "api::Box[Pair[u32,str]]", "")) { ret 17_u32 }
    if !assert(completion("import std::vec::", "", "")) { ret 18_u32 }
    if !assert(completion("object.read", "", "")) { ret 19_u32 }
    if !assert(completion("Box[u32]::new(", "", "")) { ret 20_u32 }
    let prefix = "let shown = f\"value={read("
    let interpolated = prefix + "1, 2)}\""
    match cursor_call_context(lexer.tokenize(interpolated), 0_usize, prefix.char_len()) {
        Some(context) => {
            if !assert(context.0.value == "read" && context.1 == 0_usize) { ret 21_u32 }
        }
        None => { ret 22_u32 }
    }
    match cursor_call_context(lexer.tokenize(interpolated), 0_usize, prefix.char_len() + 3_usize) {
        Some(context) => {
            if !assert(context.0.value == "read" && context.1 == 1_usize) { ret 23_u32 }
        }
        None => { ret 24_u32 }
    }
    ret 0_u32
}
