import core::testing::*
import core::vec::Vec

fn first(items: Vec[str]) -> str {
    for item in items {
        ret item
    }
    ret ""
}

fn main() -> u32 {
    let mut items = Vec[str]::new()
    items.push("first")
    items.push("second")
    if !assert(first(items) == "first") { ret 1_u32 }
    ret 0_u32
}
