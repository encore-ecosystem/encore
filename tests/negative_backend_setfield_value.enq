// @expect.compile_error=error[ehir-validation]: function 'main': setfield target 'entry_letvar_pair_0' is not a pointer

struct Pair {
    value: u32
}

fn main() -> u32 {
    let pair = Pair{1_u32}
    let replacement = 2_u32
    unsafe ehir {
        setfield pair: Pair > 0: usize, replacement: u32
    }
    ret 0_u32
}
