//! Implicit specialization binds payloads without discarding their placement.

struct Counter {
    value: u32
}
struct Holder[Item] {
    item: Item
}
trait Increment {
    fn increment(self: mut Self&) ->()
}

impl Increment for Counter {
    fn increment(self: mut Self&) ->() {
        self.value += 1 ret()
    }
}

fn update[Value: Increment](value: mut Value<H>) ->() {
    value.increment() ret()
}
fn stack[Value: Increment](value: mut Value<S>) ->() {
    value.increment() ret()
}
fn erased[Value: Increment](value: mut Value&) ->() {
    value.increment() ret()
}
fn identity[Value](value: Value) -> Value {
    ret value
}
fn choose[Value](value: Value<H>, unused: bool) -> Value<H> {
    ret value
}
fn nested[Value](value: Holder[Value]<H>) -> Value {
    ret value.item
}
fn same[Value](left: Value<H>, right: Value<H>) -> bool {
    ret left == right
}
fn mixed[Value](heap: Value<H>, local: Value<S>) -> Value<S> {
    ret local
}

fn main() -> u32 {
    let mut heap = Counter<H>{ 40 }
    let mut local = Counter<S>{ 10 }
    update(heap)
    stack(local)
    erased(heap)
    erased(local)
    if heap.value != 42 || local.value != 12 {
        ret 1
    }
    let copied = identity(heap)
    let selected = choose(heap, false)
    if copied.value != 42 || selected.value != 42 {
        ret 2
    }
    let holder = Holder[Counter<H>]<H> { heap }
    if nested(holder).value != 42 {
        ret 3
    }
    if !same(heap, copied) || same(heap, Counter<H> {
            42
        }
        ,
    ) {
        ret 4
    }
    if mixed(heap, local).value != 12 {
        ret 5
    }
    ret 0
}
