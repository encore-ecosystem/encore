//! Same-named declarations retain module identity through validation and EHIR.

import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::parser::Statement
import refrain::frontend::translator::{TranslationModule, translate_modules_to_ehir_bundle}
import refrain::target::host_target

fn parsed(source_name: str, source: str) -> Vec[Statement] {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source(source_name)
    ret parser.parse(lexer.tokenize(source))
}

fn main() -> u32 {
    let ops = parsed("ops.enq",
        "pub trait Div[Rhs] { fn op(self: Self, other: Rhs) -> Self }\n" +
        "impl Div[u8] for u8 { fn op(self: u8, other: u8) -> u8 { ret self } }\n")
    let html = parsed("html.enq",
        "import ops::Div\n" +
        "pub struct Div { value: u32 }\n" +
        "impl for Div { pub fn new(value: u32) -> Self { ret Self{value} } }\n")
    let output_a = parsed("a.enq",
        "pub struct Output { value: u32 }\n" +
        "pub fn make_a() -> Output { ret Output{7_u32} }\n")
    let output_b = parsed("b.enq",
        "pub struct Output { text: str }\n" +
        "pub fn make_b() -> Output { ret Output{\"Output\"} }\n")
    let consumer = parsed("use.enq",
        "import a::make_a\nimport b::make_b\n" +
        "fn consume() -> u32 { let left = make_a() let right = make_b() ret left.value }\n")

    let mut modules = Vec[TranslationModule]::new()
    let none = Vec[str]::new()
    modules.push(TranslationModule::new("ops", "ops.enq", none, ops, Vec[str]::new()))
    let mut html_imports = Vec[str]::new()
    html_imports.push("ops")
    modules.push(TranslationModule::new("html", "html.enq", html_imports, html, Vec[str]::new()))
    modules.push(TranslationModule::new("a", "a.enq", Vec[str]::new(), output_a, Vec[str]::new()))
    modules.push(TranslationModule::new("b", "b.enq", Vec[str]::new(), output_b, Vec[str]::new()))
    let mut consumer_imports = Vec[str]::new()
    consumer_imports.push("a")
    consumer_imports.push("b")
    modules.push(TranslationModule::new("use", "use.enq", consumer_imports, consumer, Vec[str]::new()))

    let output = translate_modules_to_ehir_bundle(modules, host_target(), "use")
    if !output.contains("trait __encore_t6f7073__Div") { ret 1_u32 }
    if !output.contains("struct __encore_t68746d6c__Div") { ret 2_u32 }
    if !output.contains("struct __encore_t61__Output") { ret 3_u32 }
    if !output.contains("struct __encore_t62__Output") { ret 4_u32 }
    if !output.contains("__encore_t61__Output") || !output.contains("__encore_t62__Output") {
        ret 5_u32
    }
    // Qualification must never rewrite user string data.
    if !output.contains("\"Output\"") { ret 6_u32 }
    ret 0_u32
}
