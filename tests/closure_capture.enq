import core::testing:: *

trait Handler {
    fn handle(self: Self, value: u32) -> u32
}

struct State {
    base: u32
}

impl for State {
    fn read(self: Self &) -> u32 {
        ret self.base
    }
}

fn invoke(handler: dyn Handler, value: u32) -> u32 {
    ret handler.handle(value)
}

fn main() -> u32 {
    let state = State < H > {
        40_u32
    }
    let handler: dyn Handler = | value | state.read() + value
    if !assert(invoke(handler, 2_u32) == 42_u32) {
        ret 1_u32
    }
    ret 0_u32
}
