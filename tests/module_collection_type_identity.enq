//! Collection constructors preserve the module identity of colliding item types.
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::{TranslationModule, translate_modules_to_ehir}
import refrain::target::host_target
import std::vec::Vec

fn main() -> u32 {
    let mut left_lexer = Lexer::new()
    let mut left_parser = Parser::new_for_source("left.enq")
    let left = left_parser.parse(left_lexer.tokenize(
        "struct Vec[T] {}\nstruct Connection { id: u32 }\nimpl for Connection { fn new() -> Self { ret Self { 1_u32 } } fn again() -> Self { ret Self::new() } fn value(self: Self) -> u32 { ret self.id } }\nfn accept(values: Vec[Connection]) -> u32 { ret 1_u32 }\nfn local() -> u32 { let item = Connection::again() let result = item.value() let values = Vec[Connection]::new() ret accept(values) }"))
    let mut right_lexer = Lexer::new()
    let mut right_parser = Parser::new_for_source("right.enq")
    let right = right_parser.parse(right_lexer.tokenize(
        "struct Connection { text: str }\nimpl for Connection { fn new() -> Self { ret Self { \"right\" } } fn again() -> Self { ret Self::new() } fn value(self: Self) -> str { ret self.text } }\nfn accept(values: Vec[Connection]) -> u32 { ret 2_u32 }\nfn local() -> u32 { let item = Connection::again() let result = item.value() let values = Vec[Connection]::with_capacity(4_usize) ret accept(values) }"))
    let mut modules = Vec[TranslationModule]::new()
    modules.push(TranslationModule::new("left", "left.enq", Vec[str]::new(), left, Vec[str]::new()))
    modules.push(TranslationModule::new("right", "right.enq", Vec[str]::new(), right, Vec[str]::new()))
    let output = translate_modules_to_ehir(modules, host_target())
    if !output.contains("fn __encore_m6c656674__accept(") || !output.contains("fn __encore_m7269676874__accept(") { ret 2_u32 }
    if output.contains("Vec[__encore_t6c656674__Connection]") && output.contains("Vec[__encore_t7269676874__Connection]") { ret 0_u32 }
    ret 1_u32
}
