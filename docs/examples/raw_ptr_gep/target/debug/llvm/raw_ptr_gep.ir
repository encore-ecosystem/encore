; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

%Pair = type { i32, i32 }

define i32 @main() {
entry:
  %._0_ptr = alloca i32, align 4
  store i32 1, ptr %._0_ptr, align 4
  %_0 = load i32, ptr %._0_ptr, align 4
  %._1_ptr = alloca i32, align 4
  store i32 2, ptr %._1_ptr, align 4
  %_1 = load i32, ptr %._1_ptr, align 4
  %.pair_1_ptr = alloca %Pair, align 8
  %..pair_1_ptr._0 = getelementptr %Pair, ptr %.pair_1_ptr, i32 0, i32 0
  store i32 %_0, ptr %..pair_1_ptr._0, align 4
  %..pair_1_ptr._1 = getelementptr %Pair, ptr %.pair_1_ptr, i32 0, i32 1
  store i32 %_1, ptr %..pair_1_ptr._1, align 4
  %pair_1 = load %Pair, ptr %.pair_1_ptr, align 4
  %pair = alloca %Pair, align 8
  store %Pair %pair_1, ptr %pair, align 4
  %pair_2 = load %Pair, ptr %pair, align 4
  %.39 = alloca %Pair, align 8
  store %Pair %pair_2, ptr %.39, align 4
  %b_3 = getelementptr %Pair, ptr %.39, i32 0, i32 1
  %._2_ptr = alloca i32, align 4
  store i32 7, ptr %._2_ptr, align 4
  %_2 = load i32, ptr %._2_ptr, align 4
  store i32 %_2, ptr %b_3, align 4
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.halloc_base = call ptr @malloc(i64 %.sizeof_u32_)
  %base = bitcast ptr %.halloc_base to ptr
  %.value_ptr = alloca i32, align 4
  store i32 11, ptr %.value_ptr, align 4
  %value = load i32, ptr %.value_ptr, align 4
  store i32 %value, ptr %base, align 4
  %.idx_ptr = alloca i64, align 8
  store i64 0, ptr %.idx_ptr, align 4
  %idx = load i64, ptr %.idx_ptr, align 4
  %elem_ptr = getelementptr i32, ptr %base, i64 %idx
  %elem = load i32, ptr %elem_ptr, align 4
  %.exit_var_ptr = alloca i32, align 4
  store i32 %elem, ptr %.exit_var_ptr, align 4
  %.br_zero_ptr = alloca i1, align 1
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}

; Function Attrs: noinline
declare ptr @malloc(i64) #0

attributes #0 = { noinline }
