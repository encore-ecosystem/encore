// ASCII donut (a1k0n math)

import core::fmt::Debug
import core::io::print
import core::io::println
import core::option::Option
import core::time::sleep_ms
import core::vec::Vec

let SCALE: i32 = 10000
let SIN_D: i32 = 200
let COS_D: i32 = 9998
let TAU_STEPS: usize = 314
let WIDTH: usize = 80
let HEIGHT: usize = 24
let R2: i32 = 20000
let K2: i32 = 50000
let CENTER_X: i32 = 40
let CENTER_Y: i32 = 12
let PROJECTION_X: i32 = 30
let PROJECTION_Y: i32 = 15

fn next_idx(idx: usize, delta: usize) -> usize {
    ret (idx + delta) % TAU_STEPS
}

fn get_i32_at(v: Vec[i32], idx: usize, fallback: i32) -> i32 {
    match v.get(idx) {
        Option[i32]::Some(x) => {
            ret x
        }
        Option[i32]::None => {
            ret fallback
        }
    }
}

fn get_str_at(v: Vec[str], idx: usize, fallback: str) -> str {
    match v.get(idx) {
        Option[str]::Some(x) => {
            ret x
        }
        Option[str]::None => {
            ret fallback
        }
    }
}

fn get_char_at(s: str, idx: usize, fallback: str) -> str {
    match s.get(idx) {
        Option[str]::Some(x) => {
            ret x
        }
        Option[str]::None => {
            ret fallback
        }
    }
}

fn muls(lhs: i32, rhs: i32) -> i32 {
    ret (lhs * rhs) / SCALE
}

fn reciprocal_depth(z: i32) -> i32 {
    ret (SCALE * SCALE) / z
}

fn project_term(scale_axis: i32, ooz: i32, value: i32) -> i32 {
    ret (((scale_axis * ooz) / SCALE) * value) / SCALE
}

fn build_sin() -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut s = 0_i32
    let mut c = SCALE
    let mut i = 0_usize
    loop {
        if i >= TAU_STEPS {
            break
        }
        out.push(s)
        let ns = (s * COS_D + c * SIN_D) / SCALE
        let nc = (c * COS_D - s * SIN_D) / SCALE
        s = ns
        c = nc
        i = i + 1_usize
    }
    ret out
}

fn build_cos() -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut s = 0_i32
    let mut c = SCALE
    let mut i = 0_usize
    loop {
        if i >= TAU_STEPS {
            break
        }
        out.push(c)
        let ns = (s * COS_D + c * SIN_D) / SCALE
        let nc = (c * COS_D - s * SIN_D) / SCALE
        s = ns
        c = nc
        i = i + 1_usize
    }
    ret out
}

fn fill_chars(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut i = 0_usize
    loop {
        if i >= WIDTH * HEIGHT {
            break
        }
        out.push(value)
        i = i + 1_usize
    }
    ret out
}

fn fill_i32(value: i32) -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut i = 0_usize
    loop {
        if i >= WIDTH * HEIGHT {
            break
        }
        out.push(value)
        i = i + 1_usize
    }
    ret out
}

fn set_pixel(buf: Vec[str], zbuf: Vec[i32], x: i32, y: i32, z: i32, ch: str) -> (Vec[str], Vec[i32]) {
    if x < 0_i32 || y < 0_i32 {
        ret (buf, zbuf)
    }

    let xu = x as usize
    let yu = y as usize
    if xu >= WIDTH || yu >= HEIGHT {
        ret (buf, zbuf)
    }

    let idx = yu * WIDTH + xu
    let prev_z = get_i32_at(zbuf, idx, 0_i32)
    if z > prev_z {
        let mut next_buf = buf
        let mut next_zbuf = zbuf
        next_buf.set(idx, ch)
        next_zbuf.set(idx, z)
        ret (next_buf, next_zbuf)
    }
    ret (buf, zbuf)
}

fn render(sins: Vec[i32], coss: Vec[i32], a_idx: usize, b_idx: usize) -> str {
    let shades = ".,-~:;=!*#$@"
    let mut out = fill_chars(" ")
    let mut zbuf = fill_i32(0_i32)

    let e = get_i32_at(sins, a_idx, 0_i32)
    let g = get_i32_at(coss, a_idx, SCALE)
    let n = get_i32_at(sins, b_idx, 0_i32)
    let m = get_i32_at(coss, b_idx, SCALE)

    let mut j = 0_usize
    loop {
        if j >= TAU_STEPS {
            break
        }
        let d = get_i32_at(coss, j, SCALE)
        let f = get_i32_at(sins, j, 0_i32)
        let h_val = d + R2

        let mut i = 0_usize
        loop {
            if i >= TAU_STEPS {
                break
            }
            let c = get_i32_at(sins, i, 0_i32)
            let l = get_i32_at(coss, i, SCALE)

            let z = muls(muls(c, h_val), e) + muls(f, g) + K2
            let ooz = reciprocal_depth(z)
            let t = muls(muls(c, h_val), g) - muls(f, e)

            let x_num = muls(muls(l, h_val), m) - muls(t, n)
            let y_num = muls(muls(l, h_val), n) + muls(t, m)
            let x = CENTER_X + project_term(PROJECTION_X, ooz, x_num)
            let y = CENTER_Y + project_term(PROJECTION_Y, ooz, y_num)

            let lum = muls((muls(f, e) - muls(muls(c, d), g)), m) - muls(muls(c, d), e) - muls(f, g) - muls(muls(l, d), n)
            if lum > 0_i32 {
                let mut shade = (8_i32 * lum) / SCALE
                if shade > 11_i32 {
                    shade = 11_i32
                }
                let ch = get_char_at(shades, shade as usize, ".")
                let pair = set_pixel(out, zbuf, x, y, ooz, ch)
                out = pair.0
                zbuf = pair.1
            }
            i = i + 1_usize
        }
        j = j + 4_usize
    }

    let mut screen_text = ""
    let mut row = 0_usize
    loop {
        if row >= HEIGHT {
            break
        }
        let mut col = 0_usize
        loop {
            if col >= WIDTH {
                break
            }
            let idx = row * WIDTH + col
            screen_text = screen_text + get_str_at(out, idx, " ")
            col = col + 1_usize
        }
        screen_text = screen_text + "\n"
        row = row + 1_usize
    }
    ret screen_text
}

fn main() -> u32 {
    let sins = build_sin()
    let coss = build_cos()

    let mut a = 0_usize
    let mut b = 0_usize
    let mut frame = 0_usize

    loop {
        if frame >= 1000_usize {
            break
        }
        print("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n")
        print(render(sins, coss, a, b))

        a = next_idx(a, 2_usize)
        b = next_idx(b, 1_usize)
        frame = frame + 1_usize
        sleep_ms(40_u64)
    }
    ret 0_u32
}
