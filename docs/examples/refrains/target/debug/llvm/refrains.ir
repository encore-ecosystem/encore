; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

define i64 @main() {
entry:
  %.sizeof_usize_ptr = getelementptr i64, ptr null, i32 1
  %.sizeof_usize_ = ptrtoint ptr %.sizeof_usize_ptr to i64
  %.salloc_._0_ptr = alloca i8, i64 %.sizeof_usize_, align 1
  %._0_ptr = bitcast ptr %.salloc_._0_ptr to ptr
  store i64 15, ptr %._0_ptr, align 4
  %_0 = load i64, ptr %._0_ptr, align 4
  %.sizeof_usize_ptr.1 = getelementptr i64, ptr null, i32 1
  %.sizeof_usize_.1 = ptrtoint ptr %.sizeof_usize_ptr.1 to i64
  %.salloc_._1_ptr = alloca i8, i64 %.sizeof_usize_.1, align 1
  %._1_ptr = bitcast ptr %.salloc_._1_ptr to ptr
  store i64 16, ptr %._1_ptr, align 4
  %_1 = load i64, ptr %._1_ptr, align 4
  %_2 = call i64 @sum(i64 %_0, i64 %_1)
  %.sizeof_usize_ptr.2 = getelementptr i64, ptr null, i32 1
  %.sizeof_usize_.2 = ptrtoint ptr %.sizeof_usize_ptr.2 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_usize_.2, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i64 %_2, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i64, ptr %.exit_var_ptr, align 4
  ret i64 %.exit_var
}

define i64 @sum(i64 %a.1, i64 %b.1) {
entry:
  %_0 = add i64 %a.1, %b.1
  %.sizeof_usize_ptr = getelementptr i64, ptr null, i32 1
  %.sizeof_usize_ = ptrtoint ptr %.sizeof_usize_ptr to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_usize_, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i64 %_0, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i64, ptr %.exit_var_ptr, align 4
  ret i64 %.exit_var
}
