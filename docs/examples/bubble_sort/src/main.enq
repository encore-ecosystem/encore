import std::{
    vec::Vec,
    fmt::Debug,
    io::println,
    option::Option,
}

fn fmt_vec_i32(values: Vec[i32]) -> str {
    let mut out = "["
    let mut i = 0_usize
    while i < values.len() {
        if i > 0_usize {
            out = out + ", "
        }
        match values.get(i) {
            Option::Some(v) => {
                out = out + Debug::fmt(v)
            }
            Option::None => {}
        }
        i = i + 1_usize
    }
    ret out + "]"
}

fn bubble_sort(values: Vec[i32]) -> Vec[i32] {
    let mut out = values
    let n = out.len()
    if n < 2_usize {
        ret out
    }

    let mut i = 0_usize
    while i < n {
        let mut j = 0_usize
        while j + 1_usize < n - i {
            let mut a = 0_i32
            match out.get(j) {
                Option::Some(v) => {
                    a = v
                }
                Option::None => {}
            }
            let mut b = 0_i32
            match out.get(j + 1_usize) {
                Option::Some(v) => {
                    b = v
                }
                Option::None => {}
            }

            if a > b {
                out.set(j, b)
                out.set(j + 1_usize, a)
            }
            j = j + 1_usize
        }
        i = i + 1_usize
    }
    ret out
}

fn main() -> u32 {
    let mut data = Vec[i32]::new()
    data.push(8_i32)
    data.push(1_i32)
    data.push(6_i32)
    data.push(2_i32)
    data.push(9_i32)
    data.push(4_i32)

    println("Before: " + fmt_vec_i32(data))
    let sorted = bubble_sort(data)
    println("After : " + fmt_vec_i32(sorted))
    ret 0_u32
}
