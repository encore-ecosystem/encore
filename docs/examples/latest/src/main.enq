trait T_Shape {
    fn get_area(self) -> f32
}

trait T_Rectangle < T_Shape {
    fn get_perimeter(self) -> f32
}

struct Square {
    a: f32
}

struct Rectangle {
    a: f32
    b: f32
}

impl for Square {
    pub fn new(a: f32) -> Self {
        ret Square{a}
    }
}

impl for Rectangle {
    pub fn new(a: f32, b: f32) -> Self {
        ret Rectangle{a, b}
    }
}

impl T_Rectangle for Square {
    pub fn get_area(self) -> f32 {
        ret self.a * self.a
    }

    pub fn get_perimeter(self) -> f32 {
        ret 4 * self.a
    }
}

impl T_Rectangle for Rectangle {
    pub fn get_area(self) -> f32 {
        ret self.a * self.b
    }

    pub fn get_perimeter(self) -> f32 {
        ret 2 * (self.a + self.b)
    }
}

fn main() -> f32 {
    let sq = Square::new(3.0)
    let rc = Rectangle::new(5.0, 4.0)
    let a = sq.get_area() + sq.get_perimeter()
    let b = rc.get_area() + rc.get_perimeter()
    ret a + b
}
