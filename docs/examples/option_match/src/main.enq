enum Option[T] {
    Some(T)
    None
}

fn increment(opt: Option[u32]) -> Option[u32] {
    match opt {
        Some(value) => {
            ret Option[u32]::Some(value + 1_u32)
        }
        None => {
            ret Option[u32]::None
        }
    }
}

fn unwrap_or_zero(opt: Option[u32]) -> u32 {
    match opt {
        Some(value) => {
            ret value
        }
        None => {
            ret 0_u32
        }
    }
}

fn main() -> u32 {
    let some = Option[u32]::Some(41_u32)
    let none = Option[u32]::None

    let lhs = unwrap_or_zero(increment(some))
    let rhs = unwrap_or_zero(increment(none))

    ret lhs + rhs
}
