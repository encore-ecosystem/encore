#cfg(feature = "left")
extern fn feature_left_native() -> u32

#cfg(feature = "left")
pub fn left() -> u32 {
    ret unsafe { feature_left_native() }
}

#cfg(feature = "right")
extern fn feature_right_native() -> u32

#cfg(feature = "right")
pub fn right() -> u32 {
    ret unsafe { feature_right_native() }
}
