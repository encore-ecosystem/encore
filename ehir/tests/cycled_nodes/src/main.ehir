imp core::smart_box::Box

enum Option[T] {
  Some(T)
  None
}

struct NodeWithIndex {
  index: usize
  next: Option[Box[NodeWithIndex]]
  prev: Option[Box[NodeWithIndex]]
}

impl NodeWithIndex {
  pub fn new(index: usize) -> Box[NodeWithIndex] {
    $entry:
      next: Option[Box[NodeWithIndex]] = capenum Option[Box[NodeWithIndex]]::None()
      prev: Option[Box[NodeWithIndex]] = capenum Option[Box[NodeWithIndex]]::None()
      node: NodeWithIndex = capstruct NodeWithIndex(index: usize, next: Option[Box[NodeWithIndex]], prev: Option[Box[NodeWithIndex]])
      boxed: Box[NodeWithIndex] = call Box[NodeWithIndex]::wrap[NodeWithIndex](node: NodeWithIndex)
      ret boxed: Box[NodeWithIndex]
  }
}

fn set_next(node: Box[NodeWithIndex], next_node: Box[NodeWithIndex]) -> () {
  $entry:
    current: NodeWithIndex = call Box[NodeWithIndex]::load[NodeWithIndex](node: Box[NodeWithIndex])
    next: Option[Box[NodeWithIndex]] = capenum Option[Box[NodeWithIndex]]::Some(next_node: Box[NodeWithIndex])
    setfield current: NodeWithIndex, next, next: Option[Box[NodeWithIndex]]
    done: () = call Box[NodeWithIndex]::store[NodeWithIndex](node: Box[NodeWithIndex], current: NodeWithIndex)
    ret done: ()
}

fn set_prev(node: Box[NodeWithIndex], prev_node: Box[NodeWithIndex]) -> () {
  $entry:
    current: NodeWithIndex = call Box[NodeWithIndex]::load[NodeWithIndex](node: Box[NodeWithIndex])
    prev: Option[Box[NodeWithIndex]] = capenum Option[Box[NodeWithIndex]]::Some(prev_node: Box[NodeWithIndex])
    setfield current: NodeWithIndex, prev, prev: Option[Box[NodeWithIndex]]
    done: () = call Box[NodeWithIndex]::store[NodeWithIndex](node: Box[NodeWithIndex], current: NodeWithIndex)
    ret done: ()
}

fn next_of(node: Box[NodeWithIndex]) -> Box[NodeWithIndex] {
  $entry:
    current: NodeWithIndex = call Box[NodeWithIndex]::load[NodeWithIndex](node: Box[NodeWithIndex])
    next: Option[Box[NodeWithIndex]] = getfield current: NodeWithIndex, next
    match next: Option[Box[NodeWithIndex]], $none {
      Some(next_node: Box[NodeWithIndex]) => $some
    }
  $some:
    ret next_node: Box[NodeWithIndex]
  $none:
    ret node: Box[NodeWithIndex]
}

fn sum_cycle3(start: Box[NodeWithIndex]) -> usize {
  $entry:
    first: NodeWithIndex = call Box[NodeWithIndex]::load[NodeWithIndex](start: Box[NodeWithIndex])
    i0: usize = getfield first: NodeWithIndex, index

    second_box: Box[NodeWithIndex] = call next_of(start: Box[NodeWithIndex])
    second: NodeWithIndex = call Box[NodeWithIndex]::load[NodeWithIndex](second_box: Box[NodeWithIndex])
    i1: usize = getfield second: NodeWithIndex, index

    third_box: Box[NodeWithIndex] = call next_of(second_box: Box[NodeWithIndex])
    third: NodeWithIndex = call Box[NodeWithIndex]::load[NodeWithIndex](third_box: Box[NodeWithIndex])
    i2: usize = getfield third: NodeWithIndex, index

    partial: usize = add i0: usize, i1: usize
    total: usize = add partial: usize, i2: usize
    ret total: usize
}

fn main() -> usize {
  $entry:
    zero: usize = capprim 0_usize
    one: usize = capprim 1_usize
    two: usize = capprim 2_usize

    a: Box[NodeWithIndex] = call NodeWithIndex::new(zero: usize)
    b: Box[NodeWithIndex] = call NodeWithIndex::new(one: usize)
    c: Box[NodeWithIndex] = call NodeWithIndex::new(two: usize)

    ab: () = call set_next(a: Box[NodeWithIndex], b: Box[NodeWithIndex])
    ba: () = call set_prev(b: Box[NodeWithIndex], a: Box[NodeWithIndex])
    bc: () = call set_next(b: Box[NodeWithIndex], c: Box[NodeWithIndex])
    cb: () = call set_prev(c: Box[NodeWithIndex], b: Box[NodeWithIndex])
    ca: () = call set_next(c: Box[NodeWithIndex], a: Box[NodeWithIndex])
    ac: () = call set_prev(a: Box[NodeWithIndex], c: Box[NodeWithIndex])

    result: usize = call sum_cycle3(a: Box[NodeWithIndex])
    ret result: usize
}
