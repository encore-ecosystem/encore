#attr(safe)
struct Inner {
  value: usize
}

struct Middle {
  inner: Inner
}

struct Outer {
  middle: Middle
}

#attr(safe)
fn main() -> usize {
  $entry:
    one: usize = capprim 1_usize
    inner: Inner = capstruct Inner(one: usize)
    middle: Middle = capstruct Middle(inner: Inner)
    outer: Outer = capstruct Outer(middle: Middle)

    got: usize = getfield outer: Outer, middle::inner::value

    two: usize = capprim 2_usize
    setfield outer: Outer, middle::inner::value, two: usize

    value_ptr: usize* = getfieldptr outer: Outer, middle::inner::value
    updated: usize = load value_ptr: usize*
    ret updated: usize
}
