enum Option[T] {
    Some(T)
    None
}

struct Node {
    index : usize
    next  : Option[Box[Node]]
}

impl Node {
    pub fn new(index: usize) -> &Self {
      $entry:
        none  = capenum   Option::None
        raw   = capstruct Node(index, none)
        boxed = wrap      raw
        ret boxed
    }
}

fn main() -> usize {
  $entry:
    ; 1.1
    index_1 = capprim 1_usize
    node_1  = methodcall Node::new(index_1)

    ; 1.2
    index_2 = capprim 2_usize
    node_2  = methodcall Node::new(index_2)

    ; 1.3
    some_2 = capenum Option::Some(node_2)
    setfield node_1 > next, some_2

    ; 1.4
    some_1 = capenum Option::Some(node_1)
    setfield node_2 > next, some_1

    ; 1.5
    s1 = getfield node_1 > index
    s2 = getfield node_2 > index
    s  = add s1, s2
    ret s
}
