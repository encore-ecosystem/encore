imp core::smart_box::Box

enum Option[T] {
  Some(T)
  None
}

struct ListNode {
  value: usize
  next: Option[Box[ListNode]]
}

impl ListNode {
  pub fn new(value: usize) -> Box[ListNode] {
    $entry:
      next: Option[Box[ListNode]] = capenum Option[Box[ListNode]]::None()
      node: ListNode = capstruct ListNode(value: usize, next: Option[Box[ListNode]])
      boxed: Box[ListNode] = call Box[ListNode]::wrap[ListNode](node: ListNode)
      ret boxed: Box[ListNode]
  }
}

fn summator(node: Box[ListNode]) -> usize {
  $entry:
    node_value: ListNode = call Box[ListNode]::load[ListNode](node: Box[ListNode])
    val: usize = getfield node_value: ListNode, value
    next: Option[Box[ListNode]] = getfield node_value: ListNode, next
    match next: Option[Box[ListNode]], $none {
      Some(next_node: Box[ListNode]) => $some
    }
  $some:
    sum: usize = call summator(next_node: Box[ListNode])
    res: usize = add val: usize, sum: usize
    ret res: usize
  $none:
    ret val: usize
}

fn main() -> usize {
  $entry:
    three: usize = capprim 3_usize
    seven: usize = capprim 7_usize

    head: Box[ListNode] = call ListNode::new(three: usize)
    tail: Box[ListNode] = call ListNode::new(seven: usize)

    head_value: ListNode = call Box[ListNode]::load[ListNode](head: Box[ListNode])
    head_num: usize = getfield head_value: ListNode, value
    some_tail: Option[Box[ListNode]] = capenum Option[Box[ListNode]]::Some(tail: Box[ListNode])
    updated_head: ListNode = capstruct ListNode(head_num: usize, some_tail: Option[Box[ListNode]])
    done: () = call Box[ListNode]::store[ListNode](head: Box[ListNode], updated_head: ListNode)

    result: usize = call summator(head: Box[ListNode])
    ret result: usize
}
