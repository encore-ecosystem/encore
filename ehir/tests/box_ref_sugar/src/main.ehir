struct Point {
  value: usize
}

fn read_value(self: &Point) -> usize {
  $entry:
    point: Point = call Box[T]::load[Point](self: &Point)
    value: usize = getfield point: Point, value
    ret value: usize
}

fn main() -> usize {
  $entry:
    seven: usize = capprim 7_usize
    point: Point = capstruct Point(seven: usize)
    boxed: &Point = call Box[T]::wrap[Point](point: Point)
    value: usize = call read_value(boxed: &Point)
    ret value: usize
}
