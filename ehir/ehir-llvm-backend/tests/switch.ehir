fn classify(x: usize) -> usize {
  $entry:
    switch x, $other {
      1_usize => $one
      2_usize => $two
    }

  $one:
    v1 = capprim 10_usize
    ret v1

  $two:
    v2 = capprim 20_usize
    ret v2

  $other:
    v3 = capprim 30_usize
    ret v3
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    two = capprim 2_usize
    three = capprim 3_usize
    a = call classify(one)
    b = call classify(two)
    c = call classify(three)
    ab = add a, b
    got = add ab, c
    exp = capprim 60_usize
    ok = ieq got, exp
    cbr ok, $ok, $err

  $ok:
    z0 = capprim 0_usize
    ret z0

  $err:
    z1 = capprim 1_usize
    ret z1
}
