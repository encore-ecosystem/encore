trait Show {
  fn show(self: Self) -> usize
}

struct Counter {
  value: usize
}

impl Show for Counter {
  fn show(self: Counter) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

fn main() -> usize {
  $entry:
    n = capprim 42_usize
    c = capstruct Counter(n)
    d = pcast c, dyn Show
    got = call Show::show(d)
    exp = capprim 42_usize
    ok = ieq got, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
