;@cfree.free_ids=node_1,node_2
enum Option[T] {
    Some(T)
    None
}

struct Node {
    id: str
    index : usize
    next  : Option[Box[Node]]
}

impl Node {
    pub fn new(id: str, index: usize) -> Box[Self] {
      $entry:
        none  = capenum   Option[Box[Node]]::None
        raw   = capstruct Node(id, index, none)
        boxed = wraph     raw
        ret boxed
    }
}

fn main() -> usize {
  $entry:
    id1s = capprim "node_1"_str
    id2s = capprim "node_2"_str
    index_1 = capprim 1_usize
    node_1  = call Node::new(id1s, index_1)

    index_2 = capprim 2_usize
    node_2  = call Node::new(id2s, index_2)

    some_2 = capenum Option[Box[Node]]::Some(node_2)
    setfield node_1 > next, some_2

    some_1 = capenum Option[Box[Node]]::Some(node_1)
    setfield node_2 > next, some_1

    s1 = getfield node_1 > index
    s2 = getfield node_2 > index
    s  = add s1, s2
    exp = capprim 3_usize
    ok = ieq s, exp
    cbr ok, $ok_br, $fail_br

  $ok_br:
    z0 = capprim 0_usize
    ret z0

  $fail_br:
    z1 = capprim 1_usize
    ret z1
}
