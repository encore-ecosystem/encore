trait AddLike {
  fn add(self: Self, other: Self) -> Self
}

impl AddLike for usize {
  fn add(self: usize, other: usize) -> usize {
    $entry:
      out = add self, other
      ret out
  }
}

fn main() -> usize {
  $entry:
    a = capprim 20_usize
    b = capprim 22_usize
    out = call AddLike::add(a, b)
    exp = capprim 42_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
