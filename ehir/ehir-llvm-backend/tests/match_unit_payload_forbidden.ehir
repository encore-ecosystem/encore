;@expect.compile_error=does not carry payload but payload variable was provided
enum Status {
  Ok
  Err(usize)
}

fn main() -> usize {
  $entry:
    zero = capprim 0_usize
    val = capenum Status::Ok()
    match val, $fallback {
      Ok(zero) => $a
    }
  $a:
    ret zero
  $fallback:
    ret zero
}
