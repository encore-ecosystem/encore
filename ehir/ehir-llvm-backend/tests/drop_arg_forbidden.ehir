;@expect.compile_error=Manual drop for function parameter
struct Payload {
  value: usize
}

fn consume(boxed: Box[Payload]) -> usize {
  $entry:
    drop boxed
    zero = capprim 0_usize
    ret zero
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    raw = capstruct Payload(one)
    boxed = wraph raw
    out = call consume(boxed)
    ret out
}
