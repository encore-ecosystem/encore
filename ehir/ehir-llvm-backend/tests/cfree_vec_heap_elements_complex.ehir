;@cfree.free_ids=vec,item0,item0_child,item1,item1_new,item2,item3
enum Option[T] {
  Some(T)
  None
}

struct Item {
  id: str
  value: usize
  child: Option[Box[Item]]
}

struct Vec3 {
  id: str
  len: usize
  slot0: Option[Box[Item]]
  slot1: Option[Box[Item]]
  slot2: Option[Box[Item]]
  spare: Option[Box[Item]]
}

impl Item {
  pub fn new(id: str, value: usize) -> Box[Self] {
    $entry:
      none = capenum Option[Box[Item]]::None
      raw = capstruct Item(id, value, none)
      boxed = wraph raw
      ret boxed
  }
}

impl Vec3 {
  pub fn new(id: str) -> Box[Self] {
    $entry:
      zero = capprim 0_usize
      none = capenum Option[Box[Item]]::None
      raw = capstruct Vec3(id, zero, none, none, none, none)
      boxed = wraph raw
      ret boxed
  }
}

fn main() -> usize {
  $entry:
    vec_id = capprim "vec"_str
    item0_id = capprim "item0"_str
    item0_child_id = capprim "item0_child"_str
    item1_id = capprim "item1"_str
    item1_new_id = capprim "item1_new"_str
    item2_id = capprim "item2"_str
    item3_id = capprim "item3"_str

    v0 = capprim 10_usize
    v1 = capprim 11_usize
    v2 = capprim 12_usize
    v3 = capprim 13_usize
    v4 = capprim 14_usize
    v5 = capprim 15_usize
    vlen = capprim 3_usize

    vec = call Vec3::new(vec_id)
    item0 = call Item::new(item0_id, v0)
    item0_child = call Item::new(item0_child_id, v1)
    item1 = call Item::new(item1_id, v2)
    item1_new = call Item::new(item1_new_id, v3)
    item2 = call Item::new(item2_id, v4)
    item3 = call Item::new(item3_id, v5)

    some_child = capenum Option[Box[Item]]::Some(item0_child)
    setfield item0 > child, some_child

    some0 = capenum Option[Box[Item]]::Some(item0)
    setfield vec > slot0, some0
    some1 = capenum Option[Box[Item]]::Some(item1)
    setfield vec > slot1, some1
    some2 = capenum Option[Box[Item]]::Some(item2)
    setfield vec > slot2, some2
    setfield vec > len, vlen

    none0 = capenum Option[Box[Item]]::None
    setfield vec > slot0, none0

    some1_new_a = capenum Option[Box[Item]]::Some(item1_new)
    setfield vec > slot1, some1_new_a
    old_item1_value = getfield item1 > value

    some1_new_b = capenum Option[Box[Item]]::Some(item1_new)
    setfield vec > slot2, some1_new_b

    some2_spare = capenum Option[Box[Item]]::Some(item2)
    setfield vec > spare, some2_spare
    setfield vec > slot2, none0

    some3 = capenum Option[Box[Item]]::Some(item3)
    setfield vec > slot0, some3

    len_value = getfield vec > len
    item3_value = getfield item3 > value
    item2_value = getfield item2 > value
    item1_new_value = getfield item1_new > value
    sum0 = add len_value, old_item1_value
    sum1 = add sum0, item1_new_value
    sum2 = add sum1, item2_value
    sum3 = add sum2, item3_value
    exp = capprim 57_usize
    ok = ieq sum3, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
