;@cfree.free_ids=a,b,c,target0,target1,target2,target2_leaf,target3
enum Option[T] {
  Some(T)
  None
}

struct Target {
  id: str
  value: usize
  child: Option[Box[Target]]
}

struct C {
  id: str
  target: Box[Target]
}

struct B {
  id: str
  c: Box[C]
}

struct A {
  id: str
  b: Box[B]
  saved: Option[Box[Target]]
}

impl Target {
  pub fn new(id: str, value: usize) -> Box[Self] {
    $entry:
      none = capenum Option[Box[Target]]::None
      raw = capstruct Target(id, value, none)
      boxed = wraph raw
      ret boxed
  }
}

impl C {
  pub fn new(id: str, target: Box[Target]) -> Box[Self] {
    $entry:
      raw = capstruct C(id, target)
      boxed = wraph raw
      ret boxed
  }
}

impl B {
  pub fn new(id: str, c: Box[C]) -> Box[Self] {
    $entry:
      raw = capstruct B(id, c)
      boxed = wraph raw
      ret boxed
  }
}

impl A {
  pub fn new(id: str, b: Box[B]) -> Box[Self] {
    $entry:
      none = capenum Option[Box[Target]]::None
      raw = capstruct A(id, b, none)
      boxed = wraph raw
      ret boxed
  }
}

fn main() -> usize {
  $entry:
    a_id = capprim "a"_str
    b_id = capprim "b"_str
    c_id = capprim "c"_str
    t0_id = capprim "target0"_str
    t1_id = capprim "target1"_str
    t2_id = capprim "target2"_str
    t2_leaf_id = capprim "target2_leaf"_str
    t3_id = capprim "target3"_str

    v0 = capprim 100_usize
    v1 = capprim 101_usize
    v2 = capprim 102_usize
    v3 = capprim 103_usize
    v4 = capprim 104_usize

    target0 = call Target::new(t0_id, v0)
    target1 = call Target::new(t1_id, v1)
    target2 = call Target::new(t2_id, v2)
    target2_leaf = call Target::new(t2_leaf_id, v3)
    target3 = call Target::new(t3_id, v4)

    c = call C::new(c_id, target0)
    b = call B::new(b_id, c)
    a = call A::new(a_id, b)

    setfield a > b > c > target, target1
    target1_value = getfield target1 > value

    saved_target1 = capenum Option[Box[Target]]::Some(target1)
    setfield a > saved, saved_target1
    setfield a > b > c > target, target2

    target1_alias_value = getfield target1 > value
    none0 = capenum Option[Box[Target]]::None
    setfield a > saved, none0

    leaf_link = capenum Option[Box[Target]]::Some(target2_leaf)
    setfield target2 > child, leaf_link
    setfield a > b > c > target, target3

    final_value = getfield a > b > c > target > value
    sum0 = add target1_value, target1_alias_value
    sum1 = add sum0, final_value
    exp = capprim 306_usize
    ok = ieq sum1, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
