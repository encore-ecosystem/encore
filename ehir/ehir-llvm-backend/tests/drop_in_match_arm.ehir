;@cfree.free_ids=match_payload
enum Option[T] {
  Some(T)
  None
}

struct Payload {
  id: str
  value: usize
}

fn main() -> usize {
  $entry:
    id = capprim "match_payload"_str
    one = capprim 1_usize
    raw = capstruct Payload(id, one)
    boxed = wraph raw
    opt = capenum Option[Box[Payload]]::Some(boxed)
    match opt, $none {
      Some(payload) => $some
    }
  $some:
    drop payload
    zero = capprim 0_usize
    ret zero
  $none:
    one_fail = capprim 1_usize
    ret one_fail
}
