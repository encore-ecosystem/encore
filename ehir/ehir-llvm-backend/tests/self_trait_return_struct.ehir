struct WrapU {
  value: usize
}

trait CloneLike {
  fn clone(self: Self) -> Self
}

impl CloneLike for WrapU {
  fn clone(self: Self) -> Self {
    $entry:
      v = sgetfield self, value
      out = capstruct WrapU(v)
      ret out
  }
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    src = capstruct WrapU(one)
    dst = call CloneLike::clone(src)
    out = sgetfield dst, value
    exp = capprim 1_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
