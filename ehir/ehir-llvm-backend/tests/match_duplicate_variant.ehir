;@expect.compile_error=Duplicate match variant 'Some'
enum Option[T] {
  Some(T)
  None
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    val = capenum Option[usize]::Some(one)
    match val, $fallback {
      Some => $a
      Some => $b
    }
  $a:
    ret one
  $b:
    ret one
  $fallback:
    zero = capprim 0_usize
    ret zero
}
