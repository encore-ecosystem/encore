fn main() -> usize {
  $entry:
    a = capprim 20_usize
    b = capprim 6_usize

    sub_v = sub a, b
    mul_v = mul b, b
    div_v = div a, b
    mod_v = mod a, b

    one = capprim 1_usize
    three = capprim 3_usize
    shl_v = shl one, three
    thirty_two = capprim 32_usize
    two = capprim 2_usize
    shr_v = shr thirty_two, two

    and_v = and a, b
    or_v = or a, b
    xor_v = xor a, b

    exp_sub = capprim 14_usize
    exp_mul = capprim 36_usize
    exp_div = capprim 3_usize
    exp_mod = capprim 2_usize
    exp_shl = capprim 8_usize
    exp_shr = capprim 8_usize
    exp_and = capprim 4_usize
    exp_or = capprim 22_usize
    exp_xor = capprim 18_usize

    e_sub = ieq sub_v, exp_sub
    e_mul = ieq mul_v, exp_mul
    e_div = ieq div_v, exp_div
    e_mod = ieq mod_v, exp_mod
    e_shl = ieq shl_v, exp_shl
    e_shr = ieq shr_v, exp_shr
    e_and = ieq and_v, exp_and
    e_or = ieq or_v, exp_or
    e_xor = ieq xor_v, exp_xor

    lt = les b, a
    le = leq b, b
    gt = grt a, b
    ge = geq a, a
    ne = neq a, b

    ok0 = and e_sub, e_mul
    ok1 = and e_div, e_mod
    ok2 = and e_shl, e_shr
    ok3 = and e_and, e_or
    ok4 = and ok0, ok1
    ok5 = and ok2, ok3
    ok6 = and ok4, ok5
    ok7 = and e_xor, lt
    ok8 = and le, gt
    ok9 = and ge, ne
    okA = and ok7, ok8
    okB = and okA, ok9
    ok = and ok6, okB

    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
