fn bump(ptr: usize*) -> usize {
  $entry:
    curr = load ptr
    one = capprim 1_usize
    next = add curr, one
    store next, ptr
    ret next
}

fn main() -> usize {
  $entry:
    z = capprim 0_usize
    p = salloc usize
    store z, p
    call bump(p)
    out = load p
    exp = capprim 1_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
