struct Wrap[T] {
  value: T
}

trait CloneLike {
  fn clone(self: Self) -> Self
}

impl[T] CloneLike for Wrap[T] {
  fn clone(self: Self) -> Self {
    $entry:
      v = sgetfield self, value
      out = capstruct Wrap[T](v)
      ret out
  }
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    w = capstruct Wrap[usize](one)
    copy = call CloneLike::clone(w)
    got = sgetfield copy, value
    exp = capprim 1_usize
    ok = ieq got, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
