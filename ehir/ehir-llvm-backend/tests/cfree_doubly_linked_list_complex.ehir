;@cfree.free_ids=head,n1,n2,n3,inserted,tail,side
enum Option[T] {
  Some(T)
  None
}

struct DNode {
  id: str
  value: usize
  prev: Option[Box[DNode]]
  next: Option[Box[DNode]]
  side: Option[Box[DNode]]
}

impl DNode {
  pub fn new(id: str, value: usize) -> Box[Self] {
    $entry:
      none = capenum Option[Box[DNode]]::None
      raw = capstruct DNode(id, value, none, none, none)
      boxed = wraph raw
      ret boxed
  }
}

fn main() -> usize {
  $entry:
    head_id = capprim "head"_str
    n1_id = capprim "n1"_str
    n2_id = capprim "n2"_str
    n3_id = capprim "n3"_str
    inserted_id = capprim "inserted"_str
    tail_id = capprim "tail"_str
    side_id = capprim "side"_str

    v0 = capprim 0_usize
    v1 = capprim 1_usize
    v2 = capprim 2_usize
    v3 = capprim 3_usize
    v4 = capprim 4_usize
    v5 = capprim 5_usize
    v6 = capprim 6_usize

    head = call DNode::new(head_id, v0)
    n1 = call DNode::new(n1_id, v1)
    n2 = call DNode::new(n2_id, v2)
    n3 = call DNode::new(n3_id, v3)
    inserted = call DNode::new(inserted_id, v4)
    tail = call DNode::new(tail_id, v5)
    side = call DNode::new(side_id, v6)

    none0 = capenum Option[Box[DNode]]::None
    some_n1_a = capenum Option[Box[DNode]]::Some(n1)
    setfield head > next, some_n1_a
    some_head = capenum Option[Box[DNode]]::Some(head)
    setfield n1 > prev, some_head

    some_n2_a = capenum Option[Box[DNode]]::Some(n2)
    setfield n1 > next, some_n2_a
    some_n1_b = capenum Option[Box[DNode]]::Some(n1)
    setfield n2 > prev, some_n1_b

    some_n3_a = capenum Option[Box[DNode]]::Some(n3)
    setfield n2 > next, some_n3_a
    some_n2_b = capenum Option[Box[DNode]]::Some(n2)
    setfield n3 > prev, some_n2_b

    some_tail_a = capenum Option[Box[DNode]]::Some(tail)
    setfield n3 > next, some_tail_a
    some_n3_b = capenum Option[Box[DNode]]::Some(n3)
    setfield tail > prev, some_n3_b

    some_side_a = capenum Option[Box[DNode]]::Some(side)
    setfield head > side, some_side_a
    some_n2_c = capenum Option[Box[DNode]]::Some(n2)
    setfield side > next, some_n2_c

    some_inserted_prev = capenum Option[Box[DNode]]::Some(n1)
    setfield inserted > prev, some_inserted_prev
    some_inserted_next = capenum Option[Box[DNode]]::Some(n2)
    setfield inserted > next, some_inserted_next
    some_inserted = capenum Option[Box[DNode]]::Some(inserted)
    setfield n1 > next, some_inserted
    some_inserted_back = capenum Option[Box[DNode]]::Some(inserted)
    setfield n2 > prev, some_inserted_back

    some_tail_b = capenum Option[Box[DNode]]::Some(tail)
    setfield n2 > next, some_tail_b
    some_n2_d = capenum Option[Box[DNode]]::Some(n2)
    setfield tail > prev, some_n2_d
    setfield n3 > prev, none0
    setfield n3 > next, none0

    a = getfield head > value
    b = getfield n1 > value
    c = getfield inserted > value
    d = getfield n2 > value
    e = getfield tail > value
    f = getfield side > value
    detached = getfield n3 > value
    sum0 = add a, b
    sum1 = add sum0, c
    sum2 = add sum1, d
    sum3 = add sum2, e
    sum4 = add sum3, f
    sum5 = add sum4, detached
    exp = capprim 21_usize
    ok = ieq sum5, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
