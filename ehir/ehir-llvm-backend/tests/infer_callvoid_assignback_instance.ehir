struct Counter {
  value: usize
}

impl Counter {
  fn inc(self: Self) -> Self {
    $entry:
      one = capprim 1_usize
      curr = sgetfield self, value
      next = add curr, one
      out = capstruct Counter(next)
      ret out
  }
}

fn main() -> usize {
  $entry:
    zero = capprim 0_usize
    c = capstruct Counter(zero)
    callvoid c::inc()
    callvoid c::inc()
    out = sgetfield c, value
    exp = capprim 2_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
