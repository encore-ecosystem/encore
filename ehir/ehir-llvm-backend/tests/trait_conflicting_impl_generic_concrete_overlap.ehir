;@expect.compile_error=Conflicting trait impl
struct Wrap[T] {
  value: T
}

trait Show {
  fn show(self: Self) -> usize
}

impl[T] Show for Wrap[T] {
  fn show(self: Self) -> usize {
    $entry:
      z0 = capprim 0_usize
      ret z0
  }
}

impl Show for Wrap[usize] {
  fn show(self: Self) -> usize {
    $entry:
      z1 = capprim 1_usize
      ret z1
  }
}

fn main() -> usize {
  $entry:
    z = capprim 0_usize
    ret z
}
