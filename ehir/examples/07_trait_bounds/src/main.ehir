; Trait and impl bounds via `where`.

trait Add[Rhs] {
  fn op(self: Self, rhs: Rhs) -> Self
}

trait Scale {
  fn by_two(self: Self) -> Self
}

trait Fold[T] where T: Add + Scale {
  fn fold(lhs: T, rhs: T) -> T
}

impl[T] Fold[T] for T where T: Add + Scale {
  fn fold(lhs: T, rhs: T) -> T {
    $entry:
      twice: T = call Scale::by_two(lhs: T)
      out: T = call Add::op(twice: T, rhs: T)
      ret out: T
  }
}
