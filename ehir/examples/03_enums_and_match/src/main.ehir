; Enum declarations, enum construction and payload-sensitive match.

enum Option[T] {
  Some(T)
  None
}

fn make_some() -> Option[u32] {
  $entry:
    value: u32 = capprim 7_u32
    opt: Option[u32] = capenum Option[u32]::Some(value: u32)
    ret opt: Option[u32]
}

fn unwrap_or_zero(value: Option[u32]) -> u32 {
  $entry:
    match value: Option[u32], $none {
      Some(payload: u32) => $some
    }
  $some:
    ret payload: u32
  $none:
    zero: u32 = capprim 0_u32
    ret zero: u32
}
