; Traits, impl blocks and trait method calls.

trait Add[Rhs] {
  fn op(self: Self, rhs: Rhs) -> Self
}

trait Scale {
  fn by_two(self: Self) -> Self
}

impl Add[u32] for u32 {
  fn op(self: u32, rhs: u32) -> u32 {
    $entry:
      out: u32 = add self: u32, rhs: u32
      ret out: u32
  }
}

impl Scale for u32 {
  fn by_two(self: u32) -> u32 {
    $entry:
      two: u32 = capprim 2_u32
      out: u32 = mul self: u32, two: u32
      ret out: u32
  }
}

fn demo(value: u32) -> u32 {
  $entry:
    doubled: u32 = call Scale::by_two(value: u32)
    result: u32 = call Add::op(doubled: u32, value: u32)
    ret result: u32
}
