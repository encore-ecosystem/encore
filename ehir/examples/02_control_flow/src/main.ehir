; Conditional branches, merge blocks, phi and switch.

fn max_u32(lhs: u32, rhs: u32) -> u32 {
  $entry:
    cond: u1 = grt lhs: u32, rhs: u32
    cbr cond: u1, $lhs_block, $rhs_block
  $lhs_block:
    br $merge
  $rhs_block:
    br $merge
  $merge:
    out: u32 = phi lhs: u32 $lhs_block, rhs: u32 $rhs_block
    ret out: u32
}

fn classify_small(value: u32) -> u32 {
  $entry:
    switch value: u32, $many {
      0_u32 => $zero
      1_u32 => $one
      2_u32 => $two
    }
  $zero:
    ret value: u32
  $one:
    ret value: u32
  $two:
    ret value: u32
  $many:
    fallback: u32 = capprim 99_u32
    ret fallback: u32
}
