; Stack allocation, heap allocation, field access, gep and raw pointer casts.

struct Point {
  x: u32
  y: u32
}

#attr(safe)
fn sum_point() -> u32 {
  $entry:
    one: u32 = capprim 1_u32
    two: u32 = capprim 2_u32
    point: Point = capstruct Point(one: u32, two: u32)
    point_slot: Point* = salloc Point
    store point: Point, point_slot: Point*
    x_ptr: u32* = getfieldptr point_slot: Point*, x
    x: u32 = load x_ptr: u32*
    y: u32 = getfield point: Point, y
    sum: u32 = add x: u32, y: u32
    ret sum: u32
}

#attr(safe)
fn heap_buffer_demo() -> u32 {
  $entry:
    zero: usize = capprim 0_usize
    four: usize = capprim 4_usize
    base: u32* = pcast zero: usize, u32*
    heap: u32* = hrealloc base: u32*, four: usize
    index: usize = capprim 2_usize
    elem_ptr: u32* = gep heap: u32*, index: usize
    value: u32 = capprim 33_u32
    store value: u32, elem_ptr: u32*
    loaded: u32 = load elem_ptr: u32*
    hfree heap: u32*
    ret loaded: u32
}
