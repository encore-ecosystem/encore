; Capture forms and Box-based heap wrappers.

imp core::smart_box::Box

struct Point {
  x: u32
  y: u32
}

enum Color {
  Red
  Green
  Blue
}

#attr(safe)
fn demo() -> u32 {
  $entry:
    ten_ptr: u32* = cpos 10_u32
    one: u32 = capprim 1_u32
    two: u32 = capprim 2_u32
    three: u32 = capprim 3_u32
    four: u32 = capprim 4_u32
    boxed_point: Box[Point] = scstruct Point(three: u32, four: u32)
    stack_point: Point = capstruct Point(one: u32, two: u32)
    green: Color = capenum Color::Green()
    x: u32 = getfield stack_point: Point, x
    boxed_point_ptr: Point* = call Box[Point]::as_ptr(boxed_point: Box[Point])
    y_ptr: u32* = getfieldptr boxed_point_ptr: Point*, y
    y: u32 = load y_ptr: u32*
    out: u32 = add x: u32, y: u32
    ret out: u32
}
