; Basic declarations, imports, extern calls and plain function calls.

imp mod::math::add_u32

extern fn puts(text: str) -> u32

struct Pair[T] {
  left: T
  right: T
}

#attr(safe)
fn main() -> u32 {
  $entry:
    lhs: u32 = capprim 20_u32
    rhs: u32 = capprim 22_u32
    pair: Pair[u32] = capstruct Pair[u32](lhs: u32, rhs: u32)
    sum: u32 = call add_u32(lhs: u32, rhs: u32)
    text: str = capprim "hello from ehir"
    _puts_status: u32 = unsafe call puts(text: str)
    ret sum: u32
}
