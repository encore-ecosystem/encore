; Generic metadata embedding example.
; Reflection here is modeled as ordinary EHIR declarations and functions.

enum SymbolKind {
  Function
  Struct
  Enum
  Trait
  Impl
  Variant
}

struct SymbolInfo {
  kind: SymbolKind
  name: str
  qualified_name: str
  is_public: u1
  detail: str
}

struct ModuleInfo {
  path: str
  symbol_count: usize
  symbols: str
}

enum MaybeSymbol {
  Some(SymbolInfo)
  None
}

extern fn __rt_str_eq(lhs: str, rhs: str) -> u1

fn reflect_module() -> ModuleInfo {
  $entry:
    path: str = capprim "src/main.ehir"
    symbols: str = capprim "main, reflect_module, reflect_symbol"
    three: usize = capprim 3_usize
    one: usize = capprim 1_usize
    info: ModuleInfo = capstruct ModuleInfo(path: str, three: usize, symbols: str)
    ret info: ModuleInfo
}

#attr(safe)
fn reflect_symbol(query: str) -> MaybeSymbol {
  $entry:
    main_name: str = capprim "main"
    matched: u1 = unsafe call __rt_str_eq(query: str, main_name: str)
    cbr matched: u1, $found, $miss
  $found:
    kind: SymbolKind = capenum SymbolKind::Function()
    qualified_name: str = capprim "main"
    is_public: u1 = capprim 0_u1
    detail: str = capprim "fn main() -> u32"
    info: SymbolInfo = capstruct SymbolInfo(kind: SymbolKind, main_name: str, qualified_name: str, is_public: u1, detail: str)
    some: MaybeSymbol = capenum MaybeSymbol::Some(info: SymbolInfo)
    ret some: MaybeSymbol
  $miss:
    none: MaybeSymbol = capenum MaybeSymbol::None()
    ret none: MaybeSymbol
}
