enum Expr {
    Path(str)
    Integer(str)
    Boolean(u1)
}

struct Lowered {
    name: str
    typ: str
}

fn lower(expr: Expr, prefix: str) -> Lowered {
  $entry:
    match expr, $fallback {
      Path => $path_arm
      Integer => $integer_arm
      Boolean => $boolean_arm
    }

  $path_arm:
    path_name = getfield expr > Path
    path_typ = capprim "usize"_str
    path_out = capstruct Lowered(path_name, path_typ)
    ret path_out

  $integer_arm:
    int_name = getfield expr > Integer
    int_typ = capprim "usize"_str
    int_out = capstruct Lowered(int_name, int_typ)
    ret int_out

  $boolean_arm:
    bool_value = getfield expr > Boolean
    bool_name = capprim "bool_name"_str
    one = capprim 1_u1
    is_true = ieq bool_value, one
    cbr is_true, $bool_true, $bool_false

  $bool_true:
    true_typ = capprim "bool"_str
    true_out = capstruct Lowered(bool_name, true_typ)
    ret true_out

  $bool_false:
    false_typ = capprim "bool"_str
    false_out = capstruct Lowered(bool_name, false_typ)
    ret false_out

  $fallback:
    fallback_name = capprim "fallback"_str
    fallback_typ = capprim "never"_str
    fallback_out = capstruct Lowered(fallback_name, fallback_typ)
    ret fallback_out
}

fn main() -> usize {
  $entry:
    lit = capprim "name"_str
    expr = capenum Expr::Path(lit)
    out = call lower(expr, lit)
    name_loaded = getfield out > name
    zero = capprim 0_usize
    ret zero
}
