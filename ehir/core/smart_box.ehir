#attr(safe)
pub struct Box[T] {
  ptr: T*
  ref_count: usize
  inner_reach: u1
  outer_reach: u1
  outer_visited: u1
}

impl[T] Box[T] {
  #attr(safe)
  pub fn from_raw(ptr: T*) -> Box[T] {
    $entry:
      ref_count: usize = capprim 1_usize
      inner_reach: u1 = capprim 1_u1
      outer_reach: u1 = capprim 0_u1
      outer_visited: u1 = capprim 0_u1
      box: Box[T] = capstruct Box[T](ptr: T*, ref_count: usize, inner_reach: u1, outer_reach: u1, outer_visited: u1)
      ret box: Box[T]
  }

  #attr(safe)
  pub fn wrap(value: T) -> Box[T] {
    $entry:
      ptr: T* = halloc T
      store value: T, ptr: T*
      box: Box[T] = call Box[T]::from_raw[T](ptr: T*)
      ret box: Box[T]
  }

  pub fn as_ptr(self: Box[T]) -> T* {
    $entry:
      ptr: T* = getfield self: Box[T], ptr
      ret ptr: T*
  }

  #attr(safe)
  pub fn load(self: Box[T]) -> T {
    $entry:
      ptr: T* = call Box[T]::as_ptr[T](self: Box[T])
      value: T = load ptr: T*
      ret value: T
  }

  #attr(safe)
  pub fn store(self: Box[T], value: T) -> () {
    $entry:
      ptr: T* = call Box[T]::as_ptr[T](self: Box[T])
      store value: T, ptr: T*
      ret done: ()
  }
}
