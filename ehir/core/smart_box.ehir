imp core::owner::OwnerHeader

#attr(safe)
pub struct Box[T] {
  ptr: T*
  owner: OwnerHeader*
}

impl[T] Box[T] {
  #attr(safe)
  pub fn from_raw(ptr: T*) -> Box[T] {
    $entry:
      owner_ptr = halloc OwnerHeader
      heap_kind = capprim 0_u8
      ref_count = capprim 1_usize
      owner     = capstruct OwnerHeader(heap_kind, ref_count)
      store owner, owner_ptr
      box = capstruct Box[T](ptr, owner_ptr)
      ret box
  }

  ;#attr(safe)
  ;pub fn from_stack_raw(ptr: T*) -> Box[T] {
  ;  $entry:
  ;    owner_ptr: OwnerHeader* = halloc OwnerHeader
  ;    frame_kind: u8 = capprim 1_u8
  ;    ref_count: usize = capprim 1_usize
  ;    owner: OwnerHeader = capstruct OwnerHeader(frame_kind: u8, ref_count: usize)
  ;    store owner: OwnerHeader, owner_ptr: OwnerHeader*
  ;    box: Box[T] = capstruct Box[T](ptr: T*, owner_ptr: OwnerHeader*)
  ;    ret box: Box[T]
  ;}

  #attr(safe)
  pub fn wrap(value: T) -> Box[T] {
    $entry:
      ptr = halloc T
      store value, ptr
      box = call Box[T]::from_raw(ptr)
      ret box
  }

  pub fn as_ptr(self: Box[T]) -> T* {
    $entry:
      ptr = getfield self > ptr
      ret ptr
  }

  ;pub fn owner_ptr(self: Box[T]) -> OwnerHeader* {
  ;  $entry:
  ;    owner_ptr: OwnerHeader* = getfield self: Box[T] > owner
  ;    ret owner_ptr: OwnerHeader*
  ;}

  #attr(safe)
  pub fn load(self: Box[T]) -> T {
    $entry:
      ptr: T* = call Box[T]::as_ptr[T](self: Box[T])
      value: T = load ptr: T*
      ret value: T
  }

  #attr(safe)
  pub fn store(self: Box[T], value: T) -> () {
    $entry:
      ptr: T* = call Box[T]::as_ptr[T](self: Box[T])
      store value: T, ptr: T*
      ret done: ()
  }
}
