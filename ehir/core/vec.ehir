imp core::smart_box::Box

#attr(safe)
pub struct Vec[T] {
  data: Box[T]
  len: usize
  cap: usize
}

impl[T] Vec[T] {
  pub fn new() -> Vec[T] {
    $entry:
      one: usize = capprim 1_usize
      vec: Vec[T] = call Vec[T]::with_capacity[T](one: usize)
      ret vec: Vec[T]
  }

  #attr(safe)
  pub fn with_capacity(cap: usize) -> Vec[T] {
    $entry:
      ptr: T* = halloc T
      data_ptr: T* = hrealloc ptr: T*, cap: usize
      data: Box[T] = call Box[T]::from_raw[T](data_ptr: T*)
      zero: usize = capprim 0_usize
      vec: Vec[T] = capstruct Vec[T](data: Box[T], zero: usize, cap: usize)
      ret vec: Vec[T]
  }

  pub fn len(self: Vec[T]) -> usize {
    $entry:
      len: usize = getfield self: Vec[T], len
      ret len: usize
  }

  pub fn capacity(self: Vec[T]) -> usize {
    $entry:
      cap: usize = getfield self: Vec[T], cap
      ret cap: usize
  }

  pub fn as_ptr(self: Vec[T]) -> T* {
    $entry:
      data: Box[T] = getfield self: Vec[T], data
      ptr: T* = call Box[T]::as_ptr[T](data: Box[T])
      ret ptr: T*
  }

  #attr(safe)
  pub fn get_ptr(self: Vec[T]*, index: usize) -> T* {
    $entry:
      data_ptr: Box[T]* = getfieldptr self: Vec[T]*, data
      data: Box[T] = load data_ptr: Box[T]*
      ptr: T* = call Box[T]::as_ptr[T](data: Box[T])
      elem_ptr: T* = gep ptr: T*, index: usize
      ret elem_ptr: T*
  }

  #attr(safe)
  pub fn push(self: Vec[T]*, value: T) -> () {
    $entry:
      len_ptr: usize* = getfieldptr self: Vec[T]*, len
      cap_ptr: usize* = getfieldptr self: Vec[T]*, cap
      data_ptr: Box[T]* = getfieldptr self: Vec[T]*, data
      len: usize = load len_ptr: usize*
      cap: usize = load cap_ptr: usize*
      one: usize = capprim 1_usize
      has_cap: u1 = les len: usize, cap: usize
      cbr has_cap: u1, $write, $grow
    $grow:
      doubled: usize = add cap: usize, cap: usize
      grow_cap: usize = add doubled: usize, one: usize
      data: Box[T] = load data_ptr: Box[T]*
      old_ptr: T* = call Box[T]::as_ptr[T](data: Box[T])
      new_ptr: T* = hrealloc old_ptr: T*, grow_cap: usize
      new_data: Box[T] = call Box[T]::from_raw[T](new_ptr: T*)
      store new_data: Box[T], data_ptr: Box[T]*
      store grow_cap: usize, cap_ptr: usize*
      br $write
    $write:
      current_data: Box[T] = load data_ptr: Box[T]*
      base_ptr: T* = call Box[T]::as_ptr[T](current_data: Box[T])
      elem_ptr: T* = gep base_ptr: T*, len: usize
      store value: T, elem_ptr: T*
      next_len: usize = add len: usize, one: usize
      store next_len: usize, len_ptr: usize*
      ret done: ()
  }
}
