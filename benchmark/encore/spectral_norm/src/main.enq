import std::{
    fmt::Debug,
    io::println,
    option::Option,
    vec::Vec,
}

fn value_at(values: Vec[f64], index: usize) -> f64 {
    ret match values.get(index) {
        Option[f64]::Some(value) => value
        Option[f64]::None => 0_f64
    }
}

fn matrix_value(i: usize, j: usize) -> f64 {
    let sum = i + j
    let denominator = (sum * (sum + 1_usize) / 2_usize + i + 1_usize) as f64
    ret 1_f64 / denominator
}

fn multiply_av(values: Vec[f64], size: usize) -> Vec[f64] {
    let mut out = Vec[f64]::with_capacity(size)
    let mut i = 0_usize
    while i < size {
        let mut sum = 0_f64
        let mut j = 0_usize
        while j < size {
            sum += matrix_value(i, j) * value_at(values, j)
            j += 1_usize
        }
        out.push(sum)
        i += 1_usize
    }
    ret out
}

fn multiply_atv(values: Vec[f64], size: usize) -> Vec[f64] {
    let mut out = Vec[f64]::with_capacity(size)
    let mut i = 0_usize
    while i < size {
        let mut sum = 0_f64
        let mut j = 0_usize
        while j < size {
            sum += matrix_value(j, i) * value_at(values, j)
            j += 1_usize
        }
        out.push(sum)
        i += 1_usize
    }
    ret out
}

fn multiply_ata(values: Vec[f64], size: usize) -> Vec[f64] {
    ret multiply_atv(multiply_av(values, size), size)
}

fn main() -> u32 {
    let size = 900_usize
    let mut u = Vec[f64]::with_capacity(size)
    let mut v = Vec[f64]::with_capacity(size)
    let mut index = 0_usize
    while index < size {
        u.push(1_f64)
        v.push(1_f64)
        index += 1_usize
    }

    let mut iteration = 0_usize
    while iteration < 10_usize {
        v = multiply_ata(u, size)
        u = multiply_ata(v, size)
        iteration += 1_usize
    }

    let mut vbv = 0_f64
    let mut vv = 0_f64
    index = 0_usize
    while index < size {
        let left = value_at(u, index)
        let right = value_at(v, index)
        vbv += left * right
        vv += right * right
        index += 1_usize
    }
    let checksum = (vbv * 1000000_f64 / vv) as u64
    println(Debug::fmt(checksum))
    ret 0_u32
}
