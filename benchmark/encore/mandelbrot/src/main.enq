import std::{fmt::Debug, io::println}

fn escape_iterations(cx: f64, cy: f64) -> u32 {
    let mut zx = 0_f64
    let mut zy = 0_f64
    let mut iteration = 0_u32
    while iteration < 120_u32 && zx * zx + zy * zy <= 4_f64 {
        let next_x = zx * zx - zy * zy + cx
        zy = 2_f64 * zx * zy + cy
        zx = next_x
        iteration += 1_u32
    }
    ret iteration
}

fn main() -> u32 {
    let width = 2000_u32
    let height = 1400_u32
    let mut checksum = 0_u64
    let mut y = 0_u32
    while y < height {
        let cy = (y as f64) * 2.4_f64 / (height as f64) - 1.2_f64
        let mut x = 0_u32
        while x < width {
            let cx = (x as f64) * 3.5_f64 / (width as f64) - 2.5_f64
            checksum += escape_iterations(cx, cy) as u64
            x += 1_u32
        }
        y += 1_u32
    }
    println(Debug::fmt(checksum))
    ret 0_u32
}
