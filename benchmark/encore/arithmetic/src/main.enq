import std::{
    fmt::Debug,
    io::println,
}

fn main() -> u32 {
    let mut value = 11400714819323198485_u64
    let mut checksum = 0_u64
    let mut index = 0_u64

    while index < 100000000_u64 {
        value ^= value << 13_u64
        value ^= value >> 7_u64
        value ^= value << 17_u64
        value += index * 2654435769_u64
        checksum += value ^ index
        index += 1_u64
    }

    println(Debug::fmt(checksum))
    ret 0_u32
}
