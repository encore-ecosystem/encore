import std::{
    fmt::Debug,
    io::println,
    option::Option,
    vec::Vec,
}

fn main() -> u32 {
    let length = 5000000_usize
    let mut values = Vec[u64]::with_capacity(length)
    let mut index = 0_usize
    while index < length {
        values.push((index as u64) * 2654435761_u64 ^ 2779096485_u64)
        index += 1_usize
    }

    let mut checksum = 0_u64
    let mut round = 0_u64
    while round < 8_u64 {
        index = 0_usize
        while index < length {
            match values.get(index) {
                Option[u64]::Some(value) => {
                    let next = value * 1664525_u64 + 1013904223_u64 + round
                    values.set(index, next)
                    checksum += next
                }
                Option[u64]::None => {}
            }
            index += 1_usize
        }
        round += 1_u64
    }

    println(Debug::fmt(checksum))
    values.free()
    ret 0_u32
}
