import std::{fmt::Debug, io::println, vec::Vec}

struct Node {
    value: i64
    children: Vec[Node]
}

fn make_tree(depth: u32, value: i64) -> Node {
    let mut children = Vec[Node]::with_capacity(2_usize)
    if depth > 0_u32 {
        children.push(make_tree(depth - 1_u32, value * 2_i64 - 1_i64))
        children.push(make_tree(depth - 1_u32, value * 2_i64))
    }
    ret Node{value, children}
}

fn check_tree(node: Node) -> i64 {
    let mut checksum = node.value
    for child in node.children {
        checksum += check_tree(child)
    }
    ret checksum
}

fn main() -> u32 {
    let maximum_depth = 15_u32
    let stretch = make_tree(maximum_depth + 1_u32, 0_i64)
    let mut checksum = check_tree(stretch)
    let long_lived = make_tree(maximum_depth, 0_i64)

    let mut depth = 4_u32
    while depth <= maximum_depth {
        let iterations = 1_usize << ((maximum_depth - depth + 2_u32) as usize)
        let mut index = 0_usize
        while index < iterations {
            checksum += check_tree(make_tree(depth, index as i64))
            checksum += check_tree(make_tree(depth, 0_i64 - (index as i64)))
            index += 1_usize
        }
        depth += 2_u32
    }
    checksum += check_tree(long_lived)
    println(Debug::fmt(checksum))
    ret 0_u32
}
