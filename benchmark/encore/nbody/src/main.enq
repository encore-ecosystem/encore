import std::{fmt::Debug, io::println}

struct Body {
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64
}

fn interact(left: mut Body, right: mut Body, dt: f64) -> () {
    let dx = right.x - left.x
    let dy = right.y - left.y
    let dz = right.z - left.z
    let scale = dt / (dx * dx + dy * dy + dz * dz + 1_f64)
    let left_scale = right.mass * scale
    let right_scale = left.mass * scale
    left.vx += dx * left_scale
    left.vy += dy * left_scale
    left.vz += dz * left_scale
    right.vx -= dx * right_scale
    right.vy -= dy * right_scale
    right.vz -= dz * right_scale
    ret ()
}

fn advance(body: mut Body, dt: f64) -> () {
    body.x += dt * body.vx
    body.y += dt * body.vy
    body.z += dt * body.vz
    ret ()
}

fn abs(value: f64) -> f64 {
    if value < 0_f64 { ret 0_f64 - value }
    ret value
}

fn main() -> u32 {
    let mut a = Body{0.0_f64, 0.0_f64, 0.0_f64, 0.001_f64, -0.002_f64, 0.003_f64, 3.0_f64}
    let mut b = Body{1.0_f64, 0.2_f64, -0.1_f64, -0.003_f64, 0.001_f64, 0.002_f64, 1.7_f64}
    let mut c = Body{-0.4_f64, 1.1_f64, 0.3_f64, 0.002_f64, 0.003_f64, -0.001_f64, 2.1_f64}
    let mut d = Body{0.3_f64, -0.8_f64, 1.2_f64, -0.001_f64, -0.002_f64, 0.002_f64, 0.9_f64}
    let mut e = Body{-1.0_f64, -0.5_f64, -0.7_f64, 0.003_f64, -0.001_f64, -0.002_f64, 1.3_f64}
    let dt = 0.00001_f64
    let mut step = 0_u32
    while step < 6000000_u32 {
        interact(a, b, dt)
        interact(a, c, dt)
        interact(a, d, dt)
        interact(a, e, dt)
        interact(b, c, dt)
        interact(b, d, dt)
        interact(b, e, dt)
        interact(c, d, dt)
        interact(c, e, dt)
        interact(d, e, dt)
        advance(a, dt)
        advance(b, dt)
        advance(c, dt)
        advance(d, dt)
        advance(e, dt)
        step += 1_u32
    }
    let total = abs(a.x) + abs(a.y) + abs(a.z) + abs(b.x) + abs(b.y) + abs(b.z) +
        abs(c.x) + abs(c.y) + abs(c.z) + abs(d.x) + abs(d.y) + abs(d.z) +
        abs(e.x) + abs(e.y) + abs(e.z)
    println(Debug::fmt((total * 1000000000_f64) as u64))
    ret 0_u32
}
