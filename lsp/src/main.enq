fn response(id: str, result: str) -> str {
    ret "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}"
}

fn error_response(id: str, code: i32, message: str) -> str {
    ret "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + Debug::fmt(code) + ",\"message\":" + json_text(message) + "}}"
}

fn notification(method: str, params: str) -> str {
    ret "{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"params\":" + params + "}"
}

fn initialize_result() -> str {
    ret "{\"serverInfo\":{\"name\":\"encore-lsp\",\"version\":\"0.1.0\"},\"capabilities\":{\"textDocumentSync\":1,\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":true},\"codeActionProvider\":true,\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true,\"documentSymbolProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"foldingRangeProvider\":true,\"selectionRangeProvider\":true,\"workspaceSymbolProvider\":true,\"renameProvider\":{\"prepareProvider\":true},\"documentLinkProvider\":{\"resolveProvider\":false},\"callHierarchyProvider\":true,\"inlayHintProvider\":{\"resolveProvider\":false},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"completionProvider\":{\"triggerCharacters\":[\":\",\".\",\"_\"]},\"hoverProvider\":true,\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"keyword\",\"function\",\"type\",\"struct\",\"enum\",\"interface\",\"variable\",\"number\",\"string\",\"operator\",\"comment\"],\"tokenModifiers\":[\"declaration\",\"definition\"]},\"full\":true}}}"
}

fn completion_result(analysis: FrontendDocument, request: Json) -> str {
    let edit_range = completion_edit_range_json(analysis, request)
    let mut out = "{\"isIncomplete\":false,\"items\":["
    out += completion_item_json("fn", 14_usize, "fn name() -> u32 {\n    ret 0_u32\n}", "", edit_range)
    out += "," + completion_item_json("struct", 14_usize, "struct Name {\n    value: u32\n}", "", edit_range)
    out += "," + completion_item_json("enum", 14_usize, "enum Name {\n    Variant\n}", "", edit_range)
    out += "," + completion_item_json("trait", 14_usize, "trait Name {\n    fn method(self: Self) -> u32\n}", "", edit_range)
    out += "," + completion_item_json("impl", 14_usize, "impl for Name {\n}\n", "", edit_range)
    out += "," + completion_item_json("match", 14_usize, "match value {\n    _ => {}\n}", "", edit_range)
    out += "," + completion_item_json("for", 14_usize, "for item in items {\n}", "", edit_range)
    out += "," + completion_item_json("while", 14_usize, "while condition {\n}", "", edit_range)
    out += "," + completion_item_json("ret", 14_usize, "ret", "", edit_range)
    out += "," + completion_item_json("let", 14_usize, "let", "", edit_range)
    out += "," + completion_item_json("pub", 14_usize, "pub", "", edit_range)
    out += "," + completion_item_json("import", 14_usize, "import", "", edit_range)
    for symbol in analysis.symbols {
        out += "," + completion_item_json(symbol.name, completion_kind_for_symbol(symbol.kind), symbol.name, "", edit_range)
    }
    out += "]}"
    ret out
}

fn completion_result_workspace(workspace: Workspace, doc: Document, request: Json) -> str {
    match import_completion_json(workspace, doc, request) {
        Option[str]::Some(result) => {
            ret result
        }
        Option[str]::None => {}
    }

    let edit_range = completion_edit_range_json(doc.analysis, request)
    let mut out = "{\"isIncomplete\":false,\"items\":["
    out += completion_item_json("fn", 14_usize, "fn name() -> u32 {\n    ret 0_u32\n}", "", edit_range)
    out += "," + completion_item_json("struct", 14_usize, "struct Name {\n    value: u32\n}", "", edit_range)
    out += "," + completion_item_json("enum", 14_usize, "enum Name {\n    Variant\n}", "", edit_range)
    out += "," + completion_item_json("trait", 14_usize, "trait Name {\n    fn method(self: Self) -> u32\n}", "", edit_range)
    out += "," + completion_item_json("impl", 14_usize, "impl for Name {\n}\n", "", edit_range)
    out += "," + completion_item_json("match", 14_usize, "match value {\n    _ => {}\n}", "", edit_range)
    out += "," + completion_item_json("for", 14_usize, "for item in items {\n}", "", edit_range)
    out += "," + completion_item_json("while", 14_usize, "while condition {\n}", "", edit_range)
    out += "," + completion_item_json("ret", 14_usize, "ret", "", edit_range)
    out += "," + completion_item_json("let", 14_usize, "let", "", edit_range)
    out += "," + completion_item_json("pub", 14_usize, "pub", "", edit_range)
    out += "," + completion_item_json("import", 14_usize, "import", "", edit_range)

    let mut emitted = Vec[str]::new()
    for doc in workspace.documents {
        for symbol in doc.analysis.symbols {
            if symbol.name.len() > 0_usize {
                if !contains_name(emitted, symbol.name) {
                    out += "," + completion_item_json(symbol.name, completion_kind_for_symbol(symbol.kind), symbol.name, doc.uri, edit_range)
                    emitted.push(symbol.name)
                }
            }
        }
    }
    out += "]}"
    ret out
}

fn import_completion_json(workspace: Workspace, doc: Document, request: Json) -> Option[str] {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    match import_prefix_before_cursor(doc.analysis, line, character) {
                        Option[str]::Some(prefix) => {
                            if contains_text(prefix, "::") {
                                ret Option[str]::Some(import_member_completion_json(workspace, doc, prefix, request))
                            }
                            ret Option[str]::Some(import_root_completion_json(doc, request))
                        }
                        Option[str]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret Option[str]::None
}

fn import_root_completion_json(doc: Document, request: Json) -> str {
    let edit_range = completion_edit_range_json(doc.analysis, request)
    let mut out = "{\"isIncomplete\":false,\"items\":["
    let mut first = true
    let mut emitted = Vec[str]::new()

    let pair = append_import_root_item(out, first, emitted, "refrain", "current refrain source root", edit_range)
    out = pair.0
    first = pair.1
    emitted = pair.2

    let pair_mod = append_import_root_item(out, first, emitted, "mod", "current module directory", edit_range)
    out = pair_mod.0
    first = pair_mod.1
    emitted = pair_mod.2

    let current_path = uri_to_path(doc.uri)
    let project_root = project_root_for_path(current_path)
    let pair_lock = append_lock_root_items(out, first, emitted, project_root, edit_range)
    out = pair_lock.0
    first = pair_lock.1
    emitted = pair_lock.2

    let root_path = cwd()
    let pair_packages = append_package_root_items(out, first, emitted, root_path, edit_range)
    out = pair_packages.0
    first = pair_packages.1
    emitted = pair_packages.2

    let index_path = join_path(root_path, "index")
    let pair_index = append_package_root_items(out, first, emitted, index_path, edit_range)
    out = pair_index.0
    first = pair_index.1
    emitted = pair_index.2

    out += "]}"
    ret out
}

fn append_lock_root_items(out: str, first: bool, emitted: Vec[str], project_root: str, edit_range: str) -> (str, bool, Vec[str]) {
    let mut result = out
    let mut is_first = first
    let mut next_emitted = emitted
    let lock_path = join_path(project_root, "encore.lock")
    if !file_exists(lock_path) {
        ret (result, is_first, next_emitted)
    }

    let mut current_name = ""
    let mut current_ref = ""
    for raw_line in split_lines_lsp(read_file(lock_path)) {
        let line = trim_ascii(raw_line)
        if line == "[[packages]]" {
            let pair = append_lock_root_item(result, is_first, next_emitted, current_name, current_ref, edit_range)
            result = pair.0
            is_first = pair.1
            next_emitted = pair.2
            current_name = ""
            current_ref = ""
            continue
        }
        match toml_string_value(line, "name") {
            Option[str]::Some(value) => {
                current_name = value
                continue
            }
            Option[str]::None => {}
        }
        match toml_string_value(line, "ref") {
            Option[str]::Some(value) => {
                current_ref = value
                continue
            }
            Option[str]::None => {}
        }
    }
    ret append_lock_root_item(result, is_first, next_emitted, current_name, current_ref, edit_range)
}

fn append_lock_root_item(out: str, first: bool, emitted: Vec[str], name: str, ref: str, edit_range: str) -> (str, bool, Vec[str]) {
    if name.len() == 0_usize {
        ret (out, first, emitted)
    }
    let detail = if ref.len() > 0_usize { ref } else { "dependency" }
    ret append_import_root_item(out, first, emitted, name, detail, edit_range)
}

fn append_package_root_items(out: str, first: bool, emitted: Vec[str], dir: str, edit_range: str) -> (str, bool, Vec[str]) {
    let mut result = out
    let mut is_first = first
    let mut next_emitted = emitted
    if !file_exists(dir) {
        ret (result, is_first, next_emitted)
    }
    for entry in read_dir(dir) {
        let package_dir = join_path(dir, entry)
        if file_exists(join_path(package_dir, "encore.toml")) {
            if file_exists(join_path(package_dir, "src")) {
                let pair = append_import_root_item(result, is_first, next_emitted, entry, package_dir, edit_range)
                result = pair.0
                is_first = pair.1
                next_emitted = pair.2
            }
        }
    }
    ret (result, is_first, next_emitted)
}

fn append_import_root_item(out: str, first: bool, emitted: Vec[str], label: str, detail: str, edit_range: str) -> (str, bool, Vec[str]) {
    let mut result = out
    let mut is_first = first
    let mut next_emitted = emitted
    if contains_name(next_emitted, label) {
        ret (result, is_first, next_emitted)
    }
    if !is_first {
        result += ","
    }
    result += completion_item_json(label, 9_usize, label, detail, edit_range)
    is_first = false
    next_emitted.push(label)
    ret (result, is_first, next_emitted)
}

fn import_member_completion_json(workspace: Workspace, doc: Document, prefix: str, request: Json) -> str {
    let edit_range = completion_edit_range_json(doc.analysis, request)
    let root = import_root(prefix)
    let tail = import_tail(prefix)
    let parent = import_parent_path(tail)
    let item_prefix = import_item_prefix(tail)
    let mut out = "{\"isIncomplete\":false,\"items\":["
    let mut first = true
    let mut emitted = Vec[str]::new()

    match import_base_dir(doc, root) {
        Option[str]::Some(base_dir) => {
            let parent_dir = import_parent_dir(base_dir, parent)
            let module_pair = append_import_module_items(out, first, emitted, parent_dir, edit_range)
            out = module_pair.0
            first = module_pair.1
            emitted = module_pair.2

            match import_module_file(base_dir, parent) {
                Option[str]::Some(module_path) => {
                    if file_exists(module_path) {
                        let text = read_file(module_path)
                        if text.len() <= max_sync_index_bytes() {
                            let analysis = analyze_source_lightweight(text)
                            let symbol_pair = append_import_symbol_items(out, first, emitted, analysis, module_path, edit_range)
                            out = symbol_pair.0
                            first = symbol_pair.1
                            emitted = symbol_pair.2
                        }
                    }
                }
                Option[str]::None => {}
            }
        }
        Option[str]::None => {}
    }

    out += "]}"
    ret out
}

fn append_import_module_items(out: str, first: bool, emitted: Vec[str], dir: str, edit_range: str) -> (str, bool, Vec[str]) {
    let mut result = out
    let mut is_first = first
    let mut next_emitted = emitted
    if !file_exists(dir) {
        ret (result, is_first, next_emitted)
    }

    for entry in read_dir(dir) {
        if entry == "mod.enq" || entry == "lib.enq" {
            continue
        }
        let mut label = ""
        if ends_with(entry, ".enq") {
            label = entry.slice(0_usize, entry.char_len() - ".enq".len())
        }
        else {
            let child_dir = join_path(dir, entry)
            if file_exists(join_path(child_dir, "mod.enq")) {
                label = entry
            }
            if file_exists(join_path(child_dir, "lib.enq")) {
                label = entry
            }
        }

        if label.len() > 0_usize {
            if !contains_name(next_emitted, label) {
                if !is_first {
                    result += ","
                }
                result += completion_item_json(label, 9_usize, label, "module", edit_range)
                next_emitted.push(label)
                is_first = false
            }
        }
    }
    ret (result, is_first, next_emitted)
}

fn append_import_symbol_items(out: str, first: bool, emitted: Vec[str], analysis: FrontendDocument, module_path: str, edit_range: str) -> (str, bool, Vec[str]) {
    let mut result = out
    let mut is_first = first
    let mut next_emitted = emitted
    for symbol in analysis.symbols {
        if symbol.name.len() > 0_usize {
            if !contains_name(next_emitted, symbol.name) {
                if !is_first {
                    result += ","
                }
                result += completion_item_json(symbol.name, completion_kind_for_symbol(symbol.kind), symbol.name, module_path, edit_range)
                next_emitted.push(symbol.name)
                is_first = false
            }
        }
    }
    ret (result, is_first, next_emitted)
}

fn import_base_dir(doc: Document, root: str) -> Option[str] {
    let current_path = uri_to_path(doc.uri)
    let project_root = project_root_for_path(current_path)
    if root == "mod" {
        ret Option[str]::Some(dirname(current_path))
    }
    if root == "refrain" {
        ret Option[str]::Some(source_root_for_path(current_path))
    }

    match lock_dependency_src_dir(project_root, root) {
        Option[str]::Some(src_dir) => {
            ret Option[str]::Some(src_dir)
        }
        Option[str]::None => {}
    }

    match local_dependency_src_dir(project_root, root) {
        Option[str]::Some(src_dir) => {
            ret Option[str]::Some(src_dir)
        }
        Option[str]::None => {}
    }

    let worktree = cwd()
    let direct = join_path(join_path(worktree, root), "src")
    if file_exists(direct) {
        ret Option[str]::Some(direct)
    }
    let indexed = join_path(join_path(join_path(worktree, "index"), root), "src")
    if file_exists(indexed) {
        ret Option[str]::Some(indexed)
    }
    let local_refrain = join_path(join_path(dirname(source_root_for_path(current_path)), "refrains"), root)
    let local_src = join_path(local_refrain, "src")
    if file_exists(local_src) {
        ret Option[str]::Some(local_src)
    }
    ret Option[str]::None
}

fn lock_dependency_src_dir(project_root: str, root: str) -> Option[str] {
    let lock_path = join_path(project_root, "encore.lock")
    if !file_exists(lock_path) {
        ret Option[str]::None
    }
    let lock_text = read_file(lock_path)
    let mut current_name = ""
    let mut current_ref = ""

    for raw_line in split_lines_lsp(lock_text) {
        let line = trim_ascii(raw_line)
        if line == "[[packages]]" {
            match dependency_ref_src_dir(project_root, current_name, current_ref, root) {
                Option[str]::Some(src_dir) => {
                    ret Option[str]::Some(src_dir)
                }
                Option[str]::None => {}
            }
            current_name = ""
            current_ref = ""
            continue
        }
        match toml_string_value(line, "name") {
            Option[str]::Some(value) => {
                current_name = value
                continue
            }
            Option[str]::None => {}
        }
        match toml_string_value(line, "ref") {
            Option[str]::Some(value) => {
                current_ref = value
                continue
            }
            Option[str]::None => {}
        }
    }

    ret dependency_ref_src_dir(project_root, current_name, current_ref, root)
}

fn dependency_ref_src_dir(project_root: str, package_name: str, package_ref: str, wanted: str) -> Option[str] {
    if package_name != wanted {
        ret Option[str]::None
    }
    if package_ref == "sys@core" {
        ret system_core_src_dir(project_root)
    }
    if starts_at(package_ref, "path@", 0_usize) {
        let path = join_path(project_root, package_ref.slice("path@".len(), package_ref.len() - "path@".len()))
        let src = join_path(path, "src")
        if file_exists(src) {
            ret Option[str]::Some(src)
        }
        ret Option[str]::None
    }
    if starts_at(package_ref, "git@", 0_usize) {
        ret git_dependency_src_dir(package_ref)
    }
    ret Option[str]::None
}

fn local_dependency_src_dir(project_root: str, root: str) -> Option[str] {
    match existing_src_dir(join_path(join_path(project_root, "refrains"), root)) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    match existing_src_dir(join_path(project_root, root)) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    let parent = dirname(project_root)
    match existing_src_dir(join_path(join_path(parent, "index"), root)) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    match existing_src_dir(join_path(parent, root)) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    ret Option[str]::None
}

fn system_core_src_dir(project_root: str) -> Option[str] {
    match existing_src_dir(join_path(project_root, "core")) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    match existing_src_dir(join_path(join_path(project_root, "refrains"), "core")) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    let parent = dirname(project_root)
    match existing_src_dir(join_path(parent, "core")) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    match existing_src_dir(join_path(join_path(parent, "refrains"), "core")) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    match existing_src_dir(join_path(join_path(parent, "encore"), "core")) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    match existing_src_dir(join_path(join_path(join_path(parent, "encore"), "refrains"), "core")) {
        Option[str]::Some(src_dir) => { ret Option[str]::Some(src_dir) }
        Option[str]::None => {}
    }
    ret Option[str]::None
}

fn git_dependency_src_dir(package_ref: str) -> Option[str] {
    let repo_url = package_ref.slice("git@".len(), package_ref.len() - "git@".len())
    let repo_name_raw = basename(repo_url)
    let repo_name = strip_suffix(repo_name_raw, ".git")
    let org_name = basename(dirname(repo_url))
    let cache_root = join_path(join_path(join_path(home_dir(), ".cache"), "encore"), "git")
    ret existing_src_dir(join_path(join_path(cache_root, org_name), repo_name))
}

fn existing_src_dir(project_dir: str) -> Option[str] {
    let src = join_path(project_dir, "src")
    if file_exists(src) {
        ret Option[str]::Some(src)
    }
    ret Option[str]::None
}

fn basename(path: str) -> str {
    let parent = dirname(path)
    if parent == "." {
        ret path
    }
    if parent == "/" {
        ret path.slice(1_usize, path.len() - 1_usize)
    }
    ret path.slice(parent.len() + 1_usize, path.len() - parent.len() - 1_usize)
}

fn strip_suffix(value: str, suffix: str) -> str {
    if ends_with(value, suffix) {
        ret value.slice(0_usize, value.len() - suffix.len())
    }
    ret value
}

fn import_parent_dir(base_dir: str, parent: str) -> str {
    if parent.len() == 0_usize {
        ret base_dir
    }
    ret join_path(base_dir, scope_to_path(parent))
}

fn import_module_file(base_dir: str, parent: str) -> Option[str] {
    if parent.len() == 0_usize {
        let lib_path = join_path(base_dir, "lib.enq")
        if file_exists(lib_path) {
            ret Option[str]::Some(lib_path)
        }
        let mod_path = join_path(base_dir, "mod.enq")
        if file_exists(mod_path) {
            ret Option[str]::Some(mod_path)
        }
        ret Option[str]::None
    }

    let module_path = scope_to_path(parent)
    let file_path = join_path(base_dir, module_path + ".enq")
    if file_exists(file_path) {
        ret Option[str]::Some(file_path)
    }
    let mod_file = join_path(join_path(base_dir, module_path), "mod.enq")
    if file_exists(mod_file) {
        ret Option[str]::Some(mod_file)
    }
    let lib_file = join_path(join_path(base_dir, module_path), "lib.enq")
    if file_exists(lib_file) {
        ret Option[str]::Some(lib_file)
    }
    ret Option[str]::None
}

fn import_prefix_before_cursor(analysis: FrontendDocument, line: usize, character: usize) -> Option[str] {
    let mut seen_import = false
    let mut out = ""
    for token in analysis.tokens {
        if token.line != line {
            continue
        }
        if token.column > character {
            break
        }
        if token.type == TokenType::KW_IMPORT {
            if token.column < character {
                seen_import = true
                out = ""
            }
            continue
        }
        if seen_import {
            if token.column >= character {
                break
            }
            if token.type == TokenType::IDENTIFIER || token.type == TokenType::SCOPE {
                if character < token.column + token.value.char_len() {
                    out += token.value.slice(0_usize, character - token.column)
                }
                else {
                    out += token.value
                }
            }
            elif token.type == TokenType::LEFT_BRACE || token.type == TokenType::RIGHT_BRACE || token.type == TokenType::COMMA {
                out += token.value
            }
            else {
                break
            }
        }
    }
    if seen_import {
        ret Option[str]::Some(out)
    }
    ret Option[str]::None
}

fn import_root(prefix: str) -> str {
    match find_substring(prefix, "::") {
        Option[usize]::Some(index) => {
            ret prefix.slice(0_usize, index)
        }
        Option[usize]::None => {
            ret prefix
        }
    }
}

fn import_tail(prefix: str) -> str {
    match find_substring(prefix, "::") {
        Option[usize]::Some(index) => {
            ret prefix.slice(index + 2_usize, prefix.char_len() - index - 2_usize)
        }
        Option[usize]::None => {
            ret ""
        }
    }
}

fn import_parent_path(tail: str) -> str {
    match find_last_substring(tail, "::") {
        Option[usize]::Some(index) => {
            ret tail.slice(0_usize, index)
        }
        Option[usize]::None => {
            ret ""
        }
    }
}

fn import_item_prefix(tail: str) -> str {
    match find_last_substring(tail, "::") {
        Option[usize]::Some(index) => {
            ret tail.slice(index + 2_usize, tail.char_len() - index - 2_usize)
        }
        Option[usize]::None => {
            ret tail
        }
    }
}

fn find_last_substring(value: str, needle: str) -> Option[usize] {
    if needle.len() == 0_usize {
        ret Option[usize]::None
    }
    if needle.len() > value.len() {
        ret Option[usize]::None
    }
    let mut found = Option[usize]::None
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if starts_at(value, needle, index) {
            found = Option[usize]::Some(index)
        }
        index += 1_usize
    }
    ret found
}

fn completion_item_json(label: str, kind: usize, new_text: str, detail: str, edit_range: str) -> str {
    let mut out = "{\"label\":" + json_text(label) + ",\"kind\":" + Debug::fmt(kind)
    if detail.len() > 0_usize {
        out += ",\"detail\":" + json_text(detail)
    }
    out += ",\"textEdit\":{\"range\":" + edit_range + ",\"newText\":" + json_text(new_text) + "}}"
    ret out
}

fn completion_edit_range_json(analysis: FrontendDocument, request: Json) -> str {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    let start = completion_prefix_start(analysis, line, character)
                    ret range_json(line, start, line, character)
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret range_json(0_usize, 0_usize, 0_usize, 0_usize)
}

fn completion_prefix_start(analysis: FrontendDocument, line: usize, character: usize) -> usize {
    for token in analysis.tokens {
        if token.line == line {
            if token.type == TokenType::IDENTIFIER {
                if character >= token.column {
                    if character <= token.column + token.value.char_len() {
                        ret token.column
                    }
                }
            }
        }
    }
    ret character
}

fn contains_name(values: Vec[str], name: str) -> bool {
    for value in values {
        if value == name {
            ret true
        }
    }
    ret false
}

fn completion_kind_for_symbol(symbol_kind: usize) -> usize {
    if symbol_kind == 12_usize {
        ret 3_usize
    }
    if symbol_kind == 23_usize {
        ret 7_usize
    }
    if symbol_kind == 10_usize {
        ret 13_usize
    }
    if symbol_kind == 11_usize {
        ret 8_usize
    }
    ret 6_usize
}

fn signature_help_json(doc: Document, request: Json) -> str {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    match find_active_call(doc.analysis, line, character) {
                        Option[ActiveCall]::Some(call) => {
                            match find_callable(doc.analysis, call.name) {
                                Option[FrontendCallable]::Some(callable) => {
                                    ret signature_help_for(callable, call.active_parameter)
                                }
                                Option[FrontendCallable]::None => {}
                            }
                        }
                        Option[ActiveCall]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"
}

fn signature_help_workspace_json(workspace: Workspace, doc: Document, request: Json) -> str {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    match find_active_call(doc.analysis, line, character) {
                        Option[ActiveCall]::Some(call) => {
                            match find_callable_workspace(workspace, doc.analysis, call.name) {
                                Option[FrontendCallable]::Some(callable) => {
                                    ret signature_help_for(callable, call.active_parameter)
                                }
                                Option[FrontendCallable]::None => {}
                            }
                        }
                        Option[ActiveCall]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"
}

fn signature_help_for(callable: FrontendCallable, active_parameter: usize) -> str {
    let mut params = "["
    let mut first = true
    for param in callable.params {
        if !first {
            params += ","
        }
        params += "{\"label\":" + json_text(param) + "}"
        first = false
    }
    params += "]"
    ret "{\"signatures\":[{\"label\":" + json_text(callable_label(callable)) + ",\"parameters\":" + params + "}],\"activeSignature\":0,\"activeParameter\":" + Debug::fmt(active_parameter) + "}"
}

fn callable_label(callable: FrontendCallable) -> str {
    let mut out = callable.name + "("
    let mut first = true
    for param in callable.params {
        if !first {
            out += ", "
        }
        out += param
        first = false
    }
    out += ")"
    match callable.ret_type {
        Option[str]::Some(ret_type) => {
            out += " -> " + ret_type
        }
        Option[str]::None => {}
    }
    ret out
}

fn find_callable(analysis: FrontendDocument, name: str) -> Option[FrontendCallable] {
    for callable in analysis.callables {
        if callable.name == name {
            ret Option[FrontendCallable]::Some(callable)
        }
    }
    ret Option[FrontendCallable]::None
}

fn find_callable_workspace(workspace: Workspace, preferred: FrontendDocument, name: str) -> Option[FrontendCallable] {
    match find_callable(preferred, name) {
        Option[FrontendCallable]::Some(callable) => {
            ret Option[FrontendCallable]::Some(callable)
        }
        Option[FrontendCallable]::None => {}
    }
    for doc in workspace.documents {
        match find_callable(doc.analysis, name) {
            Option[FrontendCallable]::Some(callable) => {
                ret Option[FrontendCallable]::Some(callable)
            }
            Option[FrontendCallable]::None => {}
        }
        match find_callable_in_list(doc.callables, name) {
            Option[FrontendCallable]::Some(callable) => {
                ret Option[FrontendCallable]::Some(callable)
            }
            Option[FrontendCallable]::None => {}
        }
    }
    ret Option[FrontendCallable]::None
}

fn find_callable_for_inlay(workspace: Workspace, preferred: FrontendDocument, extra_callables: Vec[FrontendCallable], name: str) -> Option[FrontendCallable] {
    match find_callable(preferred, name) {
        Option[FrontendCallable]::Some(callable) => {
            ret Option[FrontendCallable]::Some(callable)
        }
        Option[FrontendCallable]::None => {}
    }
    match find_callable_in_list(extra_callables, name) {
        Option[FrontendCallable]::Some(callable) => {
            ret Option[FrontendCallable]::Some(callable)
        }
        Option[FrontendCallable]::None => {}
    }
    ret find_callable_workspace(workspace, preferred, name)
}

fn find_callable_in_list(callables: Vec[FrontendCallable], name: str) -> Option[FrontendCallable] {
    for callable in callables {
        if callable.name == name {
            ret Option[FrontendCallable]::Some(callable)
        }
    }
    ret Option[FrontendCallable]::None
}

fn find_active_call(analysis: FrontendDocument, line: usize, character: usize) -> Option[ActiveCall] {
    let mut frames = Vec[ActiveCall]::new()
    let mut index = 0_usize
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token_starts_after_or_at(token, line, character) {
                    break
                }
                if token.type == TokenType::LEFT_PAREN {
                    let mut name = ""
                    match previous_token(analysis, index) {
                        Option[Token]::Some(prev) => {
                            if prev.type == TokenType::IDENTIFIER {
                                name = prev.value
                            }
                        }
                        Option[Token]::None => {}
                    }
                    frames.push(ActiveCall {name, 0_usize, token.line, token.column})
                }
                elif token.type == TokenType::COMMA {
                    if frames.len() > 0_usize {
                        let last_index = frames.len() - 1_usize
                        match frames.get(last_index) {
                            Option[ActiveCall]::Some(frame) => {
                                frames.set(last_index, ActiveCall {frame.name, frame.active_parameter + 1_usize, frame.line, frame.column})
                            }
                            Option[ActiveCall]::None => {}
                        }
                    }
                }
                elif token.type == TokenType::RIGHT_PAREN {
                    if frames.len() > 0_usize {
                        let popped = frames.pop()
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }

    let mut frame_index = frames.len()
    while frame_index > 0_usize {
        frame_index -= 1_usize
        match frames.get(frame_index) {
            Option[ActiveCall]::Some(frame) => {
                if frame.name.len() > 0_usize {
                    ret Option[ActiveCall]::Some(frame)
                }
            }
            Option[ActiveCall]::None => {}
        }
    }
    ret Option[ActiveCall]::None
}

fn inlay_hints_json(analysis: FrontendDocument) -> str {
    let mut out = "["
    let mut first = true
    let mut index = 0_usize
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER {
                    if is_callable_invocation_candidate(analysis, index) {
                        match find_callable(analysis, token.value) {
                            Option[FrontendCallable]::Some(callable) => {
                                let hints = call_inlay_hints_json(analysis, callable, index + 1_usize, first, 0_usize)
                                out += hints.0
                                first = hints.1
                            }
                            Option[FrontendCallable]::None => {}
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    out += "]"
    ret out
}

fn inlay_hints_workspace_json(workspace: Workspace, analysis: FrontendDocument) -> str {
    ret inlay_hints_workspace_json_offset(workspace, analysis, 0_usize, Vec[FrontendCallable]::new())
}

fn inlay_hints_workspace_json_offset(workspace: Workspace, analysis: FrontendDocument, line_offset: usize, extra_callables: Vec[FrontendCallable]) -> str {
    let mut out = "["
    let mut first = true
    let type_hints = variable_type_inlay_hints_json(workspace, analysis, first, line_offset, extra_callables)
    out += type_hints.0
    first = type_hints.1

    let mut index = 0_usize
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER {
                    if is_callable_invocation_candidate(analysis, index) {
                        match find_callable_for_inlay(workspace, analysis, extra_callables, token.value) {
                            Option[FrontendCallable]::Some(callable) => {
                                let hints = call_inlay_hints_json(analysis, callable, index + 1_usize, first, line_offset)
                                out += hints.0
                                first = hints.1
                            }
                            Option[FrontendCallable]::None => {}
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    out += "]"
    ret out
}

fn inlay_hints_for_request(workspace: Workspace, doc: Document, request: Json) -> str {
    if doc.analysis.tokens.len() > 0_usize {
        ret inlay_hints_workspace_json(workspace, doc.analysis)
    }

    let start_line = json_request_range_line(request, "start", 0_usize)
    let end_line = json_request_range_line(request, "end", start_line + 120_usize)
    let window = source_lines_window(doc.text, start_line, end_line)
    let analysis = analyze_source_lightweight(window)
    let extra_callables = collect_inlay_callable_index(doc.text, analysis)
    ret inlay_hints_workspace_json_offset(workspace, analysis, start_line, extra_callables)
}

fn variable_type_inlay_hints_json(workspace: Workspace, analysis: FrontendDocument, first: bool, line_offset: usize, extra_callables: Vec[FrontendCallable]) -> (str, bool) {
    let mut out = ""
    let mut is_first = first
    let mut index = 0_usize
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::KW_LET {
                    match variable_type_hint_at(workspace, analysis, index, line_offset, extra_callables) {
                        Option[str]::Some(hint) => {
                            if !is_first {
                                out += ","
                            }
                            out += hint
                            is_first = false
                        }
                        Option[str]::None => {}
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret (out, is_first)
}

fn variable_type_hint_at(workspace: Workspace, analysis: FrontendDocument, let_index: usize, line_offset: usize, extra_callables: Vec[FrontendCallable]) -> Option[str] {
    let mut index = let_index + 1_usize
    if next_token_is_lsp(analysis, index, TokenType::KW_MUT) {
        index += 1_usize
    }
    match analysis.tokens.get(index) {
        Option[Token]::Some(name_token) => {
            if name_token.type != TokenType::IDENTIFIER {
                ret Option[str]::None
            }
            match analysis.tokens.get(index + 1_usize) {
                Option[Token]::Some(after_name) => {
                    if after_name.type == TokenType::COLON {
                        ret Option[str]::None
                    }
                    if after_name.type != TokenType::ASSIGN {
                        ret Option[str]::None
                    }
                }
                Option[Token]::None => {
                    ret Option[str]::None
                }
            }
            match infer_expr_type(workspace, analysis, index + 2_usize, extra_callables) {
                Option[str]::Some(typ) => {
                    ret Option[str]::Some(inlay_hint_json(name_token.line + line_offset, name_token.column + name_token.value.char_len(), ": " + typ, 1_usize))
                }
                Option[str]::None => {}
            }
        }
        Option[Token]::None => {}
    }
    ret Option[str]::None
}

fn infer_expr_type(workspace: Workspace, analysis: FrontendDocument, start: usize, extra_callables: Vec[FrontendCallable]) -> Option[str] {
    match analysis.tokens.get(start) {
        Option[Token]::Some(token) => {
            if token.type == TokenType::INTEGER {
                ret Option[str]::Some(numeric_literal_type_at(analysis, start, "usize"))
            }
            if token.type == TokenType::FLOAT {
                ret Option[str]::Some(numeric_literal_type_at(analysis, start, "f32"))
            }
            if token.type == TokenType::STRING {
                ret Option[str]::Some("str")
            }
            if token.type == TokenType::BOOLEAN {
                ret Option[str]::Some("bool")
            }
            if token.type == TokenType::MINUS {
                ret infer_expr_type(workspace, analysis, start + 1_usize, extra_callables)
            }
            if token.type == TokenType::IDENTIFIER {
                if token.value == "vec" {
                    match infer_vec_macro_type(workspace, analysis, start, extra_callables) {
                        Option[str]::Some(typ) => {
                            ret Option[str]::Some(typ)
                        }
                        Option[str]::None => {}
                    }
                }
                match infer_generic_receiver_type(analysis, start) {
                    Option[str]::Some(typ) => {
                        ret Option[str]::Some(typ)
                    }
                    Option[str]::None => {}
                }
                if next_token_is_lsp(analysis, start + 1_usize, TokenType::LEFT_BRACE) {
                    ret Option[str]::Some(token.value)
                }
                if next_token_is_lsp(analysis, start + 1_usize, TokenType::LEFT_PAREN) {
                    match find_callable_for_inlay(workspace, analysis, extra_callables, token.value) {
                        Option[FrontendCallable]::Some(callable) => {
                            ret callable.ret_type
                        }
                        Option[FrontendCallable]::None => {}
                    }
                }
            }
        }
        Option[Token]::None => {}
    }
    ret Option[str]::None
}

fn infer_generic_receiver_type(analysis: FrontendDocument, start: usize) -> Option[str] {
    match collect_type_path_at(analysis, start) {
        Option[str]::Some(path) => {
            match token_after_type_path(analysis, start) {
                Option[Token]::Some(token) => {
                    if token.type == TokenType::SCOPE {
                        ret Option[str]::Some(path)
                    }
                }
                Option[Token]::None => {}
            }
        }
        Option[str]::None => {}
    }
    ret Option[str]::None
}

fn collect_type_path_at(analysis: FrontendDocument, start: usize) -> Option[str] {
    let mut out = ""
    let mut index = start
    let mut bracket_depth = 0_i32
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if index == start {
                    if token.type != TokenType::IDENTIFIER {
                        ret Option[str]::None
                    }
                }
                if bracket_depth == 0_i32 {
                    if token.type == TokenType::SCOPE {
                        break
                    }
                    if token.type == TokenType::LEFT_PAREN || token.type == TokenType::LEFT_BRACE || token.type == TokenType::COMMA {
                        break
                    }
                }
                if token.type == TokenType::LEFT_BRACKET {
                    bracket_depth += 1_i32
                }
                elif token.type == TokenType::RIGHT_BRACKET {
                    bracket_depth -= 1_i32
                }
                out += token.value
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    if out.len() == 0_usize {
        ret Option[str]::None
    }
    ret Option[str]::Some(out)
}

fn token_after_type_path(analysis: FrontendDocument, start: usize) -> Option[Token] {
    let mut index = start
    let mut bracket_depth = 0_i32
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if bracket_depth == 0_i32 {
                    if index > start {
                        if token.type == TokenType::SCOPE || token.type == TokenType::LEFT_PAREN || token.type == TokenType::LEFT_BRACE || token.type == TokenType::COMMA {
                            ret Option[Token]::Some(token)
                        }
                    }
                }
                if token.type == TokenType::LEFT_BRACKET {
                    bracket_depth += 1_i32
                }
                elif token.type == TokenType::RIGHT_BRACKET {
                    bracket_depth -= 1_i32
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret Option[Token]::None
}

fn infer_vec_macro_type(workspace: Workspace, analysis: FrontendDocument, start: usize, extra_callables: Vec[FrontendCallable]) -> Option[str] {
    if !next_token_is_lsp(analysis, start + 1_usize, TokenType::BANG) {
        ret Option[str]::None
    }
    if !next_token_is_lsp(analysis, start + 2_usize, TokenType::LEFT_BRACKET) {
        ret Option[str]::None
    }
    match infer_expr_type(workspace, analysis, start + 3_usize, extra_callables) {
        Option[str]::Some(item_type) => {
            ret Option[str]::Some("Vec[" + item_type + "]")
        }
        Option[str]::None => {}
    }
    ret Option[str]::None
}

fn integer_literal_type(value: str) -> str {
    match numeric_suffix(value) {
        Option[str]::Some(suffix) => {
            ret suffix
        }
        Option[str]::None => {}
    }
    ret "usize"
}

fn float_literal_type(value: str) -> str {
    match numeric_suffix(value) {
        Option[str]::Some(suffix) => {
            ret suffix
        }
        Option[str]::None => {}
    }
    ret "f32"
}

fn numeric_literal_type_at(analysis: FrontendDocument, start: usize, default_type: str) -> str {
    match analysis.tokens.get(start + 1_usize) {
        Option[Token]::Some(token) => {
            if token.type == TokenType::IDENTIFIER {
                if is_numeric_suffix_token_lsp(token.value) {
                    ret token.value.slice(1_usize, token.value.char_len() - 1_usize)
                }
            }
        }
        Option[Token]::None => {}
    }
    ret default_type
}

fn is_numeric_suffix_token_lsp(raw: str) -> bool {
    if raw.len() == 0_usize {
        ret false
    }
    ret raw.byte_at(0_usize) == 95_u8
}

fn numeric_suffix(value: str) -> Option[str] {
    let mut index = value.char_len()
    while index > 0_usize {
        index -= 1_usize
        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch == "_" {
                    if index + 1_usize < value.char_len() {
                        ret Option[str]::Some(value.slice(index + 1_usize, value.char_len() - index - 1_usize))
                    }
                    ret Option[str]::None
                }
            }
            Option[str]::None => {}
        }
    }
    ret Option[str]::None
}

fn is_callable_invocation_candidate(analysis: FrontendDocument, index: usize) -> bool {
    if !next_token_is_lsp(analysis, index + 1_usize, TokenType::LEFT_PAREN) {
        ret false
    }
    match previous_token(analysis, index) {
        Option[Token]::Some(prev) => {
            if prev.type == TokenType::KW_FN {
                ret false
            }
        }
        Option[Token]::None => {}
    }
    ret true
}

fn inlay_hint_json(line: usize, character: usize, label: str, kind: usize) -> str {
    ret "{\"position\":{\"line\":" + Debug::fmt(line) + ",\"character\":" + Debug::fmt(character) + "},\"label\":" + json_text(label) + ",\"kind\":" + Debug::fmt(kind) + ",\"paddingLeft\":true,\"paddingRight\":false}"
}

fn call_inlay_hints_json(analysis: FrontendDocument, callable: FrontendCallable, open_index: usize, first: bool, line_offset: usize) -> (str, bool) {
    let mut out = ""
    let mut is_first = first
    let mut depth = 0_i32
    let mut index = open_index
    let mut param_index = 0_usize
    let mut expecting_arg = false

    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::LEFT_PAREN {
                    depth += 1_i32
                    if index == open_index {
                        expecting_arg = true
                    }
                }
                elif token.type == TokenType::RIGHT_PAREN {
                    depth -= 1_i32
                    if depth == 0_i32 {
                        ret (out, is_first)
                    }
                }
                elif depth == 1_i32 {
                    if token.type == TokenType::COMMA {
                        param_index += 1_usize
                        expecting_arg = true
                    }
                    elif expecting_arg {
                        match callable_param(callable, param_index) {
                            Option[str]::Some(param) => {
                                if param != "self" {
                                    if !is_first {
                                        out += ","
                                    }
                                    out += inlay_hint_json(token.line + line_offset, token.column, param + ": ", 2_usize)
                                    is_first = false
                                }
                            }
                            Option[str]::None => {}
                        }
                        expecting_arg = false
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }

    ret (out, is_first)
}

fn callable_param(callable: FrontendCallable, index: usize) -> Option[str] {
    ret callable.params.get(index)
}

fn token_starts_after_or_at(token: Token, line: usize, character: usize) -> bool {
    if token.line > line {
        ret true
    }
    if token.line == line {
        if token.column >= character {
            ret true
        }
    }
    ret false
}

fn previous_token(analysis: FrontendDocument, index: usize) -> Option[Token] {
    if index == 0_usize {
        ret Option[Token]::None
    }
    ret analysis.tokens.get(index - 1_usize)
}

fn next_token_is_lsp(analysis: FrontendDocument, index: usize, expected: TokenType) -> bool {
    match analysis.tokens.get(index) {
        Option[Token]::Some(token) => {
            ret token.type == expected
        }
        Option[Token]::None => {
            ret false
        }
    }
}

fn hover_result(doc: Document, request: Json) -> str {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    match token_at(doc.analysis, line, character) {
                        Option[Token]::Some(token) => {
                            ret "{\"contents\":{\"kind\":\"markdown\",\"value\":" + json_text(hover_text(doc.analysis, token)) + "}}"
                        }
                        Option[Token]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret "{\"contents\":{\"kind\":\"markdown\",\"value\":\"Encore source file.\"}}"
}

fn hover_workspace_result(workspace: Workspace, doc: Document, request: Json) -> str {
    match request_token(doc.analysis, request) {
        Option[Token]::Some(token) => {
            match find_symbol_workspace(workspace, doc, token.value) {
                Option[LocatedSymbol]::Some(located) => {
                    let mut text = "`" + located.symbol.name + "` " + symbol_kind_name(located.symbol.kind)
                    if located.symbol.kind == 12_usize {
                        match find_callable_workspace(workspace, doc.analysis, located.symbol.name) {
                            Option[FrontendCallable]::Some(callable) => {
                                text = "`" + callable_label(callable) + "` function"
                            }
                            Option[FrontendCallable]::None => {}
                        }
                    }
                    text += " declaration"
                    if located.uri != doc.uri {
                        text += "\\n\\nDefined in `" + located.uri + "`"
                    }
                    ret "{\"contents\":{\"kind\":\"markdown\",\"value\":" + json_text(text) + "}}"
                }
                Option[LocatedSymbol]::None => {}
            }
        }
        Option[Token]::None => {}
    }
    ret hover_result(doc, request)
}

fn hover_text(analysis: FrontendDocument, token: Token) -> str {
    match find_symbol_at(analysis, token.line, token.column) {
        Option[FrontendSymbol]::Some(symbol) => {
            ret "`" + symbol.name + "` " + symbol_kind_name(symbol.kind) + " declaration"
        }
        Option[FrontendSymbol]::None => {}
    }

    match token.type {
        TokenType::IDENTIFIER => {
            ret "`" + token.value + "` identifier"
        }
        TokenType::INTEGER => {
            ret "`" + token.value + "` integer literal"
        }
        TokenType::FLOAT => {
            ret "`" + token.value + "` float literal"
        }
        TokenType::STRING => {
            ret "string literal"
        }
        TokenType::BOOLEAN => {
            ret "`" + token.value + "` boolean literal"
        }
        _ => {
            if semantic_token_type(token) == 0_usize {
                ret "`" + token.value + "` keyword"
            }
            ret "`" + token.value + "`"
        }
    }
}

fn symbol_kind_name(kind: usize) -> str {
    if kind == 12_usize {
        ret "function"
    }
    if kind == 23_usize {
        ret "struct"
    }
    if kind == 10_usize {
        ret "enum"
    }
    if kind == 11_usize {
        ret "trait"
    }
    if kind == 5_usize {
        ret "impl"
    }
    ret "symbol"
}

fn symbol_json(symbol: FrontendSymbol) -> str {
    let end_char = symbol.column + symbol.length
    ret "{\"name\":" + json_text(symbol.name) + ",\"kind\":" + Debug::fmt(symbol.kind) + ",\"range\":{\"start\":{\"line\":" + Debug::fmt(symbol.line) + ",\"character\":" + Debug::fmt(symbol.column) + "},\"end\":{\"line\":" + Debug::fmt(symbol.line) + ",\"character\":" + Debug::fmt(end_char) + "}},\"selectionRange\":{\"start\":{\"line\":" + Debug::fmt(symbol.line) + ",\"character\":" + Debug::fmt(symbol.column) + "},\"end\":{\"line\":" + Debug::fmt(symbol.line) + ",\"character\":" + Debug::fmt(end_char) + "}}}"
}

fn document_symbols(analysis: FrontendDocument) -> str {
    let mut out = "["
    let mut first = true
    for symbol in analysis.symbols {
        if symbol.name.len() > 0_usize {
                if !first {
                    out += ","
                }
                out += symbol_json(symbol)
                first = false
        }
    }
    out += "]"
    ret out
}

fn range_json(line: usize, column: usize, end_line: usize, end_column: usize) -> str {
    ret "{\"start\":{\"line\":" + Debug::fmt(line) + ",\"character\":" + Debug::fmt(column) + "},\"end\":{\"line\":" + Debug::fmt(end_line) + ",\"character\":" + Debug::fmt(end_column) + "}}"
}

fn token_range_json(token: Token) -> str {
    ret range_json(token.line, token.column, token.line, token.column + token.value.char_len())
}

fn symbol_range_json(symbol: FrontendSymbol) -> str {
    ret range_json(symbol.line, symbol.column, symbol.line, symbol.column + symbol.length)
}

fn diagnostic_json(diagnostic: FrontendDiagnostic) -> str {
    let end_char = diagnostic.column + diagnostic.length
    ret "{\"range\":" + range_json(diagnostic.line, diagnostic.column, diagnostic.line, end_char) + ",\"severity\":" + Debug::fmt(diagnostic.severity) + ",\"code\":" + json_text(diagnostic.code) + ",\"source\":\"encore-lsp\",\"message\":" + json_text(diagnostic.message) + "}"
}

fn publish_diagnostics(uri: str, analysis: FrontendDocument) -> str {
    let mut out = "{\"uri\":" + json_text(uri) + ",\"diagnostics\":" + diagnostics_array_json(analysis) + "}"
    ret notification("textDocument/publishDiagnostics", out)
}

fn diagnostics_array_json(analysis: FrontendDocument) -> str {
    let mut out = "["
    let mut first = true
    for diagnostic in analysis.diagnostics {
        if !first {
            out += ","
        }
        out += diagnostic_json(diagnostic)
        first = false
    }
    out += "]"
    ret out
}

fn diagnostic_report_json(analysis: FrontendDocument) -> str {
    ret "{\"kind\":\"full\",\"items\":" + diagnostics_array_json(analysis) + "}"
}

fn dependency_edge_json(edge: DependencyEdge) -> str {
    ret "{\"source\":" + json_text(edge.source) + ",\"target\":" + json_text(edge.target) + ",\"public\":" + Debug::fmt(edge.is_public) + ",\"line\":" + Debug::fmt(edge.line) + ",\"column\":" + Debug::fmt(edge.column) + ",\"length\":" + Debug::fmt(edge.length) + "}"
}

fn dependency_graph_json(analysis: FrontendDocument) -> str {
    let mut out = "{\"parsed\":" + Debug::fmt(analysis.parsed) + ",\"edges\":["
    let mut first = true
    for edge in analysis.dependencies.all() {
        if !first {
            out += ","
        }
        out += dependency_edge_json(edge)
        first = false
    }
    out += "]}"
    ret out
}

fn semantic_tokens_empty() -> str {
    ret "{\"data\":[]}"
}

fn document_highlights_json(analysis: FrontendDocument, request: Json) -> str {
    match request_token(analysis, request) {
        Option[Token]::Some(token) => {
            if !token_can_reference(token) {
                ret "[]"
            }
            ret token_occurrence_highlights_json(analysis, token.value)
        }
        Option[Token]::None => {
            ret "[]"
        }
    }
}

fn token_occurrence_highlights_json(analysis: FrontendDocument, name: str) -> str {
    let mut out = "["
    let mut first = true
    for token in analysis.tokens {
        if token.value == name {
            if token_can_reference(token) {
                if !first {
                    out += ","
                }
                out += "{\"range\":" + token_range_json(token) + ",\"kind\":1}"
                first = false
            }
        }
    }
    out += "]"
    ret out
}

fn references_json(doc: Document, request: Json) -> str {
    match request_token(doc.analysis, request) {
        Option[Token]::Some(token) => {
            if !token_can_reference(token) {
                ret "[]"
            }
            ret token_occurrence_locations_json(doc.uri, doc.analysis, token.value)
        }
        Option[Token]::None => {
            ret "[]"
        }
    }
}

fn references_workspace_json(workspace: Workspace, doc: Document, request: Json) -> str {
    match request_token(doc.analysis, request) {
        Option[Token]::Some(token) => {
            if !token_can_reference(token) {
                ret "[]"
            }
            let mut out = "["
            let mut first = true
            for open_doc in workspace.documents {
                let locations = token_occurrence_locations_inner_json(open_doc.uri, open_doc.analysis, token.value, first)
                out += locations.0
                first = locations.1
            }
            out += "]"
            ret out
        }
        Option[Token]::None => {
            ret "[]"
        }
    }
}

fn token_occurrence_locations_json(uri: str, analysis: FrontendDocument, name: str) -> str {
    let mut out = "["
    let mut first = true
    for token in analysis.tokens {
        if token.value == name {
            if token_can_reference(token) {
                if !first {
                    out += ","
                }
                out += "{\"uri\":" + json_text(uri) + ",\"range\":" + token_range_json(token) + "}"
                first = false
            }
        }
    }
    out += "]"
    ret out
}

fn token_occurrence_locations_inner_json(uri: str, analysis: FrontendDocument, name: str, first: bool) -> (str, bool) {
    let mut out = ""
    let mut is_first = first
    for token in analysis.tokens {
        if token.value == name {
            if token_can_reference(token) {
                if !is_first {
                    out += ","
                }
                out += "{\"uri\":" + json_text(uri) + ",\"range\":" + token_range_json(token) + "}"
                is_first = false
            }
        }
    }
    ret (out, is_first)
}

fn folding_ranges_json(analysis: FrontendDocument) -> str {
    let mut stack = Vec[Token]::new()
    let mut out = "["
    let mut first = true

    for token in analysis.tokens {
        if token.type == TokenType::LEFT_BRACE {
            stack.push(token)
        }
        elif token.type == TokenType::RIGHT_BRACE {
            let popped = stack.pop()
            match popped {
                Option[Token]::Some(open) => {
                    if token.line > open.line {
                        if !first {
                            out += ","
                        }
                        out += "{\"startLine\":" + Debug::fmt(open.line) + ",\"startCharacter\":" + Debug::fmt(open.column) + ",\"endLine\":" + Debug::fmt(token.line) + ",\"endCharacter\":" + Debug::fmt(token.column + token.value.char_len()) + "}"
                        first = false
                    }
                }
                Option[Token]::None => {}
            }
        }
    }

    out += "]"
    ret out
}

fn selection_ranges_json(analysis: FrontendDocument, request: Json) -> str {
    match json_positions(request) {
        Option[Vec[Json]]::Some(positions) => {
            let mut out = "["
            let mut first = true
            for position in positions {
                if !first {
                    out += ","
                }
                out += selection_range_for_position(analysis, position)
                first = false
            }
            out += "]"
            ret out
        }
        Option[Vec[Json]]::None => {
            ret "[]"
        }
    }
}

fn selection_range_for_position(analysis: FrontendDocument, position: Json) -> str {
    match json_position_value_line(position) {
        Option[usize]::Some(line) => {
            match json_position_value_character(position) {
                Option[usize]::Some(character) => {
                    match token_at(analysis, line, character) {
                        Option[Token]::Some(token) => {
                            ret "{\"range\":" + token_range_json(token) + "}"
                        }
                        Option[Token]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret "{\"range\":" + range_json(0_usize, 0_usize, 0_usize, 0_usize) + "}"
}

fn semantic_tokens_json(analysis: FrontendDocument) -> str {
    let mut out = "{\"data\":["
    let mut first = true
    let mut prev_line = 0_usize
    let mut prev_start = 0_usize

    for token in analysis.tokens {
        match semantic_token_kind_for_analysis(analysis, token) {
            Option[usize]::Some(kind) => {
                if !first {
                    out += ","
                }
                let mut delta_line = token.line
                let mut delta_start = token.column
                if !first {
                    delta_line = token.line - prev_line
                    if delta_line == 0_usize {
                        delta_start = token.column - prev_start
                    }
                }
                out += Debug::fmt(delta_line) + "," + Debug::fmt(delta_start) + "," + Debug::fmt(token.value.char_len()) + "," + Debug::fmt(kind) + ",0"
                prev_line = token.line
                prev_start = token.column
                first = false
            }
            Option[usize]::None => {}
        }
    }
    out += "]}"
    ret out
}

fn semantic_token_kind(token: Token) -> Option[usize] {
    match token.type {
        TokenType::IDENTIFIER => {
            ret Option[usize]::Some(6_usize)
        }
        TokenType::INTEGER => {
            ret Option[usize]::Some(7_usize)
        }
        TokenType::FLOAT => {
            ret Option[usize]::Some(7_usize)
        }
        TokenType::STRING => {
            ret Option[usize]::Some(8_usize)
        }
        TokenType::BOOLEAN => {
            ret Option[usize]::Some(0_usize)
        }
        TokenType::ONE_LINE_COMMENT => {
            ret Option[usize]::Some(10_usize)
        }
        TokenType::MULTI_LINE_COMMENT => {
            ret Option[usize]::Some(10_usize)
        }
        _ => {
            if token_is_keyword(token) {
                ret Option[usize]::Some(0_usize)
            }
            if token_is_operator(token) {
                ret Option[usize]::Some(9_usize)
            }
        }
    }
    ret Option[usize]::None
}

fn semantic_token_kind_for_analysis(analysis: FrontendDocument, token: Token) -> Option[usize] {
    match find_symbol_at(analysis, token.line, token.column) {
        Option[FrontendSymbol]::Some(symbol) => {
            if symbol.kind == 12_usize {
                ret Option[usize]::Some(1_usize)
            }
            if symbol.kind == 23_usize {
                ret Option[usize]::Some(3_usize)
            }
            if symbol.kind == 10_usize {
                ret Option[usize]::Some(4_usize)
            }
            if symbol.kind == 11_usize {
                ret Option[usize]::Some(5_usize)
            }
            if symbol.kind == 5_usize {
                ret Option[usize]::Some(2_usize)
            }
        }
        Option[FrontendSymbol]::None => {}
    }
    ret semantic_token_kind(token)
}

fn semantic_token_type(token: Token) -> usize {
    match semantic_token_kind(token) {
        Option[usize]::Some(kind) => {
            ret kind
        }
        Option[usize]::None => {
            ret 6_usize
        }
    }
}

fn token_is_keyword(token: Token) -> bool {
    match token.type {
        TokenType::KW_FN => { ret true }
        TokenType::KW_STRUCT => { ret true }
        TokenType::KW_TRAIT => { ret true }
        TokenType::KW_ENUM => { ret true }
        TokenType::KW_IMPL => { ret true }
        TokenType::KW_FOR => { ret true }
        TokenType::KW_LET => { ret true }
        TokenType::KW_MUT => { ret true }
        TokenType::KW_RET => { ret true }
        TokenType::KW_WHILE => { ret true }
        TokenType::KW_LOOP => { ret true }
        TokenType::KW_DO => { ret true }
        TokenType::KW_CONTINUE => { ret true }
        TokenType::KW_BREAK => { ret true }
        TokenType::KW_IF => { ret true }
        TokenType::KW_ELIF => { ret true }
        TokenType::KW_ELSE => { ret true }
        TokenType::KW_MATCH => { ret true }
        TokenType::KW_PUB => { ret true }
        TokenType::KW_IMPORT => { ret true }
        TokenType::KW_AS => { ret true }
        TokenType::KW_EXTERN => { ret true }
        TokenType::KW_UNSAFE => { ret true }
        TokenType::KW_EHIR => { ret true }
        _ => { ret false }
    }
}

fn token_is_operator(token: Token) -> bool {
    match token.type {
        TokenType::PLUS => { ret true }
        TokenType::MINUS => { ret true }
        TokenType::ASTERISK => { ret true }
        TokenType::SLASH => { ret true }
        TokenType::PERCENT => { ret true }
        TokenType::EQUAL_EQUAL => { ret true }
        TokenType::BANG_EQUAL => { ret true }
        TokenType::LESS => { ret true }
        TokenType::GREATER => { ret true }
        TokenType::LESS_EQUAL => { ret true }
        TokenType::GREATER_EQUAL => { ret true }
        TokenType::AND_AND => { ret true }
        TokenType::PIPE_PIPE => { ret true }
        TokenType::BANG => { ret true }
        TokenType::ASSIGN => { ret true }
        TokenType::PLUS_EQUAL => { ret true }
        TokenType::MINUS_EQUAL => { ret true }
        TokenType::ASTERISK_EQUAL => { ret true }
        TokenType::SLASH_EQUAL => { ret true }
        TokenType::PERCENT_EQUAL => { ret true }
        TokenType::ARROW => { ret true }
        TokenType::FAT_ARROW => { ret true }
        TokenType::SCOPE => { ret true }
        _ => { ret false }
    }
}

fn token_at(analysis: FrontendDocument, line: usize, character: usize) -> Option[Token] {
    for token in analysis.tokens {
        if token.line == line {
            if character >= token.column {
                if character < token.column + token.value.char_len() {
                    ret Option[Token]::Some(token)
                }
            }
        }
    }
    ret Option[Token]::None
}

fn request_token(analysis: FrontendDocument, request: Json) -> Option[Token] {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    ret token_at(analysis, line, character)
                }
                Option[usize]::None => {
                    ret Option[Token]::None
                }
            }
        }
        Option[usize]::None => {
            ret Option[Token]::None
        }
    }
}

fn token_can_reference(token: Token) -> bool {
    ret token.type == TokenType::IDENTIFIER
}

fn document_links_json(analysis: FrontendDocument) -> str {
    let mut out = "["
    let mut first = true
    for edge in analysis.dependencies.all() {
        if !first {
            out += ","
        }
        out += "{\"range\":{\"start\":{\"line\":" + Debug::fmt(edge.line) + ",\"character\":" + Debug::fmt(edge.column) + "},\"end\":{\"line\":" + Debug::fmt(edge.line) + ",\"character\":" + Debug::fmt(edge.column + edge.length) + "}},\"tooltip\":" + json_text("Encore import: " + edge.target) + "}"
        first = false
    }
    out += "]"
    ret out
}

fn definition_json(doc: Document, request: Json) -> str {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    match token_at(doc.analysis, line, character) {
                        Option[Token]::Some(token) => {
                            match find_symbol(doc.analysis, token.value) {
                                Option[FrontendSymbol]::Some(symbol) => {
                                    ret location_json(doc.uri, symbol)
                                }
                                Option[FrontendSymbol]::None => {}
                            }
                        }
                        Option[Token]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret "null"
}

fn definition_workspace_json(workspace: Workspace, doc: Document, request: Json) -> str {
    match json_position_line(request) {
        Option[usize]::Some(line) => {
            match json_position_character(request) {
                Option[usize]::Some(character) => {
                    match token_at(doc.analysis, line, character) {
                        Option[Token]::Some(token) => {
                            match find_symbol_workspace(workspace, doc, token.value) {
                                Option[LocatedSymbol]::Some(located) => {
                                    ret location_json(located.uri, located.symbol)
                                }
                                Option[LocatedSymbol]::None => {}
                            }
                        }
                        Option[Token]::None => {}
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret "null"
}

fn prepare_call_hierarchy_json(workspace: Workspace, doc: Document, request: Json) -> str {
    match request_token(doc.analysis, request) {
        Option[Token]::Some(token) => {
            if !token_can_reference(token) {
                ret "[]"
            }
            match find_symbol_workspace(workspace, doc, token.value) {
                Option[LocatedSymbol]::Some(located) => {
                    if located.symbol.kind == 12_usize {
                        ret "[" + call_hierarchy_item_json(located.uri, located.symbol) + "]"
                    }
                }
                Option[LocatedSymbol]::None => {}
            }
        }
        Option[Token]::None => {}
    }
    ret "[]"
}

fn call_hierarchy_item_json(uri: str, symbol: FrontendSymbol) -> str {
    let range = symbol_range_json(symbol)
    ret "{\"name\":" + json_text(symbol.name) + ",\"kind\":" + Debug::fmt(symbol.kind) + ",\"uri\":" + json_text(uri) + ",\"range\":" + range + ",\"selectionRange\":" + range + ",\"data\":{\"uri\":" + json_text(uri) + ",\"name\":" + json_text(symbol.name) + "}}"
}

fn outgoing_calls_json(workspace: Workspace, request: Json) -> str {
    match json_call_hierarchy_item_uri(request) {
        Option[str]::Some(uri) => {
            match json_call_hierarchy_item_name(request) {
                Option[str]::Some(name) => {
                    match workspace.get(uri) {
                        Option[Document]::Some(doc) => {
                            ret outgoing_calls_for_document(workspace, doc, name)
                        }
                        Option[Document]::None => {}
                    }
                }
                Option[str]::None => {}
            }
        }
        Option[str]::None => {}
    }
    ret "[]"
}

fn outgoing_calls_for_document(workspace: Workspace, doc: Document, name: str) -> str {
    match function_body_span(doc.analysis, name) {
        Option[TokenSpan]::Some(span) => {
            let mut out = "["
            let mut first = true
            let mut index = span.start
            while index < span.end {
                match doc.analysis.tokens.get(index) {
                    Option[Token]::Some(token) => {
                        if token.type == TokenType::IDENTIFIER {
                            if is_callable_invocation_candidate(doc.analysis, index) {
                                match find_symbol_workspace(workspace, doc, token.value) {
                                    Option[LocatedSymbol]::Some(located) => {
                                        if located.symbol.kind == 12_usize {
                                            if !first {
                                                out += ","
                                            }
                                            out += "{\"to\":" + call_hierarchy_item_json(located.uri, located.symbol) + ",\"fromRanges\":[" + token_range_json(token) + "]}"
                                            first = false
                                        }
                                    }
                                    Option[LocatedSymbol]::None => {}
                                }
                            }
                        }
                    }
                    Option[Token]::None => {}
                }
                index += 1_usize
            }
            out += "]"
            ret out
        }
        Option[TokenSpan]::None => {}
    }
    ret "[]"
}

fn incoming_calls_json(workspace: Workspace, request: Json) -> str {
    match json_call_hierarchy_item_name(request) {
        Option[str]::Some(name) => {
            let mut out = "["
            let mut first = true
            for doc in workspace.documents {
                let chunk = incoming_calls_for_document(doc, name, first)
                out += chunk.0
                first = chunk.1
            }
            out += "]"
            ret out
        }
        Option[str]::None => {}
    }
    ret "[]"
}

fn incoming_calls_for_document(doc: Document, target_name: str, first: bool) -> (str, bool) {
    let mut out = ""
    let mut is_first = first
    let mut index = 0_usize
    while index < doc.analysis.tokens.len() {
        match doc.analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.value == target_name {
                    if is_callable_invocation_candidate(doc.analysis, index) {
                        match enclosing_function_symbol(doc.analysis, index) {
                            Option[FrontendSymbol]::Some(caller) => {
                                if !is_first {
                                    out += ","
                                }
                                out += "{\"from\":" + call_hierarchy_item_json(doc.uri, caller) + ",\"fromRanges\":[" + token_range_json(token) + "]}"
                                is_first = false
                            }
                            Option[FrontendSymbol]::None => {}
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret (out, is_first)
}

fn enclosing_function_symbol(analysis: FrontendDocument, token_index: usize) -> Option[FrontendSymbol] {
    for symbol in analysis.symbols {
        if symbol.kind == 12_usize {
            match function_body_span(analysis, symbol.name) {
                Option[TokenSpan]::Some(span) => {
                    if token_index >= span.start {
                        if token_index < span.end {
                            ret Option[FrontendSymbol]::Some(symbol)
                        }
                    }
                }
                Option[TokenSpan]::None => {}
            }
        }
    }
    ret Option[FrontendSymbol]::None
}

fn function_body_span(analysis: FrontendDocument, name: str) -> Option[TokenSpan] {
    match find_symbol(analysis, name) {
        Option[FrontendSymbol]::Some(symbol) => {
            match token_index_for_symbol(analysis, symbol) {
                Option[usize]::Some(symbol_index) => {
                    let mut index = symbol_index
                    while index < analysis.tokens.len() {
                        match analysis.tokens.get(index) {
                            Option[Token]::Some(token) => {
                                if token.type == TokenType::LEFT_BRACE {
                                    ret matching_brace_span(analysis, index)
                                }
                            }
                            Option[Token]::None => {}
                        }
                        index += 1_usize
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[FrontendSymbol]::None => {}
    }
    ret Option[TokenSpan]::None
}

fn matching_brace_span(analysis: FrontendDocument, open_index: usize) -> Option[TokenSpan] {
    let mut depth = 0_i32
    let mut index = open_index
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::LEFT_BRACE {
                    depth += 1_i32
                }
                elif token.type == TokenType::RIGHT_BRACE {
                    depth -= 1_i32
                    if depth == 0_i32 {
                        ret Option[TokenSpan]::Some(TokenSpan {open_index + 1_usize, index})
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret Option[TokenSpan]::None
}

fn token_index_for_symbol(analysis: FrontendDocument, symbol: FrontendSymbol) -> Option[usize] {
    let mut index = 0_usize
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.line == symbol.line {
                    if token.column == symbol.column {
                        if token.value == symbol.name {
                            ret Option[usize]::Some(index)
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret Option[usize]::None
}

fn prepare_rename_json(doc: Document, request: Json) -> str {
    match request_token(doc.analysis, request) {
        Option[Token]::Some(token) => {
            if token_can_reference(token) {
                ret "{\"range\":" + token_range_json(token) + ",\"placeholder\":" + json_text(token.value) + "}"
            }
        }
        Option[Token]::None => {}
    }
    ret "null"
}

fn rename_json(doc: Document, request: Json) -> str {
    match json_param_string(request, "newName") {
        Option[str]::Some(new_name) => {
            match request_token(doc.analysis, request) {
                Option[Token]::Some(token) => {
                    if token_can_reference(token) {
                        ret "{\"changes\":{" + json_text(doc.uri) + ":" + text_edits_for_token(doc.analysis, token.value, new_name) + "}}"
                    }
                }
                Option[Token]::None => {}
            }
        }
        Option[str]::None => {}
    }
    ret "{\"changes\":{}}"
}

fn rename_workspace_json(workspace: Workspace, doc: Document, request: Json) -> str {
    match json_param_string(request, "newName") {
        Option[str]::Some(new_name) => {
            match request_token(doc.analysis, request) {
                Option[Token]::Some(token) => {
                    if token_can_reference(token) {
                        match find_symbol(doc.analysis, token.value) {
                            Option[FrontendSymbol]::None => {
                                ret "{\"changes\":{" + json_text(doc.uri) + ":" + text_edits_for_token(doc.analysis, token.value, new_name) + "}}"
                            }
                            Option[FrontendSymbol]::Some(symbol) => {}
                        }

                        let mut out = "{\"changes\":{"
                        let mut first_doc = true
                        for open_doc in workspace.documents {
                            if has_token_occurrence(open_doc.analysis, token.value) {
                                if !first_doc {
                                    out += ","
                                }
                                out += json_text(open_doc.uri) + ":" + text_edits_for_token(open_doc.analysis, token.value, new_name)
                                first_doc = false
                            }
                        }
                        out += "}}"
                        ret out
                    }
                }
                Option[Token]::None => {}
            }
        }
        Option[str]::None => {}
    }
    ret "{\"changes\":{}}"
}

fn has_token_occurrence(analysis: FrontendDocument, name: str) -> bool {
    for token in analysis.tokens {
        if token.value == name {
            if token_can_reference(token) {
                ret true
            }
        }
    }
    ret false
}

fn text_edits_for_token(analysis: FrontendDocument, old_name: str, new_name: str) -> str {
    let mut out = "["
    let mut first = true
    for token in analysis.tokens {
        if token.value == old_name {
            if token_can_reference(token) {
                if !first {
                    out += ","
                }
                out += "{\"range\":" + token_range_json(token) + ",\"newText\":" + json_text(new_name) + "}"
                first = false
            }
        }
    }
    out += "]"
    ret out
}

fn document_formatting_json(doc: Document) -> str {
    let formatted = format_document_text(doc.text)
    if formatted == doc.text {
        ret "[]"
    }
    let end = document_end_position(doc.text)
    ret "[{\"range\":" + range_json(0_usize, 0_usize, end.line, end.character) + ",\"newText\":" + json_text(formatted) + "}]"
}

fn format_document_text(text: str) -> str {
    let mut out = ""
    let mut line = ""
    let mut index = 0_usize
    while index < text.char_len() {
        match text.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    out += trim_trailing_ws(line) + "\n"
                    line = ""
                }
                else {
                    line += ch
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    out += trim_trailing_ws(line)
    if out.len() == 0_usize {
        ret out
    }
    if !ends_with_newline(out) {
        out += "\n"
    }
    ret out
}

fn trim_trailing_ws(value: str) -> str {
    let mut keep = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch != " " {
                    if ch != "\t" {
                        keep = index + 1_usize
                    }
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    let mut out = ""
    index = 0_usize
    while index < keep {
        match value.get(index) {
            Option[str]::Some(ch) => {
                out += ch
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    ret out
}

fn ends_with_newline(value: str) -> bool {
    if value.char_len() == 0_usize {
        ret false
    }
    match value.get(value.char_len() - 1_usize) {
        Option[str]::Some(ch) => {
            ret ch == "\n"
        }
        Option[str]::None => {
            ret false
        }
    }
}

fn document_end_position(text: str) -> TextPosition {
    let mut line = 0_usize
    let mut character = 0_usize
    let mut index = 0_usize
    while index < text.char_len() {
        match text.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    line += 1_usize
                    character = 0_usize
                }
                else {
                    character += 1_usize
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    ret TextPosition {line, character}
}

fn code_actions_json(doc: Document) -> str {
    let mut out = "["
    let mut first = true
    for diagnostic in doc.analysis.diagnostics {
        if diagnostic.code == "unknown-token" {
            if !first {
                out += ","
            }
            out += remove_unknown_token_action_json(doc.uri, diagnostic)
            first = false
        }
    }
    out += "]"
    ret out
}

fn remove_unknown_token_action_json(uri: str, diagnostic: FrontendDiagnostic) -> str {
    let end_char = diagnostic.column + diagnostic.length
    let edit = "{\"changes\":{" + json_text(uri) + ":[{\"range\":" + range_json(diagnostic.line, diagnostic.column, diagnostic.line, end_char) + ",\"newText\":\"\"}]}}"
    ret "{\"title\":\"Remove unknown token\",\"kind\":\"quickfix\",\"diagnostics\":[" + diagnostic_json(diagnostic) + "],\"edit\":" + edit + "}"
}

fn find_symbol(analysis: FrontendDocument, name: str) -> Option[FrontendSymbol] {
    for symbol in analysis.symbols {
        if symbol.name == name {
            ret Option[FrontendSymbol]::Some(symbol)
        }
    }
    ret Option[FrontendSymbol]::None
}

fn find_symbol_workspace(workspace: Workspace, preferred: Document, name: str) -> Option[LocatedSymbol] {
    match find_symbol(preferred.analysis, name) {
        Option[FrontendSymbol]::Some(symbol) => {
            ret Option[LocatedSymbol]::Some(LocatedSymbol {preferred.uri, symbol})
        }
        Option[FrontendSymbol]::None => {}
    }
    for doc in workspace.documents {
        match find_symbol(doc.analysis, name) {
            Option[FrontendSymbol]::Some(symbol) => {
                ret Option[LocatedSymbol]::Some(LocatedSymbol {doc.uri, symbol})
            }
            Option[FrontendSymbol]::None => {}
        }
    }
    ret Option[LocatedSymbol]::None
}

fn find_symbol_at(analysis: FrontendDocument, line: usize, column: usize) -> Option[FrontendSymbol] {
    for symbol in analysis.symbols {
        if symbol.line == line {
            if symbol.column == column {
                ret Option[FrontendSymbol]::Some(symbol)
            }
        }
    }
    ret Option[FrontendSymbol]::None
}

fn location_json(uri: str, symbol: FrontendSymbol) -> str {
    ret "{\"uri\":" + json_text(uri) + ",\"range\":{\"start\":{\"line\":" + Debug::fmt(symbol.line) + ",\"character\":" + Debug::fmt(symbol.column) + "},\"end\":{\"line\":" + Debug::fmt(symbol.line) + ",\"character\":" + Debug::fmt(symbol.column + symbol.length) + "}}}"
}

fn workspace_symbols_json(workspace: Workspace, query: str) -> str {
    let mut out = "["
    let mut first = true
    for doc in workspace.documents {
        for symbol in doc.analysis.symbols {
            if symbol_matches_query(symbol, query) {
                if !first {
                    out += ","
                }
                out += "{\"name\":" + json_text(symbol.name) + ",\"kind\":" + Debug::fmt(symbol.kind) + ",\"location\":" + location_json(doc.uri, symbol) + "}"
                first = false
            }
        }
    }
    out += "]"
    ret out
}

fn workspace_diagnostics_json(workspace: Workspace) -> str {
    let mut out = "{\"items\":["
    let mut first = true
    for doc in workspace.documents {
        if !first {
            out += ","
        }
        out += "{\"uri\":" + json_text(doc.uri) + ",\"version\":null,\"kind\":\"full\",\"items\":" + diagnostics_array_json(doc.analysis) + "}"
        first = false
    }
    out += "]}"
    ret out
}

fn symbol_matches_query(symbol: FrontendSymbol, query: str) -> bool {
    if query.len() == 0_usize {
        ret true
    }
    ret contains_substring(symbol.name, query)
}

fn contains_substring(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if starts_at(value, needle, index) {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn handle_document_update(workspace: mut Workspace, message: Json, text: Option[str]) -> () {
    match json_text_document_uri(message) {
        Option[str]::Some(uri) => {
            match text {
                Option[str]::Some(document_text) => {
                    workspace.upsert(uri, document_text, true)
                    if document_text.len() > max_sync_index_bytes() {
                        write_message(publish_diagnostics(uri, FrontendDocument::empty()))
                        ret ()
                    }
                    workspace.index_project_for(uri)
                    match workspace.get(uri) {
                        Option[Document]::Some(doc) => {
                            write_message(publish_diagnostics(uri, doc.analysis))
                        }
                        Option[Document]::None => {}
                    }
                }
                Option[str]::None => {}
            }
        }
        Option[str]::None => {}
    }
    ret ()
}

fn handle_request(workspace: mut Workspace, id: str, method: str, message: Json) -> () {
    if method == "initialize" {
        write_message(response(id, initialize_result()))
        ret ()
    }
    if method == "shutdown" {
        workspace.shutdown = true
        write_message(response(id, "null"))
        ret ()
    }
    if method == "workspace/symbol" {
        match json_param_string(message, "query") {
            Option[str]::Some(query) => {
                write_message(response(id, workspace_symbols_json(workspace, query)))
            }
            Option[str]::None => {
                write_message(response(id, workspace_symbols_json(workspace, "")))
            }
        }
        ret ()
    }
    if method == "workspace/diagnostic" {
        write_message(response(id, workspace_diagnostics_json(workspace)))
        ret ()
    }
    if method == "textDocument/prepareCallHierarchy" {
        match json_text_document_uri(message) {
            Option[str]::Some(uri) => {
                match workspace.get(uri) {
                    Option[Document]::Some(doc) => {
                        write_message(response(id, prepare_call_hierarchy_json(workspace, doc, message)))
                    }
                    Option[Document]::None => {
                        write_message(response(id, "[]"))
                    }
                }
            }
            Option[str]::None => {
                write_message(response(id, "[]"))
            }
        }
        ret ()
    }
    if method == "callHierarchy/outgoingCalls" {
        write_message(response(id, outgoing_calls_json(workspace, message)))
        ret ()
    }
    if method == "callHierarchy/incomingCalls" {
        write_message(response(id, incoming_calls_json(workspace, message)))
        ret ()
    }
    if method == "textDocument/completion" {
        match json_text_document_uri(message) {
            Option[str]::Some(uri) => {
                match workspace.get(uri) {
                    Option[Document]::Some(doc) => {
                        write_message(response(id, completion_result_workspace(workspace, doc, message)))
                    }
                    Option[Document]::None => {
                        write_message(response(id, completion_result(FrontendDocument::empty(), message)))
                    }
                }
            }
            Option[str]::None => {
                write_message(response(id, completion_result(FrontendDocument::empty(), message)))
            }
        }
        ret ()
    }
    if method == "textDocument/signatureHelp" {
        match json_text_document_uri(message) {
            Option[str]::Some(uri) => {
                match workspace.get(uri) {
                    Option[Document]::Some(doc) => {
                        write_message(response(id, signature_help_workspace_json(workspace, doc, message)))
                    }
                    Option[Document]::None => {
                        write_message(response(id, "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"))
                    }
                }
            }
            Option[str]::None => {
                write_message(response(id, "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"))
            }
        }
        ret ()
    }
    if method == "textDocument/inlayHint" {
        match json_text_document_uri(message) {
            Option[str]::Some(uri) => {
                match workspace.get(uri) {
                    Option[Document]::Some(doc) => {
                        write_message(response(id, inlay_hints_for_request(workspace, doc, message)))
                    }
