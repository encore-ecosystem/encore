import core::fmt::Debug
import core::option::Option
import core::vec::Vec

extern fn encore_lsp_read_message() -> str
extern fn encore_lsp_write_message(body: str) -> i32
extern fn encore_lsp_log(value: str) -> i32

struct Document {
    uri: str
    text: str
}

struct Workspace {
    documents: Vec[Document]
    shutdown: bool
}

impl for Document {
    fn new(uri: str, text: str) -> Document {
        ret Document { uri, text }
    }
}

impl for Workspace {
    fn new() -> Workspace {
        ret Workspace { Vec[Document]::new(), false }
    }

    fn get(self: Workspace, uri: str) -> Option[Document] {
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        ret Option[Document]::Some(doc)
                    }
                }
                Option[Document]::None => {}
            }
            index += 1_usize
        }
        ret Option[Document]::None
    }

    fn upsert(self: mut Self, uri: str, text: str) -> () {
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        self.documents = self.documents.set(index, Document::new(uri, text))
                        ret ()
                    }
                }
                Option[Document]::None => {}
            }
            index += 1_usize
        }
        self.documents.push(Document::new(uri, text))
        ret ()
    }

    fn clear_doc(self: mut Self, uri: str) -> () {
        let mut next = Vec[Document]::new()
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri != uri {
                        next.push(doc)
                    }
                }
                Option[Document]::None => {}
            }
            index += 1_usize
        }
        self.documents = next
        ret ()
    }
}

fn read_message() -> str {
    unsafe {
        ret encore_lsp_read_message()
    }
}

fn write_message(body: str) -> i32 {
    unsafe {
        ret encore_lsp_write_message(body)
    }
}

fn log(message: str) -> i32 {
    unsafe {
        ret encore_lsp_log(message)
    }
}

fn is_space_byte(value: u8) -> bool {
    if value == 32_u8 { ret true }
    if value == 9_u8 { ret true }
    if value == 10_u8 { ret true }
    if value == 13_u8 { ret true }
    ret false
}

fn byte_to_str(value: u8) -> str {
    if value == 9_u8 { ret "\t" }
    if value == 10_u8 { ret "\n" }
    if value == 13_u8 { ret "\r" }
    if value == 32_u8 { ret " " }
    if value == 33_u8 { ret "!" }
    if value == 34_u8 { ret "\"" }
    if value == 35_u8 { ret "#" }
    if value == 36_u8 { ret "$" }
    if value == 37_u8 { ret "%" }
    if value == 38_u8 { ret "&" }
    if value == 39_u8 { ret "'" }
    if value == 40_u8 { ret "(" }
    if value == 41_u8 { ret ")" }
    if value == 42_u8 { ret "*" }
    if value == 43_u8 { ret "+" }
    if value == 44_u8 { ret "," }
    if value == 45_u8 { ret "-" }
    if value == 46_u8 { ret "." }
    if value == 47_u8 { ret "/" }
    if value == 48_u8 { ret "0" }
    if value == 49_u8 { ret "1" }
    if value == 50_u8 { ret "2" }
    if value == 51_u8 { ret "3" }
    if value == 52_u8 { ret "4" }
    if value == 53_u8 { ret "5" }
    if value == 54_u8 { ret "6" }
    if value == 55_u8 { ret "7" }
    if value == 56_u8 { ret "8" }
    if value == 57_u8 { ret "9" }
    if value == 58_u8 { ret ":" }
    if value == 59_u8 { ret ";" }
    if value == 60_u8 { ret "<" }
    if value == 61_u8 { ret "=" }
    if value == 62_u8 { ret ">" }
    if value == 63_u8 { ret "?" }
    if value == 64_u8 { ret "@" }
    if value == 65_u8 { ret "A" }
    if value == 66_u8 { ret "B" }
    if value == 67_u8 { ret "C" }
    if value == 68_u8 { ret "D" }
    if value == 69_u8 { ret "E" }
    if value == 70_u8 { ret "F" }
    if value == 71_u8 { ret "G" }
    if value == 72_u8 { ret "H" }
    if value == 73_u8 { ret "I" }
    if value == 74_u8 { ret "J" }
    if value == 75_u8 { ret "K" }
    if value == 76_u8 { ret "L" }
    if value == 77_u8 { ret "M" }
    if value == 78_u8 { ret "N" }
    if value == 79_u8 { ret "O" }
    if value == 80_u8 { ret "P" }
    if value == 81_u8 { ret "Q" }
    if value == 82_u8 { ret "R" }
    if value == 83_u8 { ret "S" }
    if value == 84_u8 { ret "T" }
    if value == 85_u8 { ret "U" }
    if value == 86_u8 { ret "V" }
    if value == 87_u8 { ret "W" }
    if value == 88_u8 { ret "X" }
    if value == 89_u8 { ret "Y" }
    if value == 90_u8 { ret "Z" }
    if value == 91_u8 { ret "[" }
    if value == 92_u8 { ret "\\" }
    if value == 93_u8 { ret "]" }
    if value == 94_u8 { ret "^" }
    if value == 95_u8 { ret "_" }
    if value == 96_u8 { ret "`" }
    if value == 97_u8 { ret "a" }
    if value == 98_u8 { ret "b" }
    if value == 99_u8 { ret "c" }
    if value == 100_u8 { ret "d" }
    if value == 101_u8 { ret "e" }
    if value == 102_u8 { ret "f" }
    if value == 103_u8 { ret "g" }
    if value == 104_u8 { ret "h" }
    if value == 105_u8 { ret "i" }
    if value == 106_u8 { ret "j" }
    if value == 107_u8 { ret "k" }
    if value == 108_u8 { ret "l" }
    if value == 109_u8 { ret "m" }
    if value == 110_u8 { ret "n" }
    if value == 111_u8 { ret "o" }
    if value == 112_u8 { ret "p" }
    if value == 113_u8 { ret "q" }
    if value == 114_u8 { ret "r" }
    if value == 115_u8 { ret "s" }
    if value == 116_u8 { ret "t" }
    if value == 117_u8 { ret "u" }
    if value == 118_u8 { ret "v" }
    if value == 119_u8 { ret "w" }
    if value == 120_u8 { ret "x" }
    if value == 121_u8 { ret "y" }
    if value == 122_u8 { ret "z" }
    if value == 123_u8 { ret "{" }
    if value == 124_u8 { ret "|" }
    if value == 125_u8 { ret "}" }
    if value == 126_u8 { ret "~" }
    ret "?"
}

fn starts_at(value: str, needle: str, offset: usize) -> bool {
    if offset + needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index < needle.len() {
        if value.byte_at(offset + index) != needle.byte_at(index) {
            ret false
        }
        index += 1_usize
    }
    ret true
}

fn find_from(value: str, needle: str, start: usize) -> Option[usize] {
    if needle.len() == 0_usize {
        ret Option[usize]::Some(start)
    }
    if needle.len() > value.len() {
        ret Option[usize]::None
    }
    let limit = value.len() - needle.len()
    let mut index = start
    while index <= limit {
        if starts_at(value, needle, index) {
            ret Option[usize]::Some(index)
        }
        index += 1_usize
    }
    ret Option[usize]::None
}

fn trim_left(value: str) -> str {
    let mut index = 0_usize
    while index < value.len() {
        if !is_space_byte(value.byte_at(index)) {
            ret value.slice_bytes(index, value.len() - index)
        }
        index += 1_usize
    }
    ret ""
}

fn skip_ws(value: str, index: usize) -> usize {
    let mut out = index
    while out < value.len() {
        if !is_space_byte(value.byte_at(out)) {
            ret out
        }
        out += 1_usize
    }
    ret out
}

fn json_escape(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let b = value.byte_at(index)
        if b == 34_u8 {
            out += "\\\""
        }
        elif b == 92_u8 {
            out += "\\\\"
        }
        elif b == 10_u8 {
            out += "\\n"
        }
        elif b == 13_u8 {
            out += "\\r"
        }
        elif b == 9_u8 {
            out += "\\t"
        }
        else {
            out += value.slice_bytes(index, 1_usize)
        }
        index += 1_usize
    }
    ret out
}

fn json_unescape(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let b = value.byte_at(index)
        if b == 92_u8 {
            if index + 1_usize >= value.len() {
                out += value.slice_bytes(index, 1_usize)
                index += 1_usize
                continue
            }
            let next = value.byte_at(index + 1_usize)
            if next == 110_u8 {
                out += "\n"
            }
            elif next == 114_u8 {
                out += "\r"
            }
            elif next == 116_u8 {
                out += "\t"
            }
            elif next == 34_u8 {
                out += "\""
            }
            elif next == 92_u8 {
                out += "\\"
            }
            else {
                out += value.slice_bytes(index + 1_usize, 1_usize)
            }
            index += 2_usize
        }
        else {
            out += value.slice_bytes(index, 1_usize)
            index += 1_usize
        }
    }
    ret out
}

fn extract_string_field(json: str, field: str) -> Option[str] {
    let key = "\"" + field + "\""
    match find_from(json, key, 0_usize) {
        Option[usize]::Some(key_pos) => {
            match find_from(json, ":", key_pos + key.len()) {
                Option[usize]::Some(colon_pos) => {
                    let mut start = skip_ws(json, colon_pos + 1_usize)
                    if start >= json.len() {
                        ret Option[str]::None
                    }
                    if json.byte_at(start) != 34_u8 {
                        ret Option[str]::None
                    }
                    start += 1_usize
                    let mut index = start
                    let mut escaped = false
                    while index < json.len() {
                        let b = json.byte_at(index)
                        if escaped {
                            escaped = false
                        }
                        elif b == 92_u8 {
                            escaped = true
                        }
                        elif b == 34_u8 {
                            ret Option[str]::Some(json_unescape(json.slice_bytes(start, index - start)))
                        }
                        index += 1_usize
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret Option[str]::None
}

fn extract_id(json: str) -> Option[str] {
    let key = "\"id\""
    match find_from(json, key, 0_usize) {
        Option[usize]::Some(key_pos) => {
            match find_from(json, ":", key_pos + key.len()) {
                Option[usize]::Some(colon_pos) => {
                    let start = skip_ws(json, colon_pos + 1_usize)
                    if start >= json.len() {
                        ret Option[str]::None
                    }
                    if json.byte_at(start) == 34_u8 {
                        match extract_string_field(json, "id") {
                            Option[str]::Some(value) => {
                                ret Option[str]::Some("\"" + json_escape(value) + "\"")
                            }
                            Option[str]::None => {}
                        }
                    }
                    let mut end = start
                    while end < json.len() {
                        let b = json.byte_at(end)
                        if b == 44_u8 {
                            ret Option[str]::Some(json.slice_bytes(start, end - start))
                        }
                        if b == 125_u8 {
                            ret Option[str]::Some(json.slice_bytes(start, end - start))
                        }
                        if is_space_byte(b) {
                            ret Option[str]::Some(json.slice_bytes(start, end - start))
                        }
                        end += 1_usize
                    }
                    ret Option[str]::Some(json.slice_bytes(start, json.len() - start))
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret Option[str]::None
}

fn response(id: str, result: str) -> str {
    ret "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}"
}

fn error_response(id: str, code: i32, message: str) -> str {
    ret "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + Debug::fmt(code) + ",\"message\":\"" + json_escape(message) + "\"}}"
}

fn notification(method: str, params: str) -> str {
    ret "{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"params\":" + params + "}"
}

fn initialize_result() -> str {
    ret "{\"serverInfo\":{\"name\":\"encore-lsp\",\"version\":\"0.1.0\"},\"capabilities\":{\"textDocumentSync\":1,\"documentSymbolProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\":\",\".\",\"_\"]},\"hoverProvider\":true,\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"keyword\",\"function\",\"type\",\"struct\",\"enum\",\"interface\",\"variable\",\"number\",\"string\",\"operator\",\"comment\"],\"tokenModifiers\":[\"declaration\",\"definition\"]},\"full\":true}}}"
}

fn completion_result() -> str {
    ret "{\"isIncomplete\":false,\"items\":[{\"label\":\"fn\",\"kind\":14,\"insertText\":\"fn name() -> u32 {\\n    ret 0_u32\\n}\"},{\"label\":\"struct\",\"kind\":14,\"insertText\":\"struct Name {\\n    value: u32\\n}\"},{\"label\":\"enum\",\"kind\":14,\"insertText\":\"enum Name {\\n    Variant\\n}\"},{\"label\":\"trait\",\"kind\":14,\"insertText\":\"trait Name {\\n    fn method(self: Self) -> u32\\n}\"},{\"label\":\"impl\",\"kind\":14,\"insertText\":\"impl for Name {\\n}\\n\"},{\"label\":\"match\",\"kind\":14,\"insertText\":\"match value {\\n    _ => {}\\n}\"},{\"label\":\"for\",\"kind\":14,\"insertText\":\"for item in items {\\n}\"},{\"label\":\"while\",\"kind\":14,\"insertText\":\"while condition {\\n}\"},{\"label\":\"ret\",\"kind\":14},{\"label\":\"let\",\"kind\":14},{\"label\":\"pub\",\"kind\":14},{\"label\":\"import\",\"kind\":14}]}"
}

fn hover_result() -> str {
    ret "{\"contents\":{\"kind\":\"markdown\",\"value\":\"Encore source file. The Encore LSP currently provides symbols, completions and basic syntax diagnostics.\"}}"
}

fn line_count(text: str) -> usize {
    let mut count = 1_usize
    let mut index = 0_usize
    while index < text.len() {
        if text.byte_at(index) == 10_u8 {
            count += 1_usize
        }
        index += 1_usize
    }
    ret count
}

fn line_at(text: str, target: usize) -> str {
    let mut line = 0_usize
    let mut start = 0_usize
    let mut index = 0_usize
    while index < text.len() {
        if text.byte_at(index) == 10_u8 {
            if line == target {
                ret text.slice_bytes(start, index - start)
            }
            line += 1_usize
            start = index + 1_usize
        }
        index += 1_usize
    }
    if line == target {
        ret text.slice_bytes(start, text.len() - start)
    }
    ret ""
}

fn read_identifier(value: str, start: usize) -> str {
    let mut index = start
    while index < value.len() {
        let b = value.byte_at(index)
        if b == 32_u8 { ret value.slice_bytes(start, index - start) }
        if b == 9_u8 { ret value.slice_bytes(start, index - start) }
        if b == 40_u8 { ret value.slice_bytes(start, index - start) }
        if b == 123_u8 { ret value.slice_bytes(start, index - start) }
        if b == 91_u8 { ret value.slice_bytes(start, index - start) }
        if b == 58_u8 {
            ret value.slice_bytes(start, index - start)
        }
        index += 1_usize
    }
    ret value.slice_bytes(start, value.len() - start)
}

fn symbol_name_from_line(line: str, prefix: str) -> str {
    let trimmed = trim_left(line)
    if starts_at(trimmed, "pub ", 0_usize) {
        ret symbol_name_from_line(trimmed.slice_bytes(4_usize, trimmed.len() - 4_usize), prefix)
    }
    if !starts_at(trimmed, prefix, 0_usize) {
        ret ""
    }
    let start = skip_ws(trimmed, prefix.len())
    ret read_identifier(trimmed, start)
}

fn line_symbol_kind(line: str) -> usize {
    let trimmed = trim_left(line)
    if starts_at(trimmed, "pub ", 0_usize) {
        ret line_symbol_kind(trimmed.slice_bytes(4_usize, trimmed.len() - 4_usize))
    }
    if starts_at(trimmed, "fn ", 0_usize) {
        ret 12_usize
    }
    if starts_at(trimmed, "struct ", 0_usize) {
        ret 23_usize
    }
    if starts_at(trimmed, "enum ", 0_usize) {
        ret 10_usize
    }
    if starts_at(trimmed, "trait ", 0_usize) {
        ret 11_usize
    }
    if starts_at(trimmed, "impl ", 0_usize) {
        ret 5_usize
    }
    ret 0_usize
}

fn line_symbol_name(line: str) -> str {
    let kind = line_symbol_kind(line)
    if kind == 12_usize {
        ret symbol_name_from_line(line, "fn ")
    }
    if kind == 23_usize {
        ret symbol_name_from_line(line, "struct ")
    }
    if kind == 10_usize {
        ret symbol_name_from_line(line, "enum ")
    }
    if kind == 11_usize {
        ret symbol_name_from_line(line, "trait ")
    }
    if kind == 5_usize {
        let trimmed = trim_left(line)
        if starts_at(trimmed, "impl for ", 0_usize) {
            ret "impl " + read_identifier(trimmed, 9_usize)
        }
        ret "impl " + read_identifier(trimmed, 5_usize)
    }
    ret ""
}

fn symbol_json(name: str, kind: usize, line: usize, chars: usize) -> str {
    let escaped = json_escape(name)
    let end_char = chars
    ret "{\"name\":\"" + escaped + "\",\"kind\":" + Debug::fmt(kind) + ",\"range\":{\"start\":{\"line\":" + Debug::fmt(line) + ",\"character\":0},\"end\":{\"line\":" + Debug::fmt(line) + ",\"character\":" + Debug::fmt(end_char) + "}},\"selectionRange\":{\"start\":{\"line\":" + Debug::fmt(line) + ",\"character\":0},\"end\":{\"line\":" + Debug::fmt(line) + ",\"character\":" + Debug::fmt(end_char) + "}}}"
}

fn document_symbols(text: str) -> str {
    let mut out = "["
    let mut first = true
    let mut line = 0_usize
    let total = line_count(text)
    while line < total {
        let value = line_at(text, line)
        let kind = line_symbol_kind(value)
        if kind != 0_usize {
            let name = line_symbol_name(value)
            if name.len() > 0_usize {
                if !first {
                    out += ","
                }
                out += symbol_json(name, kind, line, value.char_len())
                first = false
            }
        }
        line += 1_usize
    }
    out += "]"
    ret out
}

fn brace_diagnostics(uri: str, text: str) -> str {
    let mut balance = 0_i32
    let mut index = 0_usize
    while index < text.len() {
        let b = text.byte_at(index)
        if b == 123_u8 {
            balance += 1_i32
        }
        if b == 125_u8 {
            balance -= 1_i32
            if balance < 0_i32 {
                ret notification("textDocument/publishDiagnostics", "{\"uri\":\"" + json_escape(uri) + "\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"severity\":1,\"source\":\"encore-lsp\",\"message\":\"unmatched closing brace\"}]}")
            }
        }
        index += 1_usize
    }
    if balance > 0_i32 {
        ret notification("textDocument/publishDiagnostics", "{\"uri\":\"" + json_escape(uri) + "\",\"diagnostics\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"severity\":2,\"source\":\"encore-lsp\",\"message\":\"unmatched opening brace\"}]}")
    }
    ret notification("textDocument/publishDiagnostics", "{\"uri\":\"" + json_escape(uri) + "\",\"diagnostics\":[]}")
}

fn semantic_tokens_empty() -> str {
    ret "{\"data\":[]}"
}

fn handle_document_update(workspace: mut Workspace, message: str) -> () {
    match extract_string_field(message, "uri") {
        Option[str]::Some(uri) => {
            match extract_string_field(message, "text") {
                Option[str]::Some(text) => {
                    workspace.upsert(uri, text)
                    write_message(brace_diagnostics(uri, text))
                }
                Option[str]::None => {}
            }
        }
        Option[str]::None => {}
    }
    ret ()
}

fn handle_request(workspace: mut Workspace, id: str, method: str, message: str) -> () {
    if method == "initialize" {
        write_message(response(id, initialize_result()))
        ret ()
    }
    if method == "shutdown" {
        workspace.shutdown = true
        write_message(response(id, "null"))
        ret ()
    }
    if method == "textDocument/completion" {
        write_message(response(id, completion_result()))
        ret ()
    }
    if method == "textDocument/hover" {
        write_message(response(id, hover_result()))
        ret ()
    }
    if method == "textDocument/semanticTokens/full" {
        write_message(response(id, semantic_tokens_empty()))
        ret ()
    }
    if method == "textDocument/documentSymbol" {
        match extract_string_field(message, "uri") {
            Option[str]::Some(uri) => {
                match workspace.get(uri) {
                    Option[Document]::Some(doc) => {
                        write_message(response(id, document_symbols(doc.text)))
                    }
                    Option[Document]::None => {
                        write_message(response(id, "[]"))
                    }
                }
            }
            Option[str]::None => {
                write_message(response(id, "[]"))
            }
        }
        ret ()
    }
    write_message(error_response(id, -32601_i32, "Encore LSP method is not implemented: " + method))
    ret ()
}

fn handle_notification(workspace: mut Workspace, method: str, message: str) -> bool {
    if method == "initialized" {
        ret false
    }
    if method == "exit" {
        ret true
    }
    if method == "textDocument/didOpen" {
        handle_document_update(workspace, message)
        ret false
    }
    if method == "textDocument/didChange" {
        handle_document_update(workspace, message)
        ret false
    }
    if method == "textDocument/didClose" {
        match extract_string_field(message, "uri") {
            Option[str]::Some(uri) => {
                workspace.clear_doc(uri)
                write_message(notification("textDocument/publishDiagnostics", "{\"uri\":\"" + json_escape(uri) + "\",\"diagnostics\":[]}"))
            }
            Option[str]::None => {}
        }
        ret false
    }
    ret false
}

fn handle_message(workspace: mut Workspace, message: str) -> bool {
    match extract_string_field(message, "method") {
        Option[str]::Some(method) => {
            match extract_id(message) {
                Option[str]::Some(id) => {
                    handle_request(workspace, id, method, message)
                    ret false
                }
                Option[str]::None => {
                    ret handle_notification(workspace, method, message)
                }
            }
        }
        Option[str]::None => {
            log("encore-lsp: ignored message without method")
            ret false
        }
    }
}

fn main() -> u32 {
    log("encore-lsp: started")
    let mut workspace = Workspace::new()
    loop {
        let message = read_message()
        if message.len() == 0_usize {
            break
        }
        if handle_message(workspace, message) {
            break
        }
    }
    ret 0_u32
}
