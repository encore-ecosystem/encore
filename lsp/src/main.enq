}

fn handle_notification(workspace: mut Workspace, method: str, message: Json) -> bool {
    if method == "initialized" {
        ret false
    }
    if method == "exit" {
        ret true
    }
    if method == "textDocument/didOpen" {
        handle_document_update(workspace, message, json_did_open_text(message))
        ret false
    }
    if method == "textDocument/didChange" {
        handle_document_update(workspace, message, json_did_change_text(message))
        ret false
    }
    if method == "textDocument/didClose" {
        match json_text_document_uri(message) {
            Option[str]::Some(uri) => {
                workspace.clear_doc(uri)
                write_message(notification("textDocument/publishDiagnostics", "{\"uri\":" + json_text(uri) + ",\"diagnostics\":[]}"))
            }
            Option[str]::None => {}
        }
        ret false
    }
    ret false
}

fn handle_message(workspace: mut Workspace, message: str) -> bool {
    match parse(message) {
        Result[Json, ParseError]::Ok(root) => {
            match json_string_field(root, "method") {
                Option[str]::Some(method) => {
                    match root.get("id") {
                        Option[Json]::Some(id) => {
                            handle_request(workspace, json_id_text(id), method, root)
                            ret false
                        }
                        Option[Json]::None => {
                            ret handle_notification(workspace, method, root)
                        }
                    }
                }
                Option[str]::None => {
                    log("encore-lsp: ignored message without method")
                    ret false
                }
            }
        }
        Result[Json, ParseError]::Err(err) => {
            log("encore-lsp: invalid JSON message: " + Debug::fmt(err))
            ret false
        }
    }
}

fn main() -> u32 {
    log("encore-lsp: started")
    let mut workspace = Workspace::new()
    let mut i = 0
    loop {
        let message = read_message()
        if message.len() == 0_usize {
            break
        }
        if handle_message(workspace, message) {
            break
        }
        i += 1
        if i > 100000 {
            break
        }
    }
    ret 0_u32
}
