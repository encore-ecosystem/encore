import core::fmt::Debug
import core::io::eprintln
import core::io::print
import core::io::read_exact
import core::io::read_line
import core::io::stdin_fd
import core::option::Option
import core::os::cwd
import core::os::file_exists
import core::os::home_dir
import core::os::read_dir
import core::os::read_file
import core::result::Result
import core::vec::Vec
import encore::frontend::DependencyEdge
import encore::frontend::FrontendCallable
import encore::frontend::FrontendDiagnostic
import encore::frontend::FrontendDocument
import encore::frontend::FrontendSymbol
import encore::frontend::Token
import encore::frontend::TokenType
import encore::frontend::analyze_source_lightweight
import json::Json
import json::ParseError
import json::parse
import json::stringify

struct Document {
    uri: str
    text: str
    analysis: FrontendDocument
    callables: Vec[FrontendCallable]
    is_open: bool
}

struct Workspace {
    documents: Vec[Document]
    shutdown: bool
}

struct TextPosition {
    line: usize
    character: usize
}

struct ActiveCall {
    name: str
    active_parameter: usize
    line: usize
    column: usize
}

struct LocatedSymbol {
    uri: str
    symbol: FrontendSymbol
}

struct TokenSpan {
    start: usize
    end: usize
}

impl for Document {
    fn new(uri: str, text: str, is_open: bool) -> Document {
        if text.len() > max_sync_index_bytes() {
            ret Document { uri, text, FrontendDocument::empty(), Vec[FrontendCallable]::new(), is_open }
        }
        ret Document { uri, text, analyze_source_lightweight(text), collect_callable_index(text), is_open }
    }
}

fn max_sync_index_bytes() -> usize {
    ret 40000_usize
}

impl for Workspace {
    fn new() -> Workspace {
        ret Workspace { Vec[Document]::new(), false }
    }

    fn get(self: Workspace, uri: str) -> Option[Document] {
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        ret Option[Document]::Some(doc)
                    }
                }
                Option[Document]::None => {}
            }
            index += 1_usize
        }
        ret Option[Document]::None
    }

    fn upsert(self: mut Self, uri: str, text: str, is_open: bool) -> () {
        let mut index : usize = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        self.documents.set(index, Document::new(uri, text, is_open || doc.is_open))
                        ret ()
                    }
                }
                Option[Document]::None => {}
            }
            index += 1_usize
        }
        self.documents.push(Document::new(uri, text, is_open))
        ret ()
    }

    fn clear_doc(self: mut Self, uri: str) -> () {
        let mut index = 0_usize
        while index < self.documents.len() {
            match self.documents.get(index) {
                Option[Document]::Some(doc) => {
                    if doc.uri == uri {
                        self.documents.set(index, Document::new(doc.uri, doc.text, false))
                        ret ()
                    }
                }
                Option[Document]::None => {}
            }
            index += 1_usize
        }
        ret ()
    }

    fn index_project_for(self: mut Self, root_uri: str) -> () {
        match self.get(root_uri) {
            Option[Document]::Some(root_doc) => {
                if root_doc.analysis.tokens.len() == 0_usize {
                    ret ()
                }
                let root_path = uri_to_path(root_uri)
                let root_dir = dirname(root_path)
                let src_root = source_root_for_path(root_path)
                let mut indexed = 0_usize
                for edge in root_doc.analysis.dependencies.all() {
                    if indexed >= 24_usize {
                        break
                    }
                    match resolve_import_uri(edge.target, root_dir, src_root) {
                        Option[str]::Some(next_uri) => {
                            if !self.has_document(next_uri) {
                                let next_path = uri_to_path(next_uri)
                                if file_exists(next_path) {
                                    let text = read_file(next_path)
                                    self.upsert(next_uri, text, false)
                                    indexed += 1_usize
                                }
                            }
                        }
                        Option[str]::None => {}
                    }
                }
            }
            Option[Document]::None => {}
        }
        ret ()
    }

    fn has_document(self: Self, uri: str) -> bool {
        match self.get(uri) {
            Option[Document]::Some(doc) => {
                ret true
            }
            Option[Document]::None => {
                ret false
            }
        }
    }
}

fn read_message() -> str {
    let mut content_length = 0_usize
    loop {
        match read_line(stdin_fd()) {
            Option[str]::Some(header) => {
                if header_is_blank(header) {
                    break
                }
                if starts_at_ascii_ci(header, "Content-Length:", 0_usize) {
                    content_length = parse_usize(header, "Content-Length:".len())
                }
            }
            Option[str]::None => {
                ret ""
            }
        }
    }

    if content_length == 0_usize {
        ret ""
    }

    match read_exact(stdin_fd(), content_length) {
        Option[str]::Some(body) => {
            ret body
        }
        Option[str]::None => {
            ret ""
        }
    }
}

fn write_message(body: str) -> i32 {
    ret print("Content-Length: " + Debug::fmt(body.len()) + "\r\n\r\n" + body)
}

fn log(message: str) -> i32 {
    ret eprintln(message)
}

fn is_space_byte(value: u8) -> bool {
    if value == 32_u8 { ret true }
    if value == 9_u8 { ret true }
    if value == 10_u8 { ret true }
    if value == 13_u8 { ret true }
    ret false
}

fn starts_at(value: str, needle: str, offset: usize) -> bool {
    if offset + needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index < needle.len() {
        if value.byte_at(offset + index) != needle.byte_at(index) {
            ret false
        }
        index += 1_usize
    }
    ret true
}

fn ascii_lower_byte(value: u8) -> u8 {
    if value >= 65_u8 && value <= 90_u8 {
        ret value + 32_u8
    }
    ret value
}

fn starts_at_ascii_ci(value: str, needle: str, offset: usize) -> bool {
    if offset + needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index < needle.len() {
        if ascii_lower_byte(value.byte_at(offset + index)) != ascii_lower_byte(needle.byte_at(index)) {
            ret false
        }
        index += 1_usize
    }
    ret true
}

fn uri_to_path(uri: str) -> str {
    if starts_at(uri, "file://", 0_usize) {
        ret uri.slice("file://".len(), uri.char_len() - "file://".len())
    }
    ret uri
}

fn path_to_uri(path: str) -> str {
    ret "file://" + path
}

fn dirname(path: str) -> str {
    let mut last = 0_usize
    let mut found = false
    let mut index = 0_usize
    while index < path.char_len() {
        match path.get(index) {
            Option[str]::Some(ch) => {
                if ch == "/" {
                    last = index
                    found = true
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    if !found {
        ret "."
    }
    if last == 0_usize {
        ret "/"
    }
    ret path.slice(0_usize, last)
}

fn source_root_for_path(path: str) -> str {
    match find_substring(path, "/src/") {
        Option[usize]::Some(index) => {
            ret path.slice(0_usize, index + "/src".len())
        }
        Option[usize]::None => {
            ret dirname(path)
        }
    }
}

fn project_root_for_path(path: str) -> str {
    ret dirname(source_root_for_path(path))
}

fn find_substring(value: str, needle: str) -> Option[usize] {
    if needle.len() == 0_usize {
        ret Option[usize]::Some(0_usize)
    }
    if needle.len() > value.len() {
        ret Option[usize]::None
    }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if starts_at(value, needle, index) {
            ret Option[usize]::Some(index)
        }
        index += 1_usize
    }
    ret Option[usize]::None
}

fn contains_text(value: str, needle: str) -> bool {
    match find_substring(value, needle) {
        Option[usize]::Some(index) => {
            ret true
        }
        Option[usize]::None => {
            ret false
        }
    }
}

fn resolve_import_uri(target: str, current_dir: str, src_root: str) -> Option[str] {
    if target.len() == 0_usize {
        ret Option[str]::None
    }
    if contains_text(target, "{") {
        ret Option[str]::None
    }
    if contains_text(target, ",") {
        ret Option[str]::None
    }

    if starts_at(target, "mod::", 0_usize) {
        ret resolve_module_uri(current_dir, target.slice("mod::".len(), target.char_len() - "mod::".len()))
    }
    if starts_at(target, "refrain::", 0_usize) {
        ret resolve_module_uri(src_root, target.slice("refrain::".len(), target.char_len() - "refrain::".len()))
    }
    ret resolve_module_uri(src_root, target)
}

fn resolve_module_uri(base_dir: str, target: str) -> Option[str] {
    let mut path_part = scope_to_path(target)
    loop {
        if path_part.len() == 0_usize {
            ret Option[str]::None
        }
        let file_path = join_path(base_dir, path_part + ".enq")
        if file_exists(file_path) {
            ret Option[str]::Some(path_to_uri(file_path))
        }
        let mod_path = join_path(join_path(base_dir, path_part), "mod.enq")
        if file_exists(mod_path) {
            ret Option[str]::Some(path_to_uri(mod_path))
        }
        match parent_scope_path(path_part) {
            Option[str]::Some(parent) => {
                path_part = parent
            }
            Option[str]::None => {
                break
            }
        }
    }
    ret Option[str]::None
}

fn scope_to_path(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.char_len() {
        if starts_at(value, "::", index) {
            out += "/"
            index += 2_usize
        }
        else {
            match value.get(index) {
                Option[str]::Some(ch) => {
                    out += ch
                }
                Option[str]::None => {}
            }
            index += 1_usize
        }
    }
    ret out
}

fn parent_scope_path(path: str) -> Option[str] {
    let mut last = 0_usize
    let mut found = false
    let mut index = 0_usize
    while index < path.char_len() {
        match path.get(index) {
            Option[str]::Some(ch) => {
                if ch == "/" {
                    last = index
                    found = true
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    if !found {
        ret Option[str]::None
    }
    ret Option[str]::Some(path.slice(0_usize, last))
}

fn join_path(base: str, child: str) -> str {
    if child.len() == 0_usize {
        ret base
    }
    if starts_at(child, "/", 0_usize) {
        ret child
    }
    if base.len() == 0_usize {
        ret child
    }
    if ends_with(base, "/") {
        ret base + child
    }
    ret base + "/" + child
}

fn ends_with(value: str, suffix: str) -> bool {
    if suffix.len() > value.len() {
        ret false
    }
    ret starts_at(value, suffix, value.len() - suffix.len())
}

fn split_lines_lsp(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    out.push(value.slice(start, index - start))
                    start = index + 1_usize
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    if start < value.char_len() {
        out.push(value.slice(start, value.char_len() - start))
    }
    ret out
}

fn source_lines_window(text: str, start_line: usize, end_line: usize) -> str {
    let byte_len = text.len()
    let mut start_byte = 0_usize
    let mut end_byte = byte_len
    let mut line_no = 0_usize
    let mut index = 0_usize
    let mut found_start = start_line == 0_usize

    while index < byte_len {
        let byte = text.byte_at(index)
        if !found_start && line_no == start_line {
            start_byte = index
            found_start = true
        }
        if byte == 10_u8 {
            if !found_start && line_no + 1_usize == start_line {
                start_byte = index + 1_usize
                found_start = true
            }
            if found_start && line_no >= end_line {
                end_byte = index + 1_usize
                break
            }
            line_no += 1_usize
        }
        index += 1_usize
    }

    if !found_start {
        ret ""
    }
    if end_byte < start_byte {
        ret ""
    }
    ret text.slice_bytes(start_byte, end_byte - start_byte)
}

fn is_ascii_ws_byte(value: u8) -> bool {
    if value == 32_u8 { ret true }
    if value == 9_u8 { ret true }
    if value == 10_u8 { ret true }
    if value == 13_u8 { ret true }
    ret false
}

fn trim_ascii(value: str) -> str {
    if value.len() == 0_usize {
        ret value
    }
    let mut start = 0_usize
    let mut end = value.len()
    while start < end {
        if !is_ascii_ws_byte(value.byte_at(start)) {
            break
        }
        start += 1_usize
    }
    while end > start {
        if !is_ascii_ws_byte(value.byte_at(end - 1_usize)) {
            break
        }
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn toml_string_value(line: str, key: str) -> Option[str] {
    let prefix = key + " = "
    if !starts_at(line, prefix, 0_usize) {
        ret Option[str]::None
    }
    let raw = trim_ascii(line.slice(prefix.len(), line.len() - prefix.len()))
    if raw.len() >= 2_usize {
        if raw.byte_at(0_usize) == 34_u8 && raw.byte_at(raw.len() - 1_usize) == 34_u8 {
            ret Option[str]::Some(raw.slice(1_usize, raw.len() - 2_usize))
        }
    }
    ret Option[str]::Some(raw)
}

fn collect_callable_index(text: str) -> Vec[FrontendCallable] {
    let mut out = Vec[FrontendCallable]::new()
    let mut line_no = 0_usize
    let mut line_start = 0_usize
    let mut index = 0_usize
    let byte_len = text.len()
    while index < byte_len {
        if text.byte_at(index) == 10_u8 {
            append_callable_from_line(out, text.slice_bytes(line_start, index - line_start), line_no)
            line_start = index + 1_usize
            line_no += 1_usize
        }
        index += 1_usize
    }
    if line_start < byte_len {
        append_callable_from_line(out, text.slice_bytes(line_start, byte_len - line_start), line_no)
    }
    ret out
}

fn collect_inlay_callable_index(text: str, analysis: FrontendDocument) -> Vec[FrontendCallable] {
    let mut out = Vec[FrontendCallable]::new()
    let mut index = 0_usize
    while index < analysis.tokens.len() {
        match analysis.tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER {
                    if is_callable_invocation_candidate(analysis, index) {
                        match find_callable_in_list(out, token.value) {
                            Option[FrontendCallable]::Some(_) => {}
                            Option[FrontendCallable]::None => {
                                match find_callable_signature_in_text(text, token.value) {
                                    Option[FrontendCallable]::Some(callable) => {
                                        out.push(callable)
                                    }
                                    Option[FrontendCallable]::None => {}
                                }
                            }
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret out
}

fn find_callable_signature_in_text(text: str, name: str) -> Option[FrontendCallable] {
    let mut line_no = 0_usize
    let mut line_start = 0_usize
    let mut index = 0_usize
    let byte_len = text.len()
    while index < byte_len {
        if text.byte_at(index) == 10_u8 {
            match callable_from_signature_line(text.slice_bytes(line_start, index - line_start), line_no) {
                Option[FrontendCallable]::Some(callable) => {
                    if callable.name == name {
                        ret Option[FrontendCallable]::Some(callable)
                    }
                }
                Option[FrontendCallable]::None => {}
            }
            line_start = index + 1_usize
            line_no += 1_usize
        }
        index += 1_usize
    }
    if line_start < byte_len {
        match callable_from_signature_line(text.slice_bytes(line_start, byte_len - line_start), line_no) {
            Option[FrontendCallable]::Some(callable) => {
                if callable.name == name {
                    ret Option[FrontendCallable]::Some(callable)
                }
            }
            Option[FrontendCallable]::None => {}
        }
    }
    ret Option[FrontendCallable]::None
}

fn append_callable_from_line(out: mut Vec[FrontendCallable], raw_line: str, line_no: usize) -> () {
    match callable_from_signature_line(raw_line, line_no) {
        Option[FrontendCallable]::Some(callable) => {
            out.push(callable)
        }
        Option[FrontendCallable]::None => {}
    }
    ret ()
}

fn callable_from_signature_line(raw_line: str, line_no: usize) -> Option[FrontendCallable] {
    let line = trim_ascii(raw_line)
    match find_function_keyword(line) {
        Option[usize]::Some(fn_index) => {
            let name_start = skip_ascii_ws(line, fn_index + "fn".len())
            let name_end = scan_identifier_end(line, name_start)
            if name_end <= name_start {
                ret Option[FrontendCallable]::None
            }
            let name = line.slice(name_start, name_end - name_start)
            let params = collect_signature_param_names(line)
            let ret_type = collect_signature_return_type(line)
            ret Option[FrontendCallable]::Some(FrontendCallable::new(name, params, ret_type, line_no, name_start, name.char_len()))
        }
        Option[usize]::None => {}
    }
    ret Option[FrontendCallable]::None
}

fn find_function_keyword(line: str) -> Option[usize] {
    if starts_at(line, "fn ", 0_usize) {
        ret Option[usize]::Some(0_usize)
    }
    if starts_at(line, "pub fn ", 0_usize) {
        ret Option[usize]::Some("pub ".len())
    }
    if starts_at(line, "extern fn ", 0_usize) {
        ret Option[usize]::Some("extern ".len())
    }
    if starts_at(line, "pub extern fn ", 0_usize) {
        ret Option[usize]::Some("pub extern ".len())
    }
    ret Option[usize]::None
}

fn collect_signature_param_names(line: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    match find_substring(line, "(") {
        Option[usize]::Some(open) => {
            match find_substring_from(line, ")", open + 1_usize) {
                Option[usize]::Some(close) => {
                    let params = line.slice(open + 1_usize, close - open - 1_usize)
                    for raw_part in split_commas_lsp(params) {
                        let part = trim_ascii(raw_part)
                        if part.len() == 0_usize {
                            continue
                        }
                        if starts_at(part, "mut self", 0_usize) {
                            out.push("self")
                            continue
                        }
                        if starts_at(part, "self", 0_usize) {
                            out.push("self")
                            continue
                        }
                        match find_substring(part, ":") {
                            Option[usize]::Some(colon) => {
                                let name = trim_ascii(part.slice(0_usize, colon))
                                if name.len() > 0_usize {
                                    out.push(name)
                                }
                            }
                            Option[usize]::None => {}
                        }
                    }
                }
                Option[usize]::None => {}
            }
        }
        Option[usize]::None => {}
    }
    ret out
}

fn collect_signature_return_type(line: str) -> Option[str] {
    match find_substring(line, "->") {
        Option[usize]::Some(arrow) => {
            let mut end = line.char_len()
            match find_substring_from(line, "{", arrow + 2_usize) {
                Option[usize]::Some(brace) => {
                    end = brace
                }
                Option[usize]::None => {}
            }
            let typ = trim_ascii(line.slice(arrow + 2_usize, end - arrow - 2_usize))
            if typ.len() > 0_usize {
                ret Option[str]::Some(typ)
            }
        }
        Option[usize]::None => {}
    }
    ret Option[str]::None
}

fn split_commas_lsp(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut start = 0_usize
    let mut depth = 0_i32
    let mut index = 0_usize
    while index < value.char_len() {
        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch == "[" || ch == "(" {
                    depth += 1_i32
                }
                elif ch == "]" || ch == ")" {
                    depth -= 1_i32
                }
                elif ch == "," && depth == 0_i32 {
                    out.push(value.slice(start, index - start))
                    start = index + 1_usize
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    if start <= value.char_len() {
        out.push(value.slice(start, value.char_len() - start))
    }
    ret out
}

fn find_substring_from(value: str, needle: str, start: usize) -> Option[usize] {
    if needle.len() == 0_usize {
        ret Option[usize]::Some(start)
    }
    if needle.len() > value.len() {
        ret Option[usize]::None
    }
    let mut index = start
    while index + needle.len() <= value.len() {
        if starts_at(value, needle, index) {
            ret Option[usize]::Some(index)
        }
        index += 1_usize
    }
    ret Option[usize]::None
}

fn skip_ascii_ws(value: str, start: usize) -> usize {
    let mut index = start
    while index < value.len() {
        if !is_ascii_ws_byte(value.byte_at(index)) {
            break
        }
        index += 1_usize
    }
    ret index
}

fn scan_identifier_end(value: str, start: usize) -> usize {
    let mut index = start
    while index < value.len() {
        let byte = value.byte_at(index)
        if is_identifier_byte_lsp(byte) {
            index += 1_usize
            continue
        }
        break
    }
    ret index
}

fn is_identifier_byte_lsp(byte: u8) -> bool {
    if byte >= 65_u8 && byte <= 90_u8 {
        ret true
    }
    if byte >= 97_u8 && byte <= 122_u8 {
        ret true
    }
    if byte >= 48_u8 && byte <= 57_u8 {
        ret true
    }
    ret byte == 95_u8
}

fn header_is_blank(value: str) -> bool {
    ret value == "\n" || value == "\r\n" || value.len() == 0_usize
}

fn parse_usize(value: str, start: usize) -> usize {
    let mut out = 0_usize
    let mut index = start
    while index < value.len() {
        let b = value.byte_at(index)
        if is_space_byte(b) {
            index += 1_usize
            continue
        }
        if b < 48_u8 || b > 57_u8 {
            ret out
        }
        out = (out * 10_usize) + ((b as usize) - 48_usize)
        index += 1_usize
    }
    ret out
}

fn json_text(value: str) -> str {
    ret stringify(Json::String(value))
}

fn json_string_field(value: Json, name: str) -> Option[str] {
    match value.get(name) {
        Option[Json]::Some(field_value) => {
            ret field_value.as_str()
        }
        Option[Json]::None => {
            ret Option[str]::None
        }
    }
}

fn json_field(value: Json, name: str) -> Option[Json] {
    ret value.get(name)
}

fn json_id_text(value: Json) -> str {
    match value {
        Json::String(text) => {
            ret json_text(text)
        }
        Json::Number(text) => {
            ret text
        }
        Json::Null => {
            ret "null"
        }
        _ => {
            ret "null"
        }
    }
}

fn json_params(value: Json) -> Option[Json] {
    ret json_field(value, "params")
}

fn json_text_document(value: Json) -> Option[Json] {
    match json_params(value) {
        Option[Json]::Some(params) => {
            ret json_field(params, "textDocument")
        }
        Option[Json]::None => {
            ret Option[Json]::None
        }
    }
}

fn json_text_document_uri(value: Json) -> Option[str] {
