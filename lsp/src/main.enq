        Option[Json]::Some(text_document) => {
            ret json_string_field(text_document, "uri")
        }
        Option[Json]::None => {
            ret Option[str]::None
        }
    }
}

fn json_position_line(value: Json) -> Option[usize] {
    match json_params(value) {
        Option[Json]::Some(params) => {
            match json_field(params, "position") {
                Option[Json]::Some(position) => {
                    match json_field(position, "line") {
                        Option[Json]::Some(line) => {
                            ret json_usize(line)
                        }
                        Option[Json]::None => {
                            ret Option[usize]::None
                        }
                    }
                }
                Option[Json]::None => {
                    ret Option[usize]::None
                }
            }
        }
        Option[Json]::None => {
            ret Option[usize]::None
        }
    }
}

fn json_position_character(value: Json) -> Option[usize] {
    match json_params(value) {
        Option[Json]::Some(params) => {
            match json_field(params, "position") {
                Option[Json]::Some(position) => {
                    match json_field(position, "character") {
                        Option[Json]::Some(character) => {
                            ret json_usize(character)
                        }
                        Option[Json]::None => {
                            ret Option[usize]::None
                        }
                    }
                }
                Option[Json]::None => {
                    ret Option[usize]::None
                }
            }
        }
        Option[Json]::None => {
            ret Option[usize]::None
        }
    }
}

fn json_request_range_line(value: Json, boundary: str, fallback: usize) -> usize {
    match json_params(value) {
        Option[Json]::Some(params) => {
            match json_field(params, "range") {
                Option[Json]::Some(range) => {
                    match json_field(range, boundary) {
                        Option[Json]::Some(position) => {
                            match json_position_value_line(position) {
                                Option[usize]::Some(line) => {
                                    ret line
                                }
                                Option[usize]::None => {}
                            }
                        }
                        Option[Json]::None => {}
                    }
                }
                Option[Json]::None => {}
            }
        }
        Option[Json]::None => {}
    }
    ret fallback
}

fn json_usize(value: Json) -> Option[usize] {
    match value.as_number() {
        Option[str]::Some(text) => {
            ret Option[usize]::Some(parse_usize(text, 0_usize))
        }
        Option[str]::None => {
            ret Option[usize]::None
        }
    }
}

