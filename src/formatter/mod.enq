//! Formats Encore source from the shared lossless syntax stream.

import std::vec::Vec

import refrain::frontend::{FrontendDiagnostic, Lexer, SyntaxDocument, Token, TokenType, analyze_source_lightweight}
import refrain::frontend::parser::{Parser, SourceLayoutRole, SourceLayoutToken, Statement}

/// Controls deterministic Encore source formatting.
pub struct FormatConfig {
    indent_width: usize
    line_width: usize
    newline_style: str
    trailing_comma: str
    reorder_imports: bool
    format_docstrings: bool
}

/// Contains a transactional formatting result.
pub struct FormatResult {
    source: str
    changed: bool
    diagnostics: Vec[FrontendDiagnostic]
}

struct FormatState {
    document: FormatDocument
    has_output: bool
    depth: usize
    line_has_content: bool
    pending_breaks: usize
    pending_space: bool
    previous: TokenType
    has_previous: bool
    grouped_import_depth: usize
}

enum FormatElement {
    Text(str)
    Space
    Line(usize)
    Indent(usize)
}

/// A small document IR keeps layout decisions separate from rendering.
struct FormatDocument {
    elements: Vec[FormatElement]
}

impl for FormatConfig {
    /// Returns the stable default style.
    pub fn new() -> Self {
        ret Self {
            4_usize, 100_usize, "auto", "vertical", true, true
        }
    }

    pub fn with_indent_width(self: mut Self, value: usize) -> Self {
        self.indent_width = value ret self
    }
    pub fn with_line_width(self: mut Self, value: usize) -> Self {
        self.line_width = value ret self
    }
    pub fn with_newline_style(self: mut Self, value: str) -> Self {
        self.newline_style = value ret self
    }
    pub fn with_trailing_comma(self: mut Self, value: str) -> Self {
        self.trailing_comma = value ret self
    }
    pub fn with_reorder_imports(self: mut Self, value: bool) -> Self {
        self.reorder_imports = value ret self
    }
    pub fn with_format_docstrings(self: mut Self, value: bool) -> Self {
        self.format_docstrings = value ret self
    }

    pub fn indent(self: Self) -> usize {
        ret self.indent_width
    }
    pub fn width(self: Self) -> usize {
        ret self.line_width
    }
    pub fn newline(self: Self) -> str {
        ret self.newline_style
    }
    pub fn comma_style(self: Self) -> str {
        ret self.trailing_comma
    }
    pub fn imports_are_reordered(self: Self) -> bool {
        ret self.reorder_imports
    }
    pub fn docstrings_are_formatted(self: Self) -> bool {
        ret self.format_docstrings
    }
}

impl for FormatResult {
    /// Returns source to write when formatting succeeded.
    pub fn text(self: Self) -> str {
        ret self.source
    }

    /// Returns whether formatting changes the source.
    pub fn is_changed(self: Self) -> bool {
        ret self.changed
    }

    /// Returns diagnostics that prevented transactional formatting.
    pub fn errors(self: Self) -> Vec[FrontendDiagnostic] {
        ret self.diagnostics
    }

    /// Returns whether the source was valid enough to format safely.
    pub fn is_valid(self: Self) -> bool {
        ret self.diagnostics.len() == 0_usize
    }
}

impl for FormatState {
    pub fn new() -> Self {
        ret Self {
            FormatDocument::new(), false, 0_usize, false, 0_usize, false, TokenType::UNKNOWN, false,
            0_usize
        }
    }

    pub fn request_space(self: mut Self) ->() {
        if self.line_has_content && self.pending_breaks == 0_usize {
            self.pending_space = true
        }
        ret()
    }

    pub fn request_break(self: mut Self, count: usize) ->() {
        let requested = if count > 2_usize {
            2_usize
        } else {
            count
        }
        if requested > self.pending_breaks {
            self.pending_breaks = requested
        }
        self.pending_space = false
        ret()
    }

    fn flush_prefix(self: mut Self, config: FormatConfig) ->() {
        if self.pending_breaks > 0_usize {
            let mut count = self.pending_breaks
            if !self.line_has_content && !self.has_output {
                count = 0_usize
            }
            if count > 0_usize {
                self.document.push_line(count)
            }
            self.line_has_content = false
            self.pending_breaks = 0_usize
            self.pending_space = false
        }
        if !self.line_has_content {
            self.document.push_indent(self.depth * config.indent_width)
            self.line_has_content = true
        } elif self.pending_space {
            self.document.push_space()
        }
        self.pending_space = false
        ret()
    }

    pub fn write(self: mut Self, value: str, config: FormatConfig) ->() {
        self.flush_prefix(config)
        self.document.push_text(value)
        self.has_output = true
        ret()
    }

    pub fn trim_space(self: mut Self) ->() {
        self.pending_space = false
        ret()
    }

    pub fn remember(self: mut Self, typ: TokenType) ->() {
        self.previous = typ
        self.has_previous = true
        ret()
    }

    pub fn finish(self: mut Self, config: FormatConfig) -> str {
        self.pending_space = false
        self.pending_breaks = 0_usize
        if !self.has_output {
            ret ""
        }
        self.document.push_line(1_usize)
        ret self.document.render(config)
    }
}

impl for FormatDocument {
    pub fn new() -> Self {
        ret Self {
            Vec[FormatElement]::new()
        }
    }

    pub fn push_text(self: mut Self, value: str) ->() {
        self.elements.push(FormatElement::Text(value)) ret()
    }
    pub fn push_space(self: mut Self) ->() {
        self.elements.push(FormatElement::Space) ret()
    }
    pub fn push_line(self: mut Self, count: usize) ->() {
        self.elements.push(FormatElement::Line(count)) ret()
    }
    pub fn push_indent(self: mut Self, width: usize) ->() {
        if width > 0_usize {
            self.elements.push(FormatElement::Indent(width))
        }
        ret()
    }

    pub fn render(self: Self, config: FormatConfig) -> str {
        let mut out = ""
        let newline = if config.newline_style == "crlf" {
            "\r\n"
        } else {
            "\n"
        }
        let mut column = 0_usize
        let mut current_indent = 0_usize
        for element in self.elements {
            match element {
                FormatElement::Text(value) => {
                    out += value
                    column += value.char_len()
                }
                FormatElement::Space => {
                    // Only grammar-aware code may add Line elements. Wrapping
                    // an arbitrary space can split syntax such as a grouped
                    // import, which must remain on one logical line today.
                    out += " "
                    column += 1_usize
                }
                FormatElement::Line(count) => {
                    let mut remaining = count
                    while remaining > 0_usize {
                        out += newline remaining -= 1_usize
                    }
                    column = 0_usize
                }
                FormatElement::Indent(width) => {
                    current_indent = width
                    let mut remaining = width
                    while remaining > 0_usize {
                        out += " " remaining -= 1_usize column += 1_usize
                    }
                }
            }
        }
        ret out
    }
}

/// Formats valid source and leaves invalid source byte-for-byte unchanged.
pub fn format_source(source: str, config: FormatConfig) -> FormatResult {
    let syntax = SyntaxDocument::parse(source)
    let document = analyze_source_lightweight(source)
    ret format_syntax(syntax, document.diagnostics, config)
}

/// Formats a cached lossless syntax query using existing frontend diagnostics.
pub fn format_syntax(syntax: SyntaxDocument, diagnostics: Vec[FrontendDiagnostic], config: FormatConfig)
-> FormatResult {
    let source = syntax.text()
    let fatal = formatter_syntax_diagnostics(diagnostics)
    if !syntax.is_valid() || fatal.len() > 0_usize {
        ret FormatResult {
            source, false, fatal
        }
    }
    let mut effective = config
    if effective.newline_style == "auto" {
        // Keep default output reproducible across hosts and source checkout
        // settings. Projects that require CRLF opt in explicitly.
        effective.newline_style = "lf"
    }
    let working_source = if effective.reorder_imports {
        reorder_import_source(source)
    } else {
        source
    }
    let working_syntax = SyntaxDocument::parse(working_source)
    let mut layout_tokens = normalize_trailing_commas(working_syntax.lossless_tokens(), effective)
    let mut formatted = format_tokens(layout_tokens, effective, working_source)
    // Validate each render before lexing its output as the next pass's input.
    // Otherwise stabilization can replace the baseline and hide a token merge.
    if !same_significant_tokens(layout_tokens, SyntaxDocument::parse(formatted).lossless_tokens()) {
        ret formatter_invariant_result(source)
    }
    // A multiline grouped import becomes one logical line above. Reorder once
    // more on that canonical representation so the first formatter pass is
    // already a fixed point.
    if effective.reorder_imports {
        let canonical_imports = reorder_import_source(formatted)
        if canonical_imports != formatted {
            let canonical_syntax = SyntaxDocument::parse(canonical_imports)
            layout_tokens = normalize_trailing_commas(canonical_syntax.lossless_tokens(), effective)
            formatted = format_tokens(layout_tokens, effective, canonical_imports)
            if !same_significant_tokens(layout_tokens, SyntaxDocument::parse(formatted).lossless_tokens()) {
                ret formatter_invariant_result(source)
            }
        }
    }
    // Rendering may introduce a line break at the configured width, turning a
    // formerly horizontal argument list into a vertical one. Re-run trailing
    // comma normalization against that layout so a single public formatter
    // pass already reaches the same fixed point as the next pass.
    let stabilized_syntax = SyntaxDocument::parse(formatted)
    let stabilized_tokens = normalize_trailing_commas(stabilized_syntax.lossless_tokens(), effective)
    let stabilized = format_tokens(stabilized_tokens, effective, formatted)
    if stabilized != formatted {
        layout_tokens = stabilized_tokens
        formatted = stabilized
    }
    let formatted_syntax = SyntaxDocument::parse(formatted)
    if !same_significant_tokens(layout_tokens, formatted_syntax.lossless_tokens()) {
        ret formatter_invariant_result(source)
    }
    ret FormatResult {
        formatted, formatted != source, Vec[FrontendDiagnostic]::new()
    }
}

fn formatter_invariant_result(source: str) -> FormatResult {
    let mut diagnostics = Vec[FrontendDiagnostic]::new()
    diagnostics.push(FrontendDiagnostic::new(1, "formatter-invariant", "formatting changed the significant token stream", 0, 0, 1))
    ret FormatResult { source, false, diagnostics }
}

fn formatter_syntax_diagnostics(diagnostics: Vec[FrontendDiagnostic]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    for diagnostic in diagnostics {
        if diagnostic.code == "unknown-token" || starts_with(diagnostic.code, "unmatched-") || starts_with(diagnostic.code,
            "unclosed-",) {
            out.push(diagnostic)
        }
    }
    ret out
}

fn format_tokens(tokens: Vec[Token], config: FormatConfig, source: str) -> str {
    let mut state = FormatState::new()
    let mut source_breaks = 0_usize
    let layout = source_layout_tokens(source)
    let mut layout_index = 0_usize
    let mut token_index = 0_usize
    let mut previous_role = SourceLayoutRole::Ordinary
    let mut placement_is_generic = false
    let mut inline_braces = Vec[bool]::new()
    let mut interpolation_prefix = false

    for token in tokens {
        let current_index = token_index
        token_index += 1
        // The parser recognizes an identifier `f` followed by a string as one
        // interpolated expression. Keep the literal adjacent to its prefix,
        // including when repairing whitespace introduced by older formatters.
        let interpolation_literal = interpolation_prefix && token.type == TokenType::STRING
        if token.type != TokenType::WHITESPACE && token.type != TokenType::NEWLINE {
            interpolation_prefix = token.type == TokenType::IDENTIFIER && token.value == "f"
        }
        let mut role = SourceLayoutRole::Ordinary
        while layout_index < layout.len() {
            match layout.get(layout_index) {
                Some(position) => {
                    if position.line > token.line ||(position.line == token.line && position.column > token.column) {
                        break
                    }
                    layout_index += 1
                    if token.line == position.line && token.column == position.column {
                        role = position.role
                        break
                    }
                }
                None => {
                    break
                }
            }
        }
        if role == SourceLayoutRole::FieldStart || role == SourceLayoutRole::EnumVariantStart {
            state.request_break(1)
        } elif role == SourceLayoutRole::ImplStart {
            state.request_break(2)
        }
        let preceding_role = previous_role
        if !trivia(token.type) {
            previous_role = role
        }
        if role == SourceLayoutRole::PlacementOpen || role == SourceLayoutRole::PlacementName
        || role == SourceLayoutRole::PlacementClose || role == SourceLayoutRole::TypeSuffix {
            if role == SourceLayoutRole::PlacementOpen {
                placement_is_generic = state.has_previous && state.previous == TokenType::RIGHT_BRACKET
            }
            if token.type == TokenType::ASTERISK && state.has_previous && state.previous == TokenType::ASTERISK {
                // Two pointer suffix tokens must not become the power operator.
                state.request_space()
            } else {
                state.trim_space()
            }
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if role == SourceLayoutRole::TypePrefix {
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if preceding_role == SourceLayoutRole::TypePrefix && !trivia(token.type) {
            state.trim_space()
        }
        // EOF carries a cursor position, not printable source. Flushing pending
        // line breaks for its empty value would grow trailing blank lines.
        if token.type == TokenType::EOF {
            break
        }
        if token.type == TokenType::WHITESPACE {
            if state.grouped_import_depth == 0_usize || !state.has_previous
            || state.previous != TokenType::LEFT_BRACE {
                state.request_space()
            }
            continue
        }
        if token.type == TokenType::NEWLINE {
            source_breaks += 1_usize
            if state.grouped_import_depth > 0_usize {
                if !state.has_previous || state.previous != TokenType::LEFT_BRACE {
                    state.request_space()
                }
            } else {
                state.request_break(if source_breaks > 1_usize {
                        2_usize
                    } else {
                        1_usize
                    }
                )
            }
            continue
        }
        source_breaks = 0_usize

        if token.type == TokenType::ONE_LINE_COMMENT || token.type == TokenType::DOC_COMMENT || token.type
        == TokenType::MODULE_DOC_COMMENT {
            if state.line_has_content {
                state.request_space()
            }
            state.write(format_comment(token.value, token.type, config), config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::MULTI_LINE_COMMENT {
            if state.line_has_content {
                state.request_space()
            }
            state.write(token.value, config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::LEFT_BRACE {
            if state.has_previous && state.previous == TokenType::SCOPE {
                state.trim_space()
                state.write("{", config)
                state.grouped_import_depth += 1_usize
                state.remember(token.type)
                continue
            }
            let inline = role == SourceLayoutRole::ConstructorOpen && inline_constructor(tokens, current_index, config)
            inline_braces.push(inline)
            if inline && preceding_role == SourceLayoutRole::PlacementClose && !placement_is_generic {
                state.trim_space()
            } else {
                state.request_space()
            }
            state.write("{", config)
            if inline {
                state.request_space()
            } else {
                state.depth += 1_usize
                state.request_break(1_usize)
            }
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::RIGHT_BRACE {
            if state.grouped_import_depth > 0_usize {
                state.trim_space()
                state.write("}", config)
                state.grouped_import_depth -= 1_usize
                state.remember(token.type)
                continue
            }
            if inline_braces.pop().unwrap_or(false) {
                if state.previous == TokenType::LEFT_BRACE {
                    state.trim_space()
                } else {
                    state.request_space()
                }
                state.write("}", config)
                state.remember(token.type)
                continue
            }
            if state.depth > 0_usize {
                state.depth -= 1_usize
            }
            state.request_break(1_usize)
            state.write("}", config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::COMMA {
            state.trim_space()
            state.write(",", config)
            state.request_space()
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::COLON {
            state.trim_space()
            state.write(":", config)
            state.request_space()
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::SEMICOLON {
            state.trim_space()
            state.write(";", config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::DOT || token.type == TokenType::SCOPE {
            state.trim_space()
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::LEFT_PAREN || token.type == TokenType::LEFT_BRACKET {
            if state.has_previous && control_keyword(state.previous) {
                state.request_space()
            } else {
                state.trim_space()
            }
            state.write(token.value, config)
            state.depth += 1_usize
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::RIGHT_PAREN || token.type == TokenType::RIGHT_BRACKET {
            if state.depth > 0_usize {
                state.depth -= 1_usize
            }
            state.trim_space()
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::ASTERISK && state.has_previous && state.previous == TokenType::SCOPE {
            state.trim_space()
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if binary_operator(token.type) || token.type == TokenType::ARROW || token.type == TokenType::FAT_ARROW
        || token.type == TokenType::ASSIGN {
            state.request_space()
            state.write(token.value, config)
            state.request_space()
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::KW_ELSE || token.type == TokenType::KW_ELIF {
            if state.pending_breaks > 0_usize && state.has_previous && state.previous == TokenType::RIGHT_BRACE
            {
                state.pending_breaks = 0_usize
                state.request_space()
            }
        }
        if interpolation_literal {
            state.pending_breaks = 0_usize
            state.trim_space()
        } elif needs_implicit_space(state, token.type) {
            state.request_space()
        }
        state.write(token.value, config)
        state.remember(token.type)
    }
    ret state.finish(config)
}

// The compiler parser classifies punctuation: names and whitespace cannot tell
// type placement from comparison or a node handle from a bitwise operation.
fn source_layout_tokens(source: str) -> Vec[SourceLayoutToken] {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new().with_source_layout()
    let _report = parser.parse_recovering(lexer.tokenize(source))
    ret parser.source_layout_tokens()
}

// Keep short, single-line positional constructors inline. Nested braces,
// comments, or explicit newlines retain vertical layout instead of collapsing
// a block or detaching a comment. Each scan stops at the first nested brace.
fn inline_constructor(tokens: Vec[Token], opening: usize, config: FormatConfig) -> bool {
    let mut index = opening + 1
    while index < tokens.len() {
        match tokens.get(index) {
            Some(token) => {
                if token.type == TokenType::RIGHT_BRACE {
                    ret token.column + 1 <= config.line_width
                }
                if token.type == TokenType::LEFT_BRACE || token.type == TokenType::NEWLINE
                || comment_token(token.type) || token.type == TokenType::EOF {
                    ret false
                }
            }
            None => {
                ret false
            }
        }
        index += 1
    }
    ret false
}

fn normalize_trailing_commas(tokens: Vec[Token], config: FormatConfig) -> Vec[Token] {
    let mut out = Vec[Token]::new()
    let mut opens = Vec[TokenType]::new()
    let mut saw_comma = Vec[bool]::new()
    let mut saw_newline = Vec[bool]::new()
    let mut previous_significant = TokenType::UNKNOWN
    let mut index = 0_usize
    while index < tokens.len() {
        let token = tokens.get(index).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
        if token.type == TokenType::LEFT_PAREN || token.type == TokenType::LEFT_BRACKET || token.type == TokenType::LEFT_BRACE {
            opens.push(token.type)
            saw_comma.push(false)
            saw_newline.push(false)
        } elif token.type == TokenType::NEWLINE && opens.len() > 0_usize {
            saw_newline.set(opens.len() - 1_usize, true)
        } elif token.type == TokenType::COMMA && opens.len() > 0_usize &&
        opens.get(opens.len() - 1_usize).unwrap_or(TokenType::UNKNOWN) == TokenType::LEFT_PAREN {
            saw_comma.set(opens.len() - 1_usize, true)
            if config.trailing_comma == "never" && next_significant_is(tokens, index + 1_usize, TokenType::RIGHT_PAREN)
            {
                index += 1_usize
                continue
            }
        } elif token.type == TokenType::RIGHT_PAREN && opens.len() > 0_usize &&
        opens.get(opens.len() - 1_usize).unwrap_or(TokenType::UNKNOWN) == TokenType::LEFT_PAREN {
            let depth = opens.len() - 1_usize
            let list = saw_comma.get(depth).unwrap_or(false)
            let vertical = saw_newline.get(depth).unwrap_or(false)
            let should_add = config.trailing_comma == "always" ||(config.trailing_comma == "vertical"
                && vertical)
            if list && should_add && previous_significant != TokenType::COMMA {
                let mut trailing = Vec[Token]::new()
                while out.len() > 0_usize {
                    let last = out.get(out.len() - 1_usize).unwrap_or(Token::new(TokenType::UNKNOWN,
                            "", 0_usize, 0_usize,))
                    if !trivia(last.type) {
                        break
                    }
                    match out.pop() {
                        Option[Token]::Some(value) => {
                            trailing.push(value)
                        }
                        Option[Token]::None => {
                        }
                    }
                }
                out.push(Token::new(TokenType::COMMA, ",", token.line, token.column))
                while trailing.len() > 0_usize {
                    match trailing.pop() {
                        Option[Token]::Some(value) => {
                            out.push(value)
                        }
                        Option[Token]::None => {
                        }
                    }
                }
            }
            opens.pop()
            saw_comma.pop()
            saw_newline.pop()
        } elif (token.type == TokenType::RIGHT_BRACKET || token.type == TokenType::RIGHT_BRACE) && opens.len() > 0_usize {
            opens.pop() saw_comma.pop() saw_newline.pop()
        }
        out.push(token)
        if !trivia(token.type) {
            previous_significant = token.type
        }
        index += 1_usize
    }
    ret out
}

fn next_significant_is(tokens: Vec[Token], start: usize, expected: TokenType) -> bool {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if !trivia(token.type) {
                    ret token.type == expected
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn format_comment(value: str, typ: TokenType, config: FormatConfig) -> str {
    if !config.format_docstrings ||(typ != TokenType::DOC_COMMENT && typ != TokenType::MODULE_DOC_COMMENT)
    {
        ret value
    }
    if value.len() < 3_usize {
        ret value
    }
    let marker = value.slice(0_usize, 3_usize)
    let mut body = value.slice(3_usize, value.len() - 3_usize)
    while body.len() > 0_usize &&(body.slice(0_usize, 1_usize) == " " || body.slice(0_usize, 1_usize)
        == "\t") {
        body = body.slice(1_usize, body.len() - 1_usize)
    }
    if body == "" {
        ret marker
    }
    ret marker + " " + body
}

struct FormatImport {
    parent: str
    members: Vec[str]
    is_public: bool
}

fn sort_import_text(values: mut Vec[str]) ->() {
    let mut index = 1_usize
    while index < values.len() {
        let value = values.get(index).unwrap_or("")
        let mut at = index
        while at > 0_usize && text_less(value, values.get(at - 1_usize).unwrap_or("")) {
            values.set(at, values.get(at - 1_usize).unwrap_or(""))
            at -= 1_usize
        }
        values.set(at, value)
        index += 1_usize
    }
}
// Flatten only syntax, retaining every original path, alias and duplicate.
fn append_import_paths(path: str, paths: mut Vec[str]) ->() {
    let opening = path.find_from("::{", 0_usize)
    if opening == path.byte_len() {
        paths.push(path) ret()
    }
    let parent = path.slice_bytes(0_usize, opening)
    let mut start = opening + 3_usize
    let mut index = start
    let mut depth = 0_usize
    while index < path.byte_len() {
        let ch = path.slice_bytes(index, 1_usize)
        if (ch == "," || ch == "}") && depth == 0_usize {
            let item = trim_import_text(path.slice_bytes(start, index - start))
            if item != "" {
                append_import_paths(parent + "::" + item, paths)
            }
            start = index + 1_usize
            if ch == "}" {
                break
            }
        } elif ch == "{" {
            depth += 1_usize
        } elif ch == "}" {
            depth -= 1_usize
        }
        index += 1_usize
    }
}
fn trim_import_text(value: str) -> str {
    let trimmed = trim_left(value)
    let mut end = trimmed.char_len()
    while end > 0_usize &&(trimmed.slice(end - 1_usize, 1_usize) == " "
        || trimmed.slice(end - 1_usize, 1_usize) == "\t") {
        end -= 1_usize
    }
    ret trimmed.slice(0_usize, end)
}
fn import_group(path: str) -> usize {
    let scope = path.find_from("::", 0_usize)
    let alias = path.find_from(" as ", 0_usize)
    let end = if scope < alias {
        scope
    } else {
        alias
    }
    let root = path.slice_bytes(0_usize, end)
    if root == "core" {
        ret 0_usize
    }
    if root == "std" {
        ret 1_usize
    }
    if root == "mod" || root == "refrain" {
        ret 3_usize
    }
    ret 2_usize
}
fn import_text(record: FormatImport) -> str {
    let prefix = if record.is_public {
        "pub import "
    } else {
        "import "
    }
    let parent = if record.parent == "" {
        ""
    } else {
        record.parent + "::"
    }
    if record.members.len() == 1_usize {
        ret prefix + parent + record.members.get(0_usize).unwrap_or("")
    }
    let mut text = prefix + parent + "{"
    let mut index = 0_usize
    for member in record.members {
        if index > 0_usize {
            text += ", "
        }
        text += member
        index += 1_usize
    }
    ret text + "}"
}
fn import_key(record: FormatImport) -> str {
    let parent = if record.parent == "" {
        ""
    } else {
        record.parent + "::"
    }
    ret parent + record.members.get(0_usize).unwrap_or("")
}
fn organize_import_block(lines: Vec[str]) -> Vec[str] {
    let mut records = Vec[FormatImport]::new()
    for line in lines {
        let mut lexer = Lexer::new()
        let mut parser = Parser::new()
        let parsed = parser.parse_recovering(lexer.tokenize(line))
        if parsed.failures.len() > 0_usize {
            ret lines
        }
        for statement in parsed.statements {
            match statement {
                Statement::Import(item) => {
                    // Group-wide aliases and empty groups cannot be flattened
                    // into independent selections without changing syntax.
                    if item.path.contains("} as ") || item.path.contains("{}") {
                        ret lines
                    }

                    let mut paths = Vec[str]::new()
                    append_import_paths(item.path, paths)
                    for path in paths {
                        let mut separator = path.byte_len()
                        let mut index = 0_usize
                        // Alias identifiers never contain a scope separator.
                        while index + 1_usize < path.byte_len() {
                            if path.slice_bytes(index, 2_usize) == "::" {
                                separator = index
                            }
                            index += 1_usize
                        }
                        let parent = if separator == path.byte_len() {
                            ""
                        } else {
                            path.slice_bytes(0_usize, separator)
                        }
                        let member = if parent == "" {
                            path
                        } else {
                            path.slice_bytes(separator + 2_usize, path.byte_len() - separator - 2_usize)
                        }
                        let mut merged = false
                        if parent != "" && member != "*" {
                            for record in records {
                                if record.parent == parent && record.is_public == item.is_public
                                && record.members.get(0_usize).unwrap_or("") != "*" {
                                    let mut members = record.members
                                    members.push(member)
                                    merged = true break
                                }
                            }
                        }
                        if !merged {
                            let mut members = Vec[str]::new()
                            members.push(member)
                            records.push(FormatImport { parent, members, item.is_public })
                        }
                    }
                }
                _ => {
                }
            }
        }
    }
    for record in records {
        let mut members = record.members
        sort_import_text(members)
    }
    let mut index = 1_usize
    while index < records.len() {
        let record = records.get(index).unwrap_or(FormatImport { "", Vec[str]::new(), false })
        let group = import_group(import_key(record))
        let mut at = index
        while at > 0_usize {
            let previous = records.get(at - 1_usize).unwrap_or(record)
            let previous_group = import_group(import_key(previous))
            if group > previous_group ||(group == previous_group && !text_less(import_key(record), import_key(previous))) {
                break
            }
            records.set(at, previous)
            at -= 1_usize
        }
        records.set(at, record)
        index += 1_usize
    }
    let mut out = Vec[str]::new()
    let mut previous_group = 4_usize
    for record in records {
        let group = import_group(import_key(record))
        if previous_group != 4_usize && group != previous_group {
            out.push("")
        }
        out.push(import_text(record))
        previous_group = group
    }
    ret out
}
fn import_attachment(line: str) -> bool {
    let text = trim_left(line)
    ret starts_with(text, "//") || starts_with(text, "/*") || starts_with(text, "*")
    || starts_with(text, "#")
}
fn reorder_import_source(source: str) -> str {
    let lines = split_source_lines(source)
    let mut out = Vec[str]::new()
    let mut index = 0_usize
    while index < lines.len() {
        let line = lines.get(index).unwrap_or("")
        let attached = index > 0_usize && import_attachment(lines.get(index - 1_usize).unwrap_or(""))
        if !import_line(line) || attached {
            out.push(line) index += 1_usize continue
        }
        let mut block = Vec[str]::new()
        loop {
            block.push(lines.get(index).unwrap_or(""))
            index += 1_usize
            let mut next = index
            while next < lines.len() && trim_import_text(lines.get(next).unwrap_or("")) == "" {
                next += 1_usize
            }
            if next == lines.len() || !import_line(lines.get(next).unwrap_or("")) {
                break
            }
            index = next
        }
        out.extend(organize_import_block(block))
    }
    let mut text = ""
    index = 0_usize
    for line in out {
        if index > 0_usize {
            text += "\n"
        }
        text += line
        index += 1_usize
    }
    if source.byte_len() > 0_usize && source.slice_bytes(source.byte_len() - 1_usize, 1_usize) == "\n" {
        text += "\n"
    }
    ret text
}
fn split_source_lines(source: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut current = ""
    let mut index = 0_usize
    while index < source.len() {
        let ch = source.slice(index, 1_usize)
        if ch == "\n" {
            if current.len() > 0_usize && current.slice(current.len() - 1_usize, 1_usize) == "\r" {
                current = current.slice(0_usize, current.len() - 1_usize)
            }
            out.push(current)
            current = ""
        } else {
            current += ch
        }
        index += 1_usize
    }
    if current != "" {
        out.push(current)
    }
    ret out
}

fn import_line(line: str) -> bool {
    // Import reordering is a module-level operation. Indented text can be a
    // token inside a multiline grouped import (or a function body) and must
    // never be lifted or sorted as an independent declaration.
    if !starts_with(line, "import ") && !starts_with(line, "pub import ") {
        ret false
    }
    // The sorter moves complete records, never opening lines of grouped
    // imports. Layout compacts those groups first; the stabilization pass can
    // then sort their complete single-line declarations safely. Comments and
    // quoted fragments are barriers rather than guessed structural braces.
    if line.contains("//") || line.contains("/*") || line.contains("\"") || line.contains("'") {
        ret false
    }
    let mut depth = 0_usize
    for index in 0..line.len() {
        let character = line.slice(index, 1)
        if character == "{" {
            depth += 1
        } elif character == "}" {
            if depth == 0 {
                ret false
            }
            depth -= 1
        }
    }
    ret depth == 0
}

fn trim_left(value: str) -> str {
    let mut start = 0_usize
    while start < value.len() &&(value.slice(start, 1_usize) == " " || value.slice(start, 1_usize) ==
        "\t") {
        start += 1_usize
    }
    ret value.slice(start, value.len() - start)
}

fn text_less(left: str, right: str) -> bool {
    let limit = if left.byte_len() < right.byte_len() {
        left.byte_len()
    } else {
        right.byte_len()
    }
    let mut index = 0_usize
    while index < limit {
        let lhs = left.byte_at(index)
        let rhs = right.byte_at(index)
        if lhs < rhs {
            ret true
        }
        if lhs > rhs {
            ret false
        }
        index += 1_usize
    }
    ret left.byte_len() < right.byte_len()
}

fn same_significant_tokens(lhs: Vec[Token], rhs: Vec[Token]) -> bool {
    let mut left = 0_usize
    let mut right = 0_usize
    loop {
        while left < lhs.len() {
            match lhs.get(left) {
                Option[Token]::Some(token) => {
                    if !trivia(token.type) {
                        break
                    }
                }
                Option[Token]::None => {
                }
            }
            left += 1_usize
        }
        while right < rhs.len() {
            match rhs.get(right) {
                Option[Token]::Some(token) => {
                    if !trivia(token.type) {
                        break
                    }
                }
                Option[Token]::None => {
                }
            }
            right += 1_usize
        }
        if left >= lhs.len() || right >= rhs.len() {
            ret left >= lhs.len() && right >= rhs.len()
        }
        let left_token = lhs.get(left).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
        let right_token = rhs.get(right).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
        if left_token.type != right_token.type {
            ret false
        }
        if !comment_token(left_token.type) && left_token.value != right_token.value {
            ret false
        }
        left += 1_usize
        right += 1_usize
    }
    ret true
}

fn trivia(typ: TokenType) -> bool {
    ret typ == TokenType::WHITESPACE || typ == TokenType::NEWLINE
}

fn comment_token(typ: TokenType) -> bool {
    ret typ == TokenType::ONE_LINE_COMMENT || typ == TokenType::MULTI_LINE_COMMENT || typ == TokenType::DOC_COMMENT
    || typ == TokenType::MODULE_DOC_COMMENT
}

fn needs_implicit_space(state: FormatState, current: TokenType) -> bool {
    if !state.has_previous {
        ret false
    }
    if state.previous == TokenType::LEFT_PAREN || state.previous == TokenType::LEFT_BRACKET || state.previous
    == TokenType::DOT || state.previous == TokenType::SCOPE {
        ret false
    }
    if current == TokenType::LEFT_PAREN || current == TokenType::LEFT_BRACKET || current == TokenType::DOT
    || current == TokenType::SCOPE {
        ret false
    }
    if current == TokenType::COMMA || current == TokenType::COLON || current == TokenType::RIGHT_PAREN
    || current == TokenType::RIGHT_BRACKET {
        ret false
    }
    if state.previous == TokenType::BANG || state.previous == TokenType::HASH {
        ret false
    }
    if (state.previous == TokenType::INTEGER || state.previous == TokenType::FLOAT) && current == TokenType::IDENTIFIER
    {
        ret false
    }
    ret word_token(state.previous) && word_token(current)
}

fn word_token(typ: TokenType) -> bool {
    ret typ == TokenType::IDENTIFIER || typ == TokenType::INTEGER || typ == TokenType::FLOAT || typ ==
    TokenType::BOOLEAN || typ == TokenType::STRING || typ == TokenType::RIGHT_BRACE
    || keyword(typ) || typ == TokenType::RIGHT_PAREN || typ == TokenType::RIGHT_BRACKET
}

fn keyword(typ: TokenType) -> bool {
    ret typ == TokenType::KW_FN || typ == TokenType::KW_ASYNC || typ == TokenType::KW_AWAIT || typ ==
    TokenType::KW_SPAWN
    || typ == TokenType::KW_STRUCT || typ == TokenType::KW_TRAIT || typ == TokenType::KW_ENUM || typ
    == TokenType::KW_IMPL
    || typ == TokenType::KW_FOR || typ == TokenType::KW_LET || typ == TokenType::KW_MUT || typ == TokenType::KW_RET
    || typ == TokenType::KW_WHILE || typ == TokenType::KW_LOOP || typ == TokenType::KW_DO || typ == TokenType::KW_CONTINUE
    || typ == TokenType::KW_BREAK || typ == TokenType::KW_IF || typ == TokenType::KW_ELIF || typ == TokenType::KW_ELSE
    || typ == TokenType::KW_MATCH || typ == TokenType::KW_PUB || typ == TokenType::KW_IMPORT || typ ==
    TokenType::KW_AS
    || typ == TokenType::KW_DYN || typ == TokenType::KW_EXTERN || typ == TokenType::KW_UNSAFE || typ
    == TokenType::KW_EHIR
    || typ == TokenType::KW_WITH
}

fn control_keyword(typ: TokenType) -> bool {
    ret typ == TokenType::KW_IF || typ == TokenType::KW_ELIF || typ == TokenType::KW_WHILE || typ ==
    TokenType::KW_FOR || typ == TokenType::KW_MATCH
}

fn binary_operator(typ: TokenType) -> bool {
    ret typ == TokenType::PLUS || typ == TokenType::MINUS || typ == TokenType::ASTERISK || typ == TokenType::POWER
    || typ == TokenType::SLASH || typ == TokenType::PERCENT || typ == TokenType::EQUAL_EQUAL || typ ==
    TokenType::BANG_EQUAL
    || typ == TokenType::LESS || typ == TokenType::GREATER || typ == TokenType::LESS_EQUAL || typ ==
    TokenType::GREATER_EQUAL
    || typ == TokenType::AND_AND || typ == TokenType::PIPE_PIPE || typ == TokenType::AMPERSAND || typ
    == TokenType::PIPE
    || typ == TokenType::CARET || typ == TokenType::LEFT_SHIFT || typ == TokenType::RIGHT_SHIFT || typ
    == TokenType::PLUS_EQUAL
    || typ == TokenType::MINUS_EQUAL || typ == TokenType::ASTERISK_EQUAL || typ == TokenType::POWER_EQUAL
    || typ == TokenType::SLASH_EQUAL
    || typ == TokenType::PERCENT_EQUAL || typ == TokenType::AMPERSAND_EQUAL || typ == TokenType::PIPE_EQUAL
    || typ == TokenType::CARET_EQUAL
    || typ == TokenType::LEFT_SHIFT_EQUAL || typ == TokenType::RIGHT_SHIFT_EQUAL
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() {
        ret false
    }
    ret value.slice(0_usize, prefix.len()) == prefix
}
