//! Formats Encore source from the shared lossless syntax stream.

import std::vec::Vec

import refrain::frontend::{FrontendDiagnostic, SyntaxDocument, Token, TokenType, analyze_source_lightweight}

/// Controls deterministic Encore source formatting.
pub struct FormatConfig {
    indent_width: usize
    line_width: usize
    newline_style: str
    trailing_comma: str
    reorder_imports: bool
    format_docstrings: bool
}

/// Contains a transactional formatting result.
pub struct FormatResult {
    source: str
    changed: bool
    diagnostics: Vec[FrontendDiagnostic]
}

struct FormatState {
    document: FormatDocument
    has_output: bool
    depth: usize
    line_has_content: bool
    pending_breaks: usize
    pending_space: bool
    previous: TokenType
    has_previous: bool
}

enum FormatElement {
    Text(str)
    Space
    Line(usize)
    Indent(usize)
}

/// A small document IR keeps layout decisions separate from rendering.
struct FormatDocument {
    elements: Vec[FormatElement]
}

impl for FormatConfig {
    /// Returns the stable default style.
    pub fn new() -> Self { ret Self{4_usize, 100_usize, "auto", "vertical", true, true} }

    pub fn with_indent_width(self: mut Self, value: usize) -> Self { self.indent_width = value ret self }
    pub fn with_line_width(self: mut Self, value: usize) -> Self { self.line_width = value ret self }
    pub fn with_newline_style(self: mut Self, value: str) -> Self { self.newline_style = value ret self }
    pub fn with_trailing_comma(self: mut Self, value: str) -> Self { self.trailing_comma = value ret self }
    pub fn with_reorder_imports(self: mut Self, value: bool) -> Self { self.reorder_imports = value ret self }
    pub fn with_format_docstrings(self: mut Self, value: bool) -> Self { self.format_docstrings = value ret self }

    pub fn indent(self: Self) -> usize { ret self.indent_width }
    pub fn width(self: Self) -> usize { ret self.line_width }
    pub fn newline(self: Self) -> str { ret self.newline_style }
    pub fn comma_style(self: Self) -> str { ret self.trailing_comma }
    pub fn imports_are_reordered(self: Self) -> bool { ret self.reorder_imports }
    pub fn docstrings_are_formatted(self: Self) -> bool { ret self.format_docstrings }
}

impl for FormatResult {
    /// Returns source to write when formatting succeeded.
    pub fn text(self: Self) -> str { ret self.source }

    /// Returns whether formatting changes the source.
    pub fn is_changed(self: Self) -> bool { ret self.changed }

    /// Returns diagnostics that prevented transactional formatting.
    pub fn errors(self: Self) -> Vec[FrontendDiagnostic] { ret self.diagnostics }

    /// Returns whether the source was valid enough to format safely.
    pub fn is_valid(self: Self) -> bool { ret self.diagnostics.len() == 0_usize }
}

impl for FormatState {
    fn new() -> Self {
        ret Self{FormatDocument::new(), false, 0_usize, false, 0_usize, false, TokenType::UNKNOWN, false}
    }

    fn request_space(self: mut Self) -> () {
        if self.line_has_content && self.pending_breaks == 0_usize { self.pending_space = true }
        ret ()
    }

    fn request_break(self: mut Self, count: usize) -> () {
        let requested = if count > 2_usize { 2_usize } else { count }
        if requested > self.pending_breaks { self.pending_breaks = requested }
        self.pending_space = false
        ret ()
    }

    fn flush_prefix(self: mut Self, config: FormatConfig) -> () {
        if self.pending_breaks > 0_usize {
            let mut count = self.pending_breaks
            if !self.line_has_content && !self.has_output { count = 0_usize }
            if count > 0_usize { self.document.push_line(count) }
            self.line_has_content = false
            self.pending_breaks = 0_usize
            self.pending_space = false
        }
        if !self.line_has_content {
            self.document.push_indent(self.depth * config.indent_width)
            self.line_has_content = true
        } elif self.pending_space {
            self.document.push_space()
        }
        self.pending_space = false
        ret ()
    }

    fn write(self: mut Self, value: str, config: FormatConfig) -> () {
        self.flush_prefix(config)
        self.document.push_text(value)
        self.has_output = true
        ret ()
    }

    fn trim_space(self: mut Self) -> () {
        self.pending_space = false
        ret ()
    }

    fn remember(self: mut Self, typ: TokenType) -> () {
        self.previous = typ
        self.has_previous = true
        ret ()
    }

    fn finish(self: mut Self, config: FormatConfig) -> str {
        self.pending_space = false
        self.pending_breaks = 0_usize
        if !self.has_output { ret "" }
        self.document.push_line(1_usize)
        ret self.document.render(config)
    }
}

impl for FormatDocument {
    fn new() -> Self { ret Self{Vec[FormatElement]::new()} }

    fn push_text(self: mut Self, value: str) -> () { self.elements.push(FormatElement::Text(value)) ret () }
    fn push_space(self: mut Self) -> () { self.elements.push(FormatElement::Space) ret () }
    fn push_line(self: mut Self, count: usize) -> () { self.elements.push(FormatElement::Line(count)) ret () }
    fn push_indent(self: mut Self, width: usize) -> () {
        if width > 0_usize { self.elements.push(FormatElement::Indent(width)) }
        ret ()
    }

    fn render(self: Self, config: FormatConfig) -> str {
        let mut out = ""
        let newline = if config.newline_style == "crlf" { "\r\n" } else { "\n" }
        let mut column = 0_usize
        let mut current_indent = 0_usize
        for element in self.elements {
            match element {
                FormatElement::Text(value) => {
                    out += value
                    column += value.char_len()
                }
                FormatElement::Space => {
                    if column >= config.line_width {
                        out += newline
                        column = 0_usize
                        let mut remaining = current_indent
                        while remaining > 0_usize { out += " " remaining -= 1_usize column += 1_usize }
                    } else {
                        out += " "
                        column += 1_usize
                    }
                }
                FormatElement::Line(count) => {
                    let mut remaining = count
                    while remaining > 0_usize { out += newline remaining -= 1_usize }
                    column = 0_usize
                }
                FormatElement::Indent(width) => {
                    current_indent = width
                    let mut remaining = width
                    while remaining > 0_usize { out += " " remaining -= 1_usize column += 1_usize }
                }
            }
        }
        ret out
    }
}

/// Formats valid source and leaves invalid source byte-for-byte unchanged.
pub fn format_source(source: str, config: FormatConfig) -> FormatResult {
    let syntax = SyntaxDocument::parse(source)
    let document = analyze_source_lightweight(source)
    ret format_syntax(syntax, document.diagnostics, config)
}

/// Formats a cached lossless syntax query using existing frontend diagnostics.
pub fn format_syntax(syntax: SyntaxDocument, diagnostics: Vec[FrontendDiagnostic], config: FormatConfig) -> FormatResult {
    let source = syntax.text()
    let fatal = formatter_syntax_diagnostics(diagnostics)
    if !syntax.is_valid() || fatal.len() > 0_usize { ret FormatResult{source, false, fatal} }
    let mut effective = config
    if effective.newline_style == "auto" {
        // Keep default output reproducible across hosts and source checkout
        // settings. Projects that require CRLF opt in explicitly.
        effective.newline_style = "lf"
    }
    let working_source = if effective.reorder_imports { reorder_import_source(source) } else { source }
    let working_syntax = SyntaxDocument::parse(working_source)
    let layout_tokens = normalize_trailing_commas(working_syntax.lossless_tokens(), effective)
    let formatted = format_tokens(layout_tokens, effective)
    let formatted_syntax = SyntaxDocument::parse(formatted)
    if !same_significant_tokens(layout_tokens, formatted_syntax.lossless_tokens()) {
        let mut invariant = Vec[FrontendDiagnostic]::new()
        invariant.push(FrontendDiagnostic::new(1_usize, "formatter-invariant", "formatting changed the significant token stream", 0_usize, 0_usize, 1_usize))
        ret FormatResult{source, false, invariant}
    }
    ret FormatResult{formatted, formatted != source, Vec[FrontendDiagnostic]::new()}
}

fn formatter_syntax_diagnostics(diagnostics: Vec[FrontendDiagnostic]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    for diagnostic in diagnostics {
        if diagnostic.code == "unknown-token" || starts_with(diagnostic.code, "unmatched-") || starts_with(diagnostic.code, "unclosed-") {
            out.push(diagnostic)
        }
    }
    ret out
}

fn format_tokens(tokens: Vec[Token], config: FormatConfig) -> str {
    let mut state = FormatState::new()
    let mut source_breaks = 0_usize

    for token in tokens {
        if token.type == TokenType::WHITESPACE {
            state.request_space()
            continue
        }
        if token.type == TokenType::NEWLINE {
            source_breaks += 1_usize
            state.request_break(if source_breaks > 1_usize { 2_usize } else { 1_usize })
            continue
        }
        source_breaks = 0_usize

        if token.type == TokenType::ONE_LINE_COMMENT || token.type == TokenType::DOC_COMMENT || token.type == TokenType::MODULE_DOC_COMMENT {
            if state.line_has_content { state.request_space() }
            state.write(format_comment(token.value, token.type, config), config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::MULTI_LINE_COMMENT {
            if state.line_has_content { state.request_space() }
            state.write(token.value, config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::LEFT_BRACE {
            state.request_space()
            state.write("{", config)
            state.depth += 1_usize
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::RIGHT_BRACE {
            if state.depth > 0_usize { state.depth -= 1_usize }
            state.request_break(1_usize)
            state.write("}", config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::COMMA {
            state.trim_space()
            state.write(",", config)
            state.request_space()
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::COLON {
            state.trim_space()
            state.write(":", config)
            state.request_space()
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::SEMICOLON {
            state.trim_space()
            state.write(";", config)
            state.request_break(1_usize)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::DOT || token.type == TokenType::SCOPE {
            state.trim_space()
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::LEFT_PAREN || token.type == TokenType::LEFT_BRACKET {
            if state.has_previous && control_keyword(state.previous) { state.request_space() }
            else { state.trim_space() }
            state.write(token.value, config)
            state.depth += 1_usize
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::RIGHT_PAREN || token.type == TokenType::RIGHT_BRACKET {
            if state.depth > 0_usize { state.depth -= 1_usize }
            state.trim_space()
            state.write(token.value, config)
            state.remember(token.type)
            continue
        }
        if binary_operator(token.type) || token.type == TokenType::ARROW || token.type == TokenType::FAT_ARROW || token.type == TokenType::ASSIGN {
            state.request_space()
            state.write(token.value, config)
            state.request_space()
            state.remember(token.type)
            continue
        }
        if token.type == TokenType::KW_ELSE || token.type == TokenType::KW_ELIF {
            if state.pending_breaks > 0_usize && state.has_previous && state.previous == TokenType::RIGHT_BRACE {
                state.pending_breaks = 0_usize
                state.request_space()
            }
        }
        if needs_implicit_space(state, token.type) { state.request_space() }
        state.write(token.value, config)
        state.remember(token.type)
    }
    ret state.finish(config)
}

fn normalize_trailing_commas(tokens: Vec[Token], config: FormatConfig) -> Vec[Token] {
    let mut out = Vec[Token]::new()
    let mut opens = Vec[TokenType]::new()
    let mut saw_comma = Vec[bool]::new()
    let mut saw_newline = Vec[bool]::new()
    let mut previous_significant = TokenType::UNKNOWN
    let mut index = 0_usize
    while index < tokens.len() {
        let token = tokens.get(index).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
        if token.type == TokenType::LEFT_PAREN {
            opens.push(token.type)
            saw_comma.push(false)
            saw_newline.push(false)
        } elif token.type == TokenType::NEWLINE && opens.len() > 0_usize {
            saw_newline.set(opens.len() - 1_usize, true)
        } elif token.type == TokenType::COMMA && opens.len() > 0_usize {
            saw_comma.set(opens.len() - 1_usize, true)
            if config.trailing_comma == "never" && next_significant_is(tokens, index + 1_usize, TokenType::RIGHT_PAREN) {
                index += 1_usize
                continue
            }
        } elif token.type == TokenType::RIGHT_PAREN && opens.len() > 0_usize {
            let depth = opens.len() - 1_usize
            let list = saw_comma.get(depth).unwrap_or(false)
            let vertical = saw_newline.get(depth).unwrap_or(false)
            let should_add = config.trailing_comma == "always" || (config.trailing_comma == "vertical" && vertical)
            if list && should_add && previous_significant != TokenType::COMMA {
                let mut trailing = Vec[Token]::new()
                while out.len() > 0_usize {
                    let last = out.get(out.len() - 1_usize).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
                    if !trivia(last.type) { break }
                    match out.pop() { Option[Token]::Some(value) => { trailing.push(value) } Option[Token]::None => {} }
                }
                out.push(Token::new(TokenType::COMMA, ",", token.line, token.column))
                while trailing.len() > 0_usize {
                    match trailing.pop() { Option[Token]::Some(value) => { out.push(value) } Option[Token]::None => {} }
                }
            }
            opens.pop()
            saw_comma.pop()
            saw_newline.pop()
        }
        out.push(token)
        if !trivia(token.type) { previous_significant = token.type }
        index += 1_usize
    }
    ret out
}

fn next_significant_is(tokens: Vec[Token], start: usize, expected: TokenType) -> bool {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if !trivia(token.type) { ret token.type == expected }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret false
}

fn format_comment(value: str, typ: TokenType, config: FormatConfig) -> str {
    if !config.format_docstrings || (typ != TokenType::DOC_COMMENT && typ != TokenType::MODULE_DOC_COMMENT) { ret value }
    if value.len() < 3_usize { ret value }
    let marker = value.slice(0_usize, 3_usize)
    let mut body = value.slice(3_usize, value.len() - 3_usize)
    while body.len() > 0_usize && (body.slice(0_usize, 1_usize) == " " || body.slice(0_usize, 1_usize) == "\t") {
        body = body.slice(1_usize, body.len() - 1_usize)
    }
    if body == "" { ret marker }
    ret marker + " " + body
}

fn reorder_import_source(source: str) -> str {
    let mut lines = split_source_lines(source)
    let mut index = 0_usize
    while index < lines.len() {
        if !import_line(lines.get(index).unwrap_or("")) { index += 1_usize continue }
        let start = index
        while index < lines.len() && import_line(lines.get(index).unwrap_or("")) { index += 1_usize }
        let end = index
        let mut left = start + 1_usize
        while left < end {
            let value = lines.get(left).unwrap_or("")
            let mut cursor = left
            while cursor > start {
                let previous = lines.get(cursor - 1_usize).unwrap_or("")
                if !text_less(value, previous) { break }
                lines.set(cursor, previous)
                cursor -= 1_usize
            }
            lines.set(cursor, value)
            left += 1_usize
        }
    }
    let mut out = ""
    index = 0_usize
    while index < lines.len() {
        if index > 0_usize { out += "\n" }
        out += lines.get(index).unwrap_or("")
        index += 1_usize
    }
    if source.len() > 0_usize && (source.slice(source.len() - 1_usize, 1_usize) == "\n") { out += "\n" }
    ret out
}

fn split_source_lines(source: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut current = ""
    let mut index = 0_usize
    while index < source.len() {
        let ch = source.slice(index, 1_usize)
        if ch == "\n" {
            if current.len() > 0_usize && current.slice(current.len() - 1_usize, 1_usize) == "\r" { current = current.slice(0_usize, current.len() - 1_usize) }
            out.push(current)
            current = ""
        } else {
            current += ch
        }
        index += 1_usize
    }
    if current != "" { out.push(current) }
    ret out
}

fn import_line(line: str) -> bool {
    let trimmed = trim_left(line)
    ret starts_with(trimmed, "import ") || starts_with(trimmed, "pub import ")
}

fn trim_left(value: str) -> str {
    let mut start = 0_usize
    while start < value.len() && (value.slice(start, 1_usize) == " " || value.slice(start, 1_usize) == "\t") { start += 1_usize }
    ret value.slice(start, value.len() - start)
}

fn text_less(left: str, right: str) -> bool {
    let limit = if left.byte_len() < right.byte_len() { left.byte_len() } else { right.byte_len() }
    let mut index = 0_usize
    while index < limit {
        let lhs = left.byte_at(index)
        let rhs = right.byte_at(index)
        if lhs < rhs { ret true }
        if lhs > rhs { ret false }
        index += 1_usize
    }
    ret left.byte_len() < right.byte_len()
}

fn same_significant_tokens(lhs: Vec[Token], rhs: Vec[Token]) -> bool {
    let mut left = 0_usize
    let mut right = 0_usize
    loop {
        while left < lhs.len() {
            match lhs.get(left) {
                Option[Token]::Some(token) => {
                    if !trivia(token.type) { break }
                }
                Option[Token]::None => {}
            }
            left += 1_usize
        }
        while right < rhs.len() {
            match rhs.get(right) {
                Option[Token]::Some(token) => {
                    if !trivia(token.type) { break }
                }
                Option[Token]::None => {}
            }
            right += 1_usize
        }
        if left >= lhs.len() || right >= rhs.len() { ret left >= lhs.len() && right >= rhs.len() }
        let left_token = lhs.get(left).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
        let right_token = rhs.get(right).unwrap_or(Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize))
        if left_token.type != right_token.type { ret false }
        if !comment_token(left_token.type) && left_token.value != right_token.value { ret false }
        left += 1_usize
        right += 1_usize
    }
    ret true
}

fn trivia(typ: TokenType) -> bool {
    ret typ == TokenType::WHITESPACE || typ == TokenType::NEWLINE
}

fn comment_token(typ: TokenType) -> bool {
    ret typ == TokenType::ONE_LINE_COMMENT || typ == TokenType::MULTI_LINE_COMMENT || typ == TokenType::DOC_COMMENT || typ == TokenType::MODULE_DOC_COMMENT
}

fn needs_implicit_space(state: FormatState, current: TokenType) -> bool {
    if !state.has_previous { ret false }
    if state.previous == TokenType::LEFT_PAREN || state.previous == TokenType::LEFT_BRACKET || state.previous == TokenType::DOT || state.previous == TokenType::SCOPE { ret false }
    if current == TokenType::LEFT_PAREN || current == TokenType::LEFT_BRACKET || current == TokenType::DOT || current == TokenType::SCOPE { ret false }
    if current == TokenType::COMMA || current == TokenType::COLON || current == TokenType::RIGHT_PAREN || current == TokenType::RIGHT_BRACKET { ret false }
    if state.previous == TokenType::BANG || state.previous == TokenType::HASH { ret false }
    if (state.previous == TokenType::INTEGER || state.previous == TokenType::FLOAT) && current == TokenType::IDENTIFIER { ret false }
    ret word_token(state.previous) && word_token(current)
}

fn word_token(typ: TokenType) -> bool {
    ret typ == TokenType::IDENTIFIER || typ == TokenType::INTEGER || typ == TokenType::FLOAT || typ == TokenType::BOOLEAN || typ == TokenType::STRING
        || keyword(typ) || typ == TokenType::RIGHT_PAREN || typ == TokenType::RIGHT_BRACKET
}

fn keyword(typ: TokenType) -> bool {
    ret typ == TokenType::KW_FN || typ == TokenType::KW_ASYNC || typ == TokenType::KW_AWAIT || typ == TokenType::KW_SPAWN
        || typ == TokenType::KW_STRUCT || typ == TokenType::KW_TRAIT || typ == TokenType::KW_ENUM || typ == TokenType::KW_IMPL
        || typ == TokenType::KW_FOR || typ == TokenType::KW_LET || typ == TokenType::KW_MUT || typ == TokenType::KW_RET
        || typ == TokenType::KW_WHILE || typ == TokenType::KW_LOOP || typ == TokenType::KW_DO || typ == TokenType::KW_CONTINUE
        || typ == TokenType::KW_BREAK || typ == TokenType::KW_IF || typ == TokenType::KW_ELIF || typ == TokenType::KW_ELSE
        || typ == TokenType::KW_MATCH || typ == TokenType::KW_PUB || typ == TokenType::KW_IMPORT || typ == TokenType::KW_AS
        || typ == TokenType::KW_DYN || typ == TokenType::KW_EXTERN || typ == TokenType::KW_UNSAFE || typ == TokenType::KW_EHIR
        || typ == TokenType::KW_WITH
}

fn control_keyword(typ: TokenType) -> bool {
    ret typ == TokenType::KW_IF || typ == TokenType::KW_ELIF || typ == TokenType::KW_WHILE || typ == TokenType::KW_FOR || typ == TokenType::KW_MATCH
}

fn binary_operator(typ: TokenType) -> bool {
    ret typ == TokenType::PLUS || typ == TokenType::MINUS || typ == TokenType::ASTERISK || typ == TokenType::POWER
        || typ == TokenType::SLASH || typ == TokenType::PERCENT || typ == TokenType::EQUAL_EQUAL || typ == TokenType::BANG_EQUAL
        || typ == TokenType::LESS || typ == TokenType::GREATER || typ == TokenType::LESS_EQUAL || typ == TokenType::GREATER_EQUAL
        || typ == TokenType::AND_AND || typ == TokenType::PIPE_PIPE || typ == TokenType::AMPERSAND || typ == TokenType::PIPE
        || typ == TokenType::CARET || typ == TokenType::LEFT_SHIFT || typ == TokenType::RIGHT_SHIFT || typ == TokenType::PLUS_EQUAL
        || typ == TokenType::MINUS_EQUAL || typ == TokenType::ASTERISK_EQUAL || typ == TokenType::POWER_EQUAL || typ == TokenType::SLASH_EQUAL
        || typ == TokenType::PERCENT_EQUAL || typ == TokenType::AMPERSAND_EQUAL || typ == TokenType::PIPE_EQUAL || typ == TokenType::CARET_EQUAL
        || typ == TokenType::LEFT_SHIFT_EQUAL || typ == TokenType::RIGHT_SHIFT_EQUAL
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() { ret false }
    ret value.slice(0_usize, prefix.len()) == prefix
}
