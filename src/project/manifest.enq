//! Parses Encore project manifests.

import core::option::Option
import core::panic::panic
import core::result::Result

import std::io::eprintln
import std::os::{file_exists, read_file, write_file}
import std::path::Path
import std::process::exit
import std::vec::Vec

import toml::{TomlDocument, toml_get_bool, toml_get_string, toml_get_string_array, toml_parse_document, toml_section_keys}

import mod::failure::ProjectFailure
import refrain::target::{TargetSpec, Toolchain}

/// Describes a named feature and the features or dependencies it enables.
pub struct ProjectFeature {
    name: str
    members: Vec[str]
}

/// A typed service exported by a native plugin library.
pub struct ProjectPluginExport {
    name: str
    interface: str
    factory: str
    stateless: bool
    save_state: str
    restore_state: str
}

/// Contains normalized project metadata loaded from `encore.toml`.
pub struct ProjectManifest {
    name: str
    version: str
    description: str
    readme: str
    licence: str
    repository: str
    compiler_requirement: str
    dependencies: Vec[str]
    build: Option[str]
    target: str
    publish_include: Vec[str]
    publish_exclude: Vec[str]
    features: Vec[ProjectFeature]
    plugin_exports: Vec[ProjectPluginExport]
    original_source: str
}

/// Reads and validates `encore.toml` from a project root.
pub fn try_read_project_manifest(root: Path) -> Result[ProjectManifest, ProjectFailure] {
    let manifest_path = root.join("encore.toml")
    if !file_exists(native_path(manifest_path.as_str())) {
        try_panic_missing_manifest(manifest_path)?
    }

    let source = read_file(native_path(manifest_path.as_str()))
    ret try_parse_project_manifest(source, manifest_path)
}

/// Parses a coordinator-supplied manifest snapshot without reopening its
/// file or resolving dependencies in a compilation worker.
pub fn try_parse_project_manifest(source: str, manifest_path: Path) -> Result[ProjectManifest, ProjectFailure] {
    let doc = toml_parse_document(source)
    for key in toml_section_keys(doc, "registry") {
        if key == "index" && toml_get_string(doc, "registry", "index").is_none() {
            try_manifest_error("[registry].index must be a string in " + manifest_path.as_str())?
        }
    }
    let name = try_required_project_string(doc, "name", manifest_path)?
    for key in toml_section_keys(doc, "project") {
        if key == "binary-name" {
            let binary = toml_get_string(doc, "project", "binary-name").unwrap_or("")
            if binary.is_empty() || binary == "." || binary == ".." || binary.contains("/") || binary.contains("\\") {
                try_manifest_error("[project].binary-name must be a nonempty filename in " + manifest_path.as_str())?
            }
        }
    }
    let version = project_string_or(doc, "version", "0.0.0")
    let description = project_string_or(doc, "description", "")
    let readme = project_string_or(doc, "readme", "README.md")
    let licence = project_string_or(doc, "licence", "MIT")
    let repository = project_string_or(doc, "repository", "")
    let compiler_requirement = project_string_or(doc, "encore", "")
    let build = toml_get_string(doc, "project", "build")
    let target = project_string_or(doc, "target", "auto")
    let plugin_exports = try_parse_plugin_exports(doc, target, manifest_path)?
    let publish_include = target_array_setting(doc, "publish", "include", Vec[str]::new())
    let publish_exclude = target_array_setting(doc, "publish", "exclude", Vec[str]::new())
    let mut features = Vec[ProjectFeature]::new()
    for feature_name in toml_section_keys(doc, "features") {
        match toml_get_string_array(doc, "features", feature_name) {
            Some(members) => {
                features.push(ProjectFeature {
                        feature_name, members
                    }
                    ,
                )
            }
            None => {
                try_manifest_error("Feature '" + feature_name + "' must be a string array in " + manifest_path.as_str())?
            }
        }
    }

    let mut dependencies = Vec[str]::new()
    match toml_get_string_array(doc, "project", "dependencies") {
        Option[Vec[str]]::Some(items) => {
            dependencies = items
        }
        Option[Vec[str]]::None => {
        }
    }

    ret Result[ProjectManifest, ProjectFailure]::Ok(ProjectManifest {
            name,
            version,
            description,
            readme,
            licence,
            repository,
            compiler_requirement,
            dependencies,
            build,
            target,
            publish_include,
            publish_exclude,
            features,
            plugin_exports,
            source
        }
        ,)
}

fn try_plugin_string(doc: TomlDocument, section: str, key: str) -> Result[str, ProjectFailure] {
    match toml_get_string(doc, section, key) {
        Some(value) => {
            if value != "" {
                ret Result::Ok(value)
            }
        }
        None => {
        }
    }
    ret Result::Err(ProjectFailure {
            "manifest-plugin", "[" + section + "]." + key + " must be a nonempty string"
        }
    )
}

fn try_parse_plugin_exports(doc: TomlDocument, target: str, manifest_path: Path) -> Result[Vec[ProjectPluginExport], ProjectFailure] {
    let mut exports = Vec[ProjectPluginExport]::new()
    let prefix = "plugin.exports."
    for section in doc.sections {
        if section.name.byte_len() < prefix.byte_len() || section.name.slice_bytes(0, prefix.byte_len()) != prefix {
            if section.name == "plugin.exports" {
                ret Result::Err(ProjectFailure {
                        "manifest-plugin", "Use [plugin.exports.<name>] tables in " + manifest_path.as_str()
                    }
                )
            }
            continue
        }
        if target != "shared_lib" {
            ret Result::Err(ProjectFailure {
                    "manifest-plugin", "Plugin exports require project.target = \"shared_lib\""
                }
            )
        }
        let name = section.name.slice_bytes(prefix.byte_len(), section.name.byte_len() - prefix.byte_len())
        if name == "" || name.byte_len() > 128 || exports.len() >= 1024 {
            ret Result::Err(ProjectFailure { "manifest-plugin", "Invalid plugin export name" })
        }
        for previous in exports {
            if previous.name == name {
                ret Result::Err(ProjectFailure {
                        "manifest-plugin", "Duplicate plugin export: " + name
                    }
                )
            }
        }
        for entry in section.entries {
            if entry.key != "interface" && entry.key != "factory" && entry.key != "stateless" && entry.key != "save-state" && entry.key != "restore-state" {
                ret Result::Err(ProjectFailure {
                        "manifest-plugin", "Unknown plugin export setting: " + entry.key
                    }
                )
            }
            if entry.key == "save-state" || entry.key == "restore-state" {
                let _hook = try_plugin_string(doc, section.name, entry.key)?
            }
            if entry.key == "stateless" && toml_get_bool(doc, section.name, "stateless").is_none() {
                ret Result::Err(ProjectFailure {
                        "manifest-plugin", "Plugin stateless must be a boolean"
                    }
                )
            }
        }
        let interface = try_plugin_string(doc, section.name, "interface")?
        let factory = try_plugin_string(doc, section.name, "factory")?
        let stateless = target_bool_setting(doc, section.name, "stateless", false)
        let save = toml_get_string(doc, section.name, "save-state").unwrap_or("")
        let restore = toml_get_string(doc, section.name, "restore-state").unwrap_or("")
        if (stateless &&(save != "" || restore != "")) ||(!stateless &&(save == "" || restore == "")) {
            ret Result::Err(ProjectFailure {
                    "manifest-plugin", "Plugin export must declare stateless = true or both save-state and restore-state"
                }
            )
        }
        exports.push(ProjectPluginExport { name, interface, factory, stateless, save, restore })
    }
    ret Result::Ok(exports)
}

/// Returns the project package name.
pub fn project_manifest_name(manifest: ProjectManifest) -> str {
    ret manifest.name
}

/// The executable filename can differ from the dependency/import name.
pub fn project_manifest_binary_name(manifest: ProjectManifest) -> str {
    ret toml_get_string(toml_parse_document(manifest.original_source), "project", "binary-name").unwrap_or(manifest.name)
}

/// Returns the declared project version.
pub fn project_manifest_version(manifest: ProjectManifest) -> str {
    ret manifest.version
}
/// Returns the root project's optional registry override.
pub fn project_manifest_registry_index(manifest: ProjectManifest) -> str {
    match toml_get_string(toml_parse_document(manifest.original_source), "registry", "index") {
        Some(value) => {
            ret value
        }
        None => {
            ret ""
        }
    }
}
/// Returns the package source repository used for publication.
pub fn project_manifest_repository(manifest: ProjectManifest) -> str {
    ret manifest.repository
}
/// Returns the compiler SemVer requirement declared by the package.
pub fn project_manifest_compiler_requirement(manifest: ProjectManifest) -> str {
    ret manifest.compiler_requirement
}
/// Returns direct dependency references in manifest order.
pub fn project_manifest_dependencies(manifest: ProjectManifest) -> Vec[str] {
    let mut dependencies = Vec[str]::new()
    for dependency in manifest.dependencies {
        dependencies.push(dependency)
    }
    if manifest.name != "core" && !contains_string(dependencies, "sys@core") {
        dependencies.push("sys@core")
    }
    ret dependencies
}
/// Returns the configured architecture, not the legacy output-kind spelling.
/// Output kind and target architecture are independent; --target may select
/// an architecture for executable, static_lib and shared_lib projects alike.
pub fn project_manifest_target(manifest: ProjectManifest) -> str {
    if manifest.target == "executable" || manifest.target == "static_lib" || manifest.target == "shared_lib" {
        ret "auto"
    }
    ret manifest.target
}

/// Selects a project artifact without changing how dependencies are loaded.
/// A package containing both entrypoints remains an application when built
/// directly, and remains a library when another package depends on it.
pub fn project_build_kind(root: Path, manifest: ProjectManifest) -> str {
    if manifest.target == "executable" || manifest.target == "static_lib" || manifest.target == "shared_lib" {
        ret manifest.target
    }
    if file_exists(native_path(root.join("src/main.enq").as_str())) {
        ret "executable"
    }
    ret "static_lib"
}
/// Returns all declared feature definitions.
pub fn project_manifest_features(manifest: ProjectManifest) -> Vec[ProjectFeature] {
    ret manifest.features
}
/// Returns tracked paths explicitly included during publication.
pub fn project_manifest_publish_include(manifest: ProjectManifest) -> Vec[str] {
    ret manifest.publish_include
}
/// Returns tracked paths excluded during publication.
pub fn project_manifest_publish_exclude(manifest: ProjectManifest) -> Vec[str] {
    ret manifest.publish_exclude
}

/// Expands requested and default features into the enabled feature set.
pub fn try_project_manifest_resolve_features(manifest: ProjectManifest, requested: Vec[str]) -> Result[Vec[str], ProjectFailure] {
    let mut enabled = Vec[str]::new()
    let mut queue = feature_members(manifest.features, "default")
    for feature in requested {
        if !contains_string(queue, feature) {
            queue.push(feature)
        }
    }
    let mut index = 0_usize
    while index < queue.len() {
        match queue.get(index) {
            Some(feature) => {
                if !is_dependency_member(feature) && !contains_string(enabled, feature) {
                    if !has_feature(manifest.features, feature) {
                        try_manifest_error("Unknown feature '" + feature + "' for package " + manifest.name)?
                    }
                    enabled.push(feature)
                    for member in feature_members(manifest.features, feature) {
                        if !is_dependency_member(member) {
                            queue.push(member)
                        }
                    }
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret Result[Vec[str], ProjectFailure]::Ok(enabled)
}

/// Returns dependency members activated by enabled features.
pub fn project_manifest_feature_dependencies(manifest: ProjectManifest, enabled: Vec[str]) -> Vec[str] {
    let mut dependencies = Vec[str]::new()
    let mut queue = Vec[str]::new()
    for feature in enabled {
        queue.push(feature)
    }
    let mut index = 0_usize
    while index < queue.len() {
        match queue.get(index) {
            Some(feature) => {
                for member in feature_members(manifest.features, feature) {
                    if is_dependency_member(member) {
                        if !contains_string(dependencies, member) {
                            dependencies.push(member)
                        }
                    } elif !contains_string(queue, member) {
                        queue.push(member)
                    }
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret dependencies
}

/// Resolves target-specific toolchain settings over supplied defaults.
pub fn project_target_toolchain(root: Path, target: TargetSpec, defaults: Toolchain) -> Toolchain {
    let source = read_file(native_path(root.join("encore.toml").as_str()))
    let doc = toml_parse_document(source)
    let section = "target." + target.triple
    ret Toolchain {
        target_setting(doc, section, "driver", target_setting(doc, "target", "driver", defaults.driver)),
        target_setting(doc, section, "cc", target_setting(doc, "target", "cc", defaults.compiler)),
        target_setting(doc, section, "linker", target_setting(doc, "target", "linker", defaults.linker)),
        target_setting(doc, section, "ar", target_setting(doc, "target", "ar", defaults.archiver)),
        target_setting(doc, section, "sysroot", target_setting(doc, "target", "sysroot", defaults.sysroot)),
        target_setting(doc, section, "cpu", target_setting(doc, "target", "cpu", defaults.cpu)),
        target_setting(doc, section, "features", target_setting(doc, "target", "features", defaults.features)),
        target_array_setting(doc, section, "compile-args", target_array_setting(doc, "target", "compile-args", defaults.compile_args)),
        target_array_setting(doc, section, "link-args", target_array_setting(doc, "target", "link-args", defaults.link_args)),
        target_array_setting(doc, section, "runtime-sources", target_array_setting(doc, "target", "runtime-sources", defaults.runtime_sources)),
        target_setting(doc, section, "linker-script", target_setting(doc, "target", "linker-script", defaults.linker_script)),
        target_bool_setting(doc, section, "builtin-runtime", target_bool_setting(doc, "target", "builtin-runtime", defaults.hosted_runtime))
    }
}

/// Returns whether the manifest contains an exact dependency reference.
pub fn project_manifest_has_dependency(manifest: ProjectManifest, dependency: str) -> bool {
    ret contains_string(manifest.dependencies, dependency)
}

/// Adds a dependency unless the exact reference is already present.
pub fn project_manifest_add_dependency(manifest: mut ProjectManifest, dependency: str) ->() {
    if !contains_string(manifest.dependencies, dependency) {
        manifest.dependencies.push(dependency)
    }
    ret()
}

/// Serializes the normalized manifest back to `encore.toml`.
pub fn write_project_manifest(root: Path, manifest: ProjectManifest) -> i32 {
    if manifest.original_source != "" {
        let updated = replace_project_dependencies(manifest.original_source, dependency_array(manifest.dependencies))
        ret write_file(native_path(root.join("encore.toml").as_str()), updated)
    }
    let mut source = "[project]\n"
    source = source + "name = \"" + toml_escape(manifest.name) + "\"\n"
    source = source + "version = \"" + toml_escape(manifest.version) + "\"\n"
    source = source + "description = \"" + toml_escape(manifest.description) + "\"\n"
    source = source + "readme = \"" + toml_escape(manifest.readme) + "\"\n"
    source = source + "licence = \"" + toml_escape(manifest.licence) + "\"\n"
    if manifest.repository != "" {
        source = source + "repository = \"" + toml_escape(manifest.repository) + "\"\n"
    }
    if manifest.compiler_requirement != "" {
        source = source + "encore = \"" + toml_escape(manifest.compiler_requirement) + "\"\n"
    }
    source = source + "target = \"" + toml_escape(manifest.target) + "\"\n"
    source += "dependencies = " + dependency_array(manifest.dependencies) + "\n"
    match manifest.build {
        Some(command) => {
            source = source + "build = \"" + toml_escape(command) + "\"\n"
        }
        None => {
        }
    }
    if manifest.features.len() > 0_usize {
        source = source + "\n[features]\n"
        for feature in manifest.features {
            source = source + feature.name + " = " + string_array(feature.members) + "\n"
        }
    }
    if manifest.publish_include.len() > 0_usize || manifest.publish_exclude.len() > 0_usize {
        source += "\n[publish]\n"
        source += "include = " + string_array(manifest.publish_include) + "\n"
        source += "exclude = " + string_array(manifest.publish_exclude) + "\n"
    }
    ret write_file(native_path(root.join("encore.toml").as_str()), source)
}

fn replace_project_dependencies(source: str, dependencies: str) -> str {
    let lines = manifest_lines(source)
    let mut out = ""
    let mut in_project = false
    let mut wrote = false
    let mut skipping_array = false
    for line in lines {
        let trimmed = trim_manifest_line(line)
        if skipping_array {
            if dependency_array_ends(trimmed) {
                skipping_array = false
            }
            continue
        }
        if starts_with_text(trimmed, "[") {
            if in_project && !wrote {
                out += "dependencies = " + dependencies + "\n"
                wrote = true
            }
            in_project = trimmed == "[project]"
        }
        if in_project && starts_with_text(trimmed, "dependencies") {
            out += "dependencies = " + dependencies + "\n"
            wrote = true
            if !dependency_array_ends(trimmed) {
                skipping_array = true
            }
            continue
        }
        out += line + "\n"
    }
    if in_project && !wrote {
        out += "dependencies = " + dependencies + "\n"
    }
    ret out
}

/// Returns the original manifest source with a normalized dependency array.
pub fn project_manifest_source_with_dependencies(manifest: ProjectManifest, dependencies: Vec[str]) -> str {
    ret replace_project_dependencies(manifest.original_source, dependency_array(dependencies))
}

// Feature selectors and quoted paths can contain brackets. Only an unquoted
// closing bracket before a comment ends the dependency array.
fn dependency_array_ends(line: str) -> bool {
    let mut quote = ""
    let mut escaped = false
    let mut index = 0_usize
    while index < line.len() {
        let ch = line.slice(index, 1_usize)
        if quote != "" {
            if escaped {
                escaped = false
            } elif quote == "\"" && ch == "\\" {
                escaped = true
            } elif ch == quote {
                quote = ""
            }
        } elif ch == "#" {
            ret false
        } elif ch == "\"" || ch == "'" {
            quote = ch
        } elif ch == "]" {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn dependency_array(values: Vec[str]) -> str {
    if values.len() == 0_usize {
        ret "[]"
    }
    let mut out = "[\n"
    for value in values {
        out += "    \"" + toml_escape(value) + "\",\n"
    }
    ret out + "]"
}

fn manifest_lines(source: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut line = ""
    let mut index = 0_usize
    while index < source.len() {
        let ch = source.slice(index, 1_usize)
        if ch == "\n" {
            if line.len() > 0_usize && line.slice(line.len() - 1_usize, 1_usize) == "\r" {
                line = line.slice(0_usize, line.len() - 1_usize)
            }
            out.push(line)
            line = ""
        } else {
            line += ch
        }
        index += 1_usize
    }
    if line != "" {
        out.push(line)
    }
    ret out
}

fn trim_manifest_line(value: str) -> str {
    let mut start = 0_usize
    let mut end = value.len()
    while start < end &&(value.slice(start, 1_usize) == " " || value.slice(start, 1_usize) == "\t") {
        start += 1_usize
    }
    while end > start &&(value.slice(end - 1_usize, 1_usize) == " " || value.slice(end - 1_usize, 1_usize) == "\t") {
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn contains_manifest_text(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn try_implicit_core_does_not_mutate_manifest_dependencies() -> Result[bool, ProjectFailure] {
    let manifest = try_read_project_manifest(Path::new("."))?
    let declared = manifest.dependencies.len()
    let first = project_manifest_dependencies(manifest)
    let second = project_manifest_dependencies(manifest)
    if manifest.dependencies.len() != declared {
        ret Result[bool, ProjectFailure]::Ok(false)
    }
    if contains_string(manifest.dependencies, "sys@core") {
        ret Result[bool, ProjectFailure]::Ok(first.len() == declared && second.len() == declared)
    }
    ret Result[bool, ProjectFailure]::Ok(contains_string(first, "sys@core")
        && contains_string(second, "sys@core")
        && first.len() == declared + 1_usize
        && second.len() == first.len())
}

#attr(test)
fn manifest_dependency_update_preserves_tooling_sections() -> bool {
    let source = "[project]\nname = \"sample\"\ndependencies = [\n  \"path@one\",\n]\n\n[lint.rules]\nunused-imports = \"deny\"\n\n[format]\nindent-width = 2\n"
    let updated = replace_project_dependencies(source, "[\"path@one\", \"path@two\"]")
    ret contains_manifest_text(updated, "dependencies = [\"path@one\", \"path@two\"]")
    && contains_manifest_text(updated, "[lint.rules]\nunused-imports = \"deny\"")
    && contains_manifest_text(updated, "[format]\nindent-width = 2")
}

fn feature_members(features: Vec[ProjectFeature], name: str) -> Vec[str] {
    for feature in features {
        if feature.name == name {
            ret feature.members
        }
    }
    ret Vec[str]::new()
}

fn has_feature(features: Vec[ProjectFeature], name: str) -> bool {
    for feature in features {
        if feature.name == name {
            ret true
        }
    }
    ret false
}

fn is_dependency_member(value: str) -> bool {
    ret starts_with_text(value, "index@") || starts_with_text(value, "workspace@") || starts_with_text(value, "path@") || starts_with_text(value, "git@")
}

fn starts_with_text(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}

fn string_array(values: Vec[str]) -> str {
    let mut out = "["
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Some(value) => {
                if index > 0_usize {
                    out = out + ", "
                }
                out = out + "\"" + toml_escape(value) + "\""
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret out + "]"
}

fn target_setting(doc: TomlDocument, section: str, key: str, fallback: str) -> str {
    match toml_get_string(doc, section, key) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            ret fallback
        }
    }
}

fn target_array_setting(doc: TomlDocument, section: str, key: str, fallback: Vec[str]) -> Vec[str] {
    match toml_get_string_array(doc, section, key) {
        Option[Vec[str]]::Some(value) => {
            ret value
        }
        Option[Vec[str]]::None => {
            ret fallback
        }
    }
}

fn target_bool_setting(doc: TomlDocument, section: str, key: str, fallback: bool) -> bool {
    match toml_get_bool(doc, section, key) {
        Option[u1]::Some(value) => {
            ret value == true
        }
        Option[u1]::None => {
            ret fallback
        }
    }
}

fn toml_escape(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "\\\\"
        } elif ch == "\"" {
            out = out + "\\\""
        } elif ch == "\n" {
            out = out + "\\n"
        } else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out
}

fn try_required_project_string(doc: TomlDocument, key: str, manifest_path: Path) -> Result[str, ProjectFailure] {
    match toml_get_string(doc, "project", key) {
        Option[str]::Some(value) => {
            ret Result[str, ProjectFailure]::Ok(value)
        }
        Option[str]::None => {
            try_manifest_error("Manifest " + manifest_path.as_str() + " is missing [project]." + key)?
            ret Result[str, ProjectFailure]::Ok("")
        }
    }
}

fn project_string_or(doc: TomlDocument, key: str, fallback: str) -> str {
    match toml_get_string(doc, "project", key) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            ret fallback
        }
    }
}

fn contains_string(items: Vec[str], target: str) -> bool {
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[str]::Some(value) => {
                if value == target {
                    ret true
                }
            }
            Option[str]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn try_panic_missing_manifest(manifest_path: Path) -> Result[bool, ProjectFailure] {
    try_manifest_error("Unable to find encore.toml at " + manifest_path.as_str())?
    ret Result[bool, ProjectFailure]::Ok(true)
}

fn try_manifest_error(message: str) -> Result[bool, ProjectFailure] {
    ret Result[bool, ProjectFailure]::Err(ProjectFailure { "manifest", message })
}

fn native_path(value: str) -> str {
    ret replace_backslashes(value)
}

fn replace_backslashes(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "/"
        } else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out
}

