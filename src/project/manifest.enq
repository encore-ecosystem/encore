#attr(test)
fn plugin_manifest_exports_and_state_policy_contract() -> bool {
    let base = "[project]\nname=\"plugin\"\ntarget=\"shared_lib\"\n[plugin.exports.formatter]\ninterface=\"api::Formatter\"\nfactory=\"create\"\n"
    let parsed = match try_parse_project_manifest(base + "stateless=true\n", Path::new("encore.toml")) {
        Ok(value) => value
        Err(_) => {
            ret false
        }
    }
    if parsed.plugin_exports.len() != 1 {
        ret false
    }
    for suffix in vec!["", "stateless=\"yes\"\n", "stateless=true\nsave-state=\"save\"\n", "save-state=\"save\"\n", "stateless=true\nunknown=1\n", "stateless=true\nsave-state=123\n", "stateless=true\nrestore-state=\"\"\n"] {
        if try_parse_project_manifest(base + suffix, Path::new("encore.toml")).is_ok() {
            ret false
        }
    }
    ret try_parse_project_manifest(base + "save-state=\"save\"\nrestore-state=\"restore\"\n", Path::new("encore.toml")).is_ok()
}

#attr(test)
fn manifest_binary_name_is_separate_from_library_name() -> bool {
    let base = "[project]\nname=\"example_library\"\nversion=\"0.0.0\"\n"
    let manifest = match try_parse_project_manifest(base + "binary-name=\"example-cli\"\n", Path::new("encore.toml")) {
        Ok(value) => value
        Err(_) => {
            ret false
        }
    }
    if project_manifest_name(manifest) != "example_library" || project_manifest_binary_name(manifest) != "example-cli" {
        ret false
    }
    for value in vec!["\"\"", "42", "\"../escape\"", "\"a/b\"", "\"..\""] {
        if try_parse_project_manifest(base + "binary-name=" + value + "\n", Path::new("encore.toml")).is_ok() {
            ret false
        }
    }
    let ordinary = match try_parse_project_manifest(base, Path::new("encore.toml")) {
        Ok(value) => value
        Err(_) => {
            ret false
        }
    }
    ret project_manifest_binary_name(ordinary) == project_manifest_name(ordinary)
}
