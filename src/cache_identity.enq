//! Stable content identities for compiler-produced caches.

import std::os::{file_exists, file_sha256}
import std::path::Path

extern fn encore_text_sha256(contents: str) -> str

/// Hashes the exact in-memory bytes without a temporary file or shell tool.
#attr(safe)
pub fn compiler_content_digest(contents: str) -> str {
    unsafe {
        ret encore_text_sha256(contents)
    }
}

/// Returns the content identity that all compiler-produced cache keys use.
/// The executable digest is deliberately part of the identity even for a
/// self-hosting build: source bytes describe the compiler being built, while
/// this digest describes the bootstrap compiler that actually lowered them.
pub fn compiler_binary_identity(executable: str) -> str {
    let compiler_path = Path::new(executable).resolve()
    if !file_exists(compiler_path.as_str()) {
        ret "missing\n" + compiler_path.as_str()
    }
    // Installed and workspace-local copies of the same compiler are
    // semantically identical and must share project artifacts.
    ret "sha256\n" + file_sha256(compiler_path.as_str())
}
