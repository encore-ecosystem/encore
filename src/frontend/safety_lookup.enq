//! Function-local declaration lookup, including exact overlays and overload order.
//! Handles are synchronous construction helpers, never retained by a safety plan.
import std::vec::Vec
import refrain::frontend::semantic::{SemanticCallable, SemanticMethod}
import refrain::frontend::semantic_slice::SemanticSlice

extern fn encore_strmap_new() -> usize
extern fn encore_strmap_put(map: usize, key: str, value: usize) -> ()
extern fn encore_strmap_get(map: usize, key: str) -> usize
extern fn encore_strmap_free(map: usize) -> ()

pub struct SafetyNameLookup {
    callables: usize
    methods: usize
    next: Vec[usize]
    values: SemanticSlice[SemanticMethod]
}

impl for SafetyNameLookup {
    pub fn new(callables: SemanticSlice[SemanticCallable], methods: SemanticSlice[SemanticMethod]) -> Self {
        let functions = encore_strmap_new()
        for position in 0_usize..callables.len() {
            if !callables.contains_index(position) { break }
            let value = callables.get_unchecked_borrowed(position)
            if encore_strmap_get(functions, value.name) == 0_usize { encore_strmap_put(functions, value.name, position + 1_usize) }
        }
        let heads = encore_strmap_new()
        let mut next = Vec[usize]::with_capacity(methods.len())
        let mut length = 0_usize
        // A malformed public view ends at the first missing iterator element,
        // matching the ordinary SemanticSlice iterator's behavior.
        for position in 0_usize..methods.len() {
            if !methods.contains_index(position) { break }
            next.push(0_usize)
            length += 1_usize
        }
        for offset in 0_usize..length {
            let position = length - offset - 1_usize
            let value = methods.get_unchecked_borrowed(position)
            next.set(position, encore_strmap_get(heads, value.name))
            encore_strmap_put(heads, value.name, position + 1_usize)
        }
        ret Self { functions, heads, next, methods }
    }
    pub fn callable(self: Self, name: str) -> usize { ret encore_strmap_get(self.callables, name) }
    pub fn methods_named(self: Self, name: str) -> SemanticSlice[SemanticMethod] {
        // Empty names request the complete completion environment.
        if name.is_empty() { ret self.values }
        let mut out = Vec[SemanticMethod]::new()
        let mut encoded = encore_strmap_get(self.methods, name)
        while encoded != 0_usize {
            let position = encoded - 1_usize
            out.push(self.values.get_unchecked_borrowed(position))
            encoded = self.next.get_unchecked_borrowed(position)
        }
        ret SemanticSlice::from_vec(out)
    }
    pub fn close(self: Self) -> () {
        encore_strmap_free(self.callables)
        encore_strmap_free(self.methods)
    }
}
