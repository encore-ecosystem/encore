import core::fmt::Debug
import core::ops::Eq
import core::ops::Ne


pub struct Token {
    type   : TokenType
    value  : str
    line   : usize
    column : usize
}

impl for Token {
    pub fn new(type: TokenType, value: str, line: usize, column: usize) -> Token {
        ret Token {type, value, line, column}
    }
}

impl Debug for Token {
    pub fn fmt(self: Token) -> str {
        ret "Token(" + Debug::fmt(self.type) + ", " + Debug::fmt(self.value) + ", " + Debug::fmt(self.line) + ", " + Debug::fmt(self.column) + ")"
    }
}

pub enum TokenType {
    INTEGER
    FLOAT
    BOOLEAN
    STRING
    IDENTIFIER

    ONE_LINE_COMMENT
    MULTI_LINE_COMMENT

    KW_FN
    KW_ASYNC
    KW_AWAIT
    KW_SPAWN
    KW_STRUCT
    KW_TRAIT
    KW_ENUM
    KW_IMPL
    KW_FOR
    KW_LET
    KW_MUT
    KW_RET
    KW_WHILE
    KW_LOOP
    KW_DO
    KW_CONTINUE
    KW_BREAK
    KW_IF
    KW_ELIF
    KW_ELSE
    KW_MATCH
    KW_PUB
    KW_IMPORT
    KW_AS
    KW_DYN
    KW_EXTERN
    KW_UNSAFE
    KW_EHIR
    KW_WITH

    SCOPE

    PLUS
    MINUS
    ASTERISK
    POWER
    SLASH
    PERCENT

    EQUAL_EQUAL
    BANG_EQUAL
    LESS
    GREATER
    LESS_EQUAL
    GREATER_EQUAL

    AND_AND
    PIPE_PIPE
    BANG

    AMPERSAND
    PIPE
    CARET
    TILDE
    LEFT_SHIFT
    RIGHT_SHIFT

    ASSIGN
    PLUS_EQUAL
    MINUS_EQUAL
    ASTERISK_EQUAL
    POWER_EQUAL
    SLASH_EQUAL
    PERCENT_EQUAL
    AMPERSAND_EQUAL
    PIPE_EQUAL
    CARET_EQUAL
    LEFT_SHIFT_EQUAL
    RIGHT_SHIFT_EQUAL

    INCREMENT
    DECREMENT
    QUESTION
    HASH

    ARROW
    FAT_ARROW

    LEFT_PAREN
    RIGHT_PAREN
    LEFT_BRACE
    RIGHT_BRACE
    LEFT_BRACKET
    RIGHT_BRACKET
    SEMICOLON
    COLON
    COMMA
    DOT
    QUOTE

    WHITESPACE
    NEWLINE
    EOF
    UNKNOWN
}

impl Debug for TokenType {
    pub fn fmt(self: TokenType) -> str {
        ret match self {
            INTEGER => "INTEGER"
            FLOAT => "FLOAT"
            BOOLEAN => "BOOLEAN"
            STRING => "STRING"
            IDENTIFIER => "IDENTIFIER"
            ONE_LINE_COMMENT => "ONE_LINE_COMMENT"
            MULTI_LINE_COMMENT => "MULTI_LINE_COMMENT"
            KW_FN => "KW_FN"
            KW_ASYNC => "KW_ASYNC"
            KW_AWAIT => "KW_AWAIT"
            KW_STRUCT => "KW_STRUCT"
            KW_TRAIT => "KW_TRAIT"
            KW_ENUM => "KW_ENUM"
            KW_IMPL => "KW_IMPL"
            KW_FOR => "KW_FOR"
            KW_LET => "KW_LET"
            KW_MUT => "KW_MUT"
            KW_RET => "KW_RET"
            KW_WHILE => "KW_WHILE"
            KW_LOOP => "KW_LOOP"
            KW_DO => "KW_DO"
            KW_CONTINUE => "KW_CONTINUE"
            KW_BREAK => "KW_BREAK"
            KW_IF => "KW_IF"
            KW_ELIF => "KW_ELIF"
            KW_ELSE => "KW_ELSE"
            KW_MATCH => "KW_MATCH"
            KW_PUB => "KW_PUB"
            KW_IMPORT => "KW_IMPORT"
            KW_AS => "KW_AS"
            KW_DYN => "KW_DYN"
            KW_EXTERN => "KW_EXTERN"
            KW_UNSAFE => "KW_UNSAFE"
            KW_EHIR => "KW_EHIR"
            KW_WITH => "KW_WITH"
            SCOPE => "SCOPE"
            PLUS => "PLUS"
            MINUS => "MINUS"
            ASTERISK => "ASTERISK"
            POWER => "POWER"
            SLASH => "SLASH"
            PERCENT => "PERCENT"
            EQUAL_EQUAL => "EQUAL_EQUAL"
            BANG_EQUAL => "BANG_EQUAL"
            LESS => "LESS"
            GREATER => "GREATER"
            LESS_EQUAL => "LESS_EQUAL"
            GREATER_EQUAL => "GREATER_EQUAL"
            AND_AND => "AND_AND"
            PIPE_PIPE => "PIPE_PIPE"
            BANG => "BANG"
            AMPERSAND => "AMPERSAND"
            PIPE => "PIPE"
            CARET => "CARET"
            TILDE => "TILDE"
            LEFT_SHIFT => "LEFT_SHIFT"
            RIGHT_SHIFT => "RIGHT_SHIFT"
            ASSIGN => "ASSIGN"
            PLUS_EQUAL => "PLUS_EQUAL"
            MINUS_EQUAL => "MINUS_EQUAL"
            ASTERISK_EQUAL => "ASTERISK_EQUAL"
            POWER_EQUAL => "POWER_EQUAL"
            SLASH_EQUAL => "SLASH_EQUAL"
            PERCENT_EQUAL => "PERCENT_EQUAL"
            AMPERSAND_EQUAL => "AMPERSAND_EQUAL"
            PIPE_EQUAL => "PIPE_EQUAL"
            CARET_EQUAL => "CARET_EQUAL"
            LEFT_SHIFT_EQUAL => "LEFT_SHIFT_EQUAL"
            RIGHT_SHIFT_EQUAL => "RIGHT_SHIFT_EQUAL"
            INCREMENT => "INCREMENT"
            DECREMENT => "DECREMENT"
            QUESTION => "QUESTION"
            HASH => "HASH"
            ARROW => "ARROW"
            FAT_ARROW => "FAT_ARROW"
            LEFT_PAREN => "LEFT_PAREN"
            RIGHT_PAREN => "RIGHT_PAREN"
            LEFT_BRACE => "LEFT_BRACE"
            RIGHT_BRACE => "RIGHT_BRACE"
            LEFT_BRACKET => "LEFT_BRACKET"
            RIGHT_BRACKET => "RIGHT_BRACKET"
            SEMICOLON => "SEMICOLON"
            COLON => "COLON"
            COMMA => "COMMA"
            DOT => "DOT"
            QUOTE => "QUOTE"
            WHITESPACE => "WHITESPACE"
            NEWLINE => "NEWLINE"
            EOF => "EOF"
            _ => "UNKNOWN"
        }
    }
}

impl Eq[TokenType] for TokenType {
    pub fn op(self: TokenType, other: TokenType) -> bool {
        ret Debug::fmt(self) == Debug::fmt(other)
    }
}

impl Ne[TokenType] for TokenType {
    pub fn op(self: TokenType, other: TokenType) -> bool {
        ret Debug::fmt(self) != Debug::fmt(other)
    }
}
