//! Tokenizes Encore source code.

import mod::token::Token
import mod::token::TokenType

import core::option::Option
import std::io::eprintln
import std::process::exit
import std::vec::Vec

import std::io::println
import std::io::print
import core::fmt::Debug

extern fn encore_str_char_width_at_byte(value: str, byte_index: usize) -> usize
extern fn encore_str_char_at_byte(value: str, byte_index: usize) -> str

/// Stores the state of a `Lexer` value.
pub struct Lexer {
    line: usize
    column: usize
    consumed: usize
    token_start: usize
    token_line: usize
    token_column: usize
    program: str
    tokens: Vec[Token]
    preserve_trivia: bool
}


impl for Lexer {
    /// Creates a new value with its default initial state.
    pub fn new() -> Lexer {
        ret Lexer{0_usize, 0_usize, 0_usize, 0_usize, 0_usize, 0_usize, "", Vec[Token]::new(), false}
    }

    /// Performs the `tokenize` operation.
    pub fn tokenize(mut self, p: str) -> Vec[Token] {
        self.preserve_trivia = false
        ret self.tokenize_source(p)
    }

    /// Tokenizes source while retaining whitespace, newlines, and ordinary
    /// comments. This lossless stream is used by formatting and source tools;
    /// the parser continues to consume the compact stream returned by
    /// `tokenize`.
    pub fn tokenize_lossless(mut self, p: str) -> Vec[Token] {
        self.preserve_trivia = true
        ret self.tokenize_source(p)
    }

    fn tokenize_source(mut self, p: str) -> Vec[Token] {
        self.line = 0_usize
        self.column = 0_usize
        self.consumed = 0_usize
        self.token_start = 0_usize
        self.token_line = 0_usize
        self.token_column = 0_usize
        self.program = p
        self.tokens = Vec[Token]::new()

        let mut progress_guard = 0_usize
        loop {
            progress_guard = progress_guard + 1_usize
            if progress_guard > self.program.byte_len() * 4_usize + 16_usize {
                eprintln("error[lexer-invariant]: lexer made no progress at byte index " + Debug::fmt(self.consumed))
                exit(1_i32)
            }
            match self.peek_curr() {
                "" => {
                    break
                }
                " " => {
                    self.consume_and_push(TokenType::WHITESPACE)
                }
                "\t" => {
                    self.consume_and_push(TokenType::WHITESPACE)
                }
                "\r" => {
                    self.consume()
                    if self.peek_curr() == "\n" { self.consumed += 1_usize }
                    self.push_token(TokenType::NEWLINE)
                }
                "\n" => {
                    self.consume_and_push(TokenType::NEWLINE)
                }
                "+" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::PLUS_EQUAL)
                    }
                    elif self.peek_curr() == "+" {
                        self.consume_and_push(TokenType::INCREMENT)
                    }
                    else {
                        self.push_token(TokenType::PLUS)
                    }
                }
                "-" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::MINUS_EQUAL)
                    }
                    elif self.peek_curr() == ">" {
                        self.consume_and_push(TokenType::ARROW)
                    }
                    elif self.peek_curr() == "-" {
                        self.consume_and_push(TokenType::DECREMENT)
                    }
                    else {
                        self.push_token(TokenType::MINUS)
                    }
                }
                "*" => {
                    self.consume()
                    if self.peek_curr() == "*" {
                        self.consume()
                        if self.peek_curr() == "=" {
                            self.consume_and_push(TokenType::POWER_EQUAL)
                        }
                        else {
                            self.push_token(TokenType::POWER)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::ASTERISK_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::ASTERISK)
                    }
                }
                "/" => {
                    self.consume()
                    if self.peek_curr() == "/" {
                        self.consume()
                        let mut comment_type = TokenType::ONE_LINE_COMMENT
                        if self.peek_curr() == "/" {
                            self.consume()
                            comment_type = TokenType::DOC_COMMENT
                        }
                        elif self.peek_curr() == "!" {
                            self.consume()
                            comment_type = TokenType::MODULE_DOC_COMMENT
                        }
                        self.skip_one_line_comment()
                        self.push_token(comment_type)
                    }
                    elif self.peek_curr() == "*" {
                        self.consume()
                        self.skip_multi_line_comment_body()

                        if self.is_at_end() {
                            self.push_token(TokenType::UNKNOWN)
                        }
                        else {
                            self.consume()
                            self.consume_and_push(TokenType::MULTI_LINE_COMMENT)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::SLASH_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::SLASH)
                    }
                }
                "%" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::PERCENT_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::PERCENT)
                    }
                }
                "<" => {
                    self.consume()
                    if self.peek_curr() == "<" {
                        self.consume()
                        if self.peek_curr() == "=" {
                            self.consume_and_push(TokenType::LEFT_SHIFT_EQUAL)
                        }
                        else {
                            self.push_token(TokenType::LEFT_SHIFT)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::LESS_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::LESS)
                    }
                }
                ">" => {
                    self.consume()
                    if self.peek_curr() == ">" {
                        self.consume()
                        if self.peek_curr() == "=" {
                            self.consume_and_push(TokenType::RIGHT_SHIFT_EQUAL)
                        }
                        else {
                            self.push_token(TokenType::RIGHT_SHIFT)
                        }
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::GREATER_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::GREATER)
                    }
                }
                "(" => { self.consume_and_push(TokenType::LEFT_PAREN) }
                ")" => { self.consume_and_push(TokenType::RIGHT_PAREN) }
                "[" => { self.consume_and_push(TokenType::LEFT_BRACKET) }
                "]" => { self.consume_and_push(TokenType::RIGHT_BRACKET) }
                "{" => { self.consume_and_push(TokenType::LEFT_BRACE) }
                "}" => { self.consume_and_push(TokenType::RIGHT_BRACE) }
                ":" => {
                    self.consume()
                    if self.peek_curr() == ":" {
                        self.consume_and_push(TokenType::SCOPE)
                    }
                    else {
                        self.push_token(TokenType::COLON)
                    }
                }
                "." => { self.consume_and_push(TokenType::DOT) }
                "," => { self.consume_and_push(TokenType::COMMA) }
                ";" => { self.consume_and_push(TokenType::SEMICOLON) }
                "=" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::EQUAL_EQUAL)
                    }
                    elif self.peek_curr() == ">" {
                        self.consume_and_push(TokenType::FAT_ARROW)
                    }
                    else {
                        self.push_token(TokenType::ASSIGN)
                    }
                }
                "!" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::BANG_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::BANG)
                    }
                }
                "&" => {
                    self.consume()
                    if self.peek_curr() == "&" {
                        self.consume_and_push(TokenType::AND_AND)
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::AMPERSAND_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::AMPERSAND)
                    }
                }
                "|" => {
                    self.consume()
                    if self.peek_curr() == "|" {
                        self.consume_and_push(TokenType::PIPE_PIPE)
                    }
                    elif self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::PIPE_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::PIPE)
                    }
                }
                "^" => {
                    self.consume()
                    if self.peek_curr() == "=" {
                        self.consume_and_push(TokenType::CARET_EQUAL)
                    }
                    else {
                        self.push_token(TokenType::CARET)
                    }
                }
                "~" => { self.consume_and_push(TokenType::TILDE) }
                "?" => { self.consume_and_push(TokenType::QUESTION) }
                "#" => { self.consume_and_push(TokenType::HASH) }
                "\"" => {
                    self.consume()
                    loop {
                        if self.is_at_end() {
                            break
                        }
                        if self.peek_curr() == "\\" {
                            self.consume()
                            if self.is_at_end() {
                                break
                            }
                            self.consume()
                            continue
                        }
                        if self.peek_curr() == "\"" {
                            break
                        }
                        self.consume()
                    }
                    if self.is_at_end() {
                        self.push_token(TokenType::UNKNOWN)
                    }
                    else {
                        self.consume_and_push(TokenType::STRING)
                    }
                }
                "'" => { self.consume_and_push(TokenType::QUOTE) }
                _ => {
                    let curr_char = self.peek_curr()
                    if is_digit_char(curr_char) {
                        self.parse_number()
                    }
                    elif is_identifier_start_char(curr_char) {
                        self.parse_identifier()
                    }
                    else {
                        self.consume()
                        self.push_token(TokenType::UNKNOWN)
                    }
                }
            }
        }

        ret self.tokens
    }

    fn parse_number(mut self) -> () {
        let mut is_float = false

        if self.peek_curr() == "0" {
            let prefix = self.peek_next()
            if prefix == "x" || prefix == "X" || prefix == "b" || prefix == "B" ||
                prefix == "o" || prefix == "O" {
                self.consume()
                self.consume()
                let mut digits = 0_usize
                let base = if prefix == "x" || prefix == "X" {
                    16_u32
                } else {
                    if prefix == "b" || prefix == "B" { 2_u32 } else { 8_u32 }
                }
                while radix_digit_value(self.peek_curr()) < base {
                    self.consume()
                    digits += 1_usize
                }
                // Consume an invalid alphanumeric tail as one token so the
                // parser reports the malformed literal at its real source
                // location instead of treating it as an adjacent identifier.
                if digits == 0_usize || is_alnum_char(self.peek_curr()) {
                    while is_alnum_char(self.peek_curr()) { self.consume() }
                    self.push_token(TokenType::UNKNOWN)
                    ret ()
                }
                self.push_token(TokenType::INTEGER)
                ret ()
            }
        }

        loop {
            if !is_digit_char(self.peek_curr()) {
                break
            }
            self.consume()
        }

        if self.peek_curr() == "." {
            if is_digit_char(self.peek_next()) {
                is_float = true
                self.consume()
                loop {
                    if !is_digit_char(self.peek_curr()) {
                        break
                    }
                    self.consume()
                }
            }
        }

        if is_float {
            self.push_token(TokenType::FLOAT)
            ret ()
        }
        self.push_token(TokenType::INTEGER)
        ret ()
    }

    fn parse_identifier(mut self) -> () {
        loop {
            let curr = self.peek_curr()
            if is_alnum_char(curr) {
                self.consume()
                continue
            }
            if curr == "_" {
                self.consume()
                continue
            }
            break
        }

        let raw = self.program.slice_bytes(self.token_start, self.consumed - self.token_start)
        let token_type = identifier_token_type(raw)
        self.push_token(token_type)
        ret ()
    }

    fn consume(mut self) -> () {
        let curr_char = self.peek_curr()
        if curr_char == "" {
            ret ()
        }

        self.consumed = self.consumed + unsafe { encore_str_char_width_at_byte(self.program, self.consumed) }
        if curr_char == "\n" || curr_char == "\r" {
            self.line += 1_usize
            self.column = 0_usize
        } else {
            self.column += 1_usize
        }
        ret ()
    }

    fn skip_one_line_comment(mut self) -> () {
        let end = self.program.byte_len()
        while self.consumed < end {
            let byte = self.program.byte_at(self.consumed)
            if byte == 10_u8 || byte == 13_u8 { break }
            let width = unsafe { encore_str_char_width_at_byte(self.program, self.consumed) }
            if width == 0_usize { break }
            self.consumed += width
            self.column += 1_usize
        }
        ret ()
    }

    fn skip_multi_line_comment_body(mut self) -> () {
        let end = self.program.byte_len()
        while self.consumed < end {
            let byte = self.program.byte_at(self.consumed)
            if byte == 42_u8 && self.consumed + 1_usize < end && self.program.byte_at(self.consumed + 1_usize) == 47_u8 { break }
            if byte == 13_u8 {
                self.consumed += 1_usize
                if self.consumed < end && self.program.byte_at(self.consumed) == 10_u8 { self.consumed += 1_usize }
                self.line += 1_usize
                self.column = 0_usize
            }
            elif byte == 10_u8 {
                self.consumed += 1_usize
                self.line += 1_usize
                self.column = 0_usize
            } else {
                let width = unsafe { encore_str_char_width_at_byte(self.program, self.consumed) }
                if width == 0_usize { break }
                self.consumed += width
                self.column += 1_usize
            }
        }
        ret ()
    }

    fn consume_and_push(mut self, token_type: TokenType) -> () {
        self.consume()
        self.push_token(token_type)
        ret ()
    }

    fn push_token(mut self, token_type: TokenType) -> () {
        let token_value = self.program.slice_bytes(self.token_start, self.consumed - self.token_start)
        self.token_start = self.consumed
        let line = self.token_line
        let column = self.token_column
        self.token_line = self.line
        self.token_column = self.column
        if !self.preserve_trivia {
            match token_type {
                TokenType::NEWLINE => {
                    ret ()
                }
                TokenType::WHITESPACE => {
                    ret ()
                }
                TokenType::ONE_LINE_COMMENT => {
                    ret ()
                }
                TokenType::MULTI_LINE_COMMENT => {
                    ret ()
                }
                _ => {}
            }
        }

        let token = Token::new(
            token_type,
            token_value,
            line,
            column
        )
        self.tokens.push(token)
        ret ()
    }

    fn is_at_end(mut self) -> bool {
        ret self.consumed >= self.program.byte_len()
    }

    fn peek_curr(mut self) -> str {
        ret self.peek_nth(0_usize)
    }

    fn peek_next(mut self) -> str {
        ret self.peek_nth(1_usize)
    }

    fn peek_nth(mut self, nth: usize) -> str {
        let mut byte_index = self.consumed
        let mut remaining = nth
        while remaining > 0_usize {
            let width = unsafe { encore_str_char_width_at_byte(self.program, byte_index) }
            if width == 0_usize { ret "" }
            byte_index = byte_index + width
            remaining = remaining - 1_usize
        }
        if byte_index >= self.program.byte_len() { ret "" }
        ret unsafe { encore_str_char_at_byte(self.program, byte_index) }
    }
}


fn identifier_token_type(raw: str) -> TokenType {
    ret match raw {
        "fn" => TokenType::KW_FN
        "async" => TokenType::KW_ASYNC
        "await" => TokenType::KW_AWAIT
        "spawn" => TokenType::KW_SPAWN
        "struct" => TokenType::KW_STRUCT
        "enum" => TokenType::KW_ENUM
        "trait" => TokenType::KW_TRAIT
        "impl" => TokenType::KW_IMPL
        "for" => TokenType::KW_FOR
        "let" => TokenType::KW_LET
        "mut" => TokenType::KW_MUT
        "ret" => TokenType::KW_RET
        "while" => TokenType::KW_WHILE
        "do" => TokenType::KW_DO
        "break" => TokenType::KW_BREAK
        "continue" => TokenType::KW_CONTINUE
        "loop" => TokenType::KW_LOOP
        "if" => TokenType::KW_IF
        "elif" => TokenType::KW_ELIF
        "else" => TokenType::KW_ELSE
        "match" => TokenType::KW_MATCH
        "pub" => TokenType::KW_PUB
        "import" => TokenType::KW_IMPORT
        "as" => TokenType::KW_AS
        "dyn" => TokenType::KW_DYN
        "extern" => TokenType::KW_EXTERN
        "unsafe" => TokenType::KW_UNSAFE
        "ehir" => TokenType::KW_EHIR
        "with" => TokenType::KW_WITH
        "not" => TokenType::BANG
        "true" => TokenType::BOOLEAN
        "false" => TokenType::BOOLEAN
        _ => TokenType::IDENTIFIER
    }
}

fn is_digit_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    let code = ch.byte_at(0_usize)
    if code < 48_u8 {
        ret false
    }
    if code > 57_u8 {
        ret false
    }
    ret true
}

fn radix_digit_value(ch: str) -> u32 {
    if ch.len() != 1_usize { ret 16_u32 }
    let code = ch.byte_at(0_usize)
    if code >= 48_u8 && code <= 57_u8 { ret (code - 48_u8) as u32 }
    if code >= 65_u8 && code <= 70_u8 { ret (code - 65_u8) as u32 + 10_u32 }
    if code >= 97_u8 && code <= 102_u8 { ret (code - 97_u8) as u32 + 10_u32 }
    ret 16_u32
}

fn is_alpha_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    let code = ch.byte_at(0_usize)
    if code >= 65_u8 {
        if code <= 90_u8 {
            ret true
        }
    }
    if code >= 97_u8 {
        if code <= 122_u8 {
            ret true
        }
    }
    ret false
}

fn is_alnum_char(ch: str) -> bool {
    if is_alpha_char(ch) {
        ret true
    }
    ret is_digit_char(ch)
}

fn is_identifier_start_char(ch: str) -> bool {
    if is_alpha_char(ch) {
        ret true
    }
    ret ch == "_"
}

fn is_newline_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    let code = ch.byte_at(0_usize)
    ret code == 10_u8 || code == 13_u8
}

#attr(test)
fn lexer_accepts_windows_line_endings() -> bool {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize("fn main() -> u32 {\r\n\tret 0_u32\r\n}\r\n")
    for token in tokens {
        if token.type == TokenType::UNKNOWN { ret false }
    }
    ret true
}

#attr(test)
fn lexer_tracks_token_positions() -> bool {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize("fn main() {\n    /* first\n       second */ ret 0_u32\n}\n")
    let mut saw_main = false
    let mut saw_ret = false
    for token in tokens {
        if token.value == "main" {
            if token.line != 0_usize || token.column != 3_usize { ret false }
            saw_main = true
        }
        if token.value == "ret" {
            if token.line != 2_usize || token.column != 17_usize { ret false }
            saw_ret = true
        }
    }
    ret saw_main && saw_ret
}

fn is_double_quote_char(ch: str) -> bool {
    if ch.len() != 1_usize {
        ret false
    }
    ret ch.byte_at(0_usize) == 34_u8
}
