//! Compact reusable scoped environments, bound to fresh declaration identities.
import core::fmt::Debug
import core::result::Result

import std::vec::Vec

import json::Json

import refrain::frontend::semantic::{SemanticCallable, SemanticField, SemanticMethod, SemanticVariant}
import refrain::frontend::type_scope::TypeNameBinding

pub struct StoredSemanticEnvironment {
    callables: Vec[SemanticCallable]
    fields: Vec[SemanticField]
    methods: Vec[SemanticMethod]
    aggregates: Vec[str]
    constructors: Vec[str]
    variants: Vec[SemanticVariant]
    names: Vec[TypeNameBinding]
}

fn text(value: Json) -> Result[str, str] {
    ret match value {
        Json::String(value) => Result::Ok(value) _ => Result::Err("invalid environment string")
    }
}
fn array(value: Json) -> Result[Vec[Json], str] {
    ret match value {
        Json::Array(value) => Result::Ok(value) _ => Result::Err("invalid environment array")
    }
}
fn record(value: Json, size: usize) -> Result[Vec[Json], str] {
    let values = array(value)?
    if values.len() != size {
        ret Result::Err("invalid environment record")
    }
    ret Result::Ok(values)
}
fn flag(value: Json) -> Result[bool, str] {
    ret match value {
        Json::Bool(value) => Result::Ok(value) _ => Result::Err("invalid environment flag")
    }
}
fn integer(value: Json) -> Result[u64, str] {
    let value = text(value)?
    if value.is_empty() || value.byte_len() > 20_usize {
        ret Result::Err("invalid environment integer")
    }
    let mut result = 0_u64
    for index in 0_usize..value.byte_len() {
        let byte = value.byte_at(index)
        if byte < 48_u8 || byte > 57_u8 {
            ret Result::Err("invalid environment integer")
        }
        let digit =(byte - 48_u8) as u64
        if result >(18446744073709551615_u64 - digit) / 10_u64 {
            ret Result::Err("environment integer overflow")
        }
        result = result * 10_u64 + digit
    }
    ret Result::Ok(result)
}
fn strings(values: Vec[str]) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        out.push(Json::String(value))
    }
    ret Json::Array(out)
}
fn read_strings(value: Json) -> Result[Vec[str], str] {
    let mut out = Vec[str]::new()
    for item in array(value)? {
        out.push(text(item)?)
    }
    ret Result::Ok(out)
}

fn encode_callable(value: SemanticCallable) -> Json {
    ret Json::Array(vec![Json::String(value.module_name), Json::String(value.name), strings(value.params), Json::String(value.ret_type), Json::String(Debug::fmt(value.signature)), Json::String(value.declaration_name), Json::String(value.lookup_module), Json::String(Debug::fmt(value.binding_identity)), strings(value.generic_names), Json::Bool(value.is_static)])
}

fn decode_callable(value: Json) -> Result[SemanticCallable, str] {
    let fields = record(value, 10_usize)?
    ret Result::Ok(SemanticCallable {
            text(fields.get(0_usize).unwrap_or(Json::Null))?, text(fields.get(1_usize).unwrap_or(Json::Null))?, read_strings(fields.get(2_usize).unwrap_or(Json::Null))?, text(fields.get(3_usize).unwrap_or(Json::Null))?, integer(fields.get(4_usize).unwrap_or(Json::Null))?, text(fields.get(5_usize).unwrap_or(Json::Null))?, text(fields.get(6_usize).unwrap_or(Json::Null))?, integer(fields.get(7_usize).unwrap_or(Json::Null))?, read_strings(fields.get(8_usize).unwrap_or(Json::Null))?, flag(fields.get(9_usize).unwrap_or(Json::Null))?
        }
    )
}

fn encode_field(value: SemanticField) -> Json {
    ret Json::Array(vec![Json::String(value.module_name), Json::String(value.owner_type), Json::String(value.name), Json::String(value.typ), Json::String(Debug::fmt(value.signature)), strings(value.generic_names), Json::String(value.declaration_owner)])
}

fn decode_field(value: Json) -> Result[SemanticField, str] {
    let fields = record(value, 7_usize)?
    ret Result::Ok(SemanticField {
            text(fields.get(0_usize).unwrap_or(Json::Null))?, text(fields.get(1_usize).unwrap_or(Json::Null))?, text(fields.get(2_usize).unwrap_or(Json::Null))?, text(fields.get(3_usize).unwrap_or(Json::Null))?, integer(fields.get(4_usize).unwrap_or(Json::Null))?, read_strings(fields.get(5_usize).unwrap_or(Json::Null))?, text(fields.get(6_usize).unwrap_or(Json::Null))?
        }
    )
}

fn encode_method(value: SemanticMethod) -> Json {
    ret Json::Array(vec![Json::String(value.module_name), Json::String(value.receiver_type), Json::String(value.name), strings(value.params), Json::String(value.ret_type), Json::String(Debug::fmt(value.signature)), Json::String(value.declaration_receiver), strings(value.generic_names), Json::Bool(value.is_static), Json::Bool(value.is_public), strings(value.method_generic_names)])
}

fn decode_method(value: Json) -> Result[SemanticMethod, str] {
    let fields = record(value, 11_usize)?
    ret Result::Ok(SemanticMethod {
            text(fields.get(0_usize).unwrap_or(Json::Null))?, text(fields.get(1_usize).unwrap_or(Json::Null))?, text(fields.get(2_usize).unwrap_or(Json::Null))?, read_strings(fields.get(3_usize).unwrap_or(Json::Null))?, text(fields.get(4_usize).unwrap_or(Json::Null))?, integer(fields.get(5_usize).unwrap_or(Json::Null))?, text(fields.get(6_usize).unwrap_or(Json::Null))?, read_strings(fields.get(7_usize).unwrap_or(Json::Null))?, flag(fields.get(8_usize).unwrap_or(Json::Null))?, flag(fields.get(9_usize).unwrap_or(Json::Null))?, read_strings(fields.get(10_usize).unwrap_or(Json::Null))?
        }
    )
}

fn encode_variant(value: SemanticVariant) -> Json {
    ret Json::Array(vec![Json::String(value.owner_type), Json::String(value.name), Json::String(value.payload_type), strings(value.generic_names)])
}

fn decode_variant(value: Json) -> Result[SemanticVariant, str] {
    let fields = record(value, 4_usize)?
    ret Result::Ok(SemanticVariant {
            text(fields.get(0_usize).unwrap_or(Json::Null))?, text(fields.get(1_usize).unwrap_or(Json::Null))?, text(fields.get(2_usize).unwrap_or(Json::Null))?, read_strings(fields.get(3_usize).unwrap_or(Json::Null))?
        }
    )
}

pub fn encode_semantic_environment(value: StoredSemanticEnvironment) -> Json {
    let mut callables = Vec[Json]::new()
    for item in value.callables {
        callables.push(encode_callable(item))
    }
    let mut fields = Vec[Json]::new()
    for item in value.fields {
        fields.push(encode_field(item))
    }
    let mut methods = Vec[Json]::new()
    for item in value.methods {
        methods.push(encode_method(item))
    }
    let mut variants = Vec[Json]::new()
    for item in value.variants {
        variants.push(encode_variant(item))
    }
    let mut names = Vec[Json]::new()
    for item in value.names {
        names.push(Json::Array(vec![Json::String(item.scope), Json::String(item.name),
                    Json::String(item.identity), Json::String(item.display), Json::String(item.declaration)]))
    }
    ret Json::Array(vec![Json::String("semantic-environment-1"), Json::Array(callables), Json::Array(fields),
            Json::Array(methods), strings(value.aggregates), strings(value.constructors), Json::Array(variants), Json::Array(names)])
}
pub fn decode_semantic_environment(value: Json) -> Result[StoredSemanticEnvironment, str] {
    let row = record(value, 8_usize)?
    if text(row.get(0_usize).unwrap_or(Json::Null))? != "semantic-environment-1" {
        ret Result::Err("unsupported environment schema")
    }
    let mut callables = Vec[SemanticCallable]::new()
    for item in array(row.get(1_usize).unwrap_or(Json::Null))? {
        callables.push(decode_callable(item)?)
    }
    let mut fields = Vec[SemanticField]::new()
    for item in array(row.get(2_usize).unwrap_or(Json::Null))? {
        fields.push(decode_field(item)?)
    }
    let mut methods = Vec[SemanticMethod]::new()
    for item in array(row.get(3_usize).unwrap_or(Json::Null))? {
        methods.push(decode_method(item)?)
    }
    let mut variants = Vec[SemanticVariant]::new()
    for item in array(row.get(6_usize).unwrap_or(Json::Null))? {
        variants.push(decode_variant(item)?)
    }
    let mut names = Vec[TypeNameBinding]::new()
    for item in array(row.get(7_usize).unwrap_or(Json::Null))? {
        let value = record(item, 5_usize)?
        names.push(TypeNameBinding {
                text(value.get(0_usize).unwrap_or(Json::Null))?, text(value.get(1_usize).unwrap_or(Json::Null))?,
                text(value.get(2_usize).unwrap_or(Json::Null))?, text(value.get(3_usize).unwrap_or(Json::Null))?, text(value.get(4_usize).unwrap_or(Json::Null))?
            }
        )
    }
    ret Result::Ok(StoredSemanticEnvironment {
            callables, fields, methods,
            read_strings(row.get(4_usize).unwrap_or(Json::Null))?, read_strings(row.get(5_usize).unwrap_or(Json::Null))?, variants, names
        }
    )
}
