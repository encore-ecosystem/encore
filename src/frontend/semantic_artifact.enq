//! Portable declaration records; runtime lookup indexes are rebuilt after decoding.
import std::vec::Vec
import json::Json

import refrain::frontend::hir::TypeId
import refrain::frontend::semantic::{SemanticCallable, SemanticField, SemanticMethod, SemanticVariant}
import refrain::frontend::type_scope::TypeNameBinding

pub struct ModuleSemanticView {
    module_name: str
    context: str
    callables: Vec[usize]
    fields: Vec[usize]
    methods: Vec[usize]
    variants: Vec[usize]
    names: Vec[usize]
    aggregates: Vec[str]
    constructors: Vec[str]
}
pub struct CallableBinding {
    declaration: usize
    name: str
    lookup_module: str
    identity: u64
}
pub struct SemanticIndexArtifact {
    schema: u32
    identity: str
    types: Vec[TypeId]
    declarations: Vec[SemanticCallable]
    bindings: Vec[CallableBinding]
    fields: Vec[SemanticField]
    methods: Vec[SemanticMethod]
    variants: Vec[SemanticVariant]
    names: Vec[TypeNameBinding]
    modules: Vec[ModuleSemanticView]
}

/// Body replay is independent of declaration indexes and contains no handles.
pub struct SemanticModuleRecord {
    schema: u32
    index: str
    replay: Json
}
