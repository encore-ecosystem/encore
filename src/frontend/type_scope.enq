//! Separates module-scoped type names from internal nominal identities.
import refrain::frontend::semantic_slice::SemanticSlice

import core::option::Option
import core::vec::Vec

import std::dict::Hashable

pub struct TypeNameBinding {
    scope: str
    name: str
    identity: str
    display: str
    declaration: str
}

/// An immutable, collision-checked index for one exact set of type bindings.
/// Slots contain checked vector ordinals, never native pointers or persisted
/// process-local handles. Duplicate bindings keep the original first winner.
pub struct TypeScopeIndex {
    names: SemanticSlice[TypeNameBinding]
    slots: Vec[usize]
}

pub fn type_scope_index_view(names: SemanticSlice[TypeNameBinding]) -> TypeScopeIndex {
    let mut slots = Vec[usize]::new()
    if names.is_empty() || names.len() > 1000000_usize {
        ret TypeScopeIndex { names, slots }
    }
    let mut capacity = 16_usize
    while capacity < names.len() * 2_usize {
        capacity *= 2_usize
    }
    for _index in 0_usize..capacity {
        slots.push(0_usize)
    }
    for ordinal in 0_usize..names.len() {
        let binding = names.get_unchecked_borrowed(ordinal)
        let mut slot = binding_hash(binding.scope, binding.name) as usize % capacity
        loop {
            let previous = slots.get(slot).unwrap_or(0_usize)
            if previous == 0_usize {
                slots.set(slot, ordinal + 1_usize)
                break
            }
            let existing = names.get_unchecked_borrowed(previous - 1_usize)
            if existing.scope == binding.scope && existing.name == binding.name {
                break
            }
            slot =(slot + 1_usize) % capacity
        }
    }
    ret TypeScopeIndex { names, slots }
}

fn binding_hash(scope: str, name: str) -> u64 {
    ret scope.hash() ^(name.hash() * 1099511628211_u64)
}

fn indexed_binding(index: TypeScopeIndex, scope: str, name: str) -> usize {
    if index.slots.is_empty() {
        ret 0_usize
    }
    let capacity = index.slots.len()
    let mut slot = binding_hash(scope, name) as usize % capacity
    for _probe in 0_usize..capacity {
        let ordinal = index.slots.get(slot).unwrap_or(0_usize)
        if ordinal == 0_usize {
            ret 0_usize
        }
        match index.names.get(ordinal - 1_usize) {
            Some(binding) => {
                if binding.scope == scope && binding.name == name {
                    ret ordinal
                }
            }
            None => {
                ret 0_usize
            }
        }
        slot =(slot + 1_usize) % capacity
    }
    ret 0_usize
}

/// Same lookup and generic/prelude precedence as scope_type_view, amortizing the
/// environment scan over every signature in the module's checked snapshot.
pub fn scope_type_indexed(typ: str, scope: str, index: TypeScopeIndex, generics: Vec[str]) -> str {
    if index.slots.is_empty() {
        ret scope_type_view(typ, scope, index.names, generics)
    }
    let mut out = ""
    let mut offset = 0_usize
    while offset < typ.byte_len() {
        if !identifier(typ.byte_at(offset)) {
            let start = offset
            while offset < typ.byte_len() && !identifier(typ.byte_at(offset)) {
                offset += 1_usize
            }
            out += typ.slice_bytes(start, offset - start)
            continue
        }
        let start = offset
        while offset < typ.byte_len() && identifier(typ.byte_at(offset)) {
            offset += 1_usize
        }
        while offset + 2_usize < typ.byte_len() && typ.slice_bytes(offset, 2_usize) == "::"
        && identifier(typ.byte_at(offset + 2_usize)) {
            offset += 2_usize
            while offset < typ.byte_len() && identifier(typ.byte_at(offset)) {
                offset += 1_usize
            }
        }
        let word = typ.slice_bytes(start, offset - start)
        let mut generic = false
        for name in generics {
            if name == word {
                generic = true break
            }
        }
        let mut ordinal = 0_usize
        if !generic {
            ordinal = indexed_binding(index, scope, word)
            if ordinal == 0_usize {
                ordinal = indexed_binding(index, "", word)
            }
        }
        out += if ordinal == 0_usize {
            word
        } else {
            index.names.get_unchecked_borrowed(ordinal - 1_usize).identity
        }
    }
    ret out
}

/// Selects a declaration's namespace once before normalizing its signatures.
pub fn names_in_scope_view(names: SemanticSlice[TypeNameBinding], scope: str) -> Vec[TypeNameBinding] {
    let mut selected = Vec[TypeNameBinding]::new()
    for binding in names {
        if binding.scope == scope || binding.scope == "" {
            selected.push(binding)
        }
    }
    ret selected
}

/// Preserves the declaration spelling for legacy language-library operations.
/// Unlike display_type_view this does not substitute a consumer's import alias.
pub fn declaration_type_name_view(typ: str, names: SemanticSlice[TypeNameBinding]) -> str {
    for binding in names {
        if binding.identity == typ {
            ret binding.declaration
        }
    }
    ret typ
}

fn identifier(byte: u8) -> bool {
    ret(byte >= 65_u8 && byte <= 90_u8) ||(byte >= 97_u8 && byte <= 122_u8)
    ||(byte >= 48_u8 && byte <= 57_u8) || byte == 95_u8 || byte >= 128_u8
}

/// Resolves all nominal components, including those inside generic arguments.
pub fn scope_type_view(typ: str, scope: str, names: SemanticSlice[TypeNameBinding], generics: Vec[str]) -> str {
    if names.len() == 0_usize {
        ret typ
    }
    let mut out = ""
    let mut index = 0_usize
    while index < typ.byte_len() {
        if !identifier(typ.byte_at(index)) {
            out += typ.slice_bytes(index, 1_usize)
            index += 1_usize
            continue
        }
        let start = index
        while index < typ.byte_len() && identifier(typ.byte_at(index)) {
            index += 1_usize
        }
        while index + 2_usize < typ.byte_len() && typ.slice_bytes(index, 2_usize) == "::"
        && identifier(typ.byte_at(index + 2_usize)) {
            index += 2_usize
            while index < typ.byte_len() && identifier(typ.byte_at(index)) {
                index += 1_usize
            }
        }
        let word = typ.slice_bytes(start, index - start)
        let mut generic = false
        for name in generics {
            if name == word {
                generic = true break
            }
        }
        let mut replacement = word
        if !generic {
            let mut resolved = false
            for binding in names {
                if binding.scope == scope && binding.name == word {
                    replacement = binding.identity
                    resolved = true
                    break
                }
            }
            // Explicit names (including local declarations and aliases) win.
            // The core prelude is a fallback, not a spelling-based exemption
            // from nominal checking.
            if !resolved {
                for binding in names {
                    if binding.scope == "" && binding.name == word {
                        replacement = binding.identity
                        break
                    }
                }
            }
        }
        out += replacement
    }
    ret out
}

/// Renders opaque nominal tokens without changing the analysis representation.
pub fn display_type_view(typ: str, names: SemanticSlice[TypeNameBinding]) -> str {
    // Async expression types are symbolic futures, not the output type itself.
    // Present the wrapper without exposing the analysis-only reserved spelling.
    let typ = display_async_futures(typ)
    let mut marker = 0_usize
    while marker < typ.byte_len() && typ.byte_at(marker) != 64_u8 {
        marker += 1_usize
    }
    if marker == typ.byte_len() {
        ret typ
    }
    let mut out = ""
    let mut index = 0_usize
    while index < typ.byte_len() {
        if typ.byte_at(index) != 64_u8 {
            out += typ.slice_bytes(index, 1_usize)
            index += 1_usize
            continue
        }
        let start = index
        index += 1_usize
        while index < typ.byte_len() && typ.byte_at(index) >= 48_u8 && typ.byte_at(index) <= 57_u8 {
            index += 1_usize
        }
        let word = typ.slice_bytes(start, index - start)
        let mut replacement = word
        for binding in names {
            if binding.identity == word {
                replacement = binding.display break
            }
        }
        out += replacement
    }
    ret out
}

fn display_async_futures(typ: str) -> str {
    let marker = "__encore_async_future["
    let mut start = 0_usize
    while start + marker.byte_len() <= typ.byte_len() && typ.slice_bytes(start, marker.byte_len()) != marker {
        start += 1_usize
    }
    if start + marker.byte_len() > typ.byte_len() {
        ret typ
    }
    let mut out = typ.slice_bytes(0_usize, start)
    let mut index = start
    while index < typ.byte_len() {
        if index + marker.byte_len() <= typ.byte_len() && typ.slice_bytes(index, marker.byte_len()) == marker {
            out += "Future["
            index += marker.byte_len()
        } else {
            out += typ.slice_bytes(index, 1_usize)
            index += 1_usize
        }
    }
    ret out
}

// Source-compatible vector adapters for analysis and editor callers.
pub fn type_scope_index(names: Vec[TypeNameBinding]) -> TypeScopeIndex {
    ret type_scope_index_view(SemanticSlice::from_vec(names))
}

pub fn names_in_scope(names: Vec[TypeNameBinding], scope: str) -> Vec[TypeNameBinding] {
    ret names_in_scope_view(SemanticSlice::from_vec(names), scope)
}

pub fn declaration_type_name(typ: str, names: Vec[TypeNameBinding]) -> str {
    ret declaration_type_name_view(typ, SemanticSlice::from_vec(names))
}

pub fn scope_type(typ: str, scope: str, names: Vec[TypeNameBinding], generics: Vec[str]) -> str {
    ret scope_type_view(typ, scope, SemanticSlice::from_vec(names), generics)
}

pub fn display_type(typ: str, names: Vec[TypeNameBinding]) -> str {
    ret display_type_view(typ, SemanticSlice::from_vec(names))
}
