//! Separates module-scoped type names from internal nominal identities.

import core::vec::Vec

pub struct TypeNameBinding {
    scope: str
    name: str
    identity: str
    display: str
    declaration: str
}

/// Selects a declaration's namespace once before normalizing its signatures.
pub fn names_in_scope(names: Vec[TypeNameBinding], scope: str) -> Vec[TypeNameBinding] {
    let mut selected = Vec[TypeNameBinding]::new()
    for binding in names {
        if binding.scope == scope {
            selected.push(binding)
        }
    }
    ret selected
}

/// Preserves the declaration spelling for legacy language-library operations.
/// Unlike display_type this does not substitute a consumer's import alias.
pub fn declaration_type_name(typ: str, names: Vec[TypeNameBinding]) -> str {
    for binding in names {
        if binding.identity == typ {
            ret binding.declaration
        }
    }
    ret typ
}

fn identifier(byte: u8) -> bool {
    ret(byte >= 65_u8 && byte <= 90_u8) ||(byte >= 97_u8 && byte <= 122_u8)
    ||(byte >= 48_u8 && byte <= 57_u8) || byte == 95_u8 || byte >= 128_u8
}

/// Resolves all nominal components, including those inside generic arguments.
pub fn scope_type(typ: str, scope: str, names: Vec[TypeNameBinding], generics: Vec[str]) -> str {
    if names.len() == 0_usize {
        ret typ
    }
    let mut out = ""
    let mut index = 0_usize
    while index < typ.byte_len() {
        if !identifier(typ.byte_at(index)) {
            out += typ.slice_bytes(index, 1_usize)
            index += 1_usize
            continue
        }
        let start = index
        while index < typ.byte_len() && identifier(typ.byte_at(index)) {
            index += 1_usize
        }
        while index + 2_usize < typ.byte_len() && typ.slice_bytes(index, 2_usize) == "::"
        && identifier(typ.byte_at(index + 2_usize)) {
            index += 2_usize
            while index < typ.byte_len() && identifier(typ.byte_at(index)) {
                index += 1_usize
            }
        }
        let word = typ.slice_bytes(start, index - start)
        let mut generic = false
        for name in generics {
            if name == word {
                generic = true break
            }
        }
        let mut replacement = word
        if !generic {
            for binding in names {
                if binding.scope == scope && binding.name == word {
                    replacement = binding.identity
                    break
                }
            }
        }
        out += replacement
    }
    ret out
}

/// Renders opaque nominal tokens without changing the analysis representation.
pub fn display_type(typ: str, names: Vec[TypeNameBinding]) -> str {
    let mut marker = 0_usize
    while marker < typ.byte_len() && typ.byte_at(marker) != 64_u8 {
        marker += 1_usize
    }
    if marker == typ.byte_len() {
        ret typ
    }
    let mut out = ""
    let mut index = 0_usize
    while index < typ.byte_len() {
        if typ.byte_at(index) != 64_u8 {
            out += typ.slice_bytes(index, 1_usize)
            index += 1_usize
            continue
        }
        let start = index
        index += 1_usize
        while index < typ.byte_len() && typ.byte_at(index) >= 48_u8 && typ.byte_at(index) <= 57_u8 {
            index += 1_usize
        }
        let word = typ.slice_bytes(start, index - start)
        let mut replacement = word
        for binding in names {
            if binding.identity == word {
                replacement = binding.display break
            }
        }
        out += replacement
    }
    ret out
}
