//! Stable source operator identities; boolean operators remain control flow.
pub fn operator_trait(operator: str) -> str {
    ret match operator {
        "+" => "Add"
        "-" => "Sub"
        "*" => "Mul"
        "/" => "Div"
        "%" => "Rem"
        "**" => "Pow"
        "&" => "BitAnd"
        "|" => "BitOr"
        "^" => "BitXor"
        "<<" => "Shl"
        ">>" => "Shr"
        "==" => "Eq"
        "!=" => "Ne"
        "<" => "Lt"
        "<=" => "Le"
        ">" => "Gt"
        ">=" => "Ge"
        _ => ""
    }
}

pub fn operator_method(trait_name: str) -> str {
    ret match trait_name {
        "Add" => "op"
        "Div" => "div"
        "Pow" => "pow"
        "Sub" => "__encore_op_sub"
        "Mul" => "__encore_op_mul"
        "Rem" => "__encore_op_rem"
        "BitAnd" => "__encore_op_bitand"
        "BitOr" => "__encore_op_bitor"
        "BitXor" => "__encore_op_bitxor"
        "Shl" => "__encore_op_shl"
        "Shr" => "__encore_op_shr"
        "Eq" => "__encore_op_eq"
        "Ne" => "__encore_op_ne"
        "Lt" => "__encore_op_lt"
        "Le" => "__encore_op_le"
        "Gt" => "__encore_op_gt"
        "Ge" => "__encore_op_ge"
        _ => "op"
    }
}

pub fn arithmetic_trait(name: str) -> bool {
    ret name == "Add" || name == "Sub" || name == "Mul" || name == "Div" ||
    name == "Rem" || name == "Pow" || name == "BitAnd" || name == "BitOr" ||
    name == "BitXor" || name == "Shl" || name == "Shr"
}

pub fn comparison_trait(name: str) -> bool {
    ret name == "Eq" || name == "Ne" || name == "Lt" || name == "Le" || name == "Gt" || name == "Ge"
}
