//! Performs semantic validation of Encore programs.

import refrain::frontend::parser::statements::Statement
import core::option::Option
import std::vec::Vec
import std::io::println
import refrain::frontend::semantic::check_module_declarations
import refrain::target::{TargetSpec, host_target}

/// Performs the `run_semantic_checks` operation.
pub fn run_semantic_checks(ast: Vec[Statement]) -> bool {
    match semantic_check_error(ast) {
        Option[str]::Some(message) => {
            println("Semantic error: " + message)
            ret false
        }
        Option[str]::None => {}
    }
    ret true
}

/// Performs the `semantic_check_error` operation.
pub fn semantic_check_error(ast: Vec[Statement]) -> Option[str] {
    ret semantic_check_error_for_target(ast, host_target())
}

/// Performs the `semantic_check_error_for_target` operation.
pub fn semantic_check_error_for_target(ast: Vec[Statement], target: TargetSpec) -> Option[str] {
    ret semantic_check_error_for_target_and_features(ast, target, Vec[str]::new())
}

/// Performs the `semantic_check_error_for_target_and_features` operation.
pub fn semantic_check_error_for_target_and_features(ast: Vec[Statement], target: TargetSpec, features: Vec[str]) -> Option[str] {
    if check_module_declarations(ast, target, features).len() > 0_usize { ret Option[str]::Some("duplicate function declarations") }
    ret Option[str]::None
}
