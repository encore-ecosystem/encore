//! Ephemeral monotone safety formulas. No syntax or mutable analysis handles
//! are retained by a finished plan, and no plan is serialized into replay.
import std::vec::Vec

struct SafetyFormula {
    source: usize
    left: usize
    right: usize
    is_source: bool
}

pub struct SafetyEffectPlan {
    body_true: bool
    body_sources: Vec[usize]
    returned_true: bool
    returned_sources: Vec[usize]
    dependencies: Vec[(str, str, str)]
}

pub struct SafetyPlanBuilder {
    nodes: Vec[SafetyFormula]
}

impl for SafetyPlanBuilder {
    pub fn new() -> Self {
        ret Self {
            vec![SafetyFormula { 0_usize, 0_usize, 0_usize, false },
                SafetyFormula { 0_usize, 0_usize, 0_usize, false }]
        }
    }
    pub fn source(self: mut Self, source: usize) -> usize {
        let position = self.nodes.len()
        self.nodes.push(SafetyFormula { source, 0_usize, 0_usize, true })
        ret position
    }
    pub fn join(self: mut Self, left: usize, right: usize) -> usize {
        if left == 1_usize || right == 1_usize {
            ret 1_usize
        }
        if left == 0_usize || left == right {
            ret right
        }
        if right == 0_usize {
            ret left
        }
        let position = self.nodes.len()
        self.nodes.push(SafetyFormula { 0_usize, left, right, false })
        ret position
    }
    fn sources(self: Self, root: usize) ->(bool, Vec[usize]) {
        let mut sources = Vec[usize]::new()
        if root >= self.nodes.len() {
            ret(true, sources)
        }
        if root == 1_usize {
            ret(true, sources)
        }
        if root == 0_usize {
            ret(false, sources)
        }
        let mut visited = Vec[bool]::with_capacity(self.nodes.len())
        for _index in 0_usize..self.nodes.len() {
            visited.push(false)
        }
        let mut pending = vec![root]
        while !pending.is_empty() {
            let position = pending.pop().unwrap_or(0_usize)
            if position >= self.nodes.len() {
                ret(true, Vec[usize]::new())
            }
            if position <= 1_usize || visited.get_unchecked_borrowed(position) {
                continue
            }
            visited.set(position, true)
            let node = self.nodes.get_unchecked_borrowed(position)
            if node.is_source {
                sources.push(node.source)
            } else {
                pending.push(node.right) pending.push(node.left)
            }
        }
        ret(false, sources)
    }
    pub fn finish(self: Self, body: usize, returned: usize, dependencies: Vec[(str, str, str)]) -> SafetyEffectPlan {
        let executed = self.sources(body)
        let result = self.sources(returned)
        ret SafetyEffectPlan { executed.0, executed.1, result.0, result.1, dependencies }
    }
}
