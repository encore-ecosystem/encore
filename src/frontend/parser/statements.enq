//! Provides the `statements` module.

import core::option::Option
import std::vec::Vec

/// Stores the state of a `Documentation` value.
pub struct Documentation {
    text: str
    line: usize
    column: usize
}

impl for Documentation {
    /// Creates a new value with its default initial state.
    pub fn new(text: str, line: usize, column: usize) -> Self {
        ret Self {
            text, line, column
        }
    }
}

/// Stores the state of a `FunctionParam` value.
pub struct FunctionParam {
    name: str
    typ: Option[str]
    is_sending: bool
    is_frozen: bool
}

/// Stores one decorator expression attached to a function declaration.
pub struct DecoratorApplication {
    expression: ExprNode
}

/// Stores the state of a `NamedField` value.
pub struct NamedField {
    name: str
    typ: str
    documentation: Option[Documentation]
}

/// Stores the state of a `TraitBound` value.
pub struct TraitBound {
    path: str
    args: Vec[str]
}

/// Stores the state of a `GenericParam` value.
pub struct GenericParam {
    name: str
    bounds: Vec[TraitBound]
}

/// Stores the state of a `ParsedEnumVariant` value.
pub struct ParsedEnumVariant {
    name: str
    documentation: Option[Documentation]
    generics: Vec[GenericParam]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[str]
    is_tuple: bool
    is_unit: bool
}

/// Stores the state of a `ImportStmt` value.
pub struct ImportStmt {
    is_public: bool
    path: str
    documentation: Option[Documentation]
}

/// Stores the state of a `StructStmt` value.
pub struct StructStmt {
    is_public: bool
    name: str
    documentation: Option[Documentation]
    generics: Vec[GenericParam]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[str]
    is_tuple: bool
    is_unit: bool
}

/// Stores the state of a `EnumStmt` value.
pub struct EnumStmt {
    is_public: bool
    name: str
    documentation: Option[Documentation]
    generics: Vec[GenericParam]
    variants: Vec[ParsedEnumVariant]
}

/// Stores the state of a `FunctionItem` value.
pub struct FunctionItem {
    attrs: Vec[str]
    decorators: Vec[DecoratorApplication]
    is_public: bool
    is_extern: bool
    is_async: bool
    name: str
    documentation: Option[Documentation]
    generics: Vec[GenericParam]
    params: Vec[FunctionParam]
    ret_type: Option[str]
    returns_sending: bool
    returns_frozen: bool
    body: Option[ParsedBlock]
    source_name: str
    line: usize
    column: usize
}

/// Stores the state of a `TraitStmt` value.
pub struct TraitStmt {
    is_public: bool
    name: str
    documentation: Option[Documentation]
    generics: Vec[GenericParam]
    bases: Vec[str]
    methods: Vec[FunctionItem]
    source_name: str
    line: usize
    column: usize
}

/// Stores the state of a `ImplStmt` value.
pub struct ImplStmt {
    documentation: Option[Documentation]
    generics: Vec[GenericParam]
    trait_name: Option[str]
    trait_args: Vec[str]
    target: str
    methods: Vec[FunctionItem]
    source_name: str
    line: usize
    column: usize
}

/// Stores the state of a `MatchPattern` value.
pub struct MatchPattern {
    kind: str
    value: Option[str]
    binding: Option[str]
}

/// Stores the state of a `ExprNode` value.
pub struct ExprNode {
    value: Expr
    line: usize
    column: usize
    length: usize
    source_name: str
}

/// Stores the state of a `ParsedBlock` value.
pub struct ParsedBlock {
    statements: Vec[Statement]
}

/// Stores the state of a `LetStmt` value.
pub struct LetStmt {
    name: str
    typ: Option[str]
    expr: ExprNode
    is_mut: bool
}

/// Stores the state of a `AssignmentStmt` value.
pub struct AssignmentStmt {
    target: ExprNode
    operator: str
    expr: ExprNode
}

/// Stores the state of a `IfBranch` value.
pub struct IfBranch {
    condition: ExprNode
    body: ParsedBlock
}

/// Stores the state of a `IfStmt` value.
pub struct IfStmt {
    branches: Vec[IfBranch]
    else_body: Option[ParsedBlock]
}

/// Represents the possible `MatchArmBody` cases.
pub enum MatchArmBody {
    Block(ParsedBlock)
    Expr(ExprNode)
}

/// Stores the state of a `ParsedMatchArm` value.
pub struct ParsedMatchArm {
    pattern: MatchPattern
    body: MatchArmBody
}

/// Stores the state of a `MatchStmt` value.
pub struct MatchStmt {
    expr: ExprNode
    arms: Vec[ParsedMatchArm]
}

/// Stores the state of a `WhileStmt` value.
pub struct WhileStmt {
    label: Option[str]
    condition: ExprNode
    body: ParsedBlock
}

/// Stores the state of a `LoopStmt` value.
pub struct LoopStmt {
    label: Option[str]
    body: ParsedBlock
}

/// Stores the state of a `DoWhileStmt` value.
pub struct DoWhileStmt {
    body: ParsedBlock
    condition: ExprNode
}

/// Stores the state of a `ForStmt` value.
pub struct ForStmt {
    label: Option[str]
    name: str
    iterable: ExprNode
    body: ParsedBlock
}

/// Stores the state of a `EhirStmt` value.
pub struct EhirStmt {
    is_unsafe: bool
    body: str
}

/// Stores the state of a `UnaryExpr` value.
pub struct UnaryExpr {
    operator: str
    expr: ExprNode < H >
}

/// Stores the state of a `CastExpr` value.
pub struct CastExpr {
    expr: ExprNode < H >
    target: str
}

/// Stores the state of a `BinaryExpr` value.
pub struct BinaryExpr {
    lhs: ExprNode < H >
    operator: str
    rhs: ExprNode < H >
}

/// Stores the state of a `CallExpr` value.
pub struct CallExpr {
    callee: ExprNode < H >
    generics: Vec[str]
    args: Vec[ExprNode]
}

/// Stores the state of a `FieldExpr` value.
pub struct FieldExpr {
    base: ExprNode < H >
    field: str
}

/// Stores the state of a `MethodCallExpr` value.
pub struct MethodCallExpr {
    receiver: ExprNode < H >
    method: str
    generics: Vec[str]
    args: Vec[ExprNode]
}

/// Stores the state of a `MatchExprArm` value.
pub struct MatchExprArm {
    pattern: MatchPattern
    expr: ExprNode
}

/// Stores the state of a `MatchExpr` value.
pub struct MatchExpr {
    expr: ExprNode < H >
    arms: Vec[MatchExprArm]
}

/// Stores the state of a `StructInitExpr` value.
pub struct StructInitExpr {
    path: str
    values: Vec[ExprNode]
}

/// Stores the state of a `TupleLiteralExpr` value.
pub struct TupleLiteralExpr {
    items: Vec[ExprNode]
}

/// Stores the state of a `ArrayLiteralExpr` value.
pub struct ArrayLiteralExpr {
    items: Vec[ExprNode]
}

/// Stores the state of a `ArrayRepeatExpr` value.
pub struct ArrayRepeatExpr {
    value: ExprNode < H >
    size: str
}

/// Stores the state of a `WithStmt` value.
pub struct WithStmt {
    expr: ExprNode
    name: str
    body: ParsedBlock
}

/// Stores the state of a `BlockExpr` value.
pub struct BlockExpr {
    statements: Vec[Statement]
    tail: Option[ExprNode < H >]
}

/// Stores the state of a `IfExprBranch` value.
pub struct IfExprBranch {
    condition: ExprNode
    body: ExprNode
}

/// Stores the state of a `IfExpr` value.
pub struct IfExpr {
    branches: Vec[IfExprBranch]
    else_body: ExprNode < H >
}

/// Stores the state of a `IndexExpr` value.
pub struct IndexExpr {
    base: ExprNode < H >
    index: ExprNode < H >
}

/// Stores a pipe closure. Parameter types may be omitted when the closure is
/// used where a single-method dynamic trait supplies the callable signature.
pub struct ClosureExpr {
    params: Vec[FunctionParam]
    body: ExprNode < H >
}

/// Represents the possible `Statement` cases.
pub enum Statement {
    Import(ImportStmt)
    EnumItem(EnumStmt)
    Struct(StructStmt)
    Trait(TraitStmt)
    Impl(ImplStmt)
    Function(FunctionItem)
    Let(LetStmt)
    Ret(ExprNode)
    Expr(ExprNode)
    If(IfStmt)
    Match(MatchStmt)
    Assignment(AssignmentStmt)
    While(WhileStmt)
    Loop(LoopStmt)
    DoWhile(DoWhileStmt)
    For(ForStmt)
    With(WithStmt)
    Unsafe(ParsedBlock)
    Ehir(EhirStmt)
    Break(Option[str])
    Continue(Option[str])
}

/// Represents the possible `Expr` cases.
pub enum Expr {
    Path(str)
    VecLiteral(ArrayLiteralExpr)
    Boolean(bool)
    Integer(str)
    Float(str)
    StringLiteral(str)
    Parenthesized(ExprNode < H >)
    TupleLiteral(TupleLiteralExpr)
    ArrayLiteral(ArrayLiteralExpr)
    ArrayRepeat(ArrayRepeatExpr)
    Block(BlockExpr)
    Unary(UnaryExpr)
    Await(ExprNode < H >)
    Spawn(ExprNode < H >)
    Cast(CastExpr)
    Binary(BinaryExpr)
    Call(CallExpr)
    Field(FieldExpr)
    MethodCall(MethodCallExpr)
    Match(MatchExpr)
    If(IfExpr)
    StructInit(StructInitExpr)
    Index(IndexExpr)
    Closure(ClosureExpr)
    Try(ExprNode < H >)
    Unsafe(ParsedBlock)
}
