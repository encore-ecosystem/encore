//! Parses Encore tokens into the compiler syntax tree.

import refrain::frontend::lexer::Lexer
import refrain::frontend::lexer::Token
import refrain::frontend::lexer::TokenType

import mod::statements:: *

import core::fmt::Debug
import core::option::Option
import std::io::eprintln
import std::process::exit
import std::vec::Vec

struct MacroArgument {
    tokens: Vec[Token]
}

fn parser_error(message: str) ->() {
    eprintln("error[parse]: " + message)
    exit(1_i32)
    ret()
}

fn inferred_static_initializer_type(expression: ExprNode) -> Option[str] {
    match expression.value {
        Expr::StringLiteral(_) => {
            ret Option[str]::Some("str")
        }
        Expr::Boolean(_) => {
            ret Option[str]::Some("bool")
        }
        Expr::StructInit(item) => {
            ret Option[str]::Some(item.path)
        }
        Expr::Call(call) => {
            match call.callee.value {
                Expr::Path(name) => {
                    if name.len() > 5_usize && name.slice(name.len() - 5_usize, 5_usize) == "::new" {
                        ret Option[str]::Some(name.slice(0_usize, name.len() - 5_usize))
                    }
                }
                _ => {
                }
            }
        }
        Expr::Parenthesized(inner) => {
            ret inferred_static_initializer_type(ExprNode {
                    inner.value, inner.line, inner.column,
                    inner.length, inner.source_name
                }
                ,)
        }
        _ => {
        }
    }
    ret Option[str]::None
}

fn required_macro_token(tokens: Vec[Token], index: usize) -> Token {
    match tokens.get(index) {
        Some(token) => {
            ret token
        }
        None => {
            parser_error("Malformed macro token stream at " + Debug::fmt(index) + "/" + Debug::fmt(tokens.len()))
        }
    }
    ret Token::new(TokenType::UNKNOWN, "", 0_usize, 0_usize)
}
fn macro_token_value_or_empty(tokens: Vec[Token], index: usize) -> str {
    match tokens.get(index) {
        Some(token) => {
            ret token.value
        }
        None => {
            ret ""
        }
    }
}
fn macro_token_is_identifier(tokens: Vec[Token], index: usize) -> bool {
    match tokens.get(index) {
        Some(token) => {
            ret token.type == TokenType::IDENTIFIER
        }
        None => {
            ret false
        }
    }
}

fn macro_is_open(value: str) -> bool {
    ret value == "(" || value == "[" || value == "{"
}
fn macro_close_for(value: str) -> str {
    if value == "(" {
        ret ")"
    }
    if value == "[" {
        ret "]"
    }
    if value == "{" {
        ret "}"
    }
    ret ""
}

fn macro_matching_close(tokens: Vec[Token], open: usize) -> usize {
    let opening = required_macro_token(tokens, open).value
    let closing = macro_close_for(opening)
    if closing == "" {
        parser_error("Macro delimiter expected")
    }
    let mut depth = 1_usize
    let mut index = open + 1_usize
    while index < tokens.len() {
        let value = required_macro_token(tokens, index).value
        if value == opening {
            depth = depth + 1_usize
        } elif value == closing {
            depth = depth - 1_usize
            if depth == 0_usize {
                ret index
            }
        }
        index = index + 1_usize
    }
    parser_error("Unclosed macro delimiter")
    ret tokens.len()
}

fn macro_split_arguments(tokens: Vec[Token], start: usize, end: usize) -> Vec[MacroArgument] {
    let mut out = Vec[MacroArgument]::new()
    if start >= end {
        ret out
    }
    let mut current = Vec[Token]::new()
    let mut depth = 0_usize
    let mut index = start
    while index < end {
        let token = required_macro_token(tokens, index)
        if macro_is_open(token.value) {
            depth = depth + 1_usize
        } elif token.value == ")" || token.value == "]" || token.value == "}" {
            if depth > 0_usize {
                depth = depth - 1_usize
            }
        }
        if token.value == "," && depth == 0_usize {
            out.push(MacroArgument {
                    current
                }
            )
            current = Vec[Token]::new()
        } else {
            current.push(token)
        }
        index = index + 1_usize
    }
    out.push(MacroArgument {
            current
        }
    )
    ret out
}

fn macro_argument_for(definition: BootstrapMacro, args: Vec[MacroArgument], name: str) -> Vec[Token]
{
    let mut index = 0_usize
    while index < definition.params.len() {
        match definition.params.get(index) {
            Some(param) => {
                if param == name {
                    match args.get(index) {
                        Some(arg) => {
                            ret arg.tokens
                        }
                        None => {
                        }
                    }
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret Vec[Token]::new()
}

fn expand_macro_template_once(definition: BootstrapMacro, template: Vec[Token], args: Vec[MacroArgument])
-> Vec[Token] {
    let mut out = Vec[Token]::new()
    let mut index = 0_usize
    while index < template.len() {
        let token = required_macro_token(template, index)
        if token.value == "$" && index + 1_usize < template.len() {
            let name = required_macro_token(template, index + 1_usize).value
            if name != "(" {
                out.extend(macro_argument_for(definition, args, name))
                index = index + 2_usize
                continue
            }
        }
        out.push(token)
        index = index + 1_usize
    }
    ret out
}

fn expand_bootstrap_macro(definition: BootstrapMacro, args: Vec[MacroArgument]) -> Vec[Token] {
    if !definition.variadic {
        ret expand_macro_template_once(definition, definition.template, args)
    }
    let template = definition.template
    let mut repeat_open = template.len()
    let mut index = 0_usize
    while index + 1_usize < template.len() {
        if required_macro_token(template, index).value == "$" && required_macro_token(template, index
            + 1_usize,).value == "(" {
            repeat_open = index + 1_usize break
        }
        index = index + 1_usize
    }
    if repeat_open >= template.len() {
        ret expand_macro_template_once(definition, template, args)
    }
    let repeat_close = macro_matching_close(template, repeat_open)
    let mut body = Vec[Token]::new()
    index = repeat_open + 1_usize
    while index < repeat_close {
        body.push(required_macro_token(template, index)) index = index + 1_usize
    }
    let mut out = Vec[Token]::new()
    index = 0_usize
    while index + 1_usize < args.len() || index < args.len() {
        let mut single_args = Vec[MacroArgument]::new()
        match args.get(index) {
            Some(arg) => {
                single_args.push(arg)
            }
            None => {
            }
        }
        out.extend(expand_macro_template_once(definition, body, single_args))
        if index + 1_usize < args.len() && repeat_close + 1_usize < template.len() {
            out.push(required_macro_token(template, repeat_close + 1_usize))
        }
        index = index + 1_usize
    }
    ret out
}

struct BootstrapMacro {
    name: str
    params: Vec[str]
    template: Vec[Token]
    variadic: bool
}

/// Parses a token stream into Encore syntax-tree statements.
pub struct Parser {
    source_name: str
    tokens: Vec[Token]
    consumed: usize
    ast: Vec[Statement]
    parsing_match_header: bool
    parsing_control_flow_header: bool
    parsing_with_binding_expr: bool
    macros: Vec[BootstrapMacro]
}

impl for Parser {
    /// Creates a parser without a diagnostic source name.
    pub fn new() -> Parser {
        ret Parser::new_for_source("")
    }

    /// Creates a parser that reports errors against `source_name`.
    pub fn new_for_source(source_name: str) -> Parser {
        ret Parser {
            source_name,
            Vec[Token]::new(),
            0_usize,
            Vec[Statement]::new(),
            false,
            false,
            false,
            Vec[BootstrapMacro]::new()
        }
    }

    fn error_at(mut self, message: str, token: Token) ->() {
        let location = if self.source_name == "" {
            ""
        } else {
            self.source_name + ":"
        }
        eprintln(location + Debug::fmt(token.line + 1_usize) + ":" + Debug::fmt(token.column + 1_usize)
            + ": error[parse]: " + message)
        exit(1_i32)
        ret()
    }

    /// Parses a complete token stream into top-level statements.
    pub fn parse(mut self, tokens: Vec[Token]) -> Vec[Statement] {
        self.macros = Vec[BootstrapMacro]::new()
        self.tokens = self.expand_macro_program(tokens)
        self.consumed = 0_usize
        self.ast = Vec[Statement]::new()
        self.parsing_match_header = false
        self.parsing_control_flow_header = false
        self.parsing_with_binding_expr = false

        loop {
            if self.is_at_end() {
                break
            }
            let statement = self.parse_top_level()
            self.ast.push(statement)
        }

        ret self.ast
    }

    fn expand_macro_program(mut self, input: Vec[Token]) -> Vec[Token] {
        let mut cleaned = Vec[Token]::new()
        let mut index = 0_usize
        while index < input.len() {
            let token = required_macro_token(input, index)
            if token.type == TokenType::IDENTIFIER && token.value == "macro_" + "rules" && index + 3_usize
            < input.len()
            && macro_token_value_or_empty(input, index + 1_usize) == "!"
            && macro_token_is_identifier(input, index + 2_usize)
            && macro_token_value_or_empty(input, index + 3_usize) == "{" {
                let name = required_macro_token(input, index + 2_usize).value
                let outer_open = index + 3_usize
                let outer_close = macro_matching_close(input, outer_open)
                let pattern_open = outer_open + 1_usize
                let pattern_close = macro_matching_close(input, pattern_open)
                let mut template_open = pattern_close + 1_usize
                while template_open < outer_close && !macro_is_open(required_macro_token(input, template_open).value)
                {
                    template_open = template_open + 1_usize
                }
                let template_close = macro_matching_close(input, template_open)
                let mut params = Vec[str]::new()
                let mut variadic = false
                let mut scan = pattern_open + 1_usize
                while scan < pattern_close {
                    if required_macro_token(input, scan).value == "$" && scan + 1_usize < pattern_close
                    {
                        let next = required_macro_token(input, scan + 1_usize).value
                        if next == "(" {
                            variadic = true
                        } elif next != "$" {
                            params.push(next)
                        }
                    }
                    scan = scan + 1_usize
                }
                let mut template = Vec[Token]::new()
                scan = template_open + 1_usize
                while scan < template_close {
                    template.push(required_macro_token(input, scan)) scan = scan + 1_usize
                }
                self.macros.push(BootstrapMacro {
                        name, params, template, variadic
                    }
                    ,
                )
                index = outer_close + 1_usize
                continue
            }
            cleaned.push(token)
            index = index + 1_usize
        }

        if self.macros.len() == 0_usize {
            ret cleaned
        }
        let mut round = 0_usize
        while round < 32_usize {
            let expanded = self.expand_macro_round(cleaned)
            cleaned = expanded.0
            if !expanded.1 {
                break
            }
            round = round + 1_usize
        }
        ret cleaned
    }

    fn expand_macro_round(mut self, input: Vec[Token]) ->(Vec[Token], bool) {
        let mut out = Vec[Token]::new()
        let mut changed = false
        let mut index = 0_usize
        while index < input.len() {
            let token = required_macro_token(input, index)
            let mut found = Option[BootstrapMacro]::None
            if token.type == TokenType::IDENTIFIER && index + 2_usize < input.len() && macro_token_value_or_empty(input,
                index + 1_usize,) == "!" && macro_is_open(macro_token_value_or_empty(input, index + 2_usize))
            {
                for definition in self.macros {
                    if definition.name == token.value {
                        found = Option[BootstrapMacro]::Some(definition)
                    }
                }
            }
            match found {
                Some(definition) => {
                    let open = index + 2_usize
                    let close = macro_matching_close(input, open)
                    let args = macro_split_arguments(input, open + 1_usize, close)
                    out.extend(expand_bootstrap_macro(definition, args))
                    index = close + 1_usize
                    changed = true
                    continue
                }
                None => {
                }
            }
            out.push(token)
            index = index + 1_usize
        }
        ret(out, changed)
    }

    fn mk_expr(mut self, value: Expr) -> ExprNode {
        let token = self.peek_curr()
        ret ExprNode {
            value, token.line, token.column, token.value.char_len(), self.source_name
        }
    }

    fn mk_expr_at(mut self, value: Expr, token: Token) -> ExprNode {
        ret ExprNode {
            value, token.line, token.column, token.value.char_len(), self.source_name
        }
    }

    fn box_expr(mut self, node: ExprNode) -> ExprNode < H > {
        ret ExprNode < H > {
            node.value, node.line, node.column, node.length, node.source_name
        }
    }

    fn parse_top_level(mut self) -> Statement {
        while self.peek_curr_type() == TokenType::MODULE_DOC_COMMENT {
            self.consume()
        }
        let mut documentation = self.parse_documentation()
        let attrs = self.parse_function_attrs()
        let decorators = self.parse_decorator_applications()
        match documentation {
            Option[Documentation]::None => {
                documentation = self.parse_documentation()
            }
            Option[Documentation]::Some(_) => {
            }
        }
        let mut is_public = false
        if self.peek_curr_type() == TokenType::KW_PUB {
            self.consume()
            is_public = true
        }

        let curr_token = self.peek_curr()
        if (attrs.len() > 0_usize || decorators.len() > 0_usize) && curr_token.type != TokenType::KW_FN
        && curr_token.type != TokenType::KW_ASYNC
        && curr_token.type != TokenType::KW_EXTERN && curr_token.type != TokenType::KW_STATIC {
            self.unexpected_token("function after attributes or decorators", curr_token)
        }
        match curr_token.type {
            TokenType::KW_IMPORT => {
                ret self.parse_import(is_public, documentation)
            }
            TokenType::KW_ENUM => {
                ret self.parse_enum(is_public, documentation)
            }
            TokenType::KW_STRUCT => {
                ret self.parse_struct(is_public, documentation)
            }
            TokenType::KW_TRAIT => {
                ret self.parse_trait(is_public, documentation)
            }
            TokenType::KW_IMPL => {
                ret self.parse_impl(documentation)
            }
            TokenType::KW_FN => {
                ret self.parse_fn(is_public, attrs, decorators, documentation)
            }
            TokenType::KW_ASYNC => {
                ret self.parse_fn(is_public, attrs, decorators, documentation)
            }
            TokenType::KW_EXTERN => {
                ret self.parse_extern(is_public, attrs, decorators, documentation)
            }
            TokenType::KW_LET => {
                ret self.parse_global_constant(is_public, documentation)
            }
            TokenType::KW_STATIC => {
                if decorators.len() > 0_usize {
                    self.unexpected_token("function after decorators", curr_token)
                }
                ret self.parse_global_static(is_public, attrs, documentation)
            }
            _ => {
                self.unexpected_token("top-level statement", curr_token)
                ret Statement::Import(ImportStmt {
                        false, "", Option[Documentation]::None
                    }
                    ,
                )
            }
        }
    }

    fn parse_global_constant(mut self, is_public: bool, documentation: Option[Documentation]) -> Statement
    {
        match self.parse_let() {
            Statement::Let(item) => {
                let mut statements = Vec[Statement]::new()
                statements.push(Statement::Ret(item.expr))
                ret Statement::Function(FunctionItem {
                        Vec[str]::new(), Vec[DecoratorApplication]::new(), is_public, false, false, item.name,
                        documentation, Vec[GenericParam]::new(),
                        Vec[FunctionParam]::new(), item.typ, Option[ParsedBlock]::Some(ParsedBlock {
                                statements
                            }
                        ), item.expr.source_name, item.expr.line, item.expr.column
                    }
                    ,)
            }
            _ => {
            }
        }
        ret Statement::Import(ImportStmt {
                false, "", Option[Documentation]::None
            }
            ,
        )
    }

    fn parse_global_static(mut self, is_public: bool, attrs: Vec[str],
        documentation: Option[Documentation],) -> Statement {
        let declaration = self.peek_curr()
        self.safe_consume(TokenType::KW_STATIC)
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let mut typ = Option[str]::None
        if self.peek_curr_type() == TokenType::COLON {
            self.consume()
            typ = Option[str]::Some(self.parse_type())
        }
        self.safe_consume(TokenType::ASSIGN)
        let expression = self.parse_expression()
        match typ {
            None => {
                typ = inferred_static_initializer_type(expression)
            }
            Some(_) => {
            }
        }
        match typ {
            None => {
                self.error_at("static initializer needs an explicit type annotation", declaration)
            }
            Some(_) => {
            }
        }
        let mut static_attrs = attrs
        static_attrs.push("static")
        let mut statements = Vec[Statement]::new()
        statements.push(Statement::Ret(expression))
        ret Statement::Function(FunctionItem {
                static_attrs, Vec[DecoratorApplication]::new(), is_public, false, false, name,
                documentation, Vec[GenericParam]::new(), Vec[FunctionParam]::new(), typ,
                Option[ParsedBlock]::Some(ParsedBlock {
                        statements
                    }
                ), self.source_name,
                declaration.line, declaration.column
            }
            ,)
    }

    fn parse_import(mut self, is_public: bool, documentation: Option[Documentation]) -> Statement {
        self.safe_consume(TokenType::KW_IMPORT)
        let path = self.parse_import_path()
        ret Statement::Import(ImportStmt {
                is_public, path, documentation
            }
            ,
        )
    }

    fn parse_enum(mut self, is_public: bool, documentation: Option[Documentation]) -> Statement {
        self.safe_consume(TokenType::KW_ENUM)
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generic_params()

        let mut variants = Vec[ParsedEnumVariant]::new()
        self.safe_consume(TokenType::LEFT_BRACE)
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }
            let variant_documentation = self.parse_documentation()
            variants.push(self.parse_structure_shape(variant_documentation))
            let curr_type = self.peek_curr_type()
            if curr_type == TokenType::COMMA {
                self.consume()
            } elif curr_type == TokenType::RIGHT_BRACE {
                break
            }
        }
        self.safe_consume(TokenType::RIGHT_BRACE)

        ret Statement::EnumItem(EnumStmt {
                is_public, name, documentation, generics, variants
            }
            ,
        )
    }

    fn parse_struct(mut self, is_public: bool, documentation: Option[Documentation]) -> Statement {
        self.safe_consume(TokenType::KW_STRUCT)
        let shape = self.parse_structure_shape(Option[Documentation]::None)
        ret Statement::Struct(
            StructStmt {
                is_public,
                shape.name,
                documentation,
                shape.generics,
                shape.named_fields,
                shape.tuple_fields,
                shape.is_tuple,
                shape.is_unit
            }
            ,
        )
    }

    fn parse_trait(mut self, is_public: bool, documentation: Option[Documentation]) -> Statement {
        let declaration_token = self.peek_curr()
        self.safe_consume(TokenType::KW_TRAIT)
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generic_params()
        let bases = self.parse_trait_bases()

        let mut methods = Vec[FunctionItem]::new()
        self.safe_consume(TokenType::LEFT_BRACE)
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }
            let mut method_documentation = self.parse_documentation()
            let attrs = self.parse_function_attrs()
            let decorators = self.parse_decorator_applications()
            match method_documentation {
                Option[Documentation]::None => {
                    method_documentation = self.parse_documentation()
                }
                Option[Documentation]::Some(_) => {
                }
            }
            methods.push(self.parse_function_signature(false, attrs, decorators, method_documentation))
        }
        self.safe_consume(TokenType::RIGHT_BRACE)

        ret Statement::Trait(TraitStmt {
                is_public, name, documentation, generics, bases, methods, self.source_name, declaration_token.line,
                declaration_token.column
            }
            ,
        )
    }

    fn parse_impl(mut self, documentation: Option[Documentation]) -> Statement {
        let declaration_token = self.peek_curr()
        self.safe_consume(TokenType::KW_IMPL)
        let generics = self.parse_possible_generic_params()

        let mut trait_name = Option[str]::None
        let mut trait_args = Vec[str]::new()
        if self.peek_curr_type() != TokenType::KW_FOR {
            trait_name = Option[str]::Some(self.safe_consume_value(TokenType::IDENTIFIER))
            trait_args = self.parse_possible_generics()
        }

        self.safe_consume(TokenType::KW_FOR)
        let target = self.parse_type()

        let mut methods = Vec[FunctionItem]::new()
        self.safe_consume(TokenType::LEFT_BRACE)
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }

            let mut method_documentation = self.parse_documentation()
            let attrs = self.parse_function_attrs()
            let decorators = self.parse_decorator_applications()
            match method_documentation {
                Option[Documentation]::None => {
                    method_documentation = self.parse_documentation()
                }
                Option[Documentation]::Some(_) => {
                }
            }
            let mut is_public = false
            if self.peek_curr_type() == TokenType::KW_PUB {
                self.consume()
                is_public = true
            }

            let header = self.parse_function_signature(is_public, attrs, decorators, method_documentation)
            let body = self.parse_block()
            methods.push(
                FunctionItem {
                    header.attrs,
                    header.decorators,
                    header.is_public,
                    header.is_extern,
                    header.is_async,
                    header.name,
                    header.documentation,
                    header.generics,
                    header.params,
                    header.ret_type,
                    Option[ParsedBlock]::Some(body),
                    header.source_name,
                    header.line,
                    header.column
                }
                ,
            )
        }
        self.safe_consume(TokenType::RIGHT_BRACE)

        ret Statement::Impl(ImplStmt {
                documentation, generics, trait_name, trait_args, target, methods, self.source_name, declaration_token.line,
                declaration_token.column
            }
            ,
        )
    }

    fn parse_fn(mut self, is_public: bool, attrs: Vec[str], decorators: Vec[DecoratorApplication], documentation:
        Option[Documentation],) ->
    Statement {
        let header = self.parse_function_signature(is_public, attrs, decorators, documentation)
        if header.is_extern {
            ret Statement::Function(header)
        }
        let body = self.parse_block()
        ret Statement::Function(
            FunctionItem {
                header.attrs,
                header.decorators,
                header.is_public,
                header.is_extern,
                header.is_async,
                header.name,
                header.documentation,
                header.generics,
                header.params,
                header.ret_type,
                Option[ParsedBlock]::Some(body),
                header.source_name,
                header.line,
                header.column
            }
            ,
        )
    }

    fn parse_extern(mut self, is_public: bool, attrs: Vec[str], decorators: Vec[DecoratorApplication],
        documentation: Option[Documentation],)
    -> Statement {
        ret Statement::Function(self.parse_function_signature(is_public, attrs, decorators, documentation))
    }

    fn parse_function_signature(mut self, is_public: bool, attrs: Vec[str], decorators: Vec[DecoratorApplication],
        documentation: Option[Documentation],)
    -> FunctionItem {
        let signature_token = self.peek_curr()
        let mut is_async = false
        if self.peek_curr_type() == TokenType::KW_ASYNC {
            self.consume()
            is_async = true
        }
        let mut is_extern = false
        if self.peek_curr_type() == TokenType::KW_EXTERN {
            self.consume()
            is_extern = true
        }

        self.safe_consume(TokenType::KW_FN)
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generic_params()

        let mut params = Vec[FunctionParam]::new()
        self.safe_consume(TokenType::LEFT_PAREN)
        if self.peek_curr_type() != TokenType::RIGHT_PAREN {
            params.push(self.parse_param())
            loop {
                if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                    break
                }
                self.safe_consume(TokenType::COMMA)
                if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                    break
                }
                params.push(self.parse_param())
            }
        }
        self.safe_consume(TokenType::RIGHT_PAREN)

        let mut ret_type = Option[str]::None
        if self.peek_curr_type() == TokenType::ARROW {
            self.consume()
            ret_type = Option[str]::Some(self.parse_type())
        }

        ret FunctionItem {
            attrs,
            decorators,
            is_public,
            is_extern,
            is_async,
            name,
            documentation,
            generics,
            params,
            ret_type,
            Option[ParsedBlock]::None,
            self.source_name,
            signature_token.line,
            signature_token.column
        }
    }

    fn parse_function_attrs(mut self) -> Vec[str] {
        let mut attrs = Vec[str]::new()
        loop {
            if self.peek_curr_type() != TokenType::HASH {
                break
            }

            let hash_token = self.consume()
            let mut directive = self.metadata_directive(hash_token.value)

            if self.peek_curr_type() == TokenType::IDENTIFIER {
                directive = self.consume_value()
            }

            let args = self.read_metadata_args()
            if directive == "cfg" {
                attrs.push("cfg:" + args)
            } elif directive == "attr" {
                attrs.push(args)
            }
        }
        ret attrs
    }

    fn parse_decorator_applications(mut self) -> Vec[DecoratorApplication] {
        let mut decorators = Vec[DecoratorApplication]::new()
        loop {
            if self.peek_curr_type() != TokenType::AT {
                break
            }
            self.consume()
            decorators.push(DecoratorApplication {
                    self.parse_expression()
                }
            )
        }
        ret decorators
    }

    fn parse_documentation(mut self) -> Option[Documentation] {
        if self.peek_curr_type() != TokenType::DOC_COMMENT {
            ret Option[Documentation]::None
        }
        let first = self.peek_curr()
        let mut text = ""
        let mut previous_line = first.line
        let mut line_count = 0_usize
        loop {
            if self.peek_curr_type() != TokenType::DOC_COMMENT {
                break
            }
            let token = self.peek_curr()
            if token.line > previous_line + 1_usize {
                break
            }
            self.consume()
            let mut line = ""
            if token.value.len() >= 3_usize {
                line = token.value.slice(3_usize, token.value.len() - 3_usize)
            }
            if line.len() > 0_usize && line.slice(0_usize, 1_usize) == " " {
                line = line.slice(1_usize, line.len() - 1_usize)
            }
            if line_count > 0_usize {
                text = text + "\n"
            }
            text = text + line
            line_count += 1_usize
            previous_line = token.line
        }
        ret Option[Documentation]::Some(Documentation::new(text, first.line, first.column))
    }

    fn metadata_directive(mut self, raw: str) -> str {
        if raw.len() > 1_usize {
            ret raw.slice(1_usize, raw.len() - 1_usize)
        }
        ret ""
    }

    fn read_metadata_args(mut self) -> str {
        self.safe_consume(TokenType::LEFT_PAREN)
        let mut depth = 1_usize
        let mut out = ""
        loop {
            if depth == 0_usize {
                break
            }
            let token = self.consume()
            if token.type == TokenType::EOF {
                self.unexpected_token("metadata directive closing paren", token)
            }
            if token.type == TokenType::LEFT_PAREN {
                depth = depth + 1_usize
            } elif token.type == TokenType::RIGHT_PAREN {
                depth = depth - 1_usize
            }
            if depth > 0_usize {
                out = out + token.value
            }
        }
        ret out
    }

    fn parse_structure_shape(mut self, documentation: Option[Documentation]) -> ParsedEnumVariant {
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generic_params()

        if self.peek_curr_type() == TokenType::LEFT_BRACE {
            self.consume()
            let mut named_fields = Vec[NamedField]::new()
            loop {
                if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                    break
                }
                let field_documentation = self.parse_documentation()
                let field_name = self.safe_consume_value(TokenType::IDENTIFIER)
                self.safe_consume(TokenType::COLON)
                let field_type = self.parse_type()
                named_fields.push(NamedField {
                        field_name, field_type, field_documentation
                    }
                    ,
                )
                let curr_type = self.peek_curr_type()
                if curr_type == TokenType::COMMA {
                    self.consume()
                } elif curr_type == TokenType::RIGHT_BRACE {
                    break
                }
            }
            self.safe_consume(TokenType::RIGHT_BRACE)
            ret ParsedEnumVariant {
                name, documentation, generics, named_fields, Vec[str]::new(), false, false
            }
        }

        if self.peek_curr_type() == TokenType::LEFT_PAREN {
            self.consume()
            let mut tuple_fields = Vec[str]::new()
            if self.peek_curr_type() != TokenType::RIGHT_PAREN {
                tuple_fields.push(self.parse_type())
                loop {
                    if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                        break
                    }
                    self.safe_consume(TokenType::COMMA)
                    if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                        break
                    }
                    tuple_fields.push(self.parse_type())
                }
            }
            self.safe_consume(TokenType::RIGHT_PAREN)
            ret ParsedEnumVariant {
                name, documentation, generics, Vec[NamedField]::new(), tuple_fields, true, false
            }
        }

        ret ParsedEnumVariant {
            name, documentation, generics, Vec[NamedField]::new(), Vec[str]::new(), false, true
        }
    }

    fn parse_block(mut self) -> ParsedBlock {
        self.safe_consume(TokenType::LEFT_BRACE)
        let mut statements = Vec[Statement]::new()
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }
            statements.push(self.parse_inner_level())
        }
        self.safe_consume(TokenType::RIGHT_BRACE)
        ret ParsedBlock {
            statements
        }
    }

    fn parse_inner_level(mut self) -> Statement {
        let curr_token = self.peek_curr()
        match curr_token.type {
            TokenType::KW_RET => {
                ret self.parse_ret()
            }
            TokenType::KW_LET => {
                ret self.parse_let()
            }
            TokenType::KW_DO => {
                ret self.parse_do_while()
            }
            TokenType::KW_FOR => {
                ret self.parse_for()
            }
            TokenType::KW_WITH => {
                ret self.parse_with()
            }
            TokenType::KW_WHILE => {
                ret self.parse_while()
            }
            TokenType::KW_LOOP => {
                ret self.parse_loop()
            }
            TokenType::KW_IF => {
                ret self.parse_if_statement()
            }
            TokenType::KW_MATCH => {
                ret self.parse_match_statement()
            }
            TokenType::KW_UNSAFE => {
                if self.peek_next_type() == TokenType::KW_EHIR {
                    ret self.parse_ehir_statement(true)
                }
                ret self.parse_unsafe_statement()
            }
            TokenType::KW_EHIR => {
                ret self.parse_ehir_statement(false)
            }
            TokenType::KW_BREAK => {
                ret self.parse_break()
            }
            TokenType::KW_CONTINUE => {
                ret self.parse_continue()
            }
            _ => {
                let expr = self.parse_expression()
                let next_type = self.peek_curr_type()
                if self.is_assignment_operator(next_type) {
                    ret self.parse_assignment(expr)
                }
                ret Statement::Expr(expr)
            }
        }
    }

    fn parse_ret(mut self) -> Statement {
        self.safe_consume(TokenType::KW_RET)
        ret Statement::Ret(self.parse_expression())
    }

    fn parse_let(mut self) -> Statement {
        self.safe_consume(TokenType::KW_LET)
        let mut is_mut = false
        if self.peek_curr_type() == TokenType::KW_MUT {
            self.consume()
            is_mut = true
        }
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let mut typ = Option[str]::None
        if self.peek_curr_type() == TokenType::COLON {
            self.consume()
            typ = Option[str]::Some(self.parse_type())
        }
        self.safe_consume(TokenType::ASSIGN)
        let expr = self.parse_expression()
        ret Statement::Let(LetStmt {
                name, typ, expr, is_mut
            }
            ,
        )
    }

    fn parse_while(mut self) -> Statement {
        self.safe_consume(TokenType::KW_WHILE)
        let label = self.parse_maybe_label()
        self.parsing_control_flow_header = true
        let condition = self.parse_expression()
        self.parsing_control_flow_header = false
        let body = self.parse_block()
        ret Statement::While(WhileStmt {
                label, condition, body
            }
            ,
        )
    }

    fn parse_loop(mut self) -> Statement {
        self.safe_consume(TokenType::KW_LOOP)
        let label = self.parse_maybe_label()
        let body = self.parse_block()
        ret Statement::Loop(LoopStmt {
                label, body
            }
            ,
        )
    }

    fn parse_break(mut self) -> Statement {
        self.safe_consume(TokenType::KW_BREAK)
        ret Statement::Break(self.parse_maybe_label())
    }

    fn parse_continue(mut self) -> Statement {
        self.safe_consume(TokenType::KW_CONTINUE)
        ret Statement::Continue(self.parse_maybe_label())
    }

    fn parse_do_while(mut self) -> Statement {
        self.safe_consume(TokenType::KW_DO)
        let body = self.parse_block()
        self.safe_consume(TokenType::KW_WHILE)
        self.parsing_control_flow_header = true
        let condition = self.parse_expression()
        self.parsing_control_flow_header = false
        ret Statement::DoWhile(DoWhileStmt {
                body, condition
            }
            ,
        )
    }

    fn parse_for(mut self) -> Statement {
        self.safe_consume(TokenType::KW_FOR)
        let label = self.parse_maybe_label()
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let in_token = self.safe_consume(TokenType::IDENTIFIER)
        let in_kw = in_token.value
        if in_kw != "in" {
            self.error_at("Expected `in` in for-loop, got: " + in_kw, in_token)
        }
        self.parsing_control_flow_header = true
        let mut iterable = self.parse_expression()
        if self.peek_curr_type() == TokenType::DOT && self.peek_next_type() == TokenType::DOT {
            self.consume()
            self.consume()
            let mut range_function = "core::iter::range"
            if self.peek_curr_type() == TokenType::ASSIGN {
                self.consume()
                range_function = "core::iter::range_inclusive"
            }
            let end = self.parse_expression()
            let mut args = Vec[ExprNode]::new()
            args.push(iterable)
            args.push(end)
            let callee = self.mk_expr(Expr::Path(range_function))
            iterable = self.mk_expr(Expr::Call(CallExpr {
                        self.box_expr(callee), Vec[str]::new(), args
                    }
                    ,
                ))
        }
        self.parsing_control_flow_header = false
        let body = self.parse_block()
        ret Statement::For(ForStmt {
                label, name, iterable, body
            }
            ,
        )
    }

    fn parse_with(mut self) -> Statement {
        self.safe_consume(TokenType::KW_WITH)
        self.parsing_with_binding_expr = true
        let expr = self.parse_expression()
        self.parsing_with_binding_expr = false
        self.safe_consume(TokenType::KW_AS)
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let body = self.parse_block()
        ret Statement::With(WithStmt {
                expr, name, body
            }
            ,
        )
    }

    fn parse_if_statement(mut self) -> Statement {
        self.safe_consume(TokenType::KW_IF)
        self.parsing_control_flow_header = true
        let first_condition = self.parse_expression()
        self.parsing_control_flow_header = false

        let mut branches = Vec[IfBranch]::new()
        branches.push(IfBranch {
                first_condition, self.parse_block()
            }
            ,
        )

        loop {
            if self.peek_curr_type() != TokenType::KW_ELIF {
                break
            }
            self.consume()
            self.parsing_control_flow_header = true
            let condition = self.parse_expression()
            self.parsing_control_flow_header = false
            branches.push(IfBranch {
                    condition, self.parse_block()
                }
                ,
            )
        }

        let mut else_body = Option[ParsedBlock]::None
        if self.peek_curr_type() == TokenType::KW_ELSE {
            self.consume()
            else_body = Option[ParsedBlock]::Some(self.parse_block())
        }

        ret Statement::If(IfStmt {
                branches, else_body
            }
            ,
        )
    }

    fn parse_if_expression(mut self) -> ExprNode {
        self.safe_consume(TokenType::KW_IF)
        self.parsing_control_flow_header = true
        let first_condition = self.parse_expression()
        self.parsing_control_flow_header = false

        let mut branches = Vec[IfExprBranch]::new()
        branches.push(IfExprBranch {
                first_condition, self.parse_expression_block()
            }
            ,
        )

        loop {
            if self.peek_curr_type() != TokenType::KW_ELIF {
                break
            }
            self.consume()
            self.parsing_control_flow_header = true
            let condition = self.parse_expression()
            self.parsing_control_flow_header = false
            branches.push(IfExprBranch {
                    condition, self.parse_expression_block()
                }
                ,
            )
        }

        if self.peek_curr_type() != TokenType::KW_ELSE {
            self.error_at("If expression must have else branch", self.peek_curr())
            ret self.mk_expr(Expr::Path(""))
        }
        self.consume()
        let else_body = self.parse_expression_block()
        ret self.mk_expr(Expr::If(IfExpr {
                    branches, self.box_expr(else_body)
                }
                ,
            ))
    }

    fn parse_unsafe_statement(mut self) -> Statement {
        self.safe_consume(TokenType::KW_UNSAFE)
        ret Statement::Unsafe(self.parse_block())
    }

    fn parse_unsafe_expression(mut self) -> ExprNode {
        self.safe_consume(TokenType::KW_UNSAFE)
        ret self.mk_expr(Expr::Unsafe(self.parse_block()))
    }

    fn parse_ehir_statement(mut self, is_unsafe: bool) -> Statement {
        if is_unsafe {
            self.safe_consume(TokenType::KW_UNSAFE)
        }
        self.safe_consume(TokenType::KW_EHIR)
        self.safe_consume(TokenType::LEFT_BRACE)

        let mut body = ""
        let mut previous_line = 0_usize
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }
            let token = self.consume()
            if previous_line != 0_usize && token.line != previous_line {
                body = body + "\n"
            }
            body = body + token.value
            body = body + " "
            previous_line = token.line
        }
        self.safe_consume(TokenType::RIGHT_BRACE)

        ret Statement::Ehir(EhirStmt {
                is_unsafe, body
            }
            ,
        )
    }

    fn parse_match_statement(mut self) -> Statement {
        self.safe_consume(TokenType::KW_MATCH)
        self.parsing_match_header = true
        let expr = self.parse_expression()
        self.parsing_match_header = false

        let mut arms = Vec[ParsedMatchArm]::new()
        self.safe_consume(TokenType::LEFT_BRACE)
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }
            let pattern = self.parse_match_pattern()
            self.safe_consume(TokenType::FAT_ARROW)
            let body = self.parse_statement_match_body()
            arms.push(ParsedMatchArm {
                    pattern, body
                }
                ,
            )
        }
        self.safe_consume(TokenType::RIGHT_BRACE)

        ret Statement::Match(MatchStmt {
                expr, arms
            }
            ,
        )
    }

    fn parse_match_expression(mut self) -> ExprNode {
        self.safe_consume(TokenType::KW_MATCH)
        self.parsing_match_header = true
        let expr = self.parse_expression()
        self.parsing_match_header = false

        let mut arms = Vec[MatchExprArm]::new()
        self.safe_consume(TokenType::LEFT_BRACE)
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                break
            }
            let pattern = self.parse_match_pattern()
            self.safe_consume(TokenType::FAT_ARROW)
            let arm_expr = self.parse_expression()
            arms.push(MatchExprArm {
                    pattern, arm_expr
                }
                ,
            )
        }
        self.safe_consume(TokenType::RIGHT_BRACE)

        ret self.mk_expr(Expr::Match(MatchExpr {
                    self.box_expr(expr), arms
                }
                ,
            ))
    }

    fn parse_match_pattern(mut self) -> MatchPattern {
        let curr_token = self.peek_curr()

        if curr_token.type == TokenType::IDENTIFIER {
            if curr_token.value == "_" {
                self.consume()
                ret MatchPattern {
                    "wildcard", Option[str]::None, Option[str]::None
                }
            }
        }

        if curr_token.type == TokenType::MINUS {
            self.consume()
            let next_type = self.peek_curr_type()
            if next_type == TokenType::INTEGER {
                let value = self.literal_value(self.parse_integer_literal())
                ret MatchPattern {
                    "integer", Option[str]::Some(value), Option[str]::None
                }
            }
            if next_type == TokenType::FLOAT {
                let value = self.literal_value(self.parse_float_literal())
                ret MatchPattern {
                    "float", Option[str]::Some(value), Option[str]::None
                }
            }
            self.error_at("Match pattern '-' must be followed by numeric literal", self.peek_curr())
            ret MatchPattern {
                "invalid", Option[str]::None, Option[str]::None
            }
        }

        if curr_token.type == TokenType::STRING {
            let value = self.safe_consume_value(TokenType::STRING)
            ret MatchPattern {
                "string", Option[str]::Some(value), Option[str]::None
            }
        }

        if curr_token.type == TokenType::INTEGER {
            let value = self.literal_value(self.parse_integer_literal())
            ret MatchPattern {
                "integer", Option[str]::Some(value), Option[str]::None
            }
        }

        if curr_token.type == TokenType::FLOAT {
            let value = self.literal_value(self.parse_float_literal())
            ret MatchPattern {
                "float", Option[str]::Some(value), Option[str]::None
            }
        }

        if curr_token.type == TokenType::BOOLEAN {
            let token = self.consume()
            ret MatchPattern {
                "bool", Option[str]::Some(token.value), Option[str]::None
            }
        }

        let path = self.parse_path()
        let mut binding = Option[str]::None
        if self.peek_curr_type() == TokenType::LEFT_PAREN {
            self.consume()
            let payload_name = self.safe_consume_value(TokenType::IDENTIFIER)
            if payload_name != "_" {
                binding = Option[str]::Some(payload_name)
            }
            self.safe_consume(TokenType::RIGHT_PAREN)
        }
        ret MatchPattern {
            "path", Option[str]::Some(path), binding
        }
    }

    fn parse_statement_match_body(mut self) -> MatchArmBody {
        if self.peek_curr_type() == TokenType::LEFT_BRACE {
            ret MatchArmBody::Block(self.parse_block())
        }
        ret MatchArmBody::Expr(self.parse_expression())
    }

    fn parse_expression(mut self) -> ExprNode {
        ret self.parse_logical_or()
    }

    fn parse_logical_or(mut self) -> ExprNode {
        let mut left = self.parse_logical_and()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::PIPE_PIPE {
                break
            }
            self.consume()
            let right = self.parse_logical_and()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_logical_and(mut self) -> ExprNode {
        let mut left = self.parse_bitwise_or()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::AND_AND {
                break
            }
            self.consume()
            let right = self.parse_bitwise_or()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_bitwise_or(mut self) -> ExprNode {
        let mut left = self.parse_bitwise_xor()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::PIPE {
                break
            }
            self.consume()
            let right = self.parse_bitwise_xor()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_bitwise_xor(mut self) -> ExprNode {
        let mut left = self.parse_bitwise_and()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::CARET {
                break
            }
            self.consume()
            let right = self.parse_bitwise_and()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_bitwise_and(mut self) -> ExprNode {
        let mut left = self.parse_equality()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::AMPERSAND {
                break
            }
            self.consume()
            let right = self.parse_equality()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_equality(mut self) -> ExprNode {
        let mut left = self.parse_relational()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::EQUAL_EQUAL {
                if operator.type != TokenType::BANG_EQUAL {
                    break
                }
            }
            self.consume()
            let right = self.parse_relational()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_relational(mut self) -> ExprNode {
        let mut left = self.parse_shift()
        loop {
            let operator = self.peek_curr()
            if !self.is_relational_operator(operator.type) {
                break
            }
            self.consume()
            let right = self.parse_shift()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_shift(mut self) -> ExprNode {
        let mut left = self.parse_additive()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::LEFT_SHIFT {
                if operator.type != TokenType::RIGHT_SHIFT {
                    break
                }
            }
            self.consume()
            let right = self.parse_additive()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_additive(mut self) -> ExprNode {
        let mut left = self.parse_multiplicative()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::PLUS {
                if operator.type != TokenType::MINUS {
                    break
                }
            }
            self.consume()
            let right = self.parse_multiplicative()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_multiplicative(mut self) -> ExprNode {
        let mut left = self.parse_power()
        loop {
            let operator = self.peek_curr()
            if operator.type != TokenType::ASTERISK {
                if operator.type != TokenType::SLASH {
                    if operator.type != TokenType::PERCENT {
                        break
                    }
                }
            }
            self.consume()
            let right = self.parse_power()
            left = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(left), operator.value, self.box_expr(right)
                    }
                    ,
                ))
        }
        ret left
    }

    fn parse_power(mut self) -> ExprNode {
        let left = self.parse_cast()
        let operator = self.peek_curr()
        if operator.type != TokenType::POWER {
            ret left
        }
        self.consume()
        let right = self.parse_power()
        ret self.mk_expr(Expr::Binary(BinaryExpr {
                    self.box_expr(left), operator.value, self.box_expr(right)
                }
                ,
            ))
    }

    fn parse_cast(mut self) -> ExprNode {
        let mut expr = self.parse_unary()
        loop {
            if self.peek_curr_type() != TokenType::KW_AS || self.parsing_with_binding_expr {
                break
            }
            self.consume()
            let target = self.parse_type()
            expr = self.mk_expr(Expr::Cast(CastExpr {
                        self.box_expr(expr), target
                    }
                    ,
                ))
        }
        ret expr
    }

    fn parse_unary(mut self) -> ExprNode {
        let token = self.peek_curr()
        if token.type == TokenType::KW_AWAIT {
            self.consume()
            let expr = self.parse_unary()
            ret self.mk_expr_at(Expr::Await(self.box_expr(expr)), token)
        }
        if token.type == TokenType::KW_SPAWN {
            self.consume()
            let expr = self.parse_unary()
            ret self.mk_expr_at(Expr::Spawn(self.box_expr(expr)), token)
        }
        if self.is_unary_operator(token.type) {
            self.consume()
            let expr = self.parse_unary()
            ret self.mk_expr(Expr::Unary(UnaryExpr {
                        token.value, self.box_expr(expr)
                    }
                    ,
                ))
        }
        ret self.parse_postfix()
    }

    fn parse_postfix(mut self) -> ExprNode {
        let mut expr = self.parse_primary()
        loop {
            let curr_type = self.peek_curr_type()
            if curr_type == TokenType::LEFT_PAREN {
                expr = self.parse_call(expr)
                continue
            }
            if curr_type == TokenType::DOT {
                if self.peek_next_type() == TokenType::DOT {
                    break
                }
                expr = self.parse_dotted_postfix(expr)
                continue
            }
            if curr_type == TokenType::LEFT_BRACKET {
                expr = self.parse_index_postfix(expr)
                continue
            }
            if curr_type == TokenType::QUESTION {
                self.consume()
                expr = self.mk_expr(Expr::Try(self.box_expr(expr)))
                continue
            }
            break
        }
        ret expr
    }

    fn parse_integer_literal(mut self) -> ExprNode {
        let token = self.peek_curr()
        let mut value = self.safe_consume_value(TokenType::INTEGER)
        match self.parse_numeric_literal_suffix() {
            Option[str]::Some(text) => {
                value = value + text
            }
            Option[str]::None => {
            }
        }
        ret self.mk_expr_at(Expr::Integer(value), token)
    }

    fn parse_float_literal(mut self) -> ExprNode {
        let token = self.peek_curr()
        let mut value = self.safe_consume_value(TokenType::FLOAT)
        match self.parse_numeric_literal_suffix() {
            Option[str]::Some(text) => {
                value = value + text
            }
            Option[str]::None => {
            }
        }
        ret self.mk_expr_at(Expr::Float(value), token)
    }

    fn parse_parenthesized_or_tuple(mut self) -> ExprNode {
        self.safe_consume(TokenType::LEFT_PAREN)
        if self.peek_curr_type() == TokenType::RIGHT_PAREN {
            self.consume()
            ret self.mk_expr(Expr::TupleLiteral(TupleLiteralExpr {
                        Vec[ExprNode]::new()
                    }
                ))
        }

        let first = self.parse_expression()
        if self.peek_curr_type() != TokenType::COMMA {
            self.safe_consume(TokenType::RIGHT_PAREN)
            ret self.mk_expr(Expr::Parenthesized(self.box_expr(first)))
        }

        let mut items = Vec[ExprNode]::new()
        items.push(first)
        loop {
            if self.peek_curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                break
            }
            items.push(self.parse_expression())
        }
        self.safe_consume(TokenType::RIGHT_PAREN)
        ret self.mk_expr(Expr::TupleLiteral(TupleLiteralExpr {
                    items
                }
            ))
    }

    fn parse_array_literal(mut self) -> ExprNode {
        self.safe_consume(TokenType::LEFT_BRACKET)
        if self.peek_curr_type() == TokenType::RIGHT_BRACKET {
            self.consume()
            ret self.mk_expr(Expr::ArrayLiteral(ArrayLiteralExpr {
                        Vec[ExprNode]::new()
                    }
                ))
        }

        let first = self.parse_expression()
        if self.peek_curr_type() == TokenType::SEMICOLON {
            self.consume()
            let size = self.safe_consume_value(TokenType::INTEGER)
            self.safe_consume(TokenType::RIGHT_BRACKET)
            ret self.mk_expr(Expr::ArrayRepeat(ArrayRepeatExpr {
                        self.box_expr(first), size
                    }
                    ,
                ))
        }

        let mut items = Vec[ExprNode]::new()
        items.push(first)
        loop {
            if self.peek_curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.peek_curr_type() == TokenType::RIGHT_BRACKET {
                break
            }
            items.push(self.parse_expression())
        }
        self.safe_consume(TokenType::RIGHT_BRACKET)
        ret self.mk_expr(Expr::ArrayLiteral(ArrayLiteralExpr {
                    items
                }
            ))
    }

    fn parse_expression_block(mut self) -> ExprNode {
        self.safe_consume(TokenType::LEFT_BRACE)
        let mut statements = Vec[Statement]::new()
        loop {
            if !self.starts_expression_block_statement() {
                break
            }
            statements.push(self.parse_inner_level())
        }
        let mut tail = Option[ExprNode < H >]::None
        if self.peek_curr_type() != TokenType::RIGHT_BRACE {
            tail = Option[ExprNode < H >]::Some(self.box_expr(self.parse_expression()))
        }
        self.safe_consume(TokenType::RIGHT_BRACE)
        ret self.mk_expr(Expr::Block(BlockExpr {
                    statements, tail
                }
                ,
            ))
    }

    fn starts_expression_block_statement(mut self) -> bool {
        let token_type = self.peek_curr_type()
        if token_type == TokenType::KW_LET
        || token_type == TokenType::KW_RET
        || token_type == TokenType::KW_WHILE
        || token_type == TokenType::KW_LOOP
        || token_type == TokenType::KW_DO
        || token_type == TokenType::KW_EHIR
        || token_type == TokenType::KW_BREAK
        || token_type == TokenType::KW_CONTINUE {
            ret true
        }

        if token_type == TokenType::KW_UNSAFE {
            if self.peek_next_type() == TokenType::KW_EHIR {
                ret true
            }
        }

        if token_type == TokenType::KW_IF
        || token_type == TokenType::KW_MATCH
        || token_type == TokenType::KW_UNSAFE
        || token_type == TokenType::RIGHT_BRACE
        || token_type == TokenType::EOF {
            ret false
        }

        if token_type != TokenType::IDENTIFIER {
            ret false
        }
        ret self.starts_assignment_statement()
    }

    fn starts_assignment_statement(mut self) -> bool {
        let mut index = 0_usize
        if self.peek_nth_type(index) != TokenType::IDENTIFIER {
            ret false
        }

        loop {
            index = index + 1_usize

            if self.peek_nth_type(index) == TokenType::LEFT_BRACKET {
                let mut depth = 1_usize
                index = index + 1_usize
                loop {
                    let token_type = self.peek_nth_type(index)
                    if token_type == TokenType::LEFT_BRACKET {
                        depth = depth + 1_usize
                    } elif token_type == TokenType::RIGHT_BRACKET {
                        depth = depth - 1_usize
                        if depth == 0_usize {
                            index = index + 1_usize
                            break
                        }
                    } elif token_type == TokenType::EOF {
                        ret false
                    }
                    index = index + 1_usize
                }
            }

            let next_type = self.peek_nth_type(index)
            if next_type == TokenType::SCOPE {
                index = index + 1_usize
                if self.peek_nth_type(index) != TokenType::IDENTIFIER {
                    ret false
                }
                continue
            }

            if next_type == TokenType::DOT {
                index = index + 1_usize
                let member_type = self.peek_nth_type(index)
                if member_type != TokenType::IDENTIFIER {
                    if member_type != TokenType::INTEGER {
                        ret false
                    }
                }
                continue
            }

            ret self.is_assignment_operator(next_type)
        }
    }

    fn parse_struct_initialization(mut self, path: str) -> ExprNode {
        self.safe_consume(TokenType::LEFT_BRACE)
        let mut values = Vec[ExprNode]::new()
        if self.peek_curr_type() != TokenType::RIGHT_BRACE {
            values.push(self.parse_expression())
            loop {
                if self.peek_curr_type() != TokenType::COMMA {
                    break
                }
                self.consume()
                if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                    break
                }
                values.push(self.parse_expression())
            }
        }
        self.safe_consume(TokenType::RIGHT_BRACE)
        ret self.mk_expr(Expr::StructInit(StructInitExpr {
                    path, values
                }
                ,
            ))
    }

    fn parse_call(mut self, callee: ExprNode) -> ExprNode {
        let args = self.parse_call_args()
        ret ExprNode {
            Expr::Call(CallExpr {
                    self.box_expr(callee), Vec[str]::new(), args
                }
                ,
            ),
            callee.line,
            callee.column,
            callee.length,
            callee.source_name
        }
    }

    fn parse_call_args(mut self) -> Vec[ExprNode] {
        let mut args = Vec[ExprNode]::new()
        self.safe_consume(TokenType::LEFT_PAREN)
        if self.peek_curr_type() != TokenType::RIGHT_PAREN {
            args.push(self.parse_expression())
            loop {
                if self.peek_curr_type() != TokenType::COMMA {
                    break
                }
                self.consume()
                if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                    break
                }
                args.push(self.parse_expression())
            }
        }
        self.safe_consume(TokenType::RIGHT_PAREN)
        ret args
    }

    fn parse_dotted_postfix(mut self, base: ExprNode) -> ExprNode {
        let mut expr = base
        loop {
            if self.peek_curr_type() != TokenType::DOT {
                break
            }
            self.consume()
            let member_token = self.peek_curr()
            if member_token.type != TokenType::IDENTIFIER {
                if member_token.type != TokenType::INTEGER {
                    self.unexpected_token("field or method name", member_token)
                    ret expr
                }
            }
            let member_token = self.consume()
            let member = member_token.value
            let member_generics = self.parse_possible_generics()

            if self.peek_curr_type() == TokenType::LEFT_PAREN {
                let args = self.parse_call_args()
                expr = self.mk_expr_at(
                    Expr::MethodCall(MethodCallExpr {
                            self.box_expr(expr), member, member_generics, args
                        }
                        ,
                    ),
                    member_token,
                )
                continue
            }

            if member_generics.len() > 0_usize {
                self.error_at("Field can not have generic arguments", member_token)
                ret expr
            }

            expr = self.mk_expr_at(Expr::Field(FieldExpr {
                        self.box_expr(expr), member
                    }
                    ,
                ), member_token)
        }
        ret expr
    }

    fn parse_index_postfix(mut self, base: ExprNode) -> ExprNode {
        let mut expr = base
        loop {
            if self.peek_curr_type() != TokenType::LEFT_BRACKET {
                break
            }
            self.consume()
            let index = self.parse_expression()
            self.safe_consume(TokenType::RIGHT_BRACKET)
            expr = self.mk_expr(Expr::Index(IndexExpr {
                        self.box_expr(expr), self.box_expr(index)
                    }
                    ,
                ))
        }
        ret expr
    }

    fn parse_path(mut self) -> str {
        let mut path = self.parse_expression_path_segment()
        loop {
            if self.peek_curr_type() != TokenType::SCOPE {
                break
            }
            self.consume()
            path = path + "::"
            let segment = self.parse_expression_path_segment()
            path = path + segment
        }
        ret path
    }

    fn parse_expression_path_segment(mut self) -> str {
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_expression_generics()
        let mut out = name
        if generics.len() > 0_usize {
            let joined = self.join_strings(generics, ", ")
            out = out + "["
            out = out + joined
            out = out + "]"
        }
        if self.is_smart_pointer_suffix() {
            self.safe_consume(TokenType::LESS)
            let pointer = self.safe_consume_value(TokenType::IDENTIFIER)
            self.safe_consume(TokenType::GREATER)
            out = out + "<"
            out = out + pointer
            out = out + ">"
        }
        ret out
    }

    fn parse_primary(mut self) -> ExprNode {
        let curr_token = self.peek_curr()
        match curr_token.type {
            TokenType::PIPE => {
                ret self.parse_closure_expression(false)
            }
            TokenType::PIPE_PIPE => {
                ret self.parse_closure_expression(true)
            }
            TokenType::INTEGER => {
                ret self.parse_integer_literal()
            }
            TokenType::FLOAT => {
                ret self.parse_float_literal()
            }
            TokenType::BOOLEAN => {
                let token = self.consume()
                ret self.mk_expr_at(Expr::Boolean(token.value == "true"), token)
            }
            TokenType::STRING => {
                let token = self.consume()
                ret self.mk_expr_at(Expr::StringLiteral(token.value), token)
            }
            TokenType::LEFT_PAREN => {
                ret self.parse_parenthesized_or_tuple()
            }
            TokenType::LEFT_BRACKET => {
                ret self.parse_array_literal()
            }
            TokenType::LEFT_BRACE => {
                ret self.parse_expression_block()
            }
            TokenType::KW_MATCH => {
                ret self.parse_match_expression()
            }
            TokenType::KW_IF => {
                ret self.parse_if_expression()
            }
            TokenType::KW_UNSAFE => {
                ret self.parse_unsafe_expression()
            }
            TokenType::IDENTIFIER => {
                if curr_token.value == "f" && self.peek_next_type() == TokenType::STRING {
                    self.consume()
                    ret self.parse_fstring(self.consume_value())
                }
                let path = self.parse_path()
                if path == "format" && self.peek_curr_type() == TokenType::BANG {
                    self.consume()
                    ret self.parse_format_macro()
                }
                if path == "vec" && self.peek_curr_type() == TokenType::BANG {
                    self.consume()
                    ret self.parse_vec_literal()
                }
                if self.peek_curr_type() == TokenType::LEFT_BRACE {
                    if !self.parsing_match_header {
                        if !self.parsing_control_flow_header {
                            ret self.parse_struct_initialization(path)
                        }
                    }
                }
                ret self.mk_expr_at(Expr::Path(path), curr_token)
            }
            _ => {
                self.unexpected_token("expression", curr_token)
                ret self.mk_expr(Expr::Path(""))
            }
        }
    }

    fn parse_closure_expression(mut self, empty: bool) -> ExprNode {
        let start = self.peek_curr()
        let mut params = Vec[FunctionParam]::new()
        if empty {
            self.safe_consume(TokenType::PIPE_PIPE)
        } else {
            self.safe_consume(TokenType::PIPE)
            loop {
                let name = self.safe_consume_value(TokenType::IDENTIFIER)
                let mut typ = Option[str]::None
                if self.peek_curr_type() == TokenType::COLON {
                    self.consume()
                    typ = Option[str]::Some(self.parse_type())
                }
                params.push(FunctionParam {
                        name, typ
                    }
                    ,
                )
                if self.peek_curr_type() == TokenType::PIPE {
                    break
                }
                self.safe_consume(TokenType::COMMA)
            }
            self.safe_consume(TokenType::PIPE)
        }
        let body = if self.peek_curr_type() == TokenType::LEFT_BRACE {
            self.parse_closure_block()
        } else {
            self.parse_expression()
        }
        ret self.mk_expr_at(Expr::Closure(ClosureExpr {
                    params, self.box_expr(body)
                }
                ,
            ), start)
    }

    fn parse_closure_block(mut self) -> ExprNode {
        // A closure block follows ordinary function-body statement parsing so
        // adjacent calls on separate source lines are accepted. Its final
        // expression remains the value of the closure, matching expression
        // block semantics.
        let parsed = self.parse_block()
        let mut statements = parsed.statements
        let mut tail = Option[ExprNode < H >]::None
        match statements.pop() {
            Option[Statement]::Some(statement) => {
                match statement {
                    Statement::Expr(expr) => {
                        tail = Option[ExprNode < H >]::Some(self.box_expr(expr))
                    }
                    _ => {
                        statements.push(statement)
                    }
                }
            }
            Option[Statement]::None => {
            }
        }
        ret self.mk_expr(Expr::Block(BlockExpr {
                    statements, tail
                }
                ,
            ))
    }

    fn parse_vec_literal(mut self) -> ExprNode {
        self.safe_consume(TokenType::LEFT_BRACKET)
        let mut items = Vec[ExprNode]::new()
        if self.peek_curr_type() != TokenType::RIGHT_BRACKET {
            items.push(self.parse_expression())
            while self.peek_curr_type() == TokenType::COMMA {
                self.consume()
                if self.peek_curr_type() == TokenType::RIGHT_BRACKET {
                    break
                }
                items.push(self.parse_expression())
            }
        }
        self.safe_consume(TokenType::RIGHT_BRACKET)
        ret self.mk_expr(Expr::VecLiteral(ArrayLiteralExpr {
                    items
                }
            ))
    }

    fn parse_fstring(mut self, raw: str) -> ExprNode {
        ret self.build_format_expr(raw, Vec[ExprNode]::new())
    }

    fn parse_format_macro(mut self) -> ExprNode {
        self.safe_consume(TokenType::LEFT_PAREN)
        let raw = self.safe_consume_value(TokenType::STRING)
        let mut positional = Vec[ExprNode]::new()
        while self.peek_curr_type() == TokenType::COMMA {
            self.consume()
            if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                break
            }
            positional.push(self.parse_expression())
        }
        self.safe_consume(TokenType::RIGHT_PAREN)
        ret self.build_format_expr(raw, positional)
    }

    fn parse_inline_expression(mut self, source: str) -> ExprNode {
        let mut lexer = Lexer::new()
        let tokens = lexer.tokenize(source)
        let mut nested = Parser::new_for_source(self.source_name)
        ret nested.parse_inline_tokens(tokens)
    }

    fn parse_inline_tokens(mut self, tokens: Vec[Token]) -> ExprNode {
        self.tokens = tokens
        self.consumed = 0_usize
        ret self.parse_expression()
    }

    fn build_format_expr(mut self, raw: str, positional: Vec[ExprNode]) -> ExprNode {
        let body = raw.slice(1_usize, raw.len() - 2_usize)
        let mut result = self.mk_expr(Expr::StringLiteral("\"\""))
        let mut cursor = 0_usize
        let mut chunk_start = 0_usize
        let mut positional_index = 0_usize
        while cursor < body.len() {
            if body.slice(cursor, 1_usize) == "{" {
                if cursor > chunk_start {
                    let literal = self.mk_expr(Expr::StringLiteral("\"" + body.slice(chunk_start, cursor
                                - chunk_start,) + "\""))
                    result = self.mk_expr(Expr::Binary(BinaryExpr {
                                self.box_expr(result), "+", self.box_expr(literal)
                            }
                            ,
                        ))
                }
                let mut end = cursor + 1_usize
                while end < body.len() && body.slice(end, 1_usize) != "}" {
                    end = end + 1_usize
                }
                if end >= body.len() {
                    self.unexpected_token("closing '}' in f-string", self.peek_curr())
                    ret result
                }
                let mut expression_source = body.slice(cursor + 1_usize, end - cursor - 1_usize)
                let callee = self.mk_expr(Expr::Path("Debug::fmt"))
                let mut args = Vec[ExprNode]::new()
                if expression_source == "" {
                    match positional.get(positional_index) {
                        Some(value) => {
                            args.push(value)
                        }
                        None => {
                            self.unexpected_token("format positional argument", self.peek_curr())
                        }
                    }
                    positional_index = positional_index + 1_usize
                } else {
                    if expression_source.len() > 0_usize && expression_source.slice(0_usize, 1_usize)
                    == "#" {
                        expression_source = expression_source.slice(1_usize, expression_source.len()
                            - 1_usize,)
                    }
                    args.push(self.parse_inline_expression(expression_source))
                }
                let formatted = self.mk_expr(Expr::Call(CallExpr {
                            self.box_expr(callee), Vec[str]::new(), args
                        }
                        ,
                    ))
                result = self.mk_expr(Expr::Binary(BinaryExpr {
                            self.box_expr(result), "+", self.box_expr(formatted)
                        }
                        ,
                    ))
                cursor = end + 1_usize
                chunk_start = cursor
                continue
            }
            cursor = cursor + 1_usize
        }
        if chunk_start < body.len() {
            let literal = self.mk_expr(Expr::StringLiteral("\"" + body.slice(chunk_start, body.len()
                        - chunk_start,) + "\""))
            result = self.mk_expr(Expr::Binary(BinaryExpr {
                        self.box_expr(result), "+", self.box_expr(literal)
                    }
                    ,
                ))
        }
        ret result
    }

    fn parse_assignment(mut self, target: ExprNode) -> Statement {
        let operator = self.consume_value()
        let expr = self.parse_expression()
        ret Statement::Assignment(AssignmentStmt {
                target, operator, expr
            }
            ,
        )
    }

    fn parse_numeric_literal_suffix(mut self) -> Option[str] {
        if self.is_at_end() {
            ret Option[str]::None
        }
        let token = self.peek_curr()
        if token.type != TokenType::IDENTIFIER {
            ret Option[str]::None
        }
        if !self.is_numeric_suffix_token(token.value) {
            ret Option[str]::None
        }
        ret Option[str]::Some(self.consume_value())
    }

    fn parse_possible_generics(mut self) -> Vec[str] {
        if self.peek_curr_type() == TokenType::LEFT_BRACKET {
            ret self.parse_generics_args()
        }
        ret Vec[str]::new()
    }

    fn parse_possible_generic_params(mut self) -> Vec[GenericParam] {
        if self.peek_curr_type() == TokenType::LEFT_BRACKET {
            ret self.parse_generic_params()
        }
        ret Vec[GenericParam]::new()
    }

    fn parse_possible_expression_generics(mut self) -> Vec[str] {
        if self.should_parse_expression_path_generics() {
            ret self.parse_generics_args()
        }
        ret Vec[str]::new()
    }

    fn parse_generics_args(mut self) -> Vec[str] {
        let mut generics = Vec[str]::new()
        self.safe_consume(TokenType::LEFT_BRACKET)
        generics.push(self.parse_type())
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACKET {
                break
            }
            self.safe_consume(TokenType::COMMA)
            generics.push(self.parse_type())
        }
        self.safe_consume(TokenType::RIGHT_BRACKET)
        ret generics
    }

    fn parse_generic_params(mut self) -> Vec[GenericParam] {
        let mut params = Vec[GenericParam]::new()
        self.safe_consume(TokenType::LEFT_BRACKET)
        params.push(self.parse_generic_param())
        loop {
            if self.peek_curr_type() == TokenType::RIGHT_BRACKET {
                break
            }
            self.safe_consume(TokenType::COMMA)
            params.push(self.parse_generic_param())
        }
        self.safe_consume(TokenType::RIGHT_BRACKET)
        ret params
    }

    fn parse_generic_param(mut self) -> GenericParam {
        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let mut bounds = Vec[TraitBound]::new()
        if self.peek_curr_type() == TokenType::COLON {
            self.consume()
            bounds.push(self.parse_trait_bound())
            loop {
                if self.peek_curr_type() != TokenType::PLUS {
                    break
                }
                self.consume()
                bounds.push(self.parse_trait_bound())
            }
        }
        ret GenericParam {
            name, bounds
        }
    }

    fn parse_trait_bound(mut self) -> TraitBound {
        let path = self.parse_bound_path()
        let args = self.parse_possible_generics()
        ret TraitBound {
            path, args
        }
    }

    fn parse_bound_path(mut self) -> str {
        let mut out = self.safe_consume_value(TokenType::IDENTIFIER)
        loop {
            if self.peek_curr_type() != TokenType::SCOPE {
                break
            }
            self.consume()
            out = out + "::"
            out = out + self.safe_consume_value(TokenType::IDENTIFIER)
        }
        ret out
    }

    fn parse_type(mut self) -> str {
        let mut out = ""
        if self.peek_curr_type() == TokenType::KW_MUT {
            self.consume()
            out = out + "mut "
        }

        let mut leading_reference = false
        if self.peek_curr_type() == TokenType::AMPERSAND {
            self.consume()
            leading_reference = true
        }

        let base = self.parse_type_base()
        out = out + base
        loop {
            if self.peek_curr_type() != TokenType::ASTERISK {
                break
            }
            self.consume()
            out = out + "*"
        }

        if self.is_smart_pointer_suffix() {
            self.safe_consume(TokenType::LESS)
            let pointer = self.safe_consume_value(TokenType::IDENTIFIER)
            self.safe_consume(TokenType::GREATER)
            out = out + "<"
            out = out + pointer
            out = out + ">"
        } elif self.peek_curr_type() == TokenType::AMPERSAND {
            self.consume()
            out = out + "&"
        } elif leading_reference {
            out = out + "&"
        }

        ret out
    }

    fn parse_type_base(mut self) -> str {
        if self.peek_curr_type() == TokenType::KW_DYN {
            self.consume()
            ret "dyn " + self.parse_type_base()
        }

        if self.peek_curr_type() == TokenType::LEFT_PAREN {
            self.consume()
            let mut out = "("
            if self.peek_curr_type() != TokenType::RIGHT_PAREN {
                let first = self.parse_type()
                out = out + first
                loop {
                    if self.peek_curr_type() != TokenType::COMMA {
                        break
                    }
                    self.consume()
                    out = out + ", "
                    if self.peek_curr_type() == TokenType::RIGHT_PAREN {
                        break
                    }
                    let item = self.parse_type()
                    out = out + item
                }
            }
            self.safe_consume(TokenType::RIGHT_PAREN)
            out = out + ")"
            ret out
        }

        if self.peek_curr_type() == TokenType::LEFT_BRACKET {
            self.consume()
            let item_type = self.parse_type()
            self.safe_consume(TokenType::SEMICOLON)
            let size = self.safe_consume_value(TokenType::INTEGER)
            self.safe_consume(TokenType::RIGHT_BRACKET)
            let mut out = "["
            out = out + item_type
            out = out + "; "
            out = out + size
            out = out + "]"
            ret out
        }

        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generics()
        let mut out = name
        if generics.len() > 0_usize {
            let joined = self.join_strings(generics, ", ")
            out = out + "["
            out = out + joined
            out = out + "]"
        }
        ret out
    }

    fn parse_param(mut self) -> FunctionParam {
        if self.peek_curr_type() == TokenType::KW_MUT {
            self.consume()
            let token = self.safe_consume(TokenType::IDENTIFIER)
            if token.value != "self" {
                self.error_at("Only `self` may use prefix `mut` before the parameter name", token)
                ret FunctionParam {
                    "", Option[str]::None
                }
            }
            if self.peek_curr_type() == TokenType::COLON {
                self.consume()
                let parsed_type = self.parse_type()
                let mut typ = "mut "
                typ = typ + parsed_type
                ret FunctionParam {
                    "self", Option[str]::Some(typ)
                }
            }
            ret FunctionParam {
                "self", Option[str]::Some("mut Self")
            }
        }

        if self.peek_curr_is_identifier("self") {
            self.consume()
            if self.peek_curr_type() == TokenType::COLON {
                self.consume()
                ret FunctionParam {
                    "self", Option[str]::Some(self.parse_type())
                }
            }
            ret FunctionParam {
                "self", Option[str]::Some("Self")
            }
        }

        let name = self.safe_consume_value(TokenType::IDENTIFIER)
        self.safe_consume(TokenType::COLON)
        let typ = self.parse_type()
        ret FunctionParam {
            name, Option[str]::Some(typ)
        }
    }

    fn parse_trait_bases(mut self) -> Vec[str] {
        let mut bases = Vec[str]::new()
        if self.peek_curr_type() != TokenType::LESS {
            ret bases
        }

        self.consume()
        loop {
            if self.peek_curr_type() == TokenType::LEFT_BRACE {
                break
            }
            bases.push(self.parse_type())
            if self.peek_curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
        }
        ret bases
    }

    fn parse_import_path(mut self) -> str {
        let mut out = self.safe_consume_value(TokenType::IDENTIFIER)

        loop {
            if self.peek_curr_type() != TokenType::SCOPE {
                break
            }
            self.consume()
            out = out + "::"

            if self.peek_curr_type() == TokenType::ASTERISK {
                self.consume()
                out = out + "*"
                break
            }

            if self.peek_curr_type() == TokenType::LEFT_BRACE {
                self.consume()
                out = out + "{"
                if self.peek_curr_type() != TokenType::RIGHT_BRACE {
                    let first = self.parse_import_path()
                    out = out + first
                    loop {
                        if self.peek_curr_type() != TokenType::COMMA {
                            break
                        }
                        self.consume()
                        out = out + ", "
                        if self.peek_curr_type() == TokenType::RIGHT_BRACE {
                            break
                        }
                        let nested = self.parse_import_path()
                        out = out + nested
                    }
                }
                self.safe_consume(TokenType::RIGHT_BRACE)
                out = out + "}"
                break
            }

            let segment = self.safe_consume_value(TokenType::IDENTIFIER)
            out = out + segment
        }

        if self.peek_curr_type() == TokenType::KW_AS {
            self.consume()
            let alias = self.safe_consume_value(TokenType::IDENTIFIER)
            out = out + " as "
            out = out + alias
        }

        ret out
    }

    fn parse_maybe_label(mut self) -> Option[str] {
        if self.peek_curr_type() != TokenType::LESS {
            ret Option[str]::None
        }
        self.consume()
        self.safe_consume(TokenType::QUOTE)
        let label = self.safe_consume_value(TokenType::IDENTIFIER)
        self.safe_consume(TokenType::GREATER)
        ret Option[str]::Some(label)
    }

    fn should_parse_expression_path_generics(mut self) -> bool {
        if self.peek_curr_type() != TokenType::LEFT_BRACKET {
            ret false
        }

        let mut depth = 0_usize
        let mut index = 0_usize
        loop {
            let token_type = self.peek_nth_type(index)
            if token_type == TokenType::EOF {
                ret false
            }
            if token_type == TokenType::LEFT_BRACKET {
                depth = depth + 1_usize
            } elif token_type == TokenType::RIGHT_BRACKET {
                depth = depth - 1_usize
                if depth == 0_usize {
                    let after = self.peek_nth_type(index + 1_usize)
                    ret after == TokenType::SCOPE
                    || after == TokenType::LEFT_PAREN
                    || after == TokenType::LEFT_BRACE
                    || after == TokenType::LESS
                }
            }
            index = index + 1_usize
        }
    }

    fn is_smart_pointer_suffix(mut self) -> bool {
        if self.peek_curr_type() != TokenType::LESS {
            ret false
        }
        let pointer = self.peek_nth(1_usize)
        let closer = self.peek_nth(2_usize)
        if pointer.type != TokenType::IDENTIFIER {
            ret false
        }
        if !(pointer.value == "H" || pointer.value == "S") {
            ret false
        }
        ret closer.type == TokenType::GREATER
    }

    fn is_assignment_operator(mut self, token_type: TokenType) -> bool {
        ret token_type == TokenType::ASSIGN
        || token_type == TokenType::PLUS_EQUAL
        || token_type == TokenType::MINUS_EQUAL
        || token_type == TokenType::ASTERISK_EQUAL
        || token_type == TokenType::POWER_EQUAL
        || token_type == TokenType::SLASH_EQUAL
        || token_type == TokenType::PERCENT_EQUAL
        || token_type == TokenType::AMPERSAND_EQUAL
        || token_type == TokenType::PIPE_EQUAL
        || token_type == TokenType::CARET_EQUAL
        || token_type == TokenType::LEFT_SHIFT_EQUAL
        || token_type == TokenType::RIGHT_SHIFT_EQUAL
    }

    fn is_relational_operator(mut self, token_type: TokenType) -> bool {
        ret token_type == TokenType::LESS
        || token_type == TokenType::GREATER
        || token_type == TokenType::LESS_EQUAL
        || token_type == TokenType::GREATER_EQUAL
    }

    fn is_unary_operator(mut self, token_type: TokenType) -> bool {
        ret token_type == TokenType::PLUS
        || token_type == TokenType::MINUS
        || token_type == TokenType::BANG
        || token_type == TokenType::TILDE
        || token_type == TokenType::INCREMENT
        || token_type == TokenType::DECREMENT
    }

    fn is_numeric_suffix_token(mut self, raw: str) -> bool {
        if raw.len() == 0_usize {
            ret false
        }
        ret raw.byte_at(0_usize) == 95_u8
    }

    fn literal_value(mut self, expr: ExprNode) -> str {
        match expr.value {
            Expr::Integer(value) => {
                ret value
            }
            Expr::Float(value) => {
                ret value
            }
            _ => {
                ret ""
            }
        }
    }

    fn join_strings(mut self, items: Vec[str], separator: str) -> str {
        let mut out = ""
        let mut index = 0_usize
        loop {
            match items.get(index) {
                Option[str]::Some(item) => {
                    if index > 0_usize {
                        out = out + separator
                    }
                    out = out + item
                    index = index + 1_usize
                }
                Option[str]::None => {
                    break
                }
            }
        }
        ret out
    }

    fn unexpected_token(mut self, expected: str, found: Token) ->() {
        self.error_at("expected " + expected + ", found `" + found.value + "`", found)
        ret()
    }

    fn safe_consume(mut self, expected_token_type: TokenType) -> Token {
        let token = self.consume()
        // `static` starts a declaration only in top-level statement position.
        // Keep it contextual everywhere an identifier is expected so adding
        // the declaration syntax does not break existing methods, fields, or
        // qualified calls named `static`.
        let contextual_static = expected_token_type == TokenType::IDENTIFIER
        && token.type == TokenType::KW_STATIC
        if token.type != expected_token_type && !contextual_static {
            self.unexpected_token(Debug::fmt(expected_token_type), token)
        }
        ret token
    }

    fn safe_consume_value(mut self, expected_token_type: TokenType) -> str {
        let token = self.safe_consume(expected_token_type)
        ret token.value
    }

    fn consume(mut self) -> Token {
        let token = self.peek_curr()
        if self.consumed < self.tokens.len() {
            self.consumed = self.consumed + 1_usize
        }
        ret token
    }

    fn consume_value(mut self) -> str {
        let token = self.consume()
        ret token.value
    }

    fn peek_curr(mut self) -> Token {
        ret self.peek_nth(0_usize)
    }

    fn peek_next(mut self) -> Token {
        ret self.peek_nth(1_usize)
    }

    fn peek_nth(mut self, n: usize) -> Token {
        let index = self.consumed + n
        match self.tokens.get(index) {
            Option[Token]::Some(tk) => {
                ret tk
            }
            Option[Token]::None => {
                ret Token::new(TokenType::EOF, "", 0_usize, 0_usize)
            }
        }
    }

    fn peek_curr_type(mut self) -> TokenType {
        let token = self.peek_curr()
        ret token.type
    }

    fn peek_next_type(mut self) -> TokenType {
        let token = self.peek_next()
        ret token.type
    }

    fn peek_nth_type(mut self, n: usize) -> TokenType {
        let token = self.peek_nth(n)
        ret token.type
    }

    fn peek_curr_is_identifier(mut self, expected: str) -> bool {
        if self.peek_curr_type() != TokenType::IDENTIFIER {
            ret false
        }
        let token = self.peek_curr()
        ret token.value == expected
    }

    fn is_at_end(mut self) -> bool {
        ret self.peek_curr_type() == TokenType::EOF
    }
}
