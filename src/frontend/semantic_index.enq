//! Package-wide immutable declarations and ordered module selections.
import refrain::frontend::semantic_rebind::{valid_semantic_type, rebind_semantic_callable, rebind_semantic_field, rebind_semantic_method, rebind_semantic_variant, rebind_semantic_name, rebind_semantic_strings}
import core::option::Option
import core::result::Result

import std::vec::Vec

import binary
import ehirlib::{prepared_bytes_payload, prepared_payload_bytes}
import json::Json

import refrain::frontend::hir::TypeId
import refrain::frontend::semantic::{SemanticCallable, SemanticField, SemanticMethod, SemanticVariant}
import refrain::frontend::semantic_environment::StoredSemanticEnvironment
import refrain::frontend::semantic_record_index::{RecordHash, SemanticRecord, SemanticRecordIndex, same_record_strings}
import refrain::frontend::semantic_slice::{SemanticKeyIndex, SemanticSlice}
import refrain::frontend::type_scope::TypeNameBinding

pub struct ModuleSemanticView {
    module_name: str
    context: str
    callables: Vec[usize]
    fields: Vec[usize]
    methods: Vec[usize]
    variants: Vec[usize]
    names: Vec[usize]
    aggregates: Vec[str]
    constructors: Vec[str]
}
struct CallableBinding {
    declaration: usize
    name: str
    lookup_module: str
    identity: u64
}
struct SemanticIndexArtifact {
    schema: u32
    identity: str
    types: Vec[TypeId]
    declarations: Vec[SemanticCallable]
    bindings: Vec[CallableBinding]
    fields: Vec[SemanticField]
    methods: Vec[SemanticMethod]
    variants: Vec[SemanticVariant]
    names: Vec[TypeNameBinding]
    modules: Vec[ModuleSemanticView]
}
pub struct PackageSemanticIndex {
    identity: str
    types: Vec[TypeId]
    declarations: Vec[SemanticCallable]
    bindings: Vec[CallableBinding]
    callables: Vec[SemanticCallable]
    fields: Vec[SemanticField]
    methods: Vec[SemanticMethod]
    variants: Vec[SemanticVariant]
    names: Vec[TypeNameBinding]
    modules: Vec[ModuleSemanticView]
    module_positions: SemanticKeyIndex
}
pub struct SemanticIndexBuilder {
    index: PackageSemanticIndex
    declarations: SemanticRecordIndex[SemanticCallable]
    bindings: SemanticRecordIndex[CallableBinding]
    fields: SemanticRecordIndex[SemanticField]
    methods: SemanticRecordIndex[SemanticMethod]
    variants: SemanticRecordIndex[SemanticVariant]
    names: SemanticRecordIndex[TypeNameBinding]
}

fn valid_selection(values: Vec[usize], length: usize) -> bool {
    for value in values {
        if value >= length {
            ret false
        }
    }
    ret true
}

impl for PackageSemanticIndex {
    pub fn empty() -> Self {
        ret Self {
            "", Vec[TypeId]::new(), Vec[SemanticCallable]::new(), Vec[CallableBinding]::new(), Vec[SemanticCallable]::new(),
            Vec[SemanticField]::new(), Vec[SemanticMethod]::new(), Vec[SemanticVariant]::new(), Vec[TypeNameBinding]::new(),
            Vec[ModuleSemanticView]::new(), SemanticKeyIndex::new(0_usize)
        }
    }
    pub fn module(self: Self, module_name: str) -> Option[ModuleSemanticView] {
        let position = self.module_positions.get(module_name)
        if position == 0_usize {
            ret Option::None
        }
        ret self.modules.get(position - 1_usize)
    }
    pub fn callables_for(self: Self, view: ModuleSemanticView) -> SemanticSlice[SemanticCallable] {
        ret SemanticSlice::project(self.callables, view.callables)
    }
    pub fn fields_for(self: Self, view: ModuleSemanticView) -> SemanticSlice[SemanticField] {
        ret SemanticSlice::project(self.fields, view.fields)
    }
    pub fn methods_for(self: Self, view: ModuleSemanticView) -> SemanticSlice[SemanticMethod] {
        ret SemanticSlice::project(self.methods, view.methods)
    }
    pub fn variants_for(self: Self, view: ModuleSemanticView) -> SemanticSlice[SemanticVariant] {
        ret SemanticSlice::project(self.variants, view.variants)
    }
    pub fn names_for(self: Self, view: ModuleSemanticView) -> SemanticSlice[TypeNameBinding] {
        ret SemanticSlice::project(self.names, view.names)
    }
    pub fn rebind(self: Self, identities: Vec[str], types: Vec[TypeId]) -> Result[Self, str] {
        let mut declarations = Vec[SemanticCallable]::with_capacity(self.declarations.len())
        for value in self.declarations {
            declarations.push(rebind_semantic_callable(value, identities)?)
        }
        let mut callables = Vec[SemanticCallable]::with_capacity(self.bindings.len())
        for binding in self.bindings {
            callables.push(declarations.get_unchecked_borrowed(binding.declaration).in_scope(binding.name, binding.lookup_module, binding.identity))
        }
        let mut fields = Vec[SemanticField]::with_capacity(self.fields.len())
        for value in self.fields {
            fields.push(rebind_semantic_field(value, identities)?)
        }
        let mut methods = Vec[SemanticMethod]::with_capacity(self.methods.len())
        for value in self.methods {
            methods.push(rebind_semantic_method(value, identities)?)
        }
        let mut variants = Vec[SemanticVariant]::with_capacity(self.variants.len())
        for value in self.variants {
            variants.push(rebind_semantic_variant(value, identities)?)
        }
        let mut names = Vec[TypeNameBinding]::with_capacity(self.names.len())
        for value in self.names {
            names.push(rebind_semantic_name(value, identities)?)
        }
        let mut modules = Vec[ModuleSemanticView]::with_capacity(self.modules.len())
        for value in self.modules {
            modules.push(ModuleSemanticView {
                    value.module_name, value.context, value.callables,
                    value.fields, value.methods, value.variants, value.names, rebind_semantic_strings(value.aggregates, identities)?,
                    rebind_semantic_strings(value.constructors, identities)?
                }
            )
        }
        ret Result::Ok(Self {
                self.identity, types, declarations, self.bindings, callables, fields, methods, variants, names, modules, self.module_positions
            }
        )
    }
    pub fn encode(self: Self) -> Result[str, str] {
        match binary::encode(SemanticIndexArtifact {
                1_u32, self.identity, self.types, self.declarations, self.bindings,
                self.fields, self.methods, self.variants, self.names, self.modules
            }
        ) {
            Ok(bytes) => {
                ret Result::Ok(prepared_bytes_payload(bytes))
            }
            Err(error) => {
                ret Result::Err(error.message())
            }
        }
        ret Result::Err("cannot encode semantic index")
    }
    pub fn decode(payload: str, identity: str) -> Result[Self, str] {
        let value = match binary::decode[SemanticIndexArtifact](prepared_payload_bytes(payload)) {
            Ok(value) => value Err(error) => {
                ret Result::Err(error.message())
            }
        }
        if value.schema != 1_u32 ||(!identity.is_empty() && value.identity != identity) {
            ret Result::Err("semantic index identity or schema mismatch")
        }
        let mut type_keys = SemanticKeyIndex::new(value.types.len())
        for position in 0_usize..value.types.len() {
            let key = value.types.get_unchecked_borrowed(position).key()
            if key.is_empty() || type_keys.get(key) != 0_usize {
                ret Result::Err("invalid semantic type table")
            }
            type_keys.set(key, position)
        }
        let type_count = value.types.len()
        for declaration in value.declarations {
            if !valid_semantic_type(declaration.ret_type, type_count) {
                ret Result::Err("invalid callable type")
            }
            for param in declaration.params {
                if !valid_semantic_type(param, type_count) {
                    ret Result::Err("invalid parameter type")
                }
            }
        }
        for field in value.fields {
            if !valid_semantic_type(field.owner_type, type_count) || !valid_semantic_type(field.typ, type_count) {
                ret Result::Err("invalid field type")
            }
        }
        for method in value.methods {
            if !valid_semantic_type(method.receiver_type, type_count) || !valid_semantic_type(method.ret_type, type_count) {
                ret Result::Err("invalid method type")
            }
            for param in method.params {
                if !valid_semantic_type(param, type_count) {
                    ret Result::Err("invalid method parameter type")
                }
            }
        }
        for variant in value.variants {
            if !valid_semantic_type(variant.owner_type, type_count) || !valid_semantic_type(variant.payload_type, type_count) {
                ret Result::Err("invalid variant type")
            }
        }
        for name in value.names {
            if !valid_semantic_type(name.identity, type_count) {
                ret Result::Err("invalid binding type")
            }
        }
        let mut callables = Vec[SemanticCallable]::with_capacity(value.bindings.len())
        for binding in value.bindings {
            let declaration = match value.declarations.get(binding.declaration) {
                Some(value) => value None => {
                    ret Result::Err("invalid semantic callable ordinal")
                }
            }
            callables.push(declaration.in_scope(binding.name, binding.lookup_module, binding.identity))
        }
        let mut positions = SemanticKeyIndex::new(value.modules.len())
        for position in 0_usize..value.modules.len() {
            let view = value.modules.get_unchecked_borrowed(position)
            if positions.get(view.module_name) != 0_usize || !valid_selection(view.callables, callables.len()) ||
            !valid_selection(view.fields, value.fields.len()) || !valid_selection(view.methods, value.methods.len()) ||
            !valid_selection(view.variants, value.variants.len()) || !valid_selection(view.names, value.names.len()) {
                ret Result::Err("invalid semantic module selection")
            }
            for typ in view.aggregates {
                if !valid_semantic_type(typ, type_count) {
                    ret Result::Err("invalid aggregate type")
                }
            }
            for typ in view.constructors {
                if !valid_semantic_type(typ, type_count) {
                    ret Result::Err("invalid constructor type")
                }
            }
            positions.set(view.module_name, position)
        }
        ret Result::Ok(Self {
                value.identity, value.types, value.declarations, value.bindings, callables, value.fields,
                value.methods, value.variants, value.names, value.modules, positions
            }
        )
    }
}

impl for SemanticIndexBuilder {
    pub fn new(identity: str) -> Self {
        let mut index = PackageSemanticIndex::empty()
        index.identity = identity
        ret Self {
            index, SemanticRecordIndex[SemanticCallable]::new(), SemanticRecordIndex[CallableBinding]::new(),
            SemanticRecordIndex[SemanticField]::new(), SemanticRecordIndex[SemanticMethod]::new(),
            SemanticRecordIndex[SemanticVariant]::new(), SemanticRecordIndex[TypeNameBinding]::new()
        }
    }
    pub fn include(self: mut Self, module_name: str, context: str, environment: StoredSemanticEnvironment) ->() {
        let mut callables = Vec[usize]::with_capacity(environment.callables.len())
        for value in environment.callables {
            let declaration = value.in_scope(value.declaration_name, value.module_name, 0_u64)
            let ordinal = self.declarations.intern(declaration)
            let before = self.bindings.len()
            let binding = self.bindings.intern(CallableBinding {
                    ordinal, value.name, value.lookup_module, value.binding_identity
                }
            )
            if binding == before {
                let canonical = self.declarations.get_unchecked_borrowed(ordinal)
                self.index.callables.push(canonical.in_scope(value.name, value.lookup_module, value.binding_identity))
            }
            callables.push(binding)
        }
        let mut fields = Vec[usize]::with_capacity(environment.fields.len())
        for value in environment.fields {
            fields.push(self.fields.intern(value))
        }
        let mut methods = Vec[usize]::with_capacity(environment.methods.len())
        for value in environment.methods {
            methods.push(self.methods.intern(value))
        }
        let mut variants = Vec[usize]::with_capacity(environment.variants.len())
        for value in environment.variants {
            variants.push(self.variants.intern(value))
        }
        let mut names = Vec[usize]::with_capacity(environment.names.len())
        for value in environment.names {
            names.push(self.names.intern(value))
        }
        self.index.module_positions.set(module_name, self.index.modules.len())
        self.index.modules.push(ModuleSemanticView {
                module_name, context, callables, fields, methods, variants, names, environment.aggregates, environment.constructors
            }
        )
    }
    pub fn finish(self: Self, types: Vec[TypeId]) -> PackageSemanticIndex {
        let mut index = self.index
        index.types = types
        index.declarations = self.declarations.values()
        index.bindings = self.bindings.values()
        index.fields = self.fields.values()
        index.methods = self.methods.values()
        index.variants = self.variants.values()
        index.names = self.names.values()
        ret index
    }
}

pub struct SemanticModuleRecord {
    schema: u32
    index: str
    replay: Json
}
pub fn encode_semantic_module(index: str, replay: Json) -> Result[str, str] {
    match binary::encode(SemanticModuleRecord { 1_u32, index, replay }) {
        Ok(bytes) => {
            ret Result::Ok(prepared_bytes_payload(bytes))
        }
        Err(error) => {
            ret Result::Err(error.message())
        }
    }
    ret Result::Err("cannot encode semantic module")
}
pub fn decode_semantic_module(payload: str) -> Result[SemanticModuleRecord, str] {
    let record = match binary::decode[SemanticModuleRecord](prepared_payload_bytes(payload)) {
        Ok(value) => value Err(error) => {
            ret Result::Err(error.message())
        }
    }
    if record.schema != 1_u32 || record.index.is_empty() {
        ret Result::Err("invalid semantic module schema")
    }
    ret Result::Ok(record)
}

// Equality matches every field of the former JSON keys. Declaration signatures
// are cheap hash hints, never proof of equality. These helpers are construction-only.

impl SemanticRecord for SemanticCallable {
    pub fn record_hash(self: Self) -> u64 {
        let mut hash = RecordHash::new()
        hash.text(self.name)
        hash.integer(self.signature)
        hash.text(self.lookup_module)
        hash.integer(self.binding_identity)
        ret hash.finish()
    }
    pub fn same_record(self: Self, other: Self) -> bool {
        ret self.module_name == other.module_name &&
        self.name == other.name &&
        same_record_strings(self.params, other.params) &&
        self.ret_type == other.ret_type &&
        self.signature == other.signature &&
        self.declaration_name == other.declaration_name &&
        self.lookup_module == other.lookup_module &&
        self.binding_identity == other.binding_identity &&
        same_record_strings(self.generic_names, other.generic_names) &&
        self.is_static == other.is_static
    }
}

impl SemanticRecord for CallableBinding {
    pub fn record_hash(self: Self) -> u64 {
        let mut hash = RecordHash::new()
        hash.integer(self.declaration as u64)
        hash.text(self.name)
        hash.text(self.lookup_module)
        hash.integer(self.identity)
        ret hash.finish()
    }
    pub fn same_record(self: Self, other: Self) -> bool {
        ret self.declaration == other.declaration &&
        self.name == other.name &&
        self.lookup_module == other.lookup_module &&
        self.identity == other.identity
    }
}

impl SemanticRecord for SemanticField {
    pub fn record_hash(self: Self) -> u64 {
        let mut hash = RecordHash::new()
        hash.text(self.owner_type)
        hash.integer(self.signature)
        ret hash.finish()
    }
    pub fn same_record(self: Self, other: Self) -> bool {
        ret self.module_name == other.module_name &&
        self.owner_type == other.owner_type &&
        self.name == other.name &&
        self.typ == other.typ &&
        self.signature == other.signature &&
        same_record_strings(self.generic_names, other.generic_names) &&
        self.declaration_owner == other.declaration_owner
    }
}

impl SemanticRecord for SemanticMethod {
    pub fn record_hash(self: Self) -> u64 {
        let mut hash = RecordHash::new()
        hash.text(self.receiver_type)
        hash.integer(self.signature)
        hash.flag(self.is_static)
        hash.flag(self.is_public)
        ret hash.finish()
    }
    pub fn same_record(self: Self, other: Self) -> bool {
        ret self.module_name == other.module_name &&
        self.receiver_type == other.receiver_type &&
        self.name == other.name &&
        same_record_strings(self.params, other.params) &&
        self.ret_type == other.ret_type &&
        self.signature == other.signature &&
        self.declaration_receiver == other.declaration_receiver &&
        same_record_strings(self.generic_names, other.generic_names) &&
        self.is_static == other.is_static &&
        self.is_public == other.is_public &&
        same_record_strings(self.method_generic_names, other.method_generic_names)
    }
}

impl SemanticRecord for SemanticVariant {
    pub fn record_hash(self: Self) -> u64 {
        let mut hash = RecordHash::new()
        hash.text(self.owner_type)
        hash.text(self.name)
        hash.text(self.payload_type)
        hash.strings(self.generic_names)
        ret hash.finish()
    }
    pub fn same_record(self: Self, other: Self) -> bool {
        ret self.owner_type == other.owner_type &&
        self.name == other.name &&
        self.payload_type == other.payload_type &&
        same_record_strings(self.generic_names, other.generic_names)
    }
}

impl SemanticRecord for TypeNameBinding {
    pub fn record_hash(self: Self) -> u64 {
        let mut hash = RecordHash::new()
        hash.text(self.scope)
        hash.text(self.name)
        hash.text(self.identity)
        ret hash.finish()
    }
    pub fn same_record(self: Self, other: Self) -> bool {
        ret self.scope == other.scope &&
        self.name == other.name &&
        self.identity == other.identity &&
        self.display == other.display &&
        self.declaration == other.declaration
    }
}
