import core::option::Option
import std::vec::Vec

import refrain::frontend::dependency_graph::DependencyGraph
import refrain::frontend::lexer::Lexer
import refrain::frontend::lexer::Token
import refrain::frontend::lexer::TokenType
import refrain::frontend::parser::Parser
import refrain::frontend::parser::Statement


pub struct FrontendDiagnostic {
    severity: usize
    code: str
    message: str
    line: usize
    column: usize
    length: usize
}

pub struct FrontendSymbol {
    name: str
    kind: usize
    line: usize
    column: usize
    length: usize
}

pub struct FrontendCallable {
    name: str
    params: Vec[str]
    ret_type: Option[str]
    line: usize
    column: usize
    length: usize
}

pub struct FrontendDocument {
    tokens: Vec[Token]
    ast: Vec[Statement]
    diagnostics: Vec[FrontendDiagnostic]
    symbols: Vec[FrontendSymbol]
    callables: Vec[FrontendCallable]
    dependencies: DependencyGraph
    parsed: bool
}

impl for FrontendDiagnostic {
    pub fn new(severity: usize, code: str, message: str, line: usize, column: usize, length: usize) -> Self {
        ret Self {severity, code, message, line, column, length}
    }
}

impl for FrontendSymbol {
    pub fn new(name: str, kind: usize, line: usize, column: usize, length: usize) -> Self {
        ret Self {name, kind, line, column, length}
    }
}

impl for FrontendCallable {
    pub fn new(name: str, params: Vec[str], ret_type: Option[str], line: usize, column: usize, length: usize) -> Self {
        ret Self {name, params, ret_type, line, column, length}
    }
}

impl for FrontendDocument {
    pub fn empty() -> Self {
        ret Self {
            Vec[Token]::new(),
            Vec[Statement]::new(),
            Vec[FrontendDiagnostic]::new(),
            Vec[FrontendSymbol]::new(),
            Vec[FrontendCallable]::new(),
            DependencyGraph::new(),
            false
        }
    }
}

pub fn analyze_source(source: str) -> FrontendDocument {
    ret analyze_module("document", source)
}

pub fn analyze_source_lightweight(source: str) -> FrontendDocument {
    ret analyze_module_lightweight("document", source)
}

pub fn analyze_module_lightweight(module_name: str, source: str) -> FrontendDocument {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)
    let mut diagnostics = collect_lexer_diagnostics(tokens)
    let symbols = collect_symbols(tokens)
    let callables = collect_callables(tokens)
    let dependencies = DependencyGraph::from_tokens(module_name, tokens)

    if diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            diagnostics,
            symbols,
            callables,
            dependencies,
            false
        }
    }

    let structural_diagnostics = collect_structural_diagnostics(tokens)
    if structural_diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            structural_diagnostics,
            symbols,
            callables,
            dependencies,
            false
        }
    }

    diagnostics.extend(collect_declaration_diagnostics(tokens))

    ret FrontendDocument {
        tokens,
        Vec[Statement]::new(),
        diagnostics,
        symbols,
        callables,
        dependencies,
        true
    }
}

pub fn analyze_module(module_name: str, source: str) -> FrontendDocument {
    ret analyze_named_module(module_name, module_name, source)
}

pub fn analyze_named_module(module_name: str, source_name: str, source: str) -> FrontendDocument {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)
    let mut diagnostics = collect_lexer_diagnostics(tokens)
    let symbols = collect_symbols(tokens)
    let callables = collect_callables(tokens)

    if diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            diagnostics,
            symbols,
            callables,
            DependencyGraph::new(),
            false
        }
    }

    let structural_diagnostics = collect_structural_diagnostics(tokens)
    if structural_diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            structural_diagnostics,
            symbols,
            callables,
            DependencyGraph::new(),
            false
        }
    }


    diagnostics.extend(collect_declaration_diagnostics(tokens))
    if diagnostics.len() > 0_usize {
        ret FrontendDocument {
            tokens,
            Vec[Statement]::new(),
            diagnostics,
            symbols,
            callables,
            DependencyGraph::new(),
            false
        }
    }

    let mut parser = Parser::new_for_source(source_name)
    let ast = parser.parse(tokens)
    let dependencies = DependencyGraph::from_tokens(module_name, tokens)

    ret FrontendDocument {
        tokens,
        ast,
        diagnostics,
        symbols,
        callables,
        dependencies,
        true
    }
}

fn collect_lexer_diagnostics(tokens: Vec[Token]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    for token in tokens {
        if token.type == TokenType::UNKNOWN && token.value != "$" {
            out.push(FrontendDiagnostic::new(1_usize, "unknown-token", "unknown token: " + token.value, token.line, token.column, token.value.char_len()))
        }
    }
    ret out
}

fn collect_structural_diagnostics(tokens: Vec[Token]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    let mut parens = 0_i32
    let mut braces = 0_i32
    let mut brackets = 0_i32

    for token in tokens {
        match token.type {
            TokenType::LEFT_PAREN => {
                parens += 1_i32
            }
            TokenType::RIGHT_PAREN => {
                parens -= 1_i32
                if parens < 0_i32 {
                    out.push(FrontendDiagnostic::new(1_usize, "unmatched-closing-parenthesis", "unmatched closing parenthesis", token.line, token.column, token.value.char_len()))
                    ret out
                }
            }
            TokenType::LEFT_BRACE => {
                braces += 1_i32
            }
            TokenType::RIGHT_BRACE => {
                braces -= 1_i32
                if braces < 0_i32 {
                    out.push(FrontendDiagnostic::new(1_usize, "unmatched-closing-brace", "unmatched closing brace", token.line, token.column, token.value.char_len()))
                    ret out
                }
            }
            TokenType::LEFT_BRACKET => {
                brackets += 1_i32
            }
            TokenType::RIGHT_BRACKET => {
                brackets -= 1_i32
                if brackets < 0_i32 {
                    out.push(FrontendDiagnostic::new(1_usize, "unmatched-closing-bracket", "unmatched closing bracket", token.line, token.column, token.value.char_len()))
                    ret out
                }
            }
            _ => {}
        }
    }

    match last_token(tokens) {
        Option[Token]::Some(token) => {
            if parens > 0_i32 {
                out.push(FrontendDiagnostic::new(2_usize, "unclosed-parenthesis", "unclosed parenthesis", token.line, token.column + token.value.char_len(), 1_usize))
            }
            elif braces > 0_i32 {
                out.push(FrontendDiagnostic::new(2_usize, "unclosed-brace", "unclosed brace", token.line, token.column + token.value.char_len(), 1_usize))
            }
            elif brackets > 0_i32 {
                out.push(FrontendDiagnostic::new(2_usize, "unclosed-bracket", "unclosed bracket", token.line, token.column + token.value.char_len(), 1_usize))
            }
        }
        Option[Token]::None => {}
    }

    ret out
}

fn collect_declaration_diagnostics(tokens: Vec[Token]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    let mut function_names = Vec[str]::new()
    let mut brace_depth = 0_i32
    let mut pending_attribute = false
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if brace_depth == 0_i32 && token.type == TokenType::HASH { pending_attribute = true }
                elif token.type == TokenType::LEFT_BRACE { brace_depth += 1_i32 }
                elif token.type == TokenType::RIGHT_BRACE { brace_depth -= 1_i32 }
                elif brace_depth == 0_i32 && token.type == TokenType::KW_FN {
                    match next_significant_token(tokens, index + 1_usize) {
                        Option[Token]::Some(name) => {
                            if name.type == TokenType::IDENTIFIER && !pending_attribute {
                                if contains_name(function_names, name.value) {
                                    out.push(FrontendDiagnostic::new(1_usize, "duplicate-function", "duplicate function declaration '" + name.value + "'", name.line, name.column, name.value.char_len()))
                                } else {
                                    function_names.push(name.value)
                                }
                            }
                        }
                        Option[Token]::None => {}
                    }
                    pending_attribute = false
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret out
}

fn next_significant_token(tokens: Vec[Token], start: usize) -> Option[Token] {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type != TokenType::WHITESPACE && token.type != TokenType::NEWLINE && token.type != TokenType::ONE_LINE_COMMENT && token.type != TokenType::MULTI_LINE_COMMENT {
                    ret Option[Token]::Some(token)
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret Option[Token]::None
}

fn contains_name(names: Vec[str], needle: str) -> bool {
    for name in names { if name == needle { ret true } }
    ret false
}

fn last_token(tokens: Vec[Token]) -> Option[Token] {
    if tokens.len() == 0_usize {
        ret Option[Token]::None
    }
    ret tokens.get(tokens.len() - 1_usize)
}

fn collect_symbols(tokens: Vec[Token]) -> Vec[FrontendSymbol] {
    let mut out = Vec[FrontendSymbol]::new()
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                match token.type {
                    TokenType::KW_FN => {
                        push_next_identifier_symbol(out, tokens, index, 12_usize)
                    }
                    TokenType::KW_STRUCT => {
                        push_next_identifier_symbol(out, tokens, index, 23_usize)
                    }
                    TokenType::KW_ENUM => {
                        push_next_identifier_symbol(out, tokens, index, 10_usize)
                    }
                    TokenType::KW_TRAIT => {
                        push_next_identifier_symbol(out, tokens, index, 11_usize)
                    }
                    TokenType::KW_IMPL => {
                        push_impl_symbol(out, tokens, index)
                    }
                    _ => {}
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret out
}

fn collect_callables(tokens: Vec[Token]) -> Vec[FrontendCallable] {
    let mut out = Vec[FrontendCallable]::new()
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::KW_FN {
                    push_function_callable(out, tokens, index)
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret out
}

fn push_function_callable(out: mut Vec[FrontendCallable], tokens: Vec[Token], fn_index: usize) -> () {
    match next_identifier_token(tokens, fn_index + 1_usize) {
        Option[Token]::Some(name_token) => {
            let name_index = first_token_index(tokens, name_token)
            let params = collect_function_params(tokens, name_index + 1_usize)
            let ret_type = collect_function_return_type(tokens, name_index + 1_usize)
            out.push(FrontendCallable::new(name_token.value, params, ret_type, name_token.line, name_token.column, name_token.value.char_len()))
        }
        Option[Token]::None => {}
    }
    ret ()
}

fn collect_function_params(tokens: Vec[Token], start: usize) -> Vec[str] {
    let mut params = Vec[str]::new()
    let mut index = start
    let mut depth = 0_i32
    let mut in_params = false

    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if !in_params {
                    if token.type == TokenType::LEFT_PAREN {
                        in_params = true
                        depth = 1_i32
                    }
                }
                else {
                    if token.type == TokenType::LEFT_PAREN {
                        depth += 1_i32
                    }
                    elif token.type == TokenType::RIGHT_PAREN {
                        depth -= 1_i32
                        if depth == 0_i32 {
                            ret params
                        }
                    }
                    elif depth == 1_i32 {
                        if token.type == TokenType::IDENTIFIER {
                            if next_token_is(tokens, index + 1_usize, TokenType::COLON) {
                                params.push(token.value)
                            }
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }

    ret params
}

fn collect_function_return_type(tokens: Vec[Token], start: usize) -> Option[str] {
    let mut index = start
    let mut depth = 0_i32
    let mut after_params = false

    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::LEFT_PAREN {
                    depth += 1_i32
                }
                elif token.type == TokenType::RIGHT_PAREN {
                    depth -= 1_i32
                    if depth == 0_i32 {
                        after_params = true
                    }
                }
                elif after_params {
                    if token.type == TokenType::ARROW {
                        ret collect_type_after_arrow(tokens, index + 1_usize)
                    }
                    if token.type == TokenType::LEFT_BRACE {
                        ret Option[str]::None
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }

    ret Option[str]::None
}

fn collect_type_after_arrow(tokens: Vec[Token], start: usize) -> Option[str] {
    let mut out = ""
    let mut index = start
    let mut bracket_depth = 0_i32
    let mut paren_depth = 0_i32

    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if bracket_depth == 0_i32 && paren_depth == 0_i32 {
                    if token.type == TokenType::LEFT_BRACE {
                        break
                    }
                    if token.type == TokenType::COMMA {
                        break
                    }
                }

                if token.type == TokenType::LEFT_BRACKET {
                    bracket_depth += 1_i32
                }
                elif token.type == TokenType::RIGHT_BRACKET {
                    bracket_depth -= 1_i32
                }
                elif token.type == TokenType::LEFT_PAREN {
                    paren_depth += 1_i32
                }
                elif token.type == TokenType::RIGHT_PAREN {
                    paren_depth -= 1_i32
                }
                out += token.value
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }

    if out.len() == 0_usize {
        ret Option[str]::None
    }
    ret Option[str]::Some(out)
}

fn next_token_is(tokens: Vec[Token], index: usize, expected: TokenType) -> bool {
    match tokens.get(index) {
        Option[Token]::Some(token) => {
            ret token.type == expected
        }
        Option[Token]::None => {
            ret false
        }
    }
}

fn push_next_identifier_symbol(out: mut Vec[FrontendSymbol], tokens: Vec[Token], start: usize, kind: usize) -> () {
    match next_identifier_token(tokens, start + 1_usize) {
        Option[Token]::Some(name_token) => {
            out.push(FrontendSymbol::new(name_token.value, kind, name_token.line, name_token.column, name_token.value.char_len()))
        }
        Option[Token]::None => {}
    }
    ret ()
}

fn push_impl_symbol(out: mut Vec[FrontendSymbol], tokens: Vec[Token], start: usize) -> () {
    let mut name = "impl"
    match next_identifier_token(tokens, start + 1_usize) {
        Option[Token]::Some(first) => {
            if first.value == "for" {
                match next_identifier_token(tokens, first_token_index(tokens, first) + 1_usize) {
                    Option[Token]::Some(target) => {
                        name = "impl " + target.value
                    }
                    Option[Token]::None => {}
                }
            }
            else {
                name = "impl " + first.value
            }
        }
        Option[Token]::None => {}
    }

    match tokens.get(start) {
        Option[Token]::Some(token) => {
            out.push(FrontendSymbol::new(name, 5_usize, token.line, token.column, name.char_len()))
        }
        Option[Token]::None => {}
    }
    ret ()
}

fn next_identifier_token(tokens: Vec[Token], start: usize) -> Option[Token] {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.type == TokenType::IDENTIFIER {
                    ret Option[Token]::Some(token)
                }
                if token.type == TokenType::KW_FOR {
                    ret Option[Token]::Some(Token::new(TokenType::IDENTIFIER, "for", token.line, token.column))
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret Option[Token]::None
}

fn first_token_index(tokens: Vec[Token], needle: Token) -> usize {
    let mut index = 0_usize
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if token.line == needle.line {
                    if token.column == needle.column {
                        if token.value == needle.value {
                            ret index
                        }
                    }
                }
            }
            Option[Token]::None => {}
        }
        index += 1_usize
    }
    ret 0_usize
}
