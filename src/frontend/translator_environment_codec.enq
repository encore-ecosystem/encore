pub fn encode_snapshot_TranslationEnvironmentArtifact(value: TranslationEnvironmentArtifact, identity: str) -> Result[Vec[u8], str] {
    let mut writer = new_snapshot_writer("ENQTE002", identity)
    write_TranslationEnvironmentArtifact(writer, value)
    unsafe {
        encore_strmap_free(writer.strings)
    }
    if writer.failed {
        ret Result::Err("EHIR snapshot " + writer.failure + " limit (" + Debug::fmt(writer.bytes.len()) + " bytes)")
    }
    ret Result::Ok(writer.bytes)
}
pub fn decode_snapshot_TranslationEnvironmentArtifact(bytes: Vec[u8], identity: str) -> Result[TranslationEnvironmentArtifact, str] {
    let mut reader = new_snapshot_reader(bytes, "ENQTE002", identity)?
    let value = read_TranslationEnvironmentArtifact(reader)?
    if reader.cursor != reader.bytes.len() {
        ret Result::Err("trailing EHIR snapshot bytes")
    }
    ret Result::Ok(value)
}
