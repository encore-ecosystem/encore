    for _index in 0_usize..count {
        value.push(read_StoredTranslationReflection(reader)?)
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_Vec_StoredTranslationSourceAlias(writer: mut SnapshotWriter, value: frozen Vec[StoredTranslationSourceAlias]) ->() {
    if !writer_enter(writer) {
        ret()
    }
    write_count(writer, value.len())
    for item in value {
        write_StoredTranslationSourceAlias(writer, item)
    }
    writer.depth -= 1_usize
}

fn read_Vec_StoredTranslationSourceAlias(reader: mut SnapshotReader) -> Result[Vec[StoredTranslationSourceAlias], str] {
