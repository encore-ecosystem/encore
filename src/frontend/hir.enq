//! Backend-neutral semantic HIR identities and module definition maps.
//!
//! Syntax nodes are intentionally not exposed here. Compiler, LSP, IDE and
//! agent clients query stable definitions and types, while lowering remains
//! free to replace or incrementally reparse the source tree.

import core::fmt::Debug
import core::option::Option
import std::dict::Hashable
import std::vec::Vec

/// Stable identity of a declaration across database revisions.
pub struct DefinitionId {
    raw: u64 key: str
}

/// Stable identity of a function or method body.
pub struct BodyId {
    raw: u64 key: str
}

/// Stable identity of an expression inside a body.
pub struct ExpressionId {
    raw: u64 key: str
}

/// Interned semantic type identity. Display text is presentation-only.
pub struct TypeId {
    raw: u64 key: str display: str
}

/// Namespace occupied by a definition.
pub enum DefinitionNamespace {
    Type
    Value
    Trait
    Module
}

/// Kind of a semantic definition.
pub enum DefinitionKind {
    Module
    Import
    Function
    Struct
    Enum
    Trait
    Method
    Field
    Variant
    GenericParameter
    Parameter
}

/// A declaration lowered from syntax into backend-neutral semantic HIR.
pub struct HirDefinition {
    id: DefinitionId
    module_name: str
    name: str
    kind: DefinitionKind
    namespace: DefinitionNamespace
    is_public: bool
    source_name: str
    line: usize
    column: usize
    length: usize
    typ: TypeId
}

/// One imported or locally declared name in a module namespace.
pub struct ScopeEntry {
    name: str
    namespace: DefinitionNamespace
    definition: DefinitionId
}

/// Query result used for name resolution without walking syntax trees.
pub struct ModuleDefMap {
    module_name: str
    definitions: Vec[HirDefinition]
    scope: Vec[ScopeEntry]
}

impl for HirDefinition {
    pub fn new(
        id: DefinitionId,
        module_name: str,
        name: str,
        kind: DefinitionKind,
        namespace: DefinitionNamespace,
        is_public: bool,
        source_name: str,
        line: usize,
        column: usize,
        length: usize,
        typ: TypeId,
    ) -> Self {
        ret Self {
            id, module_name, name, kind, namespace, is_public, source_name, line, column, length, typ
        }
    }

    pub fn id(self: Self) -> DefinitionId {
        ret self.id
    }
    pub fn module_name(self: Self) -> str {
        ret self.module_name
    }
    pub fn name(self: Self) -> str {
        ret self.name
    }
    pub fn kind(self: Self) -> DefinitionKind {
        ret self.kind
    }
    pub fn namespace(self: Self) -> DefinitionNamespace {
        ret self.namespace
    }
    pub fn is_public(self: Self) -> bool {
        ret self.is_public
    }
    pub fn source_name(self: Self) -> str {
        ret self.source_name
    }
    pub fn line(self: Self) -> usize {
        ret self.line
    }
    pub fn column(self: Self) -> usize {
        ret self.column
    }
    pub fn length(self: Self) -> usize {
        ret self.length
    }
    pub fn typ(self: Self) -> TypeId {
        ret self.typ
    }
}

impl for DefinitionId {
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for BodyId {
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for ExpressionId {
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for TypeId {
    pub fn unknown() -> Self {
        ret Self {
            0_u64, "", ""
        }
    }

    /// Interns a canonical type spelling into a deterministic identity.
    pub fn named(canonical: str, display: str) -> Self {
        if canonical == "" {
            ret Self::unknown()
        }
        let raw = nonzero_hash("type#" + canonical)
        ret Self {
            raw, canonical, display
        }
    }

    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
    pub fn display_name(self: Self) -> str {
        ret self.display
    }
    pub fn is_unknown(self: Self) -> bool {
        ret self.raw == 0_u64
    }
}

impl for ModuleDefMap {
    pub fn new(module_name: str) -> Self {
        ret Self {
            module_name, Vec[HirDefinition]::new(), Vec[ScopeEntry]::new()
        }
    }

    pub fn module_name(self: Self) -> str {
        ret self.module_name
    }

    pub fn insert(self: mut Self, definition: HirDefinition) ->() {
        self.scope.push(ScopeEntry {
                definition.name, definition.namespace, definition.id
            }
            ,
        )
        self.definitions.push(definition)
        ret()
    }

    pub fn resolve(self: Self, name: str, namespace: DefinitionNamespace) -> Option[DefinitionId] {
        for entry in self.scope {
            if entry.name == name && same_namespace(entry.namespace, namespace) {
                ret Option[DefinitionId]::Some(entry.definition)
            }
        }
        ret Option[DefinitionId]::None
    }

    pub fn definition(self: Self, id: DefinitionId) -> Option[HirDefinition] {
        for definition in self.definitions {
            if definition.id.raw == id.raw && definition.id.key == id.key {
                ret Option[HirDefinition]::Some(definition)
            }
        }
        ret Option[HirDefinition]::None
    }

    pub fn all_definitions(self: Self) -> Vec[HirDefinition] {
        ret self.definitions
    }
}

/// Creates a deterministic definition identity from semantic ownership.
pub fn definition_id(module_name: str, owner: str, kind: str, name: str, ordinal: usize) -> DefinitionId
{
    let key = module_name + "#" + owner + "#" + kind + "#" + name + "#" + Debug::fmt(ordinal)
    ret DefinitionId {
        nonzero_hash(key), key
    }
}

fn same_namespace(left: DefinitionNamespace, right: DefinitionNamespace) -> bool {
    match left {
        DefinitionNamespace::Type => {
            ret right == DefinitionNamespace::Type
        }
        DefinitionNamespace::Value => {
            ret right == DefinitionNamespace::Value
        }
        DefinitionNamespace::Trait => {
            ret right == DefinitionNamespace::Trait
        }
        DefinitionNamespace::Module => {
            ret right == DefinitionNamespace::Module
        }
    }
}

fn nonzero_hash(value: str) -> u64 {
    let hashed = value.hash()
    if hashed == 0_u64 {
        ret 1_u64
    }
    ret hashed
}
