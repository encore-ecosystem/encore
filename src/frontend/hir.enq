//! Backend-neutral semantic HIR identities and module definition maps.
//!
//! Syntax nodes are intentionally not exposed here. Compiler, LSP, IDE and
//! agent clients query stable definitions and types, while lowering remains
//! free to replace or incrementally reparse the source tree.

import core::fmt::Debug
import core::option::Option
import std::dict::Hashable
import std::vec::Vec

extern fn encore_strmap_new() -> usize
extern fn encore_strmap_put(map: usize, key: str, value: usize) ->()
extern fn encore_strmap_get(map: usize, key: str) -> usize
extern fn encore_strmap_free(map: usize) ->()

/// Stable identity of a declaration across database revisions.
pub struct DefinitionId {
    raw: u64
    key: str
}

/// Stable identity of a function or method body.
pub struct BodyId {
    raw: u64
    key: str
}

/// Stable identity of an expression inside a body.
pub struct ExpressionId {
    raw: u64
    key: str
}

/// Interned semantic type identity. Display text is presentation-only.
pub struct TypeId {
    raw: u64
    key: str
    display: str
}

/// Namespace occupied by a definition.
pub enum DefinitionNamespace {
    Type
    Value
    Trait
    Module
}

/// Kind of a semantic definition.
pub enum DefinitionKind {
    Module
    Import
    Function
    Struct
    Enum
    Trait
    Method
    Field
    Variant
    GenericParameter
    Parameter
}

/// A declaration lowered from syntax into backend-neutral semantic HIR.
pub struct HirDefinition {
    id: DefinitionId
    module_name: str
    name: str
    kind: DefinitionKind
    namespace: DefinitionNamespace
    is_public: bool
    source_name: str
    line: usize
    column: usize
    length: usize
    typ: TypeId
    rename_binding: str
}

/// One imported or locally declared name in a module namespace.
pub struct ScopeEntry {
    name: str
    namespace: DefinitionNamespace
    definition: DefinitionId
}

/// Query result used for name resolution without walking syntax trees.
pub struct ModuleDefMap {
    module_name: str
    definitions: Vec[HirDefinition]
    scope: Vec[ScopeEntry]
}

impl for HirDefinition {
    pub fn new(
        id: DefinitionId,
        module_name: str,
        name: str,
        kind: DefinitionKind,
        namespace: DefinitionNamespace,
        is_public: bool,
        source_name: str,
        line: usize,
        column: usize,
        length: usize,
        typ: TypeId,
    ) -> Self {
        ret Self {
            id, module_name, name, kind, namespace, is_public, source_name, line, column, length, typ, ""
        }
    }

    pub fn id(self: Self) -> DefinitionId {
        ret self.id
    }
    /// Physical declaration identity shared by logical and URI module views.
    /// Owner, kind, name and ordinal remain stable when preceding lines change.
    pub fn source_identity(self: Self) -> DefinitionId {
        if self.source_name == "" {
            ret self.id
        }
        let key = self.source_name + self.id.key.slice(self.module_name.len(), self.id.key.len() - self.module_name.len())
        ret DefinitionId {
            nonzero_hash(key), key
        }
    }
    pub fn module_name(self: Self) -> str {
        ret self.module_name
    }
    pub fn name(self: Self) -> str {
        ret self.name
    }
    /// Returns the owner recorded in this declaration's semantic identity.
    pub fn owner(self: Self) -> str {
        let start = self.module_name.byte_len() + 1
        let key = self.id.key
        let mut end = start
        while end < key.byte_len() && key.byte_at(end) != 35 {
            end += 1
        }
        ret key.slice_bytes(start, end - start)
    }
    pub fn kind(self: Self) -> DefinitionKind {
        ret self.kind
    }
    pub fn namespace(self: Self) -> DefinitionNamespace {
        ret self.namespace
    }
    pub fn is_public(self: Self) -> bool {
        ret self.is_public
    }
    pub fn source_name(self: Self) -> str {
        ret self.source_name
    }
    pub fn line(self: Self) -> usize {
        ret self.line
    }
    pub fn column(self: Self) -> usize {
        ret self.column
    }
    pub fn length(self: Self) -> usize {
        ret self.length
    }
    pub fn typ(self: Self) -> TypeId {
        ret self.typ
    }
    /// An explicit import alias has an independent rename identity, but keeps
    /// the original declaration ID and span for navigation and type analysis.
    pub fn rename_binding(self: Self) -> str {
        ret self.rename_binding
    }
    pub fn with_rename_binding(self: Self, binding: str) -> Self {
        ret Self {
            self.id, self.module_name, self.name, self.kind, self.namespace,
            self.is_public, self.source_name, self.line, self.column, self.length,
            self.typ, binding
        }
    }
}

impl for DefinitionId {
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for BodyId {
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for ExpressionId {
    pub fn invalid() -> Self {
        ret Self {
            0_u64, ""
        }
    }
    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
}

impl for TypeId {
    /// Gives a nominal type its physical declaration identity, independently
    /// of imports, aliases, and logical module views of the same source.
    pub fn declared(id: DefinitionId, module_name: str, source_name: str, display: str) -> Self {
        let identity = if source_name == "" {
            id.key()
        } else {
            source_name + id.key().slice(module_name.len(), id.key().len() - module_name.len())
        }
        ret Self::named("declaration:" + identity, display)
    }

    pub fn unknown() -> Self {
        ret Self {
            0_u64, "", ""
        }
    }

    /// Interns a canonical type spelling into a deterministic identity.
    pub fn named(canonical: str, display: str) -> Self {
        if canonical == "" {
            ret Self::unknown()
        }
        let raw = nonzero_hash("type#" + canonical)
        ret Self {
            raw, canonical, display
        }
    }

    pub fn value(self: Self) -> u64 {
        ret self.raw
    }
    pub fn key(self: Self) -> str {
        ret self.key
    }
    pub fn display_name(self: Self) -> str {
        ret self.display
    }
    pub fn is_unknown(self: Self) -> bool {
        ret self.raw == 0_u64
    }
}

impl for ModuleDefMap {
    pub fn new(module_name: str) -> Self {
        ret Self {
            module_name, Vec[HirDefinition]::new(), Vec[ScopeEntry]::new()
        }
    }

    pub fn module_name(self: Self) -> str {
        ret self.module_name
    }

    pub fn insert(self: mut Self, definition: HirDefinition) ->() {
        // Receiver members have an owner scope, not the module namespace.
        let module_scoped = match definition.kind {
            DefinitionKind::Method => false
            DefinitionKind::Field => false
            DefinitionKind::Variant => false
            DefinitionKind::Parameter => false
            DefinitionKind::GenericParameter => false
            _ => true
        }
        if module_scoped {
            self.scope.push(ScopeEntry {
                    definition.name, definition.namespace, definition.id
                }
                ,)
        }
        self.definitions.push(definition)
        ret()
    }

    pub fn resolve(self: Self, name: str, namespace: DefinitionNamespace) -> Option[DefinitionId] {
        match self.named_definition(name, namespace) {
            Some(definition) => {
                ret Option[DefinitionId]::Some(definition.id)
            }
            None => {
                ret Option[DefinitionId]::None
            }
        }
    }

    /// Resolve the scope entry itself: several aliases can share a declaration ID.
    pub fn named_definition(self: Self, name: str, namespace: DefinitionNamespace) -> Option[HirDefinition] {
        let mut imported = Option[HirDefinition]::None
        for entry in self.scope {
            if entry.name == name && same_namespace(entry.namespace, namespace) {
                for definition in self.definitions {
                    if definition.name == name && same_namespace(definition.namespace, namespace)
                    && definition.id.key == entry.definition.key {
                        match definition.kind {
                            DefinitionKind::Import => {
                                if imported.is_none() {
                                    imported = Option[HirDefinition]::Some(definition)
                                }
                            }
                            _ => {
                                ret Option[HirDefinition]::Some(definition)
                            }
                        }
                    }
                }
            }
        }
        ret imported
    }

    pub fn definition(self: Self, id: DefinitionId) -> Option[HirDefinition] {
        for definition in self.definitions {
            if definition.id.raw == id.raw && definition.id.key == id.key {
                ret Option[HirDefinition]::Some(definition)
            }
        }
        ret Option[HirDefinition]::None
    }

    pub fn all_definitions(self: Self) -> Vec[HirDefinition] {
        ret self.definitions
    }

    /// Resolves a complete module namespace in one pass. Local declarations
    /// override imports exactly as in `named_definition`; members stay scoped.
    pub fn namespace_definitions(self: Self, namespace: DefinitionNamespace) -> Vec[HirDefinition] {
        let mut selected = Vec[HirDefinition]::new()
        let slots = encore_strmap_new()
        for definition in self.definitions {
            if !same_namespace(definition.namespace, namespace) {
                continue
            }
            match definition.kind {
                DefinitionKind::Method => {
                    continue
                }
                DefinitionKind::Field => {
                    continue
                }
                DefinitionKind::Variant => {
                    continue
                }
                DefinitionKind::Parameter => {
                    continue
                }
                DefinitionKind::GenericParameter => {
                    continue
                }
                _ => {
                }
            }
            let slot = encore_strmap_get(slots, definition.name)
            if slot == 0 {
                selected.push(definition)
                encore_strmap_put(slots, definition.name, selected.len())
            } else {
                match selected.get(slot - 1) {
                    Some(previous) => {
                        if previous.kind == DefinitionKind::Import && definition.kind != DefinitionKind::Import {
                            selected.set(slot - 1, definition)
                        }
                    }
                    None => {
                    }
                }
            }
        }
        encore_strmap_free(slots)
        ret selected
    }
}

/// Creates a deterministic definition identity from semantic ownership.
pub fn definition_id(module_name: str, owner: str, kind: str, name: str, ordinal: usize) -> DefinitionId
{
    let key = module_name + "#" + owner + "#" + kind + "#" + name + "#" + Debug::fmt(ordinal)
    ret DefinitionId {
        nonzero_hash(key), key
    }
}

fn same_namespace(left: DefinitionNamespace, right: DefinitionNamespace) -> bool {
    match left {
        DefinitionNamespace::Type => {
            ret right == DefinitionNamespace::Type
        }
        DefinitionNamespace::Value => {
            ret right == DefinitionNamespace::Value
        }
        DefinitionNamespace::Trait => {
            ret right == DefinitionNamespace::Trait
        }
        DefinitionNamespace::Module => {
            ret right == DefinitionNamespace::Module
        }
    }
}

#attr(test)
fn semantic_hir_namespace_batch_contract() -> bool {
    let mut map = ModuleDefMap::new("scope")
    map.insert(HirDefinition::new(definition_id("imported", "", "struct", "Item", 0),
            "imported", "Item", DefinitionKind::Import, DefinitionNamespace::Type, true,
            "/imported.enq", 0, 0, 4, TypeId::named("imported", "Item"),))
    map.insert(HirDefinition::new(definition_id("scope", "", "struct", "Item", 0),
            "scope", "Item", DefinitionKind::Struct, DefinitionNamespace::Type, true,
            "/scope.enq", 1, 0, 4, TypeId::named("local", "Item"),))
    map.insert(HirDefinition::new(definition_id("scope", "Item", "field", "hidden", 0),
            "scope", "hidden", DefinitionKind::Field, DefinitionNamespace::Value, true,
            "/scope.enq", 1, 6, 6, TypeId::named("u32", "u32"),))
    let values = map.namespace_definitions(DefinitionNamespace::Type)
    if values.len() != 1 || map.namespace_definitions(DefinitionNamespace::Value).len() != 0 {
        ret false
    }
    let actual = match values.get(0) {
        Some(value) => value None => {
            ret false
        }
    }
    let expected = match map.named_definition("Item", DefinitionNamespace::Type) {
        Some(value) => value None => {
            ret false
        }
    }
    ret actual.typ().key() == "local"
    && actual.id().key() == expected.id().key()
}

fn nonzero_hash(value: str) -> u64 {
    let hashed = value.hash()
    if hashed == 0_u64 {
        ret 1_u64
    }
    ret hashed
}
