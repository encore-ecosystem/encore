//! Provides the lossless syntax input shared by formatting and source tools.

import std::vec::Vec

import refrain::frontend::lexer::{Lexer, Token, TokenType}

/// Retains every source byte and its lossless lexical representation.
pub struct SyntaxDocument {
    source: str
    tokens: Vec[Token]
    valid: bool
}

impl for SyntaxDocument {
    /// Creates an empty placeholder for a lazy syntax query.
    pub fn empty() -> Self {
        ret Self {
            "", Vec[Token]::new(), true
        }
    }

    /// Lexes source without discarding whitespace or comments.
    pub fn parse(source: str) -> Self {
        let mut lexer = Lexer::new()
        let tokens = lexer.tokenize_lossless(source)
        let mut valid = true
        for token in tokens {
            if token.type == TokenType::UNKNOWN {
                valid = false
            }
        }
        ret Self {
            source, tokens, valid
        }
    }

    /// Returns the exact original source bytes.
    pub fn text(self: Self) -> str {
        ret self.source
    }

    /// Returns the complete token stream, including trivia.
    pub fn lossless_tokens(self: Self) -> Vec[Token] {
        ret self.tokens
    }

    /// Returns whether lexing completed without unknown tokens.
    pub fn is_valid(self: Self) -> bool {
        ret self.valid
    }

    /// Reconstructs the source from the lossless token stream.
    pub fn reconstructed_text(self: Self) -> str {
        let mut out = ""
        for token in self.tokens {
            out += token.value
        }
        ret out
    }
}
