//! Construction-only interning of immutable typed records. No serialized keys.
import std::vec::Vec

pub trait SemanticRecord {
    fn record_hash(self: Self) -> u64
    fn same_record(self: Self, other: Self) -> bool
}

pub struct RecordHash {
    value: u64
}

impl for RecordHash {
    pub fn new() -> Self {
        ret Self { 1469598103934665603_u64 }
    }
    pub fn integer(self: mut Self, value: u64) ->() {
        self.value =(self.value ^ value) * 1099511628211_u64
    }
    pub fn text(self: mut Self, value: str) ->() {
        // Accumulate locally instead of updating a mutable record per byte.
        let mut hash =(self.value ^(value.byte_len() as u64)) * 1099511628211_u64
        for index in 0_usize..value.byte_len() {
            hash =(hash ^(value.byte_at(index) as u64)) * 1099511628211_u64
        }
        self.value = hash
    }
    pub fn strings(self: mut Self, values: Vec[str]) ->() {
        self.integer(values.len() as u64)
        for value in values {
            self.text(value)
        }
    }
    pub fn flag(self: mut Self, value: bool) ->() {
        self.integer(if value {
                1_u64
            } else {
                0_u64
            }
        )
    }
    pub fn finish(self: Self) -> u64 {
        ret self.value
    }
}

pub fn same_record_strings(left: Vec[str], right: Vec[str]) -> bool {
    if left.len() != right.len() {
        ret false
    }
    for index in 0_usize..left.len() {
        if left.get_unchecked_borrowed(index) != right.get_unchecked_borrowed(index) {
            ret false
        }
    }
    ret true
}

/// Slots contain ordinals into the canonical records. Cached hashes speed up
/// growth and probing; full equality remains authoritative for every match.
pub struct SemanticRecordIndex[T] {
    records: Vec[T]
    hashes: Vec[u64]
    slots: Vec[usize]
}

impl[T: SemanticRecord] for SemanticRecordIndex[T] {
    pub fn new() -> Self {
        let mut slots = Vec[usize]::with_capacity(128_usize)
        for _index in 0_usize..128_usize {
            slots.push(0_usize)
        }
        ret Self { Vec[T]::new(), Vec[u64]::new(), slots }
    }
    #attr(borrowed_self)
    pub fn len(self: Self) -> usize {
        ret self.records.len()
    }
    pub fn values(self: Self) -> Vec[T] {
        ret self.records
    }
    #attr(borrowed_self)
    #attr(borrowed_return)
    pub fn get_unchecked_borrowed(self: Self, index: usize) -> T {
        ret self.records.get_unchecked_borrowed(index)
    }
    fn grow(self: mut Self) ->() {
        let capacity = self.slots.len() * 2_usize
        let mask = capacity - 1_usize
        let mut slots = Vec[usize]::with_capacity(capacity)
        for _index in 0_usize..capacity {
            slots.push(0_usize)
        }
        for index in 0_usize..self.hashes.len() {
            let mut slot =(self.hashes.get_unchecked_borrowed(index) as usize) & mask
            while slots.get_unchecked_borrowed(slot) != 0_usize {
                slot =(slot + 1_usize) & mask
            }
            slots.set(slot, index + 1_usize)
        }
        self.slots = slots
    }
    /// Returns a stable zero-based ordinal; the first equal record wins.
    pub fn intern(self: mut Self, value: T) -> usize {
        if self.records.len() >= self.slots.len() / 2_usize {
            self.grow()
        }
        let hash = value.record_hash()
        let mask = self.slots.len() - 1_usize
        let mut slot =(hash as usize) & mask
        loop {
            let encoded = self.slots.get_unchecked_borrowed(slot)
            if encoded == 0_usize {
                let index = self.records.len()
                self.records.push(value)
                self.hashes.push(hash)
                self.slots.set(slot, index + 1_usize)
                ret index
            }
            let index = encoded - 1_usize
            if self.hashes.get_unchecked_borrowed(index) == hash &&
            self.records.get_unchecked_borrowed(index).same_record(value) {
                ret index
            }
            slot =(slot + 1_usize) & mask
        }
    }
}
