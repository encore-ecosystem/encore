//! Defines reusable, incremental semantic results for function-body queries.
import refrain::frontend::semantic_slice::SemanticSlice

import core::fmt::Debug
import core::option::Option
import core::result::Result

import std::dict::Hashable
import std::vec::Vec

import json::{Json, stringify}

import refrain::cache_identity::compiler_content_digest
import refrain::frontend::analysis::{DiagnosticLabel, DiagnosticLabelKind, DiagnosticSuggestion, FrontendDiagnostic, SuggestionApplicability}
import refrain::frontend::control_flow::statements_terminate_flow
import refrain::frontend::metadata_ast::encode_lowered_function_input
import refrain::frontend::parser::{BlockExpr, Expr, ExprNode, FunctionItem, FunctionParam, GenericParam, IfExprBranch, ImplStmt, MatchArmBody, MatchPattern, ParsedBlock, Statement, TraitStmt}
import refrain::frontend::reflection::{ReflectionBinding, ReflectionShape, expand_reflection_function, function_uses_reflection, reflection_binding_sites}
import refrain::frontend::type_scope::{TypeNameBinding, TypeScopeIndex, declaration_type_name_view, display_type_view, scope_type_view, scope_type_indexed, type_scope_index_view}
import refrain::target::{TargetSpec, cfg_active_with_features}

/// Records the inferred type of a local binding.
pub struct SemanticBinding {
    name: str
    typ: str
    line: usize
    column: usize
}

/// One binding with its lexical lifetime and post-initializer visibility.
pub struct ScopedSemanticBinding {
    binding: SemanticBinding
    scope:(usize, usize, usize, usize)
    visible_line: usize
    visible_column: usize
}

/// Identifies a declaration signature read while checking a body.
pub enum SemanticDependencyKind {
    Function
    FunctionBinding
    TypeScope
    Method
    Field
    LookupScope
}

pub struct SemanticDependency {
    module_name: str
    name: str
    signature: u64
    kind: SemanticDependencyKind
}

/// Describes one callable visible to a semantic body query.
pub struct SemanticCallable {
    module_name: str
    name: str
    params: Vec[str]
    ret_type: str
    signature: u64
    declaration_name: str
    lookup_module: str
    binding_identity: u64
    generic_names: Vec[str]
    is_static: bool
}

/// Call sites receive a future, while the body still returns its declared output.
/// Keep the output intact through bindings and generic substitution before await.
pub fn semantic_call_return_type(item: FunctionItem) -> str {
    let output = item.ret_type.unwrap_or("void")
    ret if item.is_async {
        "__encore_async_future[" + output + "]"
    } else {
        output
    }
}

/// Describes one field available through a resolved aggregate type.
pub struct SemanticField {
    module_name: str
    owner_type: str
    name: str
    typ: str
    signature: u64
    generic_names: Vec[str]
    declaration_owner: str
}

/// Declared enum payload, with the enum's own generic binder order.
pub struct SemanticVariant {
    owner_type: str
    name: str
    payload_type: str
    generic_names: Vec[str]
}

/// Describes one inherent or trait method after impl resolution.
pub struct SemanticMethod {
    module_name: str
    receiver_type: str
    name: str
    params: Vec[str]
    ret_type: str
    signature: u64
    declaration_receiver: str
    generic_names: Vec[str]
    is_static: bool
    is_public: bool
    method_generic_names: Vec[str]
}

/// Private inherent members are accessible only from an impl of their type.
/// Inputs use declaration identities, so aliases cannot grant extra access.
pub fn semantic_same_owner(left: str, right: str) -> bool {
    ret left != "" && right != "" &&
    semantic_root_type(semantic_type_name(left)) == semantic_root_type(semantic_type_name(right))
}

pub fn semantic_method_accessible(method: SemanticMethod, access_owner: str) -> bool {
    ret method.is_public || semantic_same_owner(method.receiver_type, access_owner)
}

pub fn semantic_accessible_methods_view(methods: SemanticSlice[SemanticMethod], access_owner: str) -> Vec[SemanticMethod] {
    let mut out = Vec[SemanticMethod]::new()
    for method in methods {
        if semantic_method_accessible(method, access_owner) {
            out.push(method)
        }
    }
    ret out
}

/// One field or method offered for a concrete receiver type.
pub struct SemanticMember {
    name: str
    typ: str
    params: Vec[str]
    is_method: bool
    declaration_module: str
    declaration_owner: str
}

/// Uses the same receiver matching and generic substitution as body checking.
pub fn semantic_members_view(receiver: str, fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod]) -> Vec[SemanticMember] {
    ret semantic_named_members_view(receiver, "", fields, methods)
}

/// Resolves one member name without specializing unrelated fields and methods.
/// An empty name requests the complete completion environment.
pub fn semantic_named_members_view(receiver: str, name_filter: str, fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod]) -> Vec[SemanticMember] {
    ret semantic_access_members(receiver, name_filter, fields, methods, false)
}

/// Specializes static members with the same receiver rules as associated calls.
pub fn semantic_associated_members_view(receiver: str, name: str, methods: SemanticSlice[SemanticMethod]) -> Vec[SemanticMember] {
    ret semantic_access_members(receiver, name, SemanticSlice[SemanticField]::from_vec(Vec[SemanticField]::new()), methods, true)
}

fn semantic_access_members(receiver: str, name_filter: str, fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], is_static: bool) -> Vec[SemanticMember] {
    let mut out = Vec[SemanticMember]::new()
    if receiver == "" {
        ret out
    }
    if !is_static && starts_with(receiver, "(") {
        let mut index = 0_usize
        loop {
            let name = Debug::fmt(index)
            let typ = tuple_element_type(receiver, name)
            if typ == "" {
                break
            }
            if name_filter == "" || name == name_filter {
                out.push(SemanticMember {
                        name, typ, Vec[str]::new(), false, "", ""
                    }
                    ,
                )
            }
            index += 1_usize
        }
    }
    for field in fields {
        if name_filter != "" && field.name != name_filter {
            continue
        }
        if semantic_receiver_matches(field.owner_type, receiver, field.generic_names) {
            out.push(SemanticMember {
                    field.name, specialize_method_type(field.typ, field.owner_type, receiver, field.generic_names),
                    Vec[str]::new(), false, field.module_name, semantic_root_type(field.declaration_owner)
                }
                ,)
        }
    }
    for method in methods {
        if (is_static && !method.is_static) ||(!is_static && method.is_static && starts_with(method.receiver_type, "dyn ")) {
            continue
        }
        if name_filter != "" && method.name != name_filter {
            continue
        }
        if semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
            out.push(SemanticMember {
                    method.name, specialize_method_type(method.ret_type, method.receiver_type, receiver, method.generic_names),
                    specialize_method_types(method.params, method.receiver_type, receiver, method.generic_names), true,
                    method.module_name, method_declaration_owner(method.declaration_receiver)
                }
                ,)
        }
    }
    ret out
}

fn method_declaration_owner(receiver: str) -> str {
    if starts_with(receiver, "dyn ") {
        ret semantic_root_type(receiver.slice(4_usize, receiver.len() - 4_usize))
    }
    ret receiver
}

/// Contains the reusable semantic facts and diagnostics of one function body.
/// Function facts retained by the package worker for safety inference.
pub struct CheckedFunctionBody {
    item: FunctionItem
    owner: str
    body: SemanticBody
}

pub struct CheckedModuleBodies {
    diagnostics: Vec[FrontendDiagnostic]
    functions: Vec[CheckedFunctionBody]
    replay: Json
    checked: usize
    reused: usize
}

struct ReplayedSemanticBody {
    body: SemanticBody
    record: Json
}

enum SemanticBodyPlan {
    ReplayFacts(ReplayedSemanticBody)
    CheckSource
}

struct SemanticReplay {
    previous: Json
    lines: Vec[str]
    records: Vec[Json]
    checked: usize
    reused: usize
    enabled: bool
    type_index: TypeScopeIndex
    type_index_ready: bool
}

fn semantic_source_lines(source: str) -> Vec[str] {
    let mut lines = Vec[str]::new()
    let mut start = 0_usize
    for index in 0_usize..source.byte_len() {
        if source.byte_at(index) == 10_u8 {
            lines.push(source.slice_bytes(start, index - start))
            start = index + 1_usize
        }
    }
    lines.push(source.slice_bytes(start, source.byte_len() - start))
    ret lines
}

pub struct SemanticBody {
    bindings: Vec[SemanticBinding]
    diagnostics: Vec[FrontendDiagnostic]
    dependencies: Vec[SemanticDependency]
    return_type: str
    scoped_bindings: Vec[ScopedSemanticBinding]
    member_receivers: Vec[(usize, usize, str)]
    bound_methods: Vec[SemanticMethod]
    type_names: SemanticSlice[TypeNameBinding]
    implicit_receivers: Vec[(usize, usize, str, str)]
    access_owner: str
}

struct SemanticContext {
    callables: SemanticSlice[SemanticCallable]
    fields: SemanticSlice[SemanticField]
    methods: SemanticSlice[SemanticMethod]
    self_type: str
    generic_names: Vec[str]
    bindings: Vec[SemanticBinding]
    diagnostics: Vec[FrontendDiagnostic]
    dependencies: Vec[SemanticDependency]
    scope:(usize, usize, usize, usize)
    scoped_bindings: Vec[ScopedSemanticBinding]
    aggregate_names: Vec[str]
    member_receivers: Vec[(usize, usize, str)]
    type_names: SemanticSlice[TypeNameBinding]
    type_scope: str
    implicit_receivers: Vec[(usize, usize, str, str)]
    variants: SemanticSlice[SemanticVariant]
    is_async: bool
    type_index: TypeScopeIndex
}

impl for SemanticBody {
    /// Lexical sites are reusable by editor highlighting without exposing types.
    pub fn binding_sites(self: Self) -> Vec[ScopedSemanticBinding] {
        ret self.scoped_bindings
    }
    /// Returns an empty result for callers handling a missing declaration.
    pub fn empty() -> Self {
        ret Self {
            Vec[SemanticBinding]::new(), Vec[FrontendDiagnostic]::new(), Vec[SemanticDependency]::new(),
            "", Vec[ScopedSemanticBinding]::new(), Vec[(usize, usize, str)]::new(), Vec[SemanticMethod]::new(), SemanticSlice[TypeNameBinding]::from_vec(Vec[TypeNameBinding]::new()), Vec[(usize, usize, str, str)]::new(), ""
        }
    }

    /// Returns the inferred receiver at a field or method token, including a missing member.
    pub fn member_receiver_at(self: Self, line: usize, column: usize) -> str {
        ret display_type_view(self.canonical_member_receiver_at(line, column), self.type_names)
    }

    /// Internal receiver identity for semantic matching, not user-facing text.
    pub fn canonical_member_receiver_at(self: Self, line: usize, column: usize) -> str {
        for receiver in self.member_receivers {
            if receiver.0 == line && receiver.1 == column {
                ret receiver.2
            }
        }
        ret ""
    }

    /// Returns the inferred or declared type of a local binding.
    pub fn binding_type(self: Self, name: str) -> Option[str] {
        for binding in self.bindings {
            if binding.name == name {
                ret Option[str]::Some(binding.typ)
            }
        }
        ret Option[str]::None
    }

    /// Resolves shadowing only among bindings visible at this source position.
    pub fn bindings_at(self: Self, line: usize, column: usize) -> Vec[SemanticBinding] {
        let mut out = Vec[SemanticBinding]::new()
        let mut index = self.scoped_bindings.len()
        while index > 0_usize {
            index -= 1_usize
            match self.scoped_bindings.get(index) {
                Some(site) => {
                    if !position_before_or_equal(site.scope.0, site.scope.1, line, column)
                    || !position_before_or_equal(line, column, site.scope.2, site.scope.3)
                    || !position_before_or_equal(site.visible_line, site.visible_column, line, column) {
                        continue
                    }
                    let mut duplicate = false
                    for existing in out {
                        if existing.name == site.binding.name {
                            duplicate = true break
                        }
                    }
                    if !duplicate {
                        out.push(site.binding)
                    }
                }
                None => {
                }
            }
        }
        ret out
    }

    /// Resolves shadowing only among bindings visible at this source position.
    pub fn binding_at(self: Self, name: str, line: usize, column: usize) -> Option[SemanticBinding] {
        ret self.binding_at_with_rename(name, line, column, 0_usize, 0_usize, "", false)
    }

    /// Checks lexical identity under a hypothetical rename without changing the AST or cache.
    pub fn rename_preserves_binding(self: Self, name: str, line: usize, column: usize,
        declaration_line: usize, declaration_column: usize, new_name: str,) -> bool {
        let before = self.binding_at(name, line, column)
        let mut queried_name = name
        match before {
            Some(binding) => {
                if binding.line == declaration_line && binding.column == declaration_column {
                    queried_name = new_name
                }
            }
            None => {
            }
        }
        let after = self.binding_at_with_rename(queried_name, line, column,
            declaration_line, declaration_column, new_name, true,)
        match before {
            Some(binding) => {
                match after {
                    Some(changed) => {
                        ret binding.line == changed.line && binding.column == changed.column
                    }
                    None => {
                        ret false
                    }
                }
            }
            None => {
                ret after.is_none()
            }
        }
    }

    fn binding_at_with_rename(self: Self, name: str, line: usize, column: usize,
        declaration_line: usize, declaration_column: usize, new_name: str,
        rename: bool,) -> Option[SemanticBinding] {
        let mut index = self.scoped_bindings.len()
        while index > 0_usize {
            index -= 1_usize
            match self.scoped_bindings.get(index) {
                Some(site) => {
                    let candidate_name = if rename && site.binding.line == declaration_line
                    && site.binding.column == declaration_column {
                        new_name
                    } else {
                        site.binding.name
                    }
                    if candidate_name == name
                    &&((site.binding.line == line && site.binding.column == column)
                        ||(position_before_or_equal(site.scope.0, site.scope.1, line, column)
                            && position_before_or_equal(line, column, site.scope.2, site.scope.3)
                            && position_before_or_equal(site.visible_line, site.visible_column, line, column))) {
                        ret Option[SemanticBinding]::Some(site.binding)
                    }
                }
                None => {
                }
            }
        }
        ret Option[SemanticBinding]::None
    }
}

fn position_before_or_equal(a_line: usize, a_column: usize, b_line: usize, b_column: usize) -> bool {
    ret a_line < b_line ||(a_line == b_line && a_column <= b_column)
}

impl for SemanticCallable {
    /// Creates a callable and its deterministic declaration fingerprint.
    pub fn new(module_name: str, name: str, params: Vec[str], ret_type: str) -> Self {
        let mut key = module_name + "#" + name + "("
        for param in params {
            key += param + ","
        }
        key += ")->" + ret_type
        ret Self {
            module_name, name, params, ret_type, nonzero_hash(key), name, "", 0_u64, Vec[str]::new(), false
        }
    }

    /// Changes only the visible spelling, preserving dependency identity.
    pub fn in_scope(self: Self, name: str, module_name: str, identity: u64) -> Self {
        ret Self {
            self.module_name, name, self.params, self.ret_type, self.signature,
            self.declaration_name, module_name, identity, self.generic_names, self.is_static
        }
    }

    pub fn with_generics(self: Self, names: Vec[str]) -> Self {
        ret Self {
            self.module_name, self.name, self.params, self.ret_type,
            generic_signature(self.signature, names), self.declaration_name, self.lookup_module,
            self.binding_identity, names, self.is_static
        }
    }

    /// Static reads use the declaration's value type and dependency identity.
    pub fn with_static(self: Self, is_static: bool) -> Self {
        let signature = if is_static {
            nonzero_hash(Debug::fmt(self.signature) + "#static")
        } else {
            self.signature
        }
        ret Self {
            self.module_name, self.name, self.params, self.ret_type, signature,
            self.declaration_name, self.lookup_module, self.binding_identity, self.generic_names, is_static
        }
    }

    /// An inferred static's value type participates in dependency invalidation.
    pub fn with_return_type(self: Self, typ: str) -> Self {
        if typ == self.ret_type {
            ret self
        }
        ret Self {
            self.module_name, self.name, self.params, typ,
            nonzero_hash(Debug::fmt(self.signature) + "#return:" + typ),
            self.declaration_name, self.lookup_module, self.binding_identity, self.generic_names, self.is_static
        }
    }
}

impl for SemanticField {
    pub fn new(module_name: str, owner_type: str, name: str, typ: str) -> Self {
        let key = module_name + "#" + owner_type + "." + name + ":" + typ
        ret Self {
            module_name, owner_type, name, typ, nonzero_hash(key), Vec[str]::new(), owner_type
        }
    }

    pub fn with_generics(self: Self, names: Vec[str]) -> Self {
        ret Self {
            self.module_name, self.owner_type, self.name, self.typ,
            generic_signature(self.signature, names), names, self.declaration_owner
        }
    }

    /// Changes lookup types without moving the declaration or its cache key.
    pub fn in_receiver_scope(self: Self, owner: str, typ: str) -> Self {
        ret Self {
            self.module_name, owner, self.name, typ, self.signature,
            self.generic_names, self.declaration_owner
        }
    }
}

impl for SemanticMethod {
    pub fn new(module_name: str, receiver_type: str, name: str, params: Vec[str], ret_type: str) -> Self
    {
        let mut key = module_name + "#" + receiver_type + "." + name + "("
        for param in params {
            key += param + ","
        }
        key += ")->" + ret_type
        ret Self {
            module_name, receiver_type, name, params, ret_type, nonzero_hash(key), receiver_type, Vec[str]::new(), false, true, Vec[str]::new()
        }
    }

    pub fn with_generics(self: Self, names: Vec[str]) -> Self {
        ret Self {
            self.module_name, self.receiver_type, self.name, self.params, self.ret_type,
            generic_signature(self.signature, names), self.declaration_receiver, names, self.is_static, self.is_public, self.method_generic_names
        }
    }

    /// Records function binders separately from the impl's receiver binders.
    pub fn with_method_generics(self: Self, names: Vec[str]) -> Self {
        if names.len() == 0_usize {
            ret self
        }
        ret Self {
            self.module_name, self.receiver_type, self.name, self.params, self.ret_type,
            generic_signature(nonzero_hash(Debug::fmt(self.signature) + "#method"), names),
            self.declaration_receiver, self.generic_names, self.is_static, self.is_public, names
        }
    }

    pub fn with_static(self: Self, is_static: bool) -> Self {
        let signature = if is_static {
            nonzero_hash(Debug::fmt(self.signature) + "#static")
        } else {
            self.signature
        }
        ret Self {
            self.module_name, self.receiver_type, self.name, self.params, self.ret_type,
            signature, self.declaration_receiver, self.generic_names, is_static, self.is_public, self.method_generic_names
        }
    }

    pub fn with_visibility(self: Self, is_public: bool) -> Self {
        ret Self {
            self.module_name, self.receiver_type, self.name, self.params, self.ret_type,
            if is_public {
                self.signature
            } else {
                nonzero_hash(Debug::fmt(self.signature) + "#private")
            }
            ,
            self.declaration_receiver, self.generic_names, self.is_static, is_public, self.method_generic_names
        }
    }

    /// Exposes an inherited method while preserving the signature's true owner.
    pub fn inherited_by(self: Self, receiver: str, parent: str, generics: Vec[str]) -> Option[SemanticMethod] {
        if semantic_root_type(self.receiver_type) != semantic_root_type(parent) {
            ret Option[SemanticMethod]::None
        }
        let mut params = Vec[str]::new()
        for param in self.params {
            params.push(specialize_method_type_with_self(param, self.receiver_type, parent, "Self", self.generic_names))
        }
        let result = specialize_method_type_with_self(self.ret_type, self.receiver_type, parent, "Self", self.generic_names)
        ret Option[SemanticMethod]::Some(Self {
                self.module_name, receiver, self.name, params, result,
                self.signature, self.declaration_receiver, generics, self.is_static, self.is_public, self.method_generic_names
            }
            ,)
    }
}

/// Checks one function body without performing EHIR lowering.
pub fn check_function_body_view(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str) -> SemanticBody {
    ret check_function_body_with_types_view(item, callables, fields, methods, self_type, Vec[str]::new())
}

/// Checks with explicit known aggregate names, including types with no fields.
pub fn check_function_body_with_types_view(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str, aggregate_names: Vec[str]) -> SemanticBody {
    if semantic_function_has_attr(item, "decorator") {
        ret SemanticBody {
            Vec[SemanticBinding]::new(), Vec[FrontendDiagnostic]::new(), Vec[SemanticDependency]::new(),
            item.ret_type.unwrap_or("void"), Vec[ScopedSemanticBinding]::new(), Vec[(usize, usize, str)]::new(), Vec[SemanticMethod]::new(), SemanticSlice[TypeNameBinding]::from_vec(Vec[TypeNameBinding]::new()), Vec[(usize, usize, str, str)]::new(), self_type
        }
    }
    ret check_function_body_with_scope_view(item, callables, fields, methods, self_type, Vec[GenericParam]::new(), aggregate_names)
}

pub fn check_function_body_with_scope_view(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str, scope_generics: Vec[GenericParam], aggregate_names: Vec[str]) -> SemanticBody {
    ret check_function_body_with_type_scope_view(item, callables, fields, methods, self_type,
        scope_generics, aggregate_names, "", SemanticSlice[TypeNameBinding]::from_vec(Vec[TypeNameBinding]::new()),)
}

pub fn check_function_body_with_type_scope_view(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str, scope_generics: Vec[GenericParam], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding]) -> SemanticBody {
    ret check_function_body_with_variants_view(item, callables, fields, methods, self_type, scope_generics,
        aggregate_names, type_scope, type_names, SemanticSlice[SemanticVariant]::from_vec(Vec[SemanticVariant]::new()),)
}

pub fn check_function_body_with_variants_view(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str, scope_generics: Vec[GenericParam], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant]) -> SemanticBody {
    ret check_function_body_indexed(item, callables, fields, methods, self_type, scope_generics,
        aggregate_names, type_scope, type_names, variants, type_scope_index_view(type_names),)
}

fn check_function_body_indexed(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str, scope_generics: Vec[GenericParam], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant], type_index: TypeScopeIndex) -> SemanticBody {
    let reflection_sites = if function_uses_reflection(item) {
        reflection_binding_sites(item)
    } else {
        Vec[ReflectionBinding]::new()
    }
    if function_uses_reflection(item) {
        if !item.generics.is_empty() || !scope_generics.is_empty() {
            let mut result = SemanticBody::empty()
            result.return_type = item.ret_type.unwrap_or("void")
            result.type_names = type_names
            result.access_owner = self_type
            match item.body {
                Some(block) => {
                    for parameter in item.params {
                        let declared = parameter.typ.unwrap_or("void")
                        let typ = if declared == "Self" {
                            self_type
                        } else {
                            declared
                        }
                        let binding = SemanticBinding {
                            parameter.name, typ, parameter.line, parameter.column
                        }
                        result.bindings.push(binding)
                        result.scoped_bindings.push(ScopedSemanticBinding {
                                binding,
                                (block.start_line, block.start_column, block.end_line, block.end_column),
                                block.start_line, block.start_column
                            }
                            ,)
                    }
                }
                None => {
                }
            }
            for site in reflection_sites {
                let binding = SemanticBinding { site.name, site.typ, site.line, site.column }
                result.bindings.push(binding)
                result.scoped_bindings.push(ScopedSemanticBinding {
                        binding, site.scope, site.visible_line, site.visible_column
                    }
                    ,
                )
            }
            ret result
        }
    }
    let item = if function_uses_reflection(item) {
        match prepare_semantic_reflection(item, fields, aggregate_names, type_names, type_scope, variants) {
            Ok(expanded) => expanded
            Err(message) => {
                let mut result = SemanticBody::empty()
                result.diagnostics.push(FrontendDiagnostic::new(1, "invalid-reflection", message,
                        item.line, item.column, item.name.char_len(),))
                ret result
            }
        }
    } else {
        item
    }
    if semantic_function_has_attr(item, "decorator") {
        ret SemanticBody {
            Vec[SemanticBinding]::new(), Vec[FrontendDiagnostic]::new(), Vec[SemanticDependency]::new(),
            item.ret_type.unwrap_or("void"), Vec[ScopedSemanticBinding]::new(), Vec[(usize, usize, str)]::new(), Vec[SemanticMethod]::new(), type_names, Vec[(usize, usize, str, str)]::new(), self_type
        }
    }
    let mut generic_names = Vec[str]::new()
    let mut generics = Vec[GenericParam]::new()
    for generic in scope_generics {
        generic_names.push(generic.name)
        generics.push(generic)
    }
    for generic in item.generics {
        generic_names.push(generic.name)
        generics.push(generic)
    }
    let bound_methods = methods_for_generic_bounds(generics, methods, type_scope, type_names, type_index)
    let scoped_methods = append_bound_methods_view(methods, bound_methods)
    let mut ctx = SemanticContext {
        callables, fields, scoped_methods, self_type, generic_names, Vec[SemanticBinding]::new(), Vec[FrontendDiagnostic]::new(),
        Vec[SemanticDependency]::new(),
        (0_usize, 0_usize, 0_usize, 0_usize), Vec[ScopedSemanticBinding]::new(), aggregate_names,
        Vec[(usize, usize, str)]::new(), type_names, type_scope, Vec[(usize, usize, str, str)]::new(), variants, item.is_async, type_index
    }
    for generic in generics {
        if generic.bounds.len() > 0_usize {
            remember_failed_lookup(ctx) break
        }
    }
    if scope_generics.len() > 0_usize {
        remember_failed_lookup(ctx)
    }
    match item.body {
        Some(body) => {
            replace_scope(ctx, block_scope(body))
        }
        None => {
        }
    }
    for param in item.params {
        match param.typ {
            Option[str]::Some(typ) => {
                let resolved = if self_type != "" {
                    local_type(ctx, replace_type_name(semantic_type_name(typ), "Self", self_type))
                } else {
                    local_type(ctx, semantic_type_name(typ))
                }
                push_binding(ctx, SemanticBinding {
                        param.name, resolved, param.line, param.column
                    }
                    , item.line, item.column,
                )
            }
            Option[str]::None => {
            }
        }
    }
    let mut return_type = item.ret_type.unwrap_or("void")
    if self_type != "" {
        return_type = replace_type_name(semantic_type_name(return_type), "Self", self_type)
    }
    return_type = local_type(ctx, return_type)
    if semantic_function_has_attr(item, "static_inferred") {
        match item.body {
            Some(body) => {
                match body.statements.get(0_usize) {
                    Some(statement) => {
                        match statement {
                            Statement::Ret(expression) => {
                                let inferred = infer_expression(ctx, expression)
                                if inferred != "" {
                                    return_type = inferred
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            None => {
            }
        }
    }
    match item.body {
        Option::Some(body) => {
            check_statements(ctx, body.statements, return_type)
            if return_type != "" && return_type != "void" && return_type != "()" && !statements_definitely_return(body.statements)
            {
                ctx.diagnostics.push(
                    FrontendDiagnostic::new(
                        1_usize,
                        "missing-return",
                        "function `" + item.name + "` can reach the end without returning `" + return_type
                        + "`",
                        item.line,
                        item.column,
                        item.name.len(),
                    )
                    .with_label(item.source_name, item.line, item.column, item.name.len(), DiagnosticLabelKind::Primary,
                        "not every control-flow path returns a value",)
                    .with_help("add a `ret` expression on every path or change the return type to `void`")
                )
            }
        }
        Option::None => {
        }
    }
    let mut public_bindings = Vec[SemanticBinding]::new()
    for binding in ctx.bindings {
        public_bindings.push(present_binding(binding, type_names))
    }
    let mut public_scoped = Vec[ScopedSemanticBinding]::new()
    for site in ctx.scoped_bindings {
        public_scoped.push(ScopedSemanticBinding {
                present_binding(site.binding, type_names),
                site.scope, site.visible_line, site.visible_column
            }
            ,)
    }
    for site in reflection_sites {
        let binding = SemanticBinding { site.name, site.typ, site.line, site.column }
        public_bindings.push(binding)
        public_scoped.push(ScopedSemanticBinding {
                binding, site.scope, site.visible_line, site.visible_column
            }
            ,
        )
    }
    let mut public_diagnostics = Vec[FrontendDiagnostic]::new()
    for diagnostic in ctx.diagnostics {
        public_diagnostics.push(present_diagnostic(diagnostic, type_names))
    }
    ret SemanticBody {
        public_bindings, public_diagnostics, ctx.dependencies, display_type_view(return_type, type_names), public_scoped,
        ctx.member_receivers, bound_methods, type_names, ctx.implicit_receivers, self_type
    }
}

fn prepare_semantic_reflection(item: FunctionItem, fields: SemanticSlice[SemanticField], aggregates: Vec[str], names: SemanticSlice[TypeNameBinding], scope: str, variants: SemanticSlice[SemanticVariant]) -> Result[FunctionItem, str] {
    let mut shapes = Vec[ReflectionShape]::new()
    for owner in aggregates {
        let mut members = Vec[(str, str)]::new()
        let mut parameters = Vec[str]::new()
        for field in fields {
            if semantic_root_type(field.owner_type) == semantic_root_type(owner) {
                members.push((field.name, field.typ))
                parameters = field.generic_names
            }
        }
        let mut kind = "Struct"
        for variant in variants {
            if variant.owner_type == owner {
                kind = "Enum"
                parameters = variant.generic_names
                members.push((variant.name, variant.payload_type))
            }
        }
        shapes.push(ReflectionShape {
                owner, owner, kind, parameters, members, Vec[(str, str, str)]::new()
            }
            ,
        )
        for name in names {
            if name.identity == owner &&(name.scope == scope || name.scope == "") {
                shapes.push(ReflectionShape {
                        name.name, owner, kind, parameters, members, Vec[(str, str, str)]::new()
                    }
                    ,
                )
            }
        }
    }
    ret expand_reflection_function(item, shapes)
}

fn present_diagnostic(diagnostic: FrontendDiagnostic, names: SemanticSlice[TypeNameBinding]) -> FrontendDiagnostic {
    let mut labels = Vec[DiagnosticLabel]::new()
    for label in diagnostic.labels {
        labels.push(DiagnosticLabel {
                label.source_name, label.line, label.column, label.length, label.kind,
                display_type_view(label.message, names)
            }
            ,)
    }
    let mut notes = Vec[str]::new()
    for note in diagnostic.notes {
        notes.push(display_type_view(note, names))
    }
    let mut helps = Vec[str]::new()
    for help in diagnostic.helps {
        helps.push(display_type_view(help, names))
    }
    let mut suggestions = Vec[DiagnosticSuggestion]::new()
    for suggestion in diagnostic.suggestions {
        suggestions.push(DiagnosticSuggestion {
                suggestion.source_name, suggestion.line, suggestion.column,
                suggestion.length, display_type_view(suggestion.replacement, names), display_type_view(suggestion.message, names),
                suggestion.applicability
            }
            ,)
    }
    ret FrontendDiagnostic {
        diagnostic.severity, diagnostic.code, display_type_view(diagnostic.message, names),
        diagnostic.line, diagnostic.column, diagnostic.length, labels, notes, helps, suggestions
    }
}

fn present_binding(binding: SemanticBinding, names: SemanticSlice[TypeNameBinding]) -> SemanticBinding {
    ret SemanticBinding {
        binding.name, display_type_view(binding.typ, names), binding.line, binding.column
    }
}

fn local_type(ctx: SemanticContext, typ: str) -> str {
    ret scope_type_indexed(typ, ctx.type_scope, ctx.type_index, ctx.generic_names)
}

fn statements_definitely_return(statements: Vec[Statement]) -> bool {
    for statement in statements {
        if statement_definitely_returns(statement) {
            ret true
        }
    }
    ret false
}

fn statement_definitely_returns(statement: Statement) -> bool {
    match statement {
        Statement::Ret(expr) => {
            let _ignored = expr ret true
        }
        Statement::Unsafe(body) => {
            ret statements_definitely_return(body.statements)
        }
        Statement::With(item) => {
            ret statements_definitely_return(item.body.statements)
        }
        Statement::DoWhile(item) => {
            ret statements_definitely_return(item.body.statements)
        }
        Statement::Loop(item) => {
            ret statements_definitely_return(item.body.statements) || !statements_break_current_loop(item.body.statements)
        }
        Statement::If(item) => {
            if item.branches.len() == 0_usize {
                ret false
            }
            for branch in item.branches {
                if !statements_definitely_return(branch.body.statements) {
                    ret false
                }
            }
            match item.else_body {
                Option::Some(body) => {
                    ret statements_definitely_return(body.statements)
                }
                Option::None => {
                    ret false
                }
            }
        }
        Statement::Match(item) => {
            if item.arms.len() == 0_usize {
                ret false
            }
            for arm in item.arms {
                match arm.body {
                    MatchArmBody::Block(body) => {
                        if !statements_definitely_return(body.statements) {
                            ret false
                        }
                    }
                    MatchArmBody::Expr(expr) => {
                        let _ignored = expr ret false
                    }
                }
            }
            ret true
        }
        _ => {
        }
    }
    ret false
}

fn statements_break_current_loop(statements: Vec[Statement]) -> bool {
    for statement in statements {
        match statement {
            Statement::Break(label) => {
                let _ignored = label ret true
            }
            Statement::If(item) => {
                for branch in item.branches {
                    if statements_break_current_loop(branch.body.statements) {
                        ret true
                    }
                }
                match item.else_body {
                    Option::Some(body) => {
                        if statements_break_current_loop(body.statements) {
                            ret true
                        }
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Match(item) => {
                for arm in item.arms {
                    match arm.body {
                        MatchArmBody::Block(body) => {
                            if statements_break_current_loop(body.statements) {
                                ret true
                            }
                        }
                        MatchArmBody::Expr(expr) => {
                            let _ignored = expr
                        }
                    }
                }
            }
            Statement::Unsafe(body) => {
                if statements_break_current_loop(body.statements) {
                    ret true
                }
            }
            Statement::With(item) => {
                if statements_break_current_loop(item.body.statements) {
                    ret true
                }
            }
            // A break inside a nested loop targets that nested loop unless it
            // carries an explicit outer label; labels are conservatively left
            // to the lowering checker.
            Statement::Loop(item) => {
                let _ignored = item
            }
            Statement::While(item) => {
                let _ignored = item
            }
            Statement::For(item) => {
                let _ignored = item
            }
            Statement::DoWhile(item) => {
                let _ignored = item
            }
            _ => {
            }
        }
    }
    ret false
}

/// Checks every function body in a parsed module in one AST traversal.
/// This is the cold compiler path; individual editor queries remain cached by
/// stable symbol identity in the analysis database.
pub fn check_module_bodies_view(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod]) -> Vec[FrontendDiagnostic] {
    ret check_module_bodies_with_types_view(ast, callables, fields, methods, semantic_aggregate_names(ast))
}

pub fn semantic_aggregate_names(ast: Vec[Statement]) -> Vec[str] {
    let mut names = Vec[str]::new()
    for statement in ast {
        match statement {
            Statement::Struct(item) => {
                names.push(item.name)
            }
            _ => {
            }
        }
    }
    ret names
}

pub fn check_module_bodies_with_types_view(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], aggregate_names: Vec[str]) -> Vec[FrontendDiagnostic] {
    ret check_module_bodies_with_type_scope_view(ast, callables, fields, methods, aggregate_names,
        "", SemanticSlice[TypeNameBinding]::from_vec(Vec[TypeNameBinding]::new()),)
}

/// Checks all bodies using nominal identities from their declaring namespace.
pub fn check_module_bodies_with_type_scope_view(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding]) -> Vec[FrontendDiagnostic] {
    ret check_module_bodies_with_variants_view(ast, callables, fields, methods, aggregate_names,
        type_scope, type_names, SemanticSlice[SemanticVariant]::from_vec(Vec[SemanticVariant]::new()),)
}

pub fn check_module_bodies_with_variants_view(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant]) -> Vec[FrontendDiagnostic] {
    ret check_module_bodies_impl(ast, callables, fields, methods, aggregate_names, type_scope, type_names, variants, false, Json::Null, "").diagnostics
}

/// Validates the same bodies and trait implementations, retaining resolved
/// facts only for callers that will immediately infer package safety effects.
pub fn prepare_module_bodies_with_variants_view(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant]) -> CheckedModuleBodies {
    ret check_module_bodies_impl(ast, callables, fields, methods, aggregate_names, type_scope, type_names, variants, true, Json::Null, "")
}

pub fn prepare_module_bodies_with_replay_view(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant], previous: Json, source: str) -> CheckedModuleBodies {
    ret check_module_bodies_impl(ast, callables, fields, methods, aggregate_names, type_scope, type_names, variants, true, previous, source)
}

fn semantic_body_plan(item: FunctionItem, names: SemanticSlice[TypeNameBinding], key: str, previous: Json) -> SemanticBodyPlan {
    if !key.is_empty() {
        match previous.get(key) {
            Some(saved) => {
                match decode_semantic_checkpoint_view(saved, names, item.line, item.column) {
                    Ok(body) => {
                        let original = saved.as_array().unwrap_or(Vec[Json]::new())
                        let unchanged = checkpoint_position(original.get(1_usize).unwrap_or(Json::Null)).unwrap_or(item.line + 1_usize) == item.line &&
                            checkpoint_position(original.get(2_usize).unwrap_or(Json::Null)).unwrap_or(item.column + 1_usize) == item.column
                        let record = if unchanged { saved } else { encode_semantic_checkpoint(body, item.line, item.column) }
                        ret SemanticBodyPlan::ReplayFacts(ReplayedSemanticBody { body, record })
                    }
                    Err(_) => {}
                }
            }
            None => {}
        }
    }
    ret SemanticBodyPlan::CheckSource
}

fn check_function_body_replayed(item: FunctionItem, callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], self_type: str, scope_generics: Vec[GenericParam], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant], replay: mut SemanticReplay) -> SemanticBody {
    let mut source = ""
    if replay.enabled {
        match item.body {
            Some(body) => {
                let first_line = item.line
                let last_line = body.end_line + 1_usize
                for line in first_line..last_line {
                    source += replay.lines.get(line).unwrap_or("") + "\n"
                }
            }
            None => {
            }
        }
    }
    let eligible = replay.enabled && !source.is_empty() && !function_uses_reflection(item) && !semantic_function_has_attr(item, "decorator")
    let key = if eligible {
        compiler_content_digest("encore-semantic-function-1\n" + type_scope + "\n" + self_type + "\n" + source + "\n" +
            stringify(encode_lowered_function_input(item, type_scope)))
    } else {
        ""
    }
    match semantic_body_plan(item, type_names, key, replay.previous) {
        SemanticBodyPlan::ReplayFacts(facts) => {
            replay.records.push(Json::Array(vec![Json::String(key), facts.record]))
            replay.reused += 1_usize
            ret facts.body
        }
        SemanticBodyPlan::CheckSource => {}
    }
    if !replay.type_index_ready {
        replay.type_index = type_scope_index_view(type_names)
        replay.type_index_ready = true
    }
    let self_type = scope_type_indexed(self_type, type_scope, replay.type_index, generic_param_names(scope_generics))
    replay.checked += 1_usize
    let body = check_function_body_indexed(item, callables, fields, methods, self_type, scope_generics,
        aggregate_names, type_scope, type_names, variants, replay.type_index,)
    if eligible && body.diagnostics.is_empty() {
        replay.records.push(Json::Array(vec![Json::String(key), encode_semantic_checkpoint(body, item.line, item.column)]))
    }
    ret body
}

fn check_module_bodies_impl(ast: Vec[Statement], callables: SemanticSlice[SemanticCallable], fields: SemanticSlice[SemanticField], methods: SemanticSlice[SemanticMethod], aggregate_names: Vec[str], type_scope: str, type_names: SemanticSlice[TypeNameBinding], variants: SemanticSlice[SemanticVariant], retain_bodies: bool, previous: Json, source: str) -> CheckedModuleBodies {
    let mut replay = SemanticReplay {
        previous, semantic_source_lines(source), Vec[Json]::new(), 0_usize, 0_usize, !source.is_empty(),
        TypeScopeIndex { type_names, Vec[usize]::new() }, false
    }
    let mut out = Vec[FrontendDiagnostic]::new()
    let mut functions = Vec[CheckedFunctionBody]::new()
    let mut traits = Vec[TraitStmt]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                let checked = check_function_body_replayed(item, callables, fields, methods, "",
                    Vec[GenericParam]::new(), aggregate_names, type_scope, type_names, variants, replay,)
                out.extend(checked.diagnostics)
                if retain_bodies {
                    functions.push(CheckedFunctionBody { item, "", checked })
                }
            }
            Statement::Trait(item) => {
                let scope_generics = item.generics
                for method in item.methods {
                    let checked = check_function_body_replayed(method, callables, fields, methods,
                        item.name,
                        scope_generics, aggregate_names, type_scope, type_names, variants, replay,)
                    out.extend(checked.diagnostics)
                    if retain_bodies {
                        functions.push(CheckedFunctionBody {
                                method, item.name, checked
                            }
                        )
                    }
                }
                traits.push(item)
            }
            Statement::Impl(item) => {
                let scope_generics = item.generics
                for method in item.methods {
                    let checked = check_function_body_replayed(method, callables, fields, methods,
                        item.target,
                        scope_generics, aggregate_names, type_scope, type_names, variants, replay,)
                    out.extend(checked.diagnostics)
                    if retain_bodies {
                        functions.push(CheckedFunctionBody {
                                method, item.target, checked
                            }
                        )
                    }
                }
            }
            _ => {
            }
        }
    }
    for statement in ast {
        match statement {
            Statement::Impl(item) => {
                check_local_trait_impl(item, traits, out)
            }
            _ => {
            }
        }
    }
    let mut records = Vec[(str, Json)]::new()
    for value in replay.records {
        let row = value.as_array().unwrap_or(Vec[Json]::new())
        records.push((row.get(0).unwrap_or(Json::Null).as_str().unwrap_or(""), row.get(1).unwrap_or(Json::Null)))
    }
    ret CheckedModuleBodies { out, functions, Json::Object(records), replay.checked, replay.reused }
}

pub fn append_bound_methods_view(methods: SemanticSlice[SemanticMethod], bound_methods: Vec[SemanticMethod]) -> SemanticSlice[SemanticMethod] {
    ret methods.with_overlay(bound_methods)
}
fn methods_for_generic_bounds(generics: Vec[GenericParam], methods: SemanticSlice[SemanticMethod], type_scope: str, type_names: SemanticSlice[TypeNameBinding], type_index: TypeScopeIndex) -> Vec[SemanticMethod] {
    let mut out = Vec[SemanticMethod]::new()
    for generic in generics {
        for bound in generic.bounds {
            let mut receiver = "dyn " + bound.path
            if bound.args.len() > 0_usize {
                receiver += "["
                let mut index = 0_usize
                for arg in bound.args {
                    if index > 0_usize {
                        receiver += ", "
                    }
                    receiver += arg
                    index += 1_usize
                }
                receiver += "]"
            }
            receiver = scope_type_indexed(receiver, type_scope, type_index, generic_param_names(generics))
            for method in methods {
                if method.is_static {
                    continue
                }
                if semantic_root_type(semantic_type_name(method.receiver_type)) != semantic_root_type(semantic_type_name(receiver)) {
                    continue
                }
                let mut params = Vec[str]::new()
                for param in method.params {
                    params.push(specialize_method_type_with_self(param, method.receiver_type, receiver, generic.name, method.generic_names))
                }
                let result = specialize_method_type_with_self(method.ret_type, method.receiver_type, receiver, generic.name, method.generic_names)
                out.push(SemanticMethod {
                        method.module_name, generic.name, method.name, params,
                        result, method.signature, method.declaration_receiver, Vec[str]::new(), method.is_static, method.is_public, method.method_generic_names
                    }
                    ,)
            }
        }
    }
    ret out
}

fn generic_param_names(params: Vec[GenericParam]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for param in params {
        out.push(param.name)
    }
    ret out
}

fn check_local_trait_impl(item: ImplStmt, traits: Vec[TraitStmt], out: mut Vec[FrontendDiagnostic]) ->()
{
    let trait_name = match item.trait_name {
        Option[str]::Some(value) => value
        Option[str]::None => {
            ret()
        }
    }
    for trait_item in traits {
        if trait_item.name != trait_name {
            continue
        }
        for required in trait_item.methods {
            if required.body.is_some() {
                continue
            }
            let mut found = false
            for method in item.methods {
                if method.name == required.name {
                    found = true
                    if !method_signatures_compatible(required, method, trait_item, item) {
                        let mismatch = method_signature_mismatch(required, method, trait_item, item)
                        out.push(
                            FrontendDiagnostic::new(1_usize, "trait-method-signature-mismatch", mismatch,
                                method.line, method.column, method.name.len(),)
                            .with_label(method.source_name, method.line, method.column, method.name.len(),
                                DiagnosticLabelKind::Primary, "incompatible implementation",)
                            .with_label(required.source_name, required.line, required.column, required.name.len(),
                                DiagnosticLabelKind::Secondary, "trait method declared here",)
                            .with_help("match the trait method parameter and return types exactly")
                        )
                    }
                }
            }
            if !found {
                out.push(
                    FrontendDiagnostic::new(1_usize, "missing-trait-method", "implementation of trait '"
                        + trait_name + "' for '" + item.target + "' is missing method '" + required.name
                        + "'", item.line, item.column, trait_name.len(),)
                    .with_label(item.source_name, item.line, item.column, trait_name.len(), DiagnosticLabelKind::Primary,
                        "missing required method",)
                    .with_label(required.source_name, required.line, required.column, required.name.len(),
                        DiagnosticLabelKind::Secondary, "required by this trait",)
                    .with_help("implement `fn " + required.name + "(...)` in this impl block")
                )
            }
        }
        ret()
    }
    ret()
}

fn method_signature_mismatch(required: FunctionItem, actual: FunctionItem, trait_item: TraitStmt, implementation:
    ImplStmt,) -> str {
    if required.params.len() != actual.params.len() {
        ret "method '" + actual.name + "' has " + Debug::fmt(actual.params.len()) + " parameter(s), expected "
        + Debug::fmt(required.params.len())
    }
    let mut index = 0_usize
    while index < required.params.len() {
        let expected = substitute_trait_type(function_param_type(required.params, index), trait_item,
            implementation,)
        let found = replace_type_name(function_param_type(actual.params, index), "Self", implementation.target)
        if !semantic_types_compatible(expected, found) {
            ret "parameter " + Debug::fmt(index + 1_usize) + " of method '" + actual.name + "' has type '"
            + found + "', expected '" + expected + "'"
        }
        index += 1_usize
    }
    let expected_return = substitute_trait_type(required.ret_type.unwrap_or("void"), trait_item, implementation)
    let found_return = replace_type_name(actual.ret_type.unwrap_or("void"), "Self", implementation.target)
    ret "method '" + actual.name + "' returns '" + found_return + "', expected '" + expected_return +
    "'"
}

fn method_signatures_compatible(required: FunctionItem, actual: FunctionItem, trait_item: TraitStmt,
    implementation: ImplStmt,) -> bool {
    if required.params.len() != actual.params.len() {
        ret false
    }
    let mut index = 0_usize
    while index < required.params.len() {
        let expected = substitute_trait_type(function_param_type(required.params, index), trait_item,
            implementation,)
        let found = replace_type_name(function_param_type(actual.params, index), "Self", implementation.target)
        if !semantic_types_compatible(expected, found) {
            ret false
        }
        index += 1_usize
    }
    let expected_return = substitute_trait_type(required.ret_type.unwrap_or("void"), trait_item, implementation)
    ret semantic_types_compatible(expected_return, replace_type_name(actual.ret_type.unwrap_or("void"),
            "Self", implementation.target,))
}

fn function_param_type(params: Vec[FunctionParam], index: usize) -> str {
    match params.get(index) {
        Option::Some(param) => {
            ret param.typ.unwrap_or("")
        }
        Option::None => {
            ret ""
        }
    }
}

fn substitute_trait_type(typ: str, trait_item: TraitStmt, implementation: ImplStmt) -> str {
    let mut out = replace_type_name(typ, "Self", implementation.target)
    let mut index = 0_usize
    while index < trait_item.generics.len() && index < implementation.trait_args.len() {
        match trait_item.generics.get(index) {
            Option::Some(generic) => {
                match implementation.trait_args.get(index) {
                    Option::Some(argument) => {
                        out = replace_type_name(out, generic.name, argument)
                    }
                    Option::None => {
                    }
                }
            }
            Option::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn replace_type_name(typ: str, name: str, replacement: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < typ.len() {
        let byte = typ.byte_at(index)
        if identifier_byte(byte) {
            let start = index
            while index < typ.len() && identifier_byte(typ.byte_at(index)) {
                index += 1_usize
            }
            let token = typ.slice(start, index - start)
            out += if token == name {
                replacement
            } else {
                token
            }
        } else {
            out += typ.slice(index, 1_usize)
            index += 1_usize
        }
    }
    ret out
}

fn identifier_byte(byte: u8) -> bool {
    ret(byte >= 65_u8 && byte <= 90_u8) ||(byte >= 97_u8 && byte <= 122_u8) ||(byte >= 48_u8 && byte
        <= 57_u8) || byte == 95_u8
}

/// Checks declaration invariants that depend on target and feature selection.
pub fn check_module_declarations(ast: Vec[Statement], target: TargetSpec, features: Vec[str]) -> Vec[FrontendDiagnostic]
{
    let mut out = Vec[FrontendDiagnostic]::new()
    let mut names = Vec[str]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                if semantic_function_is_active(item, target, features) {
                    if contains_name(names, item.name) {
                        out.push(FrontendDiagnostic::new(1_usize, "duplicate-function", "duplicate function declaration '"
                                + item.name + "'", item.line, item.column, item.name.len(),))
                    } else {
                        names.push(item.name)
                    }
                }
            }
            _ => {
            }
        }
    }
    ret out
}

fn semantic_function_is_active(item: FunctionItem, target: TargetSpec, features: Vec[str]) -> bool {
    for attr in item.attrs {
        if contains_substring(attr, "test") {
            ret false
        }
        if starts_with(attr, "cfg:") {
            let expr = attr.slice(4_usize, attr.len() - 4_usize)
            if !cfg_active_with_features(target, expr, features) {
                ret false
            }
        }
    }
    ret true
}

fn semantic_function_has_attr(item: FunctionItem, expected: str) -> bool {
    for attr in item.attrs {
        if attr == expected {
            ret true
        }
    }
    ret false
}

fn contains_name(names: Vec[str], name: str) -> bool {
    for existing in names {
        if existing == name {
            ret true
        }
    }
    ret false
}

fn semantic_type_name(typ: str) -> str {
    if starts_with(typ, "mut ") {
        ret typ.slice(4_usize, typ.len() - 4_usize)
    }
    ret typ
}

fn semantic_types_compatible(expected: str, actual: str) -> bool {
    let normalized_expected = compact_type(semantic_type_name(expected))
    let normalized_actual = compact_type(semantic_type_name(actual))
    // An empty type is an inference hole, not `void`. Diagnostics must only
    // be emitted after both sides have been resolved with confidence.
    if normalized_expected == "" || normalized_actual == "" {
        ret true
    }
    if type_contains_inference_hole(normalized_expected) || type_contains_inference_hole(normalized_actual)
    {
        ret true
    }
    // `ret`, `break` and other diverging expressions coerce to every type.
    if normalized_expected == "never" || normalized_actual == "never" {
        ret true
    }
    if normalized_expected == normalized_actual {
        ret true
    }
    if (normalized_expected == "()" || normalized_expected == "void") &&
    (normalized_actual == "()" || normalized_actual == "void") {
        ret true
    }

    if (normalized_expected == "bool" && normalized_actual == "u1") ||
    (normalized_expected == "u1" && normalized_actual == "bool") {
        ret true
    }
    if numeric_semantic_type(normalized_expected) && numeric_semantic_type(normalized_actual) {
        ret true
    }
    // Numeric values and raw addresses never share a source type. In
    // particular `as f32 *` is a pointer cast, not a scalar cast.
    let expected_pointer = ends_with(normalized_expected, "*")
    let actual_pointer = ends_with(normalized_actual, "*")
    if expected_pointer != actual_pointer && !generic_placeholder(normalized_expected) &&
    !generic_placeholder(normalized_actual) {
        ret false
    }
    if semantic_root_type(normalized_expected) == semantic_root_type(normalized_actual) {
        ret true
    }
    if generic_placeholder(normalized_expected) || generic_placeholder(normalized_actual) {
        ret true
    }
    if generic_container_compatible(normalized_expected, normalized_actual) {
        ret true
    }
    ret false
}

fn semantic_root_type(typ: str) -> str {
    let mut value = typ
    while value.byte_len() > 0_usize &&(value.byte_at(value.byte_len() - 1) == 38 || value.byte_at(value.byte_len() - 1) == 42) {
        value = value.slice_bytes(0, value.byte_len() - 1)
    }
    let mut index = 0_usize
    while index < value.byte_len() {
        let byte = value.byte_at(index)
        if byte == 91 || byte == 60 {
            ret value.slice_bytes(0, index)
        }
        index += 1_usize
    }
    ret value
}

fn type_contains_inference_hole(typ: str) -> bool {
    ret contains_substring(typ, "(,")
    || contains_substring(typ, ",)")
    || contains_substring(typ, ",,")
    || contains_substring(typ, "[,")
    || contains_substring(typ, ",]")
}

fn compact_type(value: str) -> str {
    // Canonical types are already compact. Do not allocate a one-character
    // string and rebuild the whole type for every candidate member lookup.
    let mut out = ""
    let mut start = 0_usize
    let mut index = 0_usize
    while index < value.byte_len() {
        let byte = value.byte_at(index)
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            if index > start {
                out += value.slice_bytes(start, index - start)
            }
            start = index + 1
        }
        index += 1_usize
    }
    if start == 0 {
        ret value
    }
    if index > start {
        out += value.slice_bytes(start, index - start)
    }
    ret out
}

#attr(test)
fn semantic_compact_type_preserves_unicode_contract() -> bool {
    ret compact_type("Модуль::Тип[u32]") == "Модуль::Тип[u32]"
    && compact_type(" \tМодуль::Тип [ u32,\r\n Vec[ str ] ] ") == "Модуль::Тип[u32,Vec[str]]"
    && compact_type(" \t\r\n") == ""
    && semantic_root_type("Модуль::Тип[u32]&") == "Модуль::Тип"
    && semantic_root_type("Модуль::Тип*") == "Модуль::Тип"
}

#attr(test)
fn semantic_receiver_substitution_identity_contract() -> bool {
    let mut generics = Vec[str]::new()
    generics.push("T")
    ret semantic_receiver_matches("owner::Box[T]", "owner::Box[Vec[u32]]", generics)
    && !semantic_receiver_matches("owner::Box[T]", "other::Box[u32]", generics)
    && !semantic_receiver_matches("owner::Pair[T,T]", "owner::Pair[u32,str]", generics)
    && semantic_receiver_matches("owner::Pair[ T, T ]", "owner::Pair[u32,u32]", generics)
}

fn generic_container_compatible(expected: str, actual: str) -> bool {
    let expected_base = type_base(expected)
    let actual_base = type_base(actual)
    // An enum constructor may omit generic arguments (`Option::None`); those
    // arguments are inferred from the expected type at the use site.
    if expected_base != "" && actual == expected_base {
        ret true
    }
    if actual_base != "" && expected == actual_base {
        ret true
    }
    if expected_base == "" || expected_base != actual_base {
        ret false
    }
    ret contains_generic_argument(expected) || contains_generic_argument(actual)
}

fn contains_generic_argument(typ: str) -> bool {
    let mut index = 0_usize
    while index < typ.len() {
        let byte = typ.byte_at(index)
        if byte >= 65_u8 && byte <= 90_u8 {
            let previous_ok = index > 0_usize &&(typ.byte_at(index - 1_usize) == 91_u8 || typ.byte_at(index
                    - 1_usize) == 44_u8 || typ.byte_at(index - 1_usize) == 32_u8)
            let next_ok = index + 1_usize >= typ.len() || typ.byte_at(index + 1_usize) == 44_u8 || typ.byte_at(index
                + 1_usize) == 93_u8 || typ.byte_at(index + 1_usize) == 32_u8
            if previous_ok && next_ok {
                ret true
            }
        }
        index += 1_usize
    }
    ret false
}

fn type_base(typ: str) -> str {
    let mut index = 0_usize
    while index < typ.len() {
        if typ.slice(index, 1_usize) == "[" {
            ret typ.slice(0_usize, index)
        }
        index += 1_usize
    }
    ret ""
}

fn type_base_or_self(typ: str) -> str {
    let base = type_base(typ)
    if base == "" {
        ret typ
    }
    ret base
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() {
        ret false
    }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn contains_substring(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut start = 0_usize
    while start + needle.len() <= value.len() {
        if value.slice(start, needle.len()) == needle {
            ret true
        }
        start += 1_usize
    }
    ret false
}

fn check_statements(
    ctx: mut SemanticContext,
    statements: Vec[Statement],
    return_type: str,
) ->() {
    for statement in statements {
        match statement {
            Statement::Let(item) => {
                let flexible_numeric = expression_is_flexible_numeric(item.expr)
                let inferred = infer_expression(ctx, item.expr)
                let mut declared = local_type(ctx, item.typ.unwrap_or(inferred))
                if semantic_type_name(declared) == "Self" && ctx.self_type != "" {
                    declared = ctx.self_type
                }
                if inferred != "" && !semantic_types_compatible(declared, inferred) && !flexible_numeric
                {
                    ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "type-mismatch", "cannot initialize '"
                            + item.name + "' of type '" + declared + "' with value of type '" + inferred
                            + "'",
                            item.expr.line, item.expr.column, item.expr.length,))
                }
                push_binding(ctx, SemanticBinding {
                        item.name, declared, item.line, item.column
                    }
                    , item.visible_line, item.visible_column,
                )
            }
            Statement::Ret(expr) => {
                let flexible_numeric = expression_is_flexible_numeric(expr)
                let actual = infer_expression(ctx, expr)
                if return_type != "" && return_type != "void" && actual != "" && !semantic_types_compatible(return_type,
                    actual,) && !flexible_numeric {
                    ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "return-type-mismatch", "cannot return value of type '"
                            + actual + "' from function returning '" + return_type + "'", expr.line,
                            expr.column,
                            expr.length,))
                }
            }
            Statement::Expr(expr) => {
                let _ignored = infer_expression(ctx, expr)
            }
            Statement::Assignment(item) => {
                let target_name = expression_path(item.target)
                let target = infer_expression(ctx, item.target)
                let actual = infer_expression(ctx, item.expr)
                if target != "" && actual != "" && !semantic_types_compatible(target, actual) && !expression_is_flexible_numeric(item.expr)
                {
                    let mut diagnostic = FrontendDiagnostic::new(
                        1_usize,
                        "assignment-type-mismatch",
                        "cannot assign value of type '" + actual + "' to variable '" + target_name +
                        "' of type '" + target + "'",
                        item.expr.line,
                        item.expr.column,
                        item.expr.length,
                    )
                    diagnostic = diagnostic.with_label(
                        item.expr.source_name,
                        item.expr.line,
                        item.expr.column,
                        item.expr.length,
                        DiagnosticLabelKind::Primary,
                        "expected `" + target + "`, found `" + actual + "`",
                    )
                    match find_binding(ctx.bindings, target_name) {
                        Option[SemanticBinding]::Some(binding) => {
                            diagnostic = diagnostic.with_label(
                                item.target.source_name,
                                binding.line,
                                binding.column,
                                if binding.name.len() == 0_usize {
                                    1_usize
                                } else {
                                    binding.name.len()
                                }
                                ,
                                DiagnosticLabelKind::Secondary,
                                "expected because of this binding",
                            )
                        }
                        Option[SemanticBinding]::None => {
                        }
                    }
                    diagnostic = diagnostic.with_note("assignments preserve the declared type of their target")
                    diagnostic = diagnostic.with_help("convert the value to `" + target + "` before assigning it")
                    diagnostic = diagnostic.with_suggestion(
                        item.expr.source_name,
                        item.expr.line,
                        item.expr.column,
                        item.expr.length,
                        "<" + target + " value>",
                        "replace this expression with a value of the expected type",
                        SuggestionApplicability::HasPlaceholders,
                    )
                    ctx.diagnostics.push(diagnostic)
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    check_boolean_condition(ctx, branch.condition)
                    check_scoped_statements(ctx, branch.body, return_type)
                }
                match item.else_body {
                    Option::Some(body) => {
                        check_scoped_statements(ctx, body, return_type)
                    }
                    Option::None => {
                    }
                }
            }
            Statement::Match(item) => {
                let matched = infer_expression(ctx, item.expr)
                let outer_bindings = ctx.bindings.len()
                let outer_scope = ctx.scope
                for arm in item.arms {
                    replace_bindings(ctx, outer_bindings)
                    match arm.body {
                        MatchArmBody::Block(body) => {
                            replace_scope(ctx, block_scope(body))
                        }
                        MatchArmBody::Expr(expr) => {
                            replace_scope(ctx,(expr.line, expr.column, expr.line, expr.column + expr.length))
                        }
                    }
                    match arm.pattern.binding {
                        Option[str]::Some(name) => {
                            push_binding(ctx, SemanticBinding {
                                    name, match_pattern_binding_type(ctx, matched, arm.pattern), item.expr.line,
                                    item.expr.column
                                }
                                , ctx.scope.0, ctx.scope.1,
                            )
                        }
                        Option[str]::None => {
                        }
                    }
                    match arm.body {
                        MatchArmBody::Block(body) => {
                            check_statements(ctx, body.statements, return_type)
                        }
                        MatchArmBody::Expr(expr) => {
                            let _arm = infer_expression(ctx, expr)
                        }
                    }
                }
                replace_bindings(ctx, outer_bindings)
                replace_scope(ctx, outer_scope)
            }
            Statement::While(item) => {
                check_boolean_condition(ctx, item.condition)
                check_scoped_statements(ctx, item.body, return_type)
            }
            Statement::Loop(item) => {
                check_scoped_statements(ctx, item.body, return_type)
            }
            Statement::DoWhile(item) => {
                check_scoped_statements(ctx, item.body, return_type)
                check_boolean_condition(ctx, item.condition)
            }
            Statement::For(item) => {
                let iterable = infer_expression(ctx, item.iterable)
                ctx.implicit_receivers.push((item.iterable.line, item.iterable.column, "for", iterable))
                check_implicit_method_access(ctx, iterable, "into_iter", item.iterable.line, item.iterable.column, item.iterable.length)
                let converted = iterable_method_return(ctx, iterable, "into_iter")
                check_implicit_method_access(ctx, if converted == "" {
                        iterable
                    } else {
                        converted
                    }
                    ,
                    "next", item.iterable.line, item.iterable.column, item.iterable.length,)
                let outer_bindings = ctx.bindings.len()
                let outer_scope = ctx.scope
                replace_scope(ctx, block_scope(item.body))
                push_binding(ctx, SemanticBinding {
                        item.name, iterable_item_type(ctx, iterable), item.iterable.line, item.iterable.column
                    }
                    , item.body.start_line, item.body.start_column,
                )
                check_statements(ctx, item.body.statements, return_type)
                replace_bindings(ctx, outer_bindings)
                replace_scope(ctx, outer_scope)
            }
            Statement::With(item) => {
                let resource = infer_expression(ctx, item.expr)
                ctx.implicit_receivers.push((item.expr.line, item.expr.column, "with", resource))
                check_implicit_method_access(ctx, resource, "with_enter", item.expr.line, item.expr.column, item.expr.length)
                check_implicit_method_access(ctx, resource, "with_exit", item.expr.line, item.expr.column, item.expr.length)
                let outer_bindings = ctx.bindings.len()
                let outer_scope = ctx.scope
                replace_scope(ctx, block_scope(item.body))
                push_binding(ctx, SemanticBinding {
                        item.name, resource, item.expr.line, item.expr.column
                    }
                    , item.body.start_line, item.body.start_column,
                )
                check_statements(ctx, item.body.statements, return_type)
                replace_bindings(ctx, outer_bindings)
                replace_scope(ctx, outer_scope)
            }
            Statement::Unsafe(body) => {
                check_scoped_statements(ctx, body, return_type)
            }
            Statement::Ehir(item) => {
                register_ehir_bindings(ctx, item.body)
            }
            _ => {
            }
        }
    }
    ret()
}

fn push_binding(ctx: mut SemanticContext, binding: SemanticBinding, line: usize, column: usize) ->() {
    ctx.bindings.push(binding)
    ctx.scoped_bindings.push(ScopedSemanticBinding {
            binding, ctx.scope, line, column
        }
        ,
    )
    ret()
}

fn block_scope(body: ParsedBlock) ->(usize, usize, usize, usize) {
    ret(body.start_line, body.start_column, body.end_line, body.end_column)
}

fn replace_scope(ctx: mut SemanticContext, scope:(usize, usize, usize, usize)) ->() {
    ctx.scope = scope
    ret()
}

fn check_scoped_statements(ctx: mut SemanticContext, body: ParsedBlock, return_type: str) ->() {
    let outer = ctx.bindings.len()
    let outer_scope = ctx.scope
    replace_scope(ctx, block_scope(body))
    check_statements(ctx, body.statements, return_type)
    replace_bindings(ctx, outer)
    replace_scope(ctx, outer_scope)
    ret()
}

fn infer_block(ctx: mut SemanticContext, block: BlockExpr) -> str {
    let outer = ctx.bindings.len()
    let outer_scope = ctx.scope
    replace_scope(ctx,(block.start_line, block.start_column, block.end_line, block.end_column))
    check_statements(ctx, block.statements, "")
    let tail_type = match block.tail {
        Some(tail) => infer_expression_h(ctx, tail)
        None => "void"
    }
    let result = if statements_terminate_flow(block.statements) {
        "never"
    } else {
        tail_type
    }
    replace_bindings(ctx, outer)
    replace_scope(ctx, outer_scope)
    ret result
}

fn infer_unsafe_block(ctx: mut SemanticContext, body: ParsedBlock) -> str {
    let outer = ctx.bindings.len()
    let outer_scope = ctx.scope
    replace_scope(ctx, block_scope(body))
    check_statements(ctx, body.statements, "")
    let result = unsafe_block_type(ctx, body.statements)
    replace_bindings(ctx, outer)
    replace_scope(ctx, outer_scope)
    ret result
}

fn register_ehir_bindings(ctx: mut SemanticContext, body: str) ->() {
    let mut line_start = 0_usize
    let mut index = 0_usize
    while index <= body.len() {
        let at_end = index == body.len()
        if at_end || body.slice(index, 1_usize) == "\n" {
            let line = body.slice(line_start, index - line_start)
            let mut colon = line.len()
            let mut equals = line.len()
            let mut cursor = 0_usize
            while cursor < line.len() {
                let ch = line.slice(cursor, 1_usize)
                if ch == ":" && colon == line.len() {
                    colon = cursor
                }
                if ch == "=" {
                    equals = cursor break
                }
                cursor += 1_usize
            }
            if colon < equals {
                let name = trim_type_text(line.slice(0_usize, colon))
                let typ = trim_type_text(line.slice(colon + 1_usize, equals - colon - 1_usize))
                if name != "" {
                    ctx.bindings.push(SemanticBinding {
                            name, typ, 0_usize, 0_usize
                        }
                        ,
                    )
                }
            }
            line_start = index + 1_usize
        }
        index += 1_usize
    }
    ret()
}

/// Restores the lexical stack to its entry depth. Copying a Vec handle would
/// share the same storage, not snapshot it; lengths are immutable checkpoints.
fn replace_bindings(ctx: mut SemanticContext, length: usize) ->() {
    while ctx.bindings.len() > length {
        let _removed = ctx.bindings.pop()
    }
    ret()
}

fn check_boolean_condition(ctx: mut SemanticContext, expr: ExprNode) ->() {
    let actual = infer_expression(ctx, expr)
    if actual != "" && actual != "bool" && actual != "never" {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "condition-type-mismatch", "condition must have type 'bool', found '"
                + actual + "'", expr.line, expr.column, expr.length,))
    }
    ret()
}

fn infer_expression(
    ctx: mut SemanticContext,
    expr: ExprNode,
) -> str {
    let line = expr.line
    let column = expr.column
    let length = expr.length
    let source_name = expr.source_name
    match expr.value {
        Expr::StringLiteral(value) => {
            let _ignored = value ret "str"
        }
        Expr::Boolean(value) => {
            let _ignored = value ret "bool"
        }
        Expr::Integer(value) => {
            ret integer_type(value)
        }
        Expr::Float(value) => {
            ret float_type(value)
        }
        Expr::Path(name) => {
            ret infer_value_path(ctx, name, source_name, line, column, length)
        }
        Expr::Parenthesized(inner) => {
            ret infer_expression_h(ctx, inner)
        }
        Expr::Cast(cast) => {
            let mut target = local_type(ctx, cast.target)
            if semantic_type_name(target) == "Self" && ctx.self_type != "" {
                target = ctx.self_type
            }
            let _ignored = infer_expression_h(ctx, cast.expr)
            ret target
        }
        Expr::Binary(binary) => {
            let operator = binary.operator
            let lhs = infer_expression_h(ctx, binary.lhs)
            let rhs = infer_expression_h(ctx, binary.rhs)
            if operator == "+" && !numeric_semantic_type(lhs) && lhs != "str" {
                ctx.implicit_receivers.push((line, column, "binary", lhs))
            }
            check_binary_operands(ctx, operator, lhs, rhs, source_name, line, column, length)
            ret binary_expression_type(operator, lhs, rhs, binary.rhs.value)
        }
        Expr::Unary(unary) => {
            let inner = infer_expression_h(ctx, unary.expr)
            ret unary_result_type(unary.operator, inner, unary.expr)
        }
        Expr::TupleLiteral(tuple) => {
            ret tuple_type(ctx, tuple.items)
        }
        Expr::ArrayLiteral(array) => {
            ret array_type(ctx, array.items, false)
        }
        Expr::VecLiteral(array) => {
            ret array_type(ctx, array.items, true)
        }
        Expr::ArrayRepeat(array) => {
            let item = infer_expression_h(ctx, array.value)
            ret "[" + item + "; " + semantic_numeric_literal_value(array.size) + "]"
        }
        Expr::Block(block) => {
            ret infer_block(ctx, block)
        }
        Expr::If(item) => {
            ret infer_if_expression(ctx, item.branches, item.else_body, line, column, length)
        }
        Expr::Match(item) => {
            let matched = infer_expression_h(ctx, item.expr)
            let mut resolved = ""
            let outer_bindings = ctx.bindings.len()
            for arm in item.arms {
                replace_bindings(ctx, outer_bindings)
                match arm.pattern.binding {
                    Option[str]::Some(name) => {
                        ctx.bindings.push(SemanticBinding {
                                name, match_pattern_binding_type(ctx, matched, arm.pattern), arm.expr.line,
                                arm.expr.column
                            }
                            ,
                        )
                    }
                    Option[str]::None => {
                    }
                }
                let arm_type = infer_expression(ctx, arm.expr)
                resolved = merge_expression_types(ctx, resolved, arm_type, arm.expr)
            }
            replace_bindings(ctx, outer_bindings)
            ret resolved
        }
        Expr::Index(item) => {
            let base = infer_expression_h(ctx, item.base)
            let _index = infer_expression_h(ctx, item.index)
            ret indexed_type(ctx, base)
        }
        Expr::Await(inner) => {
            let future = infer_expression_h(ctx, inner)
            ret checked_awaited_type(ctx, future, expr.source_name, expr.line, expr.column, expr.length)
        }
        Expr::Try(inner) => {
            ret first_type_argument(infer_expression_h(ctx, inner))
        }
        Expr::Spawn(inner) => {
            ret local_type(ctx, "JoinHandle[" + infer_expression_h(ctx, inner) + "]")
        }
        Expr::Unsafe(body) => {
            ret infer_unsafe_block(ctx, body)
        }
        Expr::Call(call) => {
            let name = expression_path_h(call.callee)
            if name != "" {
                match resolve_call(ctx, name, call.generics, call.args, line, column, length) {
                    Option[str]::Some(ret_type) => {
                        ret ret_type
                    }
                    Option[str]::None => {
                    }
                }
            }
            ret ""
        }
        Expr::StructInit(initializer) => {
            check_struct_initializer(ctx, local_type(ctx, initializer.path), initializer.values, source_name, line, column,
                length,)
            if initializer.path == "Self" && ctx.self_type != "" {
                ret ctx.self_type
            }
            ret local_type(ctx, initializer.path)
        }
        Expr::Field(field) => {
            let owner = infer_expression_h(ctx, field.base)
            ctx.member_receivers.push((line, column, owner))
            if field.field == "" {
                ret ""
            }
            ret resolve_field_expression(ctx, owner, field.field, source_name, line, column, length)
        }
        Expr::MethodCall(call) => {
            let receiver = infer_expression_h(ctx, call.receiver)
            ctx.member_receivers.push((line, column, receiver))
            ret resolve_method_call(ctx, receiver, call.method, call.generics, call.args, source_name, line, column,
                length,)
        }
        _ => {
            ret ""
        }
    }
    ret ""
}
fn infer_expression_h(ctx: mut SemanticContext, expr: ExprNode<H>) -> str {
    let line = expr.line
    let column = expr.column
    let length = expr.length
    let source_name = expr.source_name
    match expr.value {
        Expr::StringLiteral(value) => {
            let _ignored = value ret "str"
        }
        Expr::Boolean(value) => {
            let _ignored = value ret "bool"
        }
        Expr::Integer(value) => {
            ret integer_type(value)
        }
        Expr::Float(value) => {
            ret float_type(value)
        }
        Expr::Path(name) => {
            ret infer_value_path(ctx, name, source_name, line, column, length)
        }
        Expr::Parenthesized(inner) => {
            ret infer_expression_h(ctx, inner)
        }
        Expr::Cast(cast) => {
            let mut target = local_type(ctx, cast.target)
            if semantic_type_name(target) == "Self" && ctx.self_type != "" {
                target = ctx.self_type
            }
            let _ignored = infer_expression_h(ctx, cast.expr)
            ret target
        }
        Expr::Binary(binary) => {
            let operator = binary.operator
            let lhs = infer_expression_h(ctx, binary.lhs)
            let rhs = infer_expression_h(ctx, binary.rhs)
            if operator == "+" && !numeric_semantic_type(lhs) && lhs != "str" {
                ctx.implicit_receivers.push((line, column, "binary", lhs))
            }
            check_binary_operands(ctx, operator, lhs, rhs, source_name, line, column, length)
            ret binary_expression_type(operator, lhs, rhs, binary.rhs.value)
        }
        Expr::Unary(unary) => {
            let inner = infer_expression_h(ctx, unary.expr)
            ret unary_result_type(unary.operator, inner, unary.expr)
        }
        Expr::TupleLiteral(tuple) => {
            ret tuple_type(ctx, tuple.items)
        }
        Expr::ArrayLiteral(array) => {
            ret array_type(ctx, array.items, false)
        }
        Expr::VecLiteral(array) => {
            ret array_type(ctx, array.items, true)
        }
        Expr::ArrayRepeat(array) => {
            let item = infer_expression_h(ctx, array.value)
            ret "[" + item + "; " + semantic_numeric_literal_value(array.size) + "]"
        }
        Expr::Block(block) => {
            ret infer_block(ctx, block)
        }
        Expr::If(item) => {
            ret infer_if_expression(ctx, item.branches, item.else_body, line, column, length)
        }
        Expr::Match(item) => {
            let matched = infer_expression_h(ctx, item.expr)
            let mut resolved = ""
            let outer_bindings = ctx.bindings.len()
            for arm in item.arms {
                replace_bindings(ctx, outer_bindings)
                match arm.pattern.binding {
                    Option[str]::Some(name) => {
                        ctx.bindings.push(SemanticBinding {
                                name, match_pattern_binding_type(ctx, matched, arm.pattern), arm.expr.line,
                                arm.expr.column
                            }
                            ,
                        )
                    }
                    Option[str]::None => {
                    }
                }
                let arm_type = infer_expression(ctx, arm.expr)
                resolved = merge_expression_types(ctx, resolved, arm_type, arm.expr)
            }
            replace_bindings(ctx, outer_bindings)
            ret resolved
        }
        Expr::Index(item) => {
            let base = infer_expression_h(ctx, item.base)
            let _index = infer_expression_h(ctx, item.index)
            ret indexed_type(ctx, base)
        }
        Expr::Await(inner) => {
            let future = infer_expression_h(ctx, inner)
            ret checked_awaited_type(ctx, future, expr.source_name, expr.line, expr.column, expr.length)
        }
        Expr::Try(inner) => {
            ret first_type_argument(infer_expression_h(ctx, inner))
        }
        Expr::Spawn(inner) => {
            ret local_type(ctx, "JoinHandle[" + infer_expression_h(ctx, inner) + "]")
        }
        Expr::Unsafe(body) => {
            ret infer_unsafe_block(ctx, body)
        }
        Expr::Call(call) => {
            let name = expression_path_h(call.callee)
            if name != "" {
                match resolve_call(ctx, name, call.generics, call.args, line, column, length) {
                    Option[str]::Some(ret_type) => {
                        ret ret_type
                    }
                    Option[str]::None => {
                    }
                }
            }
            ret ""
        }
        Expr::StructInit(initializer) => {
            check_struct_initializer(ctx, local_type(ctx, initializer.path), initializer.values, source_name, line, column,
                length,)
            if initializer.path == "Self" && ctx.self_type != "" {
                ret ctx.self_type
            }
            ret local_type(ctx, initializer.path)
        }
        Expr::Field(field) => {
            let owner = infer_expression_h(ctx, field.base)
            ctx.member_receivers.push((line, column, owner))
            if field.field == "" {
                ret ""
            }
            ret resolve_field_expression(ctx, owner, field.field, source_name, line, column, length)
        }
        Expr::MethodCall(call) => {
            let receiver = infer_expression_h(ctx, call.receiver)
            ctx.member_receivers.push((line, column, receiver))
            ret resolve_method_call(ctx, receiver, call.method, call.generics, call.args, source_name, line, column,
                length,)
        }
        _ => {
            ret ""
        }
    }
    ret ""
}
fn binding_type(bindings: Vec[SemanticBinding], name: str) -> str {
    let mut index = bindings.len()
    while index > 0_usize {
        index -= 1_usize
        match bindings.get(index) {
            Option[SemanticBinding]::Some(binding) => {
                if binding.name == name {
                    ret binding.typ
                }
            }
            Option[SemanticBinding]::None => {
            }
        }
    }
    ret ""
}

fn infer_value_path(ctx: mut SemanticContext, name: str, source_name: str,
    line: usize, column: usize, length: usize,) -> str {
    let mut resolved = infer_path_type(ctx.bindings, name)
    if !binding_exists(ctx.bindings, name) {
        for callable in ctx.callables {
            if callable.is_static && callable.name == name {
                remember_dependency(ctx, callable)
                resolved = callable.ret_type
                break
            }
        }
    }
    if resolved == "" {
        report_unknown_value(ctx, name, source_name, line, column, length)
    }
    let result = if resolved == "Self" && ctx.self_type != "" {
        ctx.self_type
    } else {
        local_type(ctx, resolved)
    }
    let mut end = name.len()
    while end >= 2_usize {
        if name.slice(end - 2_usize, 2_usize) == "::" {
            let spelling = name.slice(0_usize, end - 2_usize)
            let owner = if spelling == "Self" || spelling == "self" {
                ctx.self_type
            } else {
                local_type(ctx, spelling)
            }
            let member = name.slice(end, name.len() - end)
            for variant in ctx.variants {
                if variant.name == member && semantic_same_owner(variant.owner_type, owner) {
                    ret result
                }
            }
            let mut denied = false
            let mut allowed = false
            for method in ctx.methods {
                if method.name == member && semantic_receiver_matches(method.receiver_type, owner, method.generic_names) {
                    if semantic_method_accessible(method, ctx.self_type) {
                        allowed = true
                    } else {
                        denied = true
                        remember_method_dependency(ctx, method)
                    }
                }
            }
            if denied && !allowed {
                report_private_method(ctx, owner, member, line, column, length)
                ret ""
            }
            break
        }
        end -= 1_usize
    }
    ret result
}

fn infer_path_type(bindings: Vec[SemanticBinding], name: str) -> str {
    let bound = binding_type(bindings, name)
    if bound != "" {
        ret bound
    }

    // A qualified enum constructor used as a value has the type of its
    // owning enum, for example `Option[usize]::None` is `Option[usize]`.
    let mut index = name.len()
    while index >= 2_usize {
        if name.slice(index - 2_usize, 2_usize) == "::" {
            let owner = name.slice(0_usize, index - 2_usize)
            if owner != "" {
                ret last_path_segment(owner)
            }
            ret ""
        }
        index -= 1_usize
    }
    ret ""
}

fn report_unknown_value(
    ctx: mut SemanticContext,
    name: str,
    source_name: str,
    line: usize,
    column: usize,
    length: usize,
) ->() {
    if name == "" || name == "_" || contains_substring(name, "::") || starts_with_uppercase_semantic(name)
    {
        ret()
    }
    if binding_exists(ctx.bindings, name) {
        ret()
    }
    for callable in ctx.callables {
        if callable.name == name {
            ret()
        }
    }
    remember_failed_lookup(ctx)
    let nearest = nearest_value_name(ctx.bindings, name)
    let mut diagnostic = FrontendDiagnostic::new(
        1_usize,
        "unknown-variable",
        "unknown variable '" + name + "'",
        line,
        column,
        length,
    ).with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "not found in this scope")
    if nearest != "" {
        diagnostic = diagnostic.with_help("did you mean `" + nearest + "`?")
        diagnostic = diagnostic.with_suggestion(source_name, line, column, length, nearest, "use the similarly named binding",
            SuggestionApplicability::MachineApplicable,)
    } else {
        diagnostic = diagnostic.with_help("introduce a local binding or import a value named `" + name
            + "`")
    }
    ctx.diagnostics.push(diagnostic)
    ret()
}

fn binding_exists(bindings: Vec[SemanticBinding], name: str) -> bool {
    for binding in bindings {
        if binding.name == name {
            ret true
        }
    }
    ret false
}

fn nearest_value_name(bindings: Vec[SemanticBinding], name: str) -> str {
    let mut nearest = ""
    let mut distance = 4_usize
    for binding in bindings {
        let current = edit_distance(binding.name, name)
        if current < distance {
            distance = current nearest = binding.name
        }
    }
    if distance <= 3_usize {
        ret nearest
    }
    ret ""
}

fn starts_with_uppercase_semantic(value: str) -> bool {
    if value.len() == 0_usize {
        ret false
    }
    let byte = value.byte_at(0_usize)
    ret byte >= 65_u8 && byte <= 90_u8
}

fn check_binary_operands(
    ctx: mut SemanticContext,
    operator: str,
    lhs: str,
    rhs: str,
    source_name: str,
    line: usize,
    column: usize,
    length: usize,
) ->() {
    if lhs == "" || rhs == "" || lhs == "never" || rhs == "never" {
        ret()
    }
    let method = if operator == "**" {
        "pow"
    } elif lhs != "str" && !numeric_semantic_type(lhs) {
        if operator == "+" {
            "op"
        } elif operator == "/" {
            "div"
        } else {
            ""
        }
    } else {
        ""
    }
    if method != "" {
        check_implicit_method_access(ctx, lhs, method, line, column, length)
    }
    if !builtin_receiver_type(lhs) || !builtin_receiver_type(rhs) {
        ret()
    }
    let logical = operator == "&&" || operator == "||"
    let compatible = if logical {
        lhs == "bool" && rhs == "bool"
    } else {
        semantic_types_compatible(lhs, rhs) ||(numeric_semantic_type(lhs) && numeric_semantic_type(rhs))
    }
    if compatible {
        ret()
    }
    ctx.diagnostics.push(
        FrontendDiagnostic::new(
            1_usize,
            "binary-operand-type-mismatch",
            "operator `" + operator + "` cannot be applied to `" + lhs + "` and `" + rhs + "`",
            line,
            column,
            length,
        )
        .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "incompatible operand types")
        .with_help(if logical {
                "both operands of a logical operator must have type `bool`"
            } else {
                "use operands with compatible types"
            }
        )
    )
    ret()
}
fn numeric_semantic_type(typ: str) -> bool {
    ret typ == "u8" || typ == "u16" || typ == "u32" || typ == "u64" || typ == "u128" || typ == "usize"
    || typ == "i8" || typ == "i16" || typ == "i32" || typ == "i64" || typ == "i128" || typ == "isize"
    || typ == "f32" || typ == "f64"
}

/// Mirrors binary lowering: an unsuffixed right operand uses the left type;
/// otherwise floating-point arithmetic promotes both operands to one type.
fn binary_expression_type(operator: str, lhs: str, rhs: str, right: Expr) -> str {
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" ||
    operator == ">" || operator == ">=" || operator == "&&" || operator == "||" {
        ret "bool"
    }
    if operator != "**" && numeric_semantic_type(lhs) && numeric_semantic_type(rhs) &&
    !contextual_numeric_value_matches(right, lhs) {
        if lhs == "f64" || rhs == "f64" {
            ret "f64"
        }
        if lhs == "f32" || rhs == "f32" {
            ret "f32"
        }
    }
    ret if lhs != "" {
        lhs
    } else {
        rhs
    }
}

fn last_path_segment(path: str) -> str {
    let mut index = path.len()
    while index >= 2_usize {
        if path.slice(index - 2_usize, 2_usize) == "::" {
            ret path.slice(index, path.len() - index)
        }
        index -= 1_usize
    }
    ret path
}

fn unsafe_block_type(ctx: mut SemanticContext, statements: Vec[Statement]) -> str {
    if statements_terminate_flow(statements) {
        ret "never"
    }
    if statements.len() == 0_usize {
        ret "void"
    }
    match statements.get(statements.len() - 1_usize) {
        Option[Statement]::Some(statement) => {
            match statement {
                Statement::Expr(expr) => {
                    ret infer_expression(ctx, expr)
                }
                _ => {
                }
            }
        }
        Option[Statement]::None => {
        }
    }
    ret "void"
}

fn find_binding(bindings: Vec[SemanticBinding], name: str) -> Option[SemanticBinding] {
    let mut index = bindings.len()
    while index > 0_usize {
        index -= 1_usize
        match bindings.get(index) {
            Option[SemanticBinding]::Some(binding) => {
                if binding.name == name {
                    ret Option[SemanticBinding]::Some(binding)
                }
            }
            Option[SemanticBinding]::None => {
            }
        }
    }
    ret Option[SemanticBinding]::None
}

fn expression_path(expr: ExprNode) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        Expr::Parenthesized(inner) => {
            ret expression_path_h(inner)
        }
        _ => {
        }
    }
    ret ""
}

fn expression_path_h(expr: ExprNode<H>) -> str {
    match expr.value {
        Expr::Path(name) => {
            ret name
        }
        Expr::Parenthesized(inner) => {
            ret expression_path_h(inner)
        }
        _ => {
        }
    }
    ret ""
}

fn resolve_associated_call(ctx: mut SemanticContext, path: str, type_arguments: Vec[str], args: Vec[ExprNode], argument_types: Vec[str],
    line: usize, column: usize, length: usize,) -> Option[str] {
    let mut separator = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    while index + 1_usize < path.len() {
        let ch = path.slice(index, 1_usize)
        if ch == "[" {
            depth += 1_usize
        } elif ch == "]" && depth > 0_usize {
            depth -= 1_usize
        } elif depth == 0_usize && path.slice(index, 2_usize) == "::" {
            separator = index
        }
        index += 1_usize
    }
    if separator == 0_usize {
        ret Option[str]::None
    }
    let mut receiver = local_type(ctx, path.slice(0_usize, separator))
    if receiver == "Self" || receiver == "self" {
        receiver = ctx.self_type
    }
    let name = path.slice(separator + 2_usize, path.len() - separator - 2_usize)
    let mut expected = Vec[str]::new()
    let mut found = false
    for method in ctx.methods {
        if !method.is_static || method.name != name {
            continue
        }
        if !semantic_method_accessible(method, ctx.self_type) {
            continue
        }
        if !semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
            continue
        }
        found = true
        expected = specialize_method_types(method.params, method.receiver_type, receiver, method.generic_names)
        let mut substitutions = Vec[(str, str)]::new()
        let supplied_types = bind_explicit_type_arguments(ctx, method.method_generic_names, type_arguments, substitutions)
        let matches = if method.method_generic_names.len() == 0_usize {
            parameter_types_match_contextual(expected, argument_types, args)
        } else {
            generic_call_matches(expected, argument_types, args, method.method_generic_names, substitutions)
        }
        if supplied_types && expected.len() == argument_types.len() && matches {
            remember_method_dependency(ctx, method)
            let result = specialize_method_type(method.ret_type, method.receiver_type, receiver, method.generic_names)
            ret Option[str]::Some(substitute_type_bindings(result, substitutions))
        }
    }
    if found {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "argument-mismatch",
                "arguments to associated function '" + path + "' do not match " + type_list(expected),
                line, column, length,))
    }
    if !found && known_nominal_receiver(ctx, receiver) {
        // Type::method(receiver, ...) can name an ordinary receiver method.
        // Keep that accessible declaration available to UFCS call checking.
        let mut accessible_member = false
        let mut private_member = false
        for method in ctx.methods {
            let declared = if starts_with(method.receiver_type, "dyn ") {
                method.receiver_type.slice(4_usize, method.receiver_type.len() - 4_usize)
            } else {
                method.receiver_type
            }
            if method.name == name && semantic_root_type(declared) == semantic_root_type(receiver) {
                if semantic_method_accessible(method, ctx.self_type) {
                    accessible_member = true
                } else {
                    private_member = true
                    remember_method_dependency(ctx, method)
                }
            }
        }
        let mut constructor = false
        for variant in ctx.variants {
            if variant.name == name && semantic_root_type(variant.owner_type) == semantic_root_type(receiver) {
                constructor = true
            }
        }
        if !constructor && !accessible_member {
            if private_member {
                report_private_method(ctx, receiver, name, line, column, length)
                ret Option[str]::Some("")
            }
            remember_failed_lookup(ctx)
            ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "unknown-associated-function",
                    "no accessible associated function '" + name + "' found for type '" + receiver + "'",
                    line, column, length,))
        }
    }
    ret Option[str]::None
}
fn resolve_call(ctx: mut SemanticContext, name: str, type_arguments: Vec[str], args: Vec[ExprNode], line: usize, column: usize,
    length: usize,) -> Option[str] {
    let mut argument_types = Vec[str]::new()
    for argument in args {
        argument_types.push(infer_expression(ctx, argument))
    }
    // Range syntax uses an absolute core path, independent of local imports
    // and any user function named `range`. Its bounds obey the usize contract.
    if name == "core::iter::range" || name == "core::iter::range_inclusive" {
        let expected = vec!["usize", "usize"]
        if args.len() == 2_usize && contextual_integer_out_of_range(expected, args) {
            ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "integer-literal-out-of-range",
                    "range bound is outside the range of usize", line, column, length,))
        } elif args.len() != 2_usize || !parameter_types_match_contextual(expected, argument_types, args) {
            ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "argument-mismatch",
                    "range requires two usize bounds, found " + type_list(argument_types),
                    line, column, length,))
        }
        ret Option[str]::Some(local_type(ctx, "core::iter::Range"))
    }
    if contains_substring(name, "::") {
        match resolve_associated_call(ctx, name, type_arguments, args, argument_types, line, column, length) {
            Some(typ) => {
                ret Option[str]::Some(typ)
            }
            None => {
            }
        }
    }
    let mut saw_name = false
    let mut saw_arity = false
    let mut expected_arity = 0_usize
    let mut expected_params = Vec[str]::new()
    let mut out_of_range = false
    for callable in ctx.callables {
        if callable.name == name {
            saw_name = true
            expected_arity = callable.params.len()
            expected_params = callable.params
            if callable.params.len() == argument_types.len() {
                saw_arity = true
                let mut substitutions = Vec[(str, str)]::new()
                if !bind_explicit_type_arguments(ctx, callable.generic_names, type_arguments, substitutions) {
                    continue
                }
                let matches = if callable.generic_names.len() == 0 {
                    parameter_types_match_contextual(callable.params, argument_types, args)
                } else {
                    generic_call_matches(callable.params, argument_types, args, callable.generic_names, substitutions)
                }
                if matches {
                    remember_dependency(ctx, callable)
                    ret Option[str]::Some(if callable.generic_names.len() == 0 {
                            substitute_return_type(callable.ret_type, callable.params, argument_types)
                        } else {
                            substitute_type_bindings(callable.ret_type, substitutions)
                        }
                    )
                } elif contextual_integer_out_of_range(callable.params, args) {
                    out_of_range = true
                }
            }
        }
    }
    remember_failed_lookup(ctx)
    if out_of_range {
        ctx.diagnostics.push(
            FrontendDiagnostic::new(1_usize, "integer-literal-out-of-range",
                "integer literal is outside the range of the expected parameter type",
                line, column, length,)
            .with_help("use a wider integer parameter or a value within its range")
        )
        ret Option[str]::None
    }
    if saw_name && expected_arity != argument_types.len() {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "argument-mismatch", "call to '" + name
                + "' expects " + Debug::fmt(expected_arity) + " argument(s), got " + Debug::fmt(argument_types.len()),
                line, column, length,))
    } elif saw_name && saw_arity {
        ctx.diagnostics.push(
            FrontendDiagnostic::new(1_usize, "argument-mismatch", "arguments to '" + name + "' have types "
                + legacy_type_list(argument_types) + ", expected " + legacy_type_list(expected_params),
                line,
                column, length,)
            .with_label("", line, column, length, DiagnosticLabelKind::Primary, "argument types are "
                + type_list(argument_types),)
            .with_help("pass values compatible with the declared function signature")
        )
    }
    ret Option[str]::None
}
fn legacy_type_list(types: Vec[str]) -> str {
    let mut out = "["
    let mut index = 0_usize
    for typ in types {
        if index > 0_usize {
            out += ", "
        }
        out += typ
        index += 1_usize
    }
    ret out + "]"
}

fn type_list(types: Vec[str]) -> str {
    let mut out = "("
    let mut index = 0_usize
    for typ in types {
        if index > 0_usize {
            out += ", "
        }
        out += "`" + typ + "`"
        index += 1_usize
    }
    ret out + ")"
}

fn substitute_return_type(ret_type: str, params: Vec[str], arguments: Vec[str]) -> str {
    let mut index = 0_usize
    while index < params.len() {
        match params.get(index) {
            Option[str]::Some(param) => {
                if generic_placeholder(param) {
                    match arguments.get(index) {
                        Option[str]::Some(argument) => {
                            if ret_type == param {
                                ret argument
                            }
                        }
                        Option[str]::None => {
                        }
                    }
                }
            }
            Option[str]::None => {
            }
        }
        index += 1_usize
    }
    ret ret_type
}

fn resolve_field_type(ctx: mut SemanticContext, owner: str, name: str) -> str {
    if starts_with(owner, "(") {
        ret tuple_element_type(owner, name)
    }
    for field in ctx.fields {
        if field.name == name && semantic_receiver_matches(field.owner_type, owner, field.generic_names) {
            let mut recorded = false
            for dependency in ctx.dependencies {
                if dependency.kind == SemanticDependencyKind::Field
                && dependency.module_name == field.module_name
                && dependency.name == field.declaration_owner + "." + field.name {
                    recorded = true break
                }
            }
            if !recorded {
                ctx.dependencies.push(SemanticDependency {
                        field.module_name,
                        field.declaration_owner + "." + field.name, field.signature, SemanticDependencyKind::Field
                    }
                    ,)
            }
            ret specialize_method_type(field.typ, field.owner_type, owner, field.generic_names)
        }
    }
    ret ""
}

fn resolve_field_expression(
    ctx: mut SemanticContext,
    owner: str,
    name: str,
    source_name: str,
    line: usize,
    column: usize,
    length: usize,
) -> str {
    if owner == "" {
        ret ""
    }
    let typ = resolve_field_type(ctx, owner, name)
    if typ != "" {
        ret typ
    }
    remember_failed_lookup(ctx)
    if owner == "" || builtin_receiver_type(owner) {
        ret ""
    }
    let mut saw_owner = false
    for aggregate in ctx.aggregate_names {
        if aggregate == semantic_root_type(semantic_type_name(owner)) {
            saw_owner = true break
        }
    }
    let mut nearest = ""
    let mut best = 4_usize
    for field in ctx.fields {
        if semantic_receiver_matches(field.owner_type, owner, field.generic_names) {
            saw_owner = true
            let distance = edit_distance(field.name, name)
            if distance < best {
                best = distance nearest = field.name
            }
        }
    }
    if saw_owner {
        let mut diagnostic = FrontendDiagnostic::new(1_usize, "unknown-field", "type '" + owner + "' has no field '"
            + name + "'", line, column, length,)
        .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "unknown field")
        if best <= 3_usize {
            diagnostic = diagnostic.with_help("did you mean `" + nearest + "`?")
            diagnostic = diagnostic.with_suggestion(source_name, line, column, length, nearest, "use the similarly named field",
                SuggestionApplicability::MachineApplicable,)
        }
        ctx.diagnostics.push(diagnostic)
    }
    ret ""
}

fn check_struct_initializer(
    ctx: mut SemanticContext,
    owner: str,
    values: Vec[ExprNode],
    source_name: str,
    line: usize,
    column: usize,
    length: usize,
) ->() {
    let resolved_owner = if owner == "Self" && ctx.self_type != "" {
        ctx.self_type
    } else {
        owner
    }
    let mut expected = Vec[SemanticField]::new()
    for field in ctx.fields {
        if semantic_receiver_matches(field.owner_type, resolved_owner, field.generic_names) {
            expected.push(field)
        }
    }
    let mut actual_types = Vec[str]::new()
    for value in values {
        actual_types.push(infer_expression(ctx, value))
    }
    if expected.len() > 0_usize && expected.len() != actual_types.len() {
        ctx.diagnostics.push(
            FrontendDiagnostic::new(1_usize, "struct-field-count-mismatch", "`" + resolved_owner + "` expects "
                + Debug::fmt(expected.len()) + " field value(s), found " + Debug::fmt(actual_types.len()),
                line, column, length,)
            .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "wrong number of field values")
        )
        ret()
    }
    let mut index = 0_usize
    while index < expected.len() {
        let field = expected.get(index).unwrap_or(SemanticField::new("", "", "", ""))
        let actual = actual_types.get(index).unwrap_or("")
        let expected_type = specialize_method_type(field.typ, field.owner_type, resolved_owner, field.generic_names)
        if actual != "" && !semantic_types_compatible(expected_type, actual) {
            ctx.diagnostics.push(
                FrontendDiagnostic::new(1_usize, "struct-field-type-mismatch", "field `" + field.name
                    + "` expects `" + expected_type + "`, found `" + actual + "`", line, column, length,)
                .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "invalid value for field `"
                    + field.name + "`",)
            )
        }
        index += 1_usize
    }
    ret()
}

fn tuple_type(ctx: mut SemanticContext, items: Vec[ExprNode]) -> str {
    let mut out = "("
    let mut index = 0_usize
    for item in items {
        if index > 0_usize {
            out += ", "
        }
        out += infer_expression(ctx, item)
        index += 1_usize
    }
    ret out + ")"
}

fn array_type(ctx: mut SemanticContext, items: Vec[ExprNode], vector: bool) -> str {
    let mut element = ""
    let mut count = 0_usize
    for item in items {
        let actual = infer_expression(ctx, item)
        if element == "" {
            element = actual
        } elif actual != "" && !semantic_types_compatible(element, actual) {
            ctx.diagnostics.push(
                FrontendDiagnostic::new(1_usize, "collection-element-type-mismatch", "collection elements have incompatible types: expected `"
                    + element + "`, found `" + actual + "`", item.line, item.column, item.length,)
                .with_label(item.source_name, item.line, item.column, item.length, DiagnosticLabelKind::Primary,
                    "element has type `" + actual + "`",)
                .with_help("use a common element type for every value in the collection")
            )
        }
        count += 1_usize
    }
    if element == "" {
        ret ""
    }
    if vector {
        ret local_type(ctx, "Vec[" + element + "]")
    }
    ret "[" + element + "; " + Debug::fmt(count) + "]"
}

fn infer_if_expression(
    ctx: mut SemanticContext,
    branches: Vec[IfExprBranch],
    else_body: ExprNode<H>,
    line: usize,
    column: usize,
    length: usize,
) -> str {
    let mut resolved = ""
    for branch in branches {
        check_boolean_condition(ctx, branch.condition)
        let branch_type = infer_expression(ctx, branch.body)
        resolved = merge_expression_type_at(ctx, resolved, branch_type, branch.body.source_name, branch.body.line,
            branch.body.column, branch.body.length,)
    }
    let else_type = infer_expression_h(ctx, else_body)
    ret merge_expression_type_at(ctx, resolved, else_type, else_body.source_name, else_body.line, else_body.column,
        else_body.length,)
}

fn merge_expression_types(ctx: mut SemanticContext, expected: str, actual: str, expr: ExprNode) -> str
{
    ret merge_expression_type_at(ctx, expected, actual, expr.source_name, expr.line, expr.column, expr.length)
}

fn merge_expression_type_at(
    ctx: mut SemanticContext,
    expected: str,
    actual: str,
    source_name: str,
    line: usize,
    column: usize,
    length: usize,
) -> str {
    if expected == "never" {
        ret actual
    }
    if actual == "never" {
        ret expected
    }
    if expected == "" {
        ret actual
    }
    if actual == "" {
        ret expected
    }
    if !semantic_types_compatible(expected, actual) {
        ctx.diagnostics.push(
            FrontendDiagnostic::new(1_usize, "branch-type-mismatch", "branches have incompatible types: expected `"
                + expected + "`, found `" + actual + "`", line, column, length,)
            .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "this branch has type `"
                + actual + "`",)
            .with_help("make every branch produce the same type")
        )
    }
    ret expected
}

fn indexed_type(ctx: SemanticContext, typ: str) -> str {
    let root = declaration_type_name_view(semantic_root_type(typ), ctx.type_names)
    if root == "Vec" || root == "Option" || root == "Result" {
        ret first_type_argument(typ)
    }
    if starts_with(typ, "[") {
        let mut index = 1_usize
        while index < typ.len() {
            if typ.slice(index, 1_usize) == ";" || typ.slice(index, 1_usize) == "]" {
                ret trim_type_text(typ.slice(1_usize, index - 1_usize))
            }
            index += 1_usize
        }
    }
    ret ""
}

// Syntax-driven calls obey the same declaring-type boundary as explicit calls.
fn check_implicit_method_access(ctx: mut SemanticContext, receiver: str, name: str,
    line: usize, column: usize, length: usize,) ->() {
    let mut denied = false
    let mut allowed = false
    for method in ctx.methods {
        if method.name == name && semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
            remember_method_dependency(ctx, method)
            if semantic_method_accessible(method, ctx.self_type) {
                allowed = true
            } else {
                denied = true
            }
        }
    }
    if denied && !allowed {
        report_private_method(ctx, receiver, name, line, column, length)
    }
}
fn iterable_method_return(ctx: mut SemanticContext, receiver: str, name: str) -> str {
    for method in ctx.methods {
        if !method.is_static && method.name == name &&
        semantic_method_accessible(method, ctx.self_type) &&
        semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
            remember_method_dependency(ctx, method)
            ret specialize_method_type(method.ret_type, method.receiver_type, receiver, method.generic_names)
        }
    }
    remember_failed_lookup(ctx)
    ret ""
}

fn iterable_item_type(ctx: mut SemanticContext, typ: str) -> str {
    let mut iterator = typ
    let converted = iterable_method_return(ctx, typ, "into_iter")
    if converted != "" {
        iterator = converted
    }
    let step = iterable_method_return(ctx, iterator, "next")
    if step != "" {
        let option = tuple_element_type(step, "1")
        if declaration_type_name_view(semantic_root_type(option), ctx.type_names) == "Option" {
            ret first_type_argument(option)
        }
    }
    let item = indexed_type(ctx, typ)
    if item != "" {
        ret item
    }
    // Range iterators in the prelude yield `usize`.
    if declaration_type_name_view(typ, ctx.type_names) == "Range" {
        ret "usize"
    }
    ret ""
}

// A custom Future's generic arguments describe its state, not its output.
// The resolved poll contract carries the output in Poll[State, Output].
fn checked_awaited_type(ctx: mut SemanticContext, future: str, source: str,
    line: usize, column: usize, length: usize,) -> str {
    let output = awaited_type(ctx, future)
    if !ctx.is_async {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "await-outside-async",
                "'await' can only be used inside an async function", line, column, length,)
            .with_label(source, line, column, length, DiagnosticLabelKind::Primary,
                "this function is synchronous",))
        ret output
    }
    let root = semantic_root_type(future)
    if output == "" && future != "" && !type_contains_inference_hole(future) &&
    !contains_name(ctx.generic_names, root) && !generic_placeholder(root) && root != "Self" {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "invalid-await-operand",
                "await expects a Future, got '" + future + "'", line, column, length,)
            .with_label(source, line, column, length, DiagnosticLabelKind::Primary,
                "this value does not provide a Future poll contract",))
    }
    ret output
}

fn awaited_type(ctx: mut SemanticContext, future: str) -> str {
    if semantic_root_type(future) == "__encore_async_future" {
        ret first_type_argument(future)
    }
    let step = iterable_method_return(ctx, future, "poll")
    if declaration_type_name_view(semantic_root_type(step), ctx.type_names) == "Poll" {
        ret nth_type_argument(step, 1_usize)
    }
    // Leave an unresolved operand to the complete Future contract validator.
    ret ""
}

fn first_type_argument(typ: str) -> str {
    ret nth_type_argument(typ, 0_usize)
}

fn nth_type_argument(typ: str, wanted: usize) -> str {
    let mut start = typ.len()
    let mut index = 0_usize
    while index < typ.len() {
        if typ.slice(index, 1_usize) == "[" {
            start = index + 1_usize break
        }
        index += 1_usize
    }
    if start >= typ.len() {
        ret ""
    }
    let mut bracket_depth = 0_i32
    let mut tuple_depth = 0_i32
    let mut argument = 0_usize
    index = start
    while index < typ.len() {
        let ch = typ.slice(index, 1_usize)
        if ch == "[" {
            bracket_depth += 1_i32
        } elif ch == "]" {
            if bracket_depth == 0_i32 && tuple_depth == 0_i32 {
                if argument == wanted {
                    ret trim_type_text(typ.slice(start, index - start))
                }
                ret ""
            }
            bracket_depth -= 1_i32
        } elif ch == "(" {
            tuple_depth += 1_i32
        } elif ch == ")" {
            tuple_depth -= 1_i32
        } elif ch == "," && bracket_depth == 0_i32 && tuple_depth == 0_i32 {
            if argument == wanted {
                ret trim_type_text(typ.slice(start, index - start))
            }
            argument += 1_usize
            start = index + 1_usize
        }
        index += 1_usize
    }
    ret ""
}

fn match_pattern_binding_type(ctx: mut SemanticContext, matched: str, pattern: MatchPattern) -> str {
    let root = declaration_type_name_view(semantic_root_type(matched), ctx.type_names)
    match pattern.value {
        Option[str]::Some(value) => {
            let variant = semantic_variant_name(value)
            for declaration in ctx.variants {
                if semantic_root_type(matched) == declaration.owner_type && declaration.name == variant {
                    // Follow declaration edits, not merely the nominal enum ID.
                    remember_failed_lookup(ctx)
                    let mut receiver = declaration.owner_type
                    if declaration.generic_names.len() > 0 {
                        receiver += "["
                        let mut separator = ""
                        for name in declaration.generic_names {
                            receiver += separator + name separator = ", "
                        }
                        receiver += "]"
                    }
                    ret specialize_method_type(declaration.payload_type, receiver, matched, declaration.generic_names)
                }
            }
            if variant == "Err" && root == "Result" {
                ret nth_type_argument(matched, 1_usize)
            }
            if variant == "Ok" && root == "Result" {
                ret nth_type_argument(matched, 0_usize)
            }
            if variant == "Some" && root == "Option" {
                ret nth_type_argument(matched, 0_usize)
            }
        }
        Option[str]::None => {
        }
    }
    // An unknown enum declaration is not evidence that its first parameter
    // is this variant's payload (Poll::Ready is the second, for example).
    ret ""
}

fn semantic_variant_name(value: str) -> str {
    let mut last = value.len()
    let mut index = 0_usize
    while index + 1_usize < value.len() {
        if value.slice(index, 2_usize) == "::" {
            last = index + 2_usize
        }
        index += 1_usize
    }
    if last < value.len() {
        ret value.slice(last, value.len() - last)
    }
    ret value
}

fn tuple_element_type(typ: str, field: str) -> str {
    let mut wanted = 0_usize
    let mut index = 0_usize
    while index < field.len() {
        let byte = field.byte_at(index)
        if byte < 48_u8 || byte > 57_u8 {
            ret ""
        }
        wanted = wanted * 10_usize +(byte - 48_u8) as usize
        index += 1_usize
    }
    if typ.len() < 2_usize {
        ret ""
    }
    let inner = typ.slice(1_usize, typ.len() - 2_usize)
    let mut current = 0_usize
    let mut start = 0_usize
    let mut depth = 0_i32
    index = 0_usize
    while index <= inner.len() {
        let at_end = index == inner.len()
        let ch = if at_end {
            ","
        } else {
            inner.slice(index, 1_usize)
        }
        if ch == "[" || ch == "(" {
            depth += 1_i32
        } elif ch == "]" || ch == ")" {
            depth -= 1_i32
        } elif ch == "," && depth == 0_i32 {
            if current == wanted {
                ret trim_type_text(inner.slice(start, index - start))
            }
            current += 1_usize
            start = index + 1_usize
        }
        index += 1_usize
    }
    ret ""
}

fn trim_type_text(value: str) -> str {
    let mut start = 0_usize
    let mut end = value.len()
    while start < end && value.slice(start, 1_usize) == " " {
        start += 1_usize
    }
    while end > start && value.slice(end - 1_usize, 1_usize) == " " {
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn known_nominal_receiver(ctx: mut SemanticContext, receiver: str) -> bool {
    ret contains_name(ctx.aggregate_names, semantic_root_type(semantic_type_name(receiver)))
}

fn report_private_method(ctx: mut SemanticContext, receiver: str, name: str,
    line: usize, column: usize, length: usize,) ->() {
    remember_failed_lookup(ctx)
    ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "private-method",
            "method '" + name + "' on type '" + receiver + "' is private to its declaring type",
            line, column, length,).with_help("call it from an impl of that type or declare the method pub"))
    ret()
}

fn resolve_method_call(
    ctx: mut SemanticContext,
    receiver: str,
    name: str,
    type_arguments: Vec[str],
    args: Vec[ExprNode],
    source_name: str,
    line: usize,
    column: usize,
    length: usize,
) -> str {
    if receiver == "" {
        ret ""
    }
    let receiver_name = declaration_type_name_view(semantic_root_type(receiver), ctx.type_names)
    if (receiver_name == "Task" || receiver_name == "JoinHandle") && name == "join" {
        if args.len() == 0_usize {
            ret first_type_argument(receiver)
        }
        ret ""
    }
    let generic_receiver = type_base_or_self(receiver)
    let is_generic_receiver = contains_name(ctx.generic_names, generic_receiver)
    let mut argument_types = Vec[str]::new()
    for argument in args {
        argument_types.push(infer_expression(ctx, argument))
    }
    let mut saw_receiver = false
    let mut saw_name = false
    let mut private_member = false
    let mut expected_arity = 0_usize
    let mut expected_params = Vec[str]::new()
    for method in ctx.methods {
        if method.name != name ||(method.is_static &&(is_generic_receiver || starts_with(receiver, "dyn "))) {
            continue
        }
        if is_generic_receiver && semantic_type_name(method.receiver_type) != generic_receiver {
            continue
        }
        if semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
            if !semantic_method_accessible(method, ctx.self_type) {
                private_member = true
                remember_method_dependency(ctx, method)
                continue
            }
            saw_receiver = true
            if method.name == name {
                saw_name = true
                let concrete_params = specialize_method_types(method.params, method.receiver_type, receiver, method.generic_names)
                expected_arity = concrete_params.len()
                expected_params = concrete_params
                let mut substitutions = Vec[(str, str)]::new()
                let supplied_types = bind_explicit_type_arguments(ctx, method.method_generic_names, type_arguments, substitutions)
                let matches = if method.method_generic_names.len() == 0_usize {
                    parameter_types_match_contextual(concrete_params, argument_types, args)
                } else {
                    generic_call_matches(concrete_params, argument_types, args, method.method_generic_names, substitutions)
                }
                if supplied_types && concrete_params.len() == argument_types.len() && matches {
                    remember_method_dependency(ctx, method)
                    let specialized_return = specialize_method_type(method.ret_type, method.receiver_type,
                        receiver, method.generic_names,)
                    let resolved = if method.method_generic_names.len() == 0_usize {
                        substitute_return_type(specialized_return, concrete_params, argument_types)
                    } else {
                        substitute_type_bindings(specialized_return, substitutions)
                    }
                    if semantic_type_name(resolved) == "Self" {
                        ret receiver
                    }
                    ret resolved
                }
            }
        }
    }

    remember_failed_lookup(ctx)
    if private_member && !saw_name {
        report_private_method(ctx, receiver, name, line, column, length)
        ret ""
    }
    if is_generic_receiver && !saw_name {
        ret ""
    }
    if saw_name {
        if expected_arity != argument_types.len() {
            ctx.diagnostics.push(
                FrontendDiagnostic::new(
                    1_usize,
                    "method-arity-mismatch",
                    "method `" + name + "` on `" + receiver + "` expects " + Debug::fmt(expected_arity)
                    + " argument(s), got " + Debug::fmt(argument_types.len()),
                    line,
                    column,
                    length,
                )
                .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "wrong number of method arguments")
                .with_help("supply exactly " + Debug::fmt(expected_arity) + " argument(s)")
            )
        } elif contextual_integer_out_of_range(expected_params, args) {
            ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "integer-literal-out-of-range",
                    "integer literal is outside the range of the expected method parameter type", line, column, length,))
        } else {
            ctx.diagnostics.push(
                FrontendDiagnostic::new(
                    1_usize,
                    "method-argument-type-mismatch",
                    "arguments to method `" + name + "` do not match parameter types " + type_list(expected_params),
                    line,
                    column,
                    length,
                )
                .with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "argument types are "
                    + type_list(argument_types),)
                .with_help("pass values compatible with the method signature")
            )
        }
        ret ""
    }

    // Successful lookups never specialize unrelated method names. Only a
    // missing name needs the broader receiver scan for the original diagnostic.
    if !saw_receiver && !builtin_receiver_type(receiver) {
        for method in ctx.methods {
            if !method.is_static && semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
                saw_receiver = true break
            }
        }
    }
    if receiver != "" &&(saw_receiver || known_nominal_receiver(ctx, receiver)) && !builtin_receiver_type(receiver) {
        let mut diagnostic = FrontendDiagnostic::new(
            1_usize,
            "unknown-method",
            "no method named `" + name + "` found for type `" + receiver + "`",
            line,
            column,
            length,
        ).with_label(source_name, line, column, length, DiagnosticLabelKind::Primary, "unknown method")
        let nearest = nearest_method(SemanticSlice::from_vec(semantic_accessible_methods_view(ctx.methods, ctx.self_type)), receiver, name)
        if nearest != "" {
            diagnostic = diagnostic.with_help("did you mean `" + nearest + "`?")
            diagnostic = diagnostic.with_suggestion(
                source_name,
                line,
                column,
                length,
                nearest,
                "use the similarly named method",
                SuggestionApplicability::MachineApplicable,
            )
        } else {
            diagnostic = diagnostic.with_note("methods available for this receiver have different names")
        }
        ctx.diagnostics.push(diagnostic)
    }
    ret ""
}
fn replace_self_types(types: Vec[str], receiver: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    for typ in types {
        out.push(replace_type_name(typ, "Self", receiver))
    }
    ret out
}

fn generic_signature(signature: u64, names: Vec[str]) -> u64 {
    if names.len() == 0_usize {
        ret signature
    }
    let mut key = Debug::fmt(signature) + "#generics"
    for name in names {
        key += ":" + name
    }
    ret nonzero_hash(key)
}

fn semantic_receiver_matches(declared: str, receiver: str, generics: Vec[str]) -> bool {
    let mut substitutions = Vec[(str, str)]::new()
    ret receiver_substitutions(declared, receiver, generics, substitutions)
}

fn receiver_substitutions(declared: str, receiver: str, generics: Vec[str], substitutions: mut Vec[(str, str)]) -> bool {
    let pattern = compact_type(semantic_type_name(declared))
    let actual = compact_type(semantic_type_name(receiver))
    if contains_name(generics, pattern) {
        for entry in substitutions {
            if entry.0 == pattern {
                ret entry.1 == actual
            }
        }
        substitutions.push((pattern, actual))
        ret true
    }
    if semantic_root_type(pattern) != semantic_root_type(actual) {
        ret false
    }
    let mut index = 0_usize
    loop {
        let expected_arg = nth_type_argument(pattern, index)
        let actual_arg = nth_type_argument(actual, index)
        if expected_arg == "" && actual_arg == "" {
            ret true
        }
        if expected_arg == "" || actual_arg == "" {
            ret false
        }
        if !receiver_substitutions(expected_arg, actual_arg, generics, substitutions) {
            ret false
        }
        index += 1_usize
    }
}

fn specialize_method_types(types: Vec[str], declared_receiver: str, receiver: str, generics: Vec[str]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for typ in types {
        out.push(specialize_method_type(typ, declared_receiver, receiver, generics))
    }
    ret out
}

fn specialize_method_type(typ: str, declared_receiver: str, receiver: str, generics: Vec[str]) -> str {
    ret specialize_method_type_with_self(typ, declared_receiver, receiver, receiver, generics)
}

/// Specializes a declaration type with simultaneous generic substitutions.
/// `self_type` preserves the caller's spelling when the receiver is an alias.
pub fn specialize_method_type_with_self(typ: str, declared_receiver: str, receiver: str, self_type: str, generics: Vec[str]) -> str {
    let mut substitutions = Vec[(str, str)]::new()
    substitutions.push(("Self", self_type))
    receiver_substitutions(declared_receiver, receiver, generics, substitutions)
    ret substitute_type_bindings(typ, substitutions)
}

fn substitute_type_bindings(typ: str, substitutions: Vec[(str, str)]) -> str {
    // Apply mappings simultaneously: Parent[A,B] -> Parent[B,A] must not
    // rewrite the newly inserted B a second time. Self has the same rule.
    let mut out = ""
    let mut index = 0_usize
    while index < typ.len() {
        if identifier_byte(typ.byte_at(index)) {
            let start = index
            while index < typ.len() && identifier_byte(typ.byte_at(index)) {
                index += 1_usize
            }
            let token = typ.slice(start, index - start)
            let mut replacement = token
            for entry in substitutions {
                if entry.0 == token {
                    replacement = entry.1 break
                }
            }
            out += replacement
        } else {
            out += typ.slice(index, 1_usize)
            index += 1_usize
        }
    }
    ret out
}

fn builtin_receiver_type(typ: str) -> bool {
    if typ == "str" || typ == "bool" || typ == "u8" || typ == "u16" || typ == "u32" || typ == "u64" ||
    typ == "u128"
    || typ == "usize" || typ == "i8" || typ == "i16" || typ == "i32" || typ == "i64" || typ == "i128"
    || typ == "isize"
    || typ == "f32" || typ == "f64" {
        ret true
    }
    let base = type_base(typ)
    ret base == "Vec" || base == "Option" || base == "Result" || base == "Box" || base == "Dict"
}

fn remember_failed_lookup(ctx: mut SemanticContext) ->() {
    for dependency in ctx.dependencies {
        if dependency.kind == SemanticDependencyKind::LookupScope {
            ret()
        }
    }
    // The database binds this query dependency to the caller's visible scope.
    ctx.dependencies.push(SemanticDependency {
            "", "", 0_u64, SemanticDependencyKind::LookupScope
        }
        ,
    )
    ret()
}

fn remember_method_dependency(ctx: mut SemanticContext, method: SemanticMethod) ->() {
    // The trait ancestry can change even when the inherited signature does not.
    if method.receiver_type != method.declaration_receiver {
        remember_failed_lookup(ctx)
    }
    for dependency in ctx.dependencies {
        if dependency.kind == SemanticDependencyKind::Method && dependency.module_name == method.module_name && dependency.name == method.declaration_receiver +
        "." + method.name {
            ret()
        }
    }
    ctx.dependencies.push(SemanticDependency {
            method.module_name, method.declaration_receiver + "." + method.name, method.signature, SemanticDependencyKind::Method
        }
        ,
    )
    ret()
}

fn nearest_method(methods: SemanticSlice[SemanticMethod], receiver: str, name: str) -> str {
    let mut nearest = ""
    let mut best = 4_usize
    for method in methods {
        if method.is_static {
            continue
        }
        if semantic_receiver_matches(method.receiver_type, receiver, method.generic_names) {
            let distance = edit_distance(method.name, name)
            if distance < best {
                best = distance
                nearest = method.name
            }
        }
    }
    if best <= 3_usize {
        ret nearest
    }
    ret ""
}

fn edit_distance(left: str, right: str) -> usize {
    let mut previous = Vec[usize]::new()
    let mut column = 0_usize
    while column <= right.len() {
        previous.push(column) column += 1_usize
    }
    let mut row = 0_usize
    while row < left.len() {
        let mut current = Vec[usize]::new()
        current.push(row + 1_usize)
        column = 0_usize
        while column < right.len() {
            let substitution = if left.byte_at(row) == right.byte_at(column) {
                0_usize
            } else {
                1_usize
            }
            let deletion = vec_usize(previous, column + 1_usize) + 1_usize
            let insertion = vec_usize(current, column) + 1_usize
            let replace = vec_usize(previous, column) + substitution
            current.push(min_usize(deletion, min_usize(insertion, replace)))
            column += 1_usize
        }
        previous = current
        row += 1_usize
    }
    ret vec_usize(previous, right.len())
}

fn vec_usize(values: Vec[usize], index: usize) -> usize {
    match values.get(index) {
        Option[usize]::Some(value) => {
            ret value
        }
        Option[usize]::None => {
            ret 0_usize
        }
    }
}

fn min_usize(left: usize, right: usize) -> usize {
    if left < right {
        ret left
    }
    ret right
}

fn parameter_types_match(params: Vec[str], arguments: Vec[str]) -> bool {
    let mut index = 0_usize
    while index < params.len() {
        match params.get(index) {
            Option[str]::Some(param) => {
                match arguments.get(index) {
                    Option[str]::Some(argument) => {
                        if !semantic_types_compatible(param, argument) {
                            ret false
                        }
                    }
                    Option[str]::None => {
                        ret false
                    }
                }
            }
            Option[str]::None => {
                ret false
            }
        }
        index += 1_usize
    }
    ret true
}

fn semantic_call_placement(typ: str) -> str {
    if ends_with(typ, "<H>") {
        ret "<H>"
    }
    if ends_with(typ, "<S>") {
        ret "<S>"
    }
    if ends_with(typ, "&") {
        ret "&"
    }
    if ends_with(typ, "*") {
        ret "*"
    }
    ret ""
}

fn generic_argument_matches(expected: str, actual: str, names: Vec[str], bindings: mut Vec[(str, str)]) -> bool {
    let pattern = compact_type(semantic_type_name(expected))
    let argument = compact_type(semantic_type_name(actual))
    if pattern == "" || argument == "" || argument == "never" {
        ret true
    }
    if contains_name(names, pattern) {
        for entry in bindings {
            if entry.0 == pattern {
                ret compact_type(semantic_type_name(entry.1)) == argument
            }
        }
        bindings.push((pattern, argument))
        ret true
    }
    let placement = semantic_call_placement(pattern)
    let actual_placement = semantic_call_placement(argument)
    if placement != actual_placement && !(placement == "&" &&(actual_placement == "<H>" || actual_placement == "<S>")) {
        ret false
    }
    let payload = pattern.slice(0, pattern.len() - placement.len())
    let actual_payload = argument.slice(0, argument.len() - actual_placement.len())
    if contains_name(names, payload) {
        for entry in bindings {
            if entry.0 == payload {
                ret compact_type(semantic_type_name(entry.1)) == actual_payload
            }
        }
        bindings.push((payload, actual_payload))
        ret true
    }
    if (payload == "bool" && actual_payload == "u1") ||(payload == "u1" && actual_payload == "bool") {
        ret true
    }
    if semantic_root_type(payload) != semantic_root_type(actual_payload) {
        ret false
    }
    let mut ordinal = 0_usize
    loop {
        let child = nth_type_argument(payload, ordinal)
        let actual_child = nth_type_argument(actual_payload, ordinal)
        if child == "" && actual_child == "" {
            ret true
        }
        if child == "" || actual_child == "" || !generic_argument_matches(child, actual_child, names, bindings) {
            ret false
        }
        ordinal += 1
    }
}
fn bind_explicit_type_arguments(ctx: SemanticContext, names: Vec[str], arguments: Vec[str],
    bindings: mut Vec[(str, str)],) -> bool {
    if arguments.len() == 0_usize {
        ret true
    }
    if arguments.len() != names.len() {
        ret false
    }
    let mut index = 0_usize
    for name in names {
        bindings.push((name, local_type(ctx, arguments.get(index).unwrap_or(""))))
        index += 1_usize
    }
    ret true
}
fn generic_call_matches(params: Vec[str], arguments: Vec[str], expressions: Vec[ExprNode],
    names: Vec[str], bindings: mut Vec[(str, str)],) -> bool {
    if params.len() != arguments.len() {
        ret false
    }
    for position in 0..params.len() {
        let param = params.get(position).unwrap_or("")
        let argument = arguments.get(position).unwrap_or("")
        if !generic_argument_matches(param, argument, names, bindings) {
            let concrete = substitute_type_bindings(param, bindings)
            match expressions.get(position) {
                Some(expression) => {
                    match expression.value {
                        Expr::Integer(value) => {
                            if contains(value, "_") || !integer_semantic_type(concrete) || !integer_literal_fits(value, concrete) {
                                ret false
                            }
                        }
                        _ => {
                            ret false
                        }
                    }
                }
                None => {
                    ret false
                }
            }
        }
    }
    ret true
}

fn parameter_types_match_contextual(params: Vec[str], arguments: Vec[str],
    expressions: Vec[ExprNode],) -> bool {
    let mut index = 0_usize
    while index < params.len() {
        let param = params.get(index).unwrap_or("")
        let argument = arguments.get(index).unwrap_or("")
        let expression = match expressions.get(index) {
            Option::Some(value) => {
                value
            }
            Option::None => {
                ret false
            }
        }
        let expected = compact_type(semantic_type_name(param))
        let actual = compact_type(semantic_type_name(argument))
        let compatible = if numeric_semantic_type(expected) && numeric_semantic_type(actual) {
            expected == actual
        } else {
            semantic_types_compatible(param, argument)
        }
        if !compatible && !contextual_numeric_literal_matches(expression, expected) {
            ret false
        }
        index += 1_usize
    }
    ret true
}

fn contextual_numeric_literal_matches(expression: ExprNode, expected: str) -> bool {
    ret contextual_numeric_value_matches(expression.value, expected)
}

fn contextual_numeric_value_matches(expression: Expr, expected: str) -> bool {
    let floating = expected == "f32" || expected == "f64"
    match expression {
        Expr::Integer(value) => {
            ret !contains(value, "_") &&(floating ||(integer_semantic_type(expected) && integer_literal_fits(value, expected)))
        }
        Expr::Float(value) => {
            ret !contains(value, "_") && floating
        }
        Expr::Parenthesized(inner) => {
            ret contextual_numeric_value_matches(inner.value, expected)
        }
        Expr::Binary(binary) => {
            if binary.operator == "+" || binary.operator == "-" || binary.operator == "*" ||
            binary.operator == "/" || binary.operator == "%" {
                ret contextual_numeric_value_matches(binary.lhs.value, expected) &&
                contextual_numeric_value_matches(binary.rhs.value, expected)
            }
        }
        Expr::Unary(unary) => {
            if unary.operator != "-" && unary.operator != "+" {
                ret false
            }
            match unary.expr.value {
                Expr::Integer(value) => {
                    ret !contains(value, "_") &&(floating ||(integer_semantic_type(expected) &&
                            (if unary.operator == "-" {
                                    negative_integer_literal_fits(value, expected)
                                } else {
                                    integer_literal_fits(value, expected)
                                }
                            )))
                }
                Expr::Float(value) => {
                    ret !contains(value, "_") && floating
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    ret false
}

fn negative_integer_literal_fits(value: str, typ: str) -> bool {
    if starts_with(typ, "u") {
        ret false
    }
    if integer_literal_fits(value, typ) {
        ret true
    }
    let minimum_magnitude = match typ {
        "i8" => "128" "i16" => "32768" "i32" => "2147483648"
        "i64" => "9223372036854775808" "isize" => "9223372036854775808"
        "i128" => "170141183460469231731687303715884105728" _ => ""
    }
    ret minimum_magnitude != "" && trim_leading_numeric_zeroes(semantic_numeric_literal_value(value)) == minimum_magnitude
}

fn contextual_integer_out_of_range(params: Vec[str], expressions: Vec[ExprNode]) -> bool {
    let mut index = 0_usize
    while index < params.len() && index < expressions.len() {
        let param = params.get(index).unwrap_or("")
        match expressions.get(index) {
            Option::Some(expression) => {
                match expression.value {
                    Expr::Integer(value) => {
                        if !contains(value, "_") && integer_semantic_type(param) &&
                        !integer_literal_fits(value, param) {
                            ret true
                        }
                    }
                    Expr::Unary(unary) => {
                        if unary.operator == "-" {
                            match unary.expr.value {
                                Expr::Integer(value) => {
                                    if !contains(value, "_") && integer_semantic_type(param) && !negative_integer_literal_fits(value, param) {
                                        ret true
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            Option::None => {
            }
        }
        index += 1_usize
    }
    ret false
}

fn integer_semantic_type(typ: str) -> bool {
    ret typ == "u8" || typ == "u16" || typ == "u32" || typ == "u64" ||
    typ == "u128" || typ == "usize" || typ == "i8" || typ == "i16" ||
    typ == "i32" || typ == "i64" || typ == "i128" || typ == "isize"
}

fn integer_literal_fits(value: str, typ: str) -> bool {
    let decimal = semantic_numeric_literal_value(value)
    let maximum = if typ == "u8" {
        "255"
    } else {
        if typ == "u16" {
            "65535"
        } else {
            if typ == "u32" {
                "4294967295"
            } else {
                if typ == "u64" || typ == "usize" {
                    "18446744073709551615"
                } else {
                    if typ == "u128" {
                        "340282366920938463463374607431768211455"
                    } else {
                        if typ == "i8" {
                            "127"
                        } else {
                            if typ == "i16" {
                                "32767"
                            } else {
                                if typ == "i32" {
                                    "2147483647"
                                } else {
                                    if typ == "i64" || typ == "isize" {
                                        "9223372036854775807"
                                    } else {
                                        if typ == "i128" {
                                            "170141183460469231731687303715884105727"
                                        } else {
                                            ""
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if maximum == "" {
        ret false
    }
    let normalized = trim_leading_numeric_zeroes(decimal)
    if normalized.len() != maximum.len() {
        ret normalized.len() < maximum.len()
    }
    let mut index = 0_usize
    while index < normalized.len() {
        let actual = normalized.byte_at(index)
        let limit = maximum.byte_at(index)
        if actual < limit {
            ret true
        }
        if actual > limit {
            ret false
        }
        index += 1_usize
    }
    ret true
}

fn semantic_numeric_literal_value(value: str) -> str {
    let mut end = value.len()
    let mut index = 0_usize
    while index < value.len() {
        if value.slice(index, 1_usize) == "_" {
            end = index break
        }
        index += 1_usize
    }
    let raw = value.slice(0_usize, end)
    if raw.len() < 3_usize || raw.slice(0_usize, 1_usize) != "0" {
        ret raw
    }
    let prefix = raw.slice(1_usize, 1_usize)
    let base = if prefix == "x" || prefix == "X" {
        16_u32
    } else {
        if prefix == "b" || prefix == "B" {
            2_u32
        } else {
            if prefix == "o" || prefix == "O" {
                8_u32
            } else {
                0_u32
            }
        }
    }
    if base == 0_u32 {
        ret raw
    }
    let mut decimal = "0"
    index = 2_usize
    while index < raw.len() {
        decimal = semantic_decimal_multiply_add(decimal, base,
            semantic_radix_digit(raw.slice(index, 1_usize)),)
        index += 1_usize
    }
    ret decimal
}

fn semantic_radix_digit(value: str) -> u32 {
    if value.len() != 1_usize {
        ret 0_u32
    }
    let code = value.byte_at(0_usize)
    if code >= 48_u8 && code <= 57_u8 {
        ret(code - 48_u8) as u32
    }
    if code >= 65_u8 && code <= 70_u8 {
        ret(code - 65_u8) as u32 + 10_u32
    }
    if code >= 97_u8 && code <= 102_u8 {
        ret(code - 97_u8) as u32 + 10_u32
    }
    ret 0_u32
}

fn semantic_decimal_multiply_add(value: str, multiplier: u32, addition: u32) -> str {
    let mut reversed = ""
    let mut carry = addition
    let mut index = value.len()
    while index > 0_usize {
        index -= 1_usize
        let digit =(value.byte_at(index) - 48_u8) as u32
        let product = digit * multiplier + carry
        reversed += Debug::fmt(product % 10_u32)
        carry = product / 10_u32
    }
    while carry > 0_u32 {
        reversed += Debug::fmt(carry % 10_u32)
        carry = carry / 10_u32
    }
    let mut out = ""
    index = reversed.len()
    while index > 0_usize {
        index -= 1_usize
        out += reversed.slice(index, 1_usize)
    }
    ret out
}

fn trim_leading_numeric_zeroes(value: str) -> str {
    let mut start = 0_usize
    while start + 1_usize < value.len() && value.slice(start, 1_usize) == "0" {
        start += 1_usize
    }
    ret value.slice(start, value.len() - start)
}

fn generic_placeholder(value: str) -> bool {
    if value.len() != 1_usize {
        ret false
    }
    let byte = value.byte_at(0_usize)
    ret byte >= 65_u8 && byte <= 90_u8
}

fn expression_is_flexible_numeric(expr: ExprNode) -> bool {
    match expr.value {
        Expr::Integer(value) => {
            ret !contains(value, "_")
        }
        Expr::Float(value) => {
            ret !contains(value, "_")
        }
        _ => {
        }
    }
    ret false
}

fn contains(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn remember_dependency(ctx: mut SemanticContext, callable: SemanticCallable) ->() {
    if callable.lookup_module != "" {
        let mut recorded = false
        for dependency in ctx.dependencies {
            if dependency.kind == SemanticDependencyKind::FunctionBinding
            && dependency.module_name == callable.lookup_module && dependency.name == callable.name {
                recorded = true
            }
        }
        if !recorded {
            ctx.dependencies.push(SemanticDependency {
                    callable.lookup_module, callable.name,
                    callable.binding_identity, SemanticDependencyKind::FunctionBinding
                }
                ,)
        }
    }
    for dependency in ctx.dependencies {
        if dependency.kind == SemanticDependencyKind::Function && dependency.module_name == callable.module_name && dependency.name == callable.declaration_name {
            ret()
        }
    }
    ctx.dependencies.push(SemanticDependency {
            callable.module_name, callable.declaration_name, callable.signature, SemanticDependencyKind::Function
        }
        ,
    )
    ret()
}

fn unary_result_type(operator: str, inner: str, operand: ExprNode<H>) -> str {
    if operator == "!" {
        ret "bool"
    }
    if operator == "-" {
        match operand.value {
            Expr::Integer(value) => {
                if !contains(value, "_") {
                    ret "isize"
                }
            }
            _ => {
            }
        }
    }
    ret inner
}

fn integer_type(value: str) -> str {
    if ends_with(value, "_f32") {
        ret "f32"
    }
    if ends_with(value, "_f64") {
        ret "f64"
    }
    if ends_with(value, "_u8") {
        ret "u8"
    }
    if ends_with(value, "_u16") {
        ret "u16"
    }
    if ends_with(value, "_u32") {
        ret "u32"
    }
    if ends_with(value, "_u64") {
        ret "u64"
    }
    if ends_with(value, "_u128") {
        ret "u128"
    }
    if ends_with(value, "_usize") {
        ret "usize"
    }
    if ends_with(value, "_i8") {
        ret "i8"
    }
    if ends_with(value, "_i16") {
        ret "i16"
    }
    if ends_with(value, "_i32") {
        ret "i32"
    }
    if ends_with(value, "_i64") {
        ret "i64"
    }
    if ends_with(value, "_i128") {
        ret "i128"
    }
    if ends_with(value, "_isize") {
        ret "isize"
    }
    ret "usize"
}

fn float_type(value: str) -> str {
    if ends_with(value, "_f32") {
        ret "f32"
    }
    ret "f64"
}

fn ends_with(value: str, suffix: str) -> bool {
    ret suffix.len() <= value.len() && value.slice(value.len() - suffix.len(), suffix.len()) == suffix
}

fn nonzero_hash(value: str) -> u64 {
    let hashed = value.hash()
    if hashed == 0_u64 {
        ret 1_u64
    }
    ret hashed
}

fn checkpoint_string(value: Json) -> Result[str, str] {
    ret match value {
        Json::String(text) => Result::Ok(text) _ => Result::Err("invalid semantic string")
    }
}
fn checkpoint_array(value: Json) -> Result[Vec[Json], str] {
    ret match value {
        Json::Array(items) => Result::Ok(items) _ => Result::Err("invalid semantic array")
    }
}
fn checkpoint_record(value: Json, size: usize) -> Result[Vec[Json], str] {
    let items = checkpoint_array(value)?
    if items.len() != size {
        ret Result::Err("invalid semantic record")
    }
    ret Result::Ok(items)
}
fn checkpoint_integer(value: u64) -> Json {
    ret Json::String(Debug::fmt(value))
}
fn checkpoint_number(value: Json) -> Result[u64, str] {
    let text = checkpoint_string(value)?
    if text.is_empty() || text.byte_len() > 20_usize {
        ret Result::Err("invalid semantic integer")
    }
    let mut result = 0_u64
    for i in 0_usize..text.byte_len() {
        let byte = text.byte_at(i)
        if byte < 48_u8 || byte > 57_u8 {
            ret Result::Err("invalid semantic integer")
        }
        let digit =(byte - 48_u8) as u64
        if result >(18446744073709551615_u64 - digit) / 10_u64 {
            ret Result::Err("semantic integer overflow")
        }
        result = result * 10_u64 + digit
    }
    ret Result::Ok(result)
}
fn checkpoint_position(value: Json) -> Result[usize, str] {
    let result = checkpoint_number(value)?
    if result > 4294967295_u64 {
        ret Result::Err("invalid semantic position")
    }
    ret Result::Ok(result as usize)
}
fn checkpoint_strings(values: Vec[str]) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        out.push(Json::String(value))
    }
    ret Json::Array(out)
}
fn checkpoint_read_strings(value: Json) -> Result[Vec[str], str] {
    let mut out = Vec[str]::new()
    for item in checkpoint_array(value)? {
        out.push(checkpoint_string(item)?)
    }
    ret Result::Ok(out)
}
fn checkpoint_read_bool(value: Json) -> Result[bool, str] {
    ret match value {
        Json::Bool(flag) => Result::Ok(flag) _ => Result::Err("invalid semantic boolean")
    }
}
fn checkpoint_dependency_kind(kind: SemanticDependencyKind) -> str {
    ret match kind {
        SemanticDependencyKind::Function => "function"
        SemanticDependencyKind::FunctionBinding => "binding"
        SemanticDependencyKind::TypeScope => "type"
        SemanticDependencyKind::Method => "method"
        SemanticDependencyKind::Field => "field"
        SemanticDependencyKind::LookupScope => "lookup"
    }
}

pub fn semantic_checkpoint_dependencies(value: Json) -> Result[Vec[SemanticDependency], str] {
    let row = checkpoint_record(value, 11_usize)?
    let mut dependencies = Vec[SemanticDependency]::new()
    for value in checkpoint_array(row.get(8).unwrap_or(Json::Null))? {
        let entry = checkpoint_record(value, 4_usize)?
        dependencies.push(SemanticDependency {
                checkpoint_string(entry.get(0).unwrap_or(Json::Null))?,
                checkpoint_string(entry.get(1).unwrap_or(Json::Null))?, checkpoint_number(entry.get(2).unwrap_or(Json::Null))?,
                checkpoint_read_kind(entry.get(3).unwrap_or(Json::Null))?
            }
        )
    }
    ret Result::Ok(dependencies)
}
fn checkpoint_read_kind(value: Json) -> Result[SemanticDependencyKind, str] {
    ret match checkpoint_string(value)? {
        "function" => Result::Ok(SemanticDependencyKind::Function)
        "binding" => Result::Ok(SemanticDependencyKind::FunctionBinding)
        "type" => Result::Ok(SemanticDependencyKind::TypeScope)
        "method" => Result::Ok(SemanticDependencyKind::Method)
        "field" => Result::Ok(SemanticDependencyKind::Field)
        "lookup" => Result::Ok(SemanticDependencyKind::LookupScope)
        _ => Result::Err("invalid semantic dependency")
    }
}
fn checkpoint_binding(value: SemanticBinding) -> Json {
    ret Json::Array(vec![Json::String(value.name), Json::String(value.typ), checkpoint_integer(value.line as u64), checkpoint_integer(value.column as u64)])
}
struct SemanticCheckpointRelocation {
    old_line: usize,
    old_column: usize,
    line: usize,
    column: usize
}
fn checkpoint_site(line: Json, column: Json, relocation: SemanticCheckpointRelocation) -> Result[(usize, usize), str] {
    let old_line = checkpoint_position(line)?
    let old_column = checkpoint_position(column)?
    if old_line < relocation.old_line {
        ret Result::Err("semantic position precedes owner")
    }
    let new_line = old_line - relocation.old_line + relocation.line
    let new_column = if old_line == relocation.old_line {
        if old_column < relocation.old_column {
            ret Result::Err("semantic column precedes owner")
        }
        old_column - relocation.old_column + relocation.column
    } else {
        old_column
    }
    ret Result::Ok((new_line, new_column))
}
fn checkpoint_read_binding(value: Json, relocation: SemanticCheckpointRelocation) -> Result[SemanticBinding, str] {
    let row = checkpoint_record(value, 4_usize)?
    let point = checkpoint_site(row.get(2).unwrap_or(Json::Null), row.get(3).unwrap_or(Json::Null), relocation)?
    ret Result::Ok(SemanticBinding {
            checkpoint_string(row.get(0).unwrap_or(Json::Null))?, checkpoint_string(row.get(1).unwrap_or(Json::Null))?, point.0, point.1
        }
    )
}
fn checkpoint_method(value: SemanticMethod) -> Json {
    ret Json::Array(vec![Json::String(value.module_name), Json::String(value.receiver_type), Json::String(value.name),
            checkpoint_strings(value.params), Json::String(value.ret_type), checkpoint_integer(value.signature), Json::String(value.declaration_receiver),
            checkpoint_strings(value.generic_names), Json::Bool(value.is_static), Json::Bool(value.is_public), checkpoint_strings(value.method_generic_names)])
}
fn checkpoint_read_method(value: Json) -> Result[SemanticMethod, str] {
    let row = checkpoint_record(value, 11_usize)?
    ret Result::Ok(SemanticMethod {
            checkpoint_string(row.get(0).unwrap_or(Json::Null))?, checkpoint_string(row.get(1).unwrap_or(Json::Null))?,
            checkpoint_string(row.get(2).unwrap_or(Json::Null))?, checkpoint_read_strings(row.get(3).unwrap_or(Json::Null))?,
            checkpoint_string(row.get(4).unwrap_or(Json::Null))?, checkpoint_number(row.get(5).unwrap_or(Json::Null))?,
            checkpoint_string(row.get(6).unwrap_or(Json::Null))?, checkpoint_read_strings(row.get(7).unwrap_or(Json::Null))?,
            checkpoint_read_bool(row.get(8).unwrap_or(Json::Null))?, checkpoint_read_bool(row.get(9).unwrap_or(Json::Null))?,
            checkpoint_read_strings(row.get(10).unwrap_or(Json::Null))?
        }
    )
}

pub fn encode_semantic_checkpoint(body: SemanticBody, line: usize, column: usize) -> Json {
    let mut bindings = Vec[Json]::new()
    for value in body.bindings {
        bindings.push(checkpoint_binding(value))
    }
    let mut scoped = Vec[Json]::new()
    for value in body.scoped_bindings {
        scoped.push(Json::Array(vec![checkpoint_binding(value.binding), checkpoint_integer(value.scope.0 as u64), checkpoint_integer(value.scope.1 as u64),
                    checkpoint_integer(value.scope.2 as u64), checkpoint_integer(value.scope.3 as u64), checkpoint_integer(value.visible_line as u64), checkpoint_integer(value.visible_column as u64)]))
    }
    let mut receivers = Vec[Json]::new()
    for value in body.member_receivers {
        receivers.push(Json::Array(vec![checkpoint_integer(value.0 as u64), checkpoint_integer(value.1 as u64), Json::String(value.2)]))
    }
    let mut implicit = Vec[Json]::new()
    for value in body.implicit_receivers {
        implicit.push(Json::Array(vec![checkpoint_integer(value.0 as u64), checkpoint_integer(value.1 as u64), Json::String(value.2), Json::String(value.3)]))
    }
    let mut methods = Vec[Json]::new()
    for value in body.bound_methods {
        methods.push(checkpoint_method(value))
    }
    let mut dependencies = Vec[Json]::new()
    for value in body.dependencies {
        dependencies.push(Json::Array(vec![Json::String(value.module_name), Json::String(value.name), checkpoint_integer(value.signature), Json::String(checkpoint_dependency_kind(value.kind))]))
    }
    ret Json::Array(vec![Json::String("semantic-body-1"), checkpoint_integer(line as u64), checkpoint_integer(column as u64), Json::Array(bindings),
            Json::Array(scoped), Json::Array(receivers), Json::Array(implicit), Json::Array(methods), Json::Array(dependencies), Json::String(body.return_type), Json::String(body.access_owner)])
}

pub fn decode_semantic_checkpoint_view(value: Json, names: SemanticSlice[TypeNameBinding], line: usize, column: usize) -> Result[SemanticBody, str] {
    let row = checkpoint_record(value, 11_usize)?
    if checkpoint_string(row.get(0).unwrap_or(Json::Null))? != "semantic-body-1" {
        ret Result::Err("unknown semantic schema")
    }
    let relocation = SemanticCheckpointRelocation {
        checkpoint_position(row.get(1).unwrap_or(Json::Null))?, checkpoint_position(row.get(2).unwrap_or(Json::Null))?, line, column
    }
    let mut bindings = Vec[SemanticBinding]::new()
    for value in checkpoint_array(row.get(3).unwrap_or(Json::Null))? {
        bindings.push(checkpoint_read_binding(value, relocation)?)
    }
    let mut scoped = Vec[ScopedSemanticBinding]::new()
    for value in checkpoint_array(row.get(4).unwrap_or(Json::Null))? {
        let entry = checkpoint_record(value, 7_usize)?
        let start = checkpoint_site(entry.get(1).unwrap_or(Json::Null), entry.get(2).unwrap_or(Json::Null), relocation)?
        let end = checkpoint_site(entry.get(3).unwrap_or(Json::Null), entry.get(4).unwrap_or(Json::Null), relocation)?
        let visible = checkpoint_site(entry.get(5).unwrap_or(Json::Null), entry.get(6).unwrap_or(Json::Null), relocation)?
        scoped.push(ScopedSemanticBinding {
                checkpoint_read_binding(entry.get(0).unwrap_or(Json::Null), relocation)?,(start.0, start.1, end.0, end.1), visible.0, visible.1
            }
        )
    }
    let mut receivers = Vec[(usize, usize, str)]::new()
    for value in checkpoint_array(row.get(5).unwrap_or(Json::Null))? {
        let entry = checkpoint_record(value, 3_usize)?
        let point = checkpoint_site(entry.get(0).unwrap_or(Json::Null), entry.get(1).unwrap_or(Json::Null), relocation)?
        receivers.push((point.0, point.1, checkpoint_string(entry.get(2).unwrap_or(Json::Null))?))
    }
    let mut implicit = Vec[(usize, usize, str, str)]::new()
    for value in checkpoint_array(row.get(6).unwrap_or(Json::Null))? {
        let entry = checkpoint_record(value, 4_usize)?
        let point = checkpoint_site(entry.get(0).unwrap_or(Json::Null), entry.get(1).unwrap_or(Json::Null), relocation)?
        implicit.push((point.0, point.1, checkpoint_string(entry.get(2).unwrap_or(Json::Null))?, checkpoint_string(entry.get(3).unwrap_or(Json::Null))?))
    }
    let mut methods = Vec[SemanticMethod]::new()
    for value in checkpoint_array(row.get(7).unwrap_or(Json::Null))? {
        methods.push(checkpoint_read_method(value)?)
    }
    let mut dependencies = Vec[SemanticDependency]::new()
    for value in checkpoint_array(row.get(8).unwrap_or(Json::Null))? {
        let entry = checkpoint_record(value, 4_usize)?
        dependencies.push(SemanticDependency {
                checkpoint_string(entry.get(0).unwrap_or(Json::Null))?, checkpoint_string(entry.get(1).unwrap_or(Json::Null))?, checkpoint_number(entry.get(2).unwrap_or(Json::Null))?, checkpoint_read_kind(entry.get(3).unwrap_or(Json::Null))?
            }
        )
    }
    ret Result::Ok(SemanticBody {
            bindings, Vec[FrontendDiagnostic]::new(), dependencies, checkpoint_string(row.get(9).unwrap_or(Json::Null))?, scoped, receivers, methods, names, implicit, checkpoint_string(row.get(10).unwrap_or(Json::Null))?
        }
    )
}

// Source-compatible vector adapters for analysis and editor callers.
pub fn semantic_accessible_methods(methods: Vec[SemanticMethod], access_owner: str) -> Vec[SemanticMethod] {
    ret semantic_accessible_methods_view(SemanticSlice::from_vec(methods), access_owner)
}

pub fn semantic_members(receiver: str, fields: Vec[SemanticField], methods: Vec[SemanticMethod]) -> Vec[SemanticMember] {
    ret semantic_members_view(receiver, SemanticSlice::from_vec(fields), SemanticSlice::from_vec(methods))
}

pub fn semantic_named_members(receiver: str, name_filter: str, fields: Vec[SemanticField], methods: Vec[SemanticMethod]) -> Vec[SemanticMember] {
    ret semantic_named_members_view(receiver, name_filter, SemanticSlice::from_vec(fields), SemanticSlice::from_vec(methods))
}

pub fn semantic_associated_members(receiver: str, name: str, methods: Vec[SemanticMethod]) -> Vec[SemanticMember] {
    ret semantic_associated_members_view(receiver, name, SemanticSlice::from_vec(methods))
}

