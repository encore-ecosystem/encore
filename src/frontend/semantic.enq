//! Defines reusable, incremental semantic results for function-body queries.

import core::option::Option
import core::fmt::Debug
import std::dict::Hashable
import std::vec::Vec

import refrain::frontend::analysis::FrontendDiagnostic
import refrain::frontend::parser::{Expr, ExprNode, FunctionItem, MatchArmBody, Statement}
import refrain::target::{TargetSpec, cfg_active_with_features}

/// Records the inferred type of a local binding.
pub struct SemanticBinding {
    name: str
    typ: str
    line: usize
    column: usize
}

/// Identifies a declaration signature read while checking a body.
pub struct SemanticDependency {
    module_name: str
    name: str
    signature: u64
}

/// Describes one callable visible to a semantic body query.
pub struct SemanticCallable {
    module_name: str
    name: str
    params: Vec[str]
    ret_type: str
    signature: u64
}

/// Contains the reusable semantic facts and diagnostics of one function body.
pub struct SemanticBody {
    bindings: Vec[SemanticBinding]
    diagnostics: Vec[FrontendDiagnostic]
    dependencies: Vec[SemanticDependency]
    return_type: str
}

struct SemanticContext {
    callables: Vec[SemanticCallable]
    bindings: Vec[SemanticBinding]
    diagnostics: Vec[FrontendDiagnostic]
    dependencies: Vec[SemanticDependency]
}

impl for SemanticBody {
    /// Returns an empty result for callers handling a missing declaration.
    pub fn empty() -> Self {
        ret Self{Vec[SemanticBinding]::new(), Vec[FrontendDiagnostic]::new(), Vec[SemanticDependency]::new(), ""}
    }

    /// Returns the inferred or declared type of a local binding.
    pub fn binding_type(self: Self, name: str) -> Option[str] {
        for binding in self.bindings {
            if binding.name == name { ret Option[str]::Some(binding.typ) }
        }
        ret Option[str]::None
    }
}

impl for SemanticCallable {
    /// Creates a callable and its deterministic declaration fingerprint.
    pub fn new(module_name: str, name: str, params: Vec[str], ret_type: str) -> Self {
        let mut key = module_name + "#" + name + "("
        for param in params { key += param + "," }
        key += ")->" + ret_type
        ret Self{module_name, name, params, ret_type, nonzero_hash(key)}
    }
}

/// Checks one function body without performing EHIR lowering.
pub fn check_function_body(item: FunctionItem, callables: Vec[SemanticCallable]) -> SemanticBody {
    let mut ctx = SemanticContext{callables, Vec[SemanticBinding]::new(), Vec[FrontendDiagnostic]::new(), Vec[SemanticDependency]::new()}
    for param in item.params {
        match param.typ {
            Option[str]::Some(typ) => { ctx.bindings.push(SemanticBinding{param.name, semantic_type_name(typ), item.line, item.column}) }
            Option[str]::None => {}
        }
    }
    let return_type = item.ret_type.unwrap_or("void")
    match item.body {
        Option::Some(body) => {
            check_statements(ctx, body.statements, return_type)
        }
        Option::None => {}
    }
    ret SemanticBody{ctx.bindings, ctx.diagnostics, ctx.dependencies, return_type}
}

/// Checks every function body in a parsed module in one AST traversal.
/// This is the cold compiler path; individual editor queries remain cached by
/// stable symbol identity in the analysis database.
pub fn check_module_bodies(ast: Vec[Statement], callables: Vec[SemanticCallable]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => { out.extend(check_function_body(item, callables).diagnostics) }
            Statement::Trait(item) => {
                for method in item.methods { out.extend(check_function_body(method, callables).diagnostics) }
            }
            Statement::Impl(item) => {
                for method in item.methods { out.extend(check_function_body(method, callables).diagnostics) }
            }
            _ => {}
        }
    }
    ret out
}

/// Checks declaration invariants that depend on target and feature selection.
pub fn check_module_declarations(ast: Vec[Statement], target: TargetSpec, features: Vec[str]) -> Vec[FrontendDiagnostic] {
    let mut out = Vec[FrontendDiagnostic]::new()
    let mut names = Vec[str]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                if semantic_function_is_active(item, target, features) {
                    if contains_name(names, item.name) {
                        out.push(FrontendDiagnostic::new(1_usize, "duplicate-function", "duplicate function declaration '" + item.name + "'", item.line, item.column, item.name.len()))
                    } else {
                        names.push(item.name)
                    }
                }
            }
            _ => {}
        }
    }
    ret out
}

fn semantic_function_is_active(item: FunctionItem, target: TargetSpec, features: Vec[str]) -> bool {
    for attr in item.attrs {
        if contains_substring(attr, "test") { ret false }
        if starts_with(attr, "cfg:") {
            let expr = attr.slice(4_usize, attr.len() - 4_usize)
            if !cfg_active_with_features(target, expr, features) { ret false }
        }
    }
    ret true
}

fn contains_name(names: Vec[str], name: str) -> bool {
    for existing in names { if existing == name { ret true } }
    ret false
}

fn semantic_type_name(typ: str) -> str {
    if starts_with(typ, "mut ") { ret typ.slice(4_usize, typ.len() - 4_usize) }
    ret typ
}

fn semantic_types_compatible(expected: str, actual: str) -> bool {
    if expected == actual || expected == "Self" || actual == "Self" { ret true }
    if generic_placeholder(expected) || generic_placeholder(actual) { ret true }
    if generic_container_compatible(expected, actual) { ret true }
    ret false
}

fn generic_container_compatible(expected: str, actual: str) -> bool {
    let expected_base = type_base(expected)
    let actual_base = type_base(actual)
    if expected_base == "" || expected_base != actual_base { ret false }
    ret contains_generic_argument(expected) || contains_generic_argument(actual)
}

fn contains_generic_argument(typ: str) -> bool {
    let mut index = 0_usize
    while index < typ.len() {
        let byte = typ.byte_at(index)
        if byte >= 65_u8 && byte <= 90_u8 {
            let previous_ok = index > 0_usize && (typ.byte_at(index - 1_usize) == 91_u8 || typ.byte_at(index - 1_usize) == 44_u8 || typ.byte_at(index - 1_usize) == 32_u8)
            let next_ok = index + 1_usize >= typ.len() || typ.byte_at(index + 1_usize) == 44_u8 || typ.byte_at(index + 1_usize) == 93_u8 || typ.byte_at(index + 1_usize) == 32_u8
            if previous_ok && next_ok { ret true }
        }
        index += 1_usize
    }
    ret false
}

fn type_base(typ: str) -> str {
    let mut index = 0_usize
    while index < typ.len() {
        if typ.slice(index, 1_usize) == "[" { ret typ.slice(0_usize, index) }
        index += 1_usize
    }
    ret ""
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() { ret false }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn contains_substring(value: str, needle: str) -> bool {
    if needle.len() == 0_usize { ret true }
    if needle.len() > value.len() { ret false }
    let mut start = 0_usize
    while start + needle.len() <= value.len() {
        if value.slice(start, needle.len()) == needle { ret true }
        start += 1_usize
    }
    ret false
}

fn check_statements(
    ctx: mut SemanticContext,
    statements: Vec[Statement],
    return_type: str
) -> () {
    for statement in statements {
        match statement {
            Statement::Let(item) => {
                let flexible_numeric = expression_is_flexible_numeric(item.expr)
                let inferred = infer_expression(ctx, item.expr)
                let declared = item.typ.unwrap_or(inferred)
                if inferred != "" && !semantic_types_compatible(declared, inferred) && !flexible_numeric {
                    ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "type-mismatch", "cannot initialize '" + item.name + "' of type '" + declared + "' with value of type '" + inferred + "'", item.expr.line, item.expr.column, item.expr.length))
                }
                ctx.bindings.push(SemanticBinding{item.name, declared, item.expr.line, item.expr.column})
            }
            Statement::Ret(expr) => {
                let flexible_numeric = expression_is_flexible_numeric(expr)
                let actual = infer_expression(ctx, expr)
                if return_type != "" && return_type != "void" && actual != "" && !semantic_types_compatible(return_type, actual) && !flexible_numeric {
                    ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "return-type-mismatch", "expected return type '" + return_type + "', found '" + actual + "'", expr.line, expr.column, expr.length))
                }
            }
            Statement::Expr(expr) => { let _ignored = infer_expression(ctx, expr) }
            Statement::Assignment(item) => {
                let target = infer_expression(ctx, item.target)
                let actual = infer_expression(ctx, item.expr)
                if target != "" && actual != "" && !semantic_types_compatible(target, actual) && !expression_is_flexible_numeric(item.expr) {
                    ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "assignment-type-mismatch", "cannot assign value of type '" + actual + "' to target of type '" + target + "'", item.expr.line, item.expr.column, item.expr.length))
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    check_boolean_condition(ctx, branch.condition)
                    check_statements(ctx, branch.body.statements, return_type)
                }
                match item.else_body {
                    Option::Some(body) => { check_statements(ctx, body.statements, return_type) }
                    Option::None => {}
                }
            }
            Statement::Match(item) => {
                let _matched = infer_expression(ctx, item.expr)
                let outer_bindings = ctx.bindings
                for arm in item.arms {
                    replace_bindings(ctx, outer_bindings)
                    match arm.pattern.binding {
                        Option[str]::Some(name) => { ctx.bindings.push(SemanticBinding{name, "", item.expr.line, item.expr.column}) }
                        Option[str]::None => {}
                    }
                    match arm.body {
                        MatchArmBody::Block(body) => { check_statements(ctx, body.statements, return_type) }
                        MatchArmBody::Expr(expr) => { let _arm = infer_expression(ctx, expr) }
                    }
                }
                replace_bindings(ctx, outer_bindings)
            }
            Statement::While(item) => {
                check_boolean_condition(ctx, item.condition)
                check_statements(ctx, item.body.statements, return_type)
            }
            Statement::Loop(item) => { check_statements(ctx, item.body.statements, return_type) }
            Statement::DoWhile(item) => {
                check_statements(ctx, item.body.statements, return_type)
                check_boolean_condition(ctx, item.condition)
            }
            Statement::For(item) => {
                let _iterable = infer_expression(ctx, item.iterable)
                check_statements(ctx, item.body.statements, return_type)
            }
            Statement::With(item) => {
                let _resource = infer_expression(ctx, item.expr)
                check_statements(ctx, item.body.statements, return_type)
            }
            Statement::Unsafe(body) => { check_statements(ctx, body.statements, return_type) }
            _ => {}
        }
    }
    ret ()
}

/// Establishes the lexical binding snapshot used by the next semantic scope.
///
/// Keeping scope replacement as one operation also lets older bootstrap
/// compilers build the analysis foundation before they contain the backend fix
/// for repeated identical `setfield` instructions across basic blocks.
fn replace_bindings(ctx: mut SemanticContext, bindings: Vec[SemanticBinding]) -> () {
    ctx.bindings = bindings
}

fn check_boolean_condition(ctx: mut SemanticContext, expr: ExprNode) -> () {
    let actual = infer_expression(ctx, expr)
    if actual != "" && actual != "bool" {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "condition-type-mismatch", "condition must have type 'bool', found '" + actual + "'", expr.line, expr.column, expr.length))
    }
    ret ()
}

fn infer_expression(
    ctx: mut SemanticContext,
    expr: ExprNode
) -> str {
    let line = expr.line
    let column = expr.column
    let length = expr.length
    match expr.value {
        Expr::StringLiteral(value) => { let _ignored = value ret "str" }
        Expr::Boolean(value) => { let _ignored = value ret "bool" }
        Expr::Integer(value) => { ret integer_type(value) }
        Expr::Float(value) => { ret float_type(value) }
        Expr::Path(name) => {
            ret binding_type(ctx.bindings, name)
        }
        Expr::Parenthesized(inner) => { ret infer_expression_h(ctx, inner) }
        Expr::Cast(cast) => {
            let target = cast.target
            let _ignored = infer_expression_h(ctx, cast.expr)
            ret target
        }
        Expr::Binary(binary) => {
            let operator = binary.operator
            let lhs = infer_expression_h(ctx, binary.lhs)
            let rhs = infer_expression_h(ctx, binary.rhs)
            if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" || operator == "&&" || operator == "||" { ret "bool" }
            if lhs != "" { ret lhs }
            ret rhs
        }
        Expr::Call(call) => {
            let name = expression_path_h(call.callee)
            if name != "" {
                match resolve_call(ctx, name, call.args, line, column, length) {
                    Option[SemanticCallable]::Some(callable) => {
                        remember_dependency(ctx, callable)
                        ret callable.ret_type
                    }
                    Option[SemanticCallable]::None => {}
                }
            }
            ret ""
        }
        _ => { ret "" }
    }
    ret ""
}

fn infer_expression_h(ctx: mut SemanticContext, expr: ExprNode<H>) -> str {
    let line = expr.line
    let column = expr.column
    let length = expr.length
    match expr.value {
        Expr::StringLiteral(value) => { let _ignored = value ret "str" }
        Expr::Boolean(value) => { let _ignored = value ret "bool" }
        Expr::Integer(value) => { ret integer_type(value) }
        Expr::Float(value) => { ret float_type(value) }
        Expr::Path(name) => {
            ret binding_type(ctx.bindings, name)
        }
        Expr::Parenthesized(inner) => { ret infer_expression_h(ctx, inner) }
        Expr::Cast(cast) => {
            let target = cast.target
            let _ignored = infer_expression_h(ctx, cast.expr)
            ret target
        }
        Expr::Binary(binary) => {
            let operator = binary.operator
            let lhs = infer_expression_h(ctx, binary.lhs)
            let rhs = infer_expression_h(ctx, binary.rhs)
            if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" || operator == "&&" || operator == "||" { ret "bool" }
            if lhs != "" { ret lhs }
            ret rhs
        }
        Expr::Call(call) => {
            let name = expression_path_h(call.callee)
            if name != "" {
                match resolve_call(ctx, name, call.args, line, column, length) {
                    Option[SemanticCallable]::Some(callable) => {
                        remember_dependency(ctx, callable)
                        ret callable.ret_type
                    }
                    Option[SemanticCallable]::None => {}
                }
            }
            ret ""
        }
        _ => { ret "" }
    }
    ret ""
}

fn binding_type(bindings: Vec[SemanticBinding], name: str) -> str {
    let mut index = bindings.len()
    while index > 0_usize {
        index -= 1_usize
        match bindings.get(index) {
            Option[SemanticBinding]::Some(binding) => {
                if binding.name == name { ret binding.typ }
            }
            Option[SemanticBinding]::None => {}
        }
    }
    ret ""
}

fn expression_path_h(expr: ExprNode<H>) -> str {
    match expr.value {
        Expr::Path(name) => { ret name }
        Expr::Parenthesized(inner) => { ret expression_path_h(inner) }
        _ => {}
    }
    ret ""
}

fn resolve_call(ctx: mut SemanticContext, name: str, args: Vec[ExprNode], line: usize, column: usize, length: usize) -> Option[SemanticCallable] {
    let mut argument_types = Vec[str]::new()
    for argument in args { argument_types.push(infer_expression(ctx, argument)) }
    let mut saw_name = false
    let mut expected_arity = 0_usize
    for callable in ctx.callables {
        if callable.name == name {
            saw_name = true
            expected_arity = callable.params.len()
            if callable.params.len() == argument_types.len() && parameter_types_match(callable.params, argument_types) {
                ret Option[SemanticCallable]::Some(callable)
            }
        }
    }
    if saw_name && expected_arity != argument_types.len() {
        ctx.diagnostics.push(FrontendDiagnostic::new(1_usize, "arity-mismatch", "call to '" + name + "' expects " + Debug::fmt(expected_arity) + " argument(s), got " + Debug::fmt(argument_types.len()), line, column, length))
    }
    ret Option[SemanticCallable]::None
}

fn parameter_types_match(params: Vec[str], arguments: Vec[str]) -> bool {
    let mut index = 0_usize
    while index < params.len() {
        match params.get(index) {
            Option[str]::Some(param) => {
                match arguments.get(index) {
                    Option[str]::Some(argument) => {
                        if param != "" && argument != "" && param != argument && !generic_placeholder(param) { ret false }
                    }
                    Option[str]::None => { ret false }
                }
            }
            Option[str]::None => { ret false }
        }
        index += 1_usize
    }
    ret true
}

fn generic_placeholder(value: str) -> bool {
    if value.len() != 1_usize { ret false }
    let byte = value.byte_at(0_usize)
    ret byte >= 65_u8 && byte <= 90_u8
}

fn expression_is_flexible_numeric(expr: ExprNode) -> bool {
    match expr.value {
        Expr::Integer(value) => { ret !contains(value, "_") }
        Expr::Float(value) => { ret !contains(value, "_") }
        _ => {}
    }
    ret false
}

fn contains(value: str, needle: str) -> bool {
    if needle.len() == 0_usize { ret true }
    if needle.len() > value.len() { ret false }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle { ret true }
        index += 1_usize
    }
    ret false
}

fn remember_dependency(ctx: mut SemanticContext, callable: SemanticCallable) -> () {
    for dependency in ctx.dependencies {
        if dependency.module_name == callable.module_name && dependency.name == callable.name { ret () }
    }
    ctx.dependencies.push(SemanticDependency{callable.module_name, callable.name, callable.signature})
    ret ()
}

fn integer_type(value: str) -> str {
    if ends_with(value, "_f32") { ret "f32" }
    if ends_with(value, "_f64") { ret "f64" }
    if ends_with(value, "_u8") { ret "u8" }
    if ends_with(value, "_u16") { ret "u16" }
    if ends_with(value, "_u32") { ret "u32" }
    if ends_with(value, "_u64") { ret "u64" }
    if ends_with(value, "_u128") { ret "u128" }
    if ends_with(value, "_usize") { ret "usize" }
    if ends_with(value, "_i8") { ret "i8" }
    if ends_with(value, "_i16") { ret "i16" }
    if ends_with(value, "_i32") { ret "i32" }
    if ends_with(value, "_i64") { ret "i64" }
    if ends_with(value, "_i128") { ret "i128" }
    if ends_with(value, "_isize") { ret "isize" }
    ret "i32"
}

fn float_type(value: str) -> str {
    if ends_with(value, "_f32") { ret "f32" }
    ret "f64"
}

fn ends_with(value: str, suffix: str) -> bool {
    ret suffix.len() <= value.len() && value.slice(value.len() - suffix.len(), suffix.len()) == suffix
}

fn nonzero_hash(value: str) -> u64 {
    let hashed = value.hash()
    if hashed == 0_u64 { ret 1_u64 }
    ret hashed
}
