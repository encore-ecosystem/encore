    fields: Vec[SemanticField], methods: Vec[SemanticMethod], aggregate_names: Vec[str],
    type_scope: str, type_names: Vec[TypeNameBinding], variants: Vec[SemanticVariant],
    previous: Json, source: str,) -> CheckedModuleBodies {
    ret prepare_module_bodies_with_replay_view(ast, SemanticSlice::from_vec(callables), SemanticSlice::from_vec(fields), SemanticSlice::from_vec(methods), aggregate_names, type_scope, SemanticSlice::from_vec(type_names), SemanticSlice::from_vec(variants), previous, source)
}

pub fn append_bound_methods(methods: Vec[SemanticMethod], bound_methods: Vec[SemanticMethod]) -> Vec[SemanticMethod] {
    ret append_bound_methods_view(SemanticSlice::from_vec(methods), bound_methods).materialize()
}

pub fn decode_semantic_checkpoint(value: Json, names: Vec[TypeNameBinding], line: usize, column: usize) -> Result[SemanticBody, str] {
    ret decode_semantic_checkpoint_view(value, SemanticSlice::from_vec(names), line, column)
}
