    if !writer_enter(writer) {
        ret()
    }
    write_count(writer, value.len())
    for item in value {
        write_SemanticMethod(writer, item)
    }
    writer.depth -= 1_usize
}

fn read_Vec_SemanticMethod(reader: mut SnapshotReader) -> Result[Vec[SemanticMethod], str] {
    reader_enter(reader)?
    let count = read_count(reader, 256_usize)?
    let mut value = Vec[SemanticMethod]::with_capacity(count)
    for _index in 0_usize..count {
        value.push(read_SemanticMethod(reader)?)
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

