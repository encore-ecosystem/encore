pub fn encode_snapshot_SemanticIndexArtifact(value: SemanticIndexArtifact, identity: str) -> Result[Vec[u8], str] {
    let mut writer = new_snapshot_writer("ENQSI002", identity)
    write_SemanticIndexArtifact(writer, value)
    unsafe {
        encore_strmap_free(writer.strings)
    }
    if writer.failed {
        ret Result::Err("EHIR snapshot " + writer.failure + " limit (" + Debug::fmt(writer.bytes.len()) + " bytes)")
    }
    ret Result::Ok(writer.bytes)
}
pub fn decode_snapshot_SemanticIndexArtifact(bytes: Vec[u8], identity: str) -> Result[SemanticIndexArtifact, str] {
    let mut reader = new_snapshot_reader(bytes, "ENQSI002", identity)?
    let value = read_SemanticIndexArtifact(reader)?
    if reader.cursor != reader.bytes.len() {
        ret Result::Err("trailing EHIR snapshot bytes")
    }
    ret Result::Ok(value)
}
