// The first 0.3 prerelease is a source-compatible bootstrap built by 0.2.1.
// It parses and lowers capability syntax so it can build beta.1, but keeps the
// legacy permissive checks while rebuilding itself and the legacy system
// library graph. Beta.1 flips this single gate to true.
fn strict_thread_capabilities() -> bool {
    ret true
}

struct LoweredExpr {
    code: EhirTextBuilder
    value: str
    typ: str
}

// Call operands stay rooted while subsequent operands are evaluated. A
// borrowed-self call leaves that root with the caller; a value call transfers
// it to the callee. Both forms use the ordinary control-flow cleanup stack.
struct CallOwner {
    name: str
    value: str
    typ: str
    caller_owned: bool
}

fn track_call_owner(ctx: mut TranslatorContext, owners: mut Vec[CallOwner],
    value: str, typ: str, caller_owned: bool, prefix: str,) ->() {
    let ownership_type = if starts_with(typ, "mut ") {
        typ.slice(4_usize, typ.len() - 4_usize)
    } else {
        typ
    }
    if !ctx_type_needs_ownership(ctx, ownership_type) {
        ret()
    }
    let name = prefix + "_call_owner_" + Debug::fmt(owners.len())
    ctx_add_owned_var(ctx, name, value, typ)
    owners.push(CallOwner {
            name, value, typ, caller_owned
        }
        ,
    )
    ret()
}

fn finish_call_owners(ctx: mut TranslatorContext, code: EhirTextBuilder,
    owners: Vec[CallOwner], prefix: str, retain_inputs: bool,) -> EhirTextBuilder {
    let mut out = code
    let mut index = owners.len()
    while index > 0_usize {
        index -= 1_usize
        match owners.get(index) {
            Some(owner) => {
                if owner.caller_owned || retain_inputs {
                    if is_mutable_place_type(owner.typ) {
                        let typ = capability_value_type(owner.typ)
                        let loaded = prefix + "_call_cleanup_" + Debug::fmt(index)
                        out = out.instr(loaded + ": " + typ + " = load " + owner.value)
                        out = out.instr("drop " + loaded + ": " + typ)
                    } else {
                        out = out.instr("drop " + owner.value + ": " + capability_value_type(owner.typ))
                    }
                }
                untrack_call_owner(ctx, owner.name)
            }
            None => {
            }
        }
    }
    ret out
}

fn untrack_call_owner(ctx: mut TranslatorContext, name: str) ->() {
    // Normal calls unwind a suffix of the cleanup stack. Avoid rebuilding the
    // entire list for every argument; blocks with live local bindings still
    // use the general name-based removal path.
    if ctx.owned_vars.len() > 0_usize {
        match ctx.owned_vars.get(ctx.owned_vars.len() - 1_usize) {
            Some(owner) => {
                if owner.name == name {
                    ctx.owned_vars.pop()
                    ret()
                }
            }
            None => {
            }
        }
    }
    ctx_move_owned_var(ctx, name)
    ret()
}

// Normalize the trusted borrowed-return ABI at the call boundary. Outside
// this boundary every produced call result owns its contents, including when
// the receiver is about to be released. Consumers must not retain it again.
fn own_call_result(ctx: mut TranslatorContext, code: EhirTextBuilder,
    callee: str, value: str, typ: str,) -> EhirTextBuilder {
    if ctx_function_returns_borrowed(ctx, callee) && ctx_type_needs_ownership(ctx, typ) {
        ret code.instr("retain " + value + ": " + typ)
    }
    ret code
}

// A borrowed result may point into any input. Keep a caller root for inputs
// which an ordinary value callee consumes; native/borrowed-self calls already
// leave their input owners with the caller. Acquire these roots only after all
// operands are evaluated, so an earlier `?` uses the ordinary cleanup stack.
fn protect_call_result_inputs(ctx: mut TranslatorContext, code: EhirTextBuilder,
    owners: Vec[CallOwner], callee: str,) -> EhirTextBuilder {
    let mut out = code
    if ctx_function_returns_borrowed(ctx, callee) && !ctx_function_is_extern(ctx, callee) {
        for owner in owners {
            if !owner.caller_owned {
                out = out.instr("retain " + owner.value + ": " + owner.typ)
            }
        }
    }
    ret out
}

// A diverging operand already emitted cleanup on its outgoing edge. Remove
// only translation-time bookkeeping; emitting post-call drops would duplicate
// that cleanup on an unreachable continuation.
fn abandon_call_owners(ctx: mut TranslatorContext, owners: Vec[CallOwner]) ->() {
    let mut index = owners.len()
    while index > 0_usize {
        index -= 1_usize
        match owners.get(index) {
            Some(owner) => {
                untrack_call_owner(ctx, owner.name)
            }
            None => {
            }
        }
    }
    ret()
}

struct VisibilityModule {
    module_id: str
    imports: Vec[str]
}

fn translation_invariant_error(message: str) ->() {
    eprintln("error[translator-invariant]: " + message)
    exit(1_i32)
    ret()
}

fn translation_error_at(source_name: str, line: usize, column: usize, code: str, message: str) ->() {
    let location = if source_name == "" {
        ""
    } else {
        source_name + ":" + Debug::fmt(line + 1_usize) + ":" + Debug::fmt(column + 1_usize) + ": "
    }
    if unsafe {
        encore_translation_diagnostic_is_json()
    }
    {
        eprintln(
            "{\"path\":\"" + translation_json_escape(source_name)
            + "\",\"line\":" + Debug::fmt(line + 1_usize)
            + ",\"column\":" + Debug::fmt(column + 1_usize)
            + ",\"severity\":\"error\",\"code\":\"" + translation_json_escape(code)
            + "\",\"message\":\"" + translation_json_escape(message)
            + "\",\"labels\":[{\"path\":\"" + translation_json_escape(source_name)
            + "\",\"line\":" + Debug::fmt(line + 1_usize)
            + ",\"column\":" + Debug::fmt(column + 1_usize)
            + ",\"length\":1,\"kind\":\"primary\",\"message\":\"reported during complete semantic validation\"}]"
            + ",\"notes\":[\"reported by the lowering-time semantic validator\"],\"helps\":[],\"suggestions\":[]}"
        )
    } else {
        let interactive = unsafe {
            encore_terminal_is_tty(2_i32)
        }
        let mut rendered = translation_rich_location(location, interactive)
        + translation_rich_error("error[" + code + "]", interactive) + ": " + message
        if source_name != "" {
            let frame_title = "--> " + source_name + ":" + Debug::fmt(line + 1_usize) + ":" + Debug::fmt(column
                + 1_usize) + " (primary)"
            let mut frame_body = ""
            if file_exists(source_name) {
                let source_line = translation_source_line(read_file(source_name), line)
                frame_body = translation_rich_accent(Debug::fmt(line + 1_usize), interactive)
                + " " + translation_rich_muted("│", interactive) + " " + source_line
                + "\n  " + translation_rich_muted("│", interactive) + " "
                let mut spaces = column
                while spaces > 0_usize {
                    frame_body += " " spaces -= 1_usize
                }
                frame_body += translation_rich_error("^", interactive)
            } else {
                frame_body = translation_rich_muted("source text is unavailable", interactive)
            }
            rendered += "\n" + Panel::titled(translation_rich_accent(frame_title, interactive), frame_body).render()
            rendered += "\n  " + translation_rich_muted("= note:", interactive) + " reported by the complete lowering-time semantic validator"
        }
        eprintln(rendered)
    }
    exit(1_i32)
    ret()
}

fn translation_rich_location(value: str, interactive: bool) -> str {
    if interactive {
        ret muted(value)
    }
    ret value
}

fn translation_rich_error(value: str, interactive: bool) -> str {
    if interactive {
        ret error_text(value)
    }
    ret value
}

fn translation_rich_accent(value: str, interactive: bool) -> str {
    if interactive {
        ret accent(value)
    }
    ret value
}

fn translation_rich_muted(value: str, interactive: bool) -> str {
    if interactive {
        ret muted(value)
    }
    ret value
}

/// Selects the projection used by validation-only translation diagnostics.
pub fn set_translation_diagnostic_json(enabled: bool) ->() {
    unsafe {
        encore_translation_diagnostic_set_json(enabled)
    }
    ret()
}

fn translation_source_line(source: str, target: usize) -> str {
    let mut current = ""
    let mut line = 0_usize
    let mut index = 0_usize
    while index < source.len() {
        let ch = source.slice(index, 1_usize)
        if ch == "\n" {
            if line == target {
                ret current
            }
            current = ""
            line += 1_usize
        } elif ch != "\r" {
            current += ch
        }
        index += 1_usize
    }
    if line == target {
        ret current
    }
    ret ""
}

fn translation_json_escape(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out += "\\\\"
        } elif ch == "\"" {
            out += "\\\""
        } elif ch == "\n" {
            out += "\\n"
        } elif ch == "\r" {
            out += "\\r"
        } elif ch == "\t" {
            out += "\\t"
        } else {
            out += ch
        }
        index += 1_usize
    }
    ret out
}

struct VarType {
    name: str
    emitted_name: str
    typ: str
}

struct VariableRegion {
    name: str
    region: usize
}

// Name lookup is lexical; ownership and region connectivity are separate
// flow state. Preserve declarations overwritten by a block, without undoing
// writes through an outer mutable slot or rewinding emitted-value identities.
struct TranslationBindings {
    vars: Vec[VarType]
    variable_regions: Vec[VariableRegion]
    owned_vars: Vec[VarType]
    expression_hint: str
    moved_count: usize
}

struct MatchScopeExit {
    label: str
    moves: Vec[str]
}

struct FunctionType {
    name: str
    emitted_name: str
    source_name: str
    ret_type: str
    params: Vec[str]
    sending_params: Vec[bool]
    frozen_params: Vec[bool]
    readonly_self: bool
    has_receiver: bool
    generics: Vec[str]
    is_extern: bool
    is_async: bool
    output_type: str
    returns_sending: bool
    returns_frozen: bool
    is_static: bool
}

/// Supplies one resolved source module to EHIR translation.
pub struct TranslationModule {
    module_id: str
    source_name: str
    source: str
    documentation: Option[Documentation]
    imports: Vec[str]
    ast: Vec[Statement]
    features: Vec[str]
    work_weight: usize
}

impl for TranslationModule {
    /// Creates a translation module without module documentation.
    pub fn new(module_id: str, source_name: str, imports: Vec[str], ast: Vec[Statement], features: Vec[str])
    -> TranslationModule {
        let work_weight = ast.len()
        ret TranslationModule {
            module_id, source_name, "", Option[Documentation]::None, imports, ast, features, work_weight
        }
    }

    /// Creates a translation module with structured module documentation.
    pub fn new_documented(module_id: str, source_name: str, documentation: Option[Documentation], imports:
        Vec[str], ast: Vec[Statement], features: Vec[str],) -> TranslationModule {
        let work_weight = ast.len()
        ret TranslationModule {
            module_id, source_name, "", documentation, imports, ast, features, work_weight
        }
    }

    /// Overrides the scheduler estimate used by parallel workspace lowering.
    pub fn with_work_weight(self: mut Self, work_weight: usize) -> Self {
        self.work_weight = if work_weight == 0_usize {
            1_usize
        } else {
            work_weight
        }
        ret self
    }
}

struct TranslationModuleJob {
    index: usize
    weight: usize
}

/// One independently cacheable virtual EHIR module body.
pub struct TranslatedModuleChunk {
    index: usize
    text: str
}

impl for TranslatedModuleChunk {
    pub fn new(index: usize, text: str) -> Self {
        ret Self {
            index, text
        }
    }
    pub fn module_index(self: Self) -> usize {
        ret self.index
    }
    pub fn as_text(self: Self) -> str {
        ret self.text
    }
}

