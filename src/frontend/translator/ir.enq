//! Direct typed construction. Source type spellings are interned once per scope;
//! instruction syntax is never generated or parsed by these helpers.
import core::option::Option
import core::panic::panic
import core::result::Result
import std::vec::Vec
import ehirlib::*
import ehirlib::string_index::{StringIndex, string_index_get, string_index_set, string_index_with_capacity}

pub struct Operand { name: str, annotation: Option[str] }
pub fn reference(name: str) -> Operand { ret Operand { name, Option[str]::None } }
pub fn annotated(name: str, typ: str) -> Operand { ret Operand { name, Option[str]::Some(typ) } }

struct ScopeStorage {
    names: StringIndex
    values: Vec[Variable]
    type_names: StringIndex
    types: Vec[Type]
    exclusive: u8*
}
pub struct LoweringScope { storage: ScopeStorage<H> }
impl for LoweringScope {
    pub fn new(params: Vec[Parameter]) -> Self {
        let storage = ScopeStorage<H> { string_index_with_capacity(params.len()), Vec[Variable]::new(), string_index_with_capacity(16_usize), Vec[Type]::new(), lowering_scope_marker() }
        let scope = Self { storage }
        for parameter in params { scope.remember(var(parameter.name, parameter.typ)) }
        ret scope
    }
    #attr(safe)
    /// Type probes borrow known values but keep their temporary definitions local.
    pub fn fork(self: Self) -> Self {
        let mut parameters = Vec[Parameter]::with_capacity(self.storage.values.len())
        for value in self.storage.values { parameters.push(param(value.name, value.typ)) }
        ret Self::new(parameters)
    }
    pub fn typ(self: Self, spelling: str) -> Type {
        let address = lowering_scope_address(self.storage)
        unsafe { unsafe ehir { state: mut ScopeStorage = pcast address: ScopeStorage*, mut ScopeStorage }
        let position = string_index_get(state.type_names, spelling)
        if position != 0_usize { ret state.types.get_unchecked_borrowed(position - 1_usize) }
        let typ = parse_type_text(spelling)
        string_index_set(state.type_names, spelling, state.types.len())
        state.types.push(typ)
        ret typ

        }
    }
    #attr(safe)
    pub fn remember(self: Self, value: Variable) -> () {
        let address = lowering_scope_address(self.storage)
        unsafe { unsafe ehir { state: mut ScopeStorage = pcast address: ScopeStorage*, mut ScopeStorage }
        string_index_set(state.names, value.name, state.values.len())
        state.values.push(value)

            ret()

        }
    }
    pub fn output(self: Self, name: str, spelling: str) -> Variable {
        let value = var(name, self.typ(spelling))
        self.remember(value)
        ret value
    }
    #attr(safe)
    pub fn bind(self: Self, operand: Operand) -> Variable {
        let address = lowering_scope_address(self.storage)
        unsafe { unsafe ehir { state: mut ScopeStorage = pcast address: ScopeStorage*, mut ScopeStorage }
        match operand.annotation { Some(spelling) => { ret var(operand.name, self.typ(spelling)) } None => {} }
        let position = string_index_get(state.names, operand.name)
        if position != 0_usize { ret state.values.get_unchecked_borrowed(position - 1_usize) }
        if operand.name == "void" || operand.name == "()" { ret var("void", self.typ("()")) }
        panic("unbound direct EHIR operand: " + operand.name)
        ret var("void", self.typ("()"))

        }
    }
    #attr(safe)
    pub fn comparison(self: Self, operand: Operand, op: str) -> Variable {
        let address = lowering_scope_address(self.storage)
        unsafe { unsafe ehir { state: mut ScopeStorage = pcast address: ScopeStorage*, mut ScopeStorage }
        if (op == "ieq" || op == "neq") && operand.annotation.is_none() &&
            string_index_get(state.names, operand.name) == 0_usize && !operand.name.is_empty() &&
            operand.name.byte_at(0_usize) >= 65_u8 && operand.name.byte_at(0_usize) <= 90_u8 { ret enum_tag(operand.name) }
        ret self.bind(operand)

        }
    }
    pub fn operands(self: Self, values: Vec[Operand]) -> Vec[Variable] {
        let mut out = Vec[Variable]::with_capacity(values.len())
        for value in values { out.push(self.bind(value)) }
        ret out
    }
}

pub struct LoweringBuilder { scope: LoweringScope, buffer: IrBuilder }
impl for LoweringBuilder {
    pub fn new(scope: LoweringScope) -> Self { ret Self { scope, IrBuilder::new() } }
    pub fn from_items(scope: LoweringScope, items: Vec[IrItem]) -> Self { ret Self { scope, IrBuilder::from_items(items) } }
    pub fn finish_items(self: Self) -> Vec[IrItem] { ret self.buffer.finish_items() }
    pub fn append(self: Self, other: Self) -> Self {   ret Self { self.scope, self.buffer.append(other.buffer) } }
    pub fn empty_line(self: Self) -> Self { ret self }
    pub fn declaration(self: Self, item: Directive) -> Self {   ret Self { self.scope, self.buffer.declaration(item) } }
    pub fn documentation(self: Self, text: str) -> Self {   ret Self { self.scope, self.buffer.documentation(text) } }
    pub fn function_start(self: Self, signature: FnDirective) -> Self {   ret Self { self.scope, self.buffer.function_start(signature) } }
    pub fn function_end(self: Self) -> Self {   ret Self { self.scope, self.buffer.function_end() } }
    pub fn impl_start(self: Self, signature: ImplDirective) -> Self {   ret Self { self.scope, self.buffer.impl_start(signature) } }
    pub fn impl_end(self: Self) -> Self {   ret Self { self.scope, self.buffer.impl_end() } }
    pub fn label(self: Self, name: str) -> Self {   ret Self { self.scope, self.buffer.label(name) } }
    pub fn emit(self: Self, value: Instruction) -> Self {   ret Self { self.scope, self.buffer.emit(value) } }
    pub fn terminate(self: Self, value: Terminator) -> Self {   ret Self { self.scope, self.buffer.terminate(value) } }
    pub fn primitive(self: Self, out: str, typ: str, literal: str) -> Self {   ret self.emit(lcpos(self.scope.output(out, typ), literal)) }
    pub fn alias(self: Self, out: str, typ: str, source: Operand) -> Self {   ret self.emit(ehirlib::alias(self.scope.output(out, typ), self.scope.bind(source))) }
    pub fn load(self: Self, out: str, typ: str, source: Operand) -> Self {   ret self.emit(ehirlib::load(self.scope.output(out, typ), self.scope.bind(source))) }
    pub fn store(self: Self, source: Operand, destination: Operand) -> Self {   ret self.emit(ehirlib::store(self.scope.bind(source), self.scope.bind(destination))) }
    pub fn stack_alloc(self: Self, out: str, typ: str, allocated: str) -> Self {   ret self.emit(salloc(self.scope.output(out, typ), self.scope.typ(allocated))) }
    pub fn heap_realloc(self: Self, out: str, typ: str, source: Operand, count: Operand) -> Self {   ret self.emit(hrealloc(self.scope.output(out, typ), self.scope.bind(source), self.scope.bind(count))) }
    pub fn heap_free(self: Self, source: Operand) -> Self {   ret self.emit(hfree(self.scope.bind(source))) }
    pub fn cast(self: Self, out: str, typ: str, source: Operand, target: str) -> Self {   ret self.emit(pcast(self.scope.output(out, typ), self.scope.bind(source), self.scope.typ(target))) }
    pub fn get_field(self: Self, out: str, typ: str, source: Operand, selector: str) -> Self {   ret self.emit(getfield(self.scope.output(out, typ), self.scope.bind(source), field(selector))) }
    pub fn get_field_ptr(self: Self, out: str, typ: str, source: Operand, selector: str) -> Self {   ret self.emit(getfieldptr(self.scope.output(out, typ), self.scope.bind(source), field(selector))) }
    pub fn set_field(self: Self, source: Operand, selector: str, value: Operand) -> Self {   ret self.emit(setfield(self.scope.bind(source), field(selector), self.scope.bind(value))) }
    pub fn retain(self: Self, source: Operand) -> Self {   ret self.emit(retain_value(self.scope.bind(source))) }
    pub fn drop_value(self: Self, source: Operand) -> Self {   ret self.emit(ehirlib::drop_value(self.scope.bind(source))) }
    pub fn await_value(self: Self, out: str, typ: str, source: Operand) -> Self {   ret self.emit(ehirlib::await_value(self.scope.output(out, typ), self.scope.bind(source))) }
    pub fn call(self: Self, out: str, typ: str, target: str, arguments: Vec[Operand], is_unsafe: bool) -> Self {
        let callee = self.scope.typ(target)
        ret self.emit(ehirlib::call(self.scope.output(out, typ), callee.name, callee.generics, self.scope.operands(arguments), is_unsafe))
    }
    pub fn construct(self: Self, out: str, typ: str, target: str, arguments: Vec[Operand]) -> Self {
        ret self.emit(lcsos(self.scope.output(out, typ), self.scope.typ(target), self.scope.operands(arguments)))
    }
    pub fn enumeration(self: Self, out: str, typ: str, target: str, variant: str, payload: Option[Operand]) -> Self {
        let enumeration = self.scope.typ(target)
        let value = match payload { Some(value) => Option[Variable]::Some(self.scope.bind(value)) None => Option[Variable]::None }
        ret self.emit(lceos(self.scope.output(out, typ), enum_value(enumeration.name, enumeration.generics, variant, value)))
    }
    pub fn binary(self: Self, out: str, typ: str, op: str, lhs: Operand, rhs: Operand) -> Self {
        let kind = match op {
            "add" => BinaryOpKind::ADD "sub" => BinaryOpKind::SUB "mul" => BinaryOpKind::MUL "div" => BinaryOpKind::DIV
            "mod" => BinaryOpKind::MOD "shl" => BinaryOpKind::SHL "shr" => BinaryOpKind::SHR "les" => BinaryOpKind::LES
            "leq" => BinaryOpKind::LEQ "grt" => BinaryOpKind::GRT "geq" => BinaryOpKind::GEQ "ieq" => BinaryOpKind::IEQ
            "neq" => BinaryOpKind::NEQ "and" => BinaryOpKind::AND "or" => BinaryOpKind::OR "xor" => BinaryOpKind::XOR
            _ => { panic("invalid direct EHIR binary operation: " + op) BinaryOpKind::ADD }
        }
        ret self.emit(ehirlib::binary(self.scope.output(out, typ), self.scope.comparison(lhs, op), self.scope.comparison(rhs, op), kind))
    }
    pub fn branch(self: Self, label: str) -> Self {   ret self.terminate(br_term(label)) }
    pub fn conditional(self: Self, cond: Operand, yes: str, no: str) -> Self {   ret self.terminate(cbr_term(self.scope.bind(cond), yes, no)) }
    pub fn return_value(self: Self, value: Operand) -> Self {   ret self.terminate(ret_term(self.scope.bind(value))) }
    pub fn unreachable(self: Self) -> Self {   ret self.terminate(unreachable_term()) }
}

pub fn references(names: Vec[str]) -> Vec[Operand] {
    let mut out = Vec[Operand]::with_capacity(names.len())
    for name in names { out.push(reference(if name == "void: ()" { "void" } else { name })) }
    ret out
}
impl for LoweringBuilder {
    pub fn comment(self: Self, text: str) -> Self {   ret self.emit(ehirlib::comment(text)) }
    pub fn enumeration_values(self: Self, out: str, typ: str, target: str, variant: str, values: Vec[Operand]) -> Self {
        if values.len() > 1_usize { panic("enum payload must already be a single typed aggregate") }
        ret self.enumeration(out, typ, target, variant, values.get(0_usize))
    }
    pub fn match_value(self: Self, value: Operand, default_label: str, arms: Vec[MatchArm]) -> Self {
        ret self.terminate(match_term(self.scope.bind(value), default_label, arms))
    }
}

impl for LoweringBuilder {
    /// Parse an explicit source-language EHIR block in its current SSA scope.
    pub fn inline_text(self: Self, source: str) -> Self {
        let mut parameters = Vec[Parameter]::new()
        for value in self.scope.storage.values { parameters.push(param(value.name, value.typ)) }
        let mut known = SsaBindings { parameters, string_index_with_capacity(self.scope.storage.values.len()) }
        for index in 0_usize..known.values.len() { string_index_set(known.positions, known.values.get_unchecked_borrowed(index).name, index) }
        let items = match try_parse_inline_ir_items(source, known) {
            Result::Ok(value) => value
            Result::Err(message) => { panic(message) Vec[IrItem]::new() }
        }
        for item in items {
            match item {
                IrItem::Instruction(instruction) => { match instruction_result(instruction) { Some(value) => self.scope.remember(value) None => {} } }
                IrItem::Terminator(terminator) => { match terminator { Terminator::Match(value) => { for arm in value.arms { match arm.payload_var { Some(value) => self.scope.remember(value) None => {} } } } _ => {} } }
                _ => {}
            }
        }
        ret Self { self.scope, self.buffer.append(IrBuilder::from_items(items)) }
    }
}

impl for LoweringBuilder {
    /// Compatibility export for callers explicitly requesting textual EHIR.
    pub fn finish(self: Self) -> str {
        let module = match module_from_ir_items("", Vec[EhirImport]::new(), Option[str]::None, self.finish_items()) {
            Result::Ok(value) => value
            Result::Err(message) => { panic(message) make_module("", Vec[Directive]::new()) }
        }
        ret legacy_ir_text(module_to_string(module))
    }
}

/// Keep the historical opcode aliases in explicit frontend text exports.
/// Only the opcode following a line's first assignment is rewritten; literal
/// contents, comments and declaration names are preserved byte for byte.
pub fn legacy_ir_text(text: str) -> str {
    let mut builder = EhirTextBuilder::new()
    let mut start = 0_usize
    let mut line = 0_usize
    while line < text.byte_len() {
        let end = text.find_byte_from(10_u8, line)
        let mut first = line
        while first < end && (text.byte_at(first) == 32_u8 || text.byte_at(first) == 9_u8) { first += 1_usize }
        let assignment = text.find_byte_from(61_u8, line)
        if first < end && text.byte_at(first) != 47_u8 && text.byte_at(first) != 59_u8 && assignment < end {
            let mut replacement = ""
            if text.range_eq(assignment, 8_usize, "= lcpos ") { replacement = "= capprim " }
            elif text.range_eq(assignment, 8_usize, "= lcsos ") { replacement = "= capstruct " }
            elif text.range_eq(assignment, 8_usize, "= lceos ") { replacement = "= capenum " }
            if !replacement.is_empty() {
                builder = builder.append_str(text.slice_bytes(start, assignment - start)).append_str(replacement)
                start = assignment + 8_usize
            }
        }
        line = if end < text.byte_len() { end + 1_usize } else { end }
    }
    ret builder.append_str(text.slice_bytes(start, text.byte_len() - start)).finish()
}

#attr(safe)
fn lowering_scope_marker() -> u8* {
    unsafe { unsafe ehir { zero: usize = capprim 0_usize
        pointer: u8* = pcast zero: usize, u8* } ret pointer }
}
#attr(safe)
#attr(borrowed_return)
fn lowering_scope_address(storage: ScopeStorage<H>) -> ScopeStorage* {
    // The first field has offset zero; the owner's graph root remains alive.
    unsafe { unsafe ehir {
        first: StringIndex* = getfieldptr storage > names
        address: ScopeStorage* = pcast first: StringIndex*, ScopeStorage*
    } ret address }
}
