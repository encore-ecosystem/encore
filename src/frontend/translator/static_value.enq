//! Typed process-lifetime storage behind a source-level static accessor.
import core::option::Option
import std::vec::Vec

import ehirlib::*

import mod::ir::{LoweringBuilder, LoweringScope, Operand, annotated, reference}

fn external(name: str, parameters: Vec[Parameter], result: str) -> Directive {
    ret Directive::Function(FnDirective {
            name, Vec[Type]::new(), parameters, parse_type_text(result), Vec[Block]::new(), true, false
        }
    )
}
fn parameter(name: str, typ: str) -> Parameter {
    ret param(name, parse_type_text(typ))
}
fn signature(name: str, parameters: Vec[Parameter], result: str) -> FnDirective {
    ret FnDirective {
        name, Vec[Type]::new(), parameters, parse_type_text(result), Vec[Block]::new(), false, false
    }
}
pub fn static_runtime_declarations() -> LoweringBuilder {
    ret LoweringBuilder::new(LoweringScope::new(Vec[Parameter]::new()))
    .declaration(external("encore_static_cell_get", vec![parameter("key", "str")], "u8*"))
    .declaration(external("encore_static_begin", vec![parameter("cell", "u8*")], "bool"))
    .declaration(external("encore_static_publish", vec![parameter("cell", "u8*"), parameter("value", "usize")], "()"))
    .declaration(external("encore_static_publish_owned", vec![parameter("cell", "u8*"), parameter("value", "usize"), parameter("drop", "usize")], "()"))
    .declaration(external("encore_static_value", vec![parameter("cell", "u8*")], "usize"))
}
pub fn static_accessor(name: str, initializer: str, typ: str, owns_value: bool) -> LoweringBuilder {
    let unit = typ == "()" || typ == "void"
    let mut code = LoweringBuilder::new(LoweringScope::new(Vec[Parameter]::new()))
    .function_start(signature(name, Vec[Parameter]::new(), typ)).label("entry")
    .primitive("static_key", "str", "\"encore-static-1:" + name + "\"_str")
    .call("static_cell", "u8*", "encore_static_cell_get", vec![reference("static_key")], false)
    .drop_value(reference("static_key"))
    .call("static_initialize", "bool", "encore_static_begin", vec![reference("static_cell")], false)
    .conditional(reference("static_initialize"), "initialize", "ready").label("initialize")
    .call("static_initial", typ, initializer, Vec[Operand]::new(), false)
    .primitive("static_zero", "usize", "0_usize")
    if unit {
        code = code.call("static_published", "()", "encore_static_publish", vec![reference("static_cell"), reference("static_zero")], false)
    } else {
        let address_type = typ + "*"
        code = code.cast("static_null", address_type, reference("static_zero"), address_type)
        .primitive("static_one", "usize", "1_usize")
        .heap_realloc("static_storage", address_type, reference("static_null"), reference("static_one"))
        .store(reference("static_initial"), reference("static_storage"))
        if owns_value {
            code = code.drop_value(reference("static_initial"))
        }
        code = code.cast("static_address", "usize", reference("static_storage"), "usize")
        .call("static_drop", "usize", "__ehir_function_address__" + name + "_static_drop[void,usize]", Vec[Operand]::new(), false)
        .call("static_published", "()", "encore_static_publish_owned", vec![reference("static_cell"), reference("static_address"), reference("static_drop")], false)
    }
    code = code.branch("ready").label("ready")
    if unit {
        code = code.return_value(annotated("void", "()"))
    } else {
        code = code.call("static_address_ready", "usize", "encore_static_value", vec![reference("static_cell")], false)
        .cast("static_storage_ready", typ + "*", reference("static_address_ready"), typ + "*")
        .load("static_result", typ, reference("static_storage_ready"))
        if owns_value {
            code = code.retain(reference("static_result"))
        }
        code = code.return_value(reference("static_result"))
    }
    code = code.function_end()
    if !unit {
        let parameters = vec![parameter("address", "usize")]
        let mut destructor = LoweringBuilder::new(LoweringScope::new(parameters))
        .function_start(signature(name + "_static_drop", parameters, "()")).label("entry")
        .cast("storage", typ + "*", reference("address"), typ + "*")
        if owns_value {
            destructor = destructor.load("value", typ, reference("storage")).drop_value(reference("value"))
        }
        destructor = destructor.heap_free(reference("storage")).return_value(annotated("void", "()")).function_end()
        code = code.append(destructor)
    }
    ret code
}
