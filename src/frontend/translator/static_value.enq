//! Typed process-lifetime storage behind a source-level static accessor.
import ehirlib::EhirTextBuilder

pub fn static_runtime_declarations() -> EhirTextBuilder {
    ret EhirTextBuilder::new()
    .line("extern fn encore_static_cell_get(key: str) -> u8*")
    .line("extern fn encore_static_begin(cell: u8*) -> bool")
    .line("extern fn encore_static_publish(cell: u8*, value: usize) -> ()")
    .line("extern fn encore_static_value(cell: u8*) -> usize")
    .empty_line()
}

pub fn static_accessor(name: str, initializer: str, typ: str, owns_value: bool) -> EhirTextBuilder {
    let unit = typ == "()" || typ == "void"
    let mut code = EhirTextBuilder::new()
    .line("fn " + name + "() -> " + typ + " {")
    .label("entry")
    .instr("static_key: str = capprim \"encore-static-1:" + name + "\"_str")
    .instr("static_cell: u8* = call encore_static_cell_get(static_key: str)")
    .instr("drop static_key: str")
    .instr("static_initialize: bool = call encore_static_begin(static_cell: u8*)")
    .instr("cbr static_initialize: bool, $initialize, $ready")
    .label("initialize")
    .instr("static_initial: " + typ + " = call " + initializer + "()")
    .instr("static_zero: usize = capprim 0_usize")
    if unit {
        code = code.instr("static_published: () = call encore_static_publish(static_cell: u8*, static_zero: usize)")
    } else {
        let address_type = typ + "*"
        code = code.instr("static_null: " + address_type + " = pcast static_zero: usize, " + address_type)
        .instr("static_one: usize = capprim 1_usize")
        .instr("static_storage: " + address_type + " = hrealloc static_null: " + address_type + ", static_one: usize")
        .instr("store static_initial: " + typ + ", static_storage: " + address_type)
        if owns_value {
            code = code.instr("drop static_initial: " + typ)
        }
        code = code.instr("static_address: usize = pcast static_storage: " + address_type + ", usize")
        .instr("static_published: () = call encore_static_publish(static_cell: u8*, static_address: usize)")
    }
    code = code.instr("br $ready").label("ready")
    if unit {
        code = code.instr("ret void: ()")
    } else {
        code = code.instr("static_address_ready: usize = call encore_static_value(static_cell: u8*)")
        .instr("static_storage_ready: " + typ + "* = pcast static_address_ready: usize, " + typ + "*")
        .instr("static_result: " + typ + " = load static_storage_ready: " + typ + "*")
        if owns_value {
            code = code.instr("retain static_result: " + typ)
        }
        code = code.instr("ret static_result: " + typ)
    }
    ret code.line("}").empty_line()
}
