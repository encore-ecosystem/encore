fn encode_documentation(value: Documentation, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    out.push(encode_str(value.text, encoding))
    out.push(encode_usize(value.line, encoding))
    out.push(encode_usize(value.column, encoding))
    ret Json::Array(out)
}
fn decode_documentation(data: Json) -> Result[Documentation, str] {
    let values = record(data, 3)?
    let text = decode_str(values.get(0).unwrap_or(Json::Null))?
    let line = decode_usize(values.get(1).unwrap_or(Json::Null))?
    let column = decode_usize(values.get(2).unwrap_or(Json::Null))?
    ret Result[Documentation, str]::Ok(Documentation {
            text, line, column
        }
        ,
    )
}

fn encode_function_param(value: FunctionParam, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    out.push(encode_str(value.name, encoding))
    out.push(encode_option_str(value.typ, encoding))
    out.push(encode_bool(value.is_sending, encoding))
    out.push(encode_bool(value.is_frozen, encoding))
    out.push(encode_usize(value.line, encoding))
    out.push(encode_usize(value.column, encoding))
    ret Json::Array(out)
}
fn decode_function_param(data: Json) -> Result[FunctionParam, str] {
    let values = record(data, 6)?
    let name = decode_str(values.get(0).unwrap_or(Json::Null))?
    let typ = decode_option_str(values.get(1).unwrap_or(Json::Null))?
    let is_sending = decode_bool(values.get(2).unwrap_or(Json::Null))?
    let is_frozen = decode_bool(values.get(3).unwrap_or(Json::Null))?
    let line = decode_usize(values.get(4).unwrap_or(Json::Null))?
    let column = decode_usize(values.get(5).unwrap_or(Json::Null))?
    ret Result[FunctionParam, str]::Ok(FunctionParam {
            name, typ, is_sending, is_frozen, line, column
        }
        ,
    )
}

fn encode_decorator_application(value: DecoratorApplication, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    out.push(encode_expr_node(value.expression, encoding))
    ret Json::Array(out)
}
fn decode_decorator_application(data: Json) -> Result[DecoratorApplication, str] {
    let values = record(data, 1)?
    let expression = decode_expr_node(values.get(0).unwrap_or(Json::Null))?
    ret Result[DecoratorApplication, str]::Ok(DecoratorApplication {
            expression
        }
    )
}

fn encode_named_field(value: NamedField, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    out.push(encode_str(value.name, encoding))
    out.push(encode_str(value.typ, encoding))
    out.push(encode_option_documentation(value.documentation, encoding))
    out.push(encode_usize(value.line, encoding))
    out.push(encode_usize(value.column, encoding))
    ret Json::Array(out)
}
