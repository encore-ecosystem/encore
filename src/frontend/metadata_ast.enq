//! Structured declaration metadata; decoding never lexes dependency source.
//!
//! Record layouts belong to the enclosing metadata schema. They preserve
//! capabilities, generics, documentation and source spans, not display text.
import core::fmt::Debug
import core::option::Option
import core::result::Result
import json::Json
import refrain::frontend::parser::{Documentation, FunctionParam, DecoratorApplication, NamedField, TraitBound, GenericParam, ParsedEnumVariant, ImportStmt, StructStmt, EnumStmt, FunctionItem, TraitStmt, ImplStmt, MatchPattern, ExprNode, ParsedBlock, LetStmt, AssignmentStmt, IfBranch, IfStmt, ParsedMatchArm, MatchStmt, WhileStmt, LoopStmt, DoWhileStmt, ForStmt, EhirStmt, UnaryExpr, CastExpr, BinaryExpr, CallExpr, FieldExpr, MethodCallExpr, MatchExprArm, MatchExpr, StructInitExpr, TupleLiteralExpr, ArrayLiteralExpr, ArrayRepeatExpr, WithStmt, BlockExpr, IfExprBranch, IfExpr, IndexExpr, ClosureExpr, Statement, Expr, MatchArmBody}
import std::vec::Vec

struct MetadataEncoding {
    source: str
    locations: bool
    documentation: bool
}

/// Serializes a selected declaration graph without exposing parser internals.
pub fn encode_metadata_ast(ast: Vec[Statement]) -> Json {
    let encoding = MetadataEncoding { "", true, true }
    ret encode_vec_statement(ast, encoding)
}

/// Encodes source identities relative to the declaring module, never a build
/// directory. Moving a cache entry cannot change its ABI identity or make it
/// reference the machine where the package was first compiled.
pub fn encode_metadata_ast_for_module(ast: Vec[Statement], module_id: str) -> Json {
    ret encode_vec_statement(ast, MetadataEncoding { module_id, true, true })
}

/// Encodes the semantic declaration contract, excluding runtime bodies,
/// documentation and source locations. A moved or edited function body must
/// not change dependent frontend keys when its caller-visible contract stays
/// the same. This projection is only a fingerprint, never loaded as metadata.
pub fn encode_metadata_contract_ast(ast: Vec[Statement]) -> Json {
    ret encode_vec_statement(metadata_interface_ast(ast), MetadataEncoding { "", false, false })
}

/// Lowering-context identity, not dependency metadata. Generic, async,
/// decorator and default-trait bodies remain inputs; ordinary explicitly
/// typed function bodies do not. Callers additionally bind checked safety
/// effects, target/features and imported templates into their cache key.
pub fn encode_codegen_context_ast(ast: Vec[Statement]) -> Json {
    let mut projected = Vec[Statement]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                projected.push(Statement::Function(codegen_context_function(item, false)))
            }
            Statement::Impl(item) => {
                let mut methods = Vec[FunctionItem]::new()
                for method in item.methods {
                    methods.push(codegen_context_function(method, !item.generics.is_empty()))
                }
                projected.push(Statement::Impl(ImplStmt {
                            item.documentation, item.generics, item.trait_name, item.trait_args,
                            item.target, methods, item.source_name, item.line, item.column
                        }
                        ,))
            }
            _ => {
                projected.push(statement)
            }
        }
    }
    ret encode_vec_statement(projected, MetadataEncoding { "", false, false })
}

/// A function fragment retains spans: generated closure identities currently
/// include lexical positions. Relocation is allowed; moving a function is not
/// yet a cache hit. Documentation is retained because it is emitted into EHIR.
pub fn encode_lowered_function_input(item: FunctionItem, module_id: str) -> Json {
    ret encode_function_item(item, MetadataEncoding { module_id, true, true })
}

fn codegen_context_function(item: FunctionItem, generic_owner: bool) -> FunctionItem {
    let mut keep_body = generic_owner || !item.generics.is_empty() || item.is_async || item.ret_type.is_none()
    for attr in item.attrs {
        if attr == "decorator" || attr == "attr:decorator" {
            keep_body = true
        }
    }
    let body = if keep_body {
        item.body
    } else {
        Option[ParsedBlock]::None
    }
    ret FunctionItem {
        item.attrs, item.decorators, item.is_public, item.is_extern, item.is_async, item.name,
        item.documentation, item.generics, item.params, item.ret_type, item.returns_sending,
        item.returns_frozen, body, item.source_name, item.line, item.column
    }
}

/// Restores a checked declaration graph without opening or parsing source.
pub fn decode_metadata_ast(data: Json) -> Result[Vec[Statement], str] {
    ret decode_vec_statement(data)
}

/// Removes ordinary and generic runtime bodies from declaration metadata.
/// Generic machine templates travel as EHIR, not reparsed Encore source.
/// Decorators are compile-time syntax transformations and retain structured
/// syntax. An empty default-method marker records that a definition exists;
/// the actual implementation is supplied by its package's EHIR/artifact.
pub fn metadata_interface_ast(ast: Vec[Statement]) -> Vec[Statement] {
    let mut out = Vec[Statement]::new()
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                out.push(Statement::Function(interface_function(item, false)))
            }
            Statement::Trait(item) => {
                let mut methods = Vec[FunctionItem]::new()
                for method in item.methods {
                    methods.push(interface_function(method, true))
                }
                out.push(Statement::Trait(TraitStmt {
                            item.is_public, item.name, item.documentation, item.generics,
                            item.bases, methods, item.source_name, item.line, item.column
                        }
                        ,))
            }
            Statement::Impl(item) => {
                let mut methods = Vec[FunctionItem]::new()
                for method in item.methods {
                    methods.push(interface_function(method, false))
                }
                out.push(Statement::Impl(ImplStmt {
                            item.documentation, item.generics, item.trait_name, item.trait_args,
                            item.target, methods, item.source_name, item.line, item.column
                        }
                        ,))
            }
            _ => {
                out.push(statement)
            }
        }
    }
    ret out
}

fn interface_function(item: FunctionItem, default_method: bool) -> FunctionItem {
    let mut decorator = false
    for attr in item.attrs {
        if attr == "decorator" || attr == "attr:decorator" {
            decorator = true
        }
    }
    let body = if decorator {
        item.body
    } elif default_method && item.body.is_some() {
        Option[ParsedBlock]::Some(ParsedBlock::synthetic(Vec[Statement]::new()))
    } else {
        Option[ParsedBlock]::None
    }
    ret FunctionItem {
        item.attrs, item.decorators, item.is_public, item.is_extern, item.is_async, item.name,
        item.documentation, item.generics, item.params, item.ret_type, item.returns_sending, item.returns_frozen,
        body, item.source_name, item.line, item.column
    }
}

fn encode_str(value: str, _encoding: MetadataEncoding) -> Json {
    ret Json::String(value)
}
fn encode_source(value: str, encoding: MetadataEncoding) -> Json {
    ret Json::String(if !encoding.locations {
            ""
        } elif encoding.source == "" {
            value
        } else {
            encoding.source
        }
    )
}
fn encode_bool(value: bool, _encoding: MetadataEncoding) -> Json {
    ret Json::Bool(value)
}
fn encode_usize(value: usize, encoding: MetadataEncoding) -> Json {
    ret Json::Number(if encoding.locations {
            Debug::fmt(value)
        } else {
            "0"
        }
    )
}

fn decode_str(data: Json) -> Result[str, str] {
    ret match data {
        Json::String(value) => Result[str, str]::Ok(value)
        _ => Result[str, str]::Err("metadata field must be a string")
    }
}
fn decode_bool(data: Json) -> Result[bool, str] {
    ret match data {
        Json::Bool(value) => Result[bool, str]::Ok(value)
        _ => Result[bool, str]::Err("metadata field must be a boolean")
    }
}
/// Decodes a bounded portable source coordinate in the metadata schema.
pub fn decode_metadata_position(data: Json) -> Result[usize, str] {
    ret decode_usize(data)
}

fn decode_usize(data: Json) -> Result[usize, str] {
    let text = match data {
        Json::Number(value) => value
        _ => {
            ret Result[usize, str]::Err("metadata source position must be an integer")
        }
    }
    if text == "" {
        ret Result[usize, str]::Err("empty metadata position")
    }
    let mut value = 0_u64
    let mut index = 0_usize
    while index < text.byte_len() {
        let byte = text.byte_at(index)
        if byte < 48 || byte > 57 {
            ret Result[usize, str]::Err("invalid metadata position")
        }
        value = value * 10 +(byte - 48) as u64
        if value > 4294967295_u64 {
            ret Result[usize, str]::Err("metadata position exceeds portable range")
        }
        index += 1
    }
    ret Result[usize, str]::Ok(value as usize)
}
fn record(data: Json, size: usize) -> Result[Vec[Json], str] {
    match data {
        Json::Array(values) => {
            if values.len() != size {
                ret Result[Vec[Json], str]::Err("invalid metadata record size")
            }
            ret Result[Vec[Json], str]::Ok(values)
        }
        _ => {
            ret Result[Vec[Json], str]::Err("metadata record must be an array")
        }
    }
    ret Result[Vec[Json], str]::Err("metadata record must be an array")
}
fn encode_expr_node_heap(value: ExprNode<H>, encoding: MetadataEncoding) -> Json {
    ret encode_expr_node(ExprNode {
            value.value, value.line, value.column, value.length, value.source_name
        }
        , encoding,)
}
fn decode_expr_node_heap(data: Json) -> Result[ExprNode<H>, str] {
    let value = decode_expr_node(data)?
    ret Result[ExprNode<H>, str]::Ok(ExprNode<H> {
            value.value, value.line, value.column, value.length, value.source_name
        }
        ,
    )
}

fn encode_option_str(value: Option[str], encoding: MetadataEncoding) -> Json {
    ret match value {
        Some(item) => encode_str(item, encoding) None => Json::Null
    }
}
fn decode_option_str(data: Json) -> Result[Option[str], str] {
    if data.is_null() {
        ret Result[Option[str], str]::Ok(Option[str]::None)
    }
    ret Result[Option[str], str]::Ok(Option[str]::Some(decode_str(data)?))
}

/// Encodes module documentation with its original source coordinate.
pub fn encode_metadata_documentation(value: Option[Documentation]) -> Json {
    let encoding = MetadataEncoding { "", true, true }
    ret encode_option_documentation(value, encoding)
}

/// Restores module documentation without opening its dependency source file.
pub fn decode_metadata_documentation(data: Json) -> Result[Option[Documentation], str] {
    ret decode_option_documentation(data)
}

fn encode_option_documentation(value: Option[Documentation], encoding: MetadataEncoding) -> Json {
    if !encoding.documentation {
        ret Json::Null
    }
    ret match value {
        Some(item) => encode_documentation(item, encoding) None => Json::Null
    }
}
fn decode_option_documentation(data: Json) -> Result[Option[Documentation], str] {
    if data.is_null() {
        ret Result[Option[Documentation], str]::Ok(Option[Documentation]::None)
    }
    ret Result[Option[Documentation], str]::Ok(Option[Documentation]::Some(decode_documentation(data)?))
}

fn encode_vec_str(values: Vec[str], encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        out.push(encode_str(value, encoding))
    }
    ret Json::Array(out)
}
fn decode_vec_str(data: Json) -> Result[Vec[str], str] {
    let values = match data {
        Json::Array(items) => items
        _ => {
            ret Result[Vec[str], str]::Err("metadata list must be an array")
        }
    }
    let mut out = Vec[str]::new()
    for value in values {
        out.push(decode_str(value)?)
    }
    ret Result[Vec[str], str]::Ok(out)
}

