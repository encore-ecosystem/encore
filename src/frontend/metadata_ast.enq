    let start_line = decode_usize(values.get(2).unwrap_or(Json::Null))?
    let start_column = decode_usize(values.get(3).unwrap_or(Json::Null))?
    let end_line = decode_usize(values.get(4).unwrap_or(Json::Null))?
    let end_column = decode_usize(values.get(5).unwrap_or(Json::Null))?
    ret Result[BlockExpr, str]::Ok(BlockExpr {
