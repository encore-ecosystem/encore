fn encode_statement(value: Statement, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    match value {
        Statement::Import(item) => {
            out.push(Json::String("Import")) out.push(encode_import_stmt(item, encoding))
        }
        Statement::EnumItem(item) => {
            out.push(Json::String("EnumItem")) out.push(encode_enum_stmt(item, encoding))
        }
        Statement::Struct(item) => {
            out.push(Json::String("Struct")) out.push(encode_struct_stmt(item, encoding))
        }
        Statement::Trait(item) => {
            out.push(Json::String("Trait")) out.push(encode_trait_stmt(item, encoding))
        }
        Statement::Impl(item) => {
            out.push(Json::String("Impl")) out.push(encode_impl_stmt(item, encoding))
        }
        Statement::Function(item) => {
            out.push(Json::String("Function")) out.push(encode_function_item(item, encoding))
        }
        Statement::Let(item) => {
            out.push(Json::String("Let")) out.push(encode_let_stmt(item, encoding))
        }
        Statement::Ret(item) => {
            out.push(Json::String("Ret")) out.push(encode_expr_node(item, encoding))
        }
        Statement::Expr(item) => {
            out.push(Json::String("Expr")) out.push(encode_expr_node(item, encoding))
        }
        Statement::If(item) => {
            out.push(Json::String("If")) out.push(encode_if_stmt(item, encoding))
        }
        Statement::Match(item) => {
            out.push(Json::String("Match")) out.push(encode_match_stmt(item, encoding))
        }
        Statement::Assignment(item) => {
            out.push(Json::String("Assignment")) out.push(encode_assignment_stmt(item, encoding))
        }
        Statement::While(item) => {
            out.push(Json::String("While")) out.push(encode_while_stmt(item, encoding))
        }
        Statement::Loop(item) => {
            out.push(Json::String("Loop")) out.push(encode_loop_stmt(item, encoding))
        }
        Statement::DoWhile(item) => {
            out.push(Json::String("DoWhile")) out.push(encode_do_while_stmt(item, encoding))
        }
        Statement::For(item) => {
            out.push(Json::String("For")) out.push(encode_for_stmt(item, encoding))
        }
        Statement::With(item) => {
            out.push(Json::String("With")) out.push(encode_with_stmt(item, encoding))
        }
        Statement::Unsafe(item) => {
            out.push(Json::String("Unsafe")) out.push(encode_parsed_block(item, encoding))
        }
        Statement::Ehir(item) => {
            out.push(Json::String("Ehir")) out.push(encode_ehir_stmt(item, encoding))
        }
        Statement::Break(item) => {
            out.push(Json::String("Break")) out.push(encode_option_str(item, encoding))
        }
        Statement::Continue(item) => {
            out.push(Json::String("Continue")) out.push(encode_option_str(item, encoding))
        }
    }
    ret Json::Array(out)
}
fn decode_statement(data: Json) -> Result[Statement, str] {
    let values = record(data, 2)?
    let tag = decode_str(values.get(0).unwrap_or(Json::Null))?
    let payload = values.get(1).unwrap_or(Json::Null)
    ret match tag {
        "Import" => Result[Statement, str]::Ok(Statement::Import(decode_import_stmt(payload)?))
        "EnumItem" => Result[Statement, str]::Ok(Statement::EnumItem(decode_enum_stmt(payload)?))
        "Struct" => Result[Statement, str]::Ok(Statement::Struct(decode_struct_stmt(payload)?))
        "Trait" => Result[Statement, str]::Ok(Statement::Trait(decode_trait_stmt(payload)?))
        "Impl" => Result[Statement, str]::Ok(Statement::Impl(decode_impl_stmt(payload)?))
        "Function" => Result[Statement, str]::Ok(Statement::Function(decode_function_item(payload)?))
        "Let" => Result[Statement, str]::Ok(Statement::Let(decode_let_stmt(payload)?))
        "Ret" => Result[Statement, str]::Ok(Statement::Ret(decode_expr_node(payload)?))
        "Expr" => Result[Statement, str]::Ok(Statement::Expr(decode_expr_node(payload)?))
        "If" => Result[Statement, str]::Ok(Statement::If(decode_if_stmt(payload)?))
        "Match" => Result[Statement, str]::Ok(Statement::Match(decode_match_stmt(payload)?))
        "Assignment" => Result[Statement, str]::Ok(Statement::Assignment(decode_assignment_stmt(payload)?))
        "While" => Result[Statement, str]::Ok(Statement::While(decode_while_stmt(payload)?))
        "Loop" => Result[Statement, str]::Ok(Statement::Loop(decode_loop_stmt(payload)?))
        "DoWhile" => Result[Statement, str]::Ok(Statement::DoWhile(decode_do_while_stmt(payload)?))
        "For" => Result[Statement, str]::Ok(Statement::For(decode_for_stmt(payload)?))
        "With" => Result[Statement, str]::Ok(Statement::With(decode_with_stmt(payload)?))
        "Unsafe" => Result[Statement, str]::Ok(Statement::Unsafe(decode_parsed_block(payload)?))
        "Ehir" => Result[Statement, str]::Ok(Statement::Ehir(decode_ehir_stmt(payload)?))
        "Break" => Result[Statement, str]::Ok(Statement::Break(decode_option_str(payload)?))
        "Continue" => Result[Statement, str]::Ok(Statement::Continue(decode_option_str(payload)?))
        _ => Result[Statement, str]::Err("unknown metadata Statement tag: " + tag)
    }
}

fn encode_expr(value: Expr, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    match value {
        Expr::Path(item) => {
            out.push(Json::String("Path")) out.push(encode_str(item, encoding))
        }
        Expr::VecLiteral(item) => {
            out.push(Json::String("VecLiteral")) out.push(encode_array_literal_expr(item, encoding))
        }
        Expr::Boolean(item) => {
            out.push(Json::String("Boolean")) out.push(encode_bool(item, encoding))
        }
        Expr::Integer(item) => {
            out.push(Json::String("Integer")) out.push(encode_str(item, encoding))
        }
        Expr::Float(item) => {
            out.push(Json::String("Float")) out.push(encode_str(item, encoding))
        }
        Expr::StringLiteral(item) => {
            out.push(Json::String("StringLiteral")) out.push(encode_str(item, encoding))
        }
        Expr::Parenthesized(item) => {
            out.push(Json::String("Parenthesized")) out.push(encode_expr_node_heap(item, encoding))
        }
        Expr::TupleLiteral(item) => {
            out.push(Json::String("TupleLiteral")) out.push(encode_tuple_literal_expr(item, encoding))
        }
        Expr::ArrayLiteral(item) => {
            out.push(Json::String("ArrayLiteral")) out.push(encode_array_literal_expr(item, encoding))
        }
        Expr::ArrayRepeat(item) => {
            out.push(Json::String("ArrayRepeat")) out.push(encode_array_repeat_expr(item, encoding))
        }
        Expr::Block(item) => {
            out.push(Json::String("Block")) out.push(encode_block_expr(item, encoding))
        }
        Expr::Unary(item) => {
            out.push(Json::String("Unary")) out.push(encode_unary_expr(item, encoding))
        }
        Expr::Await(item) => {
            out.push(Json::String("Await")) out.push(encode_expr_node_heap(item, encoding))
        }
        Expr::Spawn(item) => {
            out.push(Json::String("Spawn")) out.push(encode_expr_node_heap(item, encoding))
        }
        Expr::Cast(item) => {
            out.push(Json::String("Cast")) out.push(encode_cast_expr(item, encoding))
        }
        Expr::Binary(item) => {
            out.push(Json::String("Binary")) out.push(encode_binary_expr(item, encoding))
        }
        Expr::Call(item) => {
            out.push(Json::String("Call")) out.push(encode_call_expr(item, encoding))
        }
        Expr::Field(item) => {
            out.push(Json::String("Field")) out.push(encode_field_expr(item, encoding))
        }
        Expr::MethodCall(item) => {
            out.push(Json::String("MethodCall")) out.push(encode_method_call_expr(item, encoding))
        }
        Expr::Match(item) => {
            out.push(Json::String("Match")) out.push(encode_match_expr(item, encoding))
        }
        Expr::If(item) => {
            out.push(Json::String("If")) out.push(encode_if_expr(item, encoding))
        }
        Expr::StructInit(item) => {
            out.push(Json::String("StructInit")) out.push(encode_struct_init_expr(item, encoding))
        }
        Expr::Index(item) => {
            out.push(Json::String("Index")) out.push(encode_index_expr(item, encoding))
        }
        Expr::Closure(item) => {
            out.push(Json::String("Closure")) out.push(encode_closure_expr(item, encoding))
        }
        Expr::Try(item) => {
            out.push(Json::String("Try")) out.push(encode_expr_node_heap(item, encoding))
        }
        Expr::Unsafe(item) => {
            out.push(Json::String("Unsafe")) out.push(encode_parsed_block(item, encoding))
        }
    }
    ret Json::Array(out)
}
fn decode_expr(data: Json) -> Result[Expr, str] {
    let values = record(data, 2)?
    let tag = decode_str(values.get(0).unwrap_or(Json::Null))?
    let payload = values.get(1).unwrap_or(Json::Null)
    ret match tag {
        "Path" => Result[Expr, str]::Ok(Expr::Path(decode_str(payload)?))
        "VecLiteral" => Result[Expr, str]::Ok(Expr::VecLiteral(decode_array_literal_expr(payload)?))
        "Boolean" => Result[Expr, str]::Ok(Expr::Boolean(decode_bool(payload)?))
        "Integer" => Result[Expr, str]::Ok(Expr::Integer(decode_str(payload)?))
        "Float" => Result[Expr, str]::Ok(Expr::Float(decode_str(payload)?))
        "StringLiteral" => Result[Expr, str]::Ok(Expr::StringLiteral(decode_str(payload)?))
        "Parenthesized" => Result[Expr, str]::Ok(Expr::Parenthesized(decode_expr_node_heap(payload)?))
        "TupleLiteral" => Result[Expr, str]::Ok(Expr::TupleLiteral(decode_tuple_literal_expr(payload)?))
        "ArrayLiteral" => Result[Expr, str]::Ok(Expr::ArrayLiteral(decode_array_literal_expr(payload)?))
        "ArrayRepeat" => Result[Expr, str]::Ok(Expr::ArrayRepeat(decode_array_repeat_expr(payload)?))
        "Block" => Result[Expr, str]::Ok(Expr::Block(decode_block_expr(payload)?))
        "Unary" => Result[Expr, str]::Ok(Expr::Unary(decode_unary_expr(payload)?))
        "Await" => Result[Expr, str]::Ok(Expr::Await(decode_expr_node_heap(payload)?))
        "Spawn" => Result[Expr, str]::Ok(Expr::Spawn(decode_expr_node_heap(payload)?))
        "Cast" => Result[Expr, str]::Ok(Expr::Cast(decode_cast_expr(payload)?))
        "Binary" => Result[Expr, str]::Ok(Expr::Binary(decode_binary_expr(payload)?))
        "Call" => Result[Expr, str]::Ok(Expr::Call(decode_call_expr(payload)?))
        "Field" => Result[Expr, str]::Ok(Expr::Field(decode_field_expr(payload)?))
        "MethodCall" => Result[Expr, str]::Ok(Expr::MethodCall(decode_method_call_expr(payload)?))
        "Match" => Result[Expr, str]::Ok(Expr::Match(decode_match_expr(payload)?))
        "If" => Result[Expr, str]::Ok(Expr::If(decode_if_expr(payload)?))
        "StructInit" => Result[Expr, str]::Ok(Expr::StructInit(decode_struct_init_expr(payload)?))
        "Index" => Result[Expr, str]::Ok(Expr::Index(decode_index_expr(payload)?))
        "Closure" => Result[Expr, str]::Ok(Expr::Closure(decode_closure_expr(payload)?))
        "Try" => Result[Expr, str]::Ok(Expr::Try(decode_expr_node_heap(payload)?))
        "Unsafe" => Result[Expr, str]::Ok(Expr::Unsafe(decode_parsed_block(payload)?))
        _ => Result[Expr, str]::Err("unknown metadata Expr tag: " + tag)
    }
}

fn encode_match_arm_body(value: MatchArmBody, encoding: MetadataEncoding) -> Json {
    let mut out = Vec[Json]::new()
    match value {
        MatchArmBody::Block(item) => {
            out.push(Json::String("Block")) out.push(encode_parsed_block(item, encoding))
        }
        MatchArmBody::Expr(item) => {
            out.push(Json::String("Expr")) out.push(encode_expr_node(item, encoding))
        }
    }
    ret Json::Array(out)
}
fn decode_match_arm_body(data: Json) -> Result[MatchArmBody, str] {
    let values = record(data, 2)?
    let tag = decode_str(values.get(0).unwrap_or(Json::Null))?
    let payload = values.get(1).unwrap_or(Json::Null)
    ret match tag {
        "Block" => Result[MatchArmBody, str]::Ok(MatchArmBody::Block(decode_parsed_block(payload)?))
        "Expr" => Result[MatchArmBody, str]::Ok(MatchArmBody::Expr(decode_expr_node(payload)?))
        _ => Result[MatchArmBody, str]::Err("unknown metadata MatchArmBody tag: " + tag)
    }
}

import json::stringify
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser

fn codec_round_trip(source: str) -> bool {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("package@model.enq")
    let ast = match parser.parse_result(lexer.tokenize(source)) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    if ast.len() == 0 {
        ret false
    }
    let encoded = encode_metadata_ast(ast)
    let restored = match decode_metadata_ast(encoded) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    ret stringify(encode_metadata_ast(restored)) == stringify(encoded)
}

#attr(test)
fn metadata_codec_functions_contract() -> bool {
    ret codec_round_trip("pub fn sample(value: u16) -> u32 { ret value as u32 }")
}

#attr(test)
fn metadata_codec_generics_contract() -> bool {
    ret codec_round_trip("pub fn identity[T](value: T) -> T { ret value }")
}

#attr(test)
fn metadata_codec_documentation_contract() -> bool {
    ret codec_round_trip("//! Module text\n/// Function text\npub fn sample() -> str { ret \"é 中文\" }")
}

#attr(test)
fn metadata_codec_capabilities_contract() -> bool {
    ret codec_round_trip("pub fn sample(value: sending str, input: frozen str) -> sending str { ret value }")
}

#attr(test)
fn metadata_codec_structs_contract() -> bool {
    ret codec_round_trip("pub struct Point[T] { x: T y: T }\npub struct Pair(u16, str)\npub struct Unit")
}

#attr(test)
fn metadata_codec_enums_contract() -> bool {
    ret codec_round_trip("pub enum Choice[T] { Empty Value(T) Named { value: T } }")
}

#attr(test)
fn metadata_codec_traits_contract() -> bool {
    ret codec_round_trip("pub trait Sample[T] { fn get(self: Self) -> T fn ready(self: Self) -> bool }")
}

#attr(test)
fn metadata_codec_impls_contract() -> bool {
    ret codec_round_trip("struct Point { x: u32 }\nimpl for Point { pub fn get(self: Self) -> u32 { ret self.x } }")
}

#attr(test)
fn metadata_codec_imports_contract() -> bool {
    ret codec_round_trip("pub import std::io::{println as output, print}\nimport mod::helpers::*")
}

#attr(test)
fn metadata_codec_literals_contract() -> bool {
    ret codec_round_trip("fn sample() { let x = (1_u16, true, \"text\") let y = [1_u16, 2_u16] let z = [3_u16; 4] }")
}

#attr(test)
fn metadata_codec_operators_contract() -> bool {
    ret codec_round_trip("fn sample(x: i32) -> i32 { let y = -x + 2_i32 * 3_i32 ret (y as i32) }")
}

#attr(test)
fn metadata_codec_calls_contract() -> bool {
    ret codec_round_trip("fn sample() { work[u32](1_u32) thing.run(2_u32) let field = thing.value let index = things[0] }")
}

#attr(test)
fn metadata_codec_branches_contract() -> bool {
    ret codec_round_trip("fn sample(value: bool) { if value { work() } elif false { other() } else { finish() } }")
}

#attr(test)
fn metadata_codec_loops_contract() -> bool {
    ret codec_round_trip("fn sample() { while ready() { continue } loop { break } for item in items { work(item) } do { work() } while ready() }")
}

#attr(test)
fn metadata_codec_match_contract() -> bool {
    ret codec_round_trip("fn sample() { match item { Choice::Value(value) => { work(value) } _ => finish() } }")
}

#attr(test)
fn metadata_codec_async_contract() -> bool {
    ret codec_round_trip("async fn sample() { let task = spawn work() let value = await work() ret value }")
}

#attr(test)
fn metadata_codec_try_contract() -> bool {
    ret codec_round_trip("fn sample() { let value = work()? }")
}

#attr(test)
fn metadata_codec_closures_contract() -> bool {
    ret codec_round_trip("fn sample() { let add = |x: u32| x + 1_u32 let value = if ready() { 1_u32 } else { 2_u32 } }")
}

#attr(test)
fn metadata_codec_unsafe_contract() -> bool {
    ret codec_round_trip("#attr(safe)\npub fn sample() -> u32 { unsafe { ret external() } }")
}

#attr(test)
fn metadata_codec_format_contract() -> bool {
    ret codec_round_trip("fn sample(x: u32) -> str { ret f\"value={x}\" }")
}

#attr(test)
fn metadata_codec_rejects_bad_shapes_contract() -> bool {
    let mut bad = Vec[Json]::new()
    bad.push(Json::Null)
    let mut tagged = Vec[Json]::new()
    tagged.push(Json::String("UnknownDeclaration"))
    tagged.push(Json::Null)
    let mut unknown = Vec[Json]::new()
    unknown.push(Json::Array(tagged))
    ret decode_metadata_ast(Json::Null).is_err() && decode_metadata_ast(Json::Array(bad)).is_err()
    && decode_metadata_ast(Json::Array(unknown)).is_err()
    && decode_usize(Json::Number("-1")).is_err()
    && decode_usize(Json::Number("4294967296")).is_err()
    && decode_usize(Json::Number("1.5")).is_err()
    && decode_bool(Json::Number("1")).is_err()
    && decode_str(Json::Bool(true)).is_err()
}

#attr(test)
fn metadata_codec_runtime_bodies_not_in_interface_contract() -> bool {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("package@model.enq")
    let ast = match parser.parse_result(lexer.tokenize(
            "pub fn runtime(value: u32) -> u32 { ret value + 1_u32 }\npub fn template[T](value: T) -> T { ret value }")) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    let restored = match decode_metadata_ast(encode_metadata_ast(metadata_interface_ast(ast))) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    if restored.len() != 2 {
        ret false
    }
    for statement in restored {
        match statement {
            Statement::Function(item) => {
                if item.body.is_some() {
                    ret false
                }
            }
            _ => {
                ret false
            }
        }
    }
    ret true
}

#attr(test)
fn metadata_codec_portable_source_identity_contract() -> bool {
    let source = "pub fn value() -> u32 { ret helper(42) }"
    let mut lexer = Lexer::new()
    let mut first = Parser::new_for_source("/old/project/src/model.enq")
    let mut second = Parser::new_for_source("/new/project/src/model.enq")
    let left = match first.parse_result(lexer.tokenize(source)) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    let right = match second.parse_result(lexer.tokenize(source)) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    ret stringify(encode_metadata_ast_for_module(left, "package@model.enq")) ==
    stringify(encode_metadata_ast_for_module(right, "package@model.enq"))
}

#attr(test)
fn metadata_codec_compile_time_decorator_preserved_contract() -> bool {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("package@model.enq")
    let ast = match parser.parse_result(lexer.tokenize(
            "#attr(decorator)\npub fn wrap[Args](func: Callable[Args, u32], args: Args) -> u32 { ret func(args) }")) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    let restored = match decode_metadata_ast(encode_metadata_ast(metadata_interface_ast(ast))) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    if restored.len() != 1 {
        ret false
    }
    for statement in restored {
        match statement {
            Statement::Function(item) => {
                ret item.body.is_some() && item.attrs.len() > 0
            }
            _ => {
                ret false
            }
        }
    }
    ret false
}
