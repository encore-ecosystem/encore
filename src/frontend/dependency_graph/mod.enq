//! Tracks dependencies between Encore source modules.

import core::option::Option

import std::vec::Vec

import refrain::frontend::lexer::{Lexer, Token, TokenType}

/// Describes one source-level import and its location.
pub struct DependencyEdge {
    source: str
    target: str
    is_public: bool
    line: usize
    column: usize
    length: usize
}

/// Stores directed import edges between Encore modules.
pub struct DependencyGraph {
    edges: Vec[DependencyEdge]
}

impl for DependencyEdge {
    /// Creates a dependency edge at a source range.
    pub fn new(source: str, target: str, is_public: bool, line: usize, column: usize, length: usize)
    -> Self {
        ret Self {
            source, target, is_public, line, column, length
        }
    }
}

impl for DependencyGraph {
    /// Creates an empty dependency graph.
    pub fn new() -> Self {
        ret Self {
            Vec[DependencyEdge]::new()
        }
    }

    /// Builds a dependency graph from the import tokens of one module.
    pub fn from_tokens(module_name: str, tokens: Vec[Token]) -> Self {
        let mut graph = DependencyGraph::new()
        let mut index = 0_usize
        while index < tokens.len() {
            match tokens.get(index) {
                Option[Token]::Some(token) => {
                    if token.type == TokenType::KW_IMPORT {
                        let target = import_path_from_tokens(tokens, index + 1_usize)
                        match first_import_path_token(tokens, index + 1_usize) {
                            Option[Token]::Some(path_token) => {
                                graph.add_at(module_name, target, import_is_public(tokens, index), path_token.line,
                                    path_token.column, target.char_len(),)
                            }
                            Option[Token]::None => {
                                graph.add_at(module_name, target, import_is_public(tokens, index), token.line,
                                    token.column, target.char_len(),)
                            }
                        }
                    }
                }
                Option[Token]::None => {
                }
            }
            index += 1_usize
        }
        ret graph
    }

    /// Adds an import edge without a meaningful source position.
    pub fn add(self: mut Self, source: str, target: str, is_public: bool) ->() {
        self.edges.push(DependencyEdge::new(source, target, is_public, 0_usize, 0_usize, target.char_len()))
        ret()
    }

    /// Adds an import edge at a precise source position.
    pub fn add_at(self: mut Self, source: str, target: str, is_public: bool, line: usize, column: usize,
        length: usize,) ->() {
        self.edges.push(DependencyEdge::new(source, target, is_public, line, column, length))
        ret()
    }

    /// Returns the number of import edges.
    pub fn len(self: Self) -> usize {
        ret self.edges.len()
    }

    /// Returns whether the graph contains no imports.
    pub fn is_empty(self: Self) -> bool {
        ret self.edges.len() == 0_usize
    }

    /// Returns all dependency edges in insertion order.
    pub fn all(self: Self) -> Vec[DependencyEdge] {
        ret self.edges
    }
}

fn import_is_public(tokens: Vec[Token], import_index: usize) -> bool {
    if import_index == 0_usize {
        ret false
    }
    match tokens.get(import_index - 1_usize) {
        Option[Token]::Some(prev) => {
            ret prev.type == TokenType::KW_PUB
        }
        Option[Token]::None => {
            ret false
        }
    }
}

fn import_path_from_tokens(tokens: Vec[Token], start: usize) -> str {
    let mut out = ""
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if import_path_should_stop(token) {
                    break
                }
                if token.type == TokenType::COMMA {
                    out += ", "
                } elif token.value == "as" {
                    out += " as "
                } else {
                    out += token.value
                }
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret out
}

fn import_path_should_stop(token: Token) -> bool {
    match token.type {
        TokenType::KW_ASYNC => {
            ret true
        }
        TokenType::KW_FN => {
            ret true
        }
        TokenType::KW_STRUCT => {
            ret true
        }
        TokenType::KW_ENUM => {
            ret true
        }
        TokenType::KW_TRAIT => {
            ret true
        }
        TokenType::KW_IMPL => {
            ret true
        }
        TokenType::KW_PUB => {
            ret true
        }
        TokenType::KW_IMPORT => {
            ret true
        }
        TokenType::KW_EXTERN => {
            ret true
        }
        TokenType::HASH => {
            ret true
        }
        TokenType::DOC_COMMENT => {
            ret true
        }
        TokenType::MODULE_DOC_COMMENT => {
            ret true
        }
        _ => {
            ret false
        }
    }
}

// The tolerant graph must preserve the same import boundary as the parser,
// including a declaration whose first token is a modifier rather than `fn`.
#attr(test)
fn imports_stop_before_async_declarations() -> bool {
    if !import_target_matches("import demo::*\nasync fn work() {}", "demo::*") {
        ret false
    }
    if !import_target_matches("import demo::Thing\nasync fn work() {}", "demo::Thing") {
        ret false
    }
    if !import_target_matches("import demo::Thing as Alias\nasync fn work() {}", "demo::Thing as Alias") {
        ret false
    }
    if !import_target_matches("import demo::{Thing, Thing as Alias}\nasync fn work() {}", "demo::{Thing, Thing as Alias}") {
        ret false
    }
    if !import_target_matches("import demo::{\nThing,\nOther\n}\nasync fn work() {}", "demo::{Thing, Other}") {
        ret false
    }
    ret import_target_matches("import demo::*\npub async fn work() {}", "demo::*")
}

fn import_target_matches(source: str, expected: str) -> bool {
    let mut lexer = Lexer::new()
    let graph = DependencyGraph::from_tokens("app", lexer.tokenize(source))
    if graph.len() != 1_usize {
        ret false
    }
    match graph.all().get(0_usize) {
        Option::Some(edge) => {
            ret edge.target == expected
        }
        Option::None => {
            ret false
        }
    }
}

fn first_import_path_token(tokens: Vec[Token], start: usize) -> Option[Token] {
    let mut index = start
    while index < tokens.len() {
        match tokens.get(index) {
            Option[Token]::Some(token) => {
                if import_path_should_stop(token) {
                    ret Option[Token]::None
                }
                ret Option[Token]::Some(token)
            }
            Option[Token]::None => {
            }
        }
        index += 1_usize
    }
    ret Option[Token]::None
}
