//! Immutable package metadata used when parsing compiler-provided constants.

import core::fmt::Debug
import core::option::Option

import std::dict::Hashable

/// Values belong to the package declaring a module, never its consumer.
pub struct ProjectConstants {
    name: str
    version: str
}

impl for ProjectConstants {
    /// An absent context keeps standalone syntax tools independent of a project.
    pub fn empty() -> Self {
        ret Self { "", "" }
    }

    /// Returns a supported constant's value when a package is available.
    pub fn value(self: Self, name: str) -> Option[str] {
        if self.name == "" {
            ret Option[str]::None
        }
        if name == "__version__" {
            ret Option[str]::Some(self.version)
        }
        if name == "__project_name__" {
            ret Option[str]::Some(self.name)
        }
        ret Option[str]::None
    }

    /// Length-delimited identity for incremental queries and worker snapshots.
    pub fn key(self: Self) -> str {
        ret Debug::fmt(self.name.len()) + ":" + self.name + Debug::fmt(self.version.len()) + ":" + self.version
    }

    /// Preserves existing identities for context-free frontend clients.
    pub fn fingerprint(self: Self, source: str) -> u64 {
        if self.name == "" {
            ret source.hash()
        }
        ret(Debug::fmt(source.hash()) + ":encore-project-constants:" + self.key()).hash()
    }
}

/// Only these two bare value names are reserved by the language.
pub fn is_project_constant(name: str) -> bool {
    ret name == "__version__" || name == "__project_name__"
}

/// Encodes decoded TOML text as an Encore string token, preserving escapes.
pub fn project_constant_literal(value: str) -> str {
    let mut out = "\""
    let mut index = 0_usize
    while index < value.char_len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out += "\\\\"
        } elif ch == "\"" {
            out += "\\\""
        } elif ch == "\n" {
            out += "\\n"
        } elif ch == "\r" {
            out += "\\r"
        } elif ch == "\t" {
            out += "\\t"
        } elif ch == "\0" {
            out += "\\0"
        } else {
            out += ch
        }
        index += 1_usize
    }
    ret out + "\""
}
