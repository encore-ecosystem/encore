import refrain::frontend::parser::statements::{CallParameter, ParameterDefault}
//! Persistent declaration facts for lowering. AST fragments use the checked
//! metadata codec; native lookup handles and per-body mutable state are absent.
import std::vec::Vec

pub struct StoredTranslationFunction {
    name: str
    emitted_name: str
    source_name: str
    ret_type: str
    params: Vec[str]
    sending_params: Vec[bool]
    frozen_params: Vec[bool]
    readonly_self: bool
    has_receiver: bool
    generics: Vec[str]
    is_extern: bool
    is_async: bool
    output_type: str
    returns_sending: bool
    returns_frozen: bool
    is_static: bool
    call_parameters: Vec[CallParameter]
}

pub struct StoredTranslationTrait {
    plugin_interface: bool
    name: str
    generics: str
    bases: Vec[str]
    methods: Vec[str]
    source_name: str
    line: usize
    column: usize
}

pub struct StoredTranslationImpl {
    trait_name: str
    trait_args: Vec[str]
    target: str
    generics: str
}

pub struct StoredTranslationGeneric {
    name: str
    params: str
}

pub struct StoredTranslationDecorator {
    owner: str
    item: str
}

pub struct StoredTranslationField {
    owner: str
    field: str
    typ: str
    index: str
    generic_names: Vec[str]
}

pub struct StoredTranslationVariant {
    path: str
    owner: str
    payload_type: str
    generics: Vec[str]
    payload_arity: usize
}

pub struct StoredTranslationReflection {
    name: str
    item: str
}

pub struct StoredTranslationModule {
    id: str
    source_name: str
    imports: Vec[str]
    features: Vec[str]
    declarations: str
    documentation: str
}
pub struct StoredTranslationSourceAlias {
    source_name: str
    module: usize
}
pub struct TranslationEnvironmentArtifact {
    schema: u32
    identity: str
    functions: Vec[StoredTranslationFunction]
    types: Vec[str]
    traits: Vec[StoredTranslationTrait]
    implementations: Vec[StoredTranslationImpl]
    generics: Vec[StoredTranslationGeneric]
    decorators: Vec[StoredTranslationDecorator]
    fields: Vec[StoredTranslationField]
    variants: Vec[StoredTranslationVariant]
    extern_functions: Vec[str]
    borrowed_return_functions: Vec[str]
    borrowed_self_functions: Vec[str]
    reflection_templates: Vec[StoredTranslationReflection]
    modules: Vec[StoredTranslationModule]
    source_aliases: Vec[StoredTranslationSourceAlias]
    declaration_keys: Vec[str]
}
