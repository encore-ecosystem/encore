//! Shared declaration work within one immutable package preparation pass.
//! The database replaces this cache before and after each pass, so nominal
//! ordinals and selections never survive edits, replay, or table rebinding.
import std::vec::Vec
import refrain::frontend::semantic::{SemanticField, SemanticMethod}
import refrain::frontend::semantic_record_index::SemanticRecordIndex
import refrain::frontend::semantic_slice::SemanticKeyIndex
import refrain::frontend::type_scope::TypeNameBinding

pub struct MethodDeclarationGroup {
    is_trait: bool
    name: str
    receiver: str
    generic_names: Vec[str]
    bases: Vec[str]
    methods: Vec[SemanticMethod]
    visibility: Vec[bool]
    plugin: bool
}

pub struct DeclarationPreparationCache {
    enabled: bool
    active_module: str
    active_names: Vec[TypeNameBinding]
    type_positions: SemanticKeyIndex
    type_names: Vec[Vec[TypeNameBinding]]
    prelude_ready: bool
    prelude: Vec[TypeNameBinding]
    field_positions: SemanticKeyIndex
    field_declarations: Vec[Vec[SemanticField]]
    field_inputs: SemanticRecordIndex[SemanticField]
    scoped_fields: Vec[SemanticField]
    method_positions: SemanticKeyIndex
    method_declarations: Vec[Vec[MethodDeclarationGroup]]
    method_inputs: SemanticRecordIndex[SemanticMethod]
    scoped_methods: Vec[SemanticMethod]
}

impl for DeclarationPreparationCache {
    pub fn new(enabled: bool) -> Self {
        ret Self {
            enabled, "", Vec[TypeNameBinding]::new(), SemanticKeyIndex::new(0_usize), Vec[Vec[TypeNameBinding]]::new(),
            false, Vec[TypeNameBinding]::new(), SemanticKeyIndex::new(0_usize), Vec[Vec[SemanticField]]::new(),
            SemanticRecordIndex[SemanticField]::new(), Vec[SemanticField]::new(),
            SemanticKeyIndex::new(0_usize), Vec[Vec[MethodDeclarationGroup]]::new(),
            SemanticRecordIndex[SemanticMethod]::new(), Vec[SemanticMethod]::new()
        }
    }
}
