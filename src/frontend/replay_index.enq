//! Local immutable lookup over persisted JSON records. Wire order is unchanged.
import core::option::Option
import std::vec::Vec

import json::Json

import refrain::frontend::semantic_slice::SemanticKeyIndex

pub struct ReplayIndex {
    entries: Vec[(str, Json)]
    positions: SemanticKeyIndex
}

impl for ReplayIndex {
    pub fn new(value: Json) -> Self {
        let entries = value.as_object().unwrap_or(Vec[(str, Json)]::new())
        let mut positions = SemanticKeyIndex::new(entries.len())
        for index in 0_usize..entries.len() {
            let key = entries.get_unchecked_borrowed(index).0
            // Match Json.get: the first occurrence wins, including duplicates.
            if positions.get(key) == 0_usize {
                positions.set(key, index)
            }
        }
        ret Self { entries, positions }
    }
    #attr(borrowed_self)
    pub fn get(self: Self, key: str) -> Option[Json] {
        let position = self.positions.get(key)
        if position == 0_usize {
            ret Option[Json]::None
        }
        ret Option[Json]::Some(self.entries.get_unchecked_borrowed(position - 1_usize).1)
    }
}
