//! Backend-independent callable safety effects. An explicit safe contract is a trust boundary.
import core::fmt::Debug
import core::option::Option

import std::io::eprintln
import std::vec::Vec

import json::{Json, stringify}

import refrain::cache_identity::compiler_content_digest
import refrain::frontend::analysis::analyze_named_module
import refrain::frontend::metadata_ast::encode_lowered_function_input
import refrain::frontend::parser::{Expr, ExprNode, FunctionItem, MatchArmBody, Statement}
import refrain::frontend::semantic::{SemanticBody, SemanticCallable, SemanticField, SemanticMethod, check_function_body_with_types, semantic_associated_members, semantic_named_members, semantic_same_owner}
import refrain::frontend::type_scope::scope_type

extern fn encore_strmap_new() -> usize
extern fn encore_strmap_put(map: usize, key: str, value: usize) ->()
extern fn encore_strmap_get(map: usize, key: str) -> usize
extern fn encore_strmap_free(map: usize) ->()

/// Stable declaration and the resolved lexical environment of its body.
pub struct SafetyFunction {
    module_name: str
    owner: str
    item: FunctionItem
    body: SemanticBody
    callables: Vec[SemanticCallable]
    methods: Vec[SemanticMethod]
    symbol_line: usize
    symbol_column: usize
    constructors: Vec[str]
}

/// Both internal operations and the caller-visible contract are retained.
pub struct FunctionSafety {
    module_name: str
    owner: str
    name: str
    line: usize
    column: usize
    body_unsafe: bool
    asserted_safe: bool
    returns_unsafe_callable: bool
}

impl for FunctionSafety {
    pub fn is_unsafe(self: Self) -> bool {
        ret self.body_unsafe && !self.asserted_safe
    }
}

struct CallableValue {
    unsafe_call: bool
    unsafe_result: bool
}

// Linked overload families preserve the conservative join of every matching
// declaration, including known effects from compiled dependencies.
struct EffectLookup {
    heads: usize
    next: Vec[usize]
}

fn effect_key(module_name: str, owner: str, name: str) -> str {
    ret module_name + "\n" + owner + "\n" + name
}

fn effect_lookup(effects: Vec[FunctionSafety]) -> EffectLookup {
    let heads = unsafe {
        encore_strmap_new()
    }
    let mut next = Vec[usize]::new()
    for effect in effects {
        let key = effect_key(effect.module_name, effect.owner, effect.name)
        next.push(unsafe {
                encore_strmap_get(heads, key)
            }
        )
        unsafe {
            encore_strmap_put(heads, key, next.len())
        }
    }
    ret EffectLookup { heads, next }
}

struct SafetyContext {
    function: SafetyFunction
    effects: Vec[FunctionSafety]
    bindings: Vec[(str, CallableValue)]
    executed: bool
    returned: bool
    dependencies: Vec[(str, str, str)]
    lookup: EffectLookup
}

/// Collects resolved declarations without recursively asking for their effects.
pub fn safety_dependencies(function: SafetyFunction) -> Vec[(str, str, str)] {
    let mut ctx = SafetyContext {
        function, Vec[FunctionSafety]::new(), Vec[(str, CallableValue)]::new(), false, false, Vec[(str, str, str)]::new(),
        EffectLookup { 0, Vec[usize]::new() }
    }
    for param in function.item.params {
        ctx.bindings.push((param.name, unknown_value()))
    }
    match function.item.body {
        Some(body) => {
            statements(ctx, body.statements)
        }
        None => {
        }
    }
    ret ctx.dependencies
}

/// Monotone least fixed point, including recursive strongly connected components.
pub fn infer_safety(functions: Vec[SafetyFunction]) -> Vec[FunctionSafety] {
    ret infer_safety_with_known(functions, Vec[FunctionSafety]::new())
}

/// Reuses already closed dependency subgraphs from the same source revision.
pub fn infer_safety_with_known(functions: Vec[SafetyFunction], known: Vec[FunctionSafety]) -> Vec[FunctionSafety] {
    let mut effects = Vec[FunctionSafety]::new()
    for function in functions {
        let mut safe = false
        for attr in function.item.attrs {
            if attr == "safe" || attr == "attr:safe" {
                safe = true
            }
        }
        effects.push(FunctionSafety {
                function.module_name, function.owner, function.item.name, function.symbol_line,
                function.symbol_column, function.item.is_extern || function.item.body.is_none() || function.item.decorators.len() > 0_usize,
                safe, function.item.is_extern || function.item.body.is_none() || function.item.decorators.len() > 0_usize
            }
            ,)
    }
    effects.extend(known)
    let lookup = effect_lookup(effects)
    let result = infer_indexed_safety(functions, effects, lookup)
    unsafe {
        encore_strmap_free(lookup.heads)
    }
    ret result
}

pub struct SafetyReplayResult {
    effects: Vec[FunctionSafety]
    replay: Json
    checked: usize
    reused: usize
}

struct SafetyReplayNode {
    slot: str
    input: str
    dependencies: Vec[(str, str, str)]
    effect: FunctionSafety
    valid: bool
}

fn safety_effect_site(effect: FunctionSafety) -> str {
    ret effect.module_name + "\n" + effect.owner + "\n" + effect.name + "\n" + Debug::fmt(effect.line) + ":" + Debug::fmt(effect.column)
}

fn safety_effect_record(effect: FunctionSafety) -> Json {
    ret Json::Array(vec![Json::String(effect.module_name), Json::String(effect.owner), Json::String(effect.name),
            Json::Bool(effect.body_unsafe), Json::Bool(effect.asserted_safe), Json::Bool(effect.returns_unsafe_callable)])
}

/// Reuses closed effects only outside the reverse dependency closure of a
/// changed input. Recomputed recursive components start at lattice bottom,
/// never at their previous unsafe value, so unsafe-to-safe edits converge too.
pub fn infer_safety_with_replay(functions: Vec[SafetyFunction], known: Vec[FunctionSafety],
    contexts: Vec[(str, str)], previous: Json,) -> SafetyReplayResult {
    let mut external = Vec[Json]::new()
    for effect in known {
        external.push(safety_effect_record(effect))
    }
    let external_key = compiler_content_digest(stringify(Json::Array(external)))
    let ordinals = unsafe {
        encore_strmap_new()
    }
    let mut nodes = Vec[SafetyReplayNode]::new()
    let mut initial = Vec[FunctionSafety]::new()
    for function in functions {
        let family = effect_key(function.module_name, function.owner, function.item.name)
        let ordinal = unsafe {
            encore_strmap_get(ordinals, family)
        }
        unsafe {
            encore_strmap_put(ordinals, family, ordinal + 1_usize)
        }
        let slot = family + "\n" + Debug::fmt(ordinal)
        let mut context = ""
        for entry in contexts {
            if entry.0 == function.module_name {
                context = entry.1 break
            }
        }
        let input = compiler_content_digest("encore-safety-function-1\n" + context + "\n" + external_key + "\n" +
            function.owner + "\n" + stringify(encode_lowered_function_input(function.item, function.module_name)))
        let saved = previous.get(slot).unwrap_or(Json::Null)
        let mut valid = !context.is_empty() && saved.get("input").unwrap_or(Json::Null).as_str().unwrap_or("") == input
        let mut dependencies = Vec[(str, str, str)]::new()
        match saved.get("dependencies").unwrap_or(Json::Null) {
            Json::Array(rows) => {
                for row in rows {
                    let values = row.as_array().unwrap_or(Vec[Json]::new())
                    let module = values.get(0).unwrap_or(Json::Null).as_str()
                    let owner = values.get(1).unwrap_or(Json::Null).as_str()
                    let name = values.get(2).unwrap_or(Json::Null).as_str()
                    if values.len() != 3_usize || module.is_none() || owner.is_none() || name.is_none() {
                        valid = false break
                    }
                    dependencies.push((module.unwrap_or(""), owner.unwrap_or(""), name.unwrap_or("")))
                }
            }
            _ => {
                valid = false
            }
        }
        let body = saved.get("body_unsafe").unwrap_or(Json::Null).as_bool()
        let asserted = saved.get("asserted_safe").unwrap_or(Json::Null).as_bool()
        let returned = saved.get("returns_unsafe_callable").unwrap_or(Json::Null).as_bool()
        valid = valid && body.is_some() && asserted.is_some() && returned.is_some()
        if !valid {
            dependencies = safety_dependencies(function)
        }
        let effect = FunctionSafety {
            function.module_name, function.owner, function.item.name, function.symbol_line,
            function.symbol_column, body.unwrap_or(false), asserted.unwrap_or(false), returned.unwrap_or(false)
        }
        initial.push(effect)
        nodes.push(SafetyReplayNode { slot, input, dependencies, effect, valid })
    }
    unsafe {
        encore_strmap_free(ordinals)
    }
    initial.extend(known)
    let lookup = effect_lookup(initial)
    let mut dependents = Vec[Vec[usize]]::new()
    let mut queue = Vec[usize]::new()
    for index in 0_usize..nodes.len() {
        dependents.push(Vec[usize]::new())
        let invalid = !nodes.get_unchecked_borrowed(index).valid
        if invalid {
            queue.push(index)
        }
    }
    for consumer in 0_usize..nodes.len() {
        for dependency in nodes.get_unchecked_borrowed(consumer).dependencies {
            let mut encoded = unsafe {
                encore_strmap_get(lookup.heads, effect_key(dependency.0, dependency.1, dependency.2))
            }
            while encoded != 0_usize {
                let source = encoded - 1_usize
                if source < nodes.len() {
                    let mut values = dependents.get(source).unwrap_or(Vec[usize]::new())
                    values.push(consumer)
                    dependents.set(source, values)
                }
                encoded = lookup.next.get(source).unwrap_or(0_usize)
            }
        }
    }
    unsafe {
        encore_strmap_free(lookup.heads)
    }
    let resolved = if queue.len() == functions.len() {
        (infer_safety_with_known(functions, known), functions.len())
    } else {
        infer_safety_components(functions, known, nodes, dependents)
    }
    let computed = resolved.0
    let checked = resolved.1
    let positions = unsafe {
        encore_strmap_new()
    }
    let mut index = 0_usize
    for effect in computed {
        unsafe {
            encore_strmap_put(positions, safety_effect_site(effect), index + 1_usize)
        }
        index += 1_usize
    }
    let mut effects = Vec[FunctionSafety]::new()
    let mut records = Vec[(str, Json)]::new()
    for node in nodes {
        let position = unsafe {
            encore_strmap_get(positions, safety_effect_site(node.effect))
        }
        if position == 0_usize {
            unsafe {
                encore_strmap_free(positions)
            }
            ret SafetyReplayResult {
                infer_safety_with_known(functions, known), Json::Null, functions.len(), 0_usize
            }
        }
        let effect = computed.get(position - 1_usize).unwrap_or(node.effect)
        effects.push(effect)
        let mut dependencies = Vec[Json]::new()
        for dependency in node.dependencies {
            dependencies.push(Json::Array(vec![Json::String(dependency.0), Json::String(dependency.1), Json::String(dependency.2)]))
        }
        records.push((node.slot, Json::Object(vec![("input", Json::String(node.input)),("dependencies", Json::Array(dependencies)),
                        ("body_unsafe", Json::Bool(effect.body_unsafe)),("asserted_safe", Json::Bool(effect.asserted_safe)),
                        ("returns_unsafe_callable", Json::Bool(effect.returns_unsafe_callable))])))
    }
    unsafe {
        encore_strmap_free(positions)
    }
    effects.extend(known)
    ret SafetyReplayResult { effects, Json::Object(records), checked, functions.len() - checked }
}

/// Iterative Kosaraju traversal avoids native stack growth on long call chains.
fn safety_graph_components(graph: Vec[Vec[usize]]) -> Vec[Vec[usize]] {
    let mut transpose = Vec[Vec[usize]]::new()
    let mut visited = Vec[bool]::new()
    for _index in 0_usize..graph.len() {
        transpose.push(Vec[usize]::new()) visited.push(false)
    }
    for source in 0_usize..graph.len() {
        for target in graph.get_unchecked_borrowed(source) {
            let mut reverse = Vec[usize]::new()
            reverse.extend(transpose.get(target).unwrap_or(Vec[usize]::new()))
            reverse.push(source)
            transpose.set(target, reverse)
        }
    }
    let mut order = Vec[usize]::new()
    for root in 0_usize..graph.len() {
        if visited.get(root).unwrap_or(true) {
            continue
        }
        let mut stack = Vec[(usize, usize)]::new()
        stack.push((root, 0_usize)) visited.set(root, true)
        while !stack.is_empty() {
            let cursor = stack.len() - 1_usize
            let frame = stack.get(cursor).unwrap_or((root, 0_usize))
            let edges = graph.get(frame.0).unwrap_or(Vec[usize]::new())
            if frame.1 < edges.len() {
                let child = edges.get(frame.1).unwrap_or(root)
                stack.set(cursor,(frame.0, frame.1 + 1_usize))
                if !visited.get(child).unwrap_or(true) {
                    visited.set(child, true) stack.push((child, 0_usize))
                }
            } else {
                order.push(frame.0) let _removed = stack.pop()
            }
        }
    }
    for index in 0_usize..visited.len() {
        visited.set(index, false)
    }
    let mut components = Vec[Vec[usize]]::new()
    while !order.is_empty() {
        let root = order.pop().unwrap_or(0_usize)
        if visited.get(root).unwrap_or(true) {
            continue
        }
        let mut pending = Vec[usize]::new()
        let mut members = Vec[usize]::new()
        pending.push(root) visited.set(root, true)
        while !pending.is_empty() {
            let node = pending.pop().unwrap_or(root)
            members.push(node)
            for child in transpose.get(node).unwrap_or(Vec[usize]::new()) {
                if !visited.get(child).unwrap_or(true) {
                    visited.set(child, true) pending.push(child)
                }
            }
        }
        components.push(members)
    }
    ret components
}

/// Components are processed callee-first. Only a changed caller-visible effect
/// schedules a clean dependent component; a numerical body edit stays local.
fn infer_safety_components(functions: Vec[SafetyFunction], known: Vec[FunctionSafety],
    nodes: Vec[SafetyReplayNode], dependents: Vec[Vec[usize]],) ->(Vec[FunctionSafety], usize) {
    let components = safety_graph_components(dependents)
    let mut membership = Vec[usize]::new()
    let mut effects = Vec[FunctionSafety]::new()
    for node in nodes {
        membership.push(0_usize) effects.push(node.effect)
    }
    let mut remaining = Vec[usize]::new()
    let mut dirty = Vec[bool]::new()
    for component in 0_usize..components.len() {
        remaining.push(0_usize)
        let mut changed = false
        for node in components.get_unchecked_borrowed(component) {
            membership.set(node, component)
            changed = changed || !nodes.get_unchecked_borrowed(node).valid
        }
        dirty.push(changed)
    }
    for source in 0_usize..nodes.len() {
        let owner = membership.get(source).unwrap_or(0_usize)
        for consumer in dependents.get_unchecked_borrowed(source) {
            let target = membership.get(consumer).unwrap_or(0_usize)
            if target != owner {
                remaining.set(target, remaining.get(target).unwrap_or(0_usize) + 1_usize)
            }
        }
    }
    let mut ready = Vec[usize]::new()
    for component in 0_usize..components.len() {
        if remaining.get(component).unwrap_or(1_usize) == 0_usize {
            ready.push(component)
        }
    }
    let mut cursor = 0_usize
    let mut checked = 0_usize
    while cursor < ready.len() {
        let component = ready.get(cursor).unwrap_or(0_usize)
        cursor += 1_usize
        if dirty.get(component).unwrap_or(true) {
            let mut pending = Vec[SafetyFunction]::new()
            let mut installed = Vec[FunctionSafety]::new()
            installed.extend(known)
            for index in 0_usize..nodes.len() {
                if membership.get(index).unwrap_or(0_usize) == component {
                    pending.push(functions.get_unchecked_borrowed(index))
                } else {
                    installed.push(effects.get_unchecked_borrowed(index))
                }
            }
            checked += pending.len()
            let computed = infer_safety_with_known(pending, installed)
            for index in components.get_unchecked_borrowed(component) {
                let before = effects.get(index).unwrap_or(nodes.get_unchecked_borrowed(index).effect)
                for effect in computed {
                    if safety_effect_site(effect) == safety_effect_site(before) {
                        effects.set(index, effect)
                        if before.is_unsafe() != effect.is_unsafe() || before.returns_unsafe_callable != effect.returns_unsafe_callable {
                            for consumer in dependents.get_unchecked_borrowed(index) {
                                let target = membership.get(consumer).unwrap_or(component)
                                if target != component {
                                    dirty.set(target, true)
                                }
                            }
                        }
                        break
                    }
                }
            }
        }
        for index in components.get_unchecked_borrowed(component) {
            for consumer in dependents.get_unchecked_borrowed(index) {
                let target = membership.get(consumer).unwrap_or(component)
                if target == component {
                    continue
                }
                let count = remaining.get(target).unwrap_or(1_usize) - 1_usize
                remaining.set(target, count)
                if count == 0_usize {
                    ready.push(target)
                }
            }
        }
    }
    effects.extend(known)
    ret(effects, checked)
}

fn infer_indexed_safety(functions: Vec[SafetyFunction], effects: mut Vec[FunctionSafety], lookup: EffectLookup) -> Vec[FunctionSafety] {
    // Declaration resolution is independent of inferred effects. Build the
    // reverse graph once rather than walking every AST on every fixed-point
    // round. Keep all overloads: a call joins their effects conservatively.
    let mut dependents = Vec[Vec[usize]]::new()
    let mut pending = Vec[usize]::new()
    let mut queued = Vec[bool]::new()
    let mut index = 0_usize
    for function in functions {
        dependents.push(Vec[usize]::new())
        pending.push(index)
        queued.push(true)
        index += 1
    }
    index = 0_usize
    for function in functions {
        for dependency in safety_dependencies(function) {
            let mut encoded = unsafe {
                encore_strmap_get(lookup.heads, effect_key(dependency.0, dependency.1, dependency.2))
            }
            while encoded != 0 {
                let source = encoded - 1
                // Known dependency effects are immutable and never scheduled.
                if source < functions.len() {
                    let mut consumers = dependents.get(source).unwrap_or(Vec[usize]::new())
                    let mut present = false
                    for consumer in consumers {
                        if consumer == index {
                            present = true break
                        }
                    }
                    if !present {
                        consumers.push(index) dependents.set(source, consumers)
                    }
                }
                encoded = lookup.next.get(source).unwrap_or(0)
            }
        }
        index += 1
    }
    let mut cursor = 0_usize
    while cursor < pending.len() {
        let index = pending.get(cursor).unwrap_or(functions.len())
        cursor += 1
        queued.set(index, false)
        match functions.get(index) {
            Some(function) => {
                let before = match effects.get(index) {
                    Some(value) => value None => {
                        ret effects
                    }
                }
                let mut ctx = SafetyContext {
                    function, effects, Vec[(str, CallableValue)]::new(), before.body_unsafe, before.returns_unsafe_callable, Vec[(str, str, str)]::new(), lookup
                }
                for param in function.item.params {
                    ctx.bindings.push((param.name, unknown_value()))
                }
                match function.item.body {
                    Some(body) => {
                        statements(ctx, body.statements)
                    }
                    None => {
                    }
                }
                if ctx.executed != before.body_unsafe || ctx.returned != before.returns_unsafe_callable {
                    effects.set(index, FunctionSafety {
                            before.module_name, before.owner, before.name,
                            before.line, before.column, ctx.executed, before.asserted_safe, ctx.returned
                        }
                        ,)
                    for consumer in dependents.get(index).unwrap_or(Vec[usize]::new()) {
                        if !queued.get(consumer).unwrap_or(true) {
                            queued.set(consumer, true)
                            pending.push(consumer)
                        }
                    }
                }
            }
            None => {
                ret effects
            }
        }
    }
    ret effects
}

#attr(test)
fn semantic_safety_worklist_matches_scan_contract() -> bool {
    let mut source = "extern fn raw() -> u32\n#attr(safe) fn trusted() -> u32 { ret raw() }\n" +
    "fn safe_caller() -> u32 { ret trusted() }\nfn recursive_a() -> u32 { ret recursive_b() }\n" +
    "fn recursive_b() -> u32 { if true { ret raw() } ret recursive_a() }\n" +
    "fn callback() { let operation = raw\noperation() }\nfn plain() -> u32 { ret 1 }\n" +
    "fn foreign_caller() -> u32 { ret foreign() }\nfn pure_foreign_caller() -> u32 { ret pure_foreign() }\n"
    let mut index = 0_usize
    while index < 32 {
        source += "fn chain_" + Debug::fmt(index) + "() -> u32 { ret chain_" + Debug::fmt(index + 1) + "() }\n"
        index += 1
    }
    source += "fn chain_32() -> u32 { ret raw() }\n"
    let document = analyze_named_module("main", "main.enq", source)
    if document.diagnostics.len() != 0 {
        for diagnostic in document.diagnostics {
            eprintln(diagnostic.message)
        }
        ret false
    }
    let mut callables = Vec[SemanticCallable]::new()
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                let mut params = Vec[str]::new()
                for param in item.params {
                    params.push(param.typ.unwrap_or(""))
                }
                let mut is_static = false
                for attr in item.attrs {
                    if attr == "static" {
                        is_static = true
                    }
                }
                callables.push(SemanticCallable {
                        "main", item.name, params, item.ret_type.unwrap_or("void"),
                        0, item.name, "main", 0, Vec[str]::new(), is_static
                    }
                    ,)
            }
            _ => {
            }
        }
    }
    for name in vec!["foreign", "pure_foreign"] {
        callables.push(SemanticCallable {
                "dependency", name, Vec[str]::new(), "u32", 0, name,
                "dependency", 0, Vec[str]::new(), false
            }
        )
    }
    let mut functions = Vec[SafetyFunction]::new()
    for statement in document.ast {
        match statement {
            Statement::Function(item) => {
                let body = check_function_body_with_types(item, callables, Vec[SemanticField]::new(), Vec[SemanticMethod]::new(), "", Vec[str]::new())
                functions.push(SafetyFunction {
                        "main", "", item, body, callables, Vec[SemanticMethod]::new(), item.line, item.column, Vec[str]::new()
                    }
                    ,
                )
            }
            _ => {
            }
        }
    }
    // Immutable dependency effects include overloads whose two flags must
    // both survive the join, plus unrelated modules and method owners.
    let known = vec![
        FunctionSafety { "dependency", "", "foreign", 1, 1, true, false, false },
        FunctionSafety { "dependency", "", "foreign", 2, 1, false, false, true },
        FunctionSafety { "dependency", "", "pure_foreign", 3, 1, false, false, false },
        FunctionSafety { "other", "", "pure_foreign", 4, 1, true, false, true },
        FunctionSafety { "dependency", "Box", "pure_foreign", 5, 1, true, false, true },
    ]
    let actual = infer_safety_with_known(functions, known)
    // Independent reference: the previous full-scan least-fixed-point solver.
    let mut expected = Vec[FunctionSafety]::new()
    for function in functions {
        let mut safe = false
        for attr in function.item.attrs {
            if attr == "safe" || attr == "attr:safe" {
                safe = true
            }
        }
        expected.push(FunctionSafety {
                function.module_name, function.owner, function.item.name,
                function.symbol_line, function.symbol_column, function.item.is_extern || function.item.body.is_none(),
                safe, function.item.is_extern || function.item.body.is_none()
            }
            ,)
    }
    expected.extend(known)
    let mut changed = true
    while changed {
        changed = false
        let mut index = 0_usize
        for function in functions {
            let before = match expected.get(index) {
                Some(value) => value None => {
                    ret false
                }
            }
            let mut ctx = SafetyContext {
                function, expected, Vec[(str, CallableValue)]::new(), before.body_unsafe,
                before.returns_unsafe_callable, Vec[(str, str, str)]::new(), EffectLookup {
                    0, Vec[usize]::new()
                }
            }
            for param in function.item.params {
                ctx.bindings.push((param.name, unknown_value()))
            }
            match function.item.body {
                Some(body) => {
                    statements(ctx, body.statements)
                }
                None => {
                }
            }
            if ctx.executed != before.body_unsafe || ctx.returned != before.returns_unsafe_callable {
                expected.set(index, FunctionSafety {
                        before.module_name, before.owner, before.name, before.line, before.column,
                        ctx.executed, before.asserted_safe, ctx.returned
                    }
                    ,)
                changed = true
            }
            index += 1
        }
    }
    if actual.len() != expected.len() || actual.len() != 47 {
        eprintln("safety reference size: " + Debug::fmt(actual.len()) + " / " + Debug::fmt(expected.len()))
        ret false
    }
    let mut index = 0_usize
    for effect in expected {
        let observed = match actual.get(index) {
            Some(value) => value None => {
                ret false
            }
        }
        if observed.body_unsafe != effect.body_unsafe || observed.asserted_safe != effect.asserted_safe ||
        observed.returns_unsafe_callable != effect.returns_unsafe_callable {
            eprintln("safety reference mismatch: " + effect.name)
            ret false
        }
        index += 1
    }
    ret true
}

fn unknown_value() -> CallableValue {
    ret CallableValue {
        true, true
    }
}
fn plain_value() -> CallableValue {
    ret CallableValue {
        false, false
    }
}
fn join_value(left: CallableValue, right: CallableValue) -> CallableValue {
    ret CallableValue {
        left.unsafe_call || right.unsafe_call, left.unsafe_result || right.unsafe_result
    }
}
fn without_type_arguments(name: str) -> str {
    let mut out = ""
    let mut depth = 0_usize
    let mut index = 0_usize
    while index < name.char_len() {
        let part = name.slice(index, 1_usize)
        if part == "[" {
            depth += 1_usize
        } elif part == "]" {
            if depth > 0_usize {
                depth -= 1_usize
            }
        } elif depth == 0_usize {
            out += part
        }
        index += 1_usize
    }
    ret out
}
// Binding/Resource instance calls lower through the checked native proxy ABI.
// Resolve the SDK declaration identity so user types with these names keep
// their own safety effects. Loading/reloading a Plugin stays unsafe.
fn plugin_proxy_receiver(ctx: SafetyContext, receiver: str) -> bool {
    // Nominal identities are interned (@N); ordinary receivers need no scan.
    if !receiver.contains("[dyn ") {
        ret false
    }
    for binding in ctx.function.body.type_names {
        if binding.scope == "platform::plugin" &&
        (binding.name == "Binding" || binding.name == "Resource") &&
        semantic_same_owner(receiver, binding.identity) {
            ret true
        }
    }
    ret false
}
fn declaration(ctx: mut SafetyContext, module_name: str, owner: str, name: str) -> CallableValue {
    let dependency =(module_name, owner, name)
    let mut recorded = false
    for existing in ctx.dependencies {
        if existing.0 == module_name && existing.1 == owner && existing.2 == name {
            recorded = true break
        }
    }
    if !recorded {
        ctx.dependencies.push(dependency)
    }
    let mut found = false
    let mut out = plain_value()
    if ctx.lookup.heads != 0 {
        let mut encoded = unsafe {
            encore_strmap_get(ctx.lookup.heads, effect_key(module_name, owner, name))
        }
        while encoded != 0 {
            match ctx.effects.get(encoded - 1) {
                Some(effect) => {
                    found = true
                    out = join_value(out, CallableValue {
                            effect.is_unsafe(), effect.returns_unsafe_callable
                        }
                        ,
                    )
                }
                None => {
                    ret unknown_value()
                }
            }
            encoded = ctx.lookup.next.get(encoded - 1).unwrap_or(0)
        }
        ret if found {
            out
        } else {
            unknown_value()
        }
    }
    // Dependency collection has no effects. The independent reference solver
    // deliberately uses this scan instead of the production index.
    for effect in ctx.effects {
        if effect.module_name == module_name && effect.owner == owner && effect.name == name {
            found = true
            out = join_value(out, CallableValue {
                    effect.is_unsafe(), effect.returns_unsafe_callable
                }
                ,
            )
        }
    }
    ret if found {
        out
    } else {
        unknown_value()
    }
}
fn path_value(ctx: mut SafetyContext, name: str) -> CallableValue {
    let mut index = ctx.bindings.len()
    while index > 0_usize {
        index -= 1_usize
        let binding = match ctx.bindings.get(index) {
            Some(value) => value None => {
                ret unknown_value()
            }
        }
        if binding.0 == name {
            ret binding.1
        }
    }
    let callable_name = without_type_arguments(name)
    for callable in ctx.function.callables {
        if callable.name == callable_name {
            ret declaration(ctx, callable.module_name, "", callable.declaration_name)
        }
    }
    let mut separator = name.len()
    let mut cursor = 0_usize
    let mut depth = 0_usize
    while cursor + 1_usize < name.len() {
        let part = name.slice(cursor, 1_usize)
        if part == "[" {
            depth += 1_usize
        } elif part == "]" && depth > 0_usize {
            depth -= 1_usize
        }
        if depth == 0_usize && name.slice(cursor, 2_usize) == "::" {
            separator = cursor
        }
        cursor += 1_usize
    }
    if separator < name.len() {
        let owner_name = name.slice(0_usize, separator)
        let owner = if owner_name == "Self" {
            scope_type(ctx.function.owner, ctx.function.module_name, ctx.function.body.type_names, Vec[str]::new())
        } else {
            scope_type(owner_name, ctx.function.module_name, ctx.function.body.type_names, Vec[str]::new())
        }
        let method_name = without_type_arguments(name.slice(separator + 2_usize, name.len() - separator - 2_usize))
        let mut out = plain_value()
        let mut found = false
        for member in semantic_associated_members(owner, method_name, ctx.function.methods) {
            found = true
            out = join_value(out, declaration(ctx, member.declaration_module, member.declaration_owner, method_name))
        }
        if found {
            ret out
        }
        let constructor = without_type_arguments(owner) + "::" + method_name
        for known in ctx.function.constructors {
            if known == constructor {
                ret plain_value()
            }
        }
    }
    ret unknown_value()
}
fn scoped(ctx: mut SafetyContext, body: Vec[Statement]) ->() {
    let size = ctx.bindings.len()
    statements(ctx, body)
    while ctx.bindings.len() > size {
        let _ = ctx.bindings.pop()
    }
}
// Includes calls inserted by lowering; these are not visible as Call AST nodes.
fn protocol_call(ctx: mut SafetyContext, receiver: str, name: str) -> str {
    let mut result = ""
    let mut found = false
    let mut members = semantic_named_members(receiver, name, Vec[SemanticField]::new(), ctx.function.methods)
    members.extend(semantic_associated_members(receiver, name, ctx.function.methods))
    for member in members {
        if member.is_method {
            found = true
            if !plugin_proxy_receiver(ctx, receiver) {
                let value = declaration(ctx, member.declaration_module, member.declaration_owner, name)
                ctx.executed = ctx.executed || value.unsafe_call
            }
            result = member.typ
        }
    }
    if !found {
        ctx.executed = true
    }
    ret result
}
fn implicit_calls(ctx: mut SafetyContext, line: usize, column: usize, operation: str) ->() {
    for site in ctx.function.body.implicit_receivers {
        if site.0 != line || site.1 != column || site.2 != operation {
            continue
        }
        if operation == "binary" {
            let _ = protocol_call(ctx, site.3, "op")
        }
        if operation == "for" {
            let conversions = semantic_named_members(site.3, "into_iter", Vec[SemanticField]::new(), ctx.function.methods)
            let mut iterator = site.3
            if conversions.len() > 0_usize {
                iterator = protocol_call(ctx, site.3, "into_iter")
            }
            let _ = protocol_call(ctx, iterator, "next")
        }
        if operation == "with" {
            let _ = protocol_call(ctx, site.3, "with_enter")
            let _ = protocol_call(ctx, site.3, "with_exit")
        }
    }
}
fn statements(ctx: mut SafetyContext, body: Vec[Statement]) ->() {
    for statement in body {
        match statement {
            Statement::Let(item) => {
                let value = expression(ctx, item.expr.value, item.expr.line, item.expr.column)
                ctx.bindings.push((item.name, if item.is_mut {
                            unknown_value()
                        } else {
                            value
                        }
                        ,
                    ))
            }
            Statement::Ret(item) => {
                let value = expression(ctx, item.value, item.line, item.column)
                ctx.returned = ctx.returned || value.unsafe_call
            }
            Statement::Expr(item) => {
                let _ = expression(ctx, item.value, item.line, item.column)
            }
            Statement::Unsafe(block) => {
                ctx.executed = true scoped(ctx, block.statements)
            }
            // Opaque EHIR can contain raw calls even without an unsafe block.
            Statement::Ehir(item) => {
                ctx.executed = true
            }
            Statement::Function(item) => {
                ctx.bindings.push((item.name, unknown_value()))
            }
            Statement::Assignment(item) => {
                let value = expression(ctx, item.expr.value, item.expr.line, item.expr.column)
                let _ = expression(ctx, item.target.value, item.target.line, item.target.column)
                match item.target.value {
                    Expr::Path(name) => {
                        let mut index = ctx.bindings.len()
                        while index > 0_usize {
                            index -= 1_usize
                            let previous = ctx.bindings.get(index).unwrap_or((name, unknown_value()))
                            if previous.0 == name {
                                ctx.bindings.set(index,(name, join_value(previous.1, value)))
                                break
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            Statement::If(item) => {
                for branch in item.branches {
                    let _ = expression(ctx, branch.condition.value, branch.condition.line, branch.condition.column)
                    scoped(ctx, branch.body.statements)
                }
                match item.else_body {
                    Some(body) => {
                        scoped(ctx, body.statements)
                    }
                    None => {
                    }
                }
            }
            Statement::Match(item) => {
                let _ = expression(ctx, item.expr.value, item.expr.line, item.expr.column)
                for arm in item.arms {
                    let size = ctx.bindings.len()
                    match arm.pattern.binding {
                        Some(name) => {
                            ctx.bindings.push((name, unknown_value()))
                        }
                        None => {
                        }
                    }
                    match arm.body {
                        MatchArmBody::Block(body) => {
                            scoped(ctx, body.statements)
                        }
                        MatchArmBody::Expr(expr) => {
                            let _ = expression(ctx, expr.value, expr.line, expr.column)
                        }
                    }
                    while ctx.bindings.len() > size {
                        let _ = ctx.bindings.pop()
                    }
                }
            }
            Statement::While(item) => {
                let _ = expression(ctx, item.condition.value, item.condition.line, item.condition.column)
                scoped(ctx, item.body.statements)
            }
            Statement::DoWhile(item) => {
                scoped(ctx, item.body.statements)
                let _ = expression(ctx, item.condition.value, item.condition.line, item.condition.column)
            }
            Statement::Loop(item) => {
                scoped(ctx, item.body.statements)
            }
            Statement::For(item) => {
                let _ = expression(ctx, item.iterable.value, item.iterable.line, item.iterable.column)
                implicit_calls(ctx, item.iterable.line, item.iterable.column, "for")
                let size = ctx.bindings.len()
                ctx.bindings.push((item.name, unknown_value()))
                scoped(ctx, item.body.statements)
                while ctx.bindings.len() > size {
                    let _ = ctx.bindings.pop()
                }
            }
            Statement::With(item) => {
                let _ = expression(ctx, item.expr.value, item.expr.line, item.expr.column)
                implicit_calls(ctx, item.expr.line, item.expr.column, "with")
                let size = ctx.bindings.len()
                ctx.bindings.push((item.name, unknown_value()))
                scoped(ctx, item.body.statements)
                while ctx.bindings.len() > size {
                    let _ = ctx.bindings.pop()
                }
            }
            _ => {
            }
        }
    }
}
fn expressions(ctx: mut SafetyContext, items: Vec[ExprNode]) -> CallableValue {
    let mut out = plain_value()
    for item in items {
        out = join_value(out, expression(ctx, item.value, item.line, item.column))
    }
    ret out
}
fn expression(ctx: mut SafetyContext, expr: Expr, line: usize, column: usize) -> CallableValue {
    match expr {
        Expr::Path(name) => {
            ret path_value(ctx, name)
        }
        Expr::Unsafe(body) => {
            ctx.executed = true scoped(ctx, body.statements) ret unknown_value()
        }
        Expr::Call(call) => {
            let callee = expression(ctx, call.callee.value, call.callee.line, call.callee.column)
            let _ = expressions(ctx, call.args)
            ctx.executed = ctx.executed || callee.unsafe_call
            ret CallableValue {
                callee.unsafe_result, true
            }
        }
        Expr::MethodCall(call) => {
            let receiver_value = expression(ctx, call.receiver.value, call.receiver.line, call.receiver.column)
            let _ = expressions(ctx, call.args)
            let receiver = ctx.function.body.canonical_member_receiver_at(line, column)
            let members = semantic_named_members(receiver, call.method, Vec[SemanticField]::new(), ctx.function.methods)
            let mut value = plain_value()
            let mut found = false
            let checked_proxy = plugin_proxy_receiver(ctx, receiver)
            for member in members {
                if member.is_method {
                    found = true
                    if !checked_proxy {
                        value = join_value(value, declaration(ctx, member.declaration_module, member.declaration_owner, call.method))
                    }
                }
            }
            if !found {
                value = if call.method == "call" {
                    receiver_value
                } else {
                    unknown_value()
                }
            }
            ctx.executed = ctx.executed || value.unsafe_call
            ret CallableValue {
                value.unsafe_result, true
            }
        }
        Expr::Closure(closure) => {
            let mut bindings = Vec[(str, CallableValue)]::new()
            for binding in ctx.bindings {
                bindings.push(binding)
            }
            for param in closure.params {
                bindings.push((param.name, unknown_value()))
            }
            let mut nested = SafetyContext {
                ctx.function, ctx.effects, bindings, false, false, Vec[(str, str, str)]::new(), ctx.lookup
            }
            let value = expression(nested, closure.body.value, closure.body.line, closure.body.column)
            ctx.dependencies.extend(nested.dependencies)
            ret CallableValue {
                nested.executed, nested.returned || value.unsafe_call
            }
        }
        Expr::Parenthesized(inner) => {
            ret expression(ctx, inner.value, inner.line, inner.column)
        }
        Expr::Await(inner) => {
            ret expression(ctx, inner.value, inner.line, inner.column)
        }
        Expr::Spawn(inner) => {
            ret expression(ctx, inner.value, inner.line, inner.column)
        }
        Expr::Try(inner) => {
            ret expression(ctx, inner.value, inner.line, inner.column)
        }
        Expr::Unary(item) => {
            ret expression(ctx, item.expr.value, item.expr.line, item.expr.column)
        }
        Expr::Cast(item) => {
            ret expression(ctx, item.expr.value, item.expr.line, item.expr.column)
        }
        Expr::Binary(item) => {
            let left = expression(ctx, item.lhs.value, item.lhs.line, item.lhs.column)
            implicit_calls(ctx, line, column, "binary")
            ret join_value(left, expression(ctx, item.rhs.value, item.rhs.line, item.rhs.column))
        }
        Expr::Field(item) => {
            let _ = expression(ctx, item.base.value, item.base.line, item.base.column)
            ret unknown_value()
        }
        Expr::Index(item) => {
            let _ = expression(ctx, item.base.value, item.base.line, item.base.column)
            let _ = expression(ctx, item.index.value, item.index.line, item.index.column)
            ret unknown_value()
        }
        Expr::StructInit(item) => {
            let _ = expressions(ctx, item.values) ret plain_value()
        }
        Expr::VecLiteral(item) => {
            ret expressions(ctx, item.items)
        }
        Expr::ArrayLiteral(item) => {
            ret expressions(ctx, item.items)
        }
        Expr::TupleLiteral(item) => {
            ret expressions(ctx, item.items)
        }
        Expr::ArrayRepeat(item) => {
            ret expression(ctx, item.value.value, item.value.line, item.value.column)
        }
        Expr::Block(block) => {
            let size = ctx.bindings.len()
            statements(ctx, block.statements)
            let value = match block.tail {
                Some(tail) => expression(ctx, tail.value, tail.line, tail.column)
                None => plain_value()
            }
            while ctx.bindings.len() > size {
                let _ = ctx.bindings.pop()
            }
            ret value
        }
        Expr::If(item) => {
            let mut value = plain_value()
            for branch in item.branches {
                let _ = expression(ctx, branch.condition.value, branch.condition.line, branch.condition.column)
                value = join_value(value, expression(ctx, branch.body.value, branch.body.line, branch.body.column))
            }
            ret join_value(value, expression(ctx, item.else_body.value, item.else_body.line, item.else_body.column))
        }
        Expr::Match(item) => {
            let _ = expression(ctx, item.expr.value, item.expr.line, item.expr.column)
            let mut value = plain_value()
            for arm in item.arms {
                let size = ctx.bindings.len()
                match arm.pattern.binding {
                    Some(name) => {
                        ctx.bindings.push((name, unknown_value()))
                    }
                    None => {
                    }
                }
                value = join_value(value, expression(ctx, arm.expr.value, arm.expr.line, arm.expr.column))
                while ctx.bindings.len() > size {
                    let _ = ctx.bindings.pop()
                }
            }
            ret value
        }
        _ => {
            ret plain_value()
        }
    }
}
