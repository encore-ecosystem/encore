fn write_TraitBound(writer: mut SnapshotWriter, value: frozen TraitBound) ->() {
    if !writer_enter(writer) { ret() }
    write_str(writer, value.path)
    write_Vec_str(writer, value.args)
    writer.depth -= 1_usize
}

fn read_TraitBound(reader: mut SnapshotReader) -> Result[TraitBound, str] {
    reader_enter(reader)?
    let value = TraitBound { read_str(reader)?, read_Vec_str(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_TraitStmt(writer: mut SnapshotWriter, value: frozen TraitStmt) ->() {
    if !writer_enter(writer) { ret() }
    write_bool(writer, value.is_public)
    write_str(writer, value.name)
    write_Option_Documentation(writer, value.documentation)
    write_Vec_GenericParam(writer, value.generics)
    write_Vec_str(writer, value.bases)
    write_Vec_FunctionItem(writer, value.methods)
    write_str(writer, value.source_name)
    write_usize(writer, value.line)
    write_usize(writer, value.column)
    write_Vec_str(writer, value.attrs)
    writer.depth -= 1_usize
}

fn read_TraitStmt(reader: mut SnapshotReader) -> Result[TraitStmt, str] {
    reader_enter(reader)?
    let value = TraitStmt { read_bool(reader)?, read_str(reader)?, read_Option_Documentation(reader)?, read_Vec_GenericParam(reader)?, read_Vec_str(reader)?, read_Vec_FunctionItem(reader)?, read_str(reader)?, read_usize(reader)?, read_usize(reader)?, read_Vec_str(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_TupleLiteralExpr(writer: mut SnapshotWriter, value: frozen TupleLiteralExpr) ->() {
    if !writer_enter(writer) { ret() }
    write_Vec_ExprNode(writer, value.items)
    writer.depth -= 1_usize
