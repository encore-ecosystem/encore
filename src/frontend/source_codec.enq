        None => { write_u8(writer, 0_u8) }
    }
    writer.depth -= 1_usize
}

fn read_Option_str(reader: mut SnapshotReader) -> Result[Option[str], str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = if tag == 0_u8 { Option[str]::None } elif tag == 1_u8 { Option[str]::Some(read_str(reader)?) }
        else { ret Result::Err("invalid EHIR optional tag") }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_ParameterDefault(writer: mut SnapshotWriter, value: frozen ParameterDefault) ->() {
    if !writer_enter(writer) { ret() }
    match value {
        Integer(item) => { write_u8(writer, 0_u8) write_str(writer, item) }
        Float(item) => { write_u8(writer, 1_u8) write_str(writer, item) }
        Boolean(item) => { write_u8(writer, 2_u8) write_bool(writer, item) }
        String(item) => { write_u8(writer, 3_u8) write_str(writer, item) }
    }
    writer.depth -= 1_usize
}

fn read_ParameterDefault(reader: mut SnapshotReader) -> Result[ParameterDefault, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => ParameterDefault::Integer(read_str(reader)?)
        1_u8 => ParameterDefault::Float(read_str(reader)?)
        2_u8 => ParameterDefault::Boolean(read_bool(reader)?)
        3_u8 => ParameterDefault::String(read_str(reader)?)
        _ => { ret Result::Err("invalid EHIR variant tag") }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_ParsedBlock(writer: mut SnapshotWriter, value: frozen ParsedBlock) ->() {
    if !writer_enter(writer) { ret() }
    write_Vec_Statement(writer, value.statements)
    write_usize(writer, value.start_line)
    write_usize(writer, value.start_column)
    write_usize(writer, value.end_line)
    write_usize(writer, value.end_column)
    writer.depth -= 1_usize
}

fn read_ParsedBlock(reader: mut SnapshotReader) -> Result[ParsedBlock, str] {
    reader_enter(reader)?
    let value = ParsedBlock { read_Vec_Statement(reader)?, read_usize(reader)?, read_usize(reader)?, read_usize(reader)?, read_usize(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_ParsedEnumVariant(writer: mut SnapshotWriter, value: frozen ParsedEnumVariant) ->() {
    if !writer_enter(writer) { ret() }
    write_str(writer, value.name)
    write_Option_Documentation(writer, value.documentation)
    write_Vec_GenericParam(writer, value.generics)
    write_Vec_NamedField(writer, value.named_fields)
    write_Vec_str(writer, value.tuple_fields)
    write_bool(writer, value.is_tuple)
    write_bool(writer, value.is_unit)
    write_usize(writer, value.line)
    write_usize(writer, value.column)
    writer.depth -= 1_usize
}

fn read_ParsedEnumVariant(reader: mut SnapshotReader) -> Result[ParsedEnumVariant, str] {
    reader_enter(reader)?
    let value = ParsedEnumVariant { read_str(reader)?, read_Option_Documentation(reader)?, read_Vec_GenericParam(reader)?, read_Vec_NamedField(reader)?, read_Vec_str(reader)?, read_bool(reader)?, read_bool(reader)?, read_usize(reader)?, read_usize(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_ParsedMatchArm(writer: mut SnapshotWriter, value: frozen ParsedMatchArm) ->() {
    if !writer_enter(writer) { ret() }
    write_MatchPattern(writer, value.pattern)
    write_MatchArmBody(writer, value.body)
    writer.depth -= 1_usize
}

fn read_ParsedMatchArm(reader: mut SnapshotReader) -> Result[ParsedMatchArm, str] {
    reader_enter(reader)?
    let value = ParsedMatchArm { read_MatchPattern(reader)?, read_MatchArmBody(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_ParsedSourceArtifact(writer: mut SnapshotWriter, value: frozen ParsedSourceArtifact) ->() {
    if !writer_enter(writer) { ret() }
    write_str(writer, value.analysis_name)
    write_FrontendDocument(writer, value.document)
    writer.depth -= 1_usize
}

fn read_ParsedSourceArtifact(reader: mut SnapshotReader) -> Result[ParsedSourceArtifact, str] {
    reader_enter(reader)?
    let value = ParsedSourceArtifact { read_str(reader)?, read_FrontendDocument(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_Statement(writer: mut SnapshotWriter, value: frozen Statement) ->() {
    if !writer_enter(writer) { ret() }
    match value {
        Import(item) => { write_u8(writer, 0_u8) write_ImportStmt(writer, item) }
        EnumItem(item) => { write_u8(writer, 1_u8) write_EnumStmt(writer, item) }
        Struct(item) => { write_u8(writer, 2_u8) write_StructStmt(writer, item) }
        Trait(item) => { write_u8(writer, 3_u8) write_TraitStmt(writer, item) }
        Impl(item) => { write_u8(writer, 4_u8) write_ImplStmt(writer, item) }
        Function(item) => { write_u8(writer, 5_u8) write_FunctionItem(writer, item) }
        Let(item) => { write_u8(writer, 6_u8) write_LetStmt(writer, item) }
        Ret(item) => { write_u8(writer, 7_u8) write_ExprNode(writer, item) }
        Yield(item) => { write_u8(writer, 8_u8) write_ExprNode(writer, item) }
        Expr(item) => { write_u8(writer, 9_u8) write_ExprNode(writer, item) }
        If(item) => { write_u8(writer, 10_u8) write_IfStmt(writer, item) }
        Match(item) => { write_u8(writer, 11_u8) write_MatchStmt(writer, item) }
        Assignment(item) => { write_u8(writer, 12_u8) write_AssignmentStmt(writer, item) }
        While(item) => { write_u8(writer, 13_u8) write_WhileStmt(writer, item) }
        Loop(item) => { write_u8(writer, 14_u8) write_LoopStmt(writer, item) }
        DoWhile(item) => { write_u8(writer, 15_u8) write_DoWhileStmt(writer, item) }
        For(item) => { write_u8(writer, 16_u8) write_ForStmt(writer, item) }
        With(item) => { write_u8(writer, 17_u8) write_WithStmt(writer, item) }
        Unsafe(item) => { write_u8(writer, 18_u8) write_ParsedBlock(writer, item) }
        Ehir(item) => { write_u8(writer, 19_u8) write_EhirStmt(writer, item) }
        Break(item) => { write_u8(writer, 20_u8) write_Option_str(writer, item) }
        Continue(item) => { write_u8(writer, 21_u8) write_Option_str(writer, item) }
    }
    writer.depth -= 1_usize
}

fn read_Statement(reader: mut SnapshotReader) -> Result[Statement, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => Statement::Import(read_ImportStmt(reader)?)
        1_u8 => Statement::EnumItem(read_EnumStmt(reader)?)
        2_u8 => Statement::Struct(read_StructStmt(reader)?)
        3_u8 => Statement::Trait(read_TraitStmt(reader)?)
        4_u8 => Statement::Impl(read_ImplStmt(reader)?)
        5_u8 => Statement::Function(read_FunctionItem(reader)?)
        6_u8 => Statement::Let(read_LetStmt(reader)?)
        7_u8 => Statement::Ret(read_ExprNode(reader)?)
        8_u8 => Statement::Yield(read_ExprNode(reader)?)
        9_u8 => Statement::Expr(read_ExprNode(reader)?)
        10_u8 => Statement::If(read_IfStmt(reader)?)
        11_u8 => Statement::Match(read_MatchStmt(reader)?)
        12_u8 => Statement::Assignment(read_AssignmentStmt(reader)?)
        13_u8 => Statement::While(read_WhileStmt(reader)?)
        14_u8 => Statement::Loop(read_LoopStmt(reader)?)
        15_u8 => Statement::DoWhile(read_DoWhileStmt(reader)?)
        16_u8 => Statement::For(read_ForStmt(reader)?)
        17_u8 => Statement::With(read_WithStmt(reader)?)
        18_u8 => Statement::Unsafe(read_ParsedBlock(reader)?)
        19_u8 => Statement::Ehir(read_EhirStmt(reader)?)
        20_u8 => Statement::Break(read_Option_str(reader)?)
        21_u8 => Statement::Continue(read_Option_str(reader)?)
        _ => { ret Result::Err("invalid EHIR variant tag") }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_StructInitExpr(writer: mut SnapshotWriter, value: frozen StructInitExpr) ->() {
    if !writer_enter(writer) { ret() }
    write_str(writer, value.path)
    write_Vec_ExprNode(writer, value.values)
    writer.depth -= 1_usize
