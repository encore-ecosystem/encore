pub fn encode_snapshot_ParsedSourceArtifact(value: ParsedSourceArtifact, identity: str) -> Result[Vec[u8], str] {
        let mut writer = new_snapshot_writer("ENQSA001", identity)
        write_ParsedSourceArtifact(writer, value)
        unsafe { encore_strmap_free(writer.strings) }
        if writer.failed { ret Result::Err("EHIR snapshot " + writer.failure + " limit (" + Debug::fmt(writer.bytes.len()) + " bytes)") }
        ret Result::Ok(writer.bytes)
    }
    pub fn decode_snapshot_ParsedSourceArtifact(bytes: Vec[u8], identity: str) -> Result[ParsedSourceArtifact, str] {
        let mut reader = new_snapshot_reader(bytes, "ENQSA001", identity)?
        let value = read_ParsedSourceArtifact(reader)?
        if reader.cursor != reader.bytes.len() { ret Result::Err("trailing EHIR snapshot bytes") }
        ret Result::Ok(value)
    }
