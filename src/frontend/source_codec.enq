    let value = StructStmt { read_bool(reader)?, read_str(reader)?, read_Option_Documentation(reader)?, read_Vec_GenericParam(reader)?, read_Vec_NamedField(reader)?, read_Vec_str(reader)?, read_bool(reader)?, read_bool(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_SuggestionApplicability(writer: mut SnapshotWriter, value: frozen SuggestionApplicability) ->() {
    if !writer_enter(writer) { ret() }
    match value {
        MachineApplicable => { write_u8(writer, 0_u8) }
        MaybeIncorrect => { write_u8(writer, 1_u8) }
        HasPlaceholders => { write_u8(writer, 2_u8) }
        Unspecified => { write_u8(writer, 3_u8) }
    }
    writer.depth -= 1_usize
}

fn read_SuggestionApplicability(reader: mut SnapshotReader) -> Result[SuggestionApplicability, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => SuggestionApplicability::MachineApplicable
        1_u8 => SuggestionApplicability::MaybeIncorrect
        2_u8 => SuggestionApplicability::HasPlaceholders
        3_u8 => SuggestionApplicability::Unspecified
        _ => { ret Result::Err("invalid EHIR variant tag") }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_Token(writer: mut SnapshotWriter, value: frozen Token) ->() {
    if !writer_enter(writer) { ret() }
    write_TokenType(writer, value.type)
    write_str(writer, value.value)
    write_usize(writer, value.line)
    write_usize(writer, value.column)
    writer.depth -= 1_usize
}

fn read_Token(reader: mut SnapshotReader) -> Result[Token, str] {
    reader_enter(reader)?
    let value = Token { read_TokenType(reader)?, read_str(reader)?, read_usize(reader)?, read_usize(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_TokenType(writer: mut SnapshotWriter, value: frozen TokenType) ->() {
    if !writer_enter(writer) { ret() }
    match value {
        INTEGER => { write_u8(writer, 0_u8) }
        FLOAT => { write_u8(writer, 1_u8) }
        BOOLEAN => { write_u8(writer, 2_u8) }
        STRING => { write_u8(writer, 3_u8) }
        IDENTIFIER => { write_u8(writer, 4_u8) }
        ONE_LINE_COMMENT => { write_u8(writer, 5_u8) }
        MULTI_LINE_COMMENT => { write_u8(writer, 6_u8) }
        DOC_COMMENT => { write_u8(writer, 7_u8) }
        MODULE_DOC_COMMENT => { write_u8(writer, 8_u8) }
        KW_FN => { write_u8(writer, 9_u8) }
        KW_ASYNC => { write_u8(writer, 10_u8) }
        KW_AWAIT => { write_u8(writer, 11_u8) }
        KW_SPAWN => { write_u8(writer, 12_u8) }
        KW_STRUCT => { write_u8(writer, 13_u8) }
        KW_TRAIT => { write_u8(writer, 14_u8) }
        KW_ENUM => { write_u8(writer, 15_u8) }
        KW_IMPL => { write_u8(writer, 16_u8) }
        KW_FOR => { write_u8(writer, 17_u8) }
        KW_LET => { write_u8(writer, 18_u8) }
        KW_STATIC => { write_u8(writer, 19_u8) }
        KW_MUT => { write_u8(writer, 20_u8) }
        KW_RET => { write_u8(writer, 21_u8) }
        KW_YIELD => { write_u8(writer, 22_u8) }
        KW_WHILE => { write_u8(writer, 23_u8) }
        KW_LOOP => { write_u8(writer, 24_u8) }
        KW_DO => { write_u8(writer, 25_u8) }
        KW_CONTINUE => { write_u8(writer, 26_u8) }
        KW_BREAK => { write_u8(writer, 27_u8) }
        KW_IF => { write_u8(writer, 28_u8) }
        KW_ELIF => { write_u8(writer, 29_u8) }
        KW_ELSE => { write_u8(writer, 30_u8) }
        KW_MATCH => { write_u8(writer, 31_u8) }
        KW_PUB => { write_u8(writer, 32_u8) }
        KW_IMPORT => { write_u8(writer, 33_u8) }
        KW_AS => { write_u8(writer, 34_u8) }
        KW_DYN => { write_u8(writer, 35_u8) }
        KW_EXTERN => { write_u8(writer, 36_u8) }
        KW_UNSAFE => { write_u8(writer, 37_u8) }
        KW_EHIR => { write_u8(writer, 38_u8) }
        KW_WITH => { write_u8(writer, 39_u8) }
        SCOPE => { write_u8(writer, 40_u8) }
        PLUS => { write_u8(writer, 41_u8) }
        MINUS => { write_u8(writer, 42_u8) }
        ASTERISK => { write_u8(writer, 43_u8) }
        POWER => { write_u8(writer, 44_u8) }
        SLASH => { write_u8(writer, 45_u8) }
        PERCENT => { write_u8(writer, 46_u8) }
        EQUAL_EQUAL => { write_u8(writer, 47_u8) }
        BANG_EQUAL => { write_u8(writer, 48_u8) }
        LESS => { write_u8(writer, 49_u8) }
        GREATER => { write_u8(writer, 50_u8) }
        LESS_EQUAL => { write_u8(writer, 51_u8) }
        GREATER_EQUAL => { write_u8(writer, 52_u8) }
        AND_AND => { write_u8(writer, 53_u8) }
        PIPE_PIPE => { write_u8(writer, 54_u8) }
        BANG => { write_u8(writer, 55_u8) }
        AMPERSAND => { write_u8(writer, 56_u8) }
        PIPE => { write_u8(writer, 57_u8) }
        CARET => { write_u8(writer, 58_u8) }
        TILDE => { write_u8(writer, 59_u8) }
        LEFT_SHIFT => { write_u8(writer, 60_u8) }
        RIGHT_SHIFT => { write_u8(writer, 61_u8) }
        ASSIGN => { write_u8(writer, 62_u8) }
        PLUS_EQUAL => { write_u8(writer, 63_u8) }
        MINUS_EQUAL => { write_u8(writer, 64_u8) }
        ASTERISK_EQUAL => { write_u8(writer, 65_u8) }
        POWER_EQUAL => { write_u8(writer, 66_u8) }
        SLASH_EQUAL => { write_u8(writer, 67_u8) }
        PERCENT_EQUAL => { write_u8(writer, 68_u8) }
        AMPERSAND_EQUAL => { write_u8(writer, 69_u8) }
        PIPE_EQUAL => { write_u8(writer, 70_u8) }
        CARET_EQUAL => { write_u8(writer, 71_u8) }
        LEFT_SHIFT_EQUAL => { write_u8(writer, 72_u8) }
        RIGHT_SHIFT_EQUAL => { write_u8(writer, 73_u8) }
        INCREMENT => { write_u8(writer, 74_u8) }
        DECREMENT => { write_u8(writer, 75_u8) }
        QUESTION => { write_u8(writer, 76_u8) }
        HASH => { write_u8(writer, 77_u8) }
        AT => { write_u8(writer, 78_u8) }
        ARROW => { write_u8(writer, 79_u8) }
        FAT_ARROW => { write_u8(writer, 80_u8) }
        LEFT_PAREN => { write_u8(writer, 81_u8) }
        RIGHT_PAREN => { write_u8(writer, 82_u8) }
        LEFT_BRACE => { write_u8(writer, 83_u8) }
        RIGHT_BRACE => { write_u8(writer, 84_u8) }
        LEFT_BRACKET => { write_u8(writer, 85_u8) }
        RIGHT_BRACKET => { write_u8(writer, 86_u8) }
        SEMICOLON => { write_u8(writer, 87_u8) }
        COLON => { write_u8(writer, 88_u8) }
        COMMA => { write_u8(writer, 89_u8) }
        DOT => { write_u8(writer, 90_u8) }
        QUOTE => { write_u8(writer, 91_u8) }
        WHITESPACE => { write_u8(writer, 92_u8) }
        NEWLINE => { write_u8(writer, 93_u8) }
        EOF => { write_u8(writer, 94_u8) }
        UNKNOWN => { write_u8(writer, 95_u8) }
    }
    writer.depth -= 1_usize
}

