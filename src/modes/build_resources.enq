//! Conservative learned package admission; measurements are not cache identities.

import core::fmt::Debug
import core::option::Option
import core::result::Result
import json::{Json, parse, stringify}
import std::os::{read_file, file_sha256}
import std::path::Path
import std::vec::Vec
import refrain::cache_identity::compiler_content_digest
import mod::build_metadata::MetadataContext
import mod::build_cache::{try_unit_cache_lock, close_unit_cache_lock}

extern fn encore_compiler_write_atomic(path: str, contents: str) -> bool

pub struct UnitResourceEstimate {
    memory_bytes: u64
    weight_ms: u64
}

pub fn estimate_unit_resources(context: MetadataContext, cache: Option[Path]) -> UnitResourceEstimate {
    let minimum = 1610612736_u64
    match cache {
        Some(root) => {
            let path = root.join(resource_key(context) + ".resources")
            let text = read_file(path.as_str())
            if compiler_content_digest(text) != read_file(root.join(resource_key(context) + ".resources.sha256").as_str()) {
                ret UnitResourceEstimate{minimum, 0}
            }
            let data = parse(text).unwrap_or(Json::Null)
            if data.get("schema").unwrap_or(Json::Null).as_number().unwrap_or("") != "1" { ret UnitResourceEstimate{minimum, 0} }
            let memory = positive(data.get("memory_bytes").unwrap_or(Json::Null).as_number().unwrap_or(""))
            let weight = positive(data.get("weight_ms").unwrap_or(Json::Null).as_number().unwrap_or(""))
            ret UnitResourceEstimate{if memory > minimum { memory } else { minimum }, weight}
        }
        None => { ret UnitResourceEstimate{minimum, 0} }
    }
}

/// Keep the larger observed memory estimate when two builds race. A busy
/// measurement lock may skip an update; it must never delay executable work.
#attr(safe)
pub fn record_unit_resources(context: MetadataContext, root: Path, peak: u64, elapsed: u64) -> Result[(), str] {
    let key = resource_key(context)
    let lock = match try_unit_cache_lock(root, key)? { Some(value) => value None => { ret Result[(), str]::Ok(()) } }
    let result = write_resource_record(context, root, key, peak, elapsed)
    close_unit_cache_lock(lock)
    ret result
}

#attr(safe)
fn write_resource_record(context: MetadataContext, root: Path, key: str, peak: u64, elapsed: u64) -> Result[(), str] {
    let previous = estimate_unit_resources(context, Option[Path]::Some(root))
    let padded = if peak <= 14757395258967641292_u64 { peak + peak / 4 } else { 18446744073709551615_u64 }
    let memory = if padded > previous.memory_bytes { padded } else { previous.memory_bytes }
    let mut fields = Vec[(str, Json)]::new()
    fields.push(("schema", Json::Number("1")))
    fields.push(("memory_bytes", Json::Number(Debug::fmt(memory))))
    fields.push(("weight_ms", Json::Number(Debug::fmt(elapsed))))
    let text = stringify(Json::Object(fields))
    let path = root.join(key + ".resources")
    let digest = compiler_content_digest(text)
    if !unsafe { encore_compiler_write_atomic(path.as_str(), text) } || file_sha256(path.as_str()) != digest ||
        !unsafe { encore_compiler_write_atomic(root.join(key + ".resources.sha256").as_str(), digest) } {
        ret Result[(), str]::Err("cannot record package resource estimate")
    }
    ret Result[(), str]::Ok(())
}

fn resource_key(context: MetadataContext) -> str {
    let mut fields = Vec[Json]::new()
    fields.push(Json::String("encore-unit-resources-1")) fields.push(Json::String(context.unit))
    fields.push(Json::String(context.compiler_digest)) fields.push(Json::String(context.target))
    fields.push(Json::String(context.profile))
    // This is a scheduling hint only. Hashing the canonical context features
    // keeps different capability/configuration sets out of the same model.
    fields.push(context.encode().unwrap_or(Json::Null).get("features").unwrap_or(Json::Null))
    ret compiler_content_digest(stringify(Json::Array(fields)))
}

pub fn resource_positive(text: str) -> u64 { ret positive(text) }

fn positive(text: str) -> u64 {
    let mut value = 0_u64
    let mut cursor = 0_usize
    while cursor < text.byte_len() {
        let byte = text.byte_at(cursor)
        if byte < 48 || byte > 57 { ret 0 }
        let digit = (byte - 48) as u64
        if value > (18446744073709551615_u64 - digit) / 10 { ret 0 }
        value = value * 10 + digit
        cursor += 1
    }
    ret value
}

#attr(test)
fn metadata_resource_numeric_overflow_contract() -> bool {
    ret positive("18446744073709551615") == 18446744073709551615_u64 &&
        positive("18446744073709551616") == 0 && positive("-1") == 0 &&
        positive("123x") == 0 && positive("") == 0 && positive("1610612736") == 1610612736_u64
}

#attr(test)
fn metadata_resource_unknown_baseline_contract() -> bool {
    let context = MetadataContext{"sample", compiler_content_digest("compiler"), "x86_64-unknown-linux-gnu",
        "dev", compiler_content_digest("source"), Vec[str]::new()}
    let estimate = estimate_unit_resources(context, Option[Path]::None)
    ret estimate.memory_bytes == 1610612736_u64 && estimate.weight_ms == 0
}
