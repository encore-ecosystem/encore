//! Provides the `target_info` module.

import core::fmt::Debug
import std::io::eprintln
import core::option::Option
import std::io::println
import argparse::process_arg
import refrain::target::{TargetSpec, host_target, parse_target, target_is_supported}
import refrain::target::kits::{install_target_kit, target_kit_installed, target_kit_root}

/// Performs the `show_target_info` operation.
pub fn show_target_info() -> u32 {
    match argv(2_usize) {
        Some(value) => { if value == "install" { ret install_target_kit() } }
        None => {}
    }
    let mut target = host_target()
    match argv(2_usize) {
        Option[str]::Some(value) => {
            if value == "show" {
                match argv(3_usize) { Some(triple) => { target = parse_target(triple) } None => {} }
            } elif value != "list" { target = parse_target(value) }
        }
        Option[str]::None => {}
    }
    match argv(2_usize) {
        Option[str]::Some(value) => { if value == "list" { print_known_targets() ret 0_u32 } }
        Option[str]::None => {}
    }
    if !target_is_supported(target) {
        eprintln("Error: unsupported target architecture '" + target.arch + "' in '" + target.triple + "'")
        ret 1_u32
    }
    print_target(target)
    ret 0_u32
}

fn print_target(target: TargetSpec) -> () {
    let environment = if target.environment == "" { "none" } else { target.environment }
    println("Target:        " + target.triple)
    println("Architecture:  " + target.arch)
    println("OS:            " + target.os)
    println("Environment:   " + environment)
    println("Family:        " + target.family)
    println("Pointer width: " + Debug::fmt(target.pointer_width))
    println("Endianness:    " + target.endian)
    println("Freestanding:  " + Debug::fmt(target.freestanding))
    println("Kit installed: " + Debug::fmt(target_kit_installed(target)))
    println("Kit path:      " + target_kit_root(target).as_str())
    ret ()
}

fn print_known_targets() -> () {
    println("x86_64-unknown-linux-gnu")
    println("aarch64-unknown-linux-gnu")
    println("x86_64-apple-darwin")
    println("aarch64-apple-darwin")
    println("x86_64-pc-windows-msvc")
    println("x86_64-w64-windows-gnu")
    println("aarch64-w64-windows-gnu")
    println("thumbv6m-none-eabi")
    println("thumbv7m-none-eabi")
    println("thumbv7em-none-eabi")
    println("thumbv7em-none-eabihf")
    println("riscv32imac-unknown-none-elf")
    ret ()
}

fn argv(index: usize) -> Option[str] { ret process_arg(index) }
