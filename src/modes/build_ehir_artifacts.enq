//! Typed package snapshots separate provenance from portable EHIR contents.
import std::vec::Vec
import json::{Json, stringify}

import mod::build_metadata::MetadataContext
import refrain::cache_identity::compiler_content_digest

/// Templates follow compiler, ABI and features. Ordinary source receipts belong
/// to UnitReady and must not change the bytes of an unchanged template bundle.
pub fn template_snapshot_key(context: MetadataContext) -> str {
    let mut features = Vec[Json]::new()
    for feature in context.features {
        features.push(Json::String(feature))
    }
    ret compiler_content_digest(stringify(Json::Array(vec![Json::String("encore-typed-templates-1"),
                    Json::String(context.compiler_digest), Json::String(context.unit), Json::String(context.target),
                    Json::String(context.profile), Json::Array(features)])))
}
