//! Physical cache encoding; receipts and compiler identities hash decoded bytes.
import core::result::Result

import std::path::Path

import refrain::cache_identity::compiler_content_digest

extern fn encore_compiler_cache_read(path: str, packed: bool, expected: str) -> str
extern fn encore_compiler_cache_read_valid(value: str) -> bool
extern fn encore_compiler_cache_encode(contents: str, digest: str, packed: bool) -> str
extern fn encore_compiler_write_atomic(path: str, contents: str) -> bool

#attr(safe)
pub fn read_payload(path: Path) -> str {
    unsafe {
        ret encore_compiler_cache_read(path.as_str(), false, "")
    }
}

#attr(safe)
pub fn read_packed_payload(path: Path) -> str {
    unsafe {
        ret encore_compiler_cache_read(path.as_str(), true, "")
    }
}

#attr(safe)
pub fn verified_payload(path: Path, expected: str) -> Result[str, str] {
    if expected.byte_len() != 64_usize {
        ret Result::Err("missing or corrupt cache payload: " + path.as_str())
    }
    let text = unsafe {
        encore_compiler_cache_read(path.as_str(), false, expected)
    }
    if !unsafe {
        encore_compiler_cache_read_valid(text)
    }
    {
        ret Result::Err("missing or corrupt cache payload: " + path.as_str())
    }
    ret Result::Ok(text)
}

#attr(safe)
pub fn write_payload(path: Path, contents: str, packed: bool) -> bool {
    ret write_verified_payload(path, contents, compiler_content_digest(contents), packed)
}

/// Caller already validated these exact immutable bytes against this digest.
#attr(safe)
pub fn write_verified_payload(path: Path, contents: str, digest: str, packed: bool) -> bool {
    let encoded = unsafe {
        encore_compiler_cache_encode(contents, digest, packed)
    }
    if !unsafe {
        encore_compiler_cache_read_valid(encoded)
    }
    {
        ret false
    }
    unsafe {
        ret encore_compiler_write_atomic(path.as_str(), encoded)
    }
}
