import mod::cache_payload::{verified_payload, write_verified_payload}
import mod::cache_policy::{record_cache_usage, touch_cache}
//! Verified package cache transactions; an OS lock owns each content key.

import core::option::Option
import core::result::Result

import std::os::{file_exists, mkdir_all, read_file, remove_file, write_file}
import std::path::Path
import std::time::perf_counter_ms
import std::vec::Vec

import mod::build_artifacts::{UnitReady, ValidatedUnitSnapshot, encode_unit_complete, read_unit_complete, read_unit_completion_receipt, read_unit_snapshot, verify_validated_unit_copy}
import mod::build_metadata::{MetadataContext, MetadataDependency}
import refrain::cache_identity::compiler_content_digest

extern fn encore_compiler_cache_lock_open(path: str) -> usize
extern fn encore_compiler_cache_lock_try(lock: usize) -> i32
extern fn encore_compiler_cache_lock_close(lock: usize) ->()
extern fn encore_compiler_write_atomic(path: str, contents: str) -> bool

/// The coordinator retains this handle until a worker is reaped and its
/// complete result is committed, or until cancellation has reaped every child.
pub struct UnitCacheLock {
    directory: Path
    handle: usize
}

/// Contention is not an error or a resource reservation. Poll other units
/// before retrying this key; no CPU or RAM lease is held while waiting.
#attr(safe)
pub fn try_unit_cache_lock(root: Path, key: str) -> Result[Option[UnitCacheLock], str] {
    if !root.is_absolute() || !valid_key(key) {
        ret Result[Option[UnitCacheLock], str]::Err("invalid package cache location")
    }
    if mkdir_all(root.as_str()) != 0 {
        ret Result[Option[UnitCacheLock], str]::Err("cannot create package cache root")
    }
    let handle = unsafe {
        encore_compiler_cache_lock_open(root.join(key + ".lock").as_str())
    }
    if handle == 0 {
        ret Result[Option[UnitCacheLock], str]::Err("cannot open package cache lock")
    }
    let status = unsafe {
        encore_compiler_cache_lock_try(handle)
    }
    if status == 1 {
        ret Result[Option[UnitCacheLock], str]::Ok(Option[UnitCacheLock]::Some(UnitCacheLock {
                    root.join(key), handle
                }
                ,
            ))
    }
    unsafe {
        encore_compiler_cache_lock_close(handle)
    }
    if status == 0 {
        ret Result[Option[UnitCacheLock], str]::Ok(Option[UnitCacheLock]::None)
    }
    ret Result[Option[UnitCacheLock], str]::Err("cannot acquire package cache lock")
}

#attr(safe)
pub fn close_unit_cache_lock(lock: UnitCacheLock) ->() {
    unsafe {
        encore_compiler_cache_lock_close(lock.handle)
    }
}

/// A corrupt or incomplete entry is a miss, never compiler input. Hydrate a
/// private build snapshot while locked so later users cannot alter link inputs.
pub fn restore_unit_cache(lock: UnitCacheLock, context: MetadataContext,
    dependencies: Vec[MetadataDependency], native: str, destination: Path,) -> Result[Option[UnitReady], str] {
    let restored = restore_unit_cache_directory(lock.directory, context, dependencies, native, destination)?
    ret Result[Option[UnitReady], str]::Ok(match restored {
            Some(value) => Option[UnitReady]::Some(value.ready)
            None => Option[UnitReady]::None
        }
    )

}

/// The coordinator owns the slot's OS lock until this worker is reaped.
/// A hint is never a verified dependency: restore performs full validation.
pub fn unit_cache_candidate(directory: Path, context: MetadataContext, native: str) -> Option[UnitReady] {
    let ready = match UnitReady::decode(read_file(directory.join("unit.ready").as_str()), context) {
        Ok(value) => value Err(_) => {
            ret Option[UnitReady]::None
        }
    }
    if read_unit_completion_receipt(directory, ready, native).is_err() {
        ret Option[UnitReady]::None
    }
    ret Option[UnitReady]::Some(ready)
}

pub struct RestoredUnit {
    ready: UnitReady
    validation_ms: u64
    archive_ms: u64
    copy_ms: u64
}

pub fn restore_unit_cache_directory(directory: Path, context: MetadataContext,
    dependencies: Vec[MetadataDependency], native: str, destination: Path,) -> Result[Option[RestoredUnit], str] {
    if directory.as_str() == destination.as_str() {
        ret Result[Option[RestoredUnit], str]::Err("invalid package cache transaction")
    }
    let started = perf_counter_ms()
    let snapshot = match read_unit_snapshot(directory, context, dependencies) {
        Ok(value) => value Err(_) => {
            ret Result[Option[RestoredUnit], str]::Ok(Option[RestoredUnit]::None)
        }
    }
    let ready = snapshot.ready
    let archive = match read_unit_completion_receipt(directory, ready, native) {
        Ok(value) => value Err(_) => {
            ret Result[Option[RestoredUnit], str]::Ok(Option[RestoredUnit]::None)
        }
    }
    let validated = perf_counter_ms()
    let archive_bytes = match verified_payload(directory.join("unit.erlib"), archive) {
        Ok(value) => value Err(_) => {
            ret Result[Option[RestoredUnit], str]::Ok(Option[RestoredUnit]::None)
        }
    }
    let archived = perf_counter_ms()
    copy_committed_unit(destination, snapshot, archive, archive_bytes, native, false)?
    verify_validated_unit_copy(destination, ready)?
    let _archive = read_unit_complete(destination, ready, native)?
    touch_cache(directory)
    ret Result[Option[RestoredUnit], str]::Ok(Option[RestoredUnit]::Some(RestoredUnit {
                ready, validated - started, archived - validated, perf_counter_ms() - archived
            }
        ))
}

/// Validate the producer before touching the shared slot. Invalidate its old
/// commit record first and publish the replacement commit record last. Crash
/// at any intermediate point leaves a miss, not a partially usable entry.
pub fn commit_unit_cache(lock: UnitCacheLock, source: Path, context: MetadataContext,
    dependencies: Vec[MetadataDependency], native: str,) -> Result[(), str] {
    if source.as_str() == lock.directory.as_str() {
        ret Result[(), str]::Err("invalid package cache transaction")
    }
    let snapshot = read_unit_snapshot(source, context, dependencies)?
    let ready = snapshot.ready
    let archive = read_unit_completion_receipt(source, ready, native)?
    let archive_bytes = verified_payload(source.join("unit.erlib"), archive)?
    copy_committed_unit(lock.directory, snapshot, archive, archive_bytes, native, true)?
    verify_validated_unit_copy(lock.directory, ready)?
    let _copied_archive = read_unit_complete(lock.directory, ready, native)?
    touch_cache(lock.directory)
    record_cache_usage(lock.directory)
    ret Result[(), str]::Ok(())
}

#attr(safe)
fn copy_committed_unit(destination: Path, snapshot: ValidatedUnitSnapshot, archive: str, archive_bytes: str,
    native: str, durable: bool,) -> Result[(), str] {
    let ready = snapshot.ready
    if !destination.is_absolute() || mkdir_all(destination.as_str()) != 0 {
        ret Result[(), str]::Err("invalid package cache transaction")
    }
    let marker = destination.join("unit.complete")
    if file_exists(marker.as_str()) && remove_file(marker.as_str()) != 0 {
        ret Result[(), str]::Err("cannot invalidate package cache commit")
    }
    let mut files = Vec[(str, str)]::new()
    files.push(("unit.ermeta", ready.metadata_digest))
    files.push(("unit.ertemplate", ready.template_digest))
    files.push(("unit.errequirements", ready.requirements_digest))
    files.push(("unit.erlib", archive))
    files.push(("unit.ready", compiler_content_digest(ready.encode()?)))
    for file in files {
        let output = destination.join(file.0)
        let contents = match file.0 {
            "unit.ermeta" => snapshot.metadata
            "unit.ertemplate" => snapshot.templates
            "unit.errequirements" => snapshot.requirements
            "unit.erlib" => archive_bytes
            _ => ready.encode()?
        }
        // Shared CAS publication is durable. Hydration owns an unpublished,
        // fresh private snapshot: only its readiness/completion receipts need
        // atomic publication, not a separate fsync for every copied payload.
        // No worker receives this path until destination SHA validation passes.
        let written = if durable && file.0 != "unit.erlib" && file.0 != "unit.ready" {
            write_verified_payload(output, contents, file.1, false)
        } elif durable || file.0 == "unit.ready" {
            unsafe {
                encore_compiler_write_atomic(output.as_str(), contents)
            }
        } else {
            write_file(output.as_str(), contents) == 0
        }
        if !written {
            ret Result[(), str]::Err("cannot write package snapshot: " + file.0)
        }
    }
    // Publish completion last, using validated bindings rather than rereading
    // a mutable source receipt after its validation.
    let complete = encode_unit_complete(ready, native, archive)?
    if !unsafe {
        encore_compiler_write_atomic(marker.as_str(), complete)
    }
    {
        ret Result[(), str]::Err("cannot commit package cache receipt")
    }
    ret Result[(), str]::Ok(())
}

/// Validates content keys before accessing any cache paths.
pub fn valid_key(value: str) -> bool {
    if value.byte_len() != 64 {
        ret false
    }
    let mut index = 0_usize
    while index < 64 {
        let byte = value.byte_at(index)
        if !(byte >= 48 && byte <= 57) && !(byte >= 97 && byte <= 102) {
            ret false
        }
        index += 1
    }
    ret true
}
