//! Full unit receipts share immutable native archives instead of copying them
//! for every body revision. Missing old versions are ordinary cache misses.
import core::result::Result
import std::path::Path

import mod::cache_payload::{read_checked_payload, verified_payload}
import mod::cache_policy::touch_cache
import refrain::cache_identity::compiler_content_digest

pub fn archive_reference(slot: str, digest: str) -> str {
    ret "ENQAR001" + slot + digest
}
fn valid_digest(value: str) -> bool {
    if value.byte_len() != 64_usize {
        ret false
    }
    for index in 0_usize..64_usize {
        let byte = value.byte_at(index)
        if !((byte >= 48_u8 && byte <= 57_u8) ||(byte >= 97_u8 && byte <= 102_u8)) {
            ret false
        }
    }
    ret true
}
pub fn read_archive_payload(directory: Path, expected: str) -> Result[str, str] {
    if !valid_digest(expected) {
        ret Result::Err("invalid archive digest")
    }
    let payload = read_checked_payload(directory.join("unit.erlib"))?
    if payload.byte_len() >= 8_usize && payload.slice_bytes(0_usize, 8_usize) == "ENQAR001" {
        if payload.byte_len() != 136_usize || payload.slice_bytes(72_usize, 64_usize) != expected {
            ret Result::Err("invalid archive reference")
        }
        let slot = payload.slice_bytes(8_usize, 64_usize)
        if !valid_digest(slot) {
            ret Result::Err("invalid archive reference slot")
        }
        let root = match directory.parent() {
            Some(value) => value None => {
                ret Result::Err("missing archive cache root")
            }
        }
        let native = root.join("objects-v1").join(slot)
        let bytes = verified_payload(native.join(expected + ".erlib"), expected)?
        touch_cache(native)
        ret Result::Ok(bytes)
    }
    if compiler_content_digest(payload) != expected {
        ret Result::Err("missing or corrupt package archive")
    }
    ret Result::Ok(payload)
}
