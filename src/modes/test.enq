//! Provides the `test` module.

import argparse::{process_arg_count, process_arg}
import core::fmt::Debug
import core::option::Option
import json::{Json, field, stringify}
import std::io::eprintln
import std::io::println
import std::os::mkdir_all
import std::os::{file_exists, read_dir, read_file, remove_file, write_file}
import std::path::Path
import std::path::clone_path
import std::process::{run_args, run_args_capture}
import std::thread::{JoinHandle, available_parallelism}
import std::time::perf_counter_ms
import std::vec::Vec

import mod::build::compile_test_ast
import refrain::diagnostics::render_diagnostic
import refrain::frontend::parser::statements::FunctionItem
import refrain::frontend::{Lexer, Parser, Statement}
import refrain::project::{ProjectWorkspace, WorkspaceModule, load_library_workspace, load_entry_workspace}
import refrain::target::{cfg_active_with_features, host_target, target_executable_name}
import rich::TestProgress

struct TestSelection {
    filter: str
}

struct TestRecord {
    id: str
    status: str
    duration_ms: u64
    message: str
}

struct StandaloneTestJob {
    index: usize
    path: str
    display: str
    weight: usize
}

struct StandaloneTestResult {
    index: usize
    display: str
    duration_ms: u64
    failure: str
}

struct UnitTestJob {
    index: usize
    display: str
    weight: usize
    failure: str
}

/// Performs the `native_test` operation.
pub fn native_test() -> u32 {
    let root = Path::new(".").resolve()
    if has_switch("--_worker-harness") {
        let workspace = if file_exists(root.join("src").join("lib.enq").as_str()) {
            load_library_workspace(root)
        } else {
            load_entry_workspace(root, root.join("src").join("main.enq"))
        }
        ret compile_test_ast(root, workspace, unit_test_harness_ast(root, workspace), "__encore_unit_harness")
    }
    let worker_path = option_value("--_worker-standalone")
    if worker_path != "" {
        let path = Path::new(worker_path).resolve()
        let mut worker_workspace = load_entry_workspace(root, path)
        // Negative tests need the early semantic diagnostic they assert on.
        // Positive tests can go straight to the cached compile path; a cache
        // miss still runs the complete lowering-time validator.
        if expected_compile_error(read_file(path.as_str())) != "" {
            let semantic_error = workspace_semantic_error(worker_workspace)
            if semantic_error != "" {
                eprintln(semantic_error)
                ret 1_u32
            }
        }
        let failure = compile_and_run_result(root, worker_workspace, worker_workspace.flat_ast, "worker:" + path.as_str())
        if failure == "" {
            ret 0_u32
        }
        eprintln(failure)
        ret 1_u32
    }
    // A project may be either a library (`src/lib.enq`) or a binary
    // (`src/main.enq`).  Tests are valid for both kinds.  Loading every
    // project as a library used to panic for binaries and, because panic did
    // not terminate the bootstrap process reliably, made `encore test` look
    // like it had hung.
    let mut workspace = if file_exists(root.join("src").join("lib.enq").as_str()) {
        load_library_workspace(root)
    } else {
        load_entry_workspace(root, root.join("src").join("main.enq"))
    }
    let selection = test_selection()
    if has_switch("--list") {
        ret list_selected_tests(root, workspace, selection)
    }
    let total = count_selected_tests(root, workspace, selection)
    if total == 0_usize {
        if !write_test_report_if_requested(selection, Vec[TestRecord]::new(), 0_usize, 0_usize) {
            ret 1_u32
        }
        println("No tests found.")
        ret 0_u32
    }
    let mut passed = 0_usize
    let mut failed = 0_usize
    let mut found = 0_usize
    let mut records = Vec[TestRecord]::new()
    let mut progress = TestProgress::auto()
    progress.start_suite(workspace.root_name, total)

    let mut unit_jobs = Vec[UnitTestJob]::new()
    let mut module_index = 0_usize
    while module_index < workspace.modules.len() {
        match workspace.modules.get(module_index) {
            Some(module) => {
                let mut statement_index = 0_usize
                while module.owner_name == workspace.root_name && statement_index < module.ast.len() {
                    match module.ast.get(statement_index) {
                        Some(statement) => {
                            match statement {
                                Statement::Function(item) => {
                                    if unit_test_enabled(module, item) {
                                        let display = unit_test_display(root, module, item.name)
                                        if test_selected(display, selection) {
                                            unit_jobs.push(UnitTestJob {
                                                    unit_jobs.len(), display, module.source.len(),
                                                    unit_test_signature_error(item)
                                                }
                                                ,)
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        None => {
                        }
                    }
                    statement_index = statement_index + 1_usize
                }
            }
            None => {
            }
        }
        module_index = module_index + 1_usize
    }
    let mut harness_failure = ""
    let mut needs_harness = false
    for job in unit_jobs {
        if job.failure == "" {
            needs_harness = true
        }
    }
    if needs_harness {
        let started = perf_counter_ms()
        harness_failure = prepare_unit_test_harness(root)
        if harness_failure == "" {
            eprintln("Prepared unit test harness in " + format_test_duration(perf_counter_ms() - started))
        }
    }
    let scheduled_unit_jobs = schedule_unit_test_jobs(unit_jobs)
    let unit_worker_count = min_test_jobs(requested_test_jobs(), scheduled_unit_jobs.len())
    let unit_root = Path::new("" + root.as_str())
    let mut unit_pending = Vec[JoinHandle[Vec[StandaloneTestResult]]]::new()
    let mut unit_worker = 0_usize
    while unit_worker < unit_worker_count {
        unit_pending.push(spawn run_unit_test_batch(unit_root, scheduled_unit_jobs,
                harness_failure, unit_worker, unit_worker_count,))
        unit_worker += 1_usize
    }
    let mut unit_results = Vec[StandaloneTestResult]::new()
    for handle in unit_pending {
        unit_results.extend(handle.join())
    }
    let mut unit_result_index = 0_usize
    while unit_result_index < unit_jobs.len() {
        for result in unit_results {
            if result.index == unit_result_index {
                found += 1_usize
                if result.failure == "" {
                    passed += 1_usize
                    records.push(TestRecord {
                            result.display, "passed", result.duration_ms, ""
                        }
                        ,
                    )
                } else {
                    failed += 1_usize
                    records.push(TestRecord {
                            result.display, "failed", result.duration_ms, result.failure
                        }
                        ,
                    )
                }
                print_parallel_test_result(result)
            }
        }
        unit_result_index += 1_usize
    }

    let tests_dir = root.join("tests")
    let mut standalone_jobs = Vec[StandaloneTestJob]::new()
    if file_exists(tests_dir.as_str()) {
        let entries = read_dir(tests_dir.as_str())
        let mut entry_index = 0_usize
        while entry_index < entries.len() {
            match entries.get(entry_index) {
                Some(name) => {
                    if ends_with(name, ".enq") {
                        let display = workspace.root_name + ":tests/" + name
                        if test_selected(display, selection) {
                            let path = tests_dir.join(name)
                            standalone_jobs.push(StandaloneTestJob {
                                    standalone_jobs.len(), path.as_str(), display,
                                    read_file(path.as_str()).len()
                                }
                                ,)
                        }
                    }
                }
                None => {
                }
            }
            entry_index = entry_index + 1_usize
        }
    }
    let scheduled_jobs = schedule_standalone_test_jobs(standalone_jobs)
    let worker_count = min_test_jobs(requested_test_jobs(), scheduled_jobs.len())
    let standalone_root = Path::new("" + root.as_str())
    let mut pending = Vec[JoinHandle[Vec[StandaloneTestResult]]]::new()
    let mut worker = 0_usize
    while worker < worker_count {
        pending.push(spawn run_standalone_test_batch(standalone_root, scheduled_jobs, worker, worker_count))
        worker += 1_usize
    }
    let mut standalone_results = Vec[StandaloneTestResult]::new()
    for handle in pending {
        standalone_results.extend(handle.join())
    }
    let mut result_index = 0_usize
    while result_index < standalone_jobs.len() {
        for result in standalone_results {
            if result.index == result_index {
                found += 1_usize
                if result.failure == "" {
                    passed += 1_usize
                    records.push(TestRecord {
                            result.display, "passed", result.duration_ms, ""
                        }
                        ,
                    )
                } else {
                    failed += 1_usize
                    records.push(TestRecord {
                            result.display, "failed", result.duration_ms, result.failure
                        }
                        ,
                    )
                }
                print_parallel_test_result(result)
            }
        }
        result_index += 1_usize
    }

    progress.finish(passed, failed)
    if !write_test_report_if_requested(selection, records, passed, failed) {
        ret 1_u32
    }
    if failed == 0_usize {
        ret 0_u32
    }
    ret 1_u32
}

fn workspace_semantic_error(workspace: mut ProjectWorkspace) -> str {
    for module in workspace.modules {
        for diagnostic in module.diagnostics {
            ret render_diagnostic(module.module_path.as_str(), module.source, diagnostic)
        }
        for diagnostic in workspace.analysis.module_semantic_diagnostics(module.analysis_id.key()) {
            ret render_diagnostic(module.module_path.as_str(), module.source, diagnostic)
        }
    }
    ret ""
}

fn count_selected_tests(root: Path, workspace: ProjectWorkspace, selection: TestSelection) -> usize {
    let mut total = 0_usize
    for module in workspace.modules {
        if module.owner_name == workspace.root_name {
            for statement in module.ast {
                match statement {
                    Statement::Function(item) => {
                        let display = unit_test_display(root, module, item.name)
                        if unit_test_enabled(module, item) && test_selected(display, selection) {
                            total = total + 1_usize
                        }
                    }
                    _ => {
                    }
                }
            }
        }
    }
    let tests_dir = root.join("tests")
    if file_exists(tests_dir.as_str()) {
        for name in read_dir(tests_dir.as_str()) {
            let display = workspace.root_name + ":tests/" + name
            if ends_with(name, ".enq") && test_selected(display, selection) {
                total = total + 1_usize
            }
        }
    }
    ret total
}

fn selected_test_ids(root: Path, workspace: ProjectWorkspace, selection: TestSelection) -> Vec[str] {
    let mut out = Vec[str]::new()
    for module in workspace.modules {
        if module.owner_name == workspace.root_name {
            for statement in module.ast {
                match statement {
                    Statement::Function(item) => {
                        let display = unit_test_display(root, module, item.name)
                        if unit_test_enabled(module, item) && test_selected(display, selection) {
                            out.push(display)
                        }
                    }
                    _ => {
                    }
                }
            }
        }
    }
    let tests_dir = root.join("tests")
    if file_exists(tests_dir.as_str()) {
        for name in read_dir(tests_dir.as_str()) {
            let display = workspace.root_name + ":tests/" + name
            if ends_with(name, ".enq") && test_selected(display, selection) {
                out.push(display)
            }
        }
    }
    ret out
}

fn list_selected_tests(root: Path, workspace: ProjectWorkspace, selection: TestSelection) -> u32 {
    let ids = selected_test_ids(root, workspace, selection)
    if option_value("--format") == "json" {
        let mut values = Vec[Json]::new()
        for id in ids {
            values.push(Json::String(id))
        }
        println(stringify(Json::Array(values)))
        ret 0_u32
    }
    for id in ids {
        println(id)
    }
    ret 0_u32
}

fn test_selected(id: str, selection: TestSelection) -> bool {
    if selection.filter != "" && !contains(id, selection.filter) {
        ret false
    }
    ret true
}

fn test_selection() -> TestSelection {
    ret TestSelection {
        test_filter()
    }
}

fn decimal_value(value: str) -> usize {
    let mut result = 0_usize
    let mut index = 0_usize
    while index < value.len() {
        result = result * 10_usize +(value.byte_at(index) - 48_u8) as usize
        index += 1_usize
    }
    ret result
}

fn write_test_report_if_requested(
    selection: TestSelection,
    records: Vec[TestRecord],
    passed: usize,
    failed: usize,
) -> bool {
    let report_path = option_value("--report")
    if report_path == "" {
        ret true
    }
    let mut tests = Vec[Json]::new()
    let mut total_duration = 0_u64
    for record in records {
        total_duration += record.duration_ms
        let mut item = Vec[(str, Json)]::new()
        item.push(field("id", Json::String(record.id)))
        item.push(field("status", Json::String(record.status)))
        item.push(field("duration_ms", Json::Number(Debug::fmt(record.duration_ms))))
        item.push(field("message", Json::String(record.message)))
        tests.push(Json::Object(item))
    }
    let mut summary = Vec[(str, Json)]::new()
    summary.push(field("selected", Json::Number(Debug::fmt(passed + failed))))
    summary.push(field("passed", Json::Number(Debug::fmt(passed))))
    summary.push(field("failed", Json::Number(Debug::fmt(failed))))
    summary.push(field("duration_ms", Json::Number(Debug::fmt(total_duration))))
    let mut root = Vec[(str, Json)]::new()
    root.push(field("schema", Json::Number("1")))
    root.push(field("summary", Json::Object(summary)))
    root.push(field("tests", Json::Array(tests)))
    match Path::new(report_path).parent() {
        Some(parent) => {
            mkdir_all(parent.as_str())
        }
        None => {
        }
    }
    if write_file(report_path, stringify(Json::Object(root)) + "\n") != 0_i32 {
        eprintln("Unable to write test report: " + report_path)
        ret false
    }
    ret true
}

fn unit_test_display(root: Path, module: WorkspaceModule, test_name: str) -> str {
    let mut module_path = module.module_path.as_str()
    let prefix = root.as_str() + "/"
    if starts_with(module_path, prefix) {
        module_path = module_path.slice(prefix.len(), module_path.len() - prefix.len())
    }
    ret module.owner_name + ":" + module_path + "::" + test_name
}

fn unit_test_signature_error(item: FunctionItem) -> str {
    if item.name == "main" || item.params.len() > 0_usize || item.generics.len() > 0_usize || item.is_extern || item.is_async || !returns_bool(item) {
        ret "test must be fn() -> bool"
    }
    ret ""
}

fn unit_test_enabled(module: WorkspaceModule, item: FunctionItem) -> bool {
    if !has_attr(item, "test") {
        ret false
    }
    for attr in item.attrs {
        if starts_with(attr, "cfg:") && !cfg_active_with_features(host_target(),
            attr.slice(4_usize, attr.len() - 4_usize), module.enabled_features,) {
            ret false
        }
    }
    ret true
}

fn unit_test_active_attrs(item: FunctionItem) -> Vec[str] {
    let mut attrs = Vec[str]::new()
    for attr in item.attrs {
        if attr != "test" {
            attrs.push(attr)
        }
    }
    ret attrs
}

// Activate tests in their original modules. Module-local wrappers preserve
// private visibility and disambiguate tests sharing a name in different files.
fn unit_test_harness_ast(root: Path, workspace: ProjectWorkspace) -> Vec[Statement] {
    let mut out = Vec[Statement]::new()
    for statement in workspace.flat_ast {
        match statement {
            Statement::Function(item) => {
                if item.name != "main" {
                    if has_attr(item, "test") && unit_test_signature_error(item) == "" &&
                    unit_test_owned_by_root(workspace, item) {
                        out.push(Statement::Function(FunctionItem {
                                    unit_test_active_attrs(item), item.decorators,
                                    item.is_public, item.is_extern, item.is_async, item.name,
                                    item.documentation, item.generics, item.params, item.ret_type,
                                    item.returns_sending, item.returns_frozen, item.body,
                                    item.source_name, item.line, item.column,
                                }
                                ,))
                    } else {
                        out.push(statement)
                    }
                }
            }
            _ => {
                out.push(statement)
            }
        }
    }
    let mut main_source = "extern fn encore_os_argc() -> usize\nextern fn encore_os_argv(index: usize) -> str\n"
    main_source += "#attr(safe)\nfn main() -> u32 { let count = unsafe { encore_os_argc() } if count != 2_usize { ret 2_u32 } let selected = unsafe { encore_os_argv(1_usize) }\n"
    let mut selector = 0_usize
    for module in workspace.modules {
        if module.owner_name == workspace.root_name {
            for statement in module.ast {
                match statement {
                    Statement::Function(item) => {
                        if unit_test_enabled(module, item) && unit_test_signature_error(item) == "" {
                            let wrapper = unit_test_wrapper_name(workspace, selector)
                            append_parsed(out, "pub fn " + wrapper + "() -> bool { ret " + item.name + "() }", item.source_name)
                            let display = unit_test_display(root, module, item.name)
                            main_source += "if selected == " + stringify(Json::String(display)) + " { ret if " +
                            wrapper + "() { 0_u32 } else { 1_u32 } }\n"
                            selector += 1_usize
                        }
                    }
                    _ => {
                    }
                }
            }
        }
    }
    main_source += "ret 2_u32 }"
    let entry = if file_exists(root.join("src").join("lib.enq").as_str()) {
        root.join("src").join("lib.enq")
    } else {
        root.join("src").join("main.enq")
    }
    append_parsed(out, main_source, entry.as_str())
    ret out
}

fn unit_test_owned_by_root(workspace: ProjectWorkspace, item: FunctionItem) -> bool {
    for module in workspace.modules {
        if module.owner_name == workspace.root_name && module.module_path.as_str() == item.source_name {
            ret unit_test_enabled(module, item)
        }
    }
    ret false
}

fn unit_test_wrapper_name(workspace: ProjectWorkspace, selector: usize) -> str {
    let mut name = "__encore_unit_test_" + Debug::fmt(selector)
    let mut available = false
    while !available {
        available = true
        for statement in workspace.flat_ast {
            match statement {
                Statement::Function(item) => {
                    if item.name == name {
                        available = false
                    }
                }
                _ => {
                }
            }
        }
        if !available {
            name += "_"
        }
    }
    ret name
}

// Lowering can terminate the compiler on a diagnostic. Compile once in a
// child so one malformed suite still produces a complete report and does not
// prevent independent standalone/negative tests from running.
fn prepare_unit_test_harness(root: Path) -> str {
    let output_path = root.join("target").join("tests").join("__encore_unit_harness.output.txt")
    mkdir_all(root.join("target").join("tests").as_str())
    let mut args = Vec[str]::new()
    args.push("test")
    args.push("--_worker-harness")
    args.push("--jobs")
    args.push("1")
    let code = run_args_capture(arg_or(0_usize, "encore"), args, output_path.as_str())
    if code == 0_i32 {
        remove_file(output_path.as_str())
        ret ""
    }
    ret "unit test harness compilation failed: " + summarize_output(read_file(output_path.as_str()))
}

fn run_unit_test_isolated(root: Path, job: UnitTestJob) -> str {
    let display = job.display
    let output_path = root.join("target").join("tests").join(sanitize(display) + ".output.txt")
    mkdir_all(root.join("target").join("tests").as_str())
    let executable = root.join("target").join("tests").join("bin").join(
        target_executable_name(host_target(), "__encore_unit_harness")).as_str()
    let mut args = Vec[str]::new()
    args.push(display)
    let code = run_args_capture(executable, args, output_path.as_str())
    let output = read_file(output_path.as_str())
    if code == 0_i32 {
        remove_file(output_path.as_str())
        ret ""
    }
    // Preserve complete runtime output for CI artifacts.
    // The compact JSON report remains readable, while failures retain the
    // exact panic and process diagnostics needed for triage.
    ret "process exited with code " + Debug::fmt(code) + ": " + summarize_output(output)
}

fn schedule_unit_test_jobs(jobs: mut Vec[UnitTestJob]) -> Vec[UnitTestJob] {
    let mut index = 1_usize
    while index < jobs.len() {
        let mut position = index
        while position > 0_usize {
            let mut swap = false
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            swap = right.weight > left.weight ||
                            (right.weight == left.weight && right.index < left.index)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            if !swap {
                break
            }
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            jobs.set(position - 1_usize, right)
                            jobs.set(position, left)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            position -= 1_usize
        }
        index += 1_usize
    }
    ret jobs
}

fn run_unit_test_batch(root: frozen Path, jobs: frozen Vec[UnitTestJob], harness_failure: frozen str, worker_index: usize,
    worker_count: usize,) -> sending Vec[StandaloneTestResult] {
    let root = clone_path(root)
    let mut out = Vec[StandaloneTestResult]::new()
    let mut index = worker_index
    while index < jobs.len() {
        match jobs.get(index) {
            Some(job) => {
                let started = perf_counter_ms()
                let display = "" + job.display
                let failure = if job.failure != "" {
                    job.failure
                } elif harness_failure != "" {
                    "" + harness_failure
                } else {
                    run_unit_test_isolated(root, job)
                }
                out.push(StandaloneTestResult {
                        job.index, display, perf_counter_ms() - started, failure
                    }
                    ,)
            }
            None => {
            }
        }
        index += worker_count
    }
    ret out
}

fn run_standalone_test(root: Path, path: Path, display: str) -> str {
    let expected = expected_compile_error(read_file(path.as_str()))
    let output_path = root.join("target").join("tests").join(sanitize(display) + ".output.txt")
    mkdir_all(root.join("target").join("tests").as_str())
    let executable = arg_or(0_usize, "encore")
    let mut args = Vec[str]::new()
    args.push("test")
    args.push("--_worker-standalone")
    args.push(path.as_str())
    args.push("--jobs")
    args.push("1")
    let code = run_args_capture(executable, args, output_path.as_str())
    let output = read_file(output_path.as_str())
    if expected != "" {
        if code != 0_i32 {
            if contains(output, expected) {
                remove_file(output_path.as_str())
                ret ""
            }
            ret "expected compile error containing '" + expected + "', got: " + summarize_output(output)
        }
        ret "expected compile error: " + expected
    }
    if code == 0_i32 {
        remove_file(output_path.as_str())
        ret ""
    }
    ret summarize_output(output)
}

fn requested_test_jobs() -> usize {
    let available = available_parallelism()
    let fallback = if available == 0_usize {
        1_usize
    } else {
        available
    }
    let requested = decimal_value(option_value("--jobs"))
    if requested == 0_usize {
        ret fallback
    }
    if available == 0_usize || requested < available {
        ret requested
    }
    ret available
}

fn min_test_jobs(requested: usize, count: usize) -> usize {
    if count == 0_usize {
        ret 0_usize
    }
    if requested < count {
        ret requested
    }
    ret count
}

fn schedule_standalone_test_jobs(jobs: mut Vec[StandaloneTestJob]) -> Vec[StandaloneTestJob] {
    let mut index = 1_usize
    while index < jobs.len() {
        let mut position = index
        while position > 0_usize {
            let mut swap = false
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            swap = right.weight > left.weight ||
                            (right.weight == left.weight && right.index < left.index)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            if !swap {
                break
            }
            match jobs.get(position) {
                Some(right) => {
                    match jobs.get(position - 1_usize) {
                        Some(left) => {
                            jobs.set(position - 1_usize, right)
                            jobs.set(position, left)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
            position -= 1_usize
        }
        index += 1_usize
    }
    ret jobs
}

fn run_standalone_test_batch(root: frozen Path, jobs: frozen Vec[StandaloneTestJob], worker_index: usize,
    worker_count: usize,) -> sending Vec[StandaloneTestResult] {
    let root = clone_path(root)
    let mut out = Vec[StandaloneTestResult]::new()
    let mut index = worker_index
    while index < jobs.len() {
        match jobs.get(index) {
            Some(job) => {
                let started = perf_counter_ms()
                let display = "" + job.display
                let failure = run_standalone_test(root, Path::new("" + job.path), display)
                out.push(StandaloneTestResult {
                        job.index, display, perf_counter_ms() - started, failure
                    }
                    ,)
            }
            None => {
            }
        }
        index += worker_count
    }
    ret out
}

fn print_parallel_test_result(result: StandaloneTestResult) ->() {
    let status = if result.failure == "" {
        "ok"
    } else {
        "FAILED"
    }
    eprintln("test " + result.display + " ... " + status + " (" +
        format_test_duration(result.duration_ms) + ")")
    if result.failure != "" {
        eprintln("    " + result.failure)
    }
    ret()
}

fn format_test_duration(milliseconds: u64) -> str {
    if milliseconds < 1000_u64 {
        ret Debug::fmt(milliseconds) + " ms"
    }
    let seconds = milliseconds / 1000_u64
    let tenths =(milliseconds % 1000_u64) / 100_u64
    ret Debug::fmt(seconds) + "." + Debug::fmt(tenths) + "s"
}

fn compile_and_run_result(root: Path, workspace: ProjectWorkspace, ast: Vec[Statement], display: str) -> str {
    let name = sanitize(display)
    if compile_test_ast(root, workspace, ast, name) != 0_u32 {
        ret "compile failed"
    }
    let binary_name = target_executable_name(host_target(), name)
    let code = run_args(root.join("target").join("tests").join("bin").join(binary_name).as_str(), Vec[str]::new())
    if code == 0_i32 {
        ret ""
    }
    ret "process exited with code " + Debug::fmt(code)
}

fn dependency_ast(workspace: ProjectWorkspace) -> Vec[Statement] {
    let mut out = Vec[Statement]::new()
    let mut module_index = 0_usize
    while module_index < workspace.modules.len() {
        match workspace.modules.get(module_index) {
            Some(module) => {
                if module.owner_name != workspace.root_name {
                    out.extend(module.ast)
                }
            }
            None => {
            }
        }
        module_index = module_index + 1_usize
    }
    ret out
}

fn append_parsed(out: mut Vec[Statement], source: str, source_name: str) ->() {
    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)
    let mut parser = Parser::new_for_source(source_name)
    out.extend(parser.parse(tokens))
    ret()
}

fn has_attr(item: FunctionItem, target: str) -> bool {
    let mut index = 0_usize
    while index < item.attrs.len() {
        match item.attrs.get(index) {
            Some(attr) => {
                if attr == target {
                    ret true
                }
            }
            None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn returns_bool(item: FunctionItem) -> bool {
    match item.ret_type {
        Some(value) => {
            ret value == "bool" || value == "u1"
        }
        None => {
            ret false
        }
    }
}

fn test_filter() -> str {
    let mut index = 2_usize
    while index < argc() {
        if arg_or(index, "") == "--filter" && index + 1_usize < argc() {
            ret arg_or(index + 1_usize, "")
        }
        index = index + 1_usize
    }
    ret ""
}

fn option_value(name: str) -> str {
    let mut index = 2_usize
    while index + 1_usize < argc() {
        if arg_or(index, "") == name {
            ret arg_or(index + 1_usize, "")
        }
        index = index + 1_usize
    }
    ret ""
}

fn has_switch(name: str) -> bool {
    let mut index = 2_usize
    while index < argc() {
        if arg_or(index, "") == name {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn expected_compile_error(source: str) -> str {
    let marker = "expect.compile_error="
    let mut index = 0_usize
    while index + marker.len() <= source.len() && index < 1024_usize {
        if source.slice(index, marker.len()) == marker {
            let start = index + marker.len()
            let mut end = start
            while end < source.len() && source.slice(end, 1_usize) != "\n" && source.slice(end, 1_usize) != "\r" {
                end = end + 1_usize
            }
            ret source.slice(start, end - start)
        }
        index = index + 1_usize
    }
    ret ""
}

fn summarize_output(value: str) -> str {
    let limit = 240_usize
    let head_limit = 96_usize
    let tail_limit = limit - head_limit
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() && out.len() < head_limit {
        let ch = value.slice(index, 1_usize)
        if ch == "\n" || ch == "\r" || ch == "\t" {
            if out.len() > 0_usize && out.slice(out.len() - 1_usize, 1_usize) != " " {
                out = out + " "
            }
        } else {
            out = out + ch
        }
        index = index + 1_usize
    }
    if index < value.len() {
        let marker = "error:"
        let mut marker_index = 0_usize
        let mut error_index = value.len()
        while marker_index + marker.len() <= value.len() {
            if value.slice(marker_index, marker.len()) == marker {
                error_index = marker_index
            }
            marker_index = marker_index + 1_usize
        }
        if error_index < value.len() {
            out = out + " ... error context: "
            let context_start = if error_index > 80_usize {
                error_index - 80_usize
            } else {
                0_usize
            }
            let context_end = if error_index + 320_usize < value.len() {
                error_index + 320_usize
            } else {
                value.len()
            }
            let mut context_index = context_start
            while context_index < context_end {
                let ch = value.slice(context_index, 1_usize)
                if ch == "\n" || ch == "\r" || ch == "\t" {
                    if out.len() > 0_usize && out.slice(out.len() - 1_usize, 1_usize) != " " {
                        out = out + " "
                    }
                } else {
                    out = out + ch
                }
                context_index = context_index + 1_usize
            }
        }
        out = out + " ... tail: "
        let mut tail_index = if value.len() > tail_limit {
            value.len() - tail_limit
        } else {
            index
        }
        while tail_index < value.len() {
            let ch = value.slice(tail_index, 1_usize)
            if ch == "\n" || ch == "\r" || ch == "\t" {
                if out.len() > 0_usize && out.slice(out.len() - 1_usize, 1_usize) != " " {
                    out = out + " "
                }
            } else {
                out = out + ch
            }
            tail_index = tail_index + 1_usize
        }
    }
    if out == "" {
        ret "no compiler output"
    }
    ret out
}

fn sanitize(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if is_alnum(ch) {
            out = out + ch
        } else {
            out = out + "_"
        }
        index = index + 1_usize
    }
    ret out
}
fn is_alnum(ch: str) -> bool {
    if ch.len() == 0_usize {
        ret false
    }
    let value = ch.byte_at(0_usize)
    ret(value >= 97_u8 && value <= 122_u8) ||(value >= 65_u8 && value <= 90_u8) ||(value >= 48_u8 && value <= 57_u8)
}
fn contains(value: str, needle: str) -> bool {
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle {
            ret true
        }
        index = index + 1_usize
    }
    ret false
}
fn starts_with(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}
fn ends_with(value: str, suffix: str) -> bool {
    ret suffix.len() <= value.len() && value.slice(value.len() - suffix.len(), suffix.len()) == suffix
}
fn arg_or(index: usize, fallback: str) -> str {
    match argv(index) {
        Some(value) => {
            ret value
        }
        None => {
            ret fallback
        }
    }
}
fn shell_quote(value: str) -> str {
    let mut out = "'"
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "'" {
            out = out + "'\\''"
        } else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out + "'"
}

fn argc() -> usize {
    ret process_arg_count()
}
fn argv(index: usize) -> Option[str] {
    ret process_arg(index)
}
