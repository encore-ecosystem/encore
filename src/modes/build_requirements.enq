//! Checked link-time specialization summaries, without reparsing EHIR text.

import core::option::Option
import core::result::Result
import json::{Json, parse, stringify}
import std::vec::Vec
import ehirlib::{Type, RepresentationKind, make_type, type_to_string}
import ehir_llvm_backend::codegen::{CodegenRequirements, GenericRequirement}
import mod::build_metadata::MetadataContext

/// Carries the same compiler/target/profile identity as its checked declarations.
/// Its bytes are additionally hashed by the coordinator's completion record.
pub struct UnitRequirements {
    context: MetadataContext
    requirements: CodegenRequirements
}

impl for UnitRequirements {
    pub fn encode(self: Self) -> Result[str, str] {
        let mut fields = Vec[(str, Json)]::new()
        fields.push(("schema", Json::Number("1")))
        fields.push(("context", self.context.encode()?))
        let mut calls = Vec[Json]::new()
        for item in self.requirements.generic_calls {
            valid_name(item.name)?
            let mut record = Vec[(str, Json)]::new()
            record.push(("name", Json::String(item.name)))
            record.push(("args", encode_types(item.args, 0)?))
            calls.push(Json::Object(record))
        }
        fields.push(("calls", Json::Array(calls)))
        fields.push(("types", encode_types(self.requirements.concrete_types, 0)?))
        ret Result[str, str]::Ok(stringify(Json::Object(fields)))
    }

    pub fn decode(text: str, expected: MetadataContext) -> Result[Self, str] {
        let data = match parse(text) {
            Ok(value) => value
            Err(_) => { ret Result[Self, str]::Err("invalid requirements JSON") }
        }
        if data.get("schema").unwrap_or(Json::Null).as_number().unwrap_or("") != "1" {
            ret Result[Self, str]::Err("unsupported requirements schema")
        }
        let context = MetadataContext::decode(data.get("context").unwrap_or(Json::Null))?
        if stringify(context.encode()?) != stringify(expected.encode()?) {
            ret Result[Self, str]::Err("requirements compiler/target/profile/input mismatch")
        }
        let records = array(data.get("calls").unwrap_or(Json::Null))?
        let mut calls = Vec[GenericRequirement]::new()
        for record in records {
            let name = string_field(record, "name")?
            valid_name(name)?
            calls.push(GenericRequirement{name, decode_types(record.get("args").unwrap_or(Json::Null), 0)?})
        }
        let types = decode_types(data.get("types").unwrap_or(Json::Null), 0)?
        ret Result[Self, str]::Ok(Self{context, CodegenRequirements{calls, types}})
    }
}

fn encode_types(types: Vec[Type], depth: usize) -> Result[Json, str] {
    if depth >= 128 { ret Result[Json, str]::Err("requirements type nesting is too deep") }
    let mut records = Vec[Json]::new()
    for typ in types {
        valid_name(typ.name)?
        let representation = match typ.representation {
            RepresentationKind::Inline => "inline"
            RepresentationKind::NodeStack => "stack"
            RepresentationKind::NodeHeap => "heap"
            RepresentationKind::NodeAny => "node"
            RepresentationKind::Raw => "raw"
            RepresentationKind::LocalPlace => "place"
        }
        let mut fields = Vec[(str, Json)]::new()
        fields.push(("name", Json::String(typ.name)))
        fields.push(("representation", Json::String(representation)))
        fields.push(("args", encode_types(typ.generics, depth + 1)?))
        records.push(Json::Object(fields))
    }
    ret Result[Json, str]::Ok(Json::Array(records))
}

fn decode_types(data: Json, depth: usize) -> Result[Vec[Type], str] {
    if depth >= 128 { ret Result[Vec[Type], str]::Err("requirements type nesting is too deep") }
    let mut types = Vec[Type]::new()
    for record in array(data)? {
        let name = string_field(record, "name")?
        valid_name(name)?
        let representation = match string_field(record, "representation")? {
            "inline" => RepresentationKind::Inline
            "stack" => RepresentationKind::NodeStack
            "heap" => RepresentationKind::NodeHeap
            "node" => RepresentationKind::NodeAny
            "raw" => RepresentationKind::Raw
            "place" => RepresentationKind::LocalPlace
            _ => { ret Result[Vec[Type], str]::Err("invalid requirements representation") }
        }
        types.push(make_type(name, decode_types(record.get("args").unwrap_or(Json::Null), depth + 1)?,
            representation))
    }
    ret Result[Vec[Type], str]::Ok(types)
}

fn array(data: Json) -> Result[Vec[Json], str] {
    ret match data {
        Json::Array(values) => Result[Vec[Json], str]::Ok(values)
        _ => Result[Vec[Json], str]::Err("invalid requirements array")
    }
}

fn string_field(data: Json, key: str) -> Result[str, str] {
    ret match data.get(key).unwrap_or(Json::Null) {
        Json::String(value) => Result[str, str]::Ok(value)
        _ => Result[str, str]::Err("missing requirements string: " + key)
    }
}

fn valid_name(value: str) -> Result[(), str] {
    if value == "" || value.byte_len() > 4096 { ret Result[(), str]::Err("invalid requirements name") }
    let mut index = 0_usize
    while index < value.byte_len() {
        let byte = value.byte_at(index)
        if byte < 32 || byte == 127 { ret Result[(), str]::Err("control character in requirements name") }
        index += 1
    }
    ret Result[(), str]::Ok(())
}

fn requirements_fixture() -> UnitRequirements {
    let mut args = Vec[Type]::new()
    args.push(make_type("u16", Vec[Type]::new(), RepresentationKind::Inline))
    let mut calls = Vec[GenericRequirement]::new()
    calls.push(GenericRequirement{"sample_identity", args})
    let mut types = Vec[Type]::new()
    types.push(make_type("__encore_tsample__Value", args, RepresentationKind::NodeHeap))
    let digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    ret UnitRequirements{MetadataContext{"sample", digest, "x86_64-unknown-linux-gnu", "dev", digest,
        Vec[str]::new()}, CodegenRequirements{calls, types}}
}

#attr(test)
fn metadata_requirements_roundtrip_structured_types() -> bool {
    let original = requirements_fixture()
    let text = original.encode().unwrap_or("")
    let restored = match UnitRequirements::decode(text, original.context) {
        Ok(value) => value Err(_) => { ret false }
    }
    let typ = match restored.requirements.concrete_types.get(0) {
        Some(value) => value None => { ret false }
    }
    ret text != "" && restored.encode().unwrap_or("") == text &&
        type_to_string(typ) == "__encore_tsample__Value[u16]<H>"
}

#attr(test)
fn metadata_requirements_rejects_context_and_schema() -> bool {
    let fixture = requirements_fixture()
    let text = fixture.encode().unwrap_or("")
    let mut wrong = requirements_fixture().context
    wrong.target = "aarch64-apple-darwin"
    ret UnitRequirements::decode(text, wrong).is_err() &&
        UnitRequirements::decode("{\"schema\":2}", fixture.context).is_err()
}

#attr(test)
fn metadata_requirements_rejects_malformed_types() -> bool {
    let context = requirements_fixture().context
    let prefix = "{\"schema\":1,\"context\":" + stringify(context.encode().unwrap_or(Json::Null)) +
        ",\"calls\":[],\"types\":"
    ret UnitRequirements::decode(prefix + "[{\"name\":\"Value\",\"representation\":\"unknown\",\"args\":[]}]}", context).is_err() &&
        UnitRequirements::decode(prefix + "[{\"name\":\"Value\",\"representation\":\"inline\"}]}", context).is_err() &&
        UnitRequirements::decode(prefix + "{}" + "}", context).is_err()
}

#attr(test)
fn metadata_requirements_rejects_empty_names() -> bool {
    let mut fixture = requirements_fixture()
    let mut calls = Vec[GenericRequirement]::new()
    calls.push(GenericRequirement{"", Vec[Type]::new()})
    fixture.requirements = CodegenRequirements{calls, Vec[Type]::new()}
    ret fixture.encode().is_err()
}

#attr(test)
fn metadata_requirements_preserves_all_representations() -> bool {
    let mut fixture = requirements_fixture()
    let mut types = Vec[Type]::new()
    types.push(make_type("u32", Vec[Type]::new(), RepresentationKind::Inline))
    types.push(make_type("Value", Vec[Type]::new(), RepresentationKind::NodeStack))
    types.push(make_type("Value", Vec[Type]::new(), RepresentationKind::NodeHeap))
    types.push(make_type("Value", Vec[Type]::new(), RepresentationKind::NodeAny))
    types.push(make_type("u8", Vec[Type]::new(), RepresentationKind::Raw))
    types.push(make_type("Value", Vec[Type]::new(), RepresentationKind::LocalPlace))
    fixture.requirements = CodegenRequirements{Vec[GenericRequirement]::new(), types}
    let text = fixture.encode().unwrap_or("")
    let restored = match UnitRequirements::decode(text, fixture.context) {
        Ok(value) => value Err(_) => { ret false }
    }
    ret text != "" && restored.requirements.concrete_types.len() == 6 &&
        restored.encode().unwrap_or("") == text
}
