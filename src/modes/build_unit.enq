/// The frontend publishes declarations and compact EHIR templates separately
/// from ordinary bodies. Dependency sources and archives are not in this value.
pub struct PreparedCompilationUnit {
    metadata: RefrainMetadata
    owned: ModuleBundle
    lowered_payload: str
    lowering_identities: Vec[(str, str)]
    dependency_templates: Vec[DependencyTemplates]
    timings: Vec[(str, Json)]
}

pub struct DependencyTemplates {
    identity: str
    payload: str
}

/// Checked declarations/templates can be atomically published before emitting
/// this worker's ordinary LLVM objects. All mutable lowering state stays local.
pub struct PreparedPackageWorker {
    prepared: PreparedUnitCodegen
    metadata_text: str
    templates_text: str
    requirements_text: str
    interface_digest: str
    template_digest: str
    metadata_dependencies: Vec[MetadataDependency]
    native_sources: Vec[(str, str)]
    owned_checkpoint: str
    backend_restored: bool
}

/// The native worker owns these compact identities independently of the frozen
/// prepared EHIR. No function body is copied across this boundary.
pub fn package_native_sources(worker: frozen PreparedPackageWorker) -> Vec[(str, str)] {
    let mut sources = Vec[(str, str)]::new()
    for source in worker.native_sources {
        sources.push(("" + source.0, "" + source.1))
    }
    ret sources
}

pub fn package_owned_checkpoint(request: BuildUnitRequest, worker: frozen PreparedPackageWorker) -> Result[str, str] {
    ret Result::Ok("" + worker.owned_checkpoint)
}

/// Completes owned backend preparation before announcing metadata readiness.
/// In particular, dependencies see normalized generated coroutine layouts,
/// never the frontend's preliminary template projection.
pub fn prepare_package_worker(request: BuildUnitRequest, jobs: usize, detailed_timings: bool) -> Result[PreparedPackageWorker, str] {
    ret prepare_package_worker_with_server(request, jobs, detailed_timings, 0_usize)
}

pub fn prepare_package_worker_with_server(request: BuildUnitRequest, jobs: usize, detailed_timings: bool, server: usize) -> Result[PreparedPackageWorker, str] {
    if jobs == 0 {
        ret Result[PreparedPackageWorker, str]::Err("package worker needs a CPU lease")
    }
    if file_exists(request.output.join("unit.backend").as_str()) {
        match restore_prepared_worker(request) {
            Ok(value) => {
                ret Result::Ok(value)
            }
            Err(_) => {
            }
        }
    }
    let preparation_started = perf_counter_ms()
    let frontend = if file_exists(request.output.join("unit.frontend").as_str()) {
        match restore_frontend_worker(request) {
            Ok(value) => value
            Err(_) => prepare_compilation_unit_with_timings(request, detailed_timings, server)?
        }
    } else {
        prepare_compilation_unit_with_timings(request, detailed_timings, server)?
    }
    let checkpoint_started = perf_counter_ms()
    publish_frontend_unit(request.output, package_frontend_fingerprint(request)?, frontend.metadata, frontend.lowered_payload)?
    let checkpoint_ms = perf_counter_ms() - checkpoint_started
    let frontend_ms = perf_counter_ms() - preparation_started
    let mut modules = Vec[Module]::new()
    for input in frontend.dependency_templates {
        let dependency = decode_typed_bundle(input.payload, input.identity)?
        modules.extend(dependency.modules)
    }
    let entry = request.context.unit + if graph_package(request.graph, request.context.unit)?.target_is_binary {
        "@main.enq"
    } else {
        "@lib.enq"
    }
    let target = parse_target(request.context.target)
    let normalize_started = perf_counter_ms()
    // Common preparation reads the fully typed function alone. Declaration
    // layouts/templates belong to subsequent LLVM analysis and object keys.
    let mut context = request.context.compiler_digest + "\n" + request.context.target + "\n" + request.context.profile
    for feature in request.context.features {
        context += "\nfeature:" + feature
    }
    let normalization_jobs = if server == 0_usize {
        jobs
    } else {
        borrow_package_jobs(server, frontend.owned.modules.len())?
    }
    let normalized = prepare_ehir_unit_with_keys(frontend.owned, compiler_content_digest(context), request.cache, normalization_jobs, frontend.lowering_identities)
    if normalized.is_err() && server != 0_usize {
        return_package_jobs(server, normalization_jobs)
    }
    let normalized = normalized?
    let mut native_sources = Vec[(str, str)]::new()
    for identity in frontend.lowering_identities {
        native_sources.push((identity.0, compiler_content_digest("encore-normalized-ehir-module-1\n" +
                    compiler_content_digest(context) + "\n" + identity.1)))
    }
    let owned_checkpoint = encode_compilation_checkpoint(normalized.bundle, native_sources,
        package_backend_fingerprint(request)?, request.cache,)?
    clear_codegen_error()
    let prepared = prepare_normalized_unit_codegen(normalized.bundle,
        make_module_bundle("", modules), target.triple, target.pointer_width,)
    if server != 0_usize {
        return_package_jobs(server, normalization_jobs)
    }
    let backend_error = take_codegen_error()
    if !backend_error.is_empty() {
        ret Result::Err("LLVM preparation: " + backend_error)
    }
    let normalize_ms = perf_counter_ms() - normalize_started
    let templates = encode_typed_bundle(unit_codegen_context(prepared, entry), template_snapshot_key(request.context))?
    let template_digest = compiler_content_digest(templates)
    let mut metadata = frontend.metadata
    metadata.template_digest = template_digest
    let interface_digest = metadata.interface_digest()?
    let metadata_text = metadata.encode()?
    let requirements = UnitRequirements { request.context, unit_codegen_requirements(prepared) }
    let requirements_text = requirements.encode()?
    let mut preparation = Vec[(str, Json)]::new()
    preparation.push(("frontend_ms", Json::Number(Debug::fmt(frontend_ms))))
    preparation.push(("backend_prepare_ms", Json::Number(Debug::fmt(perf_counter_ms() - preparation_started - frontend_ms))))
    preparation.push(("prepared_functions_checked", Json::Number(Debug::fmt(normalized.prepared))))
    preparation.push(("prepared_functions_reused", Json::Number(Debug::fmt(normalized.reused))))
    preparation.push(("prepared_modules_fallback", Json::Number(Debug::fmt(normalized.fallback))))
    preparation.push(("frontend_checkpoint_bytes", Json::Number(Debug::fmt(frontend.lowered_payload.byte_len()))))
    preparation.push(("backend_checkpoint_bytes", Json::Number(Debug::fmt(owned_checkpoint.byte_len()))))
    if detailed_timings {
        preparation.extend(frontend.timings)
        preparation.push(("frontend_checkpoint_ms", Json::Number(Debug::fmt(checkpoint_ms))))
        preparation.push(("backend_normalize_ms", Json::Number(Debug::fmt(normalize_ms))))
    }
    if write_file(request.output.join("preparation.json").as_str(), stringify(Json::Object(preparation))) != 0 {
        ret Result[PreparedPackageWorker, str]::Err("cannot record package preparation")
    }
    ret Result[PreparedPackageWorker, str]::Ok(PreparedPackageWorker {
            prepared, metadata_text, templates,
            requirements_text, interface_digest, template_digest, metadata.dependencies, native_sources, owned_checkpoint, false
        }
        ,)
}

/// The fingerprint only consumes verified ready-record identities. Actual
/// dependency payload validation is performed by preparation/restoration.
pub fn package_backend_fingerprint(request: BuildUnitRequest) -> Result[str, str] {
    ret package_phase_fingerprint(request, false)
}

pub fn package_frontend_fingerprint(request: BuildUnitRequest) -> Result[str, str] {
    ret package_phase_fingerprint(request, true)
}

fn package_phase_fingerprint(request: BuildUnitRequest, frontend: bool) -> Result[str, str] {
    let mut dependencies = Vec[MetadataDependency]::new()
    for input in request.inputs {
        let ready = UnitReady::decode(read_file(input.directory.join("unit.ready").as_str()), input.context)?
        if ready.metadata_digest != input.metadata_digest || ready.template_digest != input.template_digest {
            ret Result[str, str]::Err("dependency changed while identifying prepared package")
        }
        dependencies.push(MetadataDependency {
                input.context.unit, ready.interface_digest, ready.template_digest
            }
            ,
        )
    }
    let keys = unit_fingerprint(request.context, dependencies, compiler_content_digest("unused-native-phase"))?
    ret Result[str, str]::Ok(if frontend {
            keys.frontend
        } else {
            keys.backend
        }
    )
}

fn restore_frontend_worker(request: BuildUnitRequest) -> Result[PreparedCompilationUnit, str] {
    let verified = load_unit_dependencies(request)?
    let owner = graph_package(request.graph, request.context.unit)?
    if unit_source_digest(owner)? != request.context.input_digest {
        ret Result[PreparedCompilationUnit, str]::Err("frontend checkpoint sources changed")
    }
    let mut dependencies = Vec[MetadataDependency]::new()
    let mut templates = Vec[DependencyTemplates]::new()
    for dependency in verified {
        if contains_name(owner.dependency_names, dependency.metadata.context.unit) {
            dependencies.push(MetadataDependency {
                    dependency.metadata.context.unit, dependency.metadata.interface_digest()?, dependency.metadata.template_digest
                }
                ,
            )
        }
        templates.push(DependencyTemplates {
                template_snapshot_key(dependency.metadata.context), dependency.templates
            }
        )
    }
    let checkpoint = read_frontend_unit(request.output, package_frontend_fingerprint(request)?, request.context, dependencies)?
    let restored = restore_compilation_checkpoint(checkpoint.lowered, package_frontend_fingerprint(request)?, request.cache)?
    let bundle = restored.bundle
    for module in bundle.modules {
        if module.name.byte_len() <= owner.name.byte_len() || module.name.slice_bytes(0, owner.name.byte_len() + 1) != owner.name + "@" {
            ret Result[PreparedCompilationUnit, str]::Err("foreign module in frontend checkpoint")
        }
    }
    ret Result[PreparedCompilationUnit, str]::Ok(PreparedCompilationUnit {
            checkpoint.metadata, bundle, checkpoint.lowered, restored.identities, templates, Vec[(str, Json)]::new()
        }
        ,
    )
}

fn restore_prepared_worker(request: BuildUnitRequest) -> Result[PreparedPackageWorker, str] {
    let verified = load_unit_dependencies(request)?
    let owner = graph_package(request.graph, request.context.unit)?
    if unit_source_digest(owner)? != request.context.input_digest {
        ret Result[PreparedPackageWorker, str]::Err("prepared package sources changed")
    }
    let mut dependencies = Vec[MetadataDependency]::new()
    let mut contexts = Vec[Module]::new()
    for dependency in verified {
        if contains_name(owner.dependency_names, dependency.metadata.context.unit) {
            dependencies.push(MetadataDependency {
                    dependency.metadata.context.unit, dependency.metadata.interface_digest()?, dependency.metadata.template_digest
                }
                ,
            )
        }
        contexts.extend(decode_typed_bundle(dependency.templates, template_snapshot_key(dependency.metadata.context))?.modules)
    }
    let ready = read_unit_ready(request.output, request.context, dependencies)?
    let owned_text = read_prepared_unit(request.output, ready, package_backend_fingerprint(request)?)?
    let restored = restore_compilation_checkpoint(owned_text, package_backend_fingerprint(request)?, request.cache)?
    let owned = restored.bundle
    for module in owned.modules {
        if module.name.byte_len() <= owner.name.byte_len() || module.name.slice_bytes(0, owner.name.byte_len() + 1) != owner.name + "@" {
            ret Result[PreparedPackageWorker, str]::Err("foreign module in prepared package")
        }
    }
    let templates = read_file(request.output.join("unit.ertemplate").as_str())
    contexts.extend(decode_typed_bundle(templates, template_snapshot_key(request.context))?.modules)
    let metadata_text = read_file(request.output.join("unit.ermeta").as_str())
    let requirements_text = read_file(request.output.join("unit.errequirements").as_str())
    let requirements = UnitRequirements::decode(requirements_text, request.context)?
    ret Result[PreparedPackageWorker, str]::Ok(PreparedPackageWorker {
            PreparedUnitCodegen {
                owned.modules, contexts, requirements.requirements
            }
            ,
            metadata_text, templates, requirements_text, ready.interface_digest, ready.template_digest, dependencies,
            restored.identities, owned_text, true
        }
        ,)
}

fn contains_name(values: Vec[str], name: str) -> bool {
    for value in values {
        if value == name {
            ret true
        }
    }
    ret false
}

/// Checks every expected dependency before opening this package's source files.
/// Missing/corrupt artifacts never trigger a source or registry fallback.
pub fn prepare_compilation_unit(request: BuildUnitRequest) -> Result[PreparedCompilationUnit, str] {
    ret prepare_compilation_unit_with_timings(request, false, 0_usize)
}

fn prepare_compilation_unit_with_timings(request: BuildUnitRequest, detailed_timings: bool, server: usize) -> Result[PreparedCompilationUnit, str] {
    let frontend_started = perf_counter_ms()
    let _validated = request.encode()?
    let verified = load_unit_dependencies(request)?
    let mut compiled = Vec[CompiledWorkspaceModule]::new()
    let mut dependency_templates = Vec[DependencyTemplates]::new()
    for dependency in verified {
        compiled.extend(dependency.metadata.compiled_modules()?)
        dependency_templates.push(DependencyTemplates {
                template_snapshot_key(dependency.metadata.context), dependency.templates
            }
        )
    }
    let dependencies_loaded = perf_counter_ms()
    profile_frontend("dependency-metadata", frontend_started)
    let owner = graph_package(request.graph, request.context.unit)?
    if unit_source_digest(owner)? != request.context.input_digest {
        ret Result[PreparedCompilationUnit, str]::Err("package sources changed before compilation: " + owner.name)
    }
    let sources = if request.cache.is_some() {
        load_source_documents(owner, request.context.compiler_digest, request.cache)?
    } else {
        Vec[CachedWorkspaceSource]::new()
    }
    let mut workspace = match try_load_compilation_unit_with_sources(request.graph, owner.name, compiled, sources) {
        Ok(value) => value
        Err(failure) => {
            ret Result[PreparedCompilationUnit, str]::Err(failure.message)
        }
    }
    let target = parse_target(request.context.target)
    for module in workspace.modules {
        workspace.analysis.configure_safety(module.analysis_id.key(), target, module.enabled_features)
    }
    let workspace_loaded = perf_counter_ms()
    profile_frontend("workspace", dependencies_loaded)
    publish_source_documents(workspace, owner, request.context.compiler_digest, request.cache)?
    let checked = check_own_modules(workspace, target, request, server)?
    let checking_finished = perf_counter_ms()
    profile_frontend("semantic", workspace_loaded)
    let checking_ms = perf_counter_ms() - frontend_started
    let effects = if request.cache.is_some() {
        let slot = compiler_content_digest("encore-safety-package-1\n" + request.context.compiler_digest + "\n" +
            request.context.unit + "\n" + request.context.target + "\n" + request.context.profile)
        let previous = match restore_lowered_module(request.cache, slot)? {
            Some(text) => parse(text).unwrap_or(Json::Null)
            None => Json::Null
        }
        let result = workspace.analysis.function_safety_effects_with_verified_modules(checked.functions, previous, checked.verified_modules)
        commit_lowered_module(request.cache, slot, stringify(result.replay))?
        let mut counts = parse(read_file((request.output / "semantic.json").as_str())).unwrap_or(Json::Null).as_object().unwrap_or(Vec[(str, Json)]::new())
        counts.push(("effects_checked", Json::Number(Debug::fmt(result.checked))))
        counts.push(("effects_reused", Json::Number(Debug::fmt(result.reused))))
        if write_file((request.output / "semantic.json").as_str(), stringify(Json::Object(counts))) != 0 {
            ret Result::Err("cannot record safety reuse")
        }
        result.effects
    } else {
        workspace.analysis.function_safety_effects_with_prechecked(checked.functions)
    }
    let safety_finished = perf_counter_ms()
    profile_frontend("safety", checking_finished)
    let mut translations = Vec[TranslationModule]::new()
    let mut selected = Vec[usize]::new()
    let mut declarations = Vec[MetadataModule]::new()
    let mut reflection_ast = Vec[Statement]::new()
    for module in workspace.modules {
        reflection_ast.extend(module.ast)
    }
    let reflection_names = reflection_template_names(reflection_ast)
    let mut index = 0_usize
    for module in workspace.modules {
        let ast = mark_reflection_templates(
            filter_ast_for_target(module.ast, target, module.enabled_features), reflection_names,)
        translations.push(TranslationModule {
                module.module_id, module.module_path.as_str(),
                module.source, module.documentation, module.resolved_imports, ast, module.enabled_features,
                module.source.byte_len()
            }
            ,)
        if module.owner_name == owner.name {
            selected.push(index)
            let mut own_effects = Vec[FunctionSafety]::new()
            for effect in effects {
                if effect.module_name == module.analysis_id.key() {
                    own_effects.push(effect)
                }
            }
            let declarations_ast = workspace.analysis.resolved_static_declarations(module.analysis_id.key(), ast)
            let document = target_document(module.analysis, declarations_ast)
            // The loader already guarantees this module ID belongs to the unit.
            let relative = module.module_id.slice_bytes(owner.name.byte_len() + 1,
                module.module_id.byte_len() - owner.name.byte_len() - 1,)
            declarations.push(MetadataModule::from_document(module.module_id, relative, document,
                    module.resolved_imports, own_effects,))
        }
        index += 1
    }
    // Complete lowering-time validation is still required before metadata can
    // become ready. Only the owned bodies are lowered; dependency declarations
    // have neither ordinary bodies, tokens nor source text.
    let mut dependencies = Vec[MetadataDependency]::new()
    for name in owner.dependency_names {
        for dependency in verified {
            if dependency.metadata.context.unit == name {
                dependencies.push(MetadataDependency {
                        name, dependency.metadata.interface_digest()?,
                        dependency.metadata.template_digest
                    }
                    ,)
            }
        }
    }
    let contract = RefrainMetadata {
        request.context, dependencies, declarations, compiler_content_digest("")
    }
    .interface_digest()?
    let mut context_parts = Vec[Json]::new()
    context_parts.push(Json::String(contract))
    for module in translations {
        context_parts.push(Json::String(module.module_id))
        context_parts.push(encode_codegen_context_ast(module.ast))
        let mut features = Vec[Json]::new()
        for feature in module.features {
            features.push(Json::String(feature))
        }
        context_parts.push(Json::Array(features))
    }
    for dependency in dependencies {
        context_parts.push(Json::String(dependency.template_digest))
    }
    let lowering_context = compiler_content_digest(stringify(Json::Array(context_parts)))
    // A version edit can change expanded literals while raw source is unchanged.
    // Invalidate module records, retaining replay of unchanged function bodies.
    let project_version = compiler_content_digest(owner.manifest.version)
    let cache_read_started = perf_counter_ms()
    let mut chunks = Vec[TranslatedModuleChunk]::new()
    let mut missing = Vec[usize]::new()
    let mut keys = Vec[str]::new()
    for _module in translations {
        keys.push("")
    }
    for index in selected {
        let module = match translations.get(index) {
            Some(value) => value
            None => {
                ret Result[PreparedCompilationUnit, str]::Err("invalid lowering module index")
            }
        }
        let key = compiler_content_digest("encore-lowered-module-5\n" + lowering_context + "\n" +
            module.module_id + "\n" + compiler_content_digest(module.source) + "\n" + project_version)
        keys.set(index, key)
        match restore_lowered_module(request.cache, key)? {
            Some(text) => {
                match decode_typed_module(text, key) {
                    Ok(value) => {
                        chunks.push(TranslatedModuleChunk::from_module(index, value))
                    }
                    Err(_) => {
                        missing.push(index)
                    }
                }
            }
            None => {
                missing.push(index)
            }
        }
    }
    let mut deltas = Vec[FunctionLoweringDelta]::new()
    for index in missing {
        match translations.get(index) {
            Some(module) => {
                match restore_module_delta(request.cache, lowering_context, project_version, module, index)? {
                    Some(delta) => {
                        deltas.push(delta)
                    }
                    None => {
                    }
                }
            }
            None => {
            }
        }
    }
    let mut cached_functions = Vec[CachedFunctionChunk]::new()
    let mut function_keys = Vec[(str, str)]::new()
    if request.cache.is_some() {
        for index in missing {
            match translations.get(index) {
                Some(module) => {
                    let mut ordinal = 0_usize
                    for statement in module.ast {
                        match statement {
                            Statement::Function(item) => {
                                let key = lowering_function_key(module.module_id, item)
                                function_keys.push((lowering_function_site(module.module_id, ordinal), key))
                                ordinal += 1
                                match restore_lowered_function(request.cache, lowering_context, key)? {
                                    Some(function) => {
                                        cached_functions.push(function)
                                    }
                                    None => {
                                    }
                                }
                            }
                            Statement::Impl(implementation) => {
                                for method in implementation.methods {
                                    let key = lowering_method_key(module.module_id, implementation, method)
                                    match restore_lowered_function(request.cache, lowering_context, key)? {
                                        Some(function) => {
                                            cached_functions.push(function)
                                        }
                                        None => {
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                }
                None => {
                }
            }
        }
    }
    let mut environment_paths = Vec[Json]::new()
    for module in translations {
        environment_paths.push(Json::String(module.module_id + "\n" + module.source_name))
    }
    let environment_key = compiler_content_digest("encore-translation-environment-2\n" + lowering_context + "\n" +
        stringify(Json::Array(environment_paths)))
    let environment = if missing.is_empty() {
        Option[str]::None
    } else {
        restore_lowered_module(request.cache, environment_key)?
    }
    let cache_read_finished = perf_counter_ms()
    profile_frontend("lowering-context-and-cache", safety_finished)
    let fresh = if missing.is_empty() {
        CachedCompilationChunks {
            Vec[TranslatedModuleChunk]::new(), Vec[CachedFunctionChunk]::new(), 0, Option[str]::None, false
        }
    } elif request.cache.is_some() {
        translate_compilation_unit_with_environment(translations, target, missing, cached_functions, function_keys, deltas, environment_key, environment)
    } else {
        CachedCompilationChunks {
            translate_compilation_unit_to_ehir_chunks(translations, target, missing), Vec[CachedFunctionChunk]::new(), 0, Option[str]::None, false
        }
    }
    let translation_finished = perf_counter_ms()
    profile_frontend("translate", cache_read_finished)
    match fresh.environment {
        Some(payload) => {
            commit_lowered_module(request.cache, environment_key, payload)?
        }
        None => {
        }
    }
    for function in fresh.functions {
        commit_lowered_function(request.cache, lowering_context, function)?
    }
    for chunk in fresh.modules {
        let key = keys.get(chunk.module_index()).unwrap_or("")
        commit_lowered_module(request.cache, key, encode_typed_module(chunk.as_module(), key)?)?
        match translations.get(chunk.module_index()) {
            Some(module) => {
                publish_module_history(request.cache, lowering_context, project_version, module, key)?
            }
            None => {
            }
        }
        chunks.push(chunk)
    }
    let mut lowering_identities = Vec[(str, str)]::new()
    for index in selected {
        match translations.get(index) {
            Some(module) => {
                lowering_identities.push((module.module_id, keys.get(index).unwrap_or("")))
            }
            None => {
            }
        }
    }
    let cache_write_finished = perf_counter_ms()
    let mut counts = Vec[(str, Json)]::new()
    counts.push(("modules_reused", Json::Number(Debug::fmt(selected.len() - missing.len()))))
    counts.push(("modules_lowered", Json::Number(Debug::fmt(missing.len()))))
    counts.push(("translation_environment_reused", Json::Bool(fresh.environment_reused)))
    counts.push(("functions_reused", Json::Number(Debug::fmt(fresh.functions_reused))))
    counts.push(("functions_lowered", Json::Number(Debug::fmt(fresh.functions.len()))))
    counts.push(("checking_ms", Json::Number(Debug::fmt(checking_ms))))
    counts.push(("lowering_ms", Json::Number(Debug::fmt(perf_counter_ms() - frontend_started - checking_ms))))
    if write_file(request.output.join("lowering.json").as_str(), stringify(Json::Object(counts))) != 0 {
        ret Result[PreparedCompilationUnit, str]::Err("cannot record lowering reuse")
    }
    let entry = owner.name + if owner.target_is_binary {
        "@main.enq"
    } else {
        "@lib.enq"
    }
    let assemble_started = perf_counter_ms()
    let owned = assemble_typed_ehir_module_bundle(chunks, translations.len(), entry)
    let assemble_ms = perf_counter_ms() - assemble_started
    let serialize_started = perf_counter_ms()
    let lowered_payload = encode_compilation_checkpoint(owned, lowering_identities, package_frontend_fingerprint(request)?, request.cache)?
    let templates = encode_typed_bundle(incremental_codegen_context_bundle(owned), template_snapshot_key(request.context))?
    let serialize_ms = perf_counter_ms() - serialize_started
    if unit_source_digest(owner)? != request.context.input_digest {
        ret Result[PreparedCompilationUnit, str]::Err("package sources changed during compilation: " + owner.name)
    }
    let metadata = RefrainMetadata {
        request.context, dependencies, declarations, compiler_content_digest(templates)
    }
    let _validated_metadata = metadata.encode()?
    let mut timings = Vec[(str, Json)]::new()
    if detailed_timings {
        timings.push(("dependency_metadata_ms", Json::Number(Debug::fmt(dependencies_loaded - frontend_started))))
        timings.push(("workspace_load_ms", Json::Number(Debug::fmt(workspace_loaded - dependencies_loaded))))
        timings.push(("semantic_check_ms", Json::Number(Debug::fmt(checking_finished - workspace_loaded))))
        timings.push(("safety_effects_ms", Json::Number(Debug::fmt(safety_finished - checking_finished))))
        timings.push(("lowering_context_ms", Json::Number(Debug::fmt(cache_read_started - safety_finished))))
        timings.push(("lowering_cache_read_ms", Json::Number(Debug::fmt(cache_read_finished - cache_read_started))))
        timings.push(("lowering_translate_ms", Json::Number(Debug::fmt(translation_finished - cache_read_finished))))
        timings.push(("lowering_cache_write_ms", Json::Number(Debug::fmt(cache_write_finished - translation_finished))))
        timings.push(("ehir_parse_ms", Json::Number("0")))
        timings.push(("ehir_assemble_ms", Json::Number(Debug::fmt(assemble_ms))))
        timings.push(("ehir_serialize_ms", Json::Number(Debug::fmt(serialize_ms))))
    }
    ret Result[PreparedCompilationUnit, str]::Ok(PreparedCompilationUnit {
            metadata, owned, lowered_payload, lowering_identities, dependency_templates, timings
        }
        ,
    )
}

struct VerifiedDependency {
    metadata: RefrainMetadata
    templates: str
}

fn load_unit_dependencies(request: BuildUnitRequest) -> Result[Vec[VerifiedDependency], str] {
    let mut verified = Vec[VerifiedDependency]::new()
    while verified.len() < request.inputs.len() {
        let before = verified.len()
        for input in request.inputs {
            let mut installed = false
            for existing in verified {
                if existing.metadata.context.unit == input.context.unit {
                    installed = true
                }
            }
            if installed {
                continue
            }
            let owner = graph_package(request.graph, input.context.unit)?
            let mut ready = true
            let mut dependencies = Vec[MetadataDependency]::new()
            for name in owner.dependency_names {
                let mut found = false
                for existing in verified {
                    if existing.metadata.context.unit == name {
                        dependencies.push(MetadataDependency {
                                name, existing.metadata.interface_digest()?,
                                existing.metadata.template_digest
                            }
                            ,)
                        found = true
                    }
                }
                if !found {
                    ready = false
                }
            }
            if !ready {
                continue
            }
            let text = verified_input(input.directory.join("unit.ermeta"), input.metadata_digest)?
            let templates = verified_input(input.directory.join("unit.ertemplate"), input.template_digest)?
            let metadata = RefrainMetadata::decode(text, input.context, dependencies)?
            if metadata.template_digest != input.template_digest {
                ret Result[Vec[VerifiedDependency], str]::Err("dependency template identity mismatch: " + owner.name)
            }
            verified.push(VerifiedDependency { metadata, templates })
        }
        if before == verified.len() {
            ret Result[Vec[VerifiedDependency], str]::Err("dependency metadata graph cannot become ready")
        }
    }
    ret Result[Vec[VerifiedDependency], str]::Ok(verified)
}

fn verified_input(path: Path, expected: str) -> Result[str, str] {
    if !file_exists(path.as_str()) || file_sha256(path.as_str()) != expected {
        ret Result[str, str]::Err("missing or corrupt dependency artifact: " + path.as_str())
    }
    let contents = read_file(path.as_str())
    if compiler_content_digest(contents) != expected {
        ret Result[str, str]::Err("dependency artifact changed while reading: " + path.as_str())
    }
    ret Result[str, str]::Ok(contents)
}

struct SemanticSafetyJob {
    index: usize
    weight: usize
    slot: str
    prepared: PreparedSafetyModule
    replay_unchanged: bool
}

struct SemanticSafetyChunk {
    index: usize
    slot: str
    prepared: PreparedModuleSafety
    replay_unchanged: bool
}

fn check_semantic_safety_job(job: sending SemanticSafetyJob) -> sending SemanticSafetyChunk {
    ret SemanticSafetyChunk {
        job.index, job.slot, check_prepared_safety_module(job.prepared), job.replay_unchanged
    }
}

struct CheckedUnitSemantics {
    functions: Vec[SafetyFunction]
    verified_modules: Vec[str]
}
fn check_own_modules(workspace: mut ProjectWorkspace, target: TargetSpec, request: BuildUnitRequest, server: usize) -> Result[CheckedUnitSemantics, str] {
    let preparation_started = perf_counter_ms()
    let mut cache_read_ms = 0_u64
    let mut semantic_modules = Vec[str]::new()
    for module in workspace.modules {
        if module.owner_name == workspace.compilation_unit && module.diagnostics.is_empty() {
            semantic_modules.push(module.analysis_id.key())
        }
    }
    let identity = workspace.analysis.semantic_package_identity(semantic_modules)
    let index_slot = compiler_content_digest("encore-semantic-index-1\n" + request.context.compiler_digest + "\n" +
        request.context.target + "\n" + request.context.profile + "\n" + identity)
    let cache_started = perf_counter_ms()
    let mut snapshot_key = restore_lowered_module(request.cache, index_slot)?.unwrap_or("")
    let mut previous_index = Option[PackageSemanticIndex]::None
    if valid_key(snapshot_key) {
        match restore_lowered_module(request.cache, snapshot_key)? {
            Some(payload) => {
                match PackageSemanticIndex::decode(payload, identity) {
                    Ok(index) => {
                        previous_index = Option[PackageSemanticIndex]::Some(index)
                    }
                    Err(_) => {
                    }
                }
            }
            None => {
            }
        }
    }
    cache_read_ms += perf_counter_ms() - cache_started
    let index_reused = workspace.analysis.prepare_package_semantics(semantic_modules, identity, previous_index)
    let index_prepared = perf_counter_ms()
    if !index_reused && request.cache.is_some() {
        match workspace.analysis.package_semantic_index() {
            Some(index) => {
                let payload = index.encode()?
                snapshot_key = compiler_content_digest(payload)
                commit_lowered_module(request.cache, snapshot_key, payload)?
                commit_lowered_module(request.cache, index_slot, snapshot_key)?
            }
            None => {
            }
        }
    }
    let snapshot_write_ms = perf_counter_ms() - index_prepared
    let mut historical_types = Vec[(str, Vec[str])]::new()
    let mut checked = Vec[SafetyFunction]::new()
    let mut verified_modules = Vec[str]::new()
    let mut bodies_checked = 0_usize
    let mut bodies_reused = 0_usize
    let mut environments_reused = 0_usize
    let mut module_checks_reused = 0_usize
    let mut module_bodies_reused = 0_usize
    let mut tasks = Vec[SemanticSafetyJob]::new()
    let mut module_index = 0_usize
    for module in workspace.modules {
        let index = module_index
        module_index += 1_usize
        if module.owner_name != workspace.compilation_unit {
            continue
        }
        if !module.diagnostics.is_empty() {
            continue
        }
        let started = perf_counter_ms()
        if env("ENCORE_FRONTEND_PROFILE").is_some() {
            eprintln("frontend-check-start " + module.analysis_id.key())
        }
        let mut features = Vec[Json]::new()
        for feature in module.enabled_features {
            features.push(Json::String(feature))
        }
        let slot = compiler_content_digest("encore-semantic-module-3\n" + request.context.compiler_digest + "\n" +
            request.context.target + "\n" + request.context.profile + "\n" + module.module_id + "\n" + stringify(Json::Array(features)))
        let cache_started = perf_counter_ms()
        let mut previous = Json::Null
        let mut same_snapshot = false
        match restore_lowered_module(request.cache, slot)? {
            Some(payload) => {
                match decode_semantic_module(payload) {
                    Ok(record) => {
                        same_snapshot = record.index == snapshot_key
                        if same_snapshot {
                            previous = record.replay
                        } elif valid_key(record.index) {
                            let mut identities = Option[Vec[str]]::None
                            for entry in historical_types {
                                if entry.0 == record.index {
                                    identities = Option[Vec[str]]::Some(entry.1) break
                                }
                            }
                            if identities.is_none() {
                                match restore_lowered_module(request.cache, record.index)? {
                                    Some(old_payload) => {
                                        match PackageSemanticIndex::decode(old_payload, "") {
                                            Ok(index) => {
                                                let mapping = workspace.analysis.semantic_existing_type_rebinding(index.types)
                                                historical_types.push((record.index, mapping)) identities = Option[Vec[str]]::Some(mapping)
                                            }
                                            Err(_) => {
                                            }
                                        }
                                    }
                                    None => {
                                    }
                                }
                            }
                            match identities {
                                Some(mapping) => {
                                    previous = rebind_semantic_replay(record.replay, mapping)
                                }
                                None => {
                                }
                            }
                        }
                    }
                    Err(_) => {
                    }
                }
            }
            None => {
            }
        }
        cache_read_ms += perf_counter_ms() - cache_started
        let prepared = workspace.analysis.prepare_module_safety_job(module.analysis_id.key(), target, module.enabled_features,
            previous, request.cache.is_some(),)
        let replay_unchanged = same_snapshot && previous.get("source").unwrap_or(Json::Null).as_str().unwrap_or("") == compiler_content_digest(module.source) &&
        previous.get("context").unwrap_or(Json::Null).as_str().unwrap_or("") == prepared.context
        tasks.push(SemanticSafetyJob {
                index, module.source.byte_len(), slot, prepared, replay_unchanged
            }
        )
        profile_frontend("prepare-check " + module.analysis_id.key(), started)
    }
    // Long source modules run first; publication and diagnostics below retain
    // source order. No worker reads or mutates the owner's analysis database.
    let mut cursor = 1_usize
    while cursor < tasks.len() {
        let mut position = cursor
        while position > 0_usize {
            let left = match tasks.get(position - 1_usize) {
                Some(value) => value None => {
                    break
                }
            }
            let right = match tasks.get(position) {
                Some(value) => value None => {
                    break
                }
            }
            if left.weight >= right.weight {
                break
            }
            tasks.set(position - 1_usize, right)
            tasks.set(position, left)
            position -= 1_usize
        }
        cursor += 1_usize
    }
    let inputs_prepared = perf_counter_ms()
    let jobs = borrow_package_jobs(server, tasks.len())?
    let mut chunks = Vec[SemanticSafetyChunk]::new()
    let mut handles = Vec[JoinHandle[SemanticSafetyChunk]]::new()
    for task in tasks {
        if jobs == 1_usize {
            chunks.push(check_semantic_safety_job(task))
        } else {
            handles.push(spawn check_semantic_safety_job(task))
            if handles.len() == jobs {
                for handle in handles {
                    chunks.push(handle.join())
                }
                handles = Vec[JoinHandle[SemanticSafetyChunk]]::new()
            }
        }
    }
    for handle in handles {
        chunks.push(handle.join())
    }
    return_package_jobs(server, jobs)
    let bodies_finished = perf_counter_ms()
    module_index = 0_usize
    for module in workspace.modules {
        let index = module_index
        module_index += 1_usize
        if module.owner_name != workspace.compilation_unit {
            continue
        }
        for diagnostic in module.diagnostics {
            ret Result::Err(render_diagnostic(module.module_path.as_str(), module.source, diagnostic))
        }
        for chunk in chunks {
            if chunk.index != index {
                continue
            }
            let prepared = chunk.prepared
            bodies_checked += prepared.checked
            bodies_reused += prepared.reused
            if prepared.environment_reused {
                environments_reused += 1_usize
            }
            if prepared.module_checks_reused {
                module_checks_reused += 1_usize
            }
            if prepared.replay.get("module_bodies_reused").unwrap_or(Json::Null).as_bool().unwrap_or(false) {
                module_bodies_reused += 1_usize
            }
            for diagnostic in prepared.diagnostics {
                ret Result[CheckedUnitSemantics, str]::Err(render_diagnostic(module.module_path.as_str(), module.source, diagnostic))
            }
            if chunk.replay_unchanged && prepared.checked == 0_usize && prepared.diagnostics.is_empty() &&
            prepared.replay.get("valid").unwrap_or(Json::Null).as_bool().unwrap_or(false) {
                verified_modules.push(module.analysis_id.key())
            }
            if request.cache.is_some() &&(!chunk.replay_unchanged || !prepared.environment_reused || prepared.checked != 0_usize) {
                let replay = if request.cache.is_some() {
                    workspace.analysis.finalize_semantic_replay(module.analysis_id.key(), prepared.replay)
                } else {
                    prepared.replay
                }
                commit_lowered_module(request.cache, chunk.slot, encode_semantic_module(snapshot_key, replay)?)?
            }
            checked.extend(prepared.functions)
            break
        }
    }
    let timings = workspace.analysis.semantic_preparation_timings()
    let counts = Json::Object(vec![("semantic_index_reused", Json::Bool(index_reused)),
            ("module_bodies_reused", Json::Number(Debug::fmt(module_bodies_reused))),
            ("syntax_modules_reused", Json::Number(Debug::fmt(workspace.syntax_reused))),
            ("semantic_index_write_ms", Json::Number(Debug::fmt(snapshot_write_ms))),
            ("semantic_cache_read_ms", Json::Number(Debug::fmt(cache_read_ms))),
            ("semantic_context_ms", Json::Number(Debug::fmt(timings.context_ms))),
            ("semantic_replay_ms", Json::Number(Debug::fmt(timings.replay_ms))),
            ("semantic_environment_ms", Json::Number(Debug::fmt(timings.environment_ms))),
            ("semantic_environment_names_ms", Json::Number(Debug::fmt(timings.environment_names_ms))),
            ("semantic_environment_callables_ms", Json::Number(Debug::fmt(timings.environment_callables_ms))),
            ("semantic_environment_fields_ms", Json::Number(Debug::fmt(timings.environment_fields_ms))),
            ("semantic_environment_methods_ms", Json::Number(Debug::fmt(timings.environment_methods_ms))),
            ("semantic_environment_variants_ms", Json::Number(Debug::fmt(timings.environment_variants_ms))),
            ("semantic_environment_constructors_ms", Json::Number(Debug::fmt(timings.environment_constructors_ms))),
            ("semantic_environment_statics_ms", Json::Number(Debug::fmt(timings.environment_statics_ms))),
            ("semantic_environment_index_ms", Json::Number(Debug::fmt(timings.environment_index_ms))),
            ("semantic_environment_type_index_ms", Json::Number(Debug::fmt(timings.environment_type_index_ms))),
            ("semantic_environment_callable_scope_ms", Json::Number(Debug::fmt(timings.environment_callable_scope_ms))),
            ("semantic_callable_defmap_ms", Json::Number(Debug::fmt(timings.callable_defmap_ms))),
            ("semantic_callable_collect_ms", Json::Number(Debug::fmt(timings.callable_collect_ms))),
            ("semantic_callable_bind_ms", Json::Number(Debug::fmt(timings.callable_bind_ms))),
            ("semantic_callable_qualified_ms", Json::Number(Debug::fmt(timings.callable_qualified_ms))),
            ("semantic_method_collect_ms", Json::Number(Debug::fmt(timings.method_collect_ms))),
            ("semantic_method_visibility_ms", Json::Number(Debug::fmt(timings.method_visibility_ms))),
            ("semantic_method_inheritance_ms", Json::Number(Debug::fmt(timings.method_inheritance_ms))),
            ("semantic_method_scope_ms", Json::Number(Debug::fmt(timings.method_scope_ms))),
            ("semantic_environment_context_ms", Json::Number(Debug::fmt(timings.environment_context_ms))),
            ("semantic_environment_scopes_ms", Json::Number(Debug::fmt(timings.environment_scopes_ms))),
            ("semantic_environment_lookup_ms", Json::Number(Debug::fmt(timings.environment_lookup_ms))),
            ("semantic_environment_store_ms", Json::Number(Debug::fmt(timings.environment_store_ms))),
            ("semantic_environment_finish_ms", Json::Number(Debug::fmt(timings.environment_finish_ms))),
            ("semantic_environment_release_ms", Json::Number(Debug::fmt(timings.environment_release_ms))),
            ("semantic_constructors_aggregate_ms", Json::Number(Debug::fmt(timings.constructors_aggregate_ms))),
            ("semantic_constructors_lookup_ms", Json::Number(Debug::fmt(timings.constructors_lookup_ms))),
            ("semantic_input_ms", Json::Number(Debug::fmt(timings.input_ms))),
            ("bodies_checked", Json::Number(Debug::fmt(bodies_checked))),
            ("bodies_reused", Json::Number(Debug::fmt(bodies_reused))),("environments_reused", Json::Number(Debug::fmt(environments_reused))),
            ("module_checks_reused", Json::Number(Debug::fmt(module_checks_reused))),
            ("semantic_jobs", Json::Number(Debug::fmt(jobs))),("semantic_prepare_ms", Json::Number(Debug::fmt(inputs_prepared - preparation_started))),
            ("semantic_bodies_ms", Json::Number(Debug::fmt(bodies_finished - inputs_prepared))),
            ("semantic_publish_ms", Json::Number(Debug::fmt(perf_counter_ms() - bodies_finished)))])
    if write_file((request.output / "semantic.json").as_str(), stringify(counts)) != 0 {
        ret Result::Err("cannot record semantic reuse")
    }
    ret Result::Ok(CheckedUnitSemantics { checked, verified_modules })
}

fn profile_frontend(phase: str, started: u64) ->() {
    if env("ENCORE_FRONTEND_PROFILE").is_some() {
        eprintln("frontend-" + phase + " " + Debug::fmt(perf_counter_ms() - started) + " ms")
    }
}

// Function cfg filters must also apply to token-derived callable facts. The
// ordinary document keeps source spans, but inactive APIs cannot enter metadata.
fn target_document(document: FrontendDocument, ast: Vec[Statement]) -> FrontendDocument {
    let mut symbols = Vec[FrontendSymbol]::new()
    let mut callables = Vec[FrontendCallable]::new()
    for symbol in document.symbols {
        if symbol.kind != 12 || active_function_at(document, ast, symbol.line, symbol.column, symbol.name) {
            symbols.push(symbol)
        }
    }
    for callable in document.callables {
        if active_function_at(document, ast, callable.line, callable.column, callable.name) {
            callables.push(callable)
        }
    }
    ret FrontendDocument {
        document.tokens, ast, document.module_documentation, document.diagnostics,
        symbols, callables, document.dependencies, document.parsed
    }
}

fn active_function_at(document: FrontendDocument, ast: Vec[Statement], line: usize, column: usize, name: str) -> bool {
    for statement in ast {
        match statement {
            Statement::Function(item) => {
                if item.name == name {
                    let site = function_declaration_position(document, item)
                    if site.0 == line && site.1 == column {
                        ret true
                    }
                }
            }
            Statement::Impl(item) => {
                for method in item.methods {
                    if method.name == name {
                        let site = function_declaration_position(document, method)
                        if site.0 == line && site.1 == column {
                            ret true
                        }
                    }
                }
            }
            Statement::Trait(item) => {
                for method in item.methods {
                    if method.name == name {
                        let site = function_declaration_position(document, method)
                        if site.0 == line && site.1 == column {
                            ret true
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret false
}

#attr(test)
fn metadata_unit_split_function_name_contract() -> bool {
    let document = analyze_source("pub fn\nanswer() -> u32 { ret 42 }\n")
    let filtered = target_document(document, document.ast)
    ret document.parsed && filtered.callables.len() == 1 && filtered.symbols.len() == 1
}

#attr(test)
fn metadata_unit_split_async_signature_contract() -> bool {
    let document = analyze_source("pub async\nfn\nanswer() -> u32 { ret 42 }\n")
    let filtered = target_document(document, document.ast)
    ret document.parsed && filtered.callables.len() == 1 && filtered.symbols.len() == 1
}

#attr(test)
fn metadata_unit_same_line_cfg_methods_contract() -> bool {
    let document = analyze_source("struct A {} struct B {}\n" +
        "impl for A { #cfg(windows) fn read(self: Self) -> u32 { ret 1 } } " +
        "impl for B { fn read(self: Self) -> u32 { ret 2 } }\n")
    let ast = filter_ast_for_target(document.ast, parse_target("x86_64-unknown-linux-gnu"), Vec[str]::new())
    let filtered = target_document(document, ast)
    let mut count = 0_usize
    for symbol in filtered.symbols {
        if symbol.kind == 12 {
            count += 1
        }
    }
    ret document.parsed && document.callables.len() == 2 && filtered.callables.len() == 1 && count == 1
}
