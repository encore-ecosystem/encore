//! Implements `encore lint` and its deprecated `analyze` alias.

import core::fmt::Debug
import core::option::Option

import std::io::{eprintln, println}
import std::os::{file_exists, read_file, write_file}
import std::path::Path
import std::vec::Vec

import argparse::{process_arg, process_arg_count}
import json::{Json, field, stringify}
import rich::ProgressReporter

import refrain::analyzer::{AnalyzerConfig, AnalyzerDiagnostic, RuleLevel, analyzer_source_diagnostic_to_frontend, fix_source, lint_source_document, rule_is_known}
import refrain::diagnostics::{applicability_name, render_diagnostic}
import refrain::frontend::{AnalysisDatabase, FrontendDiagnostic, FrontendDocument, Lexer, Token}
import refrain::project::{ProjectToolingConfig, ProjectWorkspace, load_binary_workspace, load_library_workspace, read_project_tooling_config}

/// Runs the shared analyzer over a project or selected source file.
pub fn native_analyze() -> u32 {
    eprintln("warning: 'encore analyze' is deprecated; use 'encore lint'")
    ret native_lint()
}

/// Runs the shared linter over a project or selected source file.
pub fn native_lint() -> u32 {
    let progress = ProgressReporter::current()
    progress.stage("Analyzing: loading project", 0_usize)
    let mut root = Path::new(".").resolve()
    let selected = analyze_path()
    if selected != "" && !ends_with(selected, ".enq") {
        root = Path::new(selected).resolve()
    }

    let mut config = AnalyzerConfig::new()
    if file_exists(root.join("encore.toml").as_str()) {
        let tooling = read_project_tooling_config(root)
        if !tooling.is_valid() {
            eprintln("error[manifest]: " + tooling.error_message()) ret 2_u32
        }
        config = tooling.lint_config()
    }
    if !apply_cli_levels(config) {
        ret 2_u32
    }
    let format = option_value("--format")
    if format != "" && format != "full" && format != "json" {
        eprintln("Error: unsupported analyzer format '" + format + "'")
        ret 2_u32
    }

    let mut diagnostics = Vec[AnalyzerDiagnostic]::new()
    let mut module_count = 0_usize
    let mut fixed_count = 0_usize
    let apply_fixes = has_option("--fix")
    if selected != "" && ends_with(selected, ".enq") {
        let path = Path::new(selected).resolve()
        if !file_exists(path.as_str()) {
            eprintln("Error: analyzer path does not exist: " + selected) ret 2_u32
        }
        let mut source = read_file(path.as_str())
        progress.stage("Analyzing files", 1_usize)
        progress.task(0_usize, path.as_str(), "analyzing")
        if apply_fixes {
            let fixed = fix_source(source, config)
            if fixed != source {
                if write_file(path.as_str(), fixed) != 0_i32 {
                    eprintln("Error: unable to write " + path.as_str()) ret 2_u32
                }
                source = fixed
                fixed_count += 1_usize
            }
        }
        let mut database = AnalysisDatabase::new()
        database.set_module_full(path.as_str(), path.as_str(), source)
        let document = match database.document(path.as_str()) {
            Option[FrontendDocument]::Some(value) => value
            Option[FrontendDocument]::None => FrontendDocument::empty()
        }
        diagnostics.extend(lint_source_document(path.as_str(), source, document, config))
        module_count = 1_usize
        progress.complete(0_usize, path.as_str())
    } else {
        if !file_exists(root.join("encore.toml").as_str()) {
            eprintln("error[manifest]: Unable to find encore.toml at " + root.join("encore.toml").as_str()) ret 1_u32
        }
        let mut workspace = load_analysis_workspace(root)
        if apply_fixes {
            for module in workspace.modules {
                if module.owner_name == workspace.root_name {
                    let fixed = fix_source(module.source, config)
                    if fixed != module.source {
                        if write_file(module.path(), fixed) != 0_i32 {
                            eprintln("Error: unable to write " + module.path()) ret 2_u32
                        }
                        fixed_count += 1_usize
                    }
                }
            }
            if fixed_count > 0_usize {
                workspace = load_analysis_workspace(root)
            }
        }
        let mut total = 0_usize
        for module in workspace.modules {
            if module.owner_name == workspace.root_name || config.dependencies_are_enabled() {
                total += 1_usize
            }
        }
        progress.stage("Analyzing files", total)
        for module in workspace.modules {
            if module.owner_name == workspace.root_name {
                progress.task(module_count, module.path(), "analyzing")
                diagnostics.extend(lint_source_document(module.path(), module.source, module.analysis, config))
                progress.complete(module_count, module.path())
                module_count += 1_usize
            } elif config.dependencies_are_enabled() {
                progress.task(module_count, module.path(), "analyzing")
                diagnostics.extend(lint_source_document(module.path(), module.source, module.analysis, config.for_dependency()))
                progress.complete(module_count, module.path())
                module_count += 1_usize
            }
        }
    }

    let mut denied = false
    let mut current_path = ""
    let mut source = ""
    let mut tokens = Vec[Token]::new()
    for diagnostic in diagnostics {
        if current_path != diagnostic.path {
            current_path = diagnostic.path
            source = read_file(current_path)
            let mut lexer = Lexer::new()
            tokens = lexer.tokenize(source)
        }
        let structured = analyzer_source_diagnostic_to_frontend(diagnostic, source, tokens)
        if diagnostic.severity == RuleLevel::Deny || diagnostic.severity == RuleLevel::Forbid {
            denied = true
        }
        if format == "json" {
            println(diagnostic_json(diagnostic, structured))
        } else {
            print_diagnostic(diagnostic, structured, source)
        }
    }
    if format != "json" {
        if apply_fixes {
            let fixed_suffix = if fixed_count == 1_usize {
                ""
            } else {
                "s"
            }
            println("Fixed " + Debug::fmt(fixed_count) + " file" + fixed_suffix)
        }
        let suffix = if module_count == 1_usize {
            ""
        } else {
            "s"
        }
        println("Linted " + Debug::fmt(module_count) + " module" + suffix)
    }
    if denied {
        ret 1_u32
    }
    ret 0_u32
}

fn load_analysis_workspace(root: Path) -> ProjectWorkspace {
    if file_exists(root.join("src/main.enq").as_str()) {
        ret load_binary_workspace(root)
    }
    if file_exists(root.join("src").join("lib.enq").as_str()) {
        ret load_library_workspace(root)
    }
    ret load_binary_workspace(root)
}

fn apply_cli_levels(config: mut AnalyzerConfig) -> bool {
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--allow" || arg == "--warn" || arg == "--deny" || arg == "--forbid" {
            if index + 1_usize >= argc() {
                ret false
            }
            if !rule_is_known(argument(index + 1_usize)) {
                eprintln("Error: unknown lint rule '" + argument(index + 1_usize) + "'") ret false
            }
            let level = if arg == "--allow" {
                RuleLevel::Allow
            } elif arg == "--warn" {
                RuleLevel::Warn
            } elif arg == "--deny" {
                RuleLevel::Deny
            } else {
                RuleLevel::Forbid
            }
            config.set_level(argument(index + 1_usize), level)
            index += 1_usize
        } elif arg == "--format" {
            index += 1_usize
        }
        index += 1_usize
    }
    ret true
}

fn print_diagnostic(diagnostic: AnalyzerDiagnostic, structured: FrontendDiagnostic, source: str) ->() {
    eprintln(render_diagnostic(diagnostic.path, source, structured))
    ret()
}

fn diagnostic_json(diagnostic: AnalyzerDiagnostic, structured: FrontendDiagnostic) -> str {
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("path", Json::String(diagnostic.path)))
    fields.push(field("line", Json::Number(Debug::fmt(diagnostic.line + 1_usize))))
    fields.push(field("column", Json::Number(Debug::fmt(diagnostic.column + 1_usize))))
    fields.push(field("severity", Json::String(if diagnostic.severity == RuleLevel::Deny || diagnostic.severity == RuleLevel::Forbid {
                    "error"
                } else {
                    "warning"
                }
            )))
    fields.push(field("code", Json::String(diagnostic.code)))
    fields.push(field("message", Json::String(diagnostic.message)))
    let mut notes = Vec[Json]::new()
    for note in structured.notes {
        notes.push(Json::String(note))
    }
    fields.push(field("notes", Json::Array(notes)))
    let mut helps = Vec[Json]::new()
    for help in structured.helps {
        helps.push(Json::String(help))
    }
    fields.push(field("helps", Json::Array(helps)))
    let mut suggestions = Vec[Json]::new()
    for suggestion in structured.suggestions {
        let mut item = Vec[(str, Json)]::new()
        item.push(field("line", Json::Number(Debug::fmt(suggestion.line + 1_usize))))
        item.push(field("column", Json::Number(Debug::fmt(suggestion.column + 1_usize))))
        item.push(field("length", Json::Number(Debug::fmt(suggestion.length))))
        item.push(field("replacement", Json::String(suggestion.replacement)))
        item.push(field("message", Json::String(suggestion.message)))
        item.push(field("applicability", Json::String(applicability_name(suggestion.applicability))))
        suggestions.push(Json::Object(item))
    }
    fields.push(field("suggestions", Json::Array(suggestions)))
    ret stringify(Json::Object(fields))
}

fn analyze_path() -> str {
    let mut index = 2_usize
    while index < argc() {
        let arg = argument(index)
        if arg == "--allow" || arg == "--warn" || arg == "--deny" || arg == "--forbid" || arg == "--format" {
            index += 1_usize
        } elif arg == "--fix" {
        } elif !starts_with(arg, "-") {
            ret arg
        }
        index += 1_usize
    }
    ret ""
}

fn has_option(name: str) -> bool {
    let mut index = 2_usize
    while index < argc() {
        if argument(index) == name {
            ret true
        }
        index += 1_usize
    }
    ret false
}

fn option_value(name: str) -> str {
    let mut index = 2_usize
    while index + 1_usize < argc() {
        if argument(index) == name {
            ret argument(index + 1_usize)
        }
        index += 1_usize
    }
    ret ""
}

fn argument(index: usize) -> str {
    match argv(index) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            ret ""
        }
    }
}

fn starts_with(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}
fn ends_with(value: str, suffix: str) -> bool {
    ret suffix.len() <= value.len() && value.slice(value.len() - suffix.len(), suffix.len()) == suffix
}

fn argc() -> usize {
    ret process_arg_count()
}
fn argv(index: usize) -> Option[str] {
    ret process_arg(index)
}
