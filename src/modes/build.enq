import core::fmt::Debug
import core::option::Option
import core::io::eprintln
import std::os::write_file
import std::os::read_file
import std::os::env
import std::os::remove_file
import std::os::argc
import std::os::argv
import std::os::file_exists
import std::os::mkdir_all
import std::path::Path
import std::process::run_args
import std::vec::Vec

import ehirlib::parse_module_text
import ehir_llvm_backend::codegen::{emit_ir, emit_ir_for_target}

import refrain::frontend::sema::{semantic_check_error, semantic_check_error_for_target, semantic_check_error_for_target_and_features}
import refrain::frontend::translator::{filter_ast_for_target, translate_to_ehir, translate_to_ehir_for_target, translate_to_ehir_for_target_and_features}
import refrain::frontend::parser::statements::Statement
import refrain::project::load_binary_workspace
import refrain::project::WorkspaceModule
import refrain::project::WorkspaceRefrain
import refrain::project::{system_core_root, workspace_release_modules, workspace_root_refrain}
import refrain::project::manifest::{project_manifest_target, project_target_toolchain, read_project_manifest}
import refrain::target::{TargetSpec, Toolchain, default_toolchain, host_target, parse_target, target_executable_name, target_is_host, target_is_supported, toolchain_driver_is_supported}

import rich::BuildProgress

pub fn run_frontend_build() -> u32 {
    ret compile_project(Path::new(".").resolve())
}

pub fn compile_project(root: Path) -> u32 {
    ret compile_project_with_profile(root, requested_profile("debug"))
}

pub fn compile_project_with_profile(root: Path, requested: str) -> u32 {
    let profile = normalize_profile(requested)
    if profile == "" {
        eprintln("Error: unknown optimization profile: " + requested)
        ret 1_u32
    }

    let manifest = read_project_manifest(root)
    let manifest_target = project_manifest_target(manifest)
    let target_request = requested_value("--target", manifest_target)
    let target = if target_request == "" { host_target() } else { parse_target(target_request) }
    if !target_is_supported(target) {
        eprintln("Error: unsupported target architecture '" + target.arch + "' in '" + target.triple + "'")
        ret 1_u32
    }
    let emit = normalize_emit(requested_value("--emit", if target.freestanding { "object" } else { "binary" }))
    if emit == "" {
        eprintln("Error: --emit must be one of: ehir, llvm-ir, object, binary")
        ret 1_u32
    }
    let toolchain = requested_toolchain(root, target)
    match validate_toolchain(root, target, toolchain, emit) {
        Option[str]::Some(message) => { eprintln("Error: " + message) ret 1_u32 }
        Option[str]::None => {}
    }
    let mut progress = BuildProgress::auto()
    progress.start_build(path_name_or(root, "project"), profile)
    progress.start_stage("Workspace", "workspace")
    let mut workspace = load_binary_workspace(root)
    let ast = filtered_workspace_ast(workspace.modules, target)
    let module_count = workspace.modules.len()

    let mut project_name = "program"
    match workspace_root_refrain(workspace) {
        Option[WorkspaceRefrain]::Some(root_refrain) => {
            project_name = root_refrain.name
        }
        Option[WorkspaceRefrain]::None => {
            progress.fail_stage("workspace loaded without root refrain")
            ret 1_u32
        }
    }
    progress.finish_stage(Debug::fmt(workspace.refrains.len()) + " refrains, " + Debug::fmt(module_count) + " modules, " + Debug::fmt(ast.len()) + " AST nodes")

    let target_dir = root.join("target")
    let profile_dir = if target_request == "" || target_request == "auto" || target_request == "host" || target_request == "native" { target_dir.join(profile) } else { target_dir.join(target.triple).join(profile) }
    if mkdir_all(native_path(profile_dir.as_str())) != 0_i32 {
        progress.start_stage("Prepare", "creating target directory")
        progress.fail_stage("failed to create target directory")
        ret 1_u32
    }
    remove_file(native_path(root.join("target.bootstrap.ehir").as_str()))
    remove_file(native_path(root.join("target.bootstrap.ll").as_str()))

    progress.start_stage("Check", "workspace")
    if !run_workspace_semantic_checks(workspace.modules, target, progress) {
        progress.fail_stage("semantic checks failed")
        ret 1_u32
    }
    progress.finish_stage(Debug::fmt(module_count) + " modules")
    workspace_release_modules(workspace)

    progress.start_stage("Lower", project_name)
    progress.update(project_name, "EHIR", 1_usize, 1_usize)
    let out_path = profile_dir.join(project_name + ".ehir")
    if !write_ehir_artifact(ast, target, out_path) {
        progress.fail_stage("failed to write translated EHIR")
        ret 1_u32
    }
    progress.finish_stage("EHIR generated")
    if emit == "ehir" {
        progress.finish_artifact(profile, "EHIR", out_path.as_str())
        ret 0_u32
    }

    progress.start_stage("Codegen", "LLVM IR")
    progress.update(project_name, "LLVM IR", 1_usize, 1_usize)
    let llvm_path = profile_dir.join(project_name + ".ll")
    if !write_llvm_artifact(out_path, llvm_path, target) {
        progress.fail_stage("failed to write translated LLVM IR")
        ret 1_u32
    }
    progress.finish_stage("LLVM IR generated")
    if emit == "llvm-ir" {
        remove_file(native_path(out_path.as_str()))
        progress.finish_artifact(profile, "LLVM IR", llvm_path.as_str())
        ret 0_u32
    }

    progress.start_stage("Compile", "target objects")
    let binary_path = profile_dir.join(target_executable_name(target, project_name))
    let mut native_sources = Vec[Path]::new()
    let runtime_path = system_core_root(root).join("runtime.c").resolve()
    if toolchain.hosted_runtime { native_sources.push(runtime_path) }
    for configured_source in toolchain.runtime_sources {
        native_sources.push(resolve_project_path(root, configured_source))
    }
    for refrain in workspace.refrains {
        let candidate = refrain.root.join("runtime.c").resolve()
        if toolchain.hosted_runtime && !target.freestanding && candidate.as_str() != runtime_path.as_str() && file_exists(native_path(candidate.as_str())) {
            native_sources.push(candidate)
        }
        if toolchain.hosted_runtime && !target.freestanding {
            for feature in refrain.enabled_features {
                let feature_source = refrain.root.join("runtime." + feature + ".c").resolve()
                if file_exists(native_path(feature_source.as_str())) { native_sources.push(feature_source) }
            }
        }
    }
    let object_dir = profile_dir.join("object")
    progress.suspend()
    if mkdir_all(native_path(object_dir.as_str())) != 0_i32 {
        progress.fail_stage("failed to create object directory")
        ret 1_u32
    }
    let object_suffix = if target.os == "windows" { ".obj" } else { ".o" }
    let llvm_object = object_dir.join(project_name + object_suffix)
    let mut llvm_args = compiler_args(profile, target, toolchain)
    llvm_args.push("-c")
    llvm_args.push(native_path(llvm_path.as_str()))
    llvm_args.push("-o")
    llvm_args.push(native_path(llvm_object.as_str()))
    if run_args(toolchain.compiler, llvm_args) != 0_i32 {
        progress.fail_stage("LLVM IR assembly failed for target " + target.triple)
        ret 1_u32
    }
    if emit == "object" {
        remove_file(native_path(out_path.as_str()))
        remove_file(native_path(llvm_path.as_str()))
        progress.finish_stage("1 target object")
        progress.finish_artifact(profile, "Object", llvm_object.as_str())
        ret 0_u32
    }
    let mut objects = Vec[str]::new()
    objects.push(native_path(llvm_object.as_str()))
    let mut source_index = 0_usize
    while source_index < native_sources.len() {
        match native_sources.get(source_index) {
            Option[Path]::Some(source) => {
                let object = object_dir.join("native_" + Debug::fmt(source_index) + object_suffix)
                let mut native_args = compiler_args(profile, target, toolchain)
                native_args.push("-c")
                native_args.push(native_path(source.as_str()))
                native_args.push("-o")
                native_args.push(native_path(object.as_str()))
                if run_args(toolchain.compiler, native_args) != 0_i32 {
                    progress.fail_stage("native runtime compilation failed for target " + target.triple)
                    ret 1_u32
                }
                objects.push(native_path(object.as_str()))
            }
            Option[Path]::None => {}
        }
        source_index = source_index + 1_usize
    }
    progress.finish_stage(Debug::fmt(native_sources.len() + 1_usize) + " target objects")

    progress.start_stage("Link", project_name)
    progress.suspend()
    if native_sources.len() == 0_usize {
        progress.fail_stage("binary output requires builtin-runtime or target.runtime-sources")
        ret 1_u32
    }
    let mut link_args = target_tool_args(target, toolchain)
    for object in objects { link_args.push(object) }
    if toolchain.linker_script != "" { link_args.push("-T") link_args.push(native_path(resolve_project_path(root, toolchain.linker_script).as_str())) }
    for arg in toolchain.link_args { link_args.push(arg) }
    link_args.push("-o")
    link_args.push(native_path(binary_path.as_str()))
    let link_code = run_args(toolchain.linker, link_args)
    remove_file(native_path(out_path.as_str()))
    remove_file(native_path(llvm_path.as_str()))
    if link_code != 0_i32 {
        progress.fail_stage("native link failed for target " + target.triple)
        ret 1_u32
    }
    progress.finish_stage("native binary")
    progress.finish_build(profile, binary_path.as_str())
    ret 0_u32
}

fn write_ehir_artifact(ast: Vec[Statement], target: TargetSpec, path: Path) -> bool {
    let text = translate_to_ehir_for_target(ast, target)
    ret write_file(native_path(path.as_str()), text) == 0_i32
}

fn write_llvm_artifact(ehir_path: Path, llvm_path: Path, target: TargetSpec) -> bool {
    let ehir_text = read_file(native_path(ehir_path.as_str()))
    let module = parse_module_text("encore_bootstrap", ehir_text)
    let llvm_text = emit_ir_for_target(module, target.triple, target.pointer_width)
    ret write_file(native_path(llvm_path.as_str()), llvm_text) == 0_i32
}

fn normalize_emit(value: str) -> str {
    if value == "ehir" { ret "ehir" }
    if value == "llvm-ir" || value == "llvm" || value == "ir" { ret "llvm-ir" }
    if value == "object" || value == "obj" { ret "object" }
    if value == "binary" || value == "bin" { ret "binary" }
    ret ""
}

fn requested_toolchain(root: Path, target: TargetSpec) -> Toolchain {
    let defaults = project_target_toolchain(root, target, default_toolchain(target))
    ret Toolchain{
        defaults.driver,
        requested_value("--cc", defaults.compiler),
        requested_value("--linker", defaults.linker),
        requested_value("--ar", defaults.archiver),
        requested_value("--sysroot", defaults.sysroot),
        requested_value("--target-cpu", defaults.cpu),
        requested_value("--target-features", defaults.features),
        defaults.compile_args,
        defaults.link_args,
        defaults.runtime_sources,
        requested_value("--linker-script", defaults.linker_script),
        defaults.hosted_runtime
    }
}

fn validate_toolchain(root: Path, target: TargetSpec, toolchain: Toolchain, emit: str) -> Option[str] {
    if emit == "ehir" || emit == "llvm-ir" { ret Option[str]::None }
    if !toolchain_driver_is_supported(toolchain.driver) {
        ret Option[str]::Some("unsupported target toolchain driver '" + toolchain.driver + "'; supported drivers: clang")
    }
    if explicit_tool_path_missing(toolchain.compiler) { ret Option[str]::Some("target compiler does not exist: " + toolchain.compiler) }
    if emit == "binary" && explicit_tool_path_missing(toolchain.linker) { ret Option[str]::Some("target linker does not exist: " + toolchain.linker) }
    if toolchain.sysroot != "" && !file_exists(native_path(resolve_project_path(root, toolchain.sysroot).as_str())) {
        ret Option[str]::Some("target sysroot does not exist: " + toolchain.sysroot)
    }
    for source in toolchain.runtime_sources {
        if !file_exists(native_path(resolve_project_path(root, source).as_str())) {
            ret Option[str]::Some("target runtime source does not exist: " + source)
        }
    }
    if emit == "binary" && toolchain.linker_script != "" && !file_exists(native_path(resolve_project_path(root, toolchain.linker_script).as_str())) {
        ret Option[str]::Some("target linker script does not exist: " + toolchain.linker_script)
    }
    if emit == "binary" && target.freestanding && !toolchain.hosted_runtime && toolchain.runtime_sources.len() == 0_usize {
        ret Option[str]::Some("freestanding binary requires target.runtime-sources")
    }
    ret Option[str]::None
}

fn explicit_tool_path_missing(value: str) -> bool {
    if !contains_path_separator(value) { ret false }
    ret !file_exists(native_path(Path::new(value).resolve().as_str()))
}

fn contains_path_separator(value: str) -> bool {
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "/" || ch == "\\" { ret true }
        index += 1_usize
    }
    ret false
}

pub fn requested_target(root: Path) -> TargetSpec {
    let manifest = read_project_manifest(root)
    ret parse_target(requested_value("--target", project_manifest_target(manifest)))
}

pub fn target_profile_dir(root: Path, target: TargetSpec, profile: str) -> Path {
    let raw = requested_value("--target", project_manifest_target(read_project_manifest(root)))
    if raw == "" || raw == "auto" || raw == "host" || raw == "native" { ret root.join("target").join(profile) }
    ret root.join("target").join(target.triple).join(profile)
}

fn compiler_args(profile: str, target: TargetSpec, toolchain: Toolchain) -> Vec[str] {
    let mut args = target_tool_args(target, toolchain)
    if target.os == "windows" { args.push("-O0") }
    elif profile == "debug" { args.push("-O0") args.push("-g") }
    else { args.push("-O2") }
    args.push("-Wno-override-module")
    for arg in toolchain.compile_args { args.push(arg) }
    ret args
}

fn resolve_project_path(root: Path, value: str) -> Path {
    let path = Path::new(value)
    if path.is_absolute() { ret path.resolve() }
    ret root.join(value).resolve()
}

fn target_tool_args(target: TargetSpec, toolchain: Toolchain) -> Vec[str] {
    let mut args = Vec[str]::new()
    if !target_is_host(target) { args.push("--target=" + target.triple) }
    if toolchain.sysroot != "" { args.push("--sysroot=" + native_path(toolchain.sysroot)) }
    if toolchain.cpu != "" { args.push("-mcpu=" + toolchain.cpu) }
    append_target_features(args, toolchain.features)
    if target.freestanding { args.push("-ffreestanding") }
    ret args
}

fn append_target_features(args: mut Vec[str], features: str) -> () {
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= features.len() {
        if index == features.len() || features.slice(index, 1_usize) == "," {
            if index > start {
                let feature = features.slice(start, index - start)
                args.push("-Xclang")
                args.push("-target-feature")
                args.push("-Xclang")
                args.push(feature)
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret ()
}

fn requested_value(name: str, fallback: str) -> str {
    let mut index = 2_usize
    while index + 1_usize < argc() {
        match argv(index) {
            Some(arg) => { if arg == name { match argv(index + 1_usize) { Some(value) => { ret value } None => {} } } }
            None => {}
        }
        index = index + 1_usize
    }
    ret fallback
}

pub fn requested_profile(fallback: str) -> str {
    let mut profile = fallback
    let mut index = 2_usize
    while index < argc() {
        match argv(index) {
            Some(arg) => {
                if arg == "--" { ret profile }
                if arg == "--release" { profile = "release" }
                elif arg == "--debug" { profile = "debug" }
                elif (arg == "--profile" || arg == "--opt-profile") && index + 1_usize < argc() {
                    match argv(index + 1_usize) { Some(value) => { profile = value } None => {} }
                    index = index + 1_usize
                }
            }
            None => {}
        }
        index = index + 1_usize
    }
    ret profile
}

fn normalize_profile(profile: str) -> str {
    if profile == "debug" || profile == "release" || profile == "extreme" { ret profile }
    ret ""
}

pub fn compile_test_ast(root: Path, ast: Vec[Statement], binary_name: str) -> u32 {
    let ehir_text = translate_to_ehir(ast)
    let tests_dir = root.join("target").join("tests")
    if mkdir_all(native_path(tests_dir.as_str())) != 0_i32 { ret 1_u32 }
    let binary_dir = tests_dir.join("bin")
    if mkdir_all(native_path(binary_dir.as_str())) != 0_i32 { ret 1_u32 }
    let ehir_path = tests_dir.join(binary_name + ".ehir")
    let llvm_path = tests_dir.join(binary_name + ".ll")
    let binary_path = binary_dir.join(target_executable_name(host_target(), binary_name))
    if write_file(native_path(ehir_path.as_str()), ehir_text) != 0_i32 { ret 1_u32 }
    let llvm_text = emit_ir(parse_module_text("encore_test", ehir_text))
    if write_file(native_path(llvm_path.as_str()), llvm_text) != 0_i32 { ret 1_u32 }
    let runtime_path = system_core_root(root).join("runtime.c").resolve()
    let mut args = Vec[str]::new()
    args.push("-O0")
    args.push("-g")
    args.push("-Wno-override-module")
    args.push(native_path(llvm_path.as_str()))
    args.push(native_path(runtime_path.as_str()))
    let package_runtime = root.join("runtime.c").resolve()
    if package_runtime.as_str() != runtime_path.as_str() && file_exists(native_path(package_runtime.as_str())) {
        args.push(native_path(package_runtime.as_str()))
    }
    args.push("-o")
    args.push(native_path(binary_path.as_str()))
    let clang_code = run_args("clang", args)
    if !keep_temporary_artifacts() {
        remove_file(native_path(ehir_path.as_str()))
        remove_file(native_path(llvm_path.as_str()))
    }
    if clang_code != 0_i32 { ret 1_u32 }
    ret 0_u32
}

fn keep_temporary_artifacts() -> bool {
    match env("ENCORE_KEEP_TEMPS") {
        Option[str]::Some(value) => { ret value == "1" || value == "true" }
        Option[str]::None => { ret false }
    }
}

fn native_path(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "/"
        }
        else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out
}

fn run_workspace_semantic_checks(modules: Vec[WorkspaceModule], target: TargetSpec, progress: mut BuildProgress) -> bool {
    let mut index = 0_usize
    while index < modules.len() {
        match modules.get(index) {
            Option[WorkspaceModule]::Some(module) => {
                progress.update(module.owner_name, module_display_name(module), index + 1_usize, modules.len())
                if module.diagnostics.len() > 0_usize {
                    progress.suspend()
                    for diagnostic in module.diagnostics {
                        eprintln(native_path(module.module_path.as_str()) + ":" + Debug::fmt(diagnostic.line + 1_usize) + ":" + Debug::fmt(diagnostic.column + 1_usize) + ": error[" + diagnostic.code + "]: " + diagnostic.message)
                    }
                    ret false
                }
                match semantic_check_error_for_target_and_features(module.ast, target, module.enabled_features) {
                    Option[str]::Some(message) => {
                        progress.suspend()
                        eprintln("Semantic error: " + message)
                        eprintln("module: " + native_path(module.module_path.as_str()))
                        ret false
                    }
                    Option[str]::None => {}
                }
            }
            Option[WorkspaceModule]::None => {
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn filtered_workspace_ast(modules: Vec[WorkspaceModule], target: TargetSpec) -> Vec[Statement] {
    let mut ast = Vec[Statement]::new()
    for module in modules { ast.extend(filter_ast_for_target(module.ast, target, module.enabled_features)) }
    ret ast
}

fn module_display_name(module: WorkspaceModule) -> str {
    match module.module_path.name() {
        Option[str]::Some(name) => { ret name }
        Option[str]::None => {}
    }
    ret native_path(module.module_path.as_str())
}

fn path_name_or(path: Path, fallback: str) -> str {
    match path.name() {
        Option[str]::Some(name) => { ret name }
        Option[str]::None => { ret fallback }
    }
}
