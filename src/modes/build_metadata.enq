fn metadata_graph_snapshot_rejects_bad_identities_contract() -> bool {
    let graph = match unit_fixture_graph(Path::new("target/graph-snapshot").resolve()) {
        Ok(value) => value Err(_) => {
            ret false
        }
    }
    let mut duplicate = Vec[WorkspaceRefrain]::new() duplicate.extend(graph.refrains) duplicate.extend(graph.refrains)
    let duplicates = ResolvedPackageGraph { graph.root_name, duplicate, graph.enabled_features }
    let missing_root = ResolvedPackageGraph {
        "missing-root", graph.refrains, graph.enabled_features
    }
    if encode_build_graph(duplicates).is_ok() {
        ret false
    }
    if encode_build_graph(missing_root).is_ok() {
        ret false
    }
    ret decode_build_graph("{}").is_err() && decode_build_graph("{\"schema\":2}").is_err()
}

#attr(test)
fn metadata_graph_snapshot_rejects_dependency_cycles_contract() -> bool {
    let graph = match unit_fixture_graph(Path::new("target/graph-snapshot").resolve()) {
        Ok(value) => value Err(_) => {
            ret false
        }
    }
    let mut cycle = Vec[WorkspaceRefrain]::new()
    for package in graph.refrains {
        if package.name == "sample" {
            let mut dependencies = Vec[str]::new() dependencies.push("consumer")
            cycle.push(WorkspaceRefrain {
                    package.name, package.root, package.distribution_root, package.source_key,
                    package.target_is_binary, package.manifest, dependencies, package.enabled_features
                }
                ,)
        } else {
            cycle.push(package)
        }
    }
    ret encode_build_graph(ResolvedPackageGraph { graph.root_name, cycle, graph.enabled_features }).is_err()
}
