fn unit_fixture_graph(root: Path) -> Result[ResolvedPackageGraph, ProjectFailure] {
    let consumer = try_parse_project_manifest("[project]\nname=\"consumer\"\nversion=\"0.0.0\"\ndependencies=[]\n", root.join("consumer/encore.toml"))?
    let sample = try_parse_project_manifest("[project]\nname=\"sample\"\nversion=\"0.0.0\"\ndependencies=[]\n", root.join("sample/encore.toml"))?
    let mut dependencies = Vec[str]::new() dependencies.push("sample")
    let mut refrains = Vec[WorkspaceRefrain]::new()
    refrains.push(WorkspaceRefrain {
            "consumer", root.join("consumer"), root, "fixture:consumer", true,
            consumer, dependencies, Vec[str]::new()
        }
        ,)
    refrains.push(WorkspaceRefrain {
            "sample", root.join("sample"), root, "fixture:sample", false,
            sample, Vec[str]::new(), Vec[str]::new()
        }
        ,)
    ret Result[ResolvedPackageGraph, ProjectFailure]::Ok(ResolvedPackageGraph {
            "consumer", refrains, Vec[str]::new()
        }
        ,
    )
}

fn unit_fixture_run(root: Path) -> bool {
    if mkdir_all(root.join("consumer/src").as_str()) != 0 || mkdir_all(root.join("sample/src").as_str()) != 0 {
        ret false
    }
    if write_file(root.join("consumer/src/main.enq").as_str(),
        "import sample::{Item, trusted}\nfn main() -> u32 { let value = Item{1} ret trusted() }\n",) != 0 {
        ret false
    }
    // There is a real dependency source on disk, but it must not be read.
    let dependency_source = root.join("sample/src/lib.enq")
    if write_file(dependency_source.as_str(), "this deliberately cannot parse { [") != 0 {
        ret false
    }
    let graph = match unit_fixture_graph(root) {
        Ok(value) => value Err(_) => {
            ret false
        }
    }
    let original = analysis_fixture_metadata()
    let compiled = original.compiled_modules().unwrap_or(Vec[CompiledWorkspaceModule]::new())
    if compiled.len() != 1 {
        ret false
    }
    let mut pass = 0_usize
    while pass < 2 {
        let mut unit = match try_load_compilation_unit(graph, "consumer", compiled) {
            Ok(value) => value Err(_) => {
                ret false
            }
        }
        if unit.modules.len() != 2 || unit.analysis.module_parse_count("sample") != 0
        || unit.analysis.module_lightweight_count("sample") != 0 || unit.analysis.module_parse_count("consumer") != 1
        || unit.analysis.module_semantic_diagnostics("consumer").len() != 0 {
            ret false
        }
        for module in unit.modules {
            if module.owner_name == "sample" &&(module.source != "" || module.analysis.tokens.len() != 0) {
                ret false
            }
            if module.owner_name == "consumer" &&(module.resolved_imports.len() != 1 || module.diagnostics.len() != 0) {
                ret false
            }
        }
        if pass == 0 && remove_file(dependency_source.as_str()) != 0 {
            ret false
        }
        pass += 1
    }
    if try_load_compilation_unit(graph, "consumer", Vec[CompiledWorkspaceModule]::new()).is_ok() {
        ret false
    }
    let mut duplicate = Vec[CompiledWorkspaceModule]::new() duplicate.extend(compiled) duplicate.extend(compiled)
    if try_load_compilation_unit(graph, "consumer", duplicate).is_ok() {
        ret false
    }
    let first = compiled.get(0).unwrap_or(CompiledWorkspaceModule {
            "", "", "", FrontendDocument::empty(), Vec[FunctionSafety]::new(), Vec[str]::new()
        }
        ,
    )
    let mut invalid = Vec[CompiledWorkspaceModule]::new()
    invalid.push(CompiledWorkspaceModule {
            first.owner_name, "../outside.enq", first.interface_digest, first.document, first.safety, first.resolved_imports
        }
        ,
    )
    if try_load_compilation_unit(graph, "consumer", invalid).is_ok() {
        ret false
    }
    let mut unresolved = Vec[str]::new() unresolved.push("sample@missing.enq")
    let mut absent = Vec[CompiledWorkspaceModule]::new()
    absent.push(CompiledWorkspaceModule {
            first.owner_name, first.source, first.interface_digest, first.document, first.safety, unresolved
        }
        ,
    )
    ret try_load_compilation_unit(graph, "consumer", absent).is_err()
}

#attr(test)
fn metadata_unit_loader_never_reads_dependencies_contract() -> bool {
    let parent = Path::new("target").resolve()
    if mkdir_all(parent.as_str()) != 0 {
        ret false
    }
    let prefix = "metadata-unit-" + Debug::fmt(perf_counter_ms()) + "-"
    let mut root = Path::new("")
    let mut attempt = 0_usize
    while attempt < 100 {
        let candidate = parent.join(prefix + Debug::fmt(attempt))
        if mkdir(candidate.as_str()) == 0 {
            root = candidate break
        }
        attempt += 1
    }
    if attempt == 100 {
        ret false
    }
    let success = unit_fixture_run(root)
    let removed = remove_dir_all(root.as_str())
    ret success && removed == 0
}

