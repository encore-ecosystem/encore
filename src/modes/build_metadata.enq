fn fixture_context() -> MetadataContext {
    ret MetadataContext {
        "sample", compiler_content_digest("compiler"), "x86_64-unknown-linux-gnu",
        "dev", compiler_content_digest("source"), Vec[str]::new()
    }
}

fn fixture_metadata() -> RefrainMetadata {
    let mut lexer = Lexer::new()
    let mut parser = Parser::new_for_source("sample@model.enq")
    let declarations = parser.parse_result(lexer.tokenize("pub fn value() -> u32 { ret 42 }")).unwrap_or(Vec[Statement]::new())
    let mut modules = Vec[MetadataModule]::new()
    let mut safety = Vec[FunctionSafety]::new()
    safety.push(FunctionSafety { "sample::model", "", "value", 0, 7, false, true, false })
    modules.push(MetadataModule {
            "sample@model.enq", "model.enq", Vec[str]::new(), declarations,
            Option[Documentation]::Some(Documentation::new("Module description", 0, 0)), safety,
            Vec[FrontendSymbol]::new(), Vec[FrontendCallable]::new(), Vec[DependencyEdge]::new()
        }
        ,)
    ret RefrainMetadata {
        fixture_context(), Vec[MetadataDependency]::new(), modules, compiler_content_digest("templates")
    }
}

#attr(test)
fn metadata_envelope_digest_vectors_contract() -> bool {
    ret compiler_content_digest("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    && compiler_content_digest("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    && metadata_digest("interface", Json::String("same")) != metadata_digest("template", Json::String("same"))
}

#attr(test)
fn metadata_envelope_round_trip_contract() -> bool {
    let original = fixture_metadata()
    let text = match original.encode() {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    let restored = match RefrainMetadata::decode(text, original.context, original.dependencies) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    if restored.modules.len() != 1 {
        ret false
    }
    for module in restored.modules {
        if module.documentation.unwrap_or(Documentation::new("", 0, 0)).text != "Module description"
        || module.safety.len() != 1 || module.declarations.len() != 1 {
            ret false
        }
        for effect in module.safety {
            if effect.is_unsafe() || !effect.asserted_safe {
                ret false
            }
        }
        for statement in module.declarations {
            match statement {
                Statement::Function(item) => {
                    if item.body.is_some() {
                        ret false
                    }
                }
                _ => {
                    ret false
                }
            }
        }
    }
    ret restored.encode().unwrap_or("") == text
}

#attr(test)
fn metadata_repeated_safety_contract_is_not_duplicate_identity() -> bool {
    let original = fixture_metadata()
    let baseline = original.interface_digest().unwrap_or("")
    let mut modules = original.modules
    let module = match modules.get(0) {
        Some(value) => value None => {
            ret false
        }
    }
    let mut effects = module.safety
    let effect = match effects.get(0) {
        Some(value) => value None => {
            ret false
        }
    }
    effects.push(FunctionSafety {
            effect.module_name, effect.owner, effect.name, 20, 3,
            effect.body_unsafe, effect.asserted_safe, effect.returns_unsafe_callable
        }
        ,)
    modules.set(0, MetadataModule {
            module.id, module.source, module.imports, module.declarations,
            module.documentation, effects, module.symbols, module.callables, module.edges
        }
        ,)
    let repeated = RefrainMetadata {
        original.context, original.dependencies, modules, original.template_digest
    }
    ret baseline != "" && baseline == repeated.interface_digest().unwrap_or("")
}

