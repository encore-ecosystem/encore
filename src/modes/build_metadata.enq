//! Versioned dependency declarations, independent of source parsing and archives.

import core::fmt::Debug
import core::option::Option
import core::result::Result

import std::vec::Vec

import json::{Json, parse, stringify}

import refrain::cache_identity::compiler_content_digest
import refrain::frontend::analysis::{FrontendCallable, FrontendDiagnostic, FrontendDocument, FrontendSymbol}
import refrain::frontend::dependency_graph::{DependencyEdge, DependencyGraph}
import refrain::frontend::lexer::Token
import refrain::frontend::metadata_ast::{decode_metadata_ast, decode_metadata_documentation, decode_metadata_position, encode_metadata_ast, encode_metadata_ast_for_module, encode_metadata_contract_ast, encode_metadata_documentation, metadata_interface_ast}
import refrain::frontend::parser::{Documentation, Statement}
import refrain::frontend::safety::FunctionSafety
import refrain::project::workspace::CompiledWorkspaceModule

/// Interface and template identities consumed by one dependent package.
/// Ordinary body/archive hashes intentionally are not frontend dependencies.
pub struct MetadataDependency {
    unit: str
    interface_digest: str
    template_digest: str
}

/// One package-owned module. No source text or dependency parser is involved.
pub struct MetadataModule {
    id: str
    source: str
    imports: Vec[str]
    declarations: Vec[Statement]
    documentation: Option[Documentation]
    safety: Vec[FunctionSafety]
    symbols: Vec[FrontendSymbol]
    callables: Vec[FrontendCallable]
    edges: Vec[DependencyEdge]
}

impl for MetadataModule {
    /// Captures facts already checked by this package worker, not sources of
    /// its dependencies. The enclosing encoder removes runtime bodies.
    pub fn from_document(id: str, source: str, document: FrontendDocument,
        imports: Vec[str], safety: Vec[FunctionSafety],) -> Self {
        ret Self {
            id, source, imports, document.ast, document.module_documentation,
            safety, document.symbols, document.callables, document.dependencies.all()
        }
    }

    /// Gives semantic analysis its normal declaration representation while
    /// keeping both lexer tokens and source text absent at this boundary.
    pub fn document(self: Self) -> FrontendDocument {
        let mut graph = DependencyGraph::new()
        for edge in self.edges {
            graph.add_at(edge.source, edge.target, edge.is_public, edge.line, edge.column, edge.length)
        }
        ret FrontendDocument {
            Vec[Token]::new(), metadata_interface_ast(self.declarations), self.documentation,
            Vec[FrontendDiagnostic]::new(), self.symbols, self.callables, graph, true
        }
    }
}

/// Checked compiler/target context; a cache key is never an ABI symbol name.
pub struct MetadataContext {
    unit: str
    compiler_digest: str
    target: str
    profile: str
    input_digest: str
    features: Vec[str]
}

impl for MetadataContext {
    /// The private worker protocol reuses the artifact's checked context codec.
    pub fn encode(self: Self) -> Result[Json, str] {
        ret encode_context(self)
    }

    /// Decodes a coordinator-supplied expected context, never a cache fallback.
    pub fn decode(value: Json) -> Result[Self, str] {
        ret decode_context(value)
    }
}

/// Metadata readiness is separate from availability of the package archive.
pub struct RefrainMetadata {
    context: MetadataContext
    dependencies: Vec[MetadataDependency]
    modules: Vec[MetadataModule]
    template_digest: str
}

/// Hashes canonical structured data, including domain and schema separation.
pub fn metadata_digest(domain: str, data: Json) -> str {
    ret compiler_content_digest("encore-refrain-metadata-v1\n" + domain + "\n" + stringify(data))
}

impl for RefrainMetadata {
    /// Reuses checked declarations when only dependency template bodies changed.
    /// The original snapshot is fully decoded before its template edges change;
    /// every current dependency must retain the same caller-visible interface.
    pub fn decode_frontend(text: str, expected: MetadataContext,
        dependencies: Vec[MetadataDependency],) -> Result[Self, str] {
        let data = match parse(text) {
            Ok(value) => value Err(_) => {
                ret Result[Self, str]::Err("invalid frontend metadata JSON")
            }
        }
        let previous = decode_dependencies(data.get("dependencies").unwrap_or(Json::Null))?
        let mut restored = Self::decode(text, expected, previous)?
        if previous.len() != dependencies.len() {
            ret Result[Self, str]::Err("frontend dependency set changed")
        }
        for dependency in dependencies {
            let mut found = false
            for old in previous {
                if old.unit == dependency.unit && old.interface_digest == dependency.interface_digest {
                    found = true
                }
            }
            if !found {
                ret Result[Self, str]::Err("frontend dependency interface changed")
            }
        }
        let _valid = encode_dependencies(dependencies)?
        restored.dependencies = dependencies
        ret Result[Self, str]::Ok(restored)
    }

    /// The frontend contract key deliberately excludes source/body checksums,
    /// native archive identities, template bodies, docs and source coordinates.
    /// Changing a transitive template alone is a backend invalidation instead.
    pub fn interface_digest(self: Self) -> Result[str, str] {
        validate_context(self.context)?
        let _valid_dependencies = encode_dependencies(self.dependencies)?
        let mut contract = Vec[Json]::new()
        contract.push(Json::String(self.context.unit))
        contract.push(Json::String(self.context.compiler_digest))
        contract.push(Json::String(self.context.target))
        contract.push(Json::String(self.context.profile))
        contract.push(encode_names(self.context.features)?)
        let mut dependencies = Vec[str]::new()
        for dependency in self.dependencies {
            let mut fields = Vec[Json]::new()
            fields.push(Json::String(dependency.unit)) fields.push(Json::String(dependency.interface_digest))
            dependencies.push(stringify(Json::Array(fields)))
        }
        contract.push(encode_names(dependencies)?)
        let mut names = Vec[str]::new()
        for module in self.modules {
            names.push(module.id)
        }
        for name in sorted_names(names)? {
            for module in self.modules {
                if module.id != name {
                    continue
                }
                if !module_identity_valid(self.context.unit, module.id, module.source) {
                    ret Result[str, str]::Err("invalid metadata module identity")
                }
                let mut fields = Vec[Json]::new()
                fields.push(Json::String(module.id)) fields.push(encode_names(module.imports)?)
                fields.push(encode_metadata_contract_ast(module.declarations))
                let mut safety = Vec[str]::new()
                for effect in module.safety {
                    let mut entry = Vec[Json]::new()
                    entry.push(Json::String(effect.module_name)) entry.push(Json::String(effect.owner))
                    entry.push(Json::String(effect.name)) entry.push(Json::Bool(effect.is_unsafe()))
                    entry.push(Json::Bool(effect.returns_unsafe_callable))
                    let identity = stringify(Json::Array(entry))
                    // Trait and inherent implementations can expose the same
                    // caller-visible effect (for example Range::next). Their
                    // declarations are distinct AST contracts; identical
                    // effect facts are a set, not duplicate package identities.
                    let mut present = false
                    for known in safety {
                        if known == identity {
                            present = true
                        }
                    }
                    if !present {
                        safety.push(identity)
                    }
                }
                fields.push(encode_names(safety)?)
                contract.push(Json::Array(fields))
            }
        }
        ret Result[str, str]::Ok(metadata_digest("interface", Json::Array(contract)))
    }

    /// Supplies the worker loader with already validated declarations. The
    /// source text, tokens and parser bodies are not part of this transfer.
    pub fn compiled_modules(self: Self) -> Result[Vec[CompiledWorkspaceModule], str] {
        let digest = self.interface_digest()?
        let mut out = Vec[CompiledWorkspaceModule]::new()
        for module in self.modules {
            out.push(CompiledWorkspaceModule {
                    self.context.unit, module.source, digest,
                    module.document(), module.safety, module.imports
                }
                ,)
        }
        ret Result[Vec[CompiledWorkspaceModule], str]::Ok(out)
    }

    /// Serializes declarations only. EHIR templates have a separate digest and
    /// an independent readiness marker; an archive need not exist yet.
    pub fn encode(self: Self) -> Result[str, str] {
        validate_context(self.context)?
        if !digest_valid(self.template_digest) {
            ret Result[str, str]::Err("invalid EHIR template digest")
        }
        let mut fields = Vec[(str, Json)]::new()
        fields.push(("schema", Json::Number("2")))
        fields.push(("abi", Json::String("encore-refrain-1")))
        fields.push(("context", encode_context(self.context)?))
        fields.push(("dependencies", encode_dependencies(self.dependencies)?))
        fields.push(("modules", encode_modules(self.context.unit, self.modules)?))
        fields.push(("templates", Json::String(self.template_digest)))
        ret Result[str, str]::Ok(stringify(Json::Object(fields)))
    }

    /// Rejects stale compilers, targets, profiles and input/dependency identities
    /// before any declarations can enter the consumer's analysis database.
    pub fn decode(text: str, expected: MetadataContext,
        dependencies: Vec[MetadataDependency],) -> Result[Self, str] {
        let data = match parse(text) {
            Ok(value) => value
            Err(error) => {
                ret Result[Self, str]::Err("invalid refrain metadata JSON")
            }
        }
        if data.get("schema").unwrap_or(Json::Null).as_number().unwrap_or("") != "2"
        || required_string(data, "abi")? != "encore-refrain-1" {
            ret Result[Self, str]::Err("unsupported refrain metadata schema or ABI")
        }
        let context = decode_context(data.get("context").unwrap_or(Json::Null))?
        if stringify(encode_context(context)?) != stringify(encode_context(expected)?) {
            ret Result[Self, str]::Err("refrain metadata compiler/target/input context mismatch")
        }
        let restored_dependencies = decode_dependencies(data.get("dependencies").unwrap_or(Json::Null))?
        if stringify(encode_dependencies(restored_dependencies)?) != stringify(encode_dependencies(dependencies)?) {
            ret Result[Self, str]::Err("refrain metadata dependency mismatch")
        }
        let templates = required_string(data, "templates")?
        if !digest_valid(templates) {
            ret Result[Self, str]::Err("invalid EHIR template digest")
        }
        let modules = decode_modules(context.unit, data.get("modules").unwrap_or(Json::Null))?
        ret Result[Self, str]::Ok(Self { context, restored_dependencies, modules, templates })
    }
}

fn required_string(data: Json, key: str) -> Result[str, str] {
    match data.get(key).unwrap_or(Json::Null) {
        Json::String(value) => {
            ret Result[str, str]::Ok(value)
        }
        _ => {
            ret Result[str, str]::Err("missing/invalid metadata string: " + key)
        }
    }
    ret Result[str, str]::Err("missing metadata string")
}

fn required_list(data: Json) -> Result[Vec[Json], str] {
    ret match data {
        Json::Array(values) => Result[Vec[Json], str]::Ok(values)
        _ => Result[Vec[Json], str]::Err("metadata field must be an array")
    }
}

fn string_list(data: Json) -> Result[Vec[str], str] {
    let values = required_list(data)?
    let mut out = Vec[str]::new()
    for value in values {
        match value {
            Json::String(text) => {
                out.push(text)
            }
            _ => {
                ret Result[Vec[str], str]::Err("metadata list must contain strings")
            }
        }
    }
    ret Result[Vec[str], str]::Ok(out)
}

/// Canonical UTF-8 byte ordering for artifact identities, independent of locale
/// and bootstrap compiler support for language-level string ordering.
pub fn metadata_name_before(left: str, right: str) -> bool {
    let mut index = 0_usize
    while index < left.byte_len() && index < right.byte_len() {
        if left.byte_at(index) != right.byte_at(index) {
            ret left.byte_at(index) < right.byte_at(index)
        }
        index += 1
    }
    ret left.byte_len() < right.byte_len()
}

fn sorted_names(values: Vec[str]) -> Result[Vec[str], str] {
    let mut out = Vec[str]::new()
    for value in values {
        if value == "" {
            ret Result[Vec[str], str]::Err("empty metadata identity")
        }
        for present in out {
            if present == value {
                ret Result[Vec[str], str]::Err("duplicate metadata identity: " + value)
            }
        }
        out.push(value)
        let mut index = out.len() - 1
        while index > 0 {
            let left = out.get(index - 1).unwrap_or("")
            let right = out.get(index).unwrap_or("")
            if !metadata_name_before(right, left) {
                break
            }
            out.set(index - 1, right) out.set(index, left) index -= 1
        }
    }
    ret Result[Vec[str], str]::Ok(out)
}

fn encode_names(values: Vec[str]) -> Result[Json, str] {
    let mut out = Vec[Json]::new()
    for value in sorted_names(values)? {
        out.push(Json::String(value))
    }
    ret Result[Json, str]::Ok(Json::Array(out))
}

fn digest_valid(value: str) -> bool {
    if value.byte_len() != 64 {
        ret false
    }
    let mut index = 0_usize
    while index < value.byte_len() {
        let byte = value.byte_at(index)
        if !(byte >= 48 && byte <= 57) && !(byte >= 97 && byte <= 102) {
            ret false
        }
        index += 1
    }
    ret true
}

fn validate_context(value: MetadataContext) -> Result[bool, str] {
    if value.unit == "" || value.target == "" || value.profile == "" || !digest_valid(value.compiler_digest)
    || !digest_valid(value.input_digest) {
        ret Result[bool, str]::Err("invalid refrain metadata context")
    }
    let _features = sorted_names(value.features)?
    ret Result[bool, str]::Ok(true)
}

fn encode_context(value: MetadataContext) -> Result[Json, str] {
    validate_context(value)?
    let mut fields = Vec[(str, Json)]::new()
    fields.push(("unit", Json::String(value.unit)))
    fields.push(("compiler", Json::String(value.compiler_digest)))
    fields.push(("target", Json::String(value.target)))
    fields.push(("profile", Json::String(value.profile)))
    fields.push(("input", Json::String(value.input_digest)))
    fields.push(("features", encode_names(value.features)?))
    ret Result[Json, str]::Ok(Json::Object(fields))
}

fn decode_context(data: Json) -> Result[MetadataContext, str] {
    let context = MetadataContext {
        required_string(data, "unit")?, required_string(data, "compiler")?,
        required_string(data, "target")?, required_string(data, "profile")?, required_string(data, "input")?,
        string_list(data.get("features").unwrap_or(Json::Null))?
    }
    validate_context(context)?
    ret Result[MetadataContext, str]::Ok(context)
}

fn encode_dependencies(values: Vec[MetadataDependency]) -> Result[Json, str] {
    let mut names = Vec[str]::new()
    for value in values {
        names.push(value.unit)
    }
    let mut out = Vec[Json]::new()
    for name in sorted_names(names)? {
        for value in values {
            if value.unit != name {
                continue
            }
            if !digest_valid(value.interface_digest) || !digest_valid(value.template_digest) {
                ret Result[Json, str]::Err("invalid dependency metadata digest: " + name)
            }
            let mut fields = Vec[(str, Json)]::new()
            fields.push(("unit", Json::String(name)))
            fields.push(("interface", Json::String(value.interface_digest)))
            fields.push(("templates", Json::String(value.template_digest)))
            out.push(Json::Object(fields))
        }
    }
    ret Result[Json, str]::Ok(Json::Array(out))
}

fn decode_dependencies(data: Json) -> Result[Vec[MetadataDependency], str] {
    let mut out = Vec[MetadataDependency]::new()
    for value in required_list(data)? {
        out.push(MetadataDependency {
                required_string(value, "unit")?, required_string(value, "interface")?,
                required_string(value, "templates")?
            }
            ,)
    }
    let _validated = encode_dependencies(out)?
    ret Result[Vec[MetadataDependency], str]::Ok(out)
}

fn module_identity_valid(unit: str, id: str, source: str) -> bool {
    if source == "" || id != unit + "@" + source {
        ret false
    }
    if source.byte_at(0) == 47 || source.byte_at(0) == 92 {
        ret false
    }
    let mut component = ""
    let mut index = 0_usize
    while index <= source.byte_len() {
        if index == source.byte_len() || source.byte_at(index) == 47 {
            if component == "" || component == "." || component == ".." {
                ret false
            }
            component = ""
        } else {
            let byte = source.byte_at(index)
            if byte == 0 || byte == 58 || byte == 92 {
                ret false
            }
            component += source.slice_bytes(index, 1)
        }
        index += 1
    }
    ret true
}

fn encode_modules(unit: str, values: Vec[MetadataModule]) -> Result[Json, str] {
    let mut names = Vec[str]::new()
    for value in values {
        names.push(value.id)
    }
    let mut out = Vec[Json]::new()
    for name in sorted_names(names)? {
        for value in values {
            if value.id != name {
                continue
            }
            if !module_identity_valid(unit, value.id, value.source) {
                ret Result[Json, str]::Err("invalid metadata module identity")
            }
            let mut fields = Vec[(str, Json)]::new()
            fields.push(("id", Json::String(value.id)))
            fields.push(("source", Json::String(value.source)))
            fields.push(("imports", encode_names(value.imports)?))
            fields.push(("declarations", encode_metadata_ast_for_module(metadata_interface_ast(value.declarations), value.id)))
            fields.push(("documentation", encode_metadata_documentation(value.documentation)))
            fields.push(("safety", encode_safety(value.safety)))
            fields.push(("symbols", encode_symbols(value.symbols)))
            fields.push(("callables", encode_callables(value.callables)))
            fields.push(("edges", encode_edges(value.edges)))
            out.push(Json::Object(fields))
        }
    }
    ret Result[Json, str]::Ok(Json::Array(out))
}

fn decode_modules(unit: str, data: Json) -> Result[Vec[MetadataModule], str] {
    let mut out = Vec[MetadataModule]::new()
    for value in required_list(data)? {
        let id = required_string(value, "id")?
        let source = required_string(value, "source")?
        if !module_identity_valid(unit, id, source) {
            ret Result[Vec[MetadataModule], str]::Err("invalid metadata module identity")
        }
        let declarations = decode_metadata_ast(value.get("declarations").unwrap_or(Json::Null))?
        // Metadata must not smuggle ordinary bodies back across the boundary.
        if stringify(encode_metadata_ast(declarations)) !=
        stringify(encode_metadata_ast(metadata_interface_ast(declarations))) {
            ret Result[Vec[MetadataModule], str]::Err("ordinary runtime body in declaration metadata")
        }
        out.push(MetadataModule {
                id, source, string_list(value.get("imports").unwrap_or(Json::Null))?, declarations,
                decode_metadata_documentation(value.get("documentation").unwrap_or(Json::Null))?,
                decode_safety(value.get("safety").unwrap_or(Json::Null))?,
                decode_symbols(value.get("symbols").unwrap_or(Json::Null))?,
                decode_callables(value.get("callables").unwrap_or(Json::Null))?,
                decode_edges(value.get("edges").unwrap_or(Json::Null))?
            }
            ,)
    }
    let _validated = encode_modules(unit, out)?
    ret Result[Vec[MetadataModule], str]::Ok(out)
}

fn encode_safety(values: Vec[FunctionSafety]) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        let mut fields = Vec[Json]::new()
        fields.push(Json::String(value.module_name)) fields.push(Json::String(value.owner))
        fields.push(Json::String(value.name)) fields.push(Json::Number(Debug::fmt(value.line)))
        fields.push(Json::Number(Debug::fmt(value.column))) fields.push(Json::Bool(value.body_unsafe))
        fields.push(Json::Bool(value.asserted_safe)) fields.push(Json::Bool(value.returns_unsafe_callable))
        out.push(Json::Array(fields))
    }
    ret Json::Array(out)
}

fn safety_bool(value: Json) -> Result[bool, str] {
    ret match value {
        Json::Bool(enabled) => Result[bool, str]::Ok(enabled)
        _ => Result[bool, str]::Err("invalid metadata safety flag")
    }
}

fn safety_string(value: Json) -> Result[str, str] {
    ret match value {
        Json::String(text) => Result[str, str]::Ok(text)
        _ => Result[str, str]::Err("invalid metadata safety identity")
    }
}

fn decode_safety(data: Json) -> Result[Vec[FunctionSafety], str] {
    let mut out = Vec[FunctionSafety]::new()
    for value in required_list(data)? {
        let fields = required_list(value)?
        if fields.len() != 8 {
            ret Result[Vec[FunctionSafety], str]::Err("invalid metadata safety record")
        }
        out.push(FunctionSafety {
                safety_string(fields.get(0).unwrap_or(Json::Null))?,
                safety_string(fields.get(1).unwrap_or(Json::Null))?, safety_string(fields.get(2).unwrap_or(Json::Null))?,
                decode_metadata_position(fields.get(3).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(4).unwrap_or(Json::Null))?,
                safety_bool(fields.get(5).unwrap_or(Json::Null))?, safety_bool(fields.get(6).unwrap_or(Json::Null))?,
                safety_bool(fields.get(7).unwrap_or(Json::Null))?
            }
            ,)
    }
    ret Result[Vec[FunctionSafety], str]::Ok(out)
}

fn encode_symbols(values: Vec[FrontendSymbol]) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        let mut fields = Vec[Json]::new()
        fields.push(Json::String(value.name)) fields.push(Json::String(value.scope))
        fields.push(Json::Number(Debug::fmt(value.kind))) fields.push(Json::Number(Debug::fmt(value.line)))
        fields.push(Json::Number(Debug::fmt(value.column))) fields.push(Json::Number(Debug::fmt(value.length)))
        fields.push(encode_metadata_documentation(value.documentation)) out.push(Json::Array(fields))
    }
    ret Json::Array(out)
}

fn decode_symbols(data: Json) -> Result[Vec[FrontendSymbol], str] {
    let mut out = Vec[FrontendSymbol]::new()
    for value in required_list(data)? {
        let fields = required_list(value)?
        if fields.len() != 7 {
            ret Result[Vec[FrontendSymbol], str]::Err("invalid metadata symbol record")
        }
        out.push(FrontendSymbol {
                safety_string(fields.get(0).unwrap_or(Json::Null))?, safety_string(fields.get(1).unwrap_or(Json::Null))?,
                decode_metadata_position(fields.get(2).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(3).unwrap_or(Json::Null))?,
                decode_metadata_position(fields.get(4).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(5).unwrap_or(Json::Null))?,
                decode_metadata_documentation(fields.get(6).unwrap_or(Json::Null))?
            }
            ,)
    }
    ret Result[Vec[FrontendSymbol], str]::Ok(out)
}

fn encode_optional_string(value: Option[str]) -> Json {
    ret match value {
        Some(text) => Json::String(text) None => Json::Null
    }
}

fn decode_optional_string(data: Json) -> Result[Option[str], str] {
    if data.is_null() {
        ret Result[Option[str], str]::Ok(Option[str]::None)
    }
    ret Result[Option[str], str]::Ok(Option[str]::Some(safety_string(data)?))
}

fn encode_callables(values: Vec[FrontendCallable]) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        let mut fields = Vec[Json]::new()
        let mut params = Vec[Json]::new()
        for param in value.params {
            params.push(Json::String(param))
        }
        fields.push(Json::String(value.name)) fields.push(Json::Array(params)) fields.push(encode_optional_string(value.ret_type))
        fields.push(Json::Number(Debug::fmt(value.line))) fields.push(Json::Number(Debug::fmt(value.column)))
        fields.push(Json::Number(Debug::fmt(value.length))) out.push(Json::Array(fields))
    }
    ret Json::Array(out)
}

fn decode_callables(data: Json) -> Result[Vec[FrontendCallable], str] {
    let mut out = Vec[FrontendCallable]::new()
    for value in required_list(data)? {
        let fields = required_list(value)?
        if fields.len() != 6 {
            ret Result[Vec[FrontendCallable], str]::Err("invalid metadata callable record")
        }
        out.push(FrontendCallable {
                safety_string(fields.get(0).unwrap_or(Json::Null))?, string_list(fields.get(1).unwrap_or(Json::Null))?,
                decode_optional_string(fields.get(2).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(3).unwrap_or(Json::Null))?,
                decode_metadata_position(fields.get(4).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(5).unwrap_or(Json::Null))?
            }
            ,)
    }
    ret Result[Vec[FrontendCallable], str]::Ok(out)
}

fn encode_edges(values: Vec[DependencyEdge]) -> Json {
    let mut out = Vec[Json]::new()
    for value in values {
        let mut fields = Vec[Json]::new()
        fields.push(Json::String(value.source)) fields.push(Json::String(value.target)) fields.push(Json::Bool(value.is_public))
        fields.push(Json::Number(Debug::fmt(value.line))) fields.push(Json::Number(Debug::fmt(value.column)))
        fields.push(Json::Number(Debug::fmt(value.length))) out.push(Json::Array(fields))
    }
    ret Json::Array(out)
}

fn decode_edges(data: Json) -> Result[Vec[DependencyEdge], str] {
    let mut out = Vec[DependencyEdge]::new()
    for value in required_list(data)? {
        let fields = required_list(value)?
        if fields.len() != 6 {
            ret Result[Vec[DependencyEdge], str]::Err("invalid metadata import record")
        }
        out.push(DependencyEdge {
                safety_string(fields.get(0).unwrap_or(Json::Null))?, safety_string(fields.get(1).unwrap_or(Json::Null))?,
                safety_bool(fields.get(2).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(3).unwrap_or(Json::Null))?,
                decode_metadata_position(fields.get(4).unwrap_or(Json::Null))?, decode_metadata_position(fields.get(5).unwrap_or(Json::Null))?
            }
            ,)
    }
    ret Result[Vec[DependencyEdge], str]::Ok(out)
}

