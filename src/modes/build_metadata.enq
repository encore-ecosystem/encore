            module.document(), module.safety,)
    }
    consumer.set_module_full("sample", "/absent/dependency/src/lib.enq", "pub fn trusted() -> u32 { unsafe { ret 2 } }")
    for symbol in consumer.all_symbols() {
        if symbol.module_name == "sample" && symbol.symbol.name == "trusted" {
            ret consumer.function_is_unsafe(symbol.id) && consumer.module_parse_count("sample") == 1
        }
    }
    ret false
}

fn contract_fixture(source: str) -> RefrainMetadata {
    let mut producer = AnalysisDatabase::new()
    producer.set_module_full("sample", "/producer/src/lib.enq", source)
    let document = producer.document("sample").unwrap_or(FrontendDocument::empty())
    let mut modules = Vec[MetadataModule]::new()
    modules.push(MetadataModule::from_document("sample@lib.enq", "lib.enq", document,
            Vec[str]::new(), producer.function_safety_effects(),))
    let c = fixture_context()
    ret RefrainMetadata {
        MetadataContext {
            c.unit, c.compiler_digest, c.target, c.profile,
            compiler_content_digest(source), c.features
        }
        , Vec[MetadataDependency]::new(), modules,
        compiler_content_digest("templates")
    }
}

