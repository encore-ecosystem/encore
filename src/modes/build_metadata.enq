fn replace_field(data: Json, name: str, value: Json) -> Json {
    let mut fields = Vec[(str, Json)]::new()
    for field in data.as_object().unwrap_or(Vec[(str, Json)]::new()) {
        fields.push((field.0, if field.0 == name {
                    value
                } else {
                    field.1
                }
                ,
            ))
    }
    ret Json::Object(fields)
}

#attr(test)
fn metadata_envelope_body_smuggling_rejected_contract() -> bool {
    let original = fixture_metadata()
    let data = parse(original.encode().unwrap_or("")).unwrap_or(Json::Null)
    let modules = data.get("modules").unwrap_or(Json::Null).as_array().unwrap_or(Vec[Json]::new())
    let mut changed = Vec[Json]::new()
    for module in original.modules {
        changed.push(replace_field(modules.get(0).unwrap_or(Json::Null), "declarations", encode_metadata_ast(module.declarations)))
    }
    let invalid = replace_field(data, "modules", Json::Array(changed))
    ret RefrainMetadata::decode(stringify(invalid), original.context, original.dependencies).is_err()
}

fn analysis_fixture_metadata() -> RefrainMetadata {
    let mut producer = AnalysisDatabase::new()
    producer.set_module_full("sample", "/producer/src/lib.enq",
        "//! Dependency documentation\npub struct Item { value: u32 }\n" +
        "pub fn dangerous() -> u32 { unsafe { ret 1 } }\n" +
        "#attr(safe)\npub fn trusted() -> u32 { unsafe { ret 2 } }\n",)
    let document = producer.document("sample").unwrap_or(FrontendDocument::empty())
    let mut modules = Vec[MetadataModule]::new()
    modules.push(MetadataModule::from_document("sample@lib.enq", "lib.enq", document,
            Vec[str]::new(), producer.function_safety_effects(),))
    ret RefrainMetadata {
        fixture_context(), Vec[MetadataDependency]::new(), modules, compiler_content_digest("templates")
    }
}

#attr(test)
fn metadata_analysis_without_source_or_parse_contract() -> bool {
    let original = analysis_fixture_metadata()
    let restored = match RefrainMetadata::decode(original.encode().unwrap_or(""), original.context, original.dependencies) {
        Ok(value) => value Err(error) => {
            ret false
        }
    }
    let mut consumer = AnalysisDatabase::new()
    for module in restored.modules {
        consumer.install_metadata_module("sample", "/absent/dependency/src/lib.enq", original.context.input_digest,
            module.document(), module.safety,)
    }
    consumer.set_module_full("consumer", "/consumer/src/lib.enq",
        "import sample::{Item, trusted}\nfn value() -> u32 { ret trusted() }\n",)
    if consumer.module_semantic_diagnostics("consumer").len() != 0 {
        ret false
    }
    let mut checked = 0_usize
    for symbol in consumer.all_symbols() {
        if symbol.module_name != "sample" {
            continue
        }
        if symbol.symbol.name == "trusted" {
            if consumer.function_is_unsafe(symbol.id) {
                ret false
            }
            checked += 1
        }
        if symbol.symbol.name == "dangerous" {
            if !consumer.function_is_unsafe(symbol.id) {
                ret false
            }
            checked += 1
        }
    }
    ret checked == 2 && consumer.module_parse_count("sample") == 0
    && consumer.module_lightweight_count("sample") == 0
    && consumer.document("sample").unwrap_or(FrontendDocument::empty()).tokens.len() == 0
}

