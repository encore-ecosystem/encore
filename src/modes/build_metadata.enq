    let mut wrong = Vec[MetadataContext]::new()
    wrong.push(MetadataContext {
            "other", c.compiler_digest, c.target, c.profile, c.input_digest, c.features
        }
        ,
    )
    wrong.push(MetadataContext {
            c.unit, compiler_content_digest("other compiler"), c.target, c.profile, c.input_digest, c.features
        }
        ,
    )
    wrong.push(MetadataContext {
            c.unit, c.compiler_digest, "aarch64-apple-darwin", c.profile, c.input_digest, c.features
        }
        ,
    )
    wrong.push(MetadataContext {
            c.unit, c.compiler_digest, c.target, "extreme", c.input_digest, c.features
        }
        ,
    )
    wrong.push(MetadataContext {
            c.unit, c.compiler_digest, c.target, c.profile, compiler_content_digest("other source"), c.features
        }
        ,
    )
    let mut features = Vec[str]::new() features.push("new-feature")
    wrong.push(MetadataContext {
            c.unit, c.compiler_digest, c.target, c.profile, c.input_digest, features
        }
        ,
    )
    for context in wrong {
        if RefrainMetadata::decode(text, context, original.dependencies).is_ok() {
            ret false
        }
    }
    ret text != ""
}

