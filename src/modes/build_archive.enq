extern fn encore_compiler_write_atomic(path: str, contents: str) -> bool
extern fn encore_compiler_worker_spawn_parts(program: str, arguments: usize, count: usize,
    directory: str, stdout_path: str, stderr_path: str,) -> usize
extern fn encore_compiler_worker_poll(child: usize) -> i32
extern fn encore_compiler_worker_cancel(child: usize) -> i32
extern fn encore_compiler_worker_close(child: usize) ->()
extern fn encore_compiler_worker_interrupted() -> i32
extern fn encore_compiler_worker_watch_parent(parent: u64) -> bool
