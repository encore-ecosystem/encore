extern fn encore_compiler_jobserver_try_acquire(server: usize) -> i32
extern fn encore_compiler_jobserver_release(server: usize) -> bool

struct NativeObjectTask {
    name: str
    object: Path
    arguments: Vec[str]
    child: usize
    extra_lease: bool
    complete: bool
}

/// Fully resolved executable paths and exact flags, selected by the coordinator.
/// The caller owns one CPU lease throughout LLVM/native work. Additional tools
/// borrow available leases nonblockingly and cannot deadlock a jobs=1 build.
pub struct UnitNativePlan {
    compiler: str
    archiver: str
    args: Vec[str]
}

/// The package already owns one lease. Extra CPU leases are borrowed without
/// waiting and returned only after all phase threads have joined.
pub fn borrow_package_jobs(server: usize, count: usize) -> Result[usize, str] {
    let mut jobs = 1_usize
    if server == 0_usize {
        ret Result::Ok(jobs)
    }
    while jobs < count {
        let admitted = unsafe {
            encore_compiler_jobserver_try_acquire(server)
        }
        if admitted < 0_i32 {
            return_package_jobs(server, jobs)
            ret Result::Err("package phase cancelled")
        }
        if admitted == 0_i32 {
            break
        }
        jobs += 1_usize
    }
    ret Result::Ok(jobs)
}

pub fn return_package_jobs(server: usize, jobs: usize) ->() {
    for _job in 1_usize..jobs {
        let _released = unsafe {
            encore_compiler_jobserver_release(server)
        }
    }
}

impl for UnitNativePlan {
    pub fn encode(self: Self) -> Result[str, str] {
        let mut flags = Vec[Json]::new()
        for argument in self.args {
            flags.push(Json::String(argument))
        }
        let mut fields = Vec[(str, Json)]::new()
        fields.push(("schema", Json::Number("1")))
        fields.push(("compiler", Json::String(self.compiler)))
        fields.push(("archiver", Json::String(self.archiver)))
        fields.push(("args", Json::Array(flags)))
        fields.push(("identity", Json::String(self.identity()?)))
        ret Result[str, str]::Ok(stringify(Json::Object(fields)))
    }

    pub fn decode(text: str) -> Result[Self, str] {
        let data = match parse(text) {
            Ok(value) => value
            Err(_) => {
                ret Result[Self, str]::Err("invalid package native plan JSON")
            }
        }
        if data.get("schema").unwrap_or(Json::Null).as_number().unwrap_or("") != "1" {
            ret Result[Self, str]::Err("unsupported package native plan schema")
        }
        let mut args = Vec[str]::new()
        let values = match data.get("args").unwrap_or(Json::Null) {
            Json::Array(values) => values
            _ => {
                ret Result[Self, str]::Err("invalid package native flags")
            }
        }
        for value in values {
            match value {
                Json::String(argument) => {
                    args.push(argument)
                }
                _ => {
                    ret Result[Self, str]::Err("invalid package native flag")
                }
            }
        }
        let plan = Self {
            native_string(data, "compiler")?, native_string(data, "archiver")?, args
        }
        if plan.identity()? != native_string(data, "identity")? {
            ret Result[Self, str]::Err("package native toolchain identity mismatch")
        }
        ret Result[Self, str]::Ok(plan)
    }
    /// Native artifacts follow executable contents and flags, not tool names.
    pub fn identity(self: Self) -> Result[str, str] {
        let compiler = Path::new(self.compiler)
        let archiver = Path::new(self.archiver)
        if !compiler.is_absolute() || !archiver.is_absolute() ||
        !file_exists(self.compiler) || !file_exists(self.archiver) {
            ret Result[str, str]::Err("package native tools must be resolved absolute executables")
        }
        let compiler_digest = compiler_file_digest(self.compiler)
        let archiver_digest = compiler_file_digest(self.archiver)
        if compiler_digest.byte_len() != 64 || archiver_digest.byte_len() != 64 {
            ret Result[str, str]::Err("cannot hash package native toolchain")
        }
        let mut flags = Vec[Json]::new()
        for argument in self.args {
            flags.push(Json::String(argument))
        }
        let mut fields = Vec[(str, Json)]::new()
        fields.push(("schema", Json::String("encore-unit-native-1")))
        fields.push(("compiler", Json::String(compiler_digest)))
        fields.push(("archiver", Json::String(archiver_digest)))
        fields.push(("flags", Json::Array(flags)))
        ret Result[str, str]::Ok(compiler_content_digest(stringify(Json::Object(fields))))
    }
}

fn native_string(data: Json, key: str) -> Result[str, str] {
    ret match data.get(key).unwrap_or(Json::Null) {
        Json::String(value) => Result[str, str]::Ok(value)
        _ => Result[str, str]::Err("missing native plan field: " + key)
    }
}

/// Owns a private staging directory. Its completion marker is published by
/// the caller only after this returns. No generic/ownership support is emitted.
pub fn emit_package_archive(unit: frozen PreparedUnitCodegen, directory: Path,
    target: TargetSpec, plan: UnitNativePlan,) -> Result[str, str] {
    ret emit_budgeted_package_archive(unit, directory, target, plan, 0, Option[Path]::None)
}

/// Native tools can borrow unused leases from this package's shared jobserver.
/// The worker's existing lease covers one tool; extra leases are nonblocking.
/// Process supervision remains on one thread, so handles are never raced.
pub fn emit_budgeted_package_archive(unit: frozen PreparedUnitCodegen, directory: Path,
    target: TargetSpec, plan: UnitNativePlan, server: usize, cache: Option[Path],) -> Result[str, str] {
    ret emit_profile_package_archive(unit, directory, target, plan, server, cache, "release")
}

pub fn emit_profile_package_archive(unit: frozen PreparedUnitCodegen, directory: Path,
    target: TargetSpec, plan: UnitNativePlan, server: usize, cache: Option[Path], profile: str,) -> Result[str, str] {
    ret emit_profile_package_archive_with_sources(unit, directory, target, plan, server, cache, profile, Vec[(str, str)]::new())
}

/// Accepted normalized module identities guard unchanged CGU body hashes.
/// ABI/layout/requirements/native flags remain in the complete object context.
pub fn emit_profile_package_archive_with_sources(unit: frozen PreparedUnitCodegen, directory: Path,
    target: TargetSpec, plan: UnitNativePlan, server: usize, cache: Option[Path], profile: str,
    sources: Vec[(str, str)],) -> Result[str, str] {
    if profile == "dev" {
        let functions = function_codegen_units(unit)
        ret emit_layout_package_archive(functions, directory, target, plan, server, cache, true, sources)
    }
    ret emit_layout_package_archive(unit, directory, target, plan, server, cache, false, Vec[(str, str)]::new())
}

fn emit_layout_package_archive(unit: frozen PreparedUnitCodegen, directory: Path,
    target: TargetSpec, plan: UnitNativePlan, server: usize, cache: Option[Path], compact: bool, sources: Vec[(str, str)],) -> Result[str, str] {
    let probe_started = perf_counter_ms()
    let identity = plan.identity()?
    let compiler = file_sha256(executable_path())
    let requirements = UnitRequirements {
        MetadataContext {
            "codegen", compiler, target.triple, "dev", compiler_content_digest(""), Vec[str]::new()
        }
        ,
        unit_codegen_requirements(unit)
    }
    .encode()?
    let context = compiler_content_digest("encore-prepared-codegen-2\n" + Debug::fmt(compact) + "\n" + compiler + "\n" + identity + "\n" +
        Debug::fmt(target.pointer_width) + "\n" + requirements + "\n" +
        module_bundle_to_string(if compact {
                unit_codegen_declaration_context(unit)
            } else {
                unit_codegen_input_context(unit)
            }
        ))
    let archive_lock = if compact {
        match cache {
            Some(root) => try_unit_cache_lock(root.join("objects-v1"), compiler_content_digest("encore-native-archive-1\n" + context))?
            None => Option[UnitCacheLock]::None
        }
    } else {
        Option[UnitCacheLock]::None
    }
    let result = emit_archive_members(unit, directory, target, plan, server, cache, compact, identity, context, archive_lock, probe_started, sources)
    match archive_lock {
        Some(lock) => {
            close_unit_cache_lock(lock)
        }
        None => {
        }
    }
    ret result
}

fn emit_archive_members(unit: frozen PreparedUnitCodegen, directory: Path, target: TargetSpec,
    plan: UnitNativePlan, server: usize, cache: Option[Path], compact: bool, identity: str, context: str,
    archive_lock: Option[UnitCacheLock], probe_started: u64, sources: Vec[(str, str)],) -> Result[str, str] {
    if !directory.is_absolute() {
        ret Result[str, str]::Err("relative package archive directory")
    }
    if mkdir_all(directory.as_str()) != 0 {
        ret Result[str, str]::Err("cannot create package archive directory")
    }
    let completion = directory.join("unit.complete")
    if file_exists(completion.as_str()) && remove_file(completion.as_str()) != 0 {
        ret Result[str, str]::Err("cannot invalidate staged archive completion")
    }
    let mut archive_args = Vec[str]::new()
    archive_args.push("rcsD")
    let archive = directory.join("unit.erlib")
    // rcs updates an existing archive; never retain a stale removed member.
    if file_exists(archive.as_str()) && remove_file(archive.as_str()) != 0 {
        ret Result[str, str]::Err("cannot invalidate staged package archive")
    }
    archive_args.push(archive.as_str())
    let mut index = 0_usize
    let mut objects = Vec[NativeObjectTask]::new()
    let packed = archive_lock.is_some()
    let object_cache = match if packed {
        Option[Path]::None
    } else {
        cache
    }
    {
        Some(root) => Option[Path]::Some(root.join("objects-v1")) None => Option[Path]::None
    }
    let mut object_keys = Vec[str]::new()
    let mut compiled_objects = Vec[Path]::new()
    let owned = unit_codegen_owned(unit, "").modules
    let mut owned_names = SemanticKeyIndex::new(owned.len())
    for ordinal in 0_usize..owned.len() {
        let name = owned.get_unchecked_borrowed(ordinal).name
        if owned_names.get(name) != 0_usize {
            ret Result::Err("duplicate native codegen unit: " + name)
        }
        owned_names.set(name, ordinal)
    }
    let previous = match archive_lock {
        Some(lock) => read_native_archive(lock.directory, context)
        None => Option[NativeArchiveSnapshot]::None
    }
    let mut can_patch = false
    let mut previous_members = Vec[(str, str)]::new()
    let mut previous_sources = Vec[str]::new()
    match previous {
        Some(snapshot) => {
            previous_members = snapshot.members
            previous_sources = snapshot.sources
            can_patch = previous_members.len() == owned.len()
            let mut ordinal = 0_usize
            for module in owned {
                let member = native_member_stem(module.name)
                if previous_members.get(ordinal).unwrap_or(("", "")).0 != member {
                    can_patch = false
                }
                ordinal += 1_usize
            }
            if can_patch &&(copy_file(snapshot.archive.as_str(), archive.as_str()) != 0 ||
                file_sha256(archive.as_str()) != snapshot.digest) {
                can_patch = false
            }
        }
        None => {
        }
    }
    if !can_patch && file_exists(archive.as_str()) && remove_file(archive.as_str()) != 0 {
        ret Result::Err("cannot invalidate previous archive layout")
    }
    let mut members = Vec[(str, str)]::new()
    let mut object_stems = Vec[str]::new()
    let mut prepared_keys = Vec[str]::new()
    let mut missing = Vec[usize]::new()
    let mut source_versions = Vec[str]::new()
    let mut source_index = SemanticKeyIndex::new(sources.len())
    for ordinal in 0_usize..sources.len() {
        let source = sources.get_unchecked_borrowed(ordinal)
        if valid_key(source.1) {
            source_index.set(source.0, ordinal)
        }
    }
    let mut hashes_reused = 0_usize
    for module in owned {
        let version = codegen_source_version(module.name, sources, source_index)
        let reuse_hash = can_patch && !version.is_empty() && previous_sources.get(index).unwrap_or("") == version
        let key = if reuse_hash {
            hashes_reused += 1_usize
            previous_members.get_unchecked_borrowed(index).1
        } else {
            prepared_object_key(module_bundle_to_string(make_module_bundle(module.name, vec![module])), context)
        }
        source_versions.push(version)
        prepared_keys.push(key)
        let stem = if compact {
            native_member_stem(module.name)
        } else {
            "module-" + Debug::fmt(index)
        }
        object_stems.push(stem)
        let object = directory /(stem + ".o")
        members.push((stem, key))
        let restored = if packed {
            can_patch && previous_members.get(index).unwrap_or(("", "")).1 == key
        } else {
            match cache {
                Some(root) => restore_prepared_object(root, key, object)? None => false
            }
        }
        if !restored {
            missing.push(index)
        }
        if !can_patch || !restored {
            archive_args.push(object.as_str())
        }
        index += 1_usize
    }
    let mut aliases = Vec[(str, str)]::new()
    let mut emitted_index = 0_usize
    let jobs = borrow_package_jobs(server, missing.len())?
    let emission_started = perf_counter_ms()
    let generated = if compact && !missing.is_empty() {
        let cached = compact_declarations(unit, target, context, archive_lock)
        match cached {
            Ok(declarations) => emit_compact_unit_codegen_with_declarations(unit, target.triple, target.pointer_width, missing, jobs, declarations)
            Err(error) => {
                return_package_jobs(server, jobs)
                ret Result::Err(error)
            }
        }
    } elif compact {
        Vec[ehirlib::codegen::EmittedIrModule]::new()
    } else {
        emit_unit_codegen_selected_parallel(unit, target.triple, target.pointer_width, missing, jobs)
    }
    return_package_jobs(server, jobs)
    let emission_finished = perf_counter_ms()
    for emitted in generated {
        if !emitted.diagnostic.is_empty() {
            ret Result::Err("LLVM: " + emitted.diagnostic)
        }
        let module_index = missing.get(emitted_index).unwrap_or(index)
        emitted_index += 1_usize
        let stem = object_stems.get(module_index).unwrap_or("")
        let ir = directory.join(stem + ".ll")
        let object = directory.join(stem + ".o")
        let stable_ir = stable_module_ir(emitted.ir, emitted.module_id)
        write_ir(ir, stable_ir)?
        let key = native_object_key(stable_ir, target.triple, identity)
        if !packed {
            aliases.push((prepared_keys.get(module_index).unwrap_or(""), key))
        }
        let reused = match object_cache {
            Some(root) => restore_native_object(root, key, object)? None => false
        }
        if reused {
            continue
        }
        object_keys.push(key)
        compiled_objects.push(object)
        let mut arguments = Vec[str]::new()
        for argument in plan.args {
            arguments.push(argument)
        }
        arguments.push("--target=" + target.triple)
        arguments.push("-c")
        arguments.push(ir.as_str())
        arguments.push("-o")
        arguments.push(object.as_str())
        objects.push(NativeObjectTask {
                stem, object, arguments, 0, false, false
            }
            ,
        )
    }
    compile_native_objects(objects, plan.compiler, directory, server)?
    if plan.identity()? != identity {
        ret Result[str, str]::Err("native toolchain changed during object compilation")
    }
    let mut compiled_index = 0_usize
    for object in compiled_objects {
        match object_cache {
            Some(root) => {
                commit_native_object(root, object_keys.get(compiled_index).unwrap_or(""), object)?
            }
            None => {
            }
        }
        compiled_index += 1
    }
    for alias in aliases {
        match cache {
            Some(root) => {
                commit_prepared_object(root, alias.0, alias.1)?
            }
            None => {
            }
        }
    }
    let mut object_counts = Vec[(str, Json)]::new()
    object_counts.push(("reused", Json::Number(Debug::fmt(index - compiled_index))))
    object_counts.push(("compiled", Json::Number(Debug::fmt(compiled_index))))
    object_counts.push(("ir_generated", Json::Number(Debug::fmt(missing.len()))))
    object_counts.push(("ir_skipped", Json::Number(Debug::fmt(index - missing.len()))))
    object_counts.push(("ir_jobs", Json::Number(Debug::fmt(jobs))))
    object_counts.push(("object_hashes_reused", Json::Number(Debug::fmt(hashes_reused))))
    object_counts.push(("object_hashes_computed", Json::Number(Debug::fmt(index - hashes_reused))))
    object_counts.push(("archive_slot", Json::String(if packed {
                    compiler_content_digest("encore-native-archive-1\n" + context)
                } else {
                    ""
                }
            )))
    object_counts.push(("object_probe_ms", Json::Number(Debug::fmt(emission_started - probe_started))))
    object_counts.push(("ir_emit_ms", Json::Number(Debug::fmt(emission_finished - emission_started))))
    if write_file(directory.join("objects.json").as_str(), stringify(Json::Object(object_counts))) != 0 {
        ret Result[str, str]::Err("cannot record native object reuse")
    }
    if !can_patch || !missing.is_empty() {
        run_unit_tool(plan.archiver, archive_command_arguments(archive_args, directory)?, directory, "archive")?
    }
    if !file_exists(archive.as_str()) {
        ret Result[str, str]::Err("archiver did not produce package archive")
    }
    if plan.identity()? != identity {
        ret Result[str, str]::Err("native toolchain changed during package compilation")
    }
    let digest = file_sha256(archive.as_str())
    match archive_lock {
        Some(lock) => {
            publish_native_archive(lock.directory, context, archive, digest, members, source_versions, previous)?
        }
        None => {
        }
    }
    ret Result[str, str]::Ok(digest)
}

struct NativeArchiveSnapshot {
    archive: Path
    digest: str
    members: Vec[(str, str)]
    sources: Vec[str]
}

fn codegen_source_version(name: str, sources: Vec[(str, str)], index: SemanticKeyIndex) -> str {
    let mut cursor = name.byte_len()
    while cursor > 0_usize {
        cursor -= 1_usize
        if name.byte_at(cursor) != 35_u8 {
            continue
        }
        let tail = name.slice_bytes(cursor, name.byte_len() - cursor)
        if (tail.byte_len() >= 10_usize && tail.slice_bytes(0_usize, 10_usize) == "#function:") ||
        (tail.byte_len() >= 8_usize && tail.slice_bytes(0_usize, 8_usize) == "#method:") {
            let ordinal = index.get(name.slice_bytes(0_usize, cursor))
            if ordinal != 0_usize {
                ret sources.get_unchecked_borrowed(ordinal - 1_usize).1
            }
            ret ""
        }
    }
    ret ""
}

#attr(test)
fn metadata_native_cgu_source_identity_preserves_filename_boundaries() -> bool {
    let version = compiler_content_digest("normalized module")
    let source = "package@path#function:part.enq"
    let sources = vec![(source, version)]
    let mut index = SemanticKeyIndex::new(1_usize)
    index.set(source, 0_usize)
    ret codegen_source_version(source + "#function:read", sources, index) == version &&
    codegen_source_version(source + "#method:Owner::read", sources, index) == version &&
    codegen_source_version("package@other.enq#function:read", sources, index).is_empty() &&
    codegen_source_version(source, sources, index).is_empty() &&
    codegen_source_version(source + "#fun", sources, index).is_empty()
}

fn compact_declarations(unit: frozen PreparedUnitCodegen, target: TargetSpec, context: str,
    lock: Option[UnitCacheLock],) -> Result[str, str] {
    let prefix = "encore-llvm-declarations-1\n" + context + "\n"
    match lock {
        Some(lock) => {
            let payload = read_packed_payload(lock.directory.join("llvm-declarations.entry"))
            if payload.byte_len() > prefix.byte_len() && payload.slice_bytes(0_usize, prefix.byte_len()) == prefix {
                ret Result::Ok(payload.slice_bytes(prefix.byte_len(), payload.byte_len() - prefix.byte_len()))
            }
        }
        None => {
        }
    }
    let declarations = compact_unit_codegen_declarations(unit, target.triple, target.pointer_width)?
    match lock {
        Some(lock) => {
            if mkdir_all(lock.directory.as_str()) != 0_i32 ||
            !write_payload(lock.directory.join("llvm-declarations.entry"), prefix + declarations, true) {
                ret Result::Err("cannot publish LLVM declaration snapshot")
            }
        }
        None => {
        }
    }
    ret Result::Ok(declarations)
}

fn native_member_stem(module: str) -> str {
    ret "cgu-" + compiler_content_digest("encore-native-member-1\n" + module)
}

fn read_native_archive(directory: Path, context: str) -> Option[NativeArchiveSnapshot] {
    let payload = read_packed_payload(directory.join("members.entry"))
    if compiler_content_digest(payload) != read_file(directory.join("commit").as_str()) {
        ret Option::None
    }
    let data = parse(payload).unwrap_or(Json::Null)
    let digest = data.get("archive").unwrap_or(Json::Null).as_str().unwrap_or("")
    let schema = data.get("schema").unwrap_or(Json::Null).as_number().unwrap_or("")
    if (schema != "1" && schema != "2") ||
    data.get("context").unwrap_or(Json::Null).as_str().unwrap_or("") != context || !valid_key(digest) {
        ret Option::None
    }
    let archive = directory.join(digest + ".erlib")
    if !file_exists(archive.as_str()) || file_sha256(archive.as_str()) != digest {
        ret Option::None
    }
    let records = match data.get("members").unwrap_or(Json::Null).as_array() {
        Some(value) => value None => {
            ret Option::None
        }
    }
    let mut members = Vec[(str, str)]::new()
    let mut sources = Vec[str]::new()
    for record in records {
        let fields = record.as_array().unwrap_or(Vec[Json]::new())
        let member = fields.get(0_usize).unwrap_or(Json::Null).as_str().unwrap_or("")
        let key = fields.get(1_usize).unwrap_or(Json::Null).as_str().unwrap_or("")
        let source = if schema == "2" {
            fields.get(2_usize).unwrap_or(Json::Null).as_str().unwrap_or("")
        } else {
            ""
        }
        if fields.len() != if schema == "2" {
            3_usize
        } else {
            2_usize
        }
        || member.is_empty() || !valid_key(key) ||
        (!source.is_empty() && !valid_key(source)) {
            ret Option::None
        }
        members.push((member, key))
        sources.push(source)
    }
    ret Option::Some(NativeArchiveSnapshot { archive, digest, members, sources })
}

fn publish_native_archive(directory: Path, context: str, archive: Path, digest: str,
    members: Vec[(str, str)], sources: Vec[str], previous: Option[NativeArchiveSnapshot],) -> Result[(), str] {
    if !valid_key(digest) || mkdir_all(directory.as_str()) != 0 {
        ret Result::Err("invalid native archive snapshot")
    }
    let stored = directory.join(digest + ".erlib")
    if !file_exists(stored.as_str()) || file_sha256(stored.as_str()) != digest {
        if copy_file(archive.as_str(), stored.as_str()) != 0 || file_sha256(stored.as_str()) != digest {
            ret Result::Err("cannot commit native archive snapshot")
        }
    }
    let mut records = Vec[Json]::new()
    for ordinal in 0_usize..members.len() {
        let member = members.get_unchecked_borrowed(ordinal)
        records.push(Json::Array(vec![Json::String(member.0), Json::String(member.1), Json::String(sources.get(ordinal).unwrap_or(""))]))
    }
    let payload = stringify(Json::Object(vec![("schema", Json::Number("2")),("context", Json::String(context)),
                ("archive", Json::String(digest)),("members", Json::Array(records))]))
    if !write_payload(directory.join("members.entry"), payload, true) || !unsafe {
        encore_compiler_write_atomic(directory.join("commit").as_str(), compiler_content_digest(payload))
    }
    {
        ret Result::Err("cannot commit native archive index")
    }
    // Keep one previous distinct revision for ordinary undo. Unit-cache
    // references to still older archives simply miss and rebuild from EHIR.
    let previous_marker = directory.join("previous-archive")
    let keep = match previous {
        Some(value) => if value.digest != digest {
            value.digest
        } else {
            read_file(previous_marker.as_str())
        }
        None => ""
    }
    if !unsafe {
        encore_compiler_write_atomic(previous_marker.as_str(), keep)
    }
    {
        ret Result::Err("cannot commit previous native archive identity")
    }
    for name in read_dir(directory.as_str()) {
        if name.byte_len() == 70_usize && name.slice_bytes(64_usize, 6_usize) == ".erlib" {
            let key = name.slice_bytes(0_usize, 64_usize)
            if valid_key(key) && key != digest && key != keep {
                let _removed = remove_file(directory.join(name).as_str())
            }
        }
    }
    touch_cache(directory) record_cache_usage(directory)
    ret Result::Ok(())
}

/// LLVM/GNU archivers accept response files. Keep large function-CGU archives
/// below host command-line limits, including Windows, without invoking a shell.
fn archive_command_arguments(arguments: Vec[str], directory: Path) -> Result[Vec[str], str] {
    if arguments.len() <= 128_usize {
        ret Result::Ok(arguments)
    }
    let mut text = ""
    for argument in arguments {
        text += "\""
        let mut start = 0_usize
        let mut cursor = 0_usize
        while cursor < argument.byte_len() {
            let byte = argument.byte_at(cursor)
            if byte == 34_u8 || byte == 92_u8 {
                text += argument.slice_bytes(start, cursor - start) + "\\" + argument.slice_bytes(cursor, 1_usize)
                start = cursor + 1_usize
            }
            cursor += 1_usize
        }
        text += argument.slice_bytes(start, argument.byte_len() - start) + "\"\n"
    }
    let path = directory.join("archive.rsp")
    if write_file(path.as_str(), text) != 0 {
        ret Result::Err("cannot write archive response file")
    }
    ret Result::Ok(vec!["@" + path.as_str()])
}

/// ThinLTO hashes the source filename when promoting local symbols. Staging
/// paths must never become part of a package's object or executable identity.
pub fn stable_module_ir(ir: str, module_id: str) -> str {
    let identity = compiler_content_digest("encore-llvm-source-1\n" + module_id)
    ret "source_filename = \"encore-" + identity + ".ll\"\n" + ir
}

#attr(test)
fn metadata_native_llvm_source_identity_contract() -> bool {
    let ir = "target triple = \"x86_64-unknown-linux-gnu\"\n"
    let first = stable_module_ir(ir, "package@lib.enq")
    ret first == stable_module_ir(ir, "package@lib.enq")
    && first != stable_module_ir(ir, "other@lib.enq")
    && first.contains("source_filename = \"encore-")
    && first.contains(ir)
}

#attr(safe)
fn compile_native_objects(tasks: mut Vec[NativeObjectTask], compiler: str, directory: Path, server: usize) -> Result[(), str] {
    let result = drive_native_objects(tasks, compiler, directory, server)
    // Capture Result before cleanup, including cancellation, failed spawn and
    // nonzero tool exits. Release leases only after their child is reaped.
    for task in tasks {
        if task.child != 0 {
            let _cancelled = unsafe {
                encore_compiler_worker_cancel(task.child)
            }
            unsafe {
                encore_compiler_worker_close(task.child)
            }
            if task.extra_lease {
                let _released = unsafe {
                    encore_compiler_jobserver_release(server)
                }
            }
        }
    }
    ret result
}

#attr(safe)
fn drive_native_objects(tasks: mut Vec[NativeObjectTask], compiler: str, directory: Path, server: usize) -> Result[(), str] {
    let running = - 2147483647_i32 - 1_i32
    let mut completed = 0_usize
    let mut base_busy = false
    while completed < tasks.len() {
        if unsafe {
            encore_compiler_worker_interrupted()
        }
        != 0 {
            ret Result[(), str]::Err("native object queue cancelled")
        }
        let mut index = 0_usize
        while index < tasks.len() {
            let task = match tasks.get(index) {
                Some(value) => value None => {
                    ret Result[(), str]::Err("invalid native object state")
                }
            }
            if task.complete || task.child != 0 {
                index += 1 continue
            }
            let extra = base_busy
            if extra {
                if server == 0 {
                    break
                }
                let lease = unsafe {
                    encore_compiler_jobserver_try_acquire(server)
                }
                if lease < 0 {
                    ret Result[(), str]::Err("native object budget cancelled")
                }
                if lease == 0 {
                    break
                }
            }
            let child = unsafe {
                encore_compiler_worker_spawn_parts(compiler, task.arguments.as_ptr() as usize,
                    task.arguments.len(), directory.as_str(), directory.join(task.name + ".stdout").as_str(),
                    directory.join(task.name + ".stderr").as_str(),)
            }
            if child == 0 {
                if extra {
                    let _released = unsafe {
                        encore_compiler_jobserver_release(server)
                    }
                }
                ret Result[(), str]::Err("cannot start native object compiler")
            }
            if !extra {
                base_busy = true
            }
            tasks.set(index, NativeObjectTask {
                    task.name, task.object, task.arguments, child, extra, false
                }
                ,
            )
            index += 1
        }
        index = 0
        while index < tasks.len() {
            let task = match tasks.get(index) {
                Some(value) => value None => {
                    ret Result[(), str]::Err("invalid native object state")
                }
            }
            if task.child == 0 {
                index += 1 continue
            }
            let status = unsafe {
                encore_compiler_worker_poll(task.child)
            }
            if status != running {
                if status != 0 {
                    ret Result[(), str]::Err("native compiler failed: " + read_file(directory.join(task.name + ".stderr").as_str()))
                }
                if !file_exists(task.object.as_str()) {
                    ret Result[(), str]::Err("native compiler produced no object")
                }
                unsafe {
                    encore_compiler_worker_close(task.child)
                }
                if task.extra_lease {
                    let _released = unsafe {
                        encore_compiler_jobserver_release(server)
                    }
                } else {
                    base_busy = false
                }
                tasks.set(index, NativeObjectTask {
                        task.name, task.object, task.arguments, 0, false, true
                    }
                    ,
                )
                completed += 1
            }
            index += 1
        }
        if completed < tasks.len() {
            let _sleep = sleep_ms(5)
        }
    }
    ret Result[(), str]::Ok(())
}

#attr(safe)
fn write_ir(path: Path, ir: str) -> Result[(), str] {
    let written = unsafe {
        encore_compiler_write_atomic(path.as_str(), ir)
    }
    if !written || file_sha256(path.as_str()) != compiler_content_digest(ir) {
        ret Result[(), str]::Err("cannot publish package LLVM output")
    }
    ret Result[(), str]::Ok(())
}

/// Exact argv, isolated logs, cancellation and reaping; never a shell command.
/// This runs on a worker's supervisor thread, not on LLVM emission threads.
#attr(safe)
pub fn run_unit_tool(program: str, arguments: Vec[str], directory: Path, name: str) -> Result[(), str] {
    let child = start_unit_tool(program, arguments, directory, name)?
    ret finish_unit_tool(child, program, directory, name)
}

/// Handles remain exclusively on the supervisor thread. A bounded phase may
/// start several tools before waiting, without racing the process registry.
#attr(safe)
fn start_unit_tool(program: str, arguments: Vec[str], directory: Path, name: str) -> Result[usize, str] {
    let output = directory.join(name + ".stdout")
    let error = directory.join(name + ".stderr")
    let child = unsafe {
        encore_compiler_worker_spawn_parts(program, arguments.as_ptr() as usize,
            arguments.len(), directory.as_str(), output.as_str(), error.as_str(),)
    }
    if child == 0 {
        ret Result[usize, str]::Err("cannot start package tool: " + program)
    }
    ret Result[usize, str]::Ok(child)
}

#attr(safe)
pub fn finish_unit_tool(child: usize, program: str, directory: Path, name: str) -> Result[(), str] {
    let error = directory.join(name + ".stderr")
    let running = - 2147483647_i32 - 1_i32
    let mut status = running
    while status == running {
        if unsafe {
            encore_compiler_worker_interrupted()
        }
        != 0 {
            let _cancelled = unsafe {
                encore_compiler_worker_cancel(child)
            }
            unsafe {
                encore_compiler_worker_close(child)
            }
            ret Result[(), str]::Err("package tool cancelled: " + program)
        }
        status = unsafe {
            encore_compiler_worker_poll(child)
        }
        if status == running {
            let _sleep = sleep_ms(5)
        }
    }
    // close also reaps a child after a polling error; never leak a live handle.
    unsafe {
        encore_compiler_worker_close(child)
    }
    if status != 0 {
        ret Result[(), str]::Err("package tool failed (" + Debug::fmt(status) + "): " + program +
            "\n" + read_file(error.as_str()))
    }
    ret Result[(), str]::Ok(())
}

/// Final-link/header tools run through the same parent-death guard as package
/// workers. Foreign tools cannot install Encore's guard themselves; the small
/// guarded supervisor owns their process group until the tool is reaped.
#attr(safe)
pub fn run_program_tool(program: str, arguments: Vec[str], directory: Path, name: str) -> Result[(), str] {
    let progress = rich::ProgressReporter::current()
    progress.stage(if name == "link" {
            "Linking"
        } else {
            "Preparing " + name
        }
        , 0_usize,)
    let child = start_program_tool(program, arguments, directory, name)?
    ret finish_unit_tool(child, program, directory, name)
}

#attr(safe)
pub fn start_program_tool(program: str, arguments: Vec[str], directory: Path, name: str) -> Result[usize, str] {
    let mut guarded = Vec[str]::new()
    guarded.push("__run-tool")
    guarded.push(Debug::fmt(unsafe {
                encore_compiler_process_id()
            }
        ))
    guarded.push(program)
    for argument in arguments {
        guarded.push(argument)
    }
    ret start_unit_tool(executable_path(), guarded, directory, name)
}

/// Also cancels live descendants. Safe on an already closed/stale handle.
#attr(safe)
pub fn close_program_tool(child: usize) ->() {
    unsafe {
        encore_compiler_worker_close(child)
    }
}

#attr(safe)
pub fn run_tool_worker() -> u32 {
    if process_arg_count() < 4 {
        eprintln("invalid guarded tool arguments") ret 2
    }
    let text = process_arg(2).unwrap_or("")
    let mut parent = 0_u64
    let mut cursor = 0_usize
    while cursor < text.byte_len() {
        let byte = text.byte_at(cursor)
        if byte < 48 || byte > 57 {
            ret 2
        }
        let digit =(byte - 48) as u64
        if parent >(18446744073709551615_u64 - digit) / 10 {
            ret 2
        }
        parent = parent * 10 + digit
        cursor += 1
    }
    if parent == 0 || !unsafe {
        encore_compiler_worker_watch_parent(parent)
    }
    {
        ret 2
    }
    let mut arguments = Vec[str]::new()
    cursor = 4
    while cursor < process_arg_count() {
        arguments.push(process_arg(cursor).unwrap_or("")) cursor += 1
    }
    // Parallel supervisors share a working directory, but must never open
    // each other's logs. Windows excludes concurrent writers; POSIX would
    // silently truncate/interleave them and corrupt failure diagnostics.
    let log_name = "guarded-tool-" + Debug::fmt(unsafe {
            encore_compiler_process_id()
        }
    )
    match run_unit_tool(process_arg(3).unwrap_or(""), arguments, Path::new(".").resolve(), log_name) {
        Ok(_) => {
            ret 0
        }
        Err(error) => {
            eprintln(error) ret 1
        }
    }
}

fn compact_declaration_snapshot_fixture(lock: UnitCacheLock, target: TargetSpec) -> Result[bool, str] {
    let unit = ehirlib::codegen::prepare_unit_codegen(make_module_bundle("empty", Vec[Module]::new()),
        make_module_bundle("", Vec[Module]::new()), target.triple, target.pointer_width, 1_usize,)
    let context = compiler_content_digest("verified declaration generation")
    let first = compact_declarations(unit, target, context, Option[UnitCacheLock]::Some(lock))?
    let path = lock.directory.join("llvm-declarations.entry")
    if first.is_empty() || !file_exists(path.as_str()) {
        ret Result::Ok(false)
    }
    let second = compact_declarations(unit, target, context, Option[UnitCacheLock]::Some(lock))?
    if first != second {
        ret Result::Ok(false)
    }
    write_file(path.as_str(), "corrupt declaration snapshot")
    let repaired = compact_declarations(unit, target, context, Option[UnitCacheLock]::Some(lock))?
    ret Result::Ok(first == repaired && read_packed_payload(path).byte_len() > first.byte_len())
}

#attr(test)
fn compact_declaration_snapshot_creates_parent_and_repairs_corruption() -> bool {
    let root = Path::new("target/declaration-snapshot-" + Debug::fmt(std::time::perf_counter_ns())).resolve()
    let lock = match try_unit_cache_lock(root, compiler_content_digest("snapshot fixture")) {
        Ok(value) => match value {
            Some(lock) => lock None => {
                ret false
            }
        }
        Err(_) => {
            ret false
        }
    }
    // A lock inode does not imply that its artifact directory exists.
    let fresh = !file_exists(lock.directory.as_str())
    let result = compact_declaration_snapshot_fixture(lock, refrain::target::host_target()).unwrap_or(false)
    close_unit_cache_lock(lock)
    let _removed = std::os::remove_dir_all(root.as_str())
    ret fresh && result
}
