import mod::cache_payload::{verified_payload, write_verified_payload}
import mod::cache_policy::{atomic as atomic_record, record_cache_usage, touch_cache}
//! Checked/lowered frontend checkpoints, independent of dependency templates.

import core::result::Result

import std::os::{file_exists, file_sha256, mkdir_all, read_file, remove_file, write_file}
import std::path::Path
import std::vec::Vec

import json::{Json, parse, stringify}

import mod::build_cache::UnitCacheLock
import mod::build_metadata::{MetadataContext, MetadataDependency, RefrainMetadata}
import refrain::cache_identity::compiler_content_digest

extern fn encore_compiler_write_atomic(path: str, contents: str) -> bool

pub struct FrontendCheckpoint {
    metadata: RefrainMetadata
    lowered: str
    metadata_text: str
    receipt_text: str
    metadata_digest: str
    owned_digest: str
}

/// Write the receipt last. Ordinary bodies stay private to the owning worker.
pub fn publish_frontend_unit(directory: Path, key: str, metadata: RefrainMetadata,
    lowered: str,) -> Result[(), str] {
    if mkdir_all(directory.as_str()) != 0 {
        ret Result[(), str]::Err("cannot stage frontend checkpoint")
    }
    let text = metadata.encode()?
    atomic(directory.join("unit.frontend-meta"), text)?
    atomic(directory.join("unit.frontend-owned"), lowered)?
    let mut fields = Vec[(str, Json)]::new()
    fields.push(("schema", Json::Number("1"))) fields.push(("key", Json::String(key)))
    fields.push(("metadata", Json::String(compiler_content_digest(text))))
    fields.push(("owned", Json::String(compiler_content_digest(lowered))))
    atomic(directory.join("unit.frontend"), stringify(Json::Object(fields)))?
    ret Result[(), str]::Ok(())
}

pub fn read_frontend_unit(directory: Path, key: str, context: MetadataContext,
    dependencies: Vec[MetadataDependency],) -> Result[FrontendCheckpoint, str] {
    let receipt_text = read_file((directory / "unit.frontend").as_str())
    let receipt = parse(receipt_text).unwrap_or(Json::Null)
    if receipt.get("schema").unwrap_or(Json::Null).as_number().unwrap_or("") != "1" ||
    receipt.get("key").unwrap_or(Json::Null).as_str().unwrap_or("") != key {
        ret Result[FrontendCheckpoint, str]::Err("frontend checkpoint identity mismatch")
    }
    let metadata_digest = receipt.get("metadata").unwrap_or(Json::Null).as_str().unwrap_or("")
    let owned_digest = receipt.get("owned").unwrap_or(Json::Null).as_str().unwrap_or("")
    let text = payload(directory / "unit.frontend-meta", metadata_digest)?
    let lowered = payload(directory / "unit.frontend-owned", owned_digest)?
    ret Result[FrontendCheckpoint, str]::Ok(FrontendCheckpoint {
            RefrainMetadata::decode_frontend(text, context, dependencies)?, lowered, text, receipt_text, metadata_digest, owned_digest
        }
        ,
    )
}

pub fn restore_frontend_cache(lock: UnitCacheLock, key: str, context: MetadataContext,
    dependencies: Vec[MetadataDependency], destination: Path,) -> Result[bool, str] {
    let checkpoint = match read_frontend_unit(lock.directory, key, context, dependencies) {
        Ok(value) => value Err(_) => {
            ret Result::Ok(false)
        }
    }
    copy_frontend(lock.directory, destination, false, checkpoint)?
    touch_cache(lock.directory)
    ret Result[bool, str]::Ok(true)
}

pub fn commit_frontend_cache(lock: UnitCacheLock, key: str, context: MetadataContext,
    dependencies: Vec[MetadataDependency], source: Path,) -> Result[(), str] {
    let checkpoint = read_frontend_unit(source, key, context, dependencies)?
    copy_frontend(source, lock.directory, true, checkpoint)?
    touch_cache(lock.directory)
    record_cache_usage(lock.directory)
    ret Result[(), str]::Ok(())
}

fn copy_frontend(source: Path, destination: Path, durable: bool, checkpoint: FrontendCheckpoint) -> Result[(), str] {
    if source.as_str() == destination.as_str() || !destination.is_absolute() || mkdir_all(destination.as_str()) != 0 {
        ret Result[(), str]::Err("invalid frontend checkpoint transaction")
    }
    let marker = destination.join("unit.frontend")
    if file_exists(marker.as_str()) && remove_file(marker.as_str()) != 0 {
        ret Result[(), str]::Err("cannot invalidate frontend receipt")
    }
    let mut files = Vec[(str, str, str)]::new()
    files.push(("unit.frontend-meta", checkpoint.metadata_text, checkpoint.metadata_digest))
    files.push(("unit.frontend-owned", checkpoint.lowered, checkpoint.owned_digest))
    files.push(("unit.frontend", checkpoint.receipt_text, compiler_content_digest(checkpoint.receipt_text)))
    for file in files {
        if durable && file.0 != "unit.frontend" {
            if !write_verified_payload(destination / file.0, file.1, file.2, false) {
                ret Result::Err("cannot store frontend checkpoint")
            }
        } else {
            let written = if file.0 == "unit.frontend" {
                atomic_record(destination / file.0, file.1)
            } else {
                write_file((destination / file.0).as_str(), file.1) == 0_i32
            }
            if !written {
                ret Result::Err("cannot write private frontend snapshot")
            }
        }
        let _copied = verified_payload(destination / file.0, file.2)?
    }
    ret Result[(), str]::Ok(())
}

fn payload(path: Path, expected: str) -> Result[str, str] {
    ret verified_payload(path, expected)
}

#attr(safe)
fn atomic(path: Path, contents: str) -> Result[(), str] {
    if !unsafe {
        encore_compiler_write_atomic(path.as_str(), contents)
    }
    || file_sha256(path.as_str()) != compiler_content_digest(contents) {
        ret Result[(), str]::Err("cannot commit frontend checkpoint")
    }
    ret Result[(), str]::Ok(())
}
