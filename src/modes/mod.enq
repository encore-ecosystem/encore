//! Dispatches top-level Encore CLI operating modes.

import mod::build::run_frontend_build
pub import mod::build::run_codegen_worker
import mod::native::{native_add, native_init, native_install, native_run, native_sync}
import mod::test::native_test
import mod::target_info::show_target_info
import mod::analyze::native_analyze
import mod::self_update::{native_self, native_self_update_apply}

/// Runs the native build command.
pub fn run_build() -> u32 {
    ret run_frontend_build()
}

/// Builds and executes the current project.
pub fn run_run() -> u32 {
    ret native_run()
}

/// Builds and executes project tests.
pub fn run_test() -> u32 {
    ret native_test()
}

/// Adds a dependency to the current project.
pub fn run_add() -> u32 {
    ret native_add()
}

/// Resolves dependencies without requesting updates.
pub fn run_sync() -> u32 {
    ret native_sync(false)
}

/// Updates and resolves project dependencies.
pub fn run_update() -> u32 {
    ret native_sync(true)
}

/// Initializes a new Encore project.
pub fn run_init() -> u32 {
    ret native_init()
}

/// Installs the current project's binary.
pub fn run_install() -> u32 {
    ret native_install()
}

/// Displays target and toolchain information.
pub fn run_target() -> u32 { ret show_target_info() }

/// Manages the native compiler installation and release channel.
pub fn run_self() -> u32 { ret native_self() }

/// Completes a deferred Windows installation replacement.
pub fn run_self_update_apply() -> u32 { ret native_self_update_apply() }

/// Analyzes the current project without compiling it.
pub fn run_analyze() -> u32 { ret native_analyze() }

/// Runs the frontend build entrypoint used by bootstrap workflows.
pub fn run_bootstrap_frontend_build() -> u32 {
    ret run_frontend_build()
}
