import std::option::Option


extern fn __ehir_rt_str_eq(lhs: str, rhs: str) -> bool
extern fn __ehir_rt_str_len(value: str) -> usize
extern fn __ehir_rt_str_byte_at(value: str, index: usize) -> u8
extern fn __ehir_rt_str_slice(value: str, start: usize, slice_len: usize) -> str
extern fn __ehir_rt_str_concat(lhs: str, rhs: str) -> str

pub fn str_eq(lhs: str, rhs: str) -> bool {
    unsafe {
        ret __ehir_rt_str_eq(lhs, rhs)
    }
}

pub fn len(value: str) -> usize {
    unsafe {
        ret __ehir_rt_str_len(value)
    }
}

pub fn byte_at(value: str, index: usize) -> u8 {
    unsafe {
        ret __ehir_rt_str_byte_at(value, index)
    }
}

pub fn slice(value: str, start: usize, slice_len: usize) -> str {
    unsafe {
        ret __ehir_rt_str_slice(value, start, slice_len)
    }
}

pub fn concat(lhs: str, rhs: str) -> str {
    unsafe {
        ret __ehir_rt_str_concat(lhs, rhs)
    }
}

pub struct String {
    value: str
}

impl for String {
    pub fn new() -> String {
        ret String{""}
    }

    pub fn from_str(s: str) -> String {
        ret String{s}
    }

    pub fn as_str(self: String) -> str {
        ret self.value
    }

    pub fn len(self: String) -> usize {
        ret len(self.value)
    }

    pub fn is_empty(self: String) -> bool {
        ret self.len() == 0_usize
    }

    pub fn byte_at(self: String, index: usize) -> Option[u8] {
        if index >= len(self.value) {
            ret Option[u8]::None
        }

        ret Option[u8]::Some(byte_at(self.value, index))
    }

    pub fn char_at(self: String, index: usize) -> Option[str] {
        if index >= len(self.value) {
            ret Option[str]::None
        }

        ret Option[str]::Some(slice(self.value, index, 1_usize))
    }

    pub fn concat(self: String, rhs: str) -> String {
        ret String{concat(self.value, rhs)}
    }
}
