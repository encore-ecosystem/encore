import refrain::vec::Vec

extern fn __ehir_rt_str_len(value: str) -> usize
extern fn __ehir_rt_str_byte_at(value: str, index: usize) -> u8

pub struct String {
    vec: Vec[u8]
}

impl for String {
    pub fn new() -> String {
        String { Vec[u8]::new() }
    }

    pub fn from_str(s: str) -> String {
        let mut result = String::new()
        unsafe {
            let len: usize = __ehir_rt_str_len(s)
        }
        let mut i: usize = 0
        while i < len {
            unsafe {
                let byte_at = __ehir_rt_str_byte_at(s, i)
                Vec[u8]::push(result.vec, byte_at)
            }
            i = i + 1
        }
        ret result
    }
}
