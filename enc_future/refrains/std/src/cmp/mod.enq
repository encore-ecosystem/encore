pub enum Ordering {
    Less
    Equal
    Greater
}

pub trait Eq[T] {
    fn eq(lhs: T, rhs: T) -> bool
}

pub fn eq[T](lhs: T, rhs: T) -> bool {
    ret lhs == rhs
}

pub fn neq[T](lhs: T, rhs: T) -> bool {
    ret lhs != rhs
}

pub fn lt[T](lhs: T, rhs: T) -> bool {
    ret lhs < rhs
}

pub fn le[T](lhs: T, rhs: T) -> bool {
    ret lhs <= rhs
}

pub fn gt[T](lhs: T, rhs: T) -> bool {
    ret lhs > rhs
}

pub fn ge[T](lhs: T, rhs: T) -> bool {
    ret lhs >= rhs
}

pub fn compare[T](lhs: T, rhs: T) -> Ordering {
    if (lhs < rhs) {
        ret Ordering::Less
    } elif (lhs > rhs) {
        ret Ordering::Greater
    } else {
        ret Ordering::Equal
    }
}

pub fn min[T](lhs: T, rhs: T) -> T {
    if (lhs <= rhs) {
        ret lhs
    } else {
        ret rhs
    }
}

pub fn max[T](lhs: T, rhs: T) -> T {
    if (lhs >= rhs) {
       ret lhs
    } else {
       ret rhs
    }
}
