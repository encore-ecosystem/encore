import std::option::Option
import ehir::core::types::Type
import ehir::core::variable::Variable

pub struct CommentInstruction {
    text: str
}

pub struct LiteralInstruction {
    out: Variable
    value: str
}

pub struct CallInstruction {
    out: Variable
    name: str
    args: str
    is_unsafe: bool
}

pub struct StoreInstruction {
    src: Variable
    dst: Variable
}

pub struct LoadInstruction {
    out: Variable
    src: Variable
}

pub struct GetFieldInstruction {
    out: Variable
    src: Variable
    field: str
}

pub struct GetFieldPtrInstruction {
    out: Variable
    src: Variable
    field: str
}

pub struct ConstructStructInstruction {
    out: Variable
    name: str
    args: str
}

pub struct PhiPair {
    label: str
    value: Variable
}

pub struct PhiInstruction {
    out: Variable
    pairs: str
}

pub struct ReturnInstruction {
    value: Variable
}

pub struct BranchInstruction {
    label: str
}

pub struct ConditionalBranchInstruction {
    cond: Variable
    true_label: str
    false_label: str
}

pub struct MatchArm {
    variant: str
    binding: Option[Variable]
    label: str
}

pub struct MatchInstruction {
    scrutinee: Variable
    default_label: str
    arms: str
}

pub enum Instruction {
    Comment(CommentInstruction)
    Literal(LiteralInstruction)
    Call(CallInstruction)
    Store(StoreInstruction)
    Load(LoadInstruction)
    GetField(GetFieldInstruction)
    GetFieldPtr(GetFieldPtrInstruction)
    ConstructStruct(ConstructStructInstruction)
    Phi(PhiInstruction)
}

pub enum Terminator {
    Ret(ReturnInstruction)
    Br(BranchInstruction)
    Cbr(ConditionalBranchInstruction)
    Match(MatchInstruction)
}

pub fn comment(text: str) -> Instruction {
    ret Instruction::Comment(CommentInstruction{text})
}

pub fn literal(out: Variable, value: str) -> Instruction {
    ret Instruction::Literal(LiteralInstruction{out, value})
}

pub fn call(out: Variable, name: str, args: str, is_unsafe: bool) -> Instruction {
    ret Instruction::Call(CallInstruction{out, name, args, is_unsafe})
}

pub fn store(src: Variable, dst: Variable) -> Instruction {
    ret Instruction::Store(StoreInstruction{src, dst})
}

pub fn load(out: Variable, src: Variable) -> Instruction {
    ret Instruction::Load(LoadInstruction{out, src})
}

pub fn getfield(out: Variable, src: Variable, field: str) -> Instruction {
    ret Instruction::GetField(GetFieldInstruction{out, src, field})
}

pub fn getfieldptr(out: Variable, src: Variable, field: str) -> Instruction {
    ret Instruction::GetFieldPtr(GetFieldPtrInstruction{out, src, field})
}

pub fn construct_struct(out: Variable, name: str, args: str) -> Instruction {
    ret Instruction::ConstructStruct(ConstructStructInstruction{out, name, args})
}

pub fn phi_pair(label: str, value: Variable) -> PhiPair {
    ret PhiPair{label, value}
}

pub fn phi(out: Variable, pairs: str) -> Instruction {
    ret Instruction::Phi(PhiInstruction{out, pairs})
}

pub fn ret_term(value: Variable) -> Terminator {
    ret Terminator::Ret(ReturnInstruction{value})
}

pub fn br_term(label: str) -> Terminator {
    ret Terminator::Br(BranchInstruction{label})
}

pub fn cbr_term(cond: Variable, true_label: str, false_label: str) -> Terminator {
    ret Terminator::Cbr(ConditionalBranchInstruction{cond, true_label, false_label})
}

pub fn match_arm(variant: str, binding: Option[Variable], label: str) -> MatchArm {
    ret MatchArm{variant, binding, label}
}

pub fn match_term(scrutinee: Variable, default_label: str, arms: str) -> Terminator {
    ret Terminator::Match(MatchInstruction{scrutinee, default_label, arms})
}
