import std::option::Option
import std::vec::Vec
import ehir::core::types::Type
import ehir::core::variable::Variable

pub struct CommentInstruction {
    text: str
}

pub struct LiteralInstruction {
    out: Variable
    value: str
}

pub struct CallInstruction {
    out: Variable
    name: str
    generics: Vec[Type]<H>
    args: Vec[Variable]<H>
    is_unsafe: bool
}

pub struct StoreInstruction {
    src: Variable
    dst: Variable
}

pub struct LoadInstruction {
    out: Variable
    src: Variable
}

pub struct GetFieldInstruction {
    out: Variable
    src: Variable
    field: Variable
}

pub struct GetFieldPtrInstruction {
    out: Variable
    src: Variable
    field: Variable
}

pub struct ConstructStructInstruction {
    out: Variable
    name: str
    args: Vec[Variable]<H>
}

pub struct GetPtrInstruction {
    out: Variable
    src: Variable
}

pub struct PtrCastInstruction {
    out: Variable
    src: Variable
    target_type: Type
}

pub struct StackAllocInstruction {
    out: Variable
}

pub struct HeapAllocInstruction {
    out: Variable
}

pub struct HeapFreeInstruction {
    src: Variable
}

pub struct PutInstruction {
    out: Variable
    src: Variable
}

pub enum BinaryOpKind {
    ADD
    SUB
    MUL
    DIV
    AND
    OR
    IEQ
    NEQ
    LES
    LEQ
    GRT
    GEQ
}

pub struct BinaryInstruction {
    out: Variable
    lhs: Variable
    rhs: Variable
    op: BinaryOpKind
}

pub struct PhiPair {
    value: Variable
    label: str
}

pub struct PhiInstruction {
    out: Variable
    pairs: Vec[PhiPair]<H>
}

pub struct ReturnInstruction {
    value: Variable
}

pub struct BranchInstruction {
    label: str
}

pub struct ConditionalBranchInstruction {
    cond: Variable
    true_label: str
    false_label: str
}

pub struct MatchArm {
    variant: str
    payload_var: Option[Variable]
    label: str
}

pub struct MatchInstruction {
    scrutinee: Variable
    default_label: str
    arms: Vec[MatchArm]<H>
}

pub struct SwitchCase {
    value: str
    label: str
}

pub struct SwitchInstruction {
    scrutinee: Variable
    default_label: str
    cases: Vec[SwitchCase]<H>
}

pub struct CfreeInstruction {
    value: Variable
}

pub enum Instruction {
    Comment(CommentInstruction)
    Literal(LiteralInstruction)
    Call(CallInstruction)
    Store(StoreInstruction)
    Load(LoadInstruction)
    GetField(GetFieldInstruction)
    GetFieldPtr(GetFieldPtrInstruction)
    ConstructStruct(ConstructStructInstruction)
    GetPtr(GetPtrInstruction)
    PtrCast(PtrCastInstruction)
    StackAlloc(StackAllocInstruction)
    HeapAlloc(HeapAllocInstruction)
    HeapFree(HeapFreeInstruction)
    Put(PutInstruction)
    Binary(BinaryInstruction)
    Phi(PhiInstruction)
}

pub enum Terminator {
    Ret(ReturnInstruction)
    Br(BranchInstruction)
    Cbr(ConditionalBranchInstruction)
    Match(MatchInstruction)
    Switch(SwitchInstruction)
    Cfree(CfreeInstruction)
}

pub fn comment(text: str) -> Instruction {
    ret Instruction::Comment(CommentInstruction{text})
}

pub fn literal(out: Variable, value: str) -> Instruction {
    ret Instruction::Literal(LiteralInstruction{out, value})
}

pub fn call(
    out: Variable,
    name: str,
    generics: Vec[Type]<H>,
    args: Vec[Variable]<H>,
    is_unsafe: bool
) -> Instruction {
    ret Instruction::Call(CallInstruction{out, name, generics, args, is_unsafe})
}

pub fn store(src: Variable, dst: Variable) -> Instruction {
    ret Instruction::Store(StoreInstruction{src, dst})
}

pub fn load(out: Variable, src: Variable) -> Instruction {
    ret Instruction::Load(LoadInstruction{out, src})
}

pub fn getfield(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret Instruction::GetField(GetFieldInstruction{out, src, field})
}

pub fn getfieldptr(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret Instruction::GetFieldPtr(GetFieldPtrInstruction{out, src, field})
}

pub fn construct_struct(out: Variable, name: str, args: Vec[Variable]<H>) -> Instruction {
    ret Instruction::ConstructStruct(ConstructStructInstruction{out, name, args})
}

pub fn getptr(out: Variable, src: Variable) -> Instruction {
    ret Instruction::GetPtr(GetPtrInstruction{out, src})
}

pub fn pcast(out: Variable, src: Variable, target_type: Type) -> Instruction {
    ret Instruction::PtrCast(PtrCastInstruction{out, src, target_type})
}

pub fn salloc(out: Variable) -> Instruction {
    ret Instruction::StackAlloc(StackAllocInstruction{out})
}

pub fn halloc(out: Variable) -> Instruction {
    ret Instruction::HeapAlloc(HeapAllocInstruction{out})
}

pub fn hfree(src: Variable) -> Instruction {
    ret Instruction::HeapFree(HeapFreeInstruction{src})
}

pub fn put(out: Variable, src: Variable) -> Instruction {
    ret Instruction::Put(PutInstruction{out, src})
}

pub fn binary(out: Variable, lhs: Variable, rhs: Variable, op: BinaryOpKind) -> Instruction {
    ret Instruction::Binary(BinaryInstruction{out, lhs, rhs, op})
}

pub fn add(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::ADD)
}

pub fn sub(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::SUB)
}

pub fn mul(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::MUL)
}

pub fn div(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::DIV)
}

pub fn and_op(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::AND)
}

pub fn or_op(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::OR)
}

pub fn ieq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::IEQ)
}

pub fn neq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::NEQ)
}

pub fn les(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::LES)
}

pub fn leq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::LEQ)
}

pub fn grt(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::GRT)
}

pub fn geq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret binary(out, lhs, rhs, BinaryOpKind::GEQ)
}

pub fn phi_pair(value: Variable, label: str) -> PhiPair {
    ret PhiPair{value, label}
}

pub fn phi(out: Variable, pairs: Vec[PhiPair]<H>) -> Instruction {
    ret Instruction::Phi(PhiInstruction{out, pairs})
}

pub fn ret_term(value: Variable) -> Terminator {
    ret Terminator::Ret(ReturnInstruction{value})
}

pub fn br_term(label: str) -> Terminator {
    ret Terminator::Br(BranchInstruction{label})
}

pub fn cbr_term(cond: Variable, true_label: str, false_label: str) -> Terminator {
    ret Terminator::Cbr(ConditionalBranchInstruction{cond, true_label, false_label})
}

pub fn match_arm(variant: str, payload_var: Option[Variable], label: str) -> MatchArm {
    ret MatchArm{variant, payload_var, label}
}

pub fn match_term(scrutinee: Variable, default_label: str, arms: Vec[MatchArm]<H>) -> Terminator {
    ret Terminator::Match(MatchInstruction{scrutinee, default_label, arms})
}

pub fn switch_case(value: str, label: str) -> SwitchCase {
    ret SwitchCase{value, label}
}

pub fn switch_term(scrutinee: Variable, default_label: str, cases: Vec[SwitchCase]<H>) -> Terminator {
    ret Terminator::Switch(SwitchInstruction{scrutinee, default_label, cases})
}

pub fn cfree_term(value: Variable) -> Terminator {
    ret Terminator::Cfree(CfreeInstruction{value})
}
