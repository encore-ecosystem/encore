import ehir::core::block::Block
import ehir::core::types::Type
import ehir::core::variable::Parameter

pub struct ImportDirective {
    path: str
    symbol: str
    is_public: bool
}

pub struct StructDirective {
    name: str
    generics: str
    fields: str
}

pub struct EnumVariant {
    name: str
    payload_type: str
}

pub struct EnumDirective {
    name: str
    generics: str
    variants: str
}

pub struct FnDirective {
    name: str
    generics: str
    params: str
    ret_type: Type
    blocks: str
    is_extern: bool
}

pub struct TraitDirective {
    name: str
    generics: str
    body: str
}

pub struct ImplDirective {
    generics: str
    trait_name: str
    target: Type
    body: str
}

pub enum Directive {
    Import(ImportDirective)
    Struct(StructDirective)
    Enum(EnumDirective)
    Function(FnDirective)
    Trait(TraitDirective)
    Impl(ImplDirective)
}

pub fn imp(path: str, symbol: str) -> Directive {
    ret Directive::Import(ImportDirective{path, symbol, false})
}

pub fn cimp(path: str, symbol: str) -> Directive {
    ret Directive::Import(ImportDirective{path, symbol, true})
}

pub fn struct_directive(name: str, generics: str, fields: str) -> Directive {
    ret Directive::Struct(StructDirective{name, generics, fields})
}

pub fn enum_variant(name: str, payload_type: str) -> EnumVariant {
    ret EnumVariant{name, payload_type}
}

pub fn enum_directive(name: str, generics: str, variants: str) -> Directive {
    ret Directive::Enum(EnumDirective{name, generics, variants})
}

pub fn fn_directive(
    name: str,
    generics: str,
    params: str,
    ret_type: Type,
    blocks: str,
    is_extern: bool
) -> Directive {
    ret Directive::Function(FnDirective{name, generics, params, ret_type, blocks, is_extern})
}

pub fn extern_fn_directive(name: str, generics: str, params: str, ret_type: Type) -> Directive {
    ret Directive::Function(FnDirective{name, generics, params, ret_type, "", true})
}

pub fn trait_directive(name: str, generics: str, body: str) -> Directive {
    ret Directive::Trait(TraitDirective{name, generics, body})
}

pub fn impl_directive(generics: str, trait_name: str, target: Type, body: str) -> Directive {
    ret Directive::Impl(ImplDirective{generics, trait_name, target, body})
}
