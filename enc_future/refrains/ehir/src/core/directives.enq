import std::option::Option
import std::vec::Vec
import ehir::core::block::Block
import ehir::core::types::Type
import ehir::core::variable::Parameter

pub struct ImportDirective {
    prefix: Vec[str]<H>
    symbol: str
    is_public: bool
}

pub struct StructDirective {
    name: str
    generics: Vec[Type]<H>
    fields: Vec[Parameter]<H>
}

pub struct EnumVariant {
    name: str
    payload_type: Option[Type]
}

pub struct EnumDirective {
    name: str
    generics: Vec[Type]<H>
    variants: Vec[EnumVariant]<H>
}

pub struct FnDirective {
    name: str
    generics: Vec[Type]<H>
    params: Vec[Parameter]<H>
    ret_type: Type
    blocks: Vec[Block]<H>
    is_extern: bool
}

pub struct TraitMethod {
    name: str
    generics: Vec[Type]<H>
    params: Vec[Parameter]<H>
    ret_type: Type
}

pub struct TraitDirective {
    name: str
    generics: Vec[Type]<H>
    methods: Vec[TraitMethod]<H>
}

pub struct ImplDirective {
    trait_name: str
    trait_args: Vec[Type]<H>
    for_type: Type
    generics: Vec[Type]<H>
    methods: Vec[FnDirective]<H>
}

pub enum Directive {
    Import(ImportDirective)
    Struct(StructDirective)
    Enum(EnumDirective)
    Function(FnDirective)
    Trait(TraitDirective)
    Impl(ImplDirective)
}

pub fn imp(prefix: Vec[str]<H>, symbol: str) -> Directive {
    ret Directive::Import(ImportDirective{prefix, symbol, false})
}

pub fn cimp(prefix: Vec[str]<H>, symbol: str) -> Directive {
    ret Directive::Import(ImportDirective{prefix, symbol, true})
}

pub fn imp_all(prefix: Vec[str]<H>) -> Directive {
    ret imp(prefix, "*")
}

pub fn cimp_all(prefix: Vec[str]<H>) -> Directive {
    ret cimp(prefix, "*")
}

pub fn struct_directive(name: str, generics: Vec[Type]<H>, fields: Vec[Parameter]<H>) -> Directive {
    ret Directive::Struct(StructDirective{name, generics, fields})
}

pub fn enum_variant(name: str, payload_type: Option[Type]) -> EnumVariant {
    ret EnumVariant{name, payload_type}
}

pub fn enum_directive(name: str, generics: Vec[Type]<H>, variants: Vec[EnumVariant]<H>) -> Directive {
    ret Directive::Enum(EnumDirective{name, generics, variants})
}

pub fn trait_method(
    name: str,
    generics: Vec[Type]<H>,
    params: Vec[Parameter]<H>,
    ret_type: Type
) -> TraitMethod {
    ret TraitMethod{name, generics, params, ret_type}
}

pub fn fn_directive(
    name: str,
    generics: Vec[Type]<H>,
    params: Vec[Parameter]<H>,
    ret_type: Type,
    blocks: Vec[Block]<H>,
    is_extern: bool
) -> Directive {
    ret Directive::Function(FnDirective{name, generics, params, ret_type, blocks, is_extern})
}

pub fn extern_fn_directive(
    name: str,
    generics: Vec[Type]<H>,
    params: Vec[Parameter]<H>,
    ret_type: Type,
    blocks: Vec[Block]<H>
) -> Directive {
    ret Directive::Function(FnDirective{name, generics, params, ret_type, blocks, true})
}

pub fn trait_directive(name: str, generics: Vec[Type]<H>, methods: Vec[TraitMethod]<H>) -> Directive {
    ret Directive::Trait(TraitDirective{name, generics, methods})
}

pub fn impl_directive(
    generics: Vec[Type]<H>,
    trait_name: str,
    trait_args: Vec[Type]<H>,
    for_type: Type,
    methods: Vec[FnDirective]<H>
) -> Directive {
    ret Directive::Impl(ImplDirective{trait_name, trait_args, for_type, generics, methods})
}
