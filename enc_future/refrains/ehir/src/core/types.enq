import std::option::Option

pub enum PointerKind {
    Stack
    Heap
    Raw
}

pub struct Type {
    name: str
    generics: str
    pointer: Option[PointerKind]
}

pub fn make_type(name: str, generics: str, pointer: Option[PointerKind]) -> Type {
    ret Type{name, generics, pointer}
}

pub fn heap_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, Option[PointerKind]::Some(PointerKind::Heap)}
}

pub fn stack_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, Option[PointerKind]::Some(PointerKind::Stack)}
}

pub fn raw_type(inner: Type) -> Type {
    ret Type{inner.name, inner.generics, Option[PointerKind]::Some(PointerKind::Raw)}
}
