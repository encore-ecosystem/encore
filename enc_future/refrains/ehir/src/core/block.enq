import std::vec::Vec
import ehir::core::instructions::Instruction
import ehir::core::instructions::Terminator

pub struct Block {
    name: str
    instructions: Vec[Instruction]<H>
    terminator: Terminator
}

pub fn block(name: str, instructions: Vec[Instruction]<H>, terminator: Terminator) -> Block {
    ret Block{name, instructions, terminator}
}
