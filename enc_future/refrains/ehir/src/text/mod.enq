fn newline() -> str {
    ret "
"
}

fn join_strings(items: Vec[str], separator: str) -> str {
    let mut out = ""
    let mut index = 0_usize

    loop {
        match items.get(index) {
            Some(item) => {
                if index > 0_usize {
                    out = concat(out, separator)
                }
                out = concat(out, item)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

fn push_text(items: Vec[str], value: str) -> Vec[str] {
    ret items.push(value)
}

fn collect_type_strings(items: Vec[Type]) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize

    loop {
        match items.get(index) {
            Some(item) => {
                out = push_text(out, type_to_string(item))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

