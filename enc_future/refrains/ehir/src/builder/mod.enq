import std::option::Option
import std::vec::Vec
import ehir::core::Block
import ehir::core::Directive
import ehir::core::EnumVariant
import ehir::core::FnDirective
import ehir::core::TraitMethod
import ehir::core::Instruction
import ehir::core::MatchArm
import ehir::core::Module
import ehir::core::Parameter
import ehir::core::PhiPair
import ehir::core::SwitchCase
import ehir::core::Terminator
import ehir::core::Type
import ehir::core::Variable
import ehir::core::struct_directive
import ehir::core::enum_directive
import ehir::core::fn_directive
import ehir::core::extern_fn_directive
import ehir::core::imp
import ehir::core::cimp
import ehir::core::imp_all
import ehir::core::cimp_all
import ehir::core::trait_method
import ehir::core::trait_directive
import ehir::core::impl_directive
import ehir::core::comment
import ehir::core::literal
import ehir::core::call
import ehir::core::store
import ehir::core::load
import ehir::core::getfield
import ehir::core::getfieldptr
import ehir::core::construct_struct
import ehir::core::getptr
import ehir::core::pcast
import ehir::core::salloc
import ehir::core::halloc
import ehir::core::hfree
import ehir::core::put
import ehir::core::BinaryOpKind
import ehir::core::binary
import ehir::core::add
import ehir::core::sub
import ehir::core::mul
import ehir::core::div
import ehir::core::and_op
import ehir::core::or_op
import ehir::core::ieq
import ehir::core::neq
import ehir::core::les
import ehir::core::leq
import ehir::core::grt
import ehir::core::geq
import ehir::core::phi_pair
import ehir::core::phi
import ehir::core::ret_term
import ehir::core::br_term
import ehir::core::cbr_term
import ehir::core::match_arm
import ehir::core::match_term
import ehir::core::switch_case
import ehir::core::switch_term
import ehir::core::cfree_term

pub fn empty_module(name: str, directives: Vec[Directive]<H>) -> Module {
    ret Module{name, directives}
}

pub fn module_with_directives(name: str, directives: Vec[Directive]<H>) -> Module {
    ret Module{name, directives}
}

pub fn empty_block(name: str, instructions: Vec[Instruction]<H>, terminator: Terminator) -> Block {
    ret Block{name, instructions, terminator}
}

pub fn block_with_instructions(name: str, instructions: Vec[Instruction]<H>, terminator: Terminator) -> Block {
    ret Block{name, instructions, terminator}
}

pub fn make_struct(name: str, generics: Vec[Type]<H>, fields: Vec[Parameter]<H>) -> Directive {
    ret struct_directive(name, generics, fields)
}

pub fn make_enum(name: str, generics: Vec[Type]<H>, variants: Vec[EnumVariant]<H>) -> Directive {
    ret enum_directive(name, generics, variants)
}

pub fn make_trait_method(
    name: str,
    generics: Vec[Type]<H>,
    params: Vec[Parameter]<H>,
    ret_type: Type
) -> TraitMethod {
    ret trait_method(name, generics, params, ret_type)
}

pub fn make_trait(name: str, generics: Vec[Type]<H>, methods: Vec[TraitMethod]<H>) -> Directive {
    ret trait_directive(name, generics, methods)
}

pub fn make_impl(
    generics: Vec[Type]<H>,
    trait_name: str,
    trait_args: Vec[Type]<H>,
    for_type: Type,
    methods: Vec[FnDirective]<H>
) -> Directive {
    ret impl_directive(generics, trait_name, trait_args, for_type, methods)
}

pub fn make_fn(
    name: str,
    generics: Vec[Type]<H>,
    params: Vec[Parameter]<H>,
    ret_type: Type,
    blocks: Vec[Block]<H>
) -> Directive {
    ret fn_directive(name, generics, params, ret_type, blocks, false)
}

pub fn make_extern_fn(
    name: str,
    generics: Vec[Type]<H>,
    params: Vec[Parameter]<H>,
    ret_type: Type,
    blocks: Vec[Block]<H>
) -> Directive {
    ret extern_fn_directive(name, generics, params, ret_type, blocks)
}

pub fn make_import(prefix: Vec[str]<H>, symbol: str) -> Directive {
    ret imp(prefix, symbol)
}

pub fn make_public_import(prefix: Vec[str]<H>, symbol: str) -> Directive {
    ret cimp(prefix, symbol)
}

pub fn make_import_all(prefix: Vec[str]<H>) -> Directive {
    ret imp_all(prefix)
}

pub fn make_public_import_all(prefix: Vec[str]<H>) -> Directive {
    ret cimp_all(prefix)
}

pub fn make_comment(text: str) -> Instruction {
    ret comment(text)
}

pub fn make_literal(out: Variable, value: str) -> Instruction {
    ret literal(out, value)
}

pub fn make_call(
    out: Variable,
    name: str,
    generics: Vec[Type]<H>,
    args: Vec[Variable]<H>,
    is_unsafe: bool
) -> Instruction {
    ret call(out, name, generics, args, is_unsafe)
}

pub fn make_store(src: Variable, dst: Variable) -> Instruction {
    ret store(src, dst)
}

pub fn make_load(out: Variable, src: Variable) -> Instruction {
    ret load(out, src)
}

pub fn make_getfield(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret getfield(out, src, field)
}

pub fn make_getfieldptr(out: Variable, src: Variable, field: Variable) -> Instruction {
    ret getfieldptr(out, src, field)
}

pub fn make_construct_struct(out: Variable, name: str, args: Vec[Variable]<H>) -> Instruction {
    ret construct_struct(out, name, args)
}

pub fn make_getptr(out: Variable, src: Variable) -> Instruction {
    ret getptr(out, src)
}

pub fn make_pcast(out: Variable, src: Variable, target_type: Type) -> Instruction {
    ret pcast(out, src, target_type)
}

pub fn make_salloc(out: Variable) -> Instruction {
    ret salloc(out)
}

pub fn make_halloc(out: Variable) -> Instruction {
    ret halloc(out)
}

pub fn make_hfree(src: Variable) -> Instruction {
    ret hfree(src)
}

pub fn make_put(out: Variable, src: Variable) -> Instruction {
    ret put(out, src)
}

pub fn make_binary(out: Variable, lhs: Variable, rhs: Variable, op: BinaryOpKind) -> Instruction {
    ret binary(out, lhs, rhs, op)
}

pub fn make_add(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret add(out, lhs, rhs)
}

pub fn make_sub(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret sub(out, lhs, rhs)
}

pub fn make_mul(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret mul(out, lhs, rhs)
}

pub fn make_div(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret div(out, lhs, rhs)
}

pub fn make_and(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret and_op(out, lhs, rhs)
}

pub fn make_or(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret or_op(out, lhs, rhs)
}

pub fn make_ieq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret ieq(out, lhs, rhs)
}

pub fn make_neq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret neq(out, lhs, rhs)
}

pub fn make_les(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret les(out, lhs, rhs)
}

pub fn make_leq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret leq(out, lhs, rhs)
}

pub fn make_grt(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret grt(out, lhs, rhs)
}

pub fn make_geq(out: Variable, lhs: Variable, rhs: Variable) -> Instruction {
    ret geq(out, lhs, rhs)
}

pub fn make_phi_pair(value: Variable, label: str) -> PhiPair {
    ret phi_pair(value, label)
}

pub fn make_phi(out: Variable, pairs: Vec[PhiPair]<H>) -> Instruction {
    ret phi(out, pairs)
}

pub fn make_ret(value: Variable) -> Terminator {
    ret ret_term(value)
}

pub fn make_br(label: str) -> Terminator {
    ret br_term(label)
}

pub fn make_cbr(cond: Variable, true_label: str, false_label: str) -> Terminator {
    ret cbr_term(cond, true_label, false_label)
}

pub fn make_match_arm(variant: str, payload_var: Option[Variable], label: str) -> MatchArm {
    ret match_arm(variant, payload_var, label)
}

pub fn make_match(scrutinee: Variable, default_label: str, arms: Vec[MatchArm]<H>) -> Terminator {
    ret match_term(scrutinee, default_label, arms)
}

pub fn make_switch_case(value: str, label: str) -> SwitchCase {
    ret switch_case(value, label)
}

pub fn make_switch(scrutinee: Variable, default_label: str, cases: Vec[SwitchCase]<H>) -> Terminator {
    ret switch_term(scrutinee, default_label, cases)
}

pub fn make_cfree(value: Variable) -> Terminator {
    ret cfree_term(value)
}
