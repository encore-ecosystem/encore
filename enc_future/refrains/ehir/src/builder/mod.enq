import std::vec::Vec
import ehir::core::Block
import ehir::core::Directive
import ehir::core::Instruction
import ehir::core::Module
import ehir::core::Terminator

pub fn empty_module(name: str) -> Module {
    ret Module{name, Vec[Directive]::Empty}
}

pub fn empty_block(name: str, terminator: Terminator) -> Block {
    ret Block{name, Vec[Instruction]::Empty, terminator}
}
