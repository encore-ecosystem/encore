    fn op(self: Self, other: Rhs) -> bool
}

pub trait Le[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

pub trait Gt[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}

pub trait Ge[Rhs] {
    fn op(self: Self, other: Rhs) -> bool
}
