import refrain::ops::cmp::base::*


impl Eq[u32] for u32 {
    pub fn op(self: u32, other: u32) -> bool {
        ehir {
            result: bool = ieq self: u32, other: u32
        }
        ret result
    }
}

impl Ne[u32] for u32 {
    pub fn op(self: u32, other: u32) -> bool {
        ehir {
            result: bool = neq self: u32, other: u32
        }
        ret result
    }
}

