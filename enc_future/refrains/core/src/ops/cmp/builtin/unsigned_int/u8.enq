import refrain::ops::cmp::base::*


impl Eq[u8] for u8 {
    pub fn op(self: u8, other: u8) -> bool {
        ehir {
            result: bool = ieq self: u8, other: u8
        }
        ret result
    }
}

impl Ne[u8] for u8 {
    pub fn op(self: u8, other: u8) -> bool {
        ehir {
            result: bool = neq self: u8, other: u8
        }
        ret result
    }
}

