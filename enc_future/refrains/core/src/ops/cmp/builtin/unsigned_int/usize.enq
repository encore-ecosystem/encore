import refrain::ops::cmp::base::*


impl Eq[usize] for usize {
    pub fn op(self: usize, other: usize) -> bool {
        ehir {
            result: bool = ieq self: usize, other: usize
        }
        ret result
    }
}

impl Ne[usize] for usize {
    pub fn op(self: usize, other: usize) -> bool {
        ehir {
            result: bool = neq self: usize, other: usize
        }
        ret result
    }
}

impl Lt[usize] for usize {
    pub fn op(self: usize, other: usize) -> bool {
        ehir {
            result: bool = les self: usize, other: usize
        }
        ret result
    }
}

impl Le[usize] for usize {
    pub fn op(self: usize, other: usize) -> bool {
        ehir {
            result: bool = leq self: usize, other: usize
        }
        ret result
    }
}

impl Gt[usize] for usize {
    pub fn op(self: usize, other: usize) -> bool {
        ehir {
            result: bool = grt self: usize, other: usize
        }
        ret result
    }
