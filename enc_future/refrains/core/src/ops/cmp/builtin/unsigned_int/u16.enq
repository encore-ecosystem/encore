import refrain::ops::cmp::base::*


impl Eq[u16] for u16 {
    pub fn op(self: u16, other: u16) -> bool {
        ehir {
            result: bool = ieq self: u16, other: u16
        }
        ret result
    }
}

impl Ne[u16] for u16 {
    pub fn op(self: u16, other: u16) -> bool {
        ehir {
            result: bool = neq self: u16, other: u16
        }
        ret result
    }
}

impl Lt[u16] for u16 {
    pub fn op(self: u16, other: u16) -> bool {
        ehir {
            result: bool = les self: u16, other: u16
        }
        ret result
    }
}

impl Le[u16] for u16 {
    pub fn op(self: u16, other: u16) -> bool {
        ehir {
            result: bool = leq self: u16, other: u16
        }
        ret result
    }
}

