import refrain::ops::cmp::base::*


impl Eq[f32] for f32 {
    pub fn op(self: f32, other: f32) -> bool {
        ehir {
            result: bool = ieq self: f32, other: f32
        }
        ret result
    }
}

impl Ne[f32] for f32 {
    pub fn op(self: f32, other: f32) -> bool {
        ehir {
            result: bool = neq self: f32, other: f32
        }
        ret result
    }
}

impl Lt[f32] for f32 {
    pub fn op(self: f32, other: f32) -> bool {
        ehir {
            result: bool = les self: f32, other: f32
        }
        ret result
    }
}

impl Le[f32] for f32 {
    pub fn op(self: f32, other: f32) -> bool {
        ehir {
            result: bool = leq self: f32, other: f32
        }
        ret result
    }
