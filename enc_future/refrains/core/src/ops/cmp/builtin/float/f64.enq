import refrain::ops::cmp::base::*


impl Eq[f64] for f64 {
    pub fn op(self: f64, other: f64) -> bool {
        ehir {
            result: bool = ieq self: f64, other: f64
        }
        ret result
    }
}

impl Ne[f64] for f64 {
    pub fn op(self: f64, other: f64) -> bool {
        ehir {
            result: bool = neq self: f64, other: f64
        }
        ret result
    }
}

