import refrain::ops::cmp::base::*

extern fn __ehir_rt_str_eq(lhs: str, rhs: str) -> bool
extern fn __ehir_rt_str_len(value: str) -> usize
extern fn __ehir_rt_str_byte_at(value: str, index: usize) -> u8

impl Eq[str] for str {
    pub fn op(self: str, other: str) -> bool {
        unsafe {
            let n = __ehir_rt_str_len(other)
        }
        let mut i = 0_usize
        let mut flag = true
        while i < n {
            unsafe {
                flag = __ehir_rt_str_eq(self, other)
            }
            if !flag {
                ret false
            }
            i = i + 1
        }
        ret true
    }
}

impl Ne[str] for str {
    pub fn op(self: str, other: str) -> bool {
        unsafe {
            if __ehir_rt_str_eq(self, other) {
                ret false
            }
            ret true
        }
    }
}
