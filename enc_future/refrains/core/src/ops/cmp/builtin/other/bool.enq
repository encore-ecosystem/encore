import refrain::ops::cmp::base::*


impl Eq[bool] for bool {
    pub fn op(self: bool, other: bool) -> bool {
        ehir {
            result: bool = ieq self: bool, other: bool
        }
        ret result
    }
}

impl Ne[bool] for bool {
    pub fn op(self: bool, other: bool) -> bool {
        ehir {
            result: bool = neq self: bool, other: bool
        }
        ret result
    }
}
