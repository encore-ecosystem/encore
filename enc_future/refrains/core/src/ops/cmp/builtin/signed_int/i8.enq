import refrain::ops::cmp::base::*


impl Eq[i8] for i8 {
    pub fn op(self: i8, other: i8) -> bool {
        ehir {
            result: bool = ieq self: i8, other: i8
        }
        ret result
    }
}

impl Ne[i8] for i8 {
    pub fn op(self: i8, other: i8) -> bool {
        ehir {
            result: bool = neq self: i8, other: i8
        }
        ret result
    }
}

