import refrain::ops::cmp::base::*


impl Eq[isize] for isize {
    pub fn op(self: isize, other: isize) -> bool {
        ehir {
            result: bool = ieq self: isize, other: isize
        }
        ret result
    }
}

impl Ne[isize] for isize {
    pub fn op(self: isize, other: isize) -> bool {
        ehir {
            result: bool = neq self: isize, other: isize
        }
        ret result
    }
}

