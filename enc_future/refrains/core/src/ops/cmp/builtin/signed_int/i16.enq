import refrain::ops::cmp::base::*


impl Eq[i16] for i16 {
    pub fn op(self: i16, other: i16) -> bool {
        ehir {
            result: bool = ieq self: i16, other: i16
        }
        ret result
    }
}

impl Ne[i16] for i16 {
    pub fn op(self: i16, other: i16) -> bool {
        ehir {
            result: bool = neq self: i16, other: i16
        }
        ret result
    }
}

