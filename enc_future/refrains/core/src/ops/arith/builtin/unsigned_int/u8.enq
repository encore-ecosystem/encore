import refrain::ops::arith::base::*


impl Add[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = add self: u8, other: u8
        }
        ret result
    }
}

impl Sub[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = sub self: u8, other: u8
        }
        ret result
    }
}

impl Mul[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = mul self: u8, other: u8
        }
        ret result
    }
}

impl Div[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = div self: u8, other: u8
        }
        ret result
    }
}
