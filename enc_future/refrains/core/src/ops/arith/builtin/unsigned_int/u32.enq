import refrain::ops::arith::base::*


impl Add[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = add self: u32, other: u32
        }
        ret result
    }
}

impl Sub[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = sub self: u32, other: u32
        }
        ret result
    }
}

impl Mul[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = mul self: u32, other: u32
        }
        ret result
    }
}

impl Div[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = div self: u32, other: u32
        }
        ret result
    }
}
