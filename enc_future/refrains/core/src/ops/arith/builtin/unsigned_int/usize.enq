import refrain::ops::arith::base::*


impl Add[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = add self: usize, other: usize
        }
        ret result
    }
}

impl Sub[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = sub self: usize, other: usize
        }
        ret result
    }
}

impl Mul[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = mul self: usize, other: usize
        }
        ret result
    }
}

impl Div[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = div self: usize, other: usize
        }
        ret result
    }
}
