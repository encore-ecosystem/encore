import refrain::ops::arith::base::*


impl Add[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = add self: u64, other: u64
        }
        ret result
    }
}

impl Sub[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = sub self: u64, other: u64
        }
        ret result
    }
}

impl Mul[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = mul self: u64, other: u64
        }
        ret result
    }
}

impl Div[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = div self: u64, other: u64
        }
        ret result
    }
}
