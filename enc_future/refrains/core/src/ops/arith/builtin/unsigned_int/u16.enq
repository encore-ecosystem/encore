import refrain::ops::arith::base::*


impl Add[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = add self: u16, other: u16
        }
        ret result
    }
}

impl Sub[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = sub self: u16, other: u16
        }
        ret result
    }
}

impl Mul[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = mul self: u16, other: u16
        }
        ret result
    }
}

impl Div[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = div self: u16, other: u16
        }
        ret result
    }
}
