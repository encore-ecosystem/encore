import refrain::ops::arith::base::*


impl Add[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = add self: isize, other: isize
        }
        ret result
    }
}

impl Sub[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = sub self: isize, other: isize
        }
        ret result
    }
}

impl Mul[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = mul self: isize, other: isize
        }
        ret result
    }
}

impl Div[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = div self: isize, other: isize
        }
        ret result
    }
}
