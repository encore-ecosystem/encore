import refrain::ops::arith::base::*


impl Add[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = add self: i8, other: i8
        }
        ret result
    }
}

impl Sub[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = sub self: i8, other: i8
        }
        ret result
    }
}

impl Mul[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = mul self: i8, other: i8
        }
        ret result
    }
}

impl Div[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = div self: i8, other: i8
        }
        ret result
    }
}
