import refrain::ops::arith::base::*


impl Add[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = add self: i64, other: i64
        }
        ret result
    }
}

impl Sub[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = sub self: i64, other: i64
        }
        ret result
    }
}

impl Mul[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = mul self: i64, other: i64
        }
        ret result
    }
}

impl Div[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = div self: i64, other: i64
        }
        ret result
    }
}
