import refrain::ops::arith::base::*


impl Add[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = add self: i32, other: i32
        }
        ret result
    }
}

impl Sub[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = sub self: i32, other: i32
        }
        ret result
    }
}

impl Mul[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = mul self: i32, other: i32
        }
        ret result
    }
}

impl Div[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = div self: i32, other: i32
        }
        ret result
    }
}
