import refrain::ops::arith::base::*


impl Add[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = add self: i16, other: i16
        }
        ret result
    }
}

impl Sub[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = sub self: i16, other: i16
        }
        ret result
    }
}

impl Mul[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = mul self: i16, other: i16
        }
        ret result
    }
}

impl Div[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = div self: i16, other: i16
        }
        ret result
    }
}
