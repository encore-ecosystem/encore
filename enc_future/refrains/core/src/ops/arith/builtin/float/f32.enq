
import refrain::ops::arith::base::*


impl Add[f32] for f32 {
    pub fn op(self: f32, other: f32) -> f32 {
        ehir {
            result: f32 = add self: f32, other: f32
        }
        ret result
    }
}

impl Sub[f32] for f32 {
    pub fn op(self: f32, other: f32) -> f32 {
        ehir {
            result: f32 = sub self: f32, other: f32
        }
        ret result
    }
}

impl Mul[f32] for f32 {
    pub fn op(self: f32, other: f32) -> f32 {
        ehir {
            result: f32 = mul self: f32, other: f32
        }
        ret result
    }
}

impl Div[f32] for f32 {
    pub fn op(self: f32, other: f32) -> f32 {
        ehir {
            result: f32 = div self: f32, other: f32
        }
        ret result
    }
}
