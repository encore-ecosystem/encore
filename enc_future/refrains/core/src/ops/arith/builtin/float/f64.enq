import refrain::ops::arith::base::*


impl Add[f64] for f64 {
    pub fn op(self: f64, other: f64) -> f64 {
        ehir {
            result: f64 = add self: f64, other: f64
        }
        ret result
    }
}

impl Sub[f64] for f64 {
    pub fn op(self: f64, other: f64) -> f64 {
        ehir {
            result: f64 = sub self: f64, other: f64
        }
        ret result
    }
}

impl Mul[f64] for f64 {
    pub fn op(self: f64, other: f64) -> f64 {
        ehir {
            result: f64 = mul self: f64, other: f64
        }
        ret result
    }
}

impl Div[f64] for f64 {
    pub fn op(self: f64, other: f64) -> f64 {
        ehir {
            result: f64 = div self: f64, other: f64
        }
        ret result
    }
}
