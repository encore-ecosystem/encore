pub trait Add[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Sub[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Mul[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Div[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Rem[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}
