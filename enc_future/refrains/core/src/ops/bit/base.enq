pub trait BitAnd[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait BitOr[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait BitXor[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Shl[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Shr[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}
