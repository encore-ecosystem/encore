import refrain::ops::bit::base::*


impl Shl[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = shl self: usize, other: usize
        }
        ret result
    }
}

impl Shr[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = shr self: usize, other: usize
        }
        ret result
    }
}

impl BitAnd[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = and self: usize, other: usize
        }
        ret result
    }
}

impl BitOr[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = or self: usize, other: usize
        }
        ret result
    }
}

impl BitXor[usize] for usize {
    pub fn op(self: usize, other: usize) -> usize {
        ehir {
            result: usize = xor self: usize, other: usize
        }
        ret result
    }
}
