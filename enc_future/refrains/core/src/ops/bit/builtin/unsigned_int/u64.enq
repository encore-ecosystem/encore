import refrain::ops::bit::base::*


impl Shl[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = shl self: u64, other: u64
        }
        ret result
    }
}

impl Shr[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = shr self: u64, other: u64
        }
        ret result
    }
}

impl BitAnd[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = and self: u64, other: u64
        }
        ret result
    }
}

impl BitOr[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = or self: u64, other: u64
        }
        ret result
    }
}

impl BitXor[u64] for u64 {
    pub fn op(self: u64, other: u64) -> u64 {
        ehir {
            result: u64 = xor self: u64, other: u64
        }
        ret result
    }
}
