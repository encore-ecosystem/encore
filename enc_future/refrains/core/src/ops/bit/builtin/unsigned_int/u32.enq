import refrain::ops::bit::base::*


impl Shl[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = shl self: u32, other: u32
        }
        ret result
    }
}

impl Shr[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = shr self: u32, other: u32
        }
        ret result
    }
}

impl BitAnd[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = and self: u32, other: u32
        }
        ret result
    }
}

impl BitOr[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = or self: u32, other: u32
        }
        ret result
    }
}

impl BitXor[u32] for u32 {
    pub fn op(self: u32, other: u32) -> u32 {
        ehir {
            result: u32 = xor self: u32, other: u32
        }
        ret result
    }
}
