import refrain::ops::bit::base::*


impl Shl[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = shl self: u16, other: u16
        }
        ret result
    }
}

impl Shr[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = shr self: u16, other: u16
        }
        ret result
    }
}

impl BitAnd[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = and self: u16, other: u16
        }
        ret result
    }
}

impl BitOr[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = or self: u16, other: u16
        }
        ret result
    }
}

impl BitXor[u16] for u16 {
    pub fn op(self: u16, other: u16) -> u16 {
        ehir {
            result: u16 = xor self: u16, other: u16
        }
        ret result
    }
}
