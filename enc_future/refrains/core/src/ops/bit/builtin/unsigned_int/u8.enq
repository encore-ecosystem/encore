import refrain::ops::bit::base::*


impl Shl[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = shl self: u8, other: u8
        }
        ret result
    }
}

impl Shr[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = shr self: u8, other: u8
        }
        ret result
    }
}

impl BitAnd[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = and self: u8, other: u8
        }
        ret result
    }
}

impl BitOr[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = or self: u8, other: u8
        }
        ret result
    }
}

impl BitXor[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = xor self: u8, other: u8
        }
        ret result
    }
}
