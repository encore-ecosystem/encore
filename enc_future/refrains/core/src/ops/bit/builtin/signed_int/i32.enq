import refrain::ops::bit::base::*


impl Shl[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = shl self: i32, other: i32
        }
        ret result
    }
}

impl Shr[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = shr self: i32, other: i32
        }
        ret result
    }
}

impl BitAnd[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = and self: i32, other: i32
        }
        ret result
    }
}

impl BitOr[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = or self: i32, other: i32
        }
        ret result
    }
}

impl BitXor[i32] for i32 {
    pub fn op(self: i32, other: i32) -> i32 {
        ehir {
            result: i32 = xor self: i32, other: i32
        }
        ret result
    }
}
