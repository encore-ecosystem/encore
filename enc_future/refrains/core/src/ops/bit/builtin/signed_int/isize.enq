import refrain::ops::bit::base::*


impl Shl[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = shl self: isize, other: isize
        }
        ret result
    }
}

impl Shr[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = shr self: isize, other: isize
        }
        ret result
    }
}

impl BitAnd[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = and self: isize, other: isize
        }
        ret result
    }
}

impl BitOr[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = or self: isize, other: isize
        }
        ret result
    }
}

impl BitXor[isize] for isize {
    pub fn op(self: isize, other: isize) -> isize {
        ehir {
            result: isize = xor self: isize, other: isize
        }
        ret result
    }
}
