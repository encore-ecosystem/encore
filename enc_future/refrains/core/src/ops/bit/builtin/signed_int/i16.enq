import refrain::ops::bit::base::*


impl Shl[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = shl self: i16, other: i16
        }
        ret result
    }
}

impl Shr[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = shr self: i16, other: i16
        }
        ret result
    }
}

impl BitAnd[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = and self: i16, other: i16
        }
        ret result
    }
}

impl BitOr[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = or self: i16, other: i16
        }
        ret result
    }
}

impl BitXor[i16] for i16 {
    pub fn op(self: i16, other: i16) -> i16 {
        ehir {
            result: i16 = xor self: i16, other: i16
        }
        ret result
    }
}
