import refrain::ops::bit::base::*


impl Shl[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = shl self: i64, other: i64
        }
        ret result
    }
}

impl Shr[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = shr self: i64, other: i64
        }
        ret result
    }
}

impl BitAnd[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = and self: i64, other: i64
        }
        ret result
    }
}

impl BitOr[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = or self: i64, other: i64
        }
        ret result
    }
}

impl BitXor[i64] for i64 {
    pub fn op(self: i64, other: i64) -> i64 {
        ehir {
            result: i64 = xor self: i64, other: i64
        }
        ret result
    }
}
