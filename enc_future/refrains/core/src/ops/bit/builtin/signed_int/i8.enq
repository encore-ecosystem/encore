import refrain::ops::bit::base::*


impl Shl[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = shl self: i8, other: i8
        }
        ret result
    }
}

impl Shr[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = shr self: i8, other: i8
        }
        ret result
    }
}

impl BitAnd[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = and self: i8, other: i8
        }
        ret result
    }
}

impl BitOr[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = or self: i8, other: i8
        }
        ret result
    }
}

impl BitXor[i8] for i8 {
    pub fn op(self: i8, other: i8) -> i8 {
        ehir {
            result: i8 = xor self: i8, other: i8
        }
        ret result
    }
}
