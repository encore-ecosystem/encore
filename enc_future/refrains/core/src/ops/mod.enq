pub trait Add[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Sub[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Mul[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Div[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Rem[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait BitAnd[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait BitOr[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait BitXor[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Shl[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

pub trait Shr[Rhs] {
    fn op(self: Self, other: Rhs) -> Self
}

impl Add[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
            result: u8 = add self: u8, other: u8
        }
        ret result
    }
}

impl Sub[u8] for u8 {
    pub fn op(self: u8, other: u8) -> u8 {
        ehir {
