fn explode() -> bool {
    let one: u32 = 1_u32
    let zero: u32 = 0_u32
    let crash: u32 = one / zero
    ret crash == 0_u32
}

fn main() -> u32 {
    let lhs_false: bool = false
    let lhs_true: bool = true

    let and_value: bool = lhs_false && explode()
    let or_value: bool = lhs_true || explode()

    if (and_value) {
        ret 1_u32
    }
    if (or_value) {
        ret 0_u32
    }
    ret 2_u32
}
