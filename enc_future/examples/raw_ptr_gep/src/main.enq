struct Pair {
    a: u32
    b: u32
}

fn main() -> u32 {
    let pair: mut Pair = Pair{1_u32, 2_u32}
    pair.b = 7_u32

    ret unsafe {
        unsafe ehir {
            base: u32* = halloc u32
            value: u32 = lcpos 11_u32
            store value: u32, base: u32*
            idx: usize = lcpos 0_usize
            elem_ptr: u32* = gep base: u32*, idx: usize
            elem: u32 = load elem_ptr: u32*
        }
        elem
    }
}
