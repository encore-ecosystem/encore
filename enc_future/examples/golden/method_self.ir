; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

%Counter = type { i32 }

define i32 @main() {
entry:
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.c_0_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.c_0_ptr = bitcast ptr %.salloc_.c_0_ptr to ptr
  store i32 5, ptr %.c_0_ptr, align 4
  %c_0 = load i32, ptr %.c_0_ptr, align 4
  %.sizeof_Counter_ptr = getelementptr %Counter, ptr null, i32 1
  %.sizeof_Counter_ = ptrtoint ptr %.sizeof_Counter_ptr to i64
  %.salloc_.c_ptr = alloca i8, i64 %.sizeof_Counter_, align 1
  %.c_ptr = bitcast ptr %.salloc_.c_ptr to ptr
  %..c_ptr.c_0 = getelementptr %Counter, ptr %.c_ptr, i32 0, i32 0
  store i32 %c_0, ptr %..c_ptr.c_0, align 4
  %c = load %Counter, ptr %.c_ptr, align 4
  %out = call i32 @"Counter::get"(%Counter %c)
  %.sizeof_u32_ptr.1 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.1 = ptrtoint ptr %.sizeof_u32_ptr.1 to i64
  %.salloc_._0_ptr = alloca i8, i64 %.sizeof_u32_.1, align 1
  %._0_ptr = bitcast ptr %.salloc_._0_ptr to ptr
  store i32 0, ptr %._0_ptr, align 4
  %_0 = load i32, ptr %._0_ptr, align 4
  %.sizeof_u32_ptr.2 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.2 = ptrtoint ptr %.sizeof_u32_ptr.2 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_.2, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %_0, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}

define i32 @"Counter::get"(%Counter %self.1) {
entry:
  %.5 = alloca %Counter, align 8
  store %Counter %self.1, ptr %.5, align 4
  %.ret_1_ptr = getelementptr %Counter, ptr %.5, i32 0, i32 0
  %ret_1 = load i32, ptr %.ret_1_ptr, align 4
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %ret_1, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}
