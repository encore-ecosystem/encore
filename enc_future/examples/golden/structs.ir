; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

%Vector2D = type { i32, i32 }

define i32 @main() {
entry:
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.a_0_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.a_0_ptr = bitcast ptr %.salloc_.a_0_ptr to ptr
  store i32 5, ptr %.a_0_ptr, align 4
  %a_0 = load i32, ptr %.a_0_ptr, align 4
  %.sizeof_u32_ptr.1 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.1 = ptrtoint ptr %.sizeof_u32_ptr.1 to i64
  %.salloc_.a_1_ptr = alloca i8, i64 %.sizeof_u32_.1, align 1
  %.a_1_ptr = bitcast ptr %.salloc_.a_1_ptr to ptr
  store i32 2, ptr %.a_1_ptr, align 4
  %a_1 = load i32, ptr %.a_1_ptr, align 4
  %.sizeof_Vector2D_ptr = getelementptr %Vector2D, ptr null, i32 1
  %.sizeof_Vector2D_ = ptrtoint ptr %.sizeof_Vector2D_ptr to i64
  %.salloc_.a_ptr = alloca i8, i64 %.sizeof_Vector2D_, align 1
  %.a_ptr = bitcast ptr %.salloc_.a_ptr to ptr
  %..a_ptr.a_0 = getelementptr %Vector2D, ptr %.a_ptr, i32 0, i32 0
  store i32 %a_0, ptr %..a_ptr.a_0, align 4
  %..a_ptr.a_1 = getelementptr %Vector2D, ptr %.a_ptr, i32 0, i32 1
  store i32 %a_1, ptr %..a_ptr.a_1, align 4
  %a = load %Vector2D, ptr %.a_ptr, align 4
  %b = call %Vector2D @vector_add(%Vector2D %a, %Vector2D %a)
  %.34 = alloca %Vector2D, align 8
  store %Vector2D %b, ptr %.34, align 4
  %.ret_6_ptr = getelementptr %Vector2D, ptr %.34, i32 0, i32 0
  %ret_6 = load i32, ptr %.ret_6_ptr, align 4
  %.40 = alloca %Vector2D, align 8
  store %Vector2D %b, ptr %.40, align 4
  %.ret_7_ptr = getelementptr %Vector2D, ptr %.40, i32 0, i32 1
  %ret_7 = load i32, ptr %.ret_7_ptr, align 4
  %_2 = add i32 %ret_6, %ret_7
  %.sizeof_u32_ptr.2 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.2 = ptrtoint ptr %.sizeof_u32_ptr.2 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_.2, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %_2, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}

define %Vector2D @vector_add(%Vector2D %a.1, %Vector2D %b.1) {
entry:
  %.6 = alloca %Vector2D, align 8
  store %Vector2D %a.1, ptr %.6, align 4
  %.ret_1_ptr = getelementptr %Vector2D, ptr %.6, i32 0, i32 0
  %ret_1 = load i32, ptr %.ret_1_ptr, align 4
  %.12 = alloca %Vector2D, align 8
  store %Vector2D %b.1, ptr %.12, align 4
  %.ret_2_ptr = getelementptr %Vector2D, ptr %.12, i32 0, i32 0
  %ret_2 = load i32, ptr %.ret_2_ptr, align 4
  %_0 = add i32 %ret_1, %ret_2
  %.20 = alloca %Vector2D, align 8
  store %Vector2D %a.1, ptr %.20, align 4
  %.ret_3_ptr = getelementptr %Vector2D, ptr %.20, i32 0, i32 1
  %ret_3 = load i32, ptr %.ret_3_ptr, align 4
  %.26 = alloca %Vector2D, align 8
  store %Vector2D %b.1, ptr %.26, align 4
  %.ret_4_ptr = getelementptr %Vector2D, ptr %.26, i32 0, i32 1
  %ret_4 = load i32, ptr %.ret_4_ptr, align 4
  %_1 = add i32 %ret_3, %ret_4
  %.sizeof_Vector2D_ptr = getelementptr %Vector2D, ptr null, i32 1
  %.sizeof_Vector2D_ = ptrtoint ptr %.sizeof_Vector2D_ptr to i64
  %.salloc_.ret_5_ptr = alloca i8, i64 %.sizeof_Vector2D_, align 1
  %.ret_5_ptr = bitcast ptr %.salloc_.ret_5_ptr to ptr
  %..ret_5_ptr._0 = getelementptr %Vector2D, ptr %.ret_5_ptr, i32 0, i32 0
  store i32 %_0, ptr %..ret_5_ptr._0, align 4
  %..ret_5_ptr._1 = getelementptr %Vector2D, ptr %.ret_5_ptr, i32 0, i32 1
  store i32 %_1, ptr %..ret_5_ptr._1, align 4
  %ret_5 = load %Vector2D, ptr %.ret_5_ptr, align 4
  %.sizeof_Vector2D_ptr.1 = getelementptr %Vector2D, ptr null, i32 1
  %.sizeof_Vector2D_.1 = ptrtoint ptr %.sizeof_Vector2D_ptr.1 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_Vector2D_.1, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store %Vector2D %ret_5, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load %Vector2D, ptr %.exit_var_ptr, align 4
  ret %Vector2D %.exit_var
}
