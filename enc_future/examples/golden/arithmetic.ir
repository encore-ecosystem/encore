; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

define i32 @main() {
entry:
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_._2_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %._2_ptr = bitcast ptr %.salloc_._2_ptr to ptr
  store i32 6, ptr %._2_ptr, align 4
  %_2 = load i32, ptr %._2_ptr, align 4
  %.sizeof_u32_ptr.1 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.1 = ptrtoint ptr %.sizeof_u32_ptr.1 to i64
  %.salloc_._3_ptr = alloca i8, i64 %.sizeof_u32_.1, align 1
  %._3_ptr = bitcast ptr %.salloc_._3_ptr to ptr
  store i32 7, ptr %._3_ptr, align 4
  %_3 = load i32, ptr %._3_ptr, align 4
  %.sizeof_u32_ptr.2 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.2 = ptrtoint ptr %.sizeof_u32_ptr.2 to i64
  %.salloc_._4_ptr = alloca i8, i64 %.sizeof_u32_.2, align 1
  %._4_ptr = bitcast ptr %.salloc_._4_ptr to ptr
  store i32 1, ptr %._4_ptr, align 4
  %_4 = load i32, ptr %._4_ptr, align 4
  %value = call i32 @mul_add(i32 %_2, i32 %_3, i32 %_4)
  %.sizeof_u32_ptr.3 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.3 = ptrtoint ptr %.sizeof_u32_ptr.3 to i64
  %.salloc_._5_ptr = alloca i8, i64 %.sizeof_u32_.3, align 1
  %._5_ptr = bitcast ptr %.salloc_._5_ptr to ptr
  store i32 1, ptr %._5_ptr, align 4
  %_5 = load i32, ptr %._5_ptr, align 4
  %_6 = sub i32 %value, %_5
  %.sizeof_u32_ptr.4 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.4 = ptrtoint ptr %.sizeof_u32_ptr.4 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_.4, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %_6, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}

define i32 @mul_add(i32 %a.1, i32 %b.1, i32 %c.1) {
entry:
  %_0 = mul i32 %a.1, %b.1
  %_1 = add i32 %_0, %c.1
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %_1, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}
