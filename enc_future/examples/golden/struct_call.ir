; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

%Vec2 = type { i32, i32 }

define i32 @run() {
entry:
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_._1_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %._1_ptr = bitcast ptr %.salloc_._1_ptr to ptr
  store i32 10, ptr %._1_ptr, align 4
  %_1 = load i32, ptr %._1_ptr, align 4
  %.sizeof_u32_ptr.1 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.1 = ptrtoint ptr %.sizeof_u32_ptr.1 to i64
  %.salloc_._2_ptr = alloca i8, i64 %.sizeof_u32_.1, align 1
  %._2_ptr = bitcast ptr %.salloc_._2_ptr to ptr
  store i32 32, ptr %._2_ptr, align 4
  %_2 = load i32, ptr %._2_ptr, align 4
  %p = call %Vec2 @make_vec(i32 %_1, i32 %_2)
  %_3 = call i32 @sum_coords(%Vec2 %p)
  %.sizeof_u32_ptr.2 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.2 = ptrtoint ptr %.sizeof_u32_ptr.2 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_.2, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %_3, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}

define i32 @sum_coords(%Vec2 %v.1) {
entry:
  %.5 = alloca %Vec2, align 8
  store %Vec2 %v.1, ptr %.5, align 4
  %.ret_2_ptr = getelementptr %Vec2, ptr %.5, i32 0, i32 0
  %ret_2 = load i32, ptr %.ret_2_ptr, align 4
  %.11 = alloca %Vec2, align 8
  store %Vec2 %v.1, ptr %.11, align 4
  %.ret_3_ptr = getelementptr %Vec2, ptr %.11, i32 0, i32 1
  %ret_3 = load i32, ptr %.ret_3_ptr, align 4
  %_0 = add i32 %ret_2, %ret_3
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %_0, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}

define %Vec2 @make_vec(i32 %x.1, i32 %y.1) {
entry:
  %.sizeof_Vec2_ptr = getelementptr %Vec2, ptr null, i32 1
  %.sizeof_Vec2_ = ptrtoint ptr %.sizeof_Vec2_ptr to i64
  %.salloc_.ret_1_ptr = alloca i8, i64 %.sizeof_Vec2_, align 1
  %.ret_1_ptr = bitcast ptr %.salloc_.ret_1_ptr to ptr
  %..ret_1_ptr.x = getelementptr %Vec2, ptr %.ret_1_ptr, i32 0, i32 0
  store i32 %x.1, ptr %..ret_1_ptr.x, align 4
  %..ret_1_ptr.y = getelementptr %Vec2, ptr %.ret_1_ptr, i32 0, i32 1
  store i32 %y.1, ptr %..ret_1_ptr.y, align 4
  %ret_1 = load %Vec2, ptr %.ret_1_ptr, align 4
  %.sizeof_Vec2_ptr.1 = getelementptr %Vec2, ptr null, i32 1
  %.sizeof_Vec2_.1 = ptrtoint ptr %.sizeof_Vec2_ptr.1 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_Vec2_.1, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store %Vec2 %ret_1, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load %Vec2, ptr %.exit_var_ptr, align 4
  ret %Vec2 %.exit_var
}
