; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

define i32 @main() {
entry:
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.value_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.value_ptr = bitcast ptr %.salloc_.value_ptr to ptr
  store i32 40, ptr %.value_ptr, align 4
  %value = load i32, ptr %.value_ptr, align 4
  %.sizeof_u32_ptr.1 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.1 = ptrtoint ptr %.sizeof_u32_ptr.1 to i64
  %.salloc_._0_ptr = alloca i8, i64 %.sizeof_u32_.1, align 1
  %._0_ptr = bitcast ptr %.salloc_._0_ptr to ptr
  store i32 2, ptr %._0_ptr, align 4
  %_0 = load i32, ptr %._0_ptr, align 4
  %value.1 = add i32 %value, %_0
  %.sizeof_u32_ptr.2 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.2 = ptrtoint ptr %.sizeof_u32_ptr.2 to i64
  %.salloc_._1_ptr = alloca i8, i64 %.sizeof_u32_.2, align 1
  %._1_ptr = bitcast ptr %.salloc_._1_ptr to ptr
  store i32 2, ptr %._1_ptr, align 4
  %_1 = load i32, ptr %._1_ptr, align 4
  %value.2 = mul i32 %value.1, %_1
  %.sizeof_u32_ptr.3 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.3 = ptrtoint ptr %.sizeof_u32_ptr.3 to i64
  %.salloc_._2_ptr = alloca i8, i64 %.sizeof_u32_.3, align 1
  %._2_ptr = bitcast ptr %.salloc_._2_ptr to ptr
  store i32 10, ptr %._2_ptr, align 4
  %_2 = load i32, ptr %._2_ptr, align 4
  %value.3 = sub i32 %value.2, %_2
  %.sizeof_u32_ptr.4 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.4 = ptrtoint ptr %.sizeof_u32_ptr.4 to i64
  %.salloc_._3_ptr = alloca i8, i64 %.sizeof_u32_.4, align 1
  %._3_ptr = bitcast ptr %.salloc_._3_ptr to ptr
  store i32 2, ptr %._3_ptr, align 4
  %_3 = load i32, ptr %._3_ptr, align 4
  %value.4 = sdiv i32 %value.3, %_3
  %.sizeof_u32_ptr.5 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.5 = ptrtoint ptr %.sizeof_u32_ptr.5 to i64
  %.salloc_._4_ptr = alloca i8, i64 %.sizeof_u32_.5, align 1
  %._4_ptr = bitcast ptr %.salloc_._4_ptr to ptr
  store i32 10, ptr %._4_ptr, align 4
  %_4 = load i32, ptr %._4_ptr, align 4
  %value.5 = srem i32 %value.4, %_4
  %.sizeof_u32_ptr.6 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.6 = ptrtoint ptr %.sizeof_u32_ptr.6 to i64
  %.salloc_._5_ptr = alloca i8, i64 %.sizeof_u32_.6, align 1
  %._5_ptr = bitcast ptr %.salloc_._5_ptr to ptr
  store i32 2, ptr %._5_ptr, align 4
  %_5 = load i32, ptr %._5_ptr, align 4
  %value.6 = shl i32 %value.5, %_5
  %.sizeof_u32_ptr.7 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.7 = ptrtoint ptr %.sizeof_u32_ptr.7 to i64
  %.salloc_._6_ptr = alloca i8, i64 %.sizeof_u32_.7, align 1
  %._6_ptr = bitcast ptr %.salloc_._6_ptr to ptr
  store i32 1, ptr %._6_ptr, align 4
  %_6 = load i32, ptr %._6_ptr, align 4
  %value.7 = lshr i32 %value.6, %_6
  %.sizeof_u32_ptr.8 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.8 = ptrtoint ptr %.sizeof_u32_ptr.8 to i64
  %.salloc_._7_ptr = alloca i8, i64 %.sizeof_u32_.8, align 1
  %._7_ptr = bitcast ptr %.salloc_._7_ptr to ptr
  store i32 1, ptr %._7_ptr, align 4
  %_7 = load i32, ptr %._7_ptr, align 4
  %value.8 = or i32 %value.7, %_7
  %.sizeof_u32_ptr.9 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.9 = ptrtoint ptr %.sizeof_u32_ptr.9 to i64
  %.salloc_._8_ptr = alloca i8, i64 %.sizeof_u32_.9, align 1
  %._8_ptr = bitcast ptr %.salloc_._8_ptr to ptr
  store i32 14, ptr %._8_ptr, align 4
  %_8 = load i32, ptr %._8_ptr, align 4
  %value.9 = and i32 %value.8, %_8
  %.sizeof_u32_ptr.10 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.10 = ptrtoint ptr %.sizeof_u32_ptr.10 to i64
  %.salloc_._9_ptr = alloca i8, i64 %.sizeof_u32_.10, align 1
  %._9_ptr = bitcast ptr %.salloc_._9_ptr to ptr
  store i32 9, ptr %._9_ptr, align 4
  %_9 = load i32, ptr %._9_ptr, align 4
  %value.10 = xor i32 %value.9, %_9
  %.sizeof_u32_ptr.11 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.11 = ptrtoint ptr %.sizeof_u32_ptr.11 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u32_.11, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i32 %value.10, ptr %.exit_var_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i32, ptr %.exit_var_ptr, align 4
  ret i32 %.exit_var
}
