  %..opponent_1_sgfptr_ptr_ptr = getelementptr %Player_HSP, ptr %.172, i32 0, i32 0
  %.opponent_1_sgfptr_ptr = load ptr, ptr %..opponent_1_sgfptr_ptr_ptr, align 8
  %opponent_1 = getelementptr %Player, ptr %.opponent_1_sgfptr_ptr, i32 0, i32 1
  %.sizeof_Option_Player_H_ptr.2 = getelementptr %Option_Player_H, ptr null, i32 1
  %.sizeof_Option_Player_H_.2 = ptrtoint ptr %.sizeof_Option_Player_H_ptr.2 to i64
  %.salloc_.opponent_2_ptr = alloca i8, i64 %.sizeof_Option_Player_H_.2, align 1
  %.opponent_2_ptr = bitcast ptr %.salloc_.opponent_2_ptr to ptr
  %.sizeof_u8_ptr.2 = getelementptr i8, ptr null, i32 1
  %.sizeof_u8_.2 = ptrtoint ptr %.sizeof_u8_ptr.2 to i64
  %.salloc_...opponent_2_ptr_tag_ptr = alloca i8, i64 %.sizeof_u8_.2, align 1
  store i8 0, ptr %.salloc_...opponent_2_ptr_tag_ptr, align 1
  %..opponent_2_ptr_tag = load i8, ptr %.salloc_...opponent_2_ptr_tag_ptr, align 1
  %..opponent_2_ptr_tag_ptr = getelementptr %Option_Player_H, ptr %.opponent_2_ptr, i32 0, i32 0
  store i8 %..opponent_2_ptr_tag, ptr %..opponent_2_ptr_tag_ptr, align 1
  %.sizeof_Player_ptr.3 = getelementptr %Player_HSP, ptr null, i32 1
  %.sizeof_Player_.3 = ptrtoint ptr %.sizeof_Player_ptr.3 to i64
  %.salloc_..opponent_2_ptr_Some_payload = alloca i8, i64 %.sizeof_Player_.3, align 1
  %..opponent_2_ptr_Some_payload = bitcast ptr %.salloc_..opponent_2_ptr_Some_payload to ptr
  store %Player_HSP %p2, ptr %..opponent_2_ptr_Some_payload, align 8
  %..opponent_2_ptr_Some_field_ptr = getelementptr %Option_Player_H, ptr %.opponent_2_ptr, i32 0, i32 1
  store ptr %..opponent_2_ptr_Some_payload, ptr %..opponent_2_ptr_Some_field_ptr, align 8
  %opponent_2 = load %Option_Player_H, ptr %.opponent_2_ptr, align 8
  store %Option_Player_H %opponent_2, ptr %opponent_1, align 8
  %.209 = alloca %Player_HSP, align 8
  store %Player_HSP %p1, ptr %.209, align 8
  %.._0_sgf_ptr_ptr = getelementptr %Player_HSP, ptr %.209, i32 0, i32 0
  %._0_sgf_ptr = load ptr, ptr %.._0_sgf_ptr_ptr, align 8
  %._0_ptr = getelementptr %Player, ptr %._0_sgf_ptr, i32 0, i32 0
  %_0 = load i16, ptr %._0_ptr, align 2
  %.219 = alloca %Player_HSP, align 8
  store %Player_HSP %p2, ptr %.219, align 8
  %.._1_sgf_ptr_ptr = getelementptr %Player_HSP, ptr %.219, i32 0, i32 0
  %._1_sgf_ptr = load ptr, ptr %.._1_sgf_ptr_ptr, align 8
  %._1_ptr = getelementptr %Player, ptr %._1_sgf_ptr, i32 0, i32 0
  %_1 = load i16, ptr %._1_ptr, align 2
  %_2 = call i16 @sum_u16(i16 %_0, i16 %_1)
  %.sizeof_u16_ptr.2 = getelementptr i16, ptr null, i32 1
  %.sizeof_u16_.2 = ptrtoint ptr %.sizeof_u16_ptr.2 to i64
  %.salloc_.exit_var_ptr = alloca i8, i64 %.sizeof_u16_.2, align 1
  %.exit_var_ptr = bitcast ptr %.salloc_.exit_var_ptr to ptr
  store i16 %_2, ptr %.exit_var_ptr, align 2
  %.sizeof_u1_ptr.8 = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_.8 = ptrtoint ptr %.sizeof_u1_ptr.8 to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_.8, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %exit [
  ]

exit:                                             ; preds = %entry
  %.exit_var = load i16, ptr %.exit_var_ptr, align 2
  %.sizeof_usize_ptr.2 = getelementptr i64, ptr null, i32 1
  %.sizeof_usize_.2 = ptrtoint ptr %.sizeof_usize_ptr.2 to i64
  %.salloc_..cfree_mode_ptr = alloca i8, i64 %.sizeof_usize_.2, align 1
  %..cfree_mode_ptr = bitcast ptr %.salloc_..cfree_mode_ptr to ptr
  store i64 0, ptr %..cfree_mode_ptr, align 4
  %.cfree_mode = load i64, ptr %..cfree_mode_ptr, align 4
  %.cfree_out = call i64 @cfree_Player_HSP(%Player_HSP %p2, i64 %.cfree_mode)
  ret i16 %.exit_var
}

