; ModuleID = '<string>'
source_filename = "<string>"
target triple = "unknown-unknown-unknown"

define i32 @main() {
entry:
  %.sizeof_u32_ptr = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_ = ptrtoint ptr %.sizeof_u32_ptr to i64
  %.salloc_.a_ptr = alloca i8, i64 %.sizeof_u32_, align 1
  %.a_ptr = bitcast ptr %.salloc_.a_ptr to ptr
  store i32 0, ptr %.a_ptr, align 4
  %a = load i32, ptr %.a_ptr, align 4
  %.sizeof_u1_ptr = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_ = ptrtoint ptr %.sizeof_u1_ptr to i64
  %.salloc_.br_zero_ptr = alloca i8, i64 %.sizeof_u1_, align 1
  %.br_zero_ptr = bitcast ptr %.salloc_.br_zero_ptr to ptr
  store i1 false, ptr %.br_zero_ptr, align 1
  %.br_zero = load i1, ptr %.br_zero_ptr, align 1
  switch i1 %.br_zero, label %do_while_body_0 [
  ]

do_while_body_0:                                  ; preds = %do_while_cond_0, %entry
  %a_phi_0 = phi i32 [ %a, %entry ], [ %a_next_0, %do_while_cond_0 ]
  %.sizeof_u32_ptr.1 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.1 = ptrtoint ptr %.sizeof_u32_ptr.1 to i64
  %.salloc_._0_ptr = alloca i8, i64 %.sizeof_u32_.1, align 1
  %._0_ptr = bitcast ptr %.salloc_._0_ptr to ptr
  store i32 2, ptr %._0_ptr, align 4
  %_0 = load i32, ptr %._0_ptr, align 4
  %a_next_0 = add i32 %a_phi_0, %_0
  %.sizeof_u1_ptr.1 = getelementptr i1, ptr null, i32 1
  %.sizeof_u1_.1 = ptrtoint ptr %.sizeof_u1_ptr.1 to i64
  %.salloc_.br_zero_ptr.1 = alloca i8, i64 %.sizeof_u1_.1, align 1
  %.br_zero_ptr.1 = bitcast ptr %.salloc_.br_zero_ptr.1 to ptr
  store i1 false, ptr %.br_zero_ptr.1, align 1
  %.br_zero.1 = load i1, ptr %.br_zero_ptr.1, align 1
  switch i1 %.br_zero.1, label %do_while_cond_0 [
  ]

do_while_cond_0:                                  ; preds = %do_while_body_0
  %.sizeof_u32_ptr.2 = getelementptr i32, ptr null, i32 1
  %.sizeof_u32_.2 = ptrtoint ptr %.sizeof_u32_ptr.2 to i64
  %.salloc_._1_ptr = alloca i8, i64 %.sizeof_u32_.2, align 1
  %._1_ptr = bitcast ptr %.salloc_._1_ptr to ptr
  store i32 62, ptr %._1_ptr, align 4
  %_1 = load i32, ptr %._1_ptr, align 4
  %_2 = icmp slt i32 %a_next_0, %_1
  switch i1 %_2, label %do_while_end_0 [
    i1 true, label %do_while_body_0
  ]

do_while_end_0:                                   ; preds = %do_while_cond_0
  ret i32 %a_next_0
}
