import core::ops::Add

struct Vector3D[T] {
    x: T
    y: T
    z: T
}

impl[T] for Vector3D[T] {
    pub fn new(x: T, y: T, z: T) -> Vector3D[T] {
        ret Vector3D[T]{x, y, z}
    }
}

impl Add[Vector3D[u32]] for Vector3D[u32] {
    pub fn op(self: Vector3D[u32], other: Vector3D[u32]) -> Vector3D[u32] {
        ret Vector3D[u32]::new(self.x + other.x, self.y + other.y, self.z + other.z)
    }
}

fn main() -> u32 {
    let a = Vector3D[u32]::new(1, 2, 3)
    let b = Vector3D[u32]::new(3, 2, 1)
    let c = a + b
    ret c.x + c.y + c.z
}
