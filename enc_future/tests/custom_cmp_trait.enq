import core::testing::*

struct Score {
    value: u32
}

impl Eq[Score] for Score {
    pub fn op(self: Score, other: Score) -> bool {
        ret self.value == other.value
    }
}

impl Lt[Score] for Score {
    pub fn op(self: Score, other: Score) -> bool {
        ret self.value < other.value
    }
}

fn main() -> u32 {
    let a = Score{7_u32}
    let b = Score{7_u32}
    let c = Score{10_u32}

    if !assert(a == b) {
        ret 1_u32
    }
    if !assert(a < c) {
        ret 1_u32
    }
    if a == c {
        ret 1_u32
    }

    ret 0_u32
}
