import core::testing::*
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
import refrain::frontend::translator::translate_module
import std::string::len


fn main() -> u32 {
    let source = "struct Pair { lhs: u32, rhs: u32 } fn sum(pair: Pair) -> u32 { ret pair.lhs + pair.rhs } fn main() -> u32 { let pair = Pair{1_u32, 2_u32} ret sum(pair) }"

    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(source)

    let mut parser = Parser::new()
    let ast = parser.parse(tokens)

    let text: str = translate_module("sample", ast)

    if !assert(len(text) > 0_usize) {
        ret 1_u32
    }

    ret 0_u32
}
