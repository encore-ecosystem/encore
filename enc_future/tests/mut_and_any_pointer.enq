import core::testing::*

struct Node {
    value: u32
}

fn get_val(node: Node&) -> u32 {
    ret node.value
}

fn main() -> u32 {
    let mut a: u32 = 1_u32
    a = a + 2_u32

    let heap_node: Node& = Node<H>{5_u32}
    let stack_node: Node& = Node<S>{10_u32}
    let result: u32 = a + get_val(heap_node) + get_val(stack_node)

    if !assert(result == 18_u32) {
        ret 1_u32
    }
    ret 0_u32
}
