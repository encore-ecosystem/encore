import std::vec
import std::option::Option

fn main() -> u32 {
    let values = vec::Vec[u32]::new().push(7_u32)
    let value = match values.get(0_usize) {
        Option[u32]::Some(v) => {
            v
        }
        _ => {
            0_u32
        }
    }
    if value == 7_u32 {
        ret 0_u32
    }
    ret 1_u32
}
