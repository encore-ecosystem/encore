import mod::parser::statements::*

import core::option::Option
import std::vec::Vec


pub struct FunctionInfo {
    name: str
    generics: Vec[str]
    params: Vec[FunctionParam]
    ret_type: str
}

pub struct StructInfo {
    name: str
    fields: Vec[NamedField]
    tuple_fields: Vec[str]
}

pub struct LocalBinding {
    name: str
    typ: str
    is_mut: bool
}

pub struct TypeInfer {
    functions: Vec[FunctionInfo]
    structs: Vec[StructInfo]
    errors: Vec[str]
}


pub fn infer_program(ast: Vec[Statement]) -> () {
    let mut infer = TypeInfer::new()
    infer.collect_declarations(ast)
    infer.infer_items(ast)
    ret ()
}

impl for TypeInfer {
    pub fn new() -> TypeInfer {
        ret TypeInfer{
            Vec[FunctionInfo]::new(),
            Vec[StructInfo]::new(),
            Vec[str]::new()
        }
    }

    fn collect_declarations(mut self, ast: Vec[Statement]) -> () {
        let mut index = 0_usize
        loop {
            match ast.get(index) {
                Some(item) => {
                    match item {
                        Statement::Function(fn_item) => {
                            self.functions = self.functions.push(
                                FunctionInfo{
                                    fn_item.name,
                                    fn_item.generics,
                                    fn_item.params,
                                    self.unwrap_ret_type(fn_item.ret_type)
                                }
                            )
                        }
                        Statement::Struct(si) => {
                            self.structs = self.structs.push(
                                StructInfo{si.name, si.named_fields, si.tuple_fields}
                            )
                        }
                        _ => {}
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret ()
    }

    fn infer_items(mut self, ast: Vec[Statement]) -> () {
        let mut index = 0_usize
        loop {
            match ast.get(index) {
                Some(item) => {
                    match item {
                        Statement::Function(fn_item) => {
                            self.infer_function(fn_item)
                        }
                        Statement::Impl(impl_item) => {
                            self.infer_impl(impl_item)
                        }
                        _ => {}
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret ()
    }

    fn infer_impl(mut self, impl_item: ImplStmt) -> () {
        let mut index = 0_usize
        loop {
            match impl_item.methods.get(index) {
                Some(fn_item) => {
                    self.infer_function(fn_item)
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret ()
    }

    fn infer_function(mut self, fn_item: FunctionItem) -> () {
        match fn_item.body {
            Some(body) => {
                let mut env = Vec[LocalBinding]::new()
                let mut pidx = 0_usize
                loop {
                    match fn_item.params.get(pidx) {
                        Some(param) => {
                            let typ = self.unwrap_opt_type(param.typ, "unknown")
                            env = env.push(LocalBinding{param.name, typ, true})
                            pidx = pidx + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }

                let fn_ret = self.unwrap_ret_type(fn_item.ret_type)
                self.infer_block(body, env, fn_ret)
            }
            None => {}
        }
        ret ()
    }

    fn infer_block(mut self, block: Block, env: Vec[LocalBinding], fn_ret: str) -> Vec[LocalBinding] {
        let mut local_env = env
        let mut index = 0_usize
        loop {
            match block.statements.get(index) {
                Some(stmt) => {
                    local_env = self.infer_statement(stmt, local_env, fn_ret)
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret local_env
    }

    fn infer_statement(mut self, stmt: Statement, env: Vec[LocalBinding], fn_ret: str) -> Vec[LocalBinding] {
        let mut next_env = env
        match stmt {
            Statement::Let(let_stmt) => {
                let inferred = self.infer_expr(let_stmt.expr, next_env)
                let explicit = self.unwrap_opt_type(let_stmt.typ, "")
                let final_type = if explicit == "" { inferred } else { explicit }
                if explicit != "" && inferred != "unknown" && explicit != inferred {
                    self.push_error("let type mismatch: explicit type differs from expression type")
                }
                next_env = self.upsert_binding(next_env, let_stmt.name, final_type, let_stmt.is_mut)
            }
            Statement::Assignment(assign_stmt) => {
                let lhs = self.infer_lvalue(assign_stmt.target, next_env)
                let rhs = self.infer_expr(assign_stmt.expr, next_env)
                if lhs != "unknown" && rhs != "unknown" && lhs != rhs {
                    self.push_error("assignment type mismatch")
                }
            }
            Statement::Ret(expr) => {
                let res = self.infer_expr(expr, next_env)
                if fn_ret != "()" && res != "unknown" && res != fn_ret {
                    self.push_error("return type mismatch")
                }
            }
            Statement::Expr(expr) => {
                self.infer_expr(expr, next_env)
            }
            Statement::If(if_stmt) => {
                let mut if_branch_idx = 0_usize
                loop {
                    match if_stmt.branches.get(if_branch_idx) {
                        Some(br) => {
                            let if_cond_t = self.infer_expr(br.condition, next_env)
                            if if_cond_t != "bool" && if_cond_t != "unknown" {
                                self.push_error("if condition must be bool")
                            }
                            self.infer_block(br.body, next_env, fn_ret)
                            if_branch_idx = if_branch_idx + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }
                match if_stmt.else_body {
                    Some(body) => {
                        self.infer_block(body, next_env, fn_ret)
                    }
                    None => {}
                }
            }
            Statement::While(while_stmt) => {
                let while_cond_t = self.infer_expr(while_stmt.condition, next_env)
                if while_cond_t != "bool" && while_cond_t != "unknown" {
                    self.push_error("while condition must be bool")
                }
                self.infer_block(while_stmt.body, next_env, fn_ret)
            }
            Statement::Loop(loop_stmt) => {
                self.infer_block(loop_stmt.body, next_env, fn_ret)
            }
            Statement::DoWhile(dw) => {
                self.infer_block(dw.body, next_env, fn_ret)
                let dowhile_cond_t = self.infer_expr(dw.condition, next_env)
                if dowhile_cond_t != "bool" && dowhile_cond_t != "unknown" {
                    self.push_error("do-while condition must be bool")
                }
            }
            Statement::Unsafe(block) => {
                self.infer_block(block, next_env, fn_ret)
            }
            Statement::Match(match_stmt) => {
                self.infer_expr(match_stmt.expr, next_env)
                let mut match_arm_idx = 0_usize
                loop {
                    match match_stmt.arms.get(match_arm_idx) {
                        Some(arm) => {
                            match arm.body {
                                MatchArmBody::Block(block) => {
                                    self.infer_block(block, next_env, fn_ret)
                                }
                                MatchArmBody::Expr(expr) => {
                                    self.infer_expr(expr, next_env)
                                }
                            }
                            match_arm_idx = match_arm_idx + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }
            }
            _ => {}
        }
        ret next_env
    }

    fn infer_expr(mut self, expr: ExprNode, env: Vec[LocalBinding]) -> str {
        match expr.value {
            Expr::Path(path) => {
                ret self.lookup_binding_type(env, path)
            }
            Expr::Boolean(_) => { ret "bool" }
            Expr::Integer(raw) => { ret infer_integer_type(raw) }
            Expr::Float(raw) => { ret infer_float_type(raw) }
            Expr::StringLiteral(_) => { ret "str" }
            Expr::Parenthesized(paren_expr) => {
                ret self.infer_expr_boxed(paren_expr, env)
            }
            Expr::Unary(unary_expr) => {
                let inner = self.infer_expr_boxed(unary_expr.expr, env)
                if unary_expr.operator == "!" {
                    if inner != "bool" && inner != "unknown" {
                        self.push_error("unary ! expects bool")
                    }
                    ret "bool"
                }
                ret inner
            }
            Expr::Binary(binary_expr) => {
                let lhs = self.infer_expr_boxed(binary_expr.lhs, env)
                let rhs = self.infer_expr_boxed(binary_expr.rhs, env)
                if lhs != "unknown" && rhs != "unknown" && lhs != rhs {
                    self.push_error("binary operand type mismatch")
                    ret "unknown"
                }
                if is_compare_op(binary_expr.operator) {
                    ret "bool"
                }
                if binary_expr.operator == "&&" || binary_expr.operator == "||" {
                    if lhs != "bool" && lhs != "unknown" {
                        self.push_error("logical operator expects bool operands")
                    }
                    ret "bool"
                }
                if lhs != "unknown" {
                    ret lhs
                }
                ret rhs
            }
            Expr::Call(call_expr) => {
                ret self.infer_call(call_expr, env)
            }
            Expr::Field(field_expr) => {
                let base_type = self.infer_expr_boxed(field_expr.base, env)
                if base_type == "unknown" {
                    ret "unknown"
                }
                ret self.resolve_field_type(base_type, field_expr.field)
            }
            Expr::MethodCall(_) => {
                ret "unknown"
            }
            Expr::StructInit(si) => {
                ret self.infer_struct_init(si, env)
            }
            Expr::TupleLiteral(_) => { ret "unknown" }
            Expr::ArrayLiteral(_) => { ret "unknown" }
            Expr::ArrayRepeat(_) => { ret "unknown" }
            Expr::Match(_) => { ret "unknown" }
            Expr::If(_) => { ret "unknown" }
            Expr::Block(be) => {
                self.infer_block(Block{be.statements}, env, "unknown")
                ret self.infer_expr_boxed(be.tail, env)
            }
            Expr::Index(_) => { ret "unknown" }
            Expr::Try(try_expr) => {
                ret self.infer_expr_boxed(try_expr, env)
            }
            Expr::Unsafe(block) => {
                self.infer_block(block, env, "unknown")
                ret "unknown"
            }
        }
    }

    fn infer_expr_boxed(mut self, expr: ExprNode<H>, env: Vec[LocalBinding]) -> str {
        ret self.infer_expr(ExprNode{expr.value}, env)
    }

    fn infer_call(mut self, call_expr: CallExpr, env: Vec[LocalBinding]) -> str {
        let mut name = ""
        match call_expr.callee.value {
            Expr::Path(path) => {
                name = path
            }
            _ => {
                ret "unknown"
            }
        }

        match self.find_function(name) {
            Some(fn_info) => {
                if fn_info.generics.len() > 0_usize && call_expr.generics.len() > 0_usize {
                    if fn_info.generics.len() != call_expr.generics.len() {
                        self.push_error("generic argument count mismatch")
                    }
                }

                if fn_info.params.len() != call_expr.args.len() {
                    self.push_error("call argument count mismatch")
                }

                let mut idx = 0_usize
                loop {
                    match call_expr.args.get(idx) {
                        Some(arg) => {
                            let arg_t = self.infer_expr(arg, env)
                            match fn_info.params.get(idx) {
                                Some(param) => {
                                    let expected = self.unwrap_opt_type(param.typ, "unknown")
                                    if expected != "unknown" && arg_t != "unknown" && expected != arg_t {
                                        self.push_error("call argument type mismatch")
                                    }
                                }
                                None => {}
                            }
                            idx = idx + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }

                ret fn_info.ret_type
            }
            None => {
                ret "unknown"
            }
        }
    }

    fn infer_struct_init(mut self, si: StructInitExpr, env: Vec[LocalBinding]) -> str {
        match self.find_struct(si.path) {
            Some(struct_info) => {
                let expected_count = struct_info.tuple_fields.len()
                if expected_count > 0_usize {
                    if expected_count != si.values.len() {
                        self.push_error("struct init field count mismatch")
                    }
                }
                let mut idx = 0_usize
                loop {
                    match si.values.get(idx) {
                        Some(value) => {
                            self.infer_expr(value, env)
                            idx = idx + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }
                ret si.path
            }
            None => {
                self.push_error("unknown struct in initializer")
                ret "unknown"
            }
        }
    }

    fn infer_lvalue(mut self, expr: ExprNode, env: Vec[LocalBinding]) -> str {
        match expr.value {
            Expr::Path(path) => {
                ret self.lookup_binding_type(env, path)
            }
            Expr::Field(field_expr) => {
                let base_t = self.infer_lvalue_boxed(field_expr.base, env)
                if base_t == "unknown" {
                    ret "unknown"
                }
                ret self.resolve_field_type(base_t, field_expr.field)
            }
            _ => {
                ret "unknown"
            }
        }
    }

    fn infer_lvalue_boxed(mut self, expr: ExprNode<H>, env: Vec[LocalBinding]) -> str {
        ret self.infer_lvalue(ExprNode{expr.value}, env)
    }

    fn resolve_field_type(mut self, base_type: str, field: str) -> str {
        match self.find_struct(base_type) {
            Some(struct_info) => {
                if field_is_integer(field) {
                    let idx = parse_usize(field)
                    match struct_info.tuple_fields.get(idx) {
                        Some(typ) => {
                            ret typ
                        }
                        None => {
                            self.push_error("tuple field index out of bounds")
                            ret "unknown"
                        }
                    }
                }
                let mut i = 0_usize
                loop {
                    match struct_info.fields.get(i) {
                        Some(named) => {
                            if named.name == field {
                                ret named.typ
                            }
                            i = i + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }
                self.push_error("unknown struct field")
                ret "unknown"
            }
            None => {
                self.push_error("field access on non-struct type")
                ret "unknown"
            }
        }
    }

    fn find_function(mut self, name: str) -> Option[FunctionInfo] {
        let mut index = 0_usize
        loop {
            match self.functions.get(index) {
                Some(info) => {
                    if info.name == name {
                        ret Option[FunctionInfo]::Some(info)
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret Option[FunctionInfo]::None
    }

    fn find_struct(mut self, name: str) -> Option[StructInfo] {
        let mut index = 0_usize
        loop {
            match self.structs.get(index) {
                Some(info) => {
                    if info.name == name {
                        ret Option[StructInfo]::Some(info)
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret Option[StructInfo]::None
    }

    fn lookup_binding_type(mut self, env: Vec[LocalBinding], name: str) -> str {
        let mut index = 0_usize
        loop {
            match env.get(index) {
                Some(binding) => {
                    if binding.name == name {
                        ret binding.typ
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret "unknown"
    }

    fn upsert_binding(mut self, env: Vec[LocalBinding], name: str, typ: str, is_mut: bool) -> Vec[LocalBinding] {
        // Minimal first version: shadowing creates a new binding.
        ret env.push(LocalBinding{name, typ, is_mut})
    }

    fn push_error(mut self, message: str) -> () {
        self.errors = self.errors.push(message)
        ret ()
    }

    fn unwrap_ret_type(mut self, typ: Option[str]) -> str {
        ret self.unwrap_opt_type(typ, "()")
    }

    fn unwrap_opt_type(mut self, typ: Option[str], fallback: str) -> str {
        match typ {
            Some(value) => {
                ret value
            }
            None => {
                ret fallback
            }
        }
    }
}


fn is_compare_op(op: str) -> bool {
    ret op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
}

fn infer_integer_type(raw: str) -> str {
    match suffix_after_underscore(raw) {
        Some(suffix) => { ret suffix }
        None => { ret "i32" }
    }
}

fn infer_float_type(raw: str) -> str {
    match suffix_after_underscore(raw) {
        Some(suffix) => { ret suffix }
        None => { ret "f32" }
    }
}

fn suffix_after_underscore(raw: str) -> Option[str] {
    let mut index = raw.len()
    loop {
        if index == 0_usize {
            break
        }
        index = index - 1_usize
        if raw.byte_at(index) == 95_u8 {
            if index + 1_usize >= raw.len() {
                ret Option[str]::None
            }
            ret Option[str]::Some(raw.slice(index + 1_usize, raw.len() - index - 1_usize))
        }
    }
    ret Option[str]::None
}

fn field_is_integer(field: str) -> bool {
    if field.len() == 0_usize {
        ret false
    }
    let mut i = 0_usize
    loop {
        if i >= field.len() {
            break
        }
        let code = field.byte_at(i)
        if code < 48_u8 || code > 57_u8 {
            ret false
        }
        i = i + 1_usize
    }
    ret true
}

fn parse_usize(text: str) -> usize {
    let mut out = 0_usize
    let mut i = 0_usize
    loop {
        if i >= text.len() {
            break
        }
        out = out * 10_usize
        out = out + digit_to_usize(text.byte_at(i))
        i = i + 1_usize
    }
    ret out
}

fn digit_to_usize(code: u8) -> usize {
    if code == 48_u8 { ret 0_usize }
    if code == 49_u8 { ret 1_usize }
    if code == 50_u8 { ret 2_usize }
    if code == 51_u8 { ret 3_usize }
    if code == 52_u8 { ret 4_usize }
    if code == 53_u8 { ret 5_usize }
    if code == 54_u8 { ret 6_usize }
    if code == 55_u8 { ret 7_usize }
    if code == 56_u8 { ret 8_usize }
    if code == 57_u8 { ret 9_usize }
    ret 0_usize
}
