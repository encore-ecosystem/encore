pub import std::string::String
pub import std::vec::Vec
pub import std::option::Option
pub import std::fmt::Debug

// Environment for type inference
pub struct TypeEnv {
    structs: Vec[StructDef],
    enums: Vec[EnumDef],
    functions: Vec[FuncSig],
}

pub struct StructDef {
    name: String,
    fields: Vec[NamedField],
}

pub struct EnumDef {
    name: String,
    variants: Vec[EnumVariant],
}

pub struct FuncSig {
    name: String,
    params: Vec[String], // type strings
    ret_type: Option[String],
}

// Simple error collector
pub struct TypeError {
    msg: String,
}

pub fn infer_types(ast: Vec[Statement]) -> u32 {
    let mut env = TypeEnv{structs: Vec[StructDef]::new(), enums: Vec[EnumDef]::new(), functions: Vec[FuncSig]::new()};
    // First pass: collect definitions
    for stmt in &ast {
        match stmt {
            Statement::Struct(s) => {
                env.structs = env.structs.push(StructDef{ name: s.name.clone(), fields: s.named_fields.clone() });
            }
            Statement::EnumItem(e) => {
                env.enums = env.enums.push(EnumDef{ name: e.name.clone(), variants: e.variants.clone() });
            }
            Statement::Function(f) => {
                let mut param_types = Vec[String]::new();
                for p in &f.params { param_types = param_types.push(p.typ.clone().unwrap_or(String::new())); }
                env.functions = env.functions.push(FuncSig{ name: f.name.clone(), params: param_types, ret_type: f.ret_type.clone() });
            }
            Statement::Impl(i) => {
                for m in &i.methods {
                    let mut param_types = Vec[String]::new();
                    for p in &m.params { param_types = param_types.push(p.typ.clone().unwrap_or(String::new())); }
                    env.functions = env.functions.push(FuncSig{ name: format!("{}::{}", i.target, m.name), params: param_types, ret_type: m.ret_type.clone() });
                }
            }
            _ => {}
        }
    }

    let mut errors = Vec[TypeError]::new();
    // Second pass: type check statements
    for stmt in &ast {
        match stmt {
            Statement::Let(l) => {
                if let Some(ref_declared) = l.typ {
                    // infer expression type
                    let expr_type_opt = infer_expr(&l.expr, &env, &mut Vec[String]::new(), &mut errors);
                    if let Some(expr_type) = expr_type_opt {
                        if expr_type != ref_declared {
                            errors = errors.push(TypeError{ msg: format!("Type mismatch in let '{}': expected {}, got {}", l.name, ref_declared, expr_type)} );
                        }
                    } else {
                        errors = errors.push(TypeError{ msg: format!("Could not infer type of expression in let '{}'", l.name)} );
                    }
                }
            }
            Statement::Assignment(a) => {
                // similar handling for assignments if needed
            }
            _ => {}
        }
    }

    if errors.len() > 0 {
        for e in &errors { println(e.msg); }
        ret 1_u32
    } else {
        ret 0_u32
    }
}

fn infer_expr(expr: &ExprNode, env: &TypeEnv, local_vars: &mut Vec[String], errors: &mut Vec[TypeError]) -> Option<String> {
    match expr.value {
        Expr::Integer(val) => {
            // parse suffix if present
            let parts = val.split('_');
            let mut iter = parts.into_iter();
            let _num = iter.next()?; // numeric part
            let type_part = iter.next();
            match type_part {
                Some(t) => Some(String::from_str(t)),
                None => Some(String::new()), // default int
            }
        }
        Expr::Float(val) => {
            let parts = val.split('_');
            let mut iter = parts.into_iter();
            let _num = iter.next()?;
            let type_part = iter.next();
            match type_part {
                Some(t) => Some(String::from_str(t)),
                None => Some(String::new()),
            }
        }
        Expr::StringLiteral(_) => Some("String".to_string()),
        Expr::StructInit(si) => {
            // find struct definition
            let mut struct_opt: Option<&StructDef> = None;
            for s in &env.structs { if s.name == si.path { struct_opt = Some(s); break; } }
            if let Some(struct_def) = struct_opt {
                if si.values.len() != struct_def.fields.len() {
                    errors = errors.push(TypeError{ msg: format!("Struct '{}' initializer has wrong number of fields", si.path)} );
                    return None;
                }
                // infer each field type
                for (i, val) in si.values.iter().enumerate() {
                    let field_type_opt = infer_expr(val, env, local_vars, errors);
                    if let Some(ftype) = field_type_opt {
                        if ftype != struct_def.fields[i].typ { // field typ is string
                            errors = errors.push(TypeError{ msg: format!("Field '{}' type mismatch in struct init", struct_def.fields[i].name)} );
                        }
                    } else {
                        return None;
                    }
                }
                Some(struct_def.name.clone())
            } else {
                errors = errors.push(TypeError{ msg: format!("Unknown struct '{}' used in init", si.path)} );
                None
            }
        }
        Expr::Call(c) => {
            // callee path string
            let mut callee_path_opt: Option<String> = None;
            if let Expr::Path(p) = c.callee.value { callee_path_opt = Some(p); }
            if let Some(callee_name) = callee_path_opt {
                // find function signature
                let mut sig_opt: Option<&FuncSig> = None;
                for f in &env.functions { if f.name == callee_name { sig_opt = Some(f); break; } }
                if let Some(sig) = sig_opt {
                    if c.args.len() != sig.params.len() {
                        errors = errors.push(TypeError{ msg: format!("Function '{}' called with wrong number of arguments", callee_name)} );
                        return None;
                    }
                    for (arg_expr, expected_type) in c.args.iter().zip(sig.params.iter()) {
                        let arg_type_opt = infer_expr(arg_expr, env, local_vars, errors);
                        if let Some(at) = arg_type_opt {
                            if &at != expected_type { errors = errors.push(TypeError{ msg: format!("Argument type mismatch in call to '{}'") }); }
                        } else { return None; }
                    }
                    sig.ret_type.clone()
                } else {
                    errors = errors.push(TypeError{ msg: format!("Unknown function '{}' called", callee_name)} );
                    None
                }
            } else { None }
        }
        _ => None,
    }
}
