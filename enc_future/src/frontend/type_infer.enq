import std::vec::Vec

import mod::parser::statements::*


pub fn infer_program(ast: Vec[Statement]) -> str {
    let mut out = Vec[str]::new()
    let mut index = 0_usize

    loop {
        match ast.get(index) {
            Some(stmt) => {
                out = out.push(statement_to_string(stmt))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret join_lines(out)
}

fn statement_to_string(stmt: Statement) -> str {
    match stmt {
        Statement::Import(import_stmt) => {
            ret "import " + import_stmt.path
        }
        Statement::Struct(struct_stmt) => {
            ret "struct " + struct_stmt.name
        }
        Statement::EnumItem(enum_stmt) => {
            ret "enum " + enum_stmt.name
        }
        Statement::Trait(trait_stmt) => {
            ret "trait " + trait_stmt.name
        }
        Statement::Impl(impl_stmt) => {
            match impl_stmt.trait_name {
                Some(trait_name) => {
                    ret "impl " + trait_name + " for " + impl_stmt.target
                }
                None => {
                    ret "impl for " + impl_stmt.target
                }
            }
        }
        Statement::Function(function_stmt) => {
            ret "fn " + function_stmt.name
        }
        Statement::Let(let_stmt) => {
            ret "let " + let_stmt.name
        }
        Statement::Assignment(_) => {
            ret "assignment"
        }
        Statement::Expr(_) => {
            ret "expr"
        }
        Statement::Ret(_) => {
            ret "ret"
        }
        Statement::If(_) => {
            ret "if"
        }
        Statement::Match(match_stmt) => {
            ret "match " + expr_kind(match_stmt.expr)
        }
        Statement::While(_) => {
            ret "while"
        }
        Statement::Loop(_) => {
            ret "loop"
        }
        Statement::DoWhile(_) => {
            ret "do while"
        }
        Statement::Break(_) => {
            ret "break"
        }
        Statement::Continue(_) => {
            ret "continue"
        }
        Statement::Unsafe(_) => {
            ret "unsafe"
        }
        Statement::Ehir(ehir_stmt) => {
            if ehir_stmt.is_unsafe {
                ret "ehir unsafe"
            } else {
                ret "ehir"
            }
        }
    }
}

fn expr_kind(node: ExprNode) -> str {
    match node.value {
        Expr::Path(path) => {
            ret path
        }
        Expr::Call(_) => {
            ret "call"
        }
        Expr::MethodCall(_) => {
            ret "method-call"
        }
        Expr::Integer(_) => {
            ret "int"
        }
        Expr::Float(_) => {
            ret "float"
        }
        Expr::Boolean(_) => {
            ret "bool"
        }
        Expr::StringLiteral(_) => {
            ret "str"
        }
        Expr::StructInit(_) => {
            ret "struct-init"
        }
        Expr::ArrayLiteral(_) => {
            ret "array"
        }
        Expr::ArrayRepeat(_) => {
            ret "array-repeat"
        }
        Expr::TupleLiteral(_) => {
            ret "tuple"
        }
        Expr::Unary(unary_expr) => {
            ret unary_expr.operator
        }
        Expr::Binary(binary_expr) => {
            ret binary_expr.operator
        }
        Expr::Field(field_expr) => {
            ret field_expr.field
        }
        Expr::Index(_) => {
            ret "index"
        }
        Expr::If(_) => {
            ret "if-expr"
        }
        Expr::Match(_) => {
            ret "match-expr"
        }
        Expr::Block(_) => {
            ret "block"
        }
        Expr::Unsafe(_) => {
            ret "unsafe-expr"
        }
        Expr::Parenthesized(_) => {
            ret "paren"
        }
        Expr::Try(_) => {
            ret "try"
        }
    }
}

fn join_lines(items: Vec[str]) -> str {
    let mut out = ""
    let mut index = 0_usize

    loop {
        match items.get(index) {
            Some(item) => {
                if index > 0_usize {
                    out = out + "\n"
                }
                out = out + item
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}
