import mod::statements::AssignmentStmt
import mod::statements::Ast
import mod::statements::BinaryExpr
import mod::statements::Block
import mod::statements::CallExpr
import mod::statements::DoWhileStmt
import mod::statements::EnumItem
import mod::statements::Expr
import mod::statements::FieldExpr
import mod::statements::FunctionItem
import mod::statements::FunctionParam
import mod::statements::IfBranch
import mod::statements::IfStmt
import mod::statements::ImplItem
import mod::statements::ImportItem
import mod::statements::Item
import mod::statements::LetStmt
import mod::statements::LoopStmt
import mod::statements::MatchArm
import mod::statements::MatchExpr
import mod::statements::MatchExprArm
import mod::statements::MatchPattern
import mod::statements::MatchStmt
import mod::statements::MethodCallExpr
import mod::statements::NamedField
import mod::statements::Statement
import mod::statements::StructInitExpr
import mod::statements::StructItem
import mod::statements::StructSignature
import mod::statements::TraitItem
import mod::statements::TupleLiteralExpr
import mod::statements::UnaryExpr
import mod::statements::WhileStmt

import refrain::frontend::lexer::Token
import refrain::frontend::lexer::TokenType

import std::fmt::Debug
import std::io::println
import std::option::Option
import std::string::String
import std::string::as_str
import std::string::str_eq
import std::vec::Vec

pub struct Parser {
    consumed: usize
    failed: bool
    parsing_match_header: bool
    parsing_control_flow_header: bool
    tokens: Vec[Token]
    items: Vec[Item]
    blocks: Vec[Block]
    exprs: Vec[Expr]
}

impl for Parser {
    pub fn new() -> Parser {
        ret Parser{
            0_usize,
            false,
            false,
            false,
            Vec[Token]::new(),
            Vec[Item]::new(),
            Vec[Block]::new(),
            Vec[Expr]::new()
        }
    }

    pub fn parse(mut self, tokens: Vec[Token]) -> Ast {
        self.consumed = 0_usize
        self.failed = false
        self.parsing_match_header = false
        self.parsing_control_flow_header = false
        self.tokens = tokens
        self.items = Vec[Item]::new()
        self.blocks = Vec[Block]::new()
        self.exprs = Vec[Expr]::new()

        loop {
            if self.is_at_end() || self.failed {
                break
            }
            self.items = self.items.push(self.parse_top_level())
        }

        ret Ast{self.items, self.blocks, self.exprs}
    }

    fn parse_top_level(mut self) -> Item {
        if self.curr_type() == TokenType::KW_IMPL {
            ret self.parse_impl()
        }

        let mut is_public = false
        if self.curr_type() == TokenType::KW_PUB {
            self.consume()
            is_public = true
        }

        if self.curr_type() == TokenType::KW_IMPORT {
            ret self.parse_import(is_public)
        }
        if self.curr_type() == TokenType::KW_STRUCT {
            ret self.parse_struct(is_public)
        }
        if self.curr_type() == TokenType::KW_ENUM {
            ret self.parse_enum(is_public)
        }
        if self.curr_type() == TokenType::KW_TRAIT {
            ret self.parse_trait(is_public)
        }
        if self.curr_type() == TokenType::KW_FN {
            ret self.parse_function(is_public, false)
        }
        if self.curr_type() == TokenType::KW_EXTERN {
            self.consume()
            if self.curr_type() == TokenType::KW_FN {
                ret self.parse_function(is_public, true)
            }

            self.fail_current("Expected `fn` after `extern`")
            ret Item::Import(ImportItem{false, String::from_str("<error>")})
        }

        self.fail_current("Unsupported top-level item")
        ret Item::Import(ImportItem{false, String::from_str("<error>")})
    }

    fn parse_import(mut self, is_public: bool) -> Item {
        self.expect(TokenType::KW_IMPORT)
        let path = self.parse_import_path_text()
        ret Item::Import(ImportItem{is_public, path})
    }

    fn parse_function(mut self, is_public: bool, is_extern: bool) -> Item {
        ret Item::Function(self.parse_function_item(is_public, is_extern, true))
    }

    fn parse_function_item(mut self, is_public: bool, is_extern: bool, allow_body: bool) -> FunctionItem {
        self.expect(TokenType::KW_FN)
        let name = self.expect_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generics_text()
        let params = self.parse_function_params()

        let mut ret_type: Option[String] = Option[String]::None
        if self.curr_type() == TokenType::ARROW {
            self.consume()
            ret_type = Option[String]::Some(self.parse_type_text())
        }

        let mut body: Option[usize] = Option[usize]::None
        if allow_body && !is_extern && self.curr_type() == TokenType::LEFT_BRACE {
            body = Option[usize]::Some(self.parse_block())
        }

        ret FunctionItem{
            is_public,
            is_extern,
            name,
            generics,
            params,
            ret_type,
            body
        }
    }

    fn parse_struct(mut self, is_public: bool) -> Item {
        self.expect(TokenType::KW_STRUCT)
        ret Item::Struct(StructItem{is_public, self.parse_struct_signature()})
    }

    fn parse_enum(mut self, is_public: bool) -> Item {
        self.expect(TokenType::KW_ENUM)
        let name = self.expect_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generics_text()
        let mut variants = Vec[StructSignature]::new()

        self.expect(TokenType::LEFT_BRACE)
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }
            variants = variants.push(self.parse_struct_signature())
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.curr_type() == TokenType::RIGHT_BRACE {
                break
            }
        }
        self.expect(TokenType::RIGHT_BRACE)

        ret Item::Enum(EnumItem{is_public, name, generics, variants})
    }

    fn parse_trait(mut self, is_public: bool) -> Item {
        self.expect(TokenType::KW_TRAIT)
        let name = self.expect_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generics_text()
        let bases = self.parse_trait_bases()
        let mut methods = Vec[FunctionItem]::new()

        self.expect(TokenType::LEFT_BRACE)
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }

            let mut method_is_public = false
            if self.curr_type() == TokenType::KW_PUB {
                self.consume()
                method_is_public = true
            }

            methods = methods.push(self.parse_function_item(method_is_public, false, false))
        }
        self.expect(TokenType::RIGHT_BRACE)

        ret Item::Trait(TraitItem{is_public, name, generics, bases, methods})
    }

    fn parse_impl(mut self) -> Item {
        self.expect(TokenType::KW_IMPL)
        let generics = self.parse_possible_generics_text()

        let mut trait_name: Option[String] = Option[String]::None
        if self.curr_type() != TokenType::KW_FOR {
            trait_name = Option[String]::Some(self.parse_path_text())
        }

        self.expect(TokenType::KW_FOR)
        let target = self.parse_type_text()
        let mut methods = Vec[FunctionItem]::new()

        self.expect(TokenType::LEFT_BRACE)
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }

            let mut method_is_public = false
            if self.curr_type() == TokenType::KW_PUB {
                self.consume()
                method_is_public = true
            }

            methods = methods.push(self.parse_function_item(method_is_public, false, true))
        }
        self.expect(TokenType::RIGHT_BRACE)

        ret Item::Impl(ImplItem{generics, trait_name, target, methods})
    }

    fn parse_struct_signature(mut self) -> StructSignature {
        let name = self.expect_value(TokenType::IDENTIFIER)
        let generics = self.parse_possible_generics_text()

        if self.curr_type() == TokenType::LEFT_BRACE {
            self.consume()
            let mut named_fields = Vec[NamedField]::new()
            loop {
                if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                    break
                }

                let field_name = self.expect_value(TokenType::IDENTIFIER)
                self.expect(TokenType::COLON)
                let field_type = self.parse_type_text()
                named_fields = named_fields.push(NamedField{field_name, field_type})

                if self.curr_type() != TokenType::COMMA {
                    break
                }
                self.consume()
                if self.curr_type() == TokenType::RIGHT_BRACE {
                    break
                }
            }
            self.expect(TokenType::RIGHT_BRACE)
            ret StructSignature{name, generics, named_fields, Vec[String]::new(), false, false}
        }

        if self.curr_type() == TokenType::LEFT_PAREN {
            self.consume()
            let mut tuple_fields = Vec[String]::new()
            loop {
                if self.curr_type() == TokenType::RIGHT_PAREN || self.failed {
                    break
                }

                tuple_fields = tuple_fields.push(self.parse_type_text())
                if self.curr_type() != TokenType::COMMA {
                    break
                }
                self.consume()
                if self.curr_type() == TokenType::RIGHT_PAREN {
                    break
                }
            }
            self.expect(TokenType::RIGHT_PAREN)
            ret StructSignature{name, generics, Vec[NamedField]::new(), tuple_fields, true, false}
        }

        ret StructSignature{name, generics, Vec[NamedField]::new(), Vec[String]::new(), false, true}
    }

    fn parse_trait_bases(mut self) -> Vec[String] {
        let mut bases = Vec[String]::new()
        if self.curr_type() != TokenType::LESS {
            ret bases
        }

        self.consume()
        loop {
            if self.curr_type() == TokenType::LEFT_BRACE || self.failed {
                break
            }

            bases = bases.push(self.parse_type_text())
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
        }

        ret bases
    }

    fn parse_function_params(mut self) -> Vec[FunctionParam] {
        let mut params = Vec[FunctionParam]::new()
        self.expect(TokenType::LEFT_PAREN)
        if self.curr_type() == TokenType::RIGHT_PAREN {
            self.expect(TokenType::RIGHT_PAREN)
            ret params
        }

        loop {
            params = params.push(self.parse_param())
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.curr_type() == TokenType::RIGHT_PAREN {
                break
            }
        }
        self.expect(TokenType::RIGHT_PAREN)
        ret params
    }

    fn parse_param(mut self) -> FunctionParam {
        if self.curr_ident_is("self") {
            let name = self.consume_value()
            let mut typ: Option[String] = Option[String]::None
            if self.curr_type() == TokenType::COLON {
                self.consume()
                typ = Option[String]::Some(self.parse_type_text())
            }
            ret FunctionParam{name, typ}
        }

        if self.curr_type() == TokenType::KW_MUT {
            self.consume()
            if self.curr_ident_is("self") {
                let name = self.consume_value()
                let mut typ: Option[String] = Option[String]::Some(String::from_str("mut Self"))
                if self.curr_type() == TokenType::COLON {
                    self.consume()
                    let mut out = String::from_str("mut ")
                    let parsed = self.parse_type_text()
                    out = out.concat(as_str(parsed))
                    typ = Option[String]::Some(out)
                }
                ret FunctionParam{name, typ}
            }
            self.fail_current("Only `self` may use prefix `mut` in parameter position")
            ret FunctionParam{String::from_str("<error>"), Option[String]::None}
        }

        let name = self.expect_value(TokenType::IDENTIFIER)
        self.expect(TokenType::COLON)
        ret FunctionParam{name, Option[String]::Some(self.parse_type_text())}
    }

    fn parse_block(mut self) -> usize {
        self.expect(TokenType::LEFT_BRACE)
        let mut statements = Vec[Statement]::new()
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }
            statements = statements.push(self.parse_inner_level())
        }
        self.expect(TokenType::RIGHT_BRACE)
        let block_id = self.blocks.len()
        self.blocks = self.blocks.push(Block{statements})
        ret block_id
    }

    fn parse_inner_level(mut self) -> Statement {
        if self.curr_type() == TokenType::KW_LET {
            ret self.parse_let()
        }
        if self.curr_type() == TokenType::KW_RET {
            ret self.parse_ret()
        }
        if self.curr_type() == TokenType::KW_WHILE {
            ret self.parse_while()
        }
        if self.curr_type() == TokenType::KW_LOOP {
            ret self.parse_loop()
        }
        if self.curr_type() == TokenType::KW_DO {
            ret self.parse_do_while()
        }
        if self.curr_type() == TokenType::KW_IF {
            ret self.parse_if()
        }
        if self.curr_type() == TokenType::KW_MATCH {
            ret self.parse_match()
        }
        if self.curr_type() == TokenType::KW_BREAK {
            self.consume()
            ret Statement::Break
        }
        if self.curr_type() == TokenType::KW_CONTINUE {
            self.consume()
            ret Statement::Continue
        }

        let target = self.parse_expression()
        if self.is_assignment_operator(self.curr_type()) {
            ret self.parse_assignment_from_target(target)
        }
        ret Statement::Expr(target)
    }

    fn parse_let(mut self) -> Statement {
        self.expect(TokenType::KW_LET)
        let mut is_mut = false
        if self.curr_type() == TokenType::KW_MUT {
            self.consume()
            is_mut = true
        }

        let name = self.expect_value(TokenType::IDENTIFIER)
        let mut typ: Option[String] = Option[String]::None
        if self.curr_type() == TokenType::COLON {
            self.consume()
            typ = Option[String]::Some(self.parse_type_text())
        }
        self.expect(TokenType::ASSIGN)
        let expr = self.parse_expression()
        ret Statement::Let(LetStmt{name, typ, expr, is_mut})
    }

    fn parse_ret(mut self) -> Statement {
        self.expect(TokenType::KW_RET)
        ret Statement::Ret(self.parse_expression())
    }

    fn parse_while(mut self) -> Statement {
        self.expect(TokenType::KW_WHILE)
        self.parsing_control_flow_header = true
        let condition = self.parse_expression()
        self.parsing_control_flow_header = false
        ret Statement::While(WhileStmt{condition, self.parse_block()})
    }

    fn parse_loop(mut self) -> Statement {
        self.expect(TokenType::KW_LOOP)
        ret Statement::Loop(LoopStmt{self.parse_block()})
    }

    fn parse_do_while(mut self) -> Statement {
        self.expect(TokenType::KW_DO)
        let body = self.parse_block()
        self.expect(TokenType::KW_WHILE)
        self.parsing_control_flow_header = true
        let condition = self.parse_expression()
        self.parsing_control_flow_header = false
        ret Statement::DoWhile(DoWhileStmt{body, condition})
    }

    fn parse_if(mut self) -> Statement {
        self.expect(TokenType::KW_IF)
        self.parsing_control_flow_header = true
        let first_condition = self.parse_expression()
        self.parsing_control_flow_header = false
        let mut branches = Vec[IfBranch]::new().push(IfBranch{first_condition, self.parse_block()})

        loop {
            if self.curr_type() != TokenType::KW_ELIF {
                break
            }
            self.consume()
            self.parsing_control_flow_header = true
            let condition = self.parse_expression()
            self.parsing_control_flow_header = false
            branches = branches.push(IfBranch{condition, self.parse_block()})
        }

        let mut else_body: Option[usize] = Option[usize]::None
        if self.curr_type() == TokenType::KW_ELSE {
            self.consume()
            else_body = Option[usize]::Some(self.parse_block())
        }

        ret Statement::If(IfStmt{branches, else_body})
    }

    fn parse_match(mut self) -> Statement {
        self.expect(TokenType::KW_MATCH)
        self.parsing_match_header = true
        let expr = self.parse_expression()
        self.parsing_match_header = false
        self.expect(TokenType::LEFT_BRACE)
        let mut arms = Vec[MatchArm]::new()
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }
            arms = arms.push(self.parse_match_arm())
        }
        self.expect(TokenType::RIGHT_BRACE)
        ret Statement::Match(MatchStmt{expr, arms})
    }

    fn parse_match_arm(mut self) -> MatchArm {
        let mut path: Option[String] = Option[String]::None
        if self.curr_ident_is("_") {
            self.consume()
        }
        else {
            path = Option[String]::Some(self.parse_path_text())
        }

        let mut binding: Option[String] = Option[String]::None
        if self.curr_type() == TokenType::LEFT_PAREN {
            self.consume()
            binding = Option[String]::Some(self.expect_value(TokenType::IDENTIFIER))
            self.expect(TokenType::RIGHT_PAREN)
        }

        self.expect(TokenType::FAT_ARROW)
        ret MatchArm{MatchPattern{path, binding}, self.parse_block()}
    }

    fn parse_assignment_from_target(mut self, target: usize) -> Statement {
        let operator = self.consume_value()
        let expr = self.parse_expression()
        ret Statement::Assignment(AssignmentStmt{target, operator, expr})
    }

    fn parse_expression(mut self) -> usize {
        ret self.parse_logical_or()
    }

    fn parse_logical_or(mut self) -> usize {
        let mut left = self.parse_logical_and()
        loop {
            if self.curr_type() != TokenType::PIPE_PIPE {
                break
            }
            let operator = self.consume_value()
            let right = self.parse_logical_and()
            left = self.push_expr(Expr::Binary(BinaryExpr{left, operator, right}))
        }
        ret left
    }

    fn parse_logical_and(mut self) -> usize {
        let mut left = self.parse_equality()
        loop {
            if self.curr_type() != TokenType::AND_AND {
                break
            }
            let operator = self.consume_value()
            let right = self.parse_equality()
            left = self.push_expr(Expr::Binary(BinaryExpr{left, operator, right}))
        }
        ret left
    }

    fn parse_equality(mut self) -> usize {
        let mut left = self.parse_relational()
        loop {
            let curr_type = self.curr_type()
            if curr_type != TokenType::EQUAL_EQUAL && curr_type != TokenType::BANG_EQUAL {
                break
            }
            let operator = self.consume_value()
            let right = self.parse_relational()
            left = self.push_expr(Expr::Binary(BinaryExpr{left, operator, right}))
        }
        ret left
    }

    fn parse_relational(mut self) -> usize {
        let mut left = self.parse_additive()
        loop {
            let curr_type = self.curr_type()
            if curr_type != TokenType::LESS && curr_type != TokenType::LESS_EQUAL &&
               curr_type != TokenType::GREATER && curr_type != TokenType::GREATER_EQUAL {
                break
            }
            let operator = self.consume_value()
            let right = self.parse_additive()
            left = self.push_expr(Expr::Binary(BinaryExpr{left, operator, right}))
        }
        ret left
    }

    fn parse_additive(mut self) -> usize {
        let mut left = self.parse_multiplicative()
        loop {
            let curr_type = self.curr_type()
            if curr_type != TokenType::PLUS && curr_type != TokenType::MINUS {
                break
            }
            let operator = self.consume_value()
            let right = self.parse_multiplicative()
            left = self.push_expr(Expr::Binary(BinaryExpr{left, operator, right}))
        }
        ret left
    }

    fn parse_multiplicative(mut self) -> usize {
        let mut left = self.parse_unary()
        loop {
            let curr_type = self.curr_type()
            if curr_type != TokenType::ASTERISK && curr_type != TokenType::SLASH && curr_type != TokenType::PERCENT {
                break
            }
            let operator = self.consume_value()
            let right = self.parse_unary()
            left = self.push_expr(Expr::Binary(BinaryExpr{left, operator, right}))
        }
        ret left
    }

    fn parse_unary(mut self) -> usize {
        let curr_type = self.curr_type()
        if curr_type == TokenType::PLUS || curr_type == TokenType::MINUS || curr_type == TokenType::BANG {
            let operator = self.consume_value()
            let expr = self.parse_unary()
            ret self.push_expr(Expr::Unary(UnaryExpr{operator, expr}))
        }
        ret self.parse_postfix()
    }

    fn parse_postfix(mut self) -> usize {
        let mut expr = self.parse_primary()
        loop {
            let curr_type = self.curr_type()
            if curr_type == TokenType::LEFT_PAREN {
                let args = self.parse_call_args()
                expr = self.push_expr(Expr::Call(CallExpr{expr, args}))
            }
            elif curr_type == TokenType::DOT {
                self.consume()
                let member = self.expect_value(TokenType::IDENTIFIER)
                if self.curr_type() == TokenType::LEFT_PAREN {
                    let args = self.parse_call_args()
                    expr = self.push_expr(Expr::MethodCall(MethodCallExpr{expr, member, args}))
                }
                else {
                    expr = self.push_expr(Expr::Field(FieldExpr{expr, member}))
                }
            }
            else {
                break
            }
        }
        ret expr
    }

    fn parse_primary(mut self) -> usize {
        let token = self.peek_curr()
        if token.type == TokenType::KW_MATCH {
            ret self.parse_match_expression()
        }
        if token.type == TokenType::INTEGER {
            ret self.parse_integer_literal()
        }
        if token.type == TokenType::FLOAT {
            ret self.parse_float_literal()
        }
        if token.type == TokenType::BOOLEAN {
            let bool_value = str_eq(as_str(self.consume_value()), "true")
            ret self.push_expr(Expr::Boolean(bool_value))
        }
        if token.type == TokenType::STRING {
            let string_value = self.consume_value()
            ret self.push_expr(Expr::StringLiteral(string_value))
        }
        if token.type == TokenType::LEFT_PAREN {
            ret self.parse_parenthesized_or_tuple()
        }
        if token.type == TokenType::IDENTIFIER {
            let path = self.parse_path_text()
            if self.curr_type() == TokenType::LEFT_BRACE {
                ret self.parse_struct_init(path)
            }
            ret self.push_expr(Expr::Path(path))
        }

        self.fail_current("Unable to parse primary expression")
        ret self.push_expr(Expr::Path(String::from_str("<error>")))
    }

    fn parse_match_expression(mut self) -> usize {
        self.expect(TokenType::KW_MATCH)
        self.parsing_match_header = true
        let expr = self.parse_expression()
        self.parsing_match_header = false
        self.expect(TokenType::LEFT_BRACE)

        let mut arms = Vec[MatchExprArm]::new()
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }
            arms = arms.push(self.parse_match_expression_arm())
        }
        self.expect(TokenType::RIGHT_BRACE)

        ret self.push_expr(Expr::Match(MatchExpr{expr, arms}))
    }

    fn parse_match_expression_arm(mut self) -> MatchExprArm {
        let mut path: Option[String] = Option[String]::None
        if self.curr_ident_is("_") {
            self.consume()
        }
        else {
            path = Option[String]::Some(self.parse_path_text())
        }

        let mut binding: Option[String] = Option[String]::None
        if self.curr_type() == TokenType::LEFT_PAREN {
            self.consume()
            binding = Option[String]::Some(self.expect_value(TokenType::IDENTIFIER))
            self.expect(TokenType::RIGHT_PAREN)
        }

        self.expect(TokenType::FAT_ARROW)

        let mut expr = 0_usize
        if self.curr_type() == TokenType::LEFT_BRACE {
            expr = self.push_expr(Expr::Block(self.parse_block()))
        }
        else {
            expr = self.parse_expression()
        }

        ret MatchExprArm{MatchPattern{path, binding}, expr}
    }

    fn parse_parenthesized_or_tuple(mut self) -> usize {
        self.expect(TokenType::LEFT_PAREN)
        if self.curr_type() == TokenType::RIGHT_PAREN {
            self.expect(TokenType::RIGHT_PAREN)
            ret self.push_expr(Expr::TupleLiteral(TupleLiteralExpr{Vec[usize]::new()}))
        }

        let first = self.parse_expression()
        if self.curr_type() != TokenType::COMMA {
            self.expect(TokenType::RIGHT_PAREN)
            ret self.push_expr(Expr::Parenthesized(first))
        }

        let mut items = Vec[usize]::new().push(first)
        loop {
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.curr_type() == TokenType::RIGHT_PAREN {
                break
            }
            items = items.push(self.parse_expression())
        }
        self.expect(TokenType::RIGHT_PAREN)
        ret self.push_expr(Expr::TupleLiteral(TupleLiteralExpr{items}))
    }

    fn parse_struct_init(mut self, path: String) -> usize {
        self.expect(TokenType::LEFT_BRACE)
        let mut values = Vec[usize]::new()
        loop {
            if self.curr_type() == TokenType::RIGHT_BRACE || self.failed {
                break
            }
            values = values.push(self.parse_expression())
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.curr_type() == TokenType::RIGHT_BRACE {
                break
            }
        }
        self.expect(TokenType::RIGHT_BRACE)
        ret self.push_expr(Expr::StructInit(StructInitExpr{path, values}))
    }

    fn parse_integer_literal(mut self) -> usize {
        let mut value = self.expect_value(TokenType::INTEGER)
        let suffix = self.parse_numeric_literal_suffix()
        match suffix {
            Some(suffix_value) => {
                value = value.concat(as_str(suffix_value))
            }
            None => {}
        }
        ret self.push_expr(Expr::Integer(value))
    }

    fn parse_float_literal(mut self) -> usize {
        let mut value = self.expect_value(TokenType::FLOAT)
        let suffix = self.parse_numeric_literal_suffix()
        match suffix {
            Some(suffix_value) => {
                value = value.concat(as_str(suffix_value))
            }
            None => {}
        }
        ret self.push_expr(Expr::Float(value))
    }

    fn parse_numeric_literal_suffix(mut self) -> Option[String] {
        if self.is_at_end() {
            ret Option[String]::None
        }

        let token = self.peek_curr()
        if token.type != TokenType::IDENTIFIER {
            ret Option[String]::None
        }

        match token.value.char_at(0_usize) {
            Some(ch) => {
                if str_eq(ch, "_") {
                    ret Option[String]::Some(self.consume_value())
                }
            }
            None => {}
        }

        ret Option[String]::None
    }

    fn parse_call_args(mut self) -> Vec[usize] {
        let mut args = Vec[usize]::new()
        self.expect(TokenType::LEFT_PAREN)
        if self.curr_type() == TokenType::RIGHT_PAREN {
            self.expect(TokenType::RIGHT_PAREN)
            ret args
        }

        loop {
            args = args.push(self.parse_expression())
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.curr_type() == TokenType::RIGHT_PAREN {
                break
            }
        }
        self.expect(TokenType::RIGHT_PAREN)
        ret args
    }

    fn parse_possible_generics_text(mut self) -> Vec[String] {
        if self.curr_type() == TokenType::LEFT_BRACKET {
            ret self.parse_generics_text()
        }
        ret Vec[String]::new()
    }

    fn parse_generics_text(mut self) -> Vec[String] {
        let mut generics = Vec[String]::new()
        self.expect(TokenType::LEFT_BRACKET)
        if self.curr_type() == TokenType::RIGHT_BRACKET {
            self.expect(TokenType::RIGHT_BRACKET)
            ret generics
        }

        loop {
            generics = generics.push(self.parse_type_text())
            if self.curr_type() != TokenType::COMMA {
                break
            }
            self.consume()
            if self.curr_type() == TokenType::RIGHT_BRACKET {
                break
            }
        }
        self.expect(TokenType::RIGHT_BRACKET)
        ret generics
    }

    fn parse_import_path_text(mut self) -> String {
        let mut out = self.parse_path_segment_text()
        loop {
            if self.curr_type() != TokenType::SCOPE {
                break
            }
            self.consume()
            out = out.concat("::")
            if self.curr_type() == TokenType::ASTERISK {
                out = out.concat(as_str(self.consume_value()))
                break
            }
            out = out.concat(as_str(self.parse_path_segment_text()))
        }
        ret out
    }

    fn parse_path_text(mut self) -> String {
        let mut out = self.parse_path_segment_text()
        loop {
            if self.curr_type() != TokenType::SCOPE {
                break
            }
            self.consume()
            out = out.concat("::")
            out = out.concat(as_str(self.parse_path_segment_text()))
        }
        ret out
    }

    fn parse_path_segment_text(mut self) -> String {
        let mut out = self.expect_value(TokenType::IDENTIFIER)
        if self.curr_type() == TokenType::LEFT_BRACKET {
            out = out.concat(as_str(self.parse_generic_suffix_text()))
        }

        if self.is_smart_pointer_suffix() {
            self.expect(TokenType::LESS)
            let pointer = self.expect_value(TokenType::IDENTIFIER)
            self.expect(TokenType::GREATER)
            out = out.concat("<")
            out = out.concat(as_str(pointer))
            out = out.concat(">")
        }

        ret out
    }

    fn parse_generic_suffix_text(mut self) -> String {
        let items = self.parse_generics_text()
        let mut out = String::from_str("[")
        let mut idx = 0_usize
        loop {
            match items.get(idx) {
                Some(item) => {
                    if idx > 0_usize {
                        out = out.concat(", ")
                    }
                    out = out.concat(as_str(item))
                    idx = idx + 1_usize
                }
                None => {
                    break
                }
            }
        }
        out = out.concat("]")
        ret out
    }

    fn parse_type_text(mut self) -> String {
        let mut out = String::new()
        if self.curr_type() == TokenType::KW_MUT {
            self.consume()
            out = out.concat("mut ")
        }

        out = out.concat(as_str(self.parse_type_base_text()))

        loop {
            if self.curr_type() != TokenType::ASTERISK {
                break
            }
            out = out.concat(as_str(self.consume_value()))
        }

        if self.is_smart_pointer_suffix() {
            self.expect(TokenType::LESS)
            let pointer = self.expect_value(TokenType::IDENTIFIER)
            self.expect(TokenType::GREATER)
            out = out.concat("<")
            out = out.concat(as_str(pointer))
            out = out.concat(">")
        }
        elif self.curr_type() == TokenType::AMPERSAND {
            out = out.concat(as_str(self.consume_value()))
        }

        ret out
    }

    fn parse_type_base_text(mut self) -> String {
        if self.curr_type() == TokenType::LEFT_PAREN {
            let mut out = String::from_str("(")
            self.consume()
            if self.curr_type() != TokenType::RIGHT_PAREN {
                loop {
                    out = out.concat(as_str(self.parse_type_text()))
                    if self.curr_type() != TokenType::COMMA {
                        break
                    }
                    out = out.concat(as_str(self.consume_value()))
                    if self.curr_type() == TokenType::RIGHT_PAREN {
                        break
                    }
                    out = out.concat(" ")
                }
            }
            self.expect(TokenType::RIGHT_PAREN)
            out = out.concat(")")
            ret out
        }

        if self.curr_type() == TokenType::LEFT_BRACKET {
            let mut out = String::from_str("[")
            self.consume()
            out = out.concat(as_str(self.parse_type_text()))
            self.expect(TokenType::SEMICOLON)
            out = out.concat("; ")
            out = out.concat(as_str(self.expect_value(TokenType::INTEGER)))
            self.expect(TokenType::RIGHT_BRACKET)
            out = out.concat("]")
            ret out
        }

        let mut out = self.expect_value(TokenType::IDENTIFIER)
        if self.curr_type() == TokenType::LEFT_BRACKET {
            out = out.concat(as_str(self.parse_generic_suffix_text()))
        }
        ret out
    }

    fn push_expr(mut self, expr: Expr) -> usize {
        let expr_id = self.exprs.len()
        self.exprs = self.exprs.push(expr)
        ret expr_id
    }

    fn is_assignment_operator(self, typ: TokenType) -> bool {
        ret typ == TokenType::ASSIGN ||
            typ == TokenType::PLUS_EQUAL ||
            typ == TokenType::MINUS_EQUAL ||
            typ == TokenType::ASTERISK_EQUAL ||
            typ == TokenType::SLASH_EQUAL ||
            typ == TokenType::PERCENT_EQUAL
    }

    fn is_smart_pointer_suffix(self) -> bool {
        if self.curr_type() != TokenType::LESS {
            ret false
        }
        let pointer = self.peek_nth(1_usize)
        let closer = self.peek_nth(2_usize)
        if pointer.type != TokenType::IDENTIFIER || closer.type != TokenType::GREATER {
            ret false
        }
        ret str_eq(as_str(pointer.value), "H") || str_eq(as_str(pointer.value), "S")
    }

    fn fail_current(mut self, message: str) -> () {
        let token = self.peek_curr()
        let mut out = String::from_str("Parser error: ")
        out = out.concat(message)
        out = out.concat(" at `")
        out = out.concat(as_str(token.value))
        out = out.concat("` (")
        out = out.concat(Debug::fmt(token.line))
        out = out.concat(":")
        out = out.concat(Debug::fmt(token.column))
        out = out.concat(")")
        println(as_str(out))
        self.failed = true
        ret ()
    }

    fn expect(mut self, expected: TokenType) -> Token {
        let token = self.consume()
        if token.type != expected {
            let mut out = String::from_str("Expected ")
            out = out.concat(Debug::fmt(expected))
            out = out.concat(", got ")
            out = out.concat(Debug::fmt(token.type))
            self.fail_current(as_str(out))
        }
        ret token
    }

    fn is_at_end(self) -> bool {
        ret self.consumed >= self.tokens.len()
    }

    fn curr_type(self) -> TokenType {
        let token = self.peek_curr()
        ret token.type
    }

    fn curr_ident_is(self, value: str) -> bool {
        let token = self.peek_curr()
        ret token.type == TokenType::IDENTIFIER && str_eq(as_str(token.value), value)
    }

    fn consume_value(mut self) -> String {
        let token = self.consume()
        ret token.value
    }

    fn expect_value(mut self, expected: TokenType) -> String {
        let token = self.expect(expected)
        ret token.value
    }

    fn peek_curr(self) -> Token {
        ret self.peek_nth(0_usize)
    }

    fn peek_nth(self, nth: usize) -> Token {
        match self.tokens.get(self.consumed + nth) {
            Some(token) => {
                ret token
            }
            None => {
                ret Token::new(TokenType::EOF, String::new(), 0_usize, 0_usize)
            }
        }
    }

    fn consume(mut self) -> Token {
        let token = self.peek_curr()
        if !self.is_at_end() {
            self.consumed = self.consumed + 1_usize
        }
        ret token
    }
}
