import std::fmt::Debug
import std::option::Option
import std::string::String
import std::vec::Vec

pub struct NamedField {
    name: String
    typ: String
}

pub struct StructSignature {
    name: String
    generics: Vec[String]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[String]
    is_tuple: bool
    is_unit: bool
}

pub struct ImportItem {
    is_public: bool
    path: String
}

pub struct FunctionParam {
    name: String
    typ: Option[String]
}

pub struct FunctionItem {
    is_public: bool
    is_extern: bool
    name: String
    generics: Vec[String]
    params: Vec[FunctionParam]
    ret_type: Option[String]
    body: Option[usize]
}

pub struct StructItem {
    is_public: bool
    signature: StructSignature
}

pub struct EnumItem {
    is_public: bool
    name: String
    generics: Vec[String]
    variants: Vec[StructSignature]
}

pub struct TraitItem {
    is_public: bool
    name: String
    generics: Vec[String]
    bases: Vec[String]
    methods: Vec[FunctionItem]
}

pub struct ImplItem {
    generics: Vec[String]
    trait_name: Option[String]
    target: String
    methods: Vec[FunctionItem]
}

pub enum Item {
    Import(ImportItem)
    Function(FunctionItem)
    Struct(StructItem)
    Enum(EnumItem)
    Trait(TraitItem)
    Impl(ImplItem)
}

pub struct Block {
    statements: Vec[Statement]
}

pub struct LetStmt {
    name: String
    typ: Option[String]
    expr: usize
    is_mut: bool
}

pub struct AssignmentStmt {
    target: usize
    operator: String
    expr: usize
}

pub struct IfBranch {
    condition: usize
    body: usize
}

pub struct IfStmt {
    branches: Vec[IfBranch]
    else_body: Option[usize]
}

pub struct MatchPattern {
    path: Option[String]
    binding: Option[String]
}

pub struct MatchArm {
    pattern: MatchPattern
    body: usize
}

pub struct MatchStmt {
    expr: usize
    arms: Vec[MatchArm]
}

pub struct WhileStmt {
    condition: usize
    body: usize
}

pub struct LoopStmt {
    body: usize
}

pub struct DoWhileStmt {
    body: usize
    condition: usize
}

pub enum Statement {
    Let(LetStmt)
    Ret(usize)
    Expr(usize)
    If(IfStmt)
    Match(MatchStmt)
    Assignment(AssignmentStmt)
    While(WhileStmt)
    Loop(LoopStmt)
    DoWhile(DoWhileStmt)
    Break
    Continue
}

pub struct UnaryExpr {
    operator: String
    expr: usize
}

pub struct BinaryExpr {
    lhs: usize
    operator: String
    rhs: usize
}

pub struct CallExpr {
    callee: usize
    args: Vec[usize]
}

pub struct FieldExpr {
    base: usize
    field: String
}

pub struct MethodCallExpr {
    receiver: usize
    method: String
    args: Vec[usize]
}

pub struct MatchExprArm {
    pattern: MatchPattern
    expr: usize
}

pub struct MatchExpr {
    expr: usize
    arms: Vec[MatchExprArm]
}

pub struct StructInitExpr {
    path: String
    values: Vec[usize]
}

pub struct TupleLiteralExpr {
    items: Vec[usize]
}

pub enum Expr {
    Path(String)
    Boolean(bool)
    Integer(String)
    Float(String)
    StringLiteral(String)
    Parenthesized(usize)
    TupleLiteral(TupleLiteralExpr)
    Block(usize)
    Unary(UnaryExpr)
    Binary(BinaryExpr)
    Call(CallExpr)
    Field(FieldExpr)
    MethodCall(MethodCallExpr)
    Match(MatchExpr)
    StructInit(StructInitExpr)
}

pub struct Ast {
    items: Vec[Item]
    blocks: Vec[Block]
    exprs: Vec[Expr]
}

impl for Ast {
    pub fn new() -> Ast {
        ret Ast{Vec[Item]::new(), Vec[Block]::new(), Vec[Expr]::new()}
    }
}

impl Debug for Ast {
    pub fn fmt(self: Ast) -> str {
        ret "<ast>"
    }
}
