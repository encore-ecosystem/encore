import std::option::Option
import std::string::String
import std::vec::Vec


pub struct FunctionParam {
    name: String
    typ: Option[String]
}

pub struct NamedField {
    name: String
    typ: String
}

pub struct EnumVariant {
    name: String
    generics: Vec[String]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[String]
    is_tuple: bool
    is_unit: bool
}

pub struct ImportStmt {
    is_public: bool
    path: String
}

pub struct StructStmt {
    is_public: bool
    name: String
    generics: Vec[String]
    named_fields: Vec[NamedField]
    tuple_fields: Vec[String]
    is_tuple: bool
    is_unit: bool
}

pub struct EnumStmt {
    is_public: bool
    name: String
    generics: Vec[String]
    variants: Vec[EnumVariant]
}

pub struct FunctionItem {
    is_public: bool
    is_extern: bool
    name: String
    generics: Vec[String]
    params: Vec[FunctionParam]
    ret_type: Option[String]
    body: Option[Block]
}

pub struct TraitStmt {
    is_public: bool
    name: String
    generics: Vec[String]
    bases: Vec[String]
    methods: Vec[FunctionItem]
}

pub struct ImplStmt {
    generics: Vec[String]
    trait_name: Option[String]
    trait_args: Vec[String]
    target: String
    methods: Vec[FunctionItem]
}

pub struct MatchPattern {
    kind: String
    value: Option[String]
    binding: Option[String]
}

pub struct ExprNode {
    value: Expr
}

pub struct Block {
    statements: Vec[Statement]
}

pub struct LetStmt {
    name: String
    typ: Option[String]
    expr: ExprNode
    is_mut: bool
}

pub struct AssignmentStmt {
    target: ExprNode
    operator: String
    expr: ExprNode
}

pub struct IfBranch {
    condition: ExprNode
    body: Block
}

pub struct IfStmt {
    branches: Vec[IfBranch]
    else_body: Option[Block]
}

pub enum MatchArmBody {
    Block(Block)
    Expr(ExprNode)
}

pub struct MatchArm {
    pattern: MatchPattern
    body: MatchArmBody
}

pub struct MatchStmt {
    expr: ExprNode
    arms: Vec[MatchArm]
}

pub struct WhileStmt {
    label: Option[String]
    condition: ExprNode
    body: Block
}

pub struct LoopStmt {
    label: Option[String]
    body: Block
}

pub struct DoWhileStmt {
    body: Block
    condition: ExprNode
}

pub struct EhirStmt {
    is_unsafe: bool
    body: String
}

pub struct UnaryExpr {
    operator: String
    expr: ExprNode<H>
}

pub struct BinaryExpr {
    lhs: ExprNode<H>
    operator: String
    rhs: ExprNode<H>
}

pub struct CallExpr {
    callee: ExprNode<H>
    generics: Vec[String]
    args: Vec[ExprNode]
}

pub struct FieldExpr {
    base: ExprNode<H>
    field: String
}

pub struct MethodCallExpr {
    receiver: ExprNode<H>
    method: String
    generics: Vec[String]
    args: Vec[ExprNode]
}

pub struct MatchExprArm {
    pattern: MatchPattern
    expr: ExprNode
}

pub struct MatchExpr {
    expr: ExprNode<H>
    arms: Vec[MatchExprArm]
}

pub struct StructInitExpr {
    path: String
    values: Vec[ExprNode]
}

pub struct TupleLiteralExpr {
    items: Vec[ExprNode]
}

pub struct ArrayLiteralExpr {
    items: Vec[ExprNode]
}

pub struct ArrayRepeatExpr {
    value: ExprNode<H>
    size: String
}

pub struct BlockExpr {
    statements: Vec[Statement]
    tail: ExprNode<H>
}

pub struct IfExprBranch {
    condition: ExprNode
    body: ExprNode
}

pub struct IfExpr {
    branches: Vec[IfExprBranch]
    else_body: ExprNode<H>
}

pub struct IndexExpr {
    base: ExprNode<H>
    index: ExprNode<H>
}

pub enum Statement {
    Import(ImportStmt)
    EnumItem(EnumStmt)
    Struct(StructStmt)
    Trait(TraitStmt)
    Impl(ImplStmt)
    Function(FunctionItem)
    Let(LetStmt)
    Ret(ExprNode)
    Expr(ExprNode)
    If(IfStmt)
    Match(MatchStmt)
    Assignment(AssignmentStmt)
    While(WhileStmt)
    Loop(LoopStmt)
    DoWhile(DoWhileStmt)
    Unsafe(Block)
    Ehir(EhirStmt)
    Break(Option[String])
    Continue(Option[String])
}

pub enum Expr {
    Path(String)
    Boolean(bool)
    Integer(String)
    Float(String)
    StringLiteral(String)
    Parenthesized(ExprNode<H>)
    TupleLiteral(TupleLiteralExpr)
    ArrayLiteral(ArrayLiteralExpr)
    ArrayRepeat(ArrayRepeatExpr)
    Block(BlockExpr)
    Unary(UnaryExpr)
    Binary(BinaryExpr)
    Call(CallExpr)
    Field(FieldExpr)
    MethodCall(MethodCallExpr)
    Match(MatchExpr)
    If(IfExpr)
    StructInit(StructInitExpr)
    Index(IndexExpr)
    Try(ExprNode<H>)
    Unsafe(Block)
}
