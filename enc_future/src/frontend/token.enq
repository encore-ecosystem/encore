pub enum TokenType {
    INTEGER
    FLOAT
    STRING
    IDENTIFIER

    KW_FN
    KW_STRUCT
    KW_TRAIT
    KW_ENUM
    KW_IMPL
    KW_FOR
    KW_LET
    KW_RET
    KW_WHILE
    KW_LOOP
    KW_DO
    KW_CONTINUE
    KW_BREAK
    KW_IF
    KW_ELIF
    KW_ELSE
    KW_MATCH
    KW_PUB
    KW_IMPORT
    KW_EXTERN
    KW_UNSAFE

    OP_SCOPE

    OP_PLUS
    OP_MINUS
    OP_MULTIPLY
    OP_DIVIDE
    OP_MODULO

    OP_EQUAL
    OP_NOT_EQUAL
    OP_LESS
    OP_GREATER
    OP_LESS_EQUAL
    OP_GREATER_EQUAL

    OP_AND
    OP_OR
    OP_NOT

    OP_BIT_AND
    OP_BIT_OR
    OP_BIT_XOR
    OP_BIT_NOT
    OP_LEFT_SHIFT
    OP_RIGHT_SHIFT

    OP_ASSIGN
    OP_PLUS_ASSIGN
    OP_MINUS_ASSIGN
    OP_MULT_ASSIGN
    OP_DIV_ASSIGN
    OP_MOD_ASSIGN
    OP_AND_ASSIGN
    OP_OR_ASSIGN
    OP_XOR_ASSIGN
    OP_LSHIFT_ASSIGN
    OP_RSHIFT_ASSIGN

    OP_INCREMENT
    OP_DECREMENT
    OP_TRY

    OP_ARROW
    OP_FAT_ARROW

    LEFT_PAREN
    RIGHT_PAREN
    LEFT_BRACE
    RIGHT_BRACE
    LEFT_BRACKET
    RIGHT_BRACKET
    COLON
    COMMA
    DOT
    ARROW

    WHITESPACE
    NEWLINE
    EOF
    UNKNOWN
}

pub struct Token {
    type: TokenType
    value: str
    line: usize
    column: usize
}

pub fn make_token(type: TokenType, value: str, line: usize, column: usize) -> Token {
    ret Token{type, value, line, column}
}

pub fn is_unknown(token_type: TokenType) -> bool {
    match token_type {
        UNKNOWN => {
            ret true
        }
        _ => {
            ret false
        }
    }
}

pub fn token_type_name(token_type: TokenType) -> str {
    match token_type {
        INTEGER => { ret "INTEGER" }
        FLOAT => { ret "FLOAT" }
        STRING => { ret "STRING" }
        IDENTIFIER => { ret "IDENTIFIER" }
        KW_FN => { ret "KW_FN" }
        KW_STRUCT => { ret "KW_STRUCT" }
        KW_TRAIT => { ret "KW_TRAIT" }
        KW_ENUM => { ret "KW_ENUM" }
        KW_IMPL => { ret "KW_IMPL" }
        KW_FOR => { ret "KW_FOR" }
        KW_LET => { ret "KW_LET" }
        KW_RET => { ret "KW_RET" }
        KW_WHILE => { ret "KW_WHILE" }
        KW_LOOP => { ret "KW_LOOP" }
        KW_DO => { ret "KW_DO" }
        KW_CONTINUE => { ret "KW_CONTINUE" }
        KW_BREAK => { ret "KW_BREAK" }
        KW_IF => { ret "KW_IF" }
        KW_ELIF => { ret "KW_ELIF" }
        KW_ELSE => { ret "KW_ELSE" }
        KW_MATCH => { ret "KW_MATCH" }
        KW_PUB => { ret "KW_PUB" }
        KW_IMPORT => { ret "KW_IMPORT" }
        KW_EXTERN => { ret "KW_EXTERN" }
        KW_UNSAFE => { ret "KW_UNSAFE" }
        OP_SCOPE => { ret "OP_SCOPE" }
        OP_PLUS => { ret "OP_PLUS" }
        OP_MINUS => { ret "OP_MINUS" }
        OP_MULTIPLY => { ret "OP_MULTIPLY" }
        OP_DIVIDE => { ret "OP_DIVIDE" }
        OP_MODULO => { ret "OP_MODULO" }
        OP_EQUAL => { ret "OP_EQUAL" }
        OP_NOT_EQUAL => { ret "OP_NOT_EQUAL" }
        OP_LESS => { ret "OP_LESS" }
        OP_GREATER => { ret "OP_GREATER" }
        OP_LESS_EQUAL => { ret "OP_LESS_EQUAL" }
        OP_GREATER_EQUAL => { ret "OP_GREATER_EQUAL" }
        OP_AND => { ret "OP_AND" }
        OP_OR => { ret "OP_OR" }
        OP_NOT => { ret "OP_NOT" }
        OP_BIT_AND => { ret "OP_BIT_AND" }
        OP_BIT_OR => { ret "OP_BIT_OR" }
        OP_BIT_XOR => { ret "OP_BIT_XOR" }
        OP_BIT_NOT => { ret "OP_BIT_NOT" }
        OP_LEFT_SHIFT => { ret "OP_LEFT_SHIFT" }
        OP_RIGHT_SHIFT => { ret "OP_RIGHT_SHIFT" }
        OP_ASSIGN => { ret "OP_ASSIGN" }
        OP_PLUS_ASSIGN => { ret "OP_PLUS_ASSIGN" }
        OP_MINUS_ASSIGN => { ret "OP_MINUS_ASSIGN" }
        OP_MULT_ASSIGN => { ret "OP_MULT_ASSIGN" }
        OP_DIV_ASSIGN => { ret "OP_DIV_ASSIGN" }
        OP_MOD_ASSIGN => { ret "OP_MOD_ASSIGN" }
        OP_AND_ASSIGN => { ret "OP_AND_ASSIGN" }
        OP_OR_ASSIGN => { ret "OP_OR_ASSIGN" }
        OP_XOR_ASSIGN => { ret "OP_XOR_ASSIGN" }
        OP_LSHIFT_ASSIGN => { ret "OP_LSHIFT_ASSIGN" }
        OP_RSHIFT_ASSIGN => { ret "OP_RSHIFT_ASSIGN" }
        OP_INCREMENT => { ret "OP_INCREMENT" }
        OP_DECREMENT => { ret "OP_DECREMENT" }
        OP_TRY => { ret "OP_TRY" }
        OP_ARROW => { ret "OP_ARROW" }
        OP_FAT_ARROW => { ret "OP_FAT_ARROW" }
        LEFT_PAREN => { ret "LEFT_PAREN" }
        RIGHT_PAREN => { ret "RIGHT_PAREN" }
        LEFT_BRACE => { ret "LEFT_BRACE" }
        RIGHT_BRACE => { ret "RIGHT_BRACE" }
        LEFT_BRACKET => { ret "LEFT_BRACKET" }
        RIGHT_BRACKET => { ret "RIGHT_BRACKET" }
        COLON => { ret "COLON" }
        COMMA => { ret "COMMA" }
        DOT => { ret "DOT" }
        ARROW => { ret "ARROW" }
        WHITESPACE => { ret "WHITESPACE" }
        NEWLINE => { ret "NEWLINE" }
