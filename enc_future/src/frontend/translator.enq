import std::vec::Vec

import mod::parser::statements::Statement

import ehir_core::Module
import ehir_core::ModuleBuilder


pub fn translate_module(module_name: str, ast: Vec[Statement]) -> Module {
    // Stub translator for self-hosted bootstrap stage.
    let _ast = ast
    let builder = ModuleBuilder::new(module_name)
    ret ModuleBuilder::finish(builder)
}
