import core::fmt::Debug
import core::option::Option
import std::vec::Vec

import ehir_core::*
import mod::parser::statements::*


pub struct ImportItem {
    prefix: Vec[str]
    symbol: str
    alias: Option[str]
    is_public: bool
}

pub struct StructFieldInfo {
    name: str
    typ: str
}

pub struct StructInfo {
    name: str
    generics: Vec[str]
    fields: Vec[StructFieldInfo]
}

pub struct EnumVariantInfo {
    name: str
    payload_type: Option[str]
}

pub struct EnumInfo {
    name: str
    generics: Vec[str]
    variants: Vec[EnumVariantInfo]
}

pub struct FunctionSignature {
    name: str
    ret_type: Option[str]
}

pub struct LocalBinding {
    name: str
    value: Variable
}

pub struct FunctionTranslator {
    builder: mut FunctionBuilder
    locals: Vec[LocalBinding]
    structs: Vec[StructInfo]
    enums: Vec[EnumInfo]
    signatures: Vec[FunctionSignature]
    current_self_type: Option[str]
    next_label_index: usize
    next_name_index: usize
    terminated: bool
    loop_break_label: Option[str]
    loop_continue_label: Option[str]
}

pub fn translate_module(module_name: str, ast: Vec[Statement]) -> Module {
    let structs = collect_struct_infos(ast)
    let enums = collect_enum_infos(ast)
    let signatures = collect_function_signatures(ast)

    let mut builder = ModuleBuilder::new(module_name)
    let mut index = 0_usize

    loop {
        match ast.get(index) {
            Some(stmt) => {
                translate_top_level_statement(builder, stmt, structs, enums, signatures)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret ModuleBuilder::finish(builder)
}

fn translate_top_level_statement(
    builder: mut ModuleBuilder,
    stmt: Statement,
    structs: Vec[StructInfo],
    enums: Vec[EnumInfo],
    signatures: Vec[FunctionSignature]
) -> () {
    match stmt {
        Statement::Import(import_stmt) => {
            let items = expand_import_stmt(import_stmt)
            let mut index = 0_usize
            loop {
                match items.get(index) {
                    Some(item) => {
                        let import_directive = Directive::Import(ImportDirective{item.prefix, item.symbol, item.alias, item.is_public})
                        builder.push(import_directive)
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }
        }
        Statement::Struct(struct_stmt) => {
            builder.push(translate_struct_stmt(struct_stmt))
        }
        Statement::EnumItem(enum_stmt) => {
            let directives = translate_enum_stmt(enum_stmt)
            let mut index = 0_usize
            loop {
                match directives.get(index) {
                    Some(enum_directive_item) => {
                        builder.push(enum_directive_item)
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }
        }
        Statement::Trait(trait_stmt) => {
            builder.push(translate_trait_stmt(trait_stmt))
        }
        Statement::Impl(impl_stmt) => {
            translate_impl_stmt(builder, impl_stmt, structs, enums, signatures)
        }
        Statement::Function(function_stmt) => {
            builder.push(Directive::Function(translate_function_item(function_stmt, Option[str]::None, function_stmt.name, structs, enums, signatures)))
        }
        _ => {}
    }

    ret ()
}

fn translate_struct_stmt(stmt: StructStmt) -> Directive {
    let mut fields = Vec[Parameter]::new()

    if stmt.is_tuple {
        let mut index = 0_usize
        loop {
            match stmt.tuple_fields.get(index) {
                Some(field_type) => {
                    fields = fields.push(param(tuple_field_name(index), lower_type_text(field_type, Option[str]::None)))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
    } else {
        let mut index = 0_usize
        loop {
            match stmt.named_fields.get(index) {
                Some(field) => {
                    fields = fields.push(param(field.name, lower_type_text(field.typ, Option[str]::None)))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
    }

    ret struct_directive(stmt.name, lower_type_generics(stmt.generics, Option[str]::None), fields)
}

fn translate_enum_stmt(stmt: EnumStmt) -> Vec[Directive] {
    let mut directives = Vec[Directive]::new()
    let mut variants = Vec[EnumVariant]::new()
    let mut index = 0_usize

    loop {
        match stmt.variants.get(index) {
            Some(variant) => {
                let payload_info = lower_enum_variant_payload(stmt.name, stmt.generics, variant)
                let payload_type = payload_info.payload_type

                let mut payload_index = 0_usize
                loop {
                    match payload_info.payload_structs.get(payload_index) {
                        Some(payload_struct) => {
                            directives = directives.push(payload_struct)
                            payload_index = payload_index + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }

                let lowered_payload = match payload_type {
                    Some(payload_text) => {
                        Option[Type]::Some(lower_type_text(payload_text, Option[str]::None))
                    }
                    None => {
                        Option[Type]::None
                    }
                }

                variants = variants.push(enum_variant(variant.name, lowered_payload))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    directives = directives.push(enum_directive(stmt.name, lower_type_generics(stmt.generics, Option[str]::None), variants))
    ret directives
}

fn translate_trait_stmt(stmt: TraitStmt) -> Directive {
    let mut methods = Vec[TraitMethod]::new()
    let mut index = 0_usize

    loop {
        match stmt.methods.get(index) {
            Some(method) => {
                methods = methods.push(
                    trait_method(
                        method.name,
                        lower_type_generics(method.generics, Option[str]::None),
                        lower_params(method.params, Option[str]::None),
                        lower_return_type(method.ret_type, Option[str]::None)
                    )
                )
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret trait_directive(stmt.name, lower_type_generics(stmt.generics, Option[str]::None), methods)
}

fn translate_impl_stmt(
    builder: mut ModuleBuilder,
    stmt: ImplStmt,
    structs: Vec[StructInfo],
    enums: Vec[EnumInfo],
    signatures: Vec[FunctionSignature]
) -> () {
    match stmt.trait_name {
        Some(trait_name) => {
            let mut methods = Vec[FnDirective]::new()
            let mut index = 0_usize
            loop {
                match stmt.methods.get(index) {
                    Some(method) => {
                        methods = methods.push(
                            translate_function_item(method, Option[str]::Some(stmt.target), method.name, structs, enums, signatures)
                        )
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }

            builder.push(
                impl_directive(
                    lower_type_generics(stmt.generics, Option[str]::Some(stmt.target)),
                    trait_name,
                    lower_type_generics(stmt.trait_args, Option[str]::Some(stmt.target)),
                    lower_type_text(stmt.target, Option[str]::Some(stmt.target)),
                    methods
                )
            )
        }
        None => {
            let prefix = base_type_name(stmt.target, Option[str]::Some(stmt.target))
            let mut index = 0_usize
            loop {
                match stmt.methods.get(index) {
                    Some(method) => {
                        let function_name = prefix + "::" + method.name
                        builder.push(
                            Directive::Function(
                                translate_function_item(method, Option[str]::Some(stmt.target), function_name, structs, enums, signatures)
                            )
                        )
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }
        }
    }

    ret ()
}

fn translate_function_item(
    stmt: FunctionItem,
    current_self_type: Option[str],
    lowered_name: str,
    structs: Vec[StructInfo],
    enums: Vec[EnumInfo],
    signatures: Vec[FunctionSignature]
) -> FnDirective {
    let generics = lower_type_generics(stmt.generics, current_self_type)
    let params = lower_params(stmt.params, current_self_type)
    let ret_type = lower_return_type(stmt.ret_type, current_self_type)

    if stmt.is_extern {
        let mut builder = FunctionBuilder::new_extern(lowered_name, generics, params, ret_type)
        ret FunctionBuilder::finish(builder)
    }

    let mut translator = FunctionTranslator::new(lowered_name, generics, params, ret_type, structs, enums, signatures, current_self_type)
    match stmt.body {
        Some(body) => {
            translator.translate_root_block(body)
        }
        None => {}
    }
    ret translator.finish()
}

impl for FunctionTranslator {
    pub fn new(
        name: str,
        generics: Vec[Type],
        params: Vec[Parameter],
        ret_type: Type,
        structs: Vec[StructInfo],
        enums: Vec[EnumInfo],
        signatures: Vec[FunctionSignature],
        current_self_type: Option[str]
    ) -> FunctionTranslator {
        let mut locals = Vec[LocalBinding]::new()
        let mut index = 0_usize
        loop {
            match params.get(index) {
                Some(parameter) => {
                    locals = push_binding(locals, parameter.name, var(parameter.name, parameter.typ))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        let mut builder = FunctionBuilder::new(name, generics, params, ret_type)
        let mut out = FunctionTranslator{
            builder,
            locals,
            structs,
            enums,
            signatures,
            current_self_type,
            0_usize,
            0_usize,
            false,
            Option[str]::None,
            Option[str]::None
        }
        out.builder.start_block("entry")
        ret out
    }

    pub fn finish(mut self) -> FnDirective {
        if !self.terminated {
            let fallback = self.default_value_for_type(self.builder.ret_type, "ret")
            self.builder.terminate(ret_term(fallback))
            self.terminated = true
        }
        let mut builder: FunctionBuilder = self.builder
        ret FunctionBuilder::finish(builder)
    }

    fn translate_root_block(mut self, block: ParsedBlock) -> () {
        let mut index = 0_usize
        loop {
            match block.statements.get(index) {
                Some(stmt) => {
                    self.translate_statement(stmt)
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret ()
    }

    fn translate_statement(mut self, stmt: Statement) -> () {
        if self.terminated {
            ret ()
        }

        match stmt {
            Statement::Let(let_stmt) => {
                self.translate_let(let_stmt)
            }
            Statement::Ret(expr) => {
                let value = self.translate_expression_with_hint(expr, "ret", Option[Type]::Some(self.builder.ret_type))
                self.builder.terminate(ret_term(value))
                self.terminated = true
            }
            Statement::Expr(expr) => {
                let _value = self.translate_expression(expr, "expr")
            }
            Statement::Assignment(assign_stmt) => {
                self.translate_assignment(assign_stmt)
            }
            Statement::If(if_stmt) => {
                self.translate_if_statement(if_stmt)
            }
            Statement::Match(match_stmt) => {
                self.translate_match_statement(match_stmt)
            }
            Statement::While(while_stmt) => {
                self.translate_while_statement(while_stmt)
            }
            Statement::Loop(loop_stmt) => {
                self.translate_loop_statement(loop_stmt)
            }
            Statement::DoWhile(do_stmt) => {
                self.translate_do_while_statement(do_stmt)
            }
            Statement::Unsafe(block) => {
                self.translate_scoped_block(block)
            }
            Statement::Ehir(ehir_stmt) => {
                self.translate_ehir_stmt(ehir_stmt)
            }
            Statement::Break(label) => {
                self.translate_break(label)
            }
            Statement::Continue(label) => {
                self.translate_continue(label)
            }
            _ => {
                self.builder.emit(comment("unsupported statement"))
            }
        }

        ret ()
    }

    fn translate_let(mut self, stmt: LetStmt) -> () {
        let hint = match stmt.typ {
            Some(declared_type_text) => {
                Option[Type]::Some(lower_type_text(declared_type_text, self.current_self_type))
            }
            None => {
                Option[Type]::None
            }
        }

        let value = self.translate_expression_with_hint(stmt.expr, stmt.name, hint)
        let bound = match hint {
            Some(hint_type) => {
                Variable{value.name, Option[Type]::Some(hint_type)}
            }
            None => {
                value
            }
        }

        self.bind_local(stmt.name, bound)
        ret ()
    }

    fn translate_assignment(mut self, stmt: AssignmentStmt) -> () {
        match logical_expr_name(stmt.target) {
            Some(target_name) => {
                let preferred = assignment_preferred_name(target_name)
                let current_value = self.translate_expression(stmt.target, "assign_lhs")
                let rhs = self.translate_expression(stmt.expr, preferred)
                let next = if stmt.operator == "=" {
                    rhs
                } else {
                    let op = compound_assignment_operator(stmt.operator)
                    self.translate_binary_from_values(current_value, op, rhs, preferred, current_value.typ)
                }
                self.bind_local(target_name, next)
            }
            None => {
                self.builder.emit(comment("unsupported assignment target"))
            }
        }
        ret ()
    }

    fn translate_if_statement(mut self, stmt: IfStmt) -> () {
        let end_label = self.fresh_label("if_end")
        let mut next_false_label = ""
        let mut branch_index = 0_usize

        loop {
            match stmt.branches.get(branch_index) {
                Some(branch) => {
                    let then_label = self.fresh_label("if_then")
                    let has_more = branch_index + 1_usize < stmt.branches.len()
                    let false_label = if has_more || has_some_block(stmt.else_body) {
                        self.fresh_label("if_else")
                    } else {
                        end_label
                    }

                    let condition = self.translate_expression(branch.condition, "if_cond")
                    self.builder.terminate(cbr_term(condition, then_label, false_label))
                    self.terminated = true

                    self.start_named_block(then_label)
                    let saved_locals = self.locals
                    self.translate_root_block(branch.body)
                    self.locals = saved_locals
                    if !self.terminated {
                        self.builder.terminate(br_term(end_label))
                        self.terminated = true
                    }

                    next_false_label = false_label
                    branch_index = branch_index + 1_usize

                    if has_more {
                        self.start_named_block(next_false_label)
                    }
                }
                None => {
                    break
                }
            }
        }

        match stmt.else_body {
            Some(else_body) => {
                self.start_named_block(next_false_label)
                let saved_locals = self.locals
                self.translate_root_block(else_body)
                self.locals = saved_locals
                if !self.terminated {
                    self.builder.terminate(br_term(end_label))
                    self.terminated = true
                }
            }
            None => {
                if next_false_label != "" && next_false_label != end_label && !self.terminated {
                    self.builder.terminate(br_term(end_label))
                    self.terminated = true
                }
            }
        }

        self.start_named_block(end_label)
        ret ()
    }

    fn translate_match_statement(mut self, stmt: MatchStmt) -> () {
        let scrutinee = self.translate_expression(stmt.expr, "match_scrutinee")
        let end_label = self.fresh_label("match_end")

        if should_use_switch(stmt.arms) {
            self.translate_switch_statement(scrutinee, stmt.arms, end_label)
        } else {
            self.translate_enum_match_statement(scrutinee, stmt.arms, end_label)
        }

        self.start_named_block(end_label)
        ret ()
    }

    fn translate_switch_statement(mut self, scrutinee: Variable, arms: Vec[ParsedMatchArm], end_label: str) -> () {
        let mut default_label = end_label
        let mut cases = Vec[SwitchCase]::new()
        let mut labels = Vec[str]::new()

        let mut index = 0_usize
        loop {
            match arms.get(index) {
                Some(arm) => {
                    if arm.pattern.kind == "wildcard" {
                        default_label = self.fresh_label("match_default")
                        labels = labels.push(default_label)
                    } else {
                        let arm_label_text = self.fresh_label("match_arm")
                        labels = labels.push(arm_label_text)
                        match arm.pattern.value {
                            Some(case_value_text) => {
                                cases = cases.push(switch_case(case_value_text, arm_label_text))
                            }
                            None => {}
                        }
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        self.builder.terminate(switch_term(scrutinee, default_label, cases))
        self.terminated = true

        let mut arm_index = 0_usize
        let mut label_index = 0_usize
        loop {
            match arms.get(arm_index) {
                Some(arm) => {
                    match labels.get(label_index) {
                        Some(arm_label_ref) => {
                            self.start_named_block(arm_label_ref)
                            self.translate_match_statement_arm(arm, Option[Variable]::None, end_label)
                            label_index = label_index + 1_usize
                        }
                        None => {}
                    }
                    arm_index = arm_index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        if default_label == end_label {
            ret ()
        }
        ret ()
    }

    fn translate_enum_match_statement(mut self, scrutinee: Variable, arms: Vec[ParsedMatchArm], end_label: str) -> () {
        let mut default_label = end_label
        let mut lowered_arms = Vec[MatchArm]::new()
        let mut labels = Vec[str]::new()
        let mut payloads = Vec[Option[Variable]]::new()

        let mut index = 0_usize
        loop {
            match arms.get(index) {
                Some(arm) => {
                    if arm.pattern.kind == "wildcard" {
                        default_label = self.fresh_label("match_default")
                        labels = labels.push(default_label)
                        payloads = payloads.push(Option[Variable]::None)
                    } else {
                        let arm_label_text = self.fresh_label("match_arm")
                        let payload = match arm.pattern.binding {
                            Some(binding_name) => {
                                Option[Variable]::Some(untyped_var(binding_name))
                            }
                            None => {
                                Option[Variable]::None
                            }
                        }
                        labels = labels.push(arm_label_text)
                        payloads = payloads.push(payload)
                        lowered_arms = lowered_arms.push(match_arm(last_scope_segment(pattern_value_or_empty(arm.pattern)), payload, arm_label_text))
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        self.builder.terminate(match_term(scrutinee, default_label, lowered_arms))
        self.terminated = true

        let mut arm_index = 0_usize
        let mut label_index = 0_usize
        loop {
            match arms.get(arm_index) {
                Some(arm) => {
                    match labels.get(label_index) {
                        Some(arm_label_ref) => {
                            let payload = get_optional_variable(payloads, label_index)
                            self.start_named_block(arm_label_ref)
                            self.translate_match_statement_arm(arm, payload, end_label)
                            label_index = label_index + 1_usize
                        }
                        None => {}
                    }
                    arm_index = arm_index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        ret ()
    }

    fn translate_match_statement_arm(mut self, arm: ParsedMatchArm, payload: Option[Variable], end_label: str) -> () {
        let saved_locals = self.locals
        match arm.pattern.binding {
            Some(binding_name) => {
                match payload {
                    Some(payload_var) => {
                        self.bind_local(binding_name, payload_var)
                    }
                    None => {}
                }
            }
            None => {}
        }

        match arm.body {
            MatchArmBody::Block(block) => {
                self.translate_root_block(block)
            }
            MatchArmBody::Expr(expr) => {
                let _value = self.translate_expression(expr, "match_expr")
            }
        }

        self.locals = saved_locals
        if !self.terminated {
            self.builder.terminate(br_term(end_label))
            self.terminated = true
        }
        ret ()
    }

    fn translate_while_statement(mut self, stmt: WhileStmt) -> () {
        let cond_label = self.fresh_label("while_cond")
        let body_label = self.fresh_label("while_body")
        let end_label = self.fresh_label("while_end")

        self.builder.terminate(br_term(cond_label))
        self.terminated = true

        self.start_named_block(cond_label)
        let condition = self.translate_expression(stmt.condition, "while_cond")
        self.builder.terminate(cbr_term(condition, body_label, end_label))
        self.terminated = true

        let saved_break = self.loop_break_label
        let saved_continue = self.loop_continue_label
        self.loop_break_label = Option[str]::Some(end_label)
        self.loop_continue_label = Option[str]::Some(cond_label)

        self.start_named_block(body_label)
        let saved_locals = self.locals
        self.translate_root_block(stmt.body)
        self.locals = saved_locals
        if !self.terminated {
            self.builder.terminate(br_term(cond_label))
            self.terminated = true
        }

        self.loop_break_label = saved_break
        self.loop_continue_label = saved_continue

        self.start_named_block(end_label)
        ret ()
    }

    fn translate_loop_statement(mut self, stmt: LoopStmt) -> () {
        let body_label = self.fresh_label("loop_body")
        let end_label = self.fresh_label("loop_end")

        self.builder.terminate(br_term(body_label))
        self.terminated = true

        let saved_break = self.loop_break_label
        let saved_continue = self.loop_continue_label
        self.loop_break_label = Option[str]::Some(end_label)
        self.loop_continue_label = Option[str]::Some(body_label)

        self.start_named_block(body_label)
        let saved_locals = self.locals
        self.translate_root_block(stmt.body)
        self.locals = saved_locals
        if !self.terminated {
            self.builder.terminate(br_term(body_label))
            self.terminated = true
        }

        self.loop_break_label = saved_break
        self.loop_continue_label = saved_continue

        self.start_named_block(end_label)
        ret ()
    }

    fn translate_do_while_statement(mut self, stmt: DoWhileStmt) -> () {
        let body_label = self.fresh_label("do_body")
        let cond_label = self.fresh_label("do_cond")
        let end_label = self.fresh_label("do_end")

        self.builder.terminate(br_term(body_label))
        self.terminated = true

        let saved_break = self.loop_break_label
        let saved_continue = self.loop_continue_label
        self.loop_break_label = Option[str]::Some(end_label)
        self.loop_continue_label = Option[str]::Some(cond_label)

        self.start_named_block(body_label)
        let saved_locals = self.locals
        self.translate_root_block(stmt.body)
        self.locals = saved_locals
        if !self.terminated {
            self.builder.terminate(br_term(cond_label))
            self.terminated = true
        }

        self.start_named_block(cond_label)
        let condition = self.translate_expression(stmt.condition, "do_cond")
        self.builder.terminate(cbr_term(condition, body_label, end_label))
        self.terminated = true

        self.loop_break_label = saved_break
        self.loop_continue_label = saved_continue

        self.start_named_block(end_label)
        ret ()
    }

    fn translate_break(mut self, label: Option[str]) -> () {
        match label {
            Some(named) => {
                self.builder.terminate(br_term(named))
                self.terminated = true
            }
            None => {
                match self.loop_break_label {
                    Some(loop_label) => {
                        self.builder.terminate(br_term(loop_label))
                        self.terminated = true
                    }
                    None => {
                        self.builder.emit(comment("break outside loop"))
                    }
                }
            }
        }
        ret ()
    }

    fn translate_continue(mut self, label: Option[str]) -> () {
        match label {
            Some(named) => {
                self.builder.terminate(br_term(named))
                self.terminated = true
            }
            None => {
                match self.loop_continue_label {
                    Some(loop_label) => {
                        self.builder.terminate(br_term(loop_label))
                        self.terminated = true
                    }
                    None => {
                        self.builder.emit(comment("continue outside loop"))
                    }
                }
            }
        }
        ret ()
    }

    fn translate_scoped_block(mut self, block: ParsedBlock) -> () {
        let saved_locals = self.locals
        self.translate_root_block(block)
        self.locals = saved_locals
        ret ()
    }

    fn translate_expression(mut self, expr: ExprNode, preferred_name: str) -> Variable {
        ret self.translate_expression_with_hint(expr, preferred_name, Option[Type]::None)
    }

    fn translate_boxed_expression(mut self, expr: ExprNode<H>, preferred_name: str) -> Variable {
        ret self.translate_expression(unbox_expr(expr), preferred_name)
    }

    fn translate_boxed_expression_with_hint(mut self, expr: ExprNode<H>, preferred_name: str, hint: Option[Type]) -> Variable {
        ret self.translate_expression_with_hint(unbox_expr(expr), preferred_name, hint)
    }

    fn translate_expression_with_hint(mut self, expr: ExprNode, preferred_name: str, hint: Option[Type]) -> Variable {
        match expr.value {
            Expr::Path(path) => {
                match self.lookup_local(path) {
                    Some(local) => {
                        ret with_fallback_type(local, hint)
                    }
                    None => {
                        match try_split_enum_constructor_path(path) {
                            Some(ctor) => {
                                let out_type = with_hint_type(lower_type_text(ctor.enum_type, self.current_self_type), hint)
                                let out = self.fresh_value(preferred_name, Option[Type]::Some(out_type))
                                self.builder.emit(lceos(out, enum_value(out_type.name, out_type.generics, ctor.variant, Option[Variable]::None)))
                                ret out
                            }
                            None => {
                                ret with_fallback_type(untyped_var(path), hint)
                            }
                        }
                    }
                }
            }
            Expr::Boolean(flag) => {
                let raw = if flag { "true" } else { "false" }
                let out = self.fresh_value(preferred_name, fallback_type(hint, Option[Type]::Some(plain_type("bool", Vec[Type]::new()))))
                self.builder.emit(lcpos(out, raw))
                ret out
            }
            Expr::Integer(integer_text) => {
                let out = self.fresh_value(preferred_name, fallback_type(hint, infer_integer_type(integer_text)))
                self.builder.emit(lcpos(out, integer_text))
                ret out
            }
            Expr::Float(float_text) => {
                let out = self.fresh_value(preferred_name, fallback_type(hint, infer_float_type(float_text)))
                self.builder.emit(lcpos(out, float_text))
                ret out
            }
            Expr::StringLiteral(string_text) => {
                let out = self.fresh_value(preferred_name, fallback_type(hint, Option[Type]::Some(plain_type("str", Vec[Type]::new()))))
                self.builder.emit(lcpos(out, string_text))
                ret out
            }
            Expr::Parenthesized(inner) => {
                ret self.translate_boxed_expression_with_hint(inner, preferred_name, hint)
            }
            Expr::Unary(unary_expr) => {
                ret self.translate_unary_expr(unary_expr, preferred_name, hint)
            }
            Expr::Binary(binary_expr) => {
                let lhs = self.translate_boxed_expression(binary_expr.lhs, preferred_name + "_lhs")
                let rhs = self.translate_boxed_expression(binary_expr.rhs, preferred_name + "_rhs")
                ret self.translate_binary_from_values(lhs, binary_expr.operator, rhs, preferred_name, hint)
            }
            Expr::Call(call_expr) => {
                ret self.translate_call_expr(call_expr, preferred_name, hint)
            }
            Expr::Field(field_expr) => {
                ret self.translate_field_expr(field_expr, preferred_name, hint)
            }
            Expr::MethodCall(method_expr) => {
                ret self.translate_method_call_expr(method_expr, preferred_name, hint)
            }
            Expr::Match(match_expr) => {
                ret self.translate_match_expr(match_expr, preferred_name, hint)
            }
            Expr::StructInit(init_expr) => {
                ret self.translate_struct_init_expr(init_expr, preferred_name, hint)
            }
            Expr::Block(block_expr) => {
                ret self.translate_block_expr(block_expr, preferred_name, hint)
            }
            Expr::If(if_expr) => {
                ret self.translate_if_expr(if_expr, preferred_name, hint)
            }
            Expr::Unsafe(block) => {
                let block_value = self.translate_block_expr(BlockExpr{block.statements, box_expr(expr)}, preferred_name, hint)
                ret block_value
            }
            Expr::TupleLiteral(tuple_expr) => {
                ret self.translate_collection_expr(tuple_expr.items, preferred_name, hint, "tuple literal")
            }
            Expr::ArrayLiteral(array_expr) => {
                ret self.translate_collection_expr(array_expr.items, preferred_name, hint, "array literal")
            }
            Expr::ArrayRepeat(array_repeat_expr) => {
                let _value = self.translate_boxed_expression(array_repeat_expr.value, preferred_name + "_item")
                self.builder.emit(comment("array repeat lowered as placeholder"))
                ret self.fresh_value(preferred_name, hint)
            }
            Expr::Index(index_expr) => {
                let base = self.translate_boxed_expression(index_expr.base, preferred_name + "_base")
                let index = self.translate_boxed_expression(index_expr.index, preferred_name + "_index")
                let out = self.fresh_value(preferred_name, hint)
                self.builder.emit(comment("index expression"))
                self.builder.emit(call(out, "__encore_index", Vec[Type]::new(), Vec[Variable]::new().push(base).push(index), false))
                ret out
            }
            Expr::Try(inner) => {
                self.builder.emit(comment("try expression lowered as passthrough"))
                ret self.translate_boxed_expression_with_hint(inner, preferred_name, hint)
            }
        }
    }

    fn translate_unary_expr(mut self, unary_expr: UnaryExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let value = self.translate_boxed_expression(unary_expr.expr, preferred_name + "_inner")
        if unary_expr.operator == "+" {
            ret value
        }
        if unary_expr.operator == "-" {
            let zero = self.default_zero_like(value.typ, preferred_name + "_zero")
            ret self.translate_binary_from_values(zero, "-", value, preferred_name, hint)
        }
        self.builder.emit(comment("unsupported unary operator " + unary_expr.operator))
        ret with_fallback_type(value, hint)
    }

    fn translate_call_expr(mut self, call_expr: CallExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        match call_expr.callee.value {
            Expr::Path(path) => {
                match try_split_enum_constructor_path(path) {
                    Some(ctor) => {
                        ret self.translate_enum_constructor_call(ctor.enum_type, ctor.variant, call_expr.args, preferred_name, hint)
                    }
                    None => {}
                }

                let args = self.translate_expr_args(call_expr.args, preferred_name)
                let ret_hint = fallback_type(hint, self.lookup_signature_return_type(path))
                let out = self.fresh_value(preferred_name, ret_hint)
                self.builder.emit(call(out, path, lower_type_generics(call_expr.generics, self.current_self_type), args, false))
                ret out
            }
            _ => {
                let callee = self.translate_boxed_expression(call_expr.callee, preferred_name + "_callee")
                let mut args = Vec[Variable]::new()
                args = args.push(callee)
                args = append_variables(args, self.translate_expr_args(call_expr.args, preferred_name))
                let out = self.fresh_value(preferred_name, hint)
                self.builder.emit(call(out, "__encore_call", lower_type_generics(call_expr.generics, self.current_self_type), args, false))
                ret out
            }
        }
    }

    fn translate_method_call_expr(mut self, method_expr: MethodCallExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let receiver = self.translate_boxed_expression(method_expr.receiver, method_expr.method + "_self")
        let mut args = Vec[Variable]::new()
        args = args.push(receiver)
        args = append_variables(args, self.translate_expr_args(method_expr.args, preferred_name))

        let call_name = self.resolve_method_name(receiver, method_expr.method)
        let ret_hint = fallback_type(hint, self.lookup_signature_return_type(call_name))
        let out = self.fresh_value(preferred_name, ret_hint)
        self.builder.emit(call(out, call_name, lower_type_generics(method_expr.generics, self.current_self_type), args, false))
        ret out
    }

    fn translate_field_expr(mut self, field_expr: FieldExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let logical_name = field_logical_name_boxed(field_expr.base, field_expr.field)
        match logical_name {
            Some(full_name) => {
                match self.lookup_local(full_name) {
                    Some(local) => {
                        ret with_fallback_type(local, hint)
                    }
                    None => {}
                }
            }
            None => {}
        }

        let base = self.translate_boxed_expression(field_expr.base, preferred_name + "_base")
        let field_type = fallback_type(hint, self.lookup_field_type(base, field_expr.field))
        let out = self.fresh_value(preferred_name, field_type)
        self.builder.emit(getfield(out, base, untyped_var(field_expr.field)))
        ret out
    }

    fn translate_struct_init_expr(mut self, init_expr: StructInitExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let args = self.translate_expr_args(init_expr.values, preferred_name)
        let init_type = lower_type_text(init_expr.path, self.current_self_type)
        let out = self.fresh_value(preferred_name, fallback_type(hint, Option[Type]::Some(init_type)))
        self.builder.emit(lcsos(out, init_type, args))
        ret out
    }

    fn translate_block_expr(mut self, block_expr: BlockExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let saved_locals = self.locals
        let mut index = 0_usize
        loop {
            match block_expr.statements.get(index) {
                Some(stmt) => {
                    self.translate_statement(stmt)
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        let value = self.translate_boxed_expression_with_hint(block_expr.tail, preferred_name, hint)
        self.locals = saved_locals
        ret value
    }

    fn translate_if_expr(mut self, if_expr: IfExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let out = self.fresh_value(preferred_name, hint)
        let end_label = self.fresh_label("if_expr_end")
        let mut pairs = Vec[PhiPair]::new()
        let mut next_false_label = ""
        let mut branch_index = 0_usize

        loop {
            match if_expr.branches.get(branch_index) {
                Some(branch) => {
                    let then_label = self.fresh_label("if_expr_then")
                    let has_more = branch_index + 1_usize < if_expr.branches.len()
                    let false_label = if has_more {
                        self.fresh_label("if_expr_else")
                    } else {
                        self.fresh_label("if_expr_final_else")
                    }

                    let condition = self.translate_expression(branch.condition, "if_expr_cond")
                    self.builder.terminate(cbr_term(condition, then_label, false_label))
                    self.terminated = true

                    self.start_named_block(then_label)
                    let saved_locals = self.locals
                    let value = self.translate_expression(branch.body, preferred_name + "_branch")
                    self.locals = saved_locals
                    if !self.terminated {
                        self.builder.terminate(br_term(end_label))
                        self.terminated = true
                        pairs = pairs.push(phi_pair(value, then_label))
                    }

                    next_false_label = false_label
                    branch_index = branch_index + 1_usize

                    if has_more {
                        self.start_named_block(next_false_label)
                    }
                }
                None => {
                    break
                }
            }
        }

        self.start_named_block(next_false_label)
        let saved_locals = self.locals
        let else_value = self.translate_boxed_expression_with_hint(if_expr.else_body, preferred_name + "_else", out.typ)
        self.locals = saved_locals
        if !self.terminated {
            self.builder.terminate(br_term(end_label))
            self.terminated = true
            pairs = pairs.push(phi_pair(else_value, next_false_label))
        }

        self.start_named_block(end_label)
        if pairs.len() > 0_usize {
            self.builder.emit(phi(out, pairs))
        } else {
            self.builder.emit(comment("if expression resolved without phi values"))
        }
        ret out
    }

    fn translate_match_expr(mut self, match_expr: MatchExpr, preferred_name: str, hint: Option[Type]) -> Variable {
        let scrutinee = self.translate_boxed_expression(match_expr.expr, preferred_name + "_scrutinee")
        let out = self.fresh_value(preferred_name, hint)
        let end_label = self.fresh_label("match_expr_end")
        let mut pairs = Vec[PhiPair]::new()

        if should_use_match_expr_switch(match_expr.arms) {
            let mut default_label = end_label
            let mut cases = Vec[SwitchCase]::new()
            let mut labels = Vec[str]::new()

            let mut index = 0_usize
            loop {
                match match_expr.arms.get(index) {
                    Some(arm) => {
                        if arm.pattern.kind == "wildcard" {
                            default_label = self.fresh_label("match_expr_default")
                            labels = labels.push(default_label)
                        } else {
                            let arm_label_text = self.fresh_label("match_expr_arm")
                            labels = labels.push(arm_label_text)
                            match arm.pattern.value {
                                Some(case_value_text) => {
                                    cases = cases.push(switch_case(case_value_text, arm_label_text))
                                }
                                None => {}
                            }
                        }
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }

            self.builder.terminate(switch_term(scrutinee, default_label, cases))
            self.terminated = true

            let mut arm_index = 0_usize
            let mut label_index = 0_usize
            loop {
                match match_expr.arms.get(arm_index) {
                    Some(arm) => {
                        match labels.get(label_index) {
                            Some(arm_label_ref) => {
                                self.start_named_block(arm_label_ref)
                                let saved_locals = self.locals
                                let arm_value = self.translate_expression(arm.expr, preferred_name + "_arm")
                                self.locals = saved_locals
                                if !self.terminated {
                                    self.builder.terminate(br_term(end_label))
                                    self.terminated = true
                                    pairs = pairs.push(phi_pair(arm_value, arm_label_ref))
                                }
                                label_index = label_index + 1_usize
                            }
                            None => {}
                        }
                        arm_index = arm_index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }
        } else {
            let mut default_label = end_label
            let mut lowered_arms = Vec[MatchArm]::new()
            let mut labels = Vec[str]::new()
            let mut payloads = Vec[Option[Variable]]::new()

            let mut index = 0_usize
            loop {
                match match_expr.arms.get(index) {
                    Some(arm) => {
                        if arm.pattern.kind == "wildcard" {
                            default_label = self.fresh_label("match_expr_default")
                            labels = labels.push(default_label)
                            payloads = payloads.push(Option[Variable]::None)
                        } else {
                            let arm_label_text = self.fresh_label("match_expr_arm")
                            let payload = match arm.pattern.binding {
                                Some(binding_name) => {
                                    Option[Variable]::Some(untyped_var(binding_name))
                                }
                                None => {
                                    Option[Variable]::None
                                }
                            }
                            labels = labels.push(arm_label_text)
                            payloads = payloads.push(payload)
                            lowered_arms = lowered_arms.push(match_arm(last_scope_segment(pattern_value_or_empty(arm.pattern)), payload, arm_label_text))
                        }
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }

            self.builder.terminate(match_term(scrutinee, default_label, lowered_arms))
            self.terminated = true

            let mut arm_index = 0_usize
            let mut label_index = 0_usize
            loop {
                match match_expr.arms.get(arm_index) {
                    Some(arm) => {
                        match labels.get(label_index) {
                            Some(arm_label_ref) => {
                                let saved_locals = self.locals
                                let payload = get_optional_variable(payloads, label_index)
                                self.start_named_block(arm_label_ref)
                                match arm.pattern.binding {
                                    Some(binding_name) => {
                                        match payload {
                                            Some(payload_var) => {
                                                self.bind_local(binding_name, payload_var)
                                            }
                                            None => {}
                                        }
                                    }
                                    None => {}
                                }
                                let arm_value = self.translate_expression(arm.expr, preferred_name + "_arm")
                                self.locals = saved_locals
                                if !self.terminated {
                                    self.builder.terminate(br_term(end_label))
                                    self.terminated = true
                                    pairs = pairs.push(phi_pair(arm_value, arm_label_ref))
                                }
                                label_index = label_index + 1_usize
                            }
                            None => {}
                        }
                        arm_index = arm_index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }
        }

        self.start_named_block(end_label)
        if pairs.len() > 0_usize {
            self.builder.emit(phi(out, pairs))
        } else {
            self.builder.emit(comment("match expression resolved without phi values"))
        }
        ret out
    }

    fn translate_collection_expr(mut self, items: Vec[ExprNode], preferred_name: str, hint: Option[Type], message: str) -> Variable {
        let mut index = 0_usize
        loop {
            match items.get(index) {
                Some(item) => {
                    let _value = self.translate_expression(item, preferred_name + "_item")
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        self.builder.emit(comment(message))
        ret self.fresh_value(preferred_name, hint)
    }

    fn translate_binary_from_values(
        mut self,
        lhs: Variable,
        operator: str,
        rhs: Variable,
        preferred_name: str,
        hint: Option[Type]
    ) -> Variable {
        match lower_binary_operator(operator) {
            Some(kind) => {
                let result_type = fallback_type(hint, infer_binary_result_type(operator, lhs.typ, rhs.typ))
                let out = self.fresh_value(preferred_name, result_type)
                self.builder.emit(binary(out, lhs, rhs, kind))
                ret out
            }
            None => {
                self.builder.emit(comment("unsupported binary operator " + operator))
                ret with_fallback_type(lhs, hint)
            }
        }
    }

    fn translate_expr_args(mut self, args: Vec[ExprNode], preferred_name: str) -> Vec[Variable] {
        let mut out = Vec[Variable]::new()
        let mut index = 0_usize
        loop {
            match args.get(index) {
                Some(arg) => {
                    let label = preferred_name + "_arg_" + Debug::fmt(index)
                    out = out.push(self.translate_expression(arg, label))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret out
    }

    fn translate_enum_constructor_call(
        mut self,
        enum_type_text: str,
        variant: str,
        args: Vec[ExprNode],
        preferred_name: str,
        hint: Option[Type]
    ) -> Variable {
        let enum_type = lower_type_text(enum_type_text, self.current_self_type)
        let mut payload = Option[Variable]::None
        if args.len() > 0_usize {
                let lowered_args = self.translate_expr_args(args, preferred_name + "_payload")
                if lowered_args.len() == 1_usize {
                    match lowered_args.get(0_usize) {
                    Some(payload_value) => {
                        payload = Option[Variable]::Some(payload_value)
                    }
                    None => {}
                }
            }
            else {
                let payload_type = payload_struct_type_text(enum_type.name, variant, enum_type.generics)
                let payload_type_lowered = lower_type_text(payload_type, self.current_self_type)
                let payload_out = self.fresh_value(preferred_name + "_payload", Option[Type]::Some(payload_type_lowered))
                self.builder.emit(lcsos(payload_out, payload_type_lowered, lowered_args))
                payload = Option[Variable]::Some(payload_out)
            }
        }

        let out_type = with_hint_type(enum_type, hint)
        let out = self.fresh_value(preferred_name, Option[Type]::Some(out_type))
        self.builder.emit(lceos(out, enum_value(out_type.name, out_type.generics, variant, payload)))
        ret out
    }

    fn translate_ehir_stmt(mut self, stmt: EhirStmt) -> () {
        let tokens = split_words(stmt.body)
        let mut index = 0_usize

        loop {
            if index >= tokens.len() {
                break
            }

            let token = get_text(tokens, index)
            if token == "," {
                index = index + 1_usize
                continue
            }

            if token == "store" {
                let src_result = parse_ehir_variable(tokens, index + 1_usize, self.current_self_type)
                let dst_result = parse_ehir_variable(tokens, src_result.next_index + 1_usize, self.current_self_type)
                self.builder.emit(store(src_result.var, dst_result.var))
                index = dst_result.next_index
                continue
            }

            if token == "hfree" {
                let src_result = parse_ehir_variable(tokens, index + 1_usize, self.current_self_type)
                self.builder.emit(hfree(src_result.var))
                index = src_result.next_index
                continue
            }

            if !is_ehir_output_pattern(tokens, index) {
                self.builder.emit(comment("unsupported ehir token " + token))
                break
            }

            let out_name = strip_trailing_colon(get_text(tokens, index))
            let out_type = lower_type_text(get_text(tokens, index + 1_usize), self.current_self_type)
            let out_var = var(out_name, out_type)
            let opcode = get_text(tokens, index + 3_usize)

            if opcode == "lcpos" {
                let literal = get_text(tokens, index + 4_usize)
                self.builder.emit(lcpos(out_var, literal))
                self.bind_local(out_name, out_var)
                index = index + 5_usize
                continue
            }

            if opcode == "load" {
                let src_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                self.builder.emit(load(out_var, src_result.var))
                self.bind_local(out_name, out_var)
                index = src_result.next_index
                continue
            }

            if opcode == "pcast" {
                let src_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                let target_type = lower_type_text(get_text(tokens, src_result.next_index + 1_usize), self.current_self_type)
                self.builder.emit(pcast(out_var, src_result.var, target_type))
                self.bind_local(out_name, out_var)
                index = src_result.next_index + 2_usize
                continue
            }

            if opcode == "gep" {
                let src_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                let offset_result = parse_ehir_variable(tokens, src_result.next_index + 1_usize, self.current_self_type)
                self.builder.emit(gep(out_var, src_result.var, offset_result.var))
                self.bind_local(out_name, out_var)
                index = offset_result.next_index
                continue
            }

            if opcode == "hrealloc" {
                let src_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                let count_result = parse_ehir_variable(tokens, src_result.next_index + 1_usize, self.current_self_type)
                self.builder.emit(hrealloc(out_var, src_result.var, count_result.var))
                self.bind_local(out_name, out_var)
                index = count_result.next_index
                continue
            }

            if opcode == "getfield" || opcode == "getfieldptr" || opcode == "sgetfield" || opcode == "sgetfieldptr" {
                let src_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                let field_result = parse_ehir_variable(tokens, src_result.next_index + 1_usize, self.current_self_type)
                if opcode == "getfield" {
                    self.builder.emit(getfield(out_var, src_result.var, field_result.var))
                }
                elif opcode == "getfieldptr" {
                    self.builder.emit(getfieldptr(out_var, src_result.var, field_result.var))
                }
                elif opcode == "sgetfield" {
                    self.builder.emit(sgetfield(out_var, src_result.var, field_result.var))
                }
                else {
                    self.builder.emit(sgetfieldptr(out_var, src_result.var, field_result.var))
                }
                self.bind_local(out_name, out_var)
                index = field_result.next_index
                continue
            }

            if opcode == "getptr" {
                let src_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                self.builder.emit(getptr(out_var, src_result.var))
                self.bind_local(out_name, out_var)
                index = src_result.next_index
                continue
            }

            if opcode == "salloc" {
                let alloc_type = lower_type_text(get_text(tokens, index + 4_usize), self.current_self_type)
                self.builder.emit(salloc(out_var, alloc_type))
                self.bind_local(out_name, out_var)
                index = index + 5_usize
                continue
            }

            if opcode == "halloc" {
                let alloc_type = lower_type_text(get_text(tokens, index + 4_usize), self.current_self_type)
                self.builder.emit(halloc(out_var, alloc_type))
                self.bind_local(out_name, out_var)
                index = index + 5_usize
                continue
            }

            match lower_binary_operator(opcode) {
                Some(kind) => {
                    let lhs_result = parse_ehir_variable(tokens, index + 4_usize, self.current_self_type)
                    let rhs_result = parse_ehir_variable(tokens, lhs_result.next_index + 1_usize, self.current_self_type)
                    self.builder.emit(binary(out_var, lhs_result.var, rhs_result.var, kind))
                    self.bind_local(out_name, out_var)
                    index = rhs_result.next_index
                }
                None => {
                    self.builder.emit(comment("unsupported ehir opcode " + opcode))
                    break
                }
            }
        }

        ret ()
    }

    fn resolve_method_name(self, receiver: Variable, method: str) -> str {
        match receiver.typ {
            Some(typ) => {
                ret typ.name + "::" + method
            }
            None => {
                ret method
            }
        }
    }

    fn lookup_signature_return_type(self, name: str) -> Option[Type] {
        let mut index = 0_usize
        loop {
            match self.signatures.get(index) {
                Some(sig) => {
                    if sig.name == name {
                        match sig.ret_type {
                            Some(ret_type) => {
                                ret Option[Type]::Some(lower_type_text(ret_type, self.current_self_type))
                            }
                            None => {
                                ret Option[Type]::Some(plain_type("void", Vec[Type]::new()))
                            }
                        }
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret Option[Type]::None
    }

    fn lookup_field_type(self, base: Variable, field: str) -> Option[Type] {
        match base.typ {
            Some(typ) => {
                let mut index = 0_usize
                loop {
                    match self.structs.get(index) {
                        Some(info) => {
                            if info.name == typ.name {
                                let mut field_index = 0_usize
                                loop {
                                    match info.fields.get(field_index) {
                                        Some(field_info) => {
                                            if field_info.name == field {
                                                ret Option[Type]::Some(lower_type_text(field_info.typ, self.current_self_type))
                                            }
                                            field_index = field_index + 1_usize
                                        }
                                        None => {
                                            break
                                        }
                                    }
                                }
                            }
                            index = index + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }
                ret Option[Type]::None
            }
            None => {
                ret Option[Type]::None
            }
        }
    }

    fn lookup_local(self, name: str) -> Option[Variable] {
        let mut index = 0_usize
        loop {
            match self.locals.get(index) {
                Some(binding) => {
                    if binding.name == name {
                        ret Option[Variable]::Some(binding.value)
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret Option[Variable]::None
    }

    fn bind_local(mut self, name: str, value: Variable) -> () {
        self.locals = upsert_binding(self.locals, name, value)
        ret ()
    }

    fn start_named_block(mut self, name: str) -> () {
        self.builder.start_block(name)
        self.terminated = false
        ret ()
    }

    fn fresh_label(mut self, prefix: str) -> str {
        let out = prefix + "_" + Debug::fmt(self.next_label_index)
        self.next_label_index = self.next_label_index + 1_usize
        ret out
    }

    fn fresh_untyped(mut self, prefix: str) -> Variable {
        let name = prefix + "_" + Debug::fmt(self.next_name_index)
        self.next_name_index = self.next_name_index + 1_usize
        ret untyped_var(name)
    }

    fn fresh_value(mut self, preferred_name: str, hint: Option[Type]) -> Variable {
        match hint {
            Some(typ) => {
                ret self.builder.fresh_named(preferred_name, typ)
            }
            None => {
                ret self.fresh_untyped(preferred_name)
            }
        }
    }

    fn default_zero_like(mut self, hint: Option[Type], preferred_name: str) -> Variable {
        match hint {
            Some(typ) => {
                ret self.default_value_for_type(typ, preferred_name)
            }
            None => {
                let out = self.fresh_untyped(preferred_name)
                self.builder.emit(lcpos(out, "0_u32"))
                ret out
            }
        }
    }

    fn default_value_for_type(mut self, typ: Type, preferred_name: str) -> Variable {
        if typ.name == "bool" {
            let out = self.fresh_value(preferred_name, Option[Type]::Some(typ))
            self.builder.emit(lcpos(out, "false"))
            ret out
        }
        if typ.name == "str" {
            let out = self.fresh_value(preferred_name, Option[Type]::Some(typ))
            self.builder.emit(lcpos(out, "\"\""))
            ret out
        }
        if is_integer_type_name(typ.name) {
            let out = self.fresh_value(preferred_name, Option[Type]::Some(typ))
            self.builder.emit(lcpos(out, "0_" + typ.name))
            ret out
        }
        if is_float_type_name(typ.name) {
            let out = self.fresh_value(preferred_name, Option[Type]::Some(typ))
            self.builder.emit(lcpos(out, "0.0_" + typ.name))
            ret out
        }
        if typ.name == "void" {
            ret var("__void", typ)
        }
        ret var("__default_" + preferred_name, typ)
    }
}

pub struct EnumVariantPayloadInfo {
    payload_type: Option[str]
    payload_structs: Vec[Directive]
}

pub struct ParsedEnumCtor {
    enum_type: str
    variant: str
}

pub struct ParsedEhirVariable {
    var: Variable
    next_index: usize
}

fn collect_struct_infos(ast: Vec[Statement]) -> Vec[StructInfo] {
    let mut out = Vec[StructInfo]::new()
    let mut index = 0_usize

    loop {
        match ast.get(index) {
            Some(stmt) => {
                match stmt {
                    Statement::Struct(struct_stmt) => {
                        out = out.push(struct_info_from_stmt(struct_stmt))
                    }
                    _ => {}
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

fn collect_enum_infos(ast: Vec[Statement]) -> Vec[EnumInfo] {
    let mut out = Vec[EnumInfo]::new()
    let mut index = 0_usize

    loop {
        match ast.get(index) {
            Some(stmt) => {
                match stmt {
                    Statement::EnumItem(enum_stmt) => {
                        out = out.push(enum_info_from_stmt(enum_stmt))
                    }
                    _ => {}
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

fn collect_function_signatures(ast: Vec[Statement]) -> Vec[FunctionSignature] {
    let mut out = Vec[FunctionSignature]::new()
    let mut index = 0_usize

    loop {
        match ast.get(index) {
            Some(stmt) => {
                match stmt {
                    Statement::Function(fn_stmt) => {
                        out = out.push(FunctionSignature{fn_stmt.name, fn_stmt.ret_type})
                    }
                    Statement::Trait(trait_stmt) => {
                        let mut method_index = 0_usize
                        loop {
                            match trait_stmt.methods.get(method_index) {
                                Some(method) => {
                                    out = out.push(FunctionSignature{trait_stmt.name + "::" + method.name, method.ret_type})
                                    method_index = method_index + 1_usize
                                }
                                None => {
                                    break
                                }
                            }
                        }
                    }
                    Statement::Impl(impl_stmt) => {
                        let prefix = match impl_stmt.trait_name {
                            Some(trait_name) => {
                                trait_name
                            }
                            None => {
                                base_type_name(impl_stmt.target, Option[str]::Some(impl_stmt.target))
                            }
                        }

                        let mut method_index = 0_usize
                        loop {
                            match impl_stmt.methods.get(method_index) {
                                Some(method) => {
                                    out = out.push(FunctionSignature{prefix + "::" + method.name, method.ret_type})
                                    method_index = method_index + 1_usize
                                }
                                None => {
                                    break
                                }
                            }
                        }
                    }
                    _ => {}
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

fn struct_info_from_stmt(stmt: StructStmt) -> StructInfo {
    let mut fields = Vec[StructFieldInfo]::new()

    if stmt.is_tuple {
        let mut index = 0_usize
        loop {
            match stmt.tuple_fields.get(index) {
                Some(field_type) => {
                    fields = fields.push(StructFieldInfo{tuple_field_name(index), field_type})
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
    } else {
        let mut index = 0_usize
        loop {
            match stmt.named_fields.get(index) {
                Some(field) => {
                    fields = fields.push(StructFieldInfo{field.name, field.typ})
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
    }

    ret StructInfo{stmt.name, stmt.generics, fields}
}

fn enum_info_from_stmt(stmt: EnumStmt) -> EnumInfo {
    let mut variants = Vec[EnumVariantInfo]::new()
    let mut index = 0_usize

    loop {
        match stmt.variants.get(index) {
            Some(variant) => {
                let payload_info = lower_enum_variant_payload(stmt.name, stmt.generics, variant)
                variants = variants.push(EnumVariantInfo{variant.name, payload_info.payload_type})
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret EnumInfo{stmt.name, stmt.generics, variants}
}

fn lower_enum_variant_payload(enum_name: str, enum_generics: Vec[str], variant: ParsedEnumVariant) -> EnumVariantPayloadInfo {
    if variant.is_unit {
        ret EnumVariantPayloadInfo{Option[str]::None, Vec[Directive]::new()}
    }

    if variant.is_tuple {
        if variant.tuple_fields.len() == 1_usize {
            match variant.tuple_fields.get(0_usize) {
                Some(first) => {
                    ret EnumVariantPayloadInfo{Option[str]::Some(first), Vec[Directive]::new()}
                }
                None => {}
            }
        }

        let struct_name = payload_struct_name(enum_name, variant.name)
        let mut fields = Vec[Parameter]::new()
        let mut index = 0_usize
        loop {
            match variant.tuple_fields.get(index) {
                Some(field_type) => {
                    fields = fields.push(param(tuple_field_name(index), lower_type_text(field_type, Option[str]::None)))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        let directive = struct_directive(struct_name, lower_type_generics(enum_generics, Option[str]::None), fields)
        ret EnumVariantPayloadInfo{Option[str]::Some(apply_type_generics_text(struct_name, enum_generics)), Vec[Directive]::new().push(directive)}
    }

    if variant.named_fields.len() == 1_usize {
        match variant.named_fields.get(0_usize) {
            Some(field) => {
                ret EnumVariantPayloadInfo{Option[str]::Some(field.typ), Vec[Directive]::new()}
            }
            None => {}
        }
    }

    let struct_name = payload_struct_name(enum_name, variant.name)
    let mut fields = Vec[Parameter]::new()
    let mut index = 0_usize
    loop {
        match variant.named_fields.get(index) {
            Some(field) => {
                fields = fields.push(param(field.name, lower_type_text(field.typ, Option[str]::None)))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    let directive = struct_directive(struct_name, lower_type_generics(enum_generics, Option[str]::None), fields)
    ret EnumVariantPayloadInfo{Option[str]::Some(apply_type_generics_text(struct_name, enum_generics)), Vec[Directive]::new().push(directive)}
}

fn lower_params(params: Vec[FunctionParam], current_self_type: Option[str]) -> Vec[Parameter] {
    let mut out = Vec[Parameter]::new()
    let mut index = 0_usize
    loop {
        match params.get(index) {
            Some(param_item) => {
                let lowered_type = match param_item.typ {
                    Some(typ) => {
                        lower_type_text(typ, current_self_type)
                    }
                    None => {
                        plain_type("void", Vec[Type]::new())
                    }
                }
                out = out.push(param(param_item.name, lowered_type))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret out
}

fn lower_return_type(ret_type: Option[str], current_self_type: Option[str]) -> Type {
    match ret_type {
        Some(typ) => {
            ret lower_type_text(typ, current_self_type)
        }
        None => {
            ret plain_type("void", Vec[Type]::new())
        }
    }
}

fn lower_type_generics(items: Vec[str], current_self_type: Option[str]) -> Vec[Type] {
    let mut out = Vec[Type]::new()
    let mut index = 0_usize
    loop {
        match items.get(index) {
            Some(item) => {
                out = out.push(lower_type_text(item, current_self_type))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret out
}

fn lower_type_text(raw: str, current_self_type: Option[str]) -> Type {
    let mut text = strip_mut_prefix(raw)
    text = substitute_self_type(text, current_self_type)

    let mut pointer = PointerKind::Plain
    if ends_with(text, "<H>") {
        pointer = PointerKind::Heap
        text = text.slice(0_usize, text.len() - 3_usize)
    }
    elif ends_with(text, "<S>") {
        pointer = PointerKind::Stack
        text = text.slice(0_usize, text.len() - 3_usize)
    }
    elif ends_with(text, "&") {
        text = text.slice(0_usize, text.len() - 1_usize)
    }
    elif ends_with(text, "*") {
        pointer = PointerKind::Raw
        text = strip_raw_pointer_suffix(text)
    }

    if starts_with(text, "(") || starts_with(text, "[") {
        ret make_type(text, Vec[Type]::new(), pointer)
    }

    let generic_open = find_top_level_char(text, 91_u8)
    if generic_open >= text.len() {
        ret make_type(text, Vec[Type]::new(), pointer)
    }

    let name = text.slice(0_usize, generic_open)
    let inner = text.slice(generic_open + 1_usize, text.len() - generic_open - 2_usize)
    ret make_type(name, split_type_args(inner, current_self_type), pointer)
}

fn split_type_args(inner: str, current_self_type: Option[str]) -> Vec[Type] {
    let parts = split_top_level_commas(inner)
    let mut out = Vec[Type]::new()
    let mut index = 0_usize
    loop {
        match parts.get(index) {
            Some(item) => {
                out = out.push(lower_type_text(trim_spaces(item), current_self_type))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret out
}

fn expand_import_stmt(stmt: ImportStmt) -> Vec[ImportItem] {
    ret expand_import_path(stmt.path, stmt.is_public)
}

fn expand_import_path(raw: str, is_public: bool) -> Vec[ImportItem] {
    let alias_index = find_top_level_alias(raw)
    let mut path = raw
    let mut alias = Option[str]::None

    if alias_index < raw.len() {
        path = trim_spaces(raw.slice(0_usize, alias_index))
        alias = Option[str]::Some(trim_spaces(raw.slice(alias_index + 4_usize, raw.len() - alias_index - 4_usize)))
    }

    let brace_index = find_top_level_char(path, 123_u8)
    if brace_index < path.len() {
        let prefix = path.slice(0_usize, brace_index - 2_usize)
        let inner = path.slice(brace_index + 1_usize, path.len() - brace_index - 2_usize)
        let items = split_top_level_commas(inner)
        let mut out = Vec[ImportItem]::new()
        let mut index = 0_usize
        loop {
            match items.get(index) {
                Some(item) => {
                    let nested = prefix + "::" + trim_spaces(item)
                    out = append_imports(out, expand_import_path(nested, is_public))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }
        ret out
    }

    let segments = split_scope_segments(path)
    if path_ends_with_glob(path) {
        ret Vec[ImportItem]::new().push(ImportItem{drop_last_segment(segments), "*", alias, is_public})
    }
    ret Vec[ImportItem]::new().push(ImportItem{drop_last_segment(segments), last_segment(segments), alias, is_public})
}

fn append_imports(lhs: Vec[ImportItem], rhs: Vec[ImportItem]) -> Vec[ImportItem] {
    let mut out = lhs
    let mut index = 0_usize
    loop {
        match rhs.get(index) {
            Some(item) => {
                out = out.push(item)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret out
}

fn append_variables(lhs: Vec[Variable], rhs: Vec[Variable]) -> Vec[Variable] {
    let mut out = lhs
    let mut index = 0_usize
    loop {
        match rhs.get(index) {
            Some(item) => {
                out = out.push(item)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret out
}

fn upsert_binding(items: Vec[LocalBinding], name: str, value: Variable) -> Vec[LocalBinding] {
    let mut out = Vec[LocalBinding]::new()
    let mut replaced = false
    let mut index = 0_usize

    loop {
        match items.get(index) {
            Some(item) => {
                if item.name == name {
                    out = out.push(LocalBinding{name, value})
                    replaced = true
                } else {
                    out = out.push(item)
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    if !replaced {
        out = out.push(LocalBinding{name, value})
    }
    ret out
}

fn push_binding(items: Vec[LocalBinding], name: str, value: Variable) -> Vec[LocalBinding] {
    ret items.push(LocalBinding{name, value})
}

fn field_logical_name(base: ExprNode, field: str) -> Option[str] {
    match logical_expr_name(base) {
        Some(base_name) => {
            ret Option[str]::Some(base_name + "." + field)
        }
        None => {
            ret Option[str]::None
        }
    }
}

fn field_logical_name_boxed(base: ExprNode<H>, field: str) -> Option[str] {
    ret field_logical_name(unbox_expr(base), field)
}

fn logical_expr_name(expr: ExprNode) -> Option[str] {
    match expr.value {
        Expr::Path(path) => {
            ret Option[str]::Some(path)
        }
        Expr::Field(field_expr) => {
            ret field_logical_name_boxed(field_expr.base, field_expr.field)
        }
        Expr::Parenthesized(inner) => {
            ret logical_expr_name(unbox_expr(inner))
        }
        _ => {
            ret Option[str]::None
        }
    }
}

fn box_expr(expr: ExprNode) -> ExprNode<H> {
    ret ExprNode<H>{expr.value}
}

fn unbox_expr(expr: ExprNode<H>) -> ExprNode {
    ret ExprNode{expr.value}
}

fn assignment_preferred_name(target_name: str) -> str {
    let dot = find_last_dot(target_name)
    if dot < target_name.len() {
        ret target_name.slice(dot + 1_usize, target_name.len() - dot - 1_usize)
    }
    ret target_name
}

fn compound_assignment_operator(operator: str) -> str {
    if operator == "+=" { ret "+" }
    if operator == "-=" { ret "-" }
    if operator == "*=" { ret "*" }
    if operator == "/=" { ret "/" }
    if operator == "%=" { ret "%" }
    if operator == "&=" { ret "&" }
    if operator == "|=" { ret "|" }
    if operator == "^=" { ret "^" }
    if operator == "<<=" { ret "<<" }
    if operator == ">>=" { ret ">>" }
    ret operator
}

fn should_use_switch(arms: Vec[ParsedMatchArm]) -> bool {
    let mut index = 0_usize
    loop {
        match arms.get(index) {
            Some(arm) => {
                if !is_switch_pattern(arm.pattern.kind) {
                    ret false
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret true
}

fn should_use_match_expr_switch(arms: Vec[MatchExprArm]) -> bool {
    let mut index = 0_usize
    loop {
        match arms.get(index) {
            Some(arm) => {
                if !is_switch_pattern(arm.pattern.kind) {
                    ret false
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret true
}

fn is_switch_pattern(kind: str) -> bool {
    ret kind == "wildcard"
        || kind == "integer"
        || kind == "float"
        || kind == "string"
        || kind == "bool"
}

fn lower_binary_operator(operator: str) -> Option[BinaryOpKind] {
    if operator == "+" { ret Option[BinaryOpKind]::Some(BinaryOpKind::ADD) }
    if operator == "-" { ret Option[BinaryOpKind]::Some(BinaryOpKind::SUB) }
    if operator == "*" { ret Option[BinaryOpKind]::Some(BinaryOpKind::MUL) }
    if operator == "/" { ret Option[BinaryOpKind]::Some(BinaryOpKind::DIV) }
    if operator == "%" { ret Option[BinaryOpKind]::Some(BinaryOpKind::MOD) }
    if operator == "<<" { ret Option[BinaryOpKind]::Some(BinaryOpKind::SHL) }
    if operator == ">>" { ret Option[BinaryOpKind]::Some(BinaryOpKind::SHR) }
    if operator == "<" { ret Option[BinaryOpKind]::Some(BinaryOpKind::LES) }
    if operator == "<=" { ret Option[BinaryOpKind]::Some(BinaryOpKind::LEQ) }
    if operator == ">" { ret Option[BinaryOpKind]::Some(BinaryOpKind::GRT) }
    if operator == ">=" { ret Option[BinaryOpKind]::Some(BinaryOpKind::GEQ) }
    if operator == "==" { ret Option[BinaryOpKind]::Some(BinaryOpKind::IEQ) }
    if operator == "!=" { ret Option[BinaryOpKind]::Some(BinaryOpKind::NEQ) }
    if operator == "&&" { ret Option[BinaryOpKind]::Some(BinaryOpKind::AND) }
    if operator == "||" { ret Option[BinaryOpKind]::Some(BinaryOpKind::OR) }
    if operator == "&" { ret Option[BinaryOpKind]::Some(BinaryOpKind::AND) }
    if operator == "|" { ret Option[BinaryOpKind]::Some(BinaryOpKind::OR) }
    if operator == "^" { ret Option[BinaryOpKind]::Some(BinaryOpKind::XOR) }
    ret Option[BinaryOpKind]::None
}

fn infer_binary_result_type(operator: str, lhs: Option[Type], rhs: Option[Type]) -> Option[Type] {
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" || operator == "&&" || operator == "||" {
        ret Option[Type]::Some(plain_type("bool", Vec[Type]::new()))
    }
    match lhs {
        Some(typ) => {
            ret Option[Type]::Some(typ)
        }
        None => {
            match rhs {
                Some(typ) => {
                    ret Option[Type]::Some(typ)
                }
                None => {
                    ret Option[Type]::None
                }
            }
        }
    }
}

fn infer_integer_type(value: str) -> Option[Type] {
    let marker = find_last_underscore(value)
    if marker < value.len() {
        ret Option[Type]::Some(plain_type(value.slice(marker + 1_usize, value.len() - marker - 1_usize), Vec[Type]::new()))
    }
    ret Option[Type]::None
}

fn infer_float_type(value: str) -> Option[Type] {
    let marker = find_last_underscore(value)
    if marker < value.len() {
        ret Option[Type]::Some(plain_type(value.slice(marker + 1_usize, value.len() - marker - 1_usize), Vec[Type]::new()))
    }
    ret Option[Type]::Some(plain_type("f32", Vec[Type]::new()))
}

fn fallback_type(primary: Option[Type], secondary: Option[Type]) -> Option[Type] {
    match primary {
        Some(typ) => {
            ret Option[Type]::Some(typ)
        }
        None => {
            ret secondary
        }
    }
}

fn with_fallback_type(var_data: Variable, hint: Option[Type]) -> Variable {
    match var_data.typ {
        Some(_) => {
            ret var_data
        }
        None => {
            match hint {
                Some(typ) => {
                    ret Variable{var_data.name, Option[Type]::Some(typ)}
                }
                None => {
                    ret var_data
                }
            }
        }
    }
}

fn with_hint_type(base: Type, hint: Option[Type]) -> Type {
    match hint {
        Some(typ) => {
            ret typ
        }
        None => {
            ret base
        }
    }
}

fn try_split_enum_constructor_path(path: str) -> Option[ParsedEnumCtor] {
    let scope = find_last_scope(path)
    if scope >= path.len() {
        ret Option[ParsedEnumCtor]::None
    }

    let enum_type = path.slice(0_usize, scope)
    let variant = path.slice(scope + 2_usize, path.len() - scope - 2_usize)
    if !starts_with_uppercase(variant) {
        ret Option[ParsedEnumCtor]::None
    }
    ret Option[ParsedEnumCtor]::Some(ParsedEnumCtor{enum_type, variant})
}

fn parse_ehir_variable(tokens: Vec[str], start: usize, current_self_type: Option[str]) -> ParsedEhirVariable {
    let name_token = get_text(tokens, start)
    let type_token = get_text(tokens, start + 1_usize)
    ret ParsedEhirVariable{
        var(strip_trailing_colon(name_token), lower_type_text(type_token, current_self_type)),
        start + 2_usize
    }
}

fn is_ehir_output_pattern(tokens: Vec[str], index: usize) -> bool {
    if index + 3_usize >= tokens.len() {
        ret false
    }
    let out_token = get_text(tokens, index)
    let assign_token = get_text(tokens, index + 2_usize)
    ret ends_with(out_token, ":") && assign_token == "="
}

fn split_words(text: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize

    loop {
        index = skip_spaces(text, index)
        if index >= text.len() {
            break
        }

        let end = find_word_end(text, index)
        out = out.push(text.slice(index, end - index))
        index = end
    }

    ret out
}

fn split_top_level_commas(text: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut square = 0_usize
    let mut paren = 0_usize
    let mut brace = 0_usize
    let mut angle = 0_usize

    loop {
        if index >= text.len() {
            out = out.push(text.slice(start, index - start))
            break
        }

        let ch = text.byte_at(index)
        if ch == 91_u8 { square = square + 1_usize }
        elif ch == 93_u8 { square = square - 1_usize }
        elif ch == 40_u8 { paren = paren + 1_usize }
        elif ch == 41_u8 { paren = paren - 1_usize }
        elif ch == 123_u8 { brace = brace + 1_usize }
        elif ch == 125_u8 { brace = brace - 1_usize }
        elif ch == 60_u8 { angle = angle + 1_usize }
        elif ch == 62_u8 { angle = angle - 1_usize }
        elif ch == 44_u8 && square == 0_usize && paren == 0_usize && brace == 0_usize && angle == 0_usize {
            out = out.push(text.slice(start, index - start))
            start = index + 1_usize
        }

        index = index + 1_usize
    }

    ret out
}

fn split_scope_segments(path: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut square = 0_usize

    loop {
        if index >= path.len() {
            out = out.push(path.slice(start, index - start))
            break
        }

        let ch = path.byte_at(index)
        if ch == 91_u8 { square = square + 1_usize }
        elif ch == 93_u8 { square = square - 1_usize }
        elif ch == 58_u8 && square == 0_usize && index + 1_usize < path.len() && path.byte_at(index + 1_usize) == 58_u8 {
            out = out.push(path.slice(start, index - start))
            start = index + 2_usize
            index = index + 1_usize
        }

        index = index + 1_usize
    }

    ret out
}

fn drop_last_segment(parts: Vec[str]) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize
    loop {
        if index + 1_usize >= parts.len() {
            break
        }
        match parts.get(index) {
            Some(part) => {
                out = out.push(part)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret out
}

fn last_segment(parts: Vec[str]) -> str {
    if parts.len() == 0_usize {
        ret ""
    }
    ret get_text(parts, parts.len() - 1_usize)
}

fn last_scope_segment(path: str) -> str {
    let scope = find_last_scope(path)
    if scope >= path.len() {
        ret path
    }
    ret path.slice(scope + 2_usize, path.len() - scope - 2_usize)
}

fn pattern_value_or_empty(pattern: MatchPattern) -> str {
    match pattern.value {
        Some(value) => {
            ret value
        }
        None => {
            ret ""
        }
    }
}

fn find_top_level_char(text: str, target: u8) -> usize {
    let mut index = 0_usize
    let mut square = 0_usize
    let mut paren = 0_usize
    let mut brace = 0_usize
    let mut angle = 0_usize

    loop {
        if index >= text.len() {
            ret text.len()
        }

        let ch = text.byte_at(index)
        if ch == 91_u8 { square = square + 1_usize }
        elif ch == 93_u8 { square = square - 1_usize }
        elif ch == 40_u8 { paren = paren + 1_usize }
        elif ch == 41_u8 { paren = paren - 1_usize }
        elif ch == 123_u8 { brace = brace + 1_usize }
        elif ch == 125_u8 { brace = brace - 1_usize }
        elif ch == 60_u8 { angle = angle + 1_usize }
        elif ch == 62_u8 { angle = angle - 1_usize }
        elif ch == target && square == 0_usize && paren == 0_usize && brace == 0_usize && angle == 0_usize {
            ret index
        }

        index = index + 1_usize
    }
}

fn find_top_level_alias(text: str) -> usize {
    let mut index = 0_usize
    let mut square = 0_usize
    let mut brace = 0_usize

    loop {
        if index + 3_usize >= text.len() {
            ret text.len()
        }

        let ch = text.byte_at(index)
        if ch == 91_u8 { square = square + 1_usize }
        elif ch == 93_u8 { square = square - 1_usize }
        elif ch == 123_u8 { brace = brace + 1_usize }
        elif ch == 125_u8 { brace = brace - 1_usize }

        if square == 0_usize && brace == 0_usize {
            if text.slice(index, 4_usize) == " as " {
                ret index
            }
        }

        index = index + 1_usize
    }
}

fn find_last_scope(text: str) -> usize {
    let mut index = 0_usize
    let mut last = text.len()
    let mut square = 0_usize

    loop {
        if index + 1_usize >= text.len() {
            ret last
        }

        let ch = text.byte_at(index)
        if ch == 91_u8 { square = square + 1_usize }
        elif ch == 93_u8 { square = square - 1_usize }
        elif ch == 58_u8 && square == 0_usize && text.byte_at(index + 1_usize) == 58_u8 {
            last = index
            index = index + 1_usize
        }

        index = index + 1_usize
    }
}

fn find_last_dot(text: str) -> usize {
    let mut index = 0_usize
    let mut last = text.len()
    loop {
        if index >= text.len() {
            ret last
        }
        if text.byte_at(index) == 46_u8 {
            last = index
        }
        index = index + 1_usize
    }
}

fn find_last_underscore(text: str) -> usize {
    let mut index = 0_usize
    let mut last = text.len()
    loop {
        if index >= text.len() {
            ret last
        }
        if text.byte_at(index) == 95_u8 {
            last = index
        }
        index = index + 1_usize
    }
}

fn skip_spaces(text: str, index: usize) -> usize {
    let mut current = index
    loop {
        if current >= text.len() {
            ret current
        }
        let ch = text.byte_at(current)
        if ch == 32_u8 || ch == 9_u8 || ch == 10_u8 || ch == 13_u8 {
            current = current + 1_usize
        } else {
            ret current
        }
    }
}

fn find_word_end(text: str, start: usize) -> usize {
    let mut current = start
    loop {
        if current >= text.len() {
            ret current
        }
        let ch = text.byte_at(current)
        if ch == 32_u8 || ch == 9_u8 || ch == 10_u8 || ch == 13_u8 {
            ret current
        }
        current = current + 1_usize
    }
}

fn trim_spaces(text: str) -> str {
    let mut start = 0_usize
    let mut end = text.len()

    loop {
        if start >= end {
            ret ""
        }
        let ch = text.byte_at(start)
        if ch == 32_u8 || ch == 9_u8 || ch == 10_u8 || ch == 13_u8 {
            start = start + 1_usize
        } else {
            break
        }
    }

    loop {
        if end == start {
            break
        }
        let ch = text.byte_at(end - 1_usize)
        if ch == 32_u8 || ch == 9_u8 || ch == 10_u8 || ch == 13_u8 {
            end = end - 1_usize
        } else {
            break
        }
    }

    ret text.slice(start, end - start)
}

fn starts_with(text: str, prefix: str) -> bool {
    if text.len() < prefix.len() {
        ret false
    }
    ret text.slice(0_usize, prefix.len()) == prefix
}

fn ends_with(text: str, suffix: str) -> bool {
    if text.len() < suffix.len() {
        ret false
    }
    ret text.slice(text.len() - suffix.len(), suffix.len()) == suffix
}

fn starts_with_uppercase(text: str) -> bool {
    if text.len() == 0_usize {
        ret false
    }
    let ch = text.byte_at(0_usize)
    ret ch >= 65_u8 && ch <= 90_u8
}

fn strip_trailing_colon(text: str) -> str {
    if ends_with(text, ":") {
        ret text.slice(0_usize, text.len() - 1_usize)
    }
    ret text
}

fn strip_mut_prefix(text: str) -> str {
    if starts_with(text, "mut ") {
        ret text.slice(4_usize, text.len() - 4_usize)
    }
    ret text
}

fn strip_raw_pointer_suffix(text: str) -> str {
    let mut end = text.len()
    loop {
        if end == 0_usize {
            ret ""
        }
        if text.byte_at(end - 1_usize) != 42_u8 {
            ret text.slice(0_usize, end)
        }
        end = end - 1_usize
    }
}

fn substitute_self_type(text: str, current_self_type: Option[str]) -> str {
    match current_self_type {
        Some(self_type) => {
            if text == "Self" {
                ret self_type
            }
            if starts_with(text, "Self[") {
                ret self_type + text.slice(4_usize, text.len() - 4_usize)
            }
            ret text
        }
        None => {
            ret text
        }
    }
}

fn base_type_name(text: str, current_self_type: Option[str]) -> str {
    let lowered = lower_type_text(text, current_self_type)
    ret lowered.name
}

fn apply_type_generics_text(name: str, generics: Vec[str]) -> str {
    if generics.len() == 0_usize {
        ret name
    }
    let mut out = name
    out = out + "["
    let mut index = 0_usize
    loop {
        match generics.get(index) {
            Some(item) => {
                if index > 0_usize {
                    out = out + ", "
                }
                out = out + item
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    out = out + "]"
    ret out
}

fn payload_struct_name(enum_name: str, variant_name: str) -> str {
    ret enum_name + "_" + variant_name + "_Payload"
}

fn payload_struct_type_text(enum_name: str, variant_name: str, generics: Vec[Type]) -> str {
    let name = payload_struct_name(enum_name, variant_name)
    let mut generic_text = Vec[str]::new()
    let mut index = 0_usize
    loop {
        match generics.get(index) {
            Some(item) => {
                generic_text = generic_text.push(type_to_string(item))
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret apply_type_generics_text(name, generic_text)
}

fn tuple_field_name(index: usize) -> str {
    ret "_" + Debug::fmt(index)
}

fn path_ends_with_glob(path: str) -> bool {
    ret ends_with(path, "::*")
}

fn has_some_block(value: Option[ParsedBlock]) -> bool {
    match value {
        Some(_) => {
            ret true
        }
        None => {
            ret false
        }
    }
}

fn get_text(items: Vec[str], index: usize) -> str {
    match items.get(index) {
        Some(item) => {
            ret item
        }
        None => {
            ret ""
        }
    }
}

fn get_optional_variable(items: Vec[Option[Variable]], index: usize) -> Option[Variable] {
    match items.get(index) {
        Some(item) => {
            ret item
        }
        None => {
            ret Option[Variable]::None
        }
    }
}

fn is_integer_type_name(name: str) -> bool {
    ret name == "u8"
        || name == "u16"
        || name == "u32"
        || name == "u64"
        || name == "usize"
        || name == "i8"
        || name == "i16"
        || name == "i32"
        || name == "i64"
        || name == "isize"
}

fn is_float_type_name(name: str) -> bool {
    ret name == "f16" || name == "f32" || name == "f64"
}
