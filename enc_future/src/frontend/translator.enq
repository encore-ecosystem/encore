import mod::parser::statements::AssignmentStmt
import mod::parser::statements::BinaryExpr
import mod::parser::statements::Block
import mod::parser::statements::CallExpr
import mod::parser::statements::Expr
import mod::parser::statements::ExprNode
import mod::parser::statements::FieldExpr
import mod::parser::statements::FunctionItem
import mod::parser::statements::FunctionParam
import mod::parser::statements::LetStmt
import mod::parser::statements::NamedField
import mod::parser::statements::Statement
import mod::parser::statements::StructInitExpr
import mod::parser::statements::StructStmt

import core::fmt::Debug
import core::panic::panic

import core::option::Option
import std::string::String
import std::vec::Vec


pub struct TypeAlias {
    source_name: String
    internal_name: String
}

pub struct StructField {
    name: String
    typ: String
}

pub struct StructInfo {
    source_name: String
    internal_name: String
    fields: Vec[StructField]
}

pub struct FunctionInfo {
    source_name: String
    internal_name: String
    params: Vec[FunctionParam]
    ret_type: String
}

pub struct LocalBinding {
    name: String
    var_name: String
    typ: String
}

pub struct LoweredExpr {
    lines: Vec[String]
    var_name: String
    typ: String
}

pub struct LoweredStmt {
    lines: Vec[String]
    locals: Vec[LocalBinding]
    terminated: bool
}

pub struct Translator {
    module_name: String
    ast: Vec[Statement]
    type_aliases: Vec[TypeAlias]
    structs: Vec[StructInfo]
    functions: Vec[FunctionInfo]
    next_temp: usize
}


pub fn translate_module(module_name: str, ast: Vec[Statement]) -> str {
    let mut translator = Translator::new(module_name, ast)
    ret translator.translate()
}

fn empty_string_vec() -> Vec[String] {
    ret Vec[String]::new()
}

fn statement_get(items: Vec[Statement], index: usize) -> Option[Statement] {
    ret items.get(index)
}

fn string_get(items: Vec[String], index: usize) -> Option[String] {
    ret items.get(index)
}

fn named_field_get(items: Vec[NamedField], index: usize) -> Option[NamedField] {
    ret items.get(index)
}

fn function_param_get(items: Vec[FunctionParam], index: usize) -> Option[FunctionParam] {
    ret items.get(index)
}

fn function_item_get(items: Vec[FunctionItem], index: usize) -> Option[FunctionItem] {
    ret items.get(index)
}

fn struct_field_get(items: Vec[StructField], index: usize) -> Option[StructField] {
    ret items.get(index)
}

fn struct_info_get(items: Vec[StructInfo], index: usize) -> Option[StructInfo] {
    ret items.get(index)
}

fn function_info_get(items: Vec[FunctionInfo], index: usize) -> Option[FunctionInfo] {
    ret items.get(index)
}

fn local_binding_get(items: Vec[LocalBinding], index: usize) -> Option[LocalBinding] {
    ret items.get(index)
}

fn expr_get(items: Vec[ExprNode], index: usize) -> Option[ExprNode] {
    ret items.get(index)
}

fn line_count(items: Vec[String]) -> usize {
    ret items.len()
}

fn field_count(items: Vec[StructField]) -> usize {
    ret items.len()
}

fn trim_spaces_text(text: str) -> String {
    let mut start = 0_usize
    let text_len = text.len()
    loop {
        if start >= text_len {
            ret String::new()
        }
        if text.byte_at(start) != 32_u8 {
            break
        }
        start = start + 1_usize
    }

    let mut end = text_len
    loop {
        if end <= start {
            break
        }
        if text.byte_at(end - 1_usize) != 32_u8 {
            break
        }
        end = end - 1_usize
    }

    ret String::from_str(text.slice(start, end - start))
}

fn starts_with_text(text: str, prefix: str) -> bool {
    let prefix_len = prefix.len()
    if text.len() < prefix_len {
        ret false
    }
    ret text.slice(0_usize == prefix_len), prefix
}

fn ends_with_text(text: str, suffix: str) -> bool {
    let text_len = text.len()
    let suffix_len = suffix.len()
    if text_len < suffix_len {
        ret false
    }
    ret text.slice(text_len - suffix_len == suffix_len), suffix
}

fn slice_without_suffix(text: str, suffix_len: usize) -> String {
    ret String::from_str(slice(text, 0_usize, text.len() - suffix_len))
}

fn scope_depth_is_zero(square_depth: usize, paren_depth: usize, angle_depth: usize) -> bool {
    if square_depth != 0_usize {
        ret false
    }
    if paren_depth != 0_usize {
        ret false
    }
    if angle_depth != 0_usize {
        ret false
    }
    ret true
}

fn split_top_level(text: str, delimiter: u8) -> Vec[String] {
    let mut parts = Vec[String]::new()
    let text_len = text.len()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut square_depth = 0_usize
    let mut paren_depth = 0_usize
    let mut angle_depth = 0_usize

    loop {
        if index >= text_len {
            parts = parts.push(trim_spaces_text(text.slice(start, text_len - start)))
            break
        }

        let curr = text.byte_at(index)
        if curr == 91_u8 {
            square_depth = square_depth + 1_usize
        }
        elif curr == 93_u8 {
            square_depth = square_depth - 1_usize
        }
        elif curr == 40_u8 {
            paren_depth = paren_depth + 1_usize
        }
        elif curr == 41_u8 {
            paren_depth = paren_depth - 1_usize
        }
        elif curr == 60_u8 {
            angle_depth = angle_depth + 1_usize
        }
        elif curr == 62_u8 {
            angle_depth = angle_depth - 1_usize
        }
        elif curr == delimiter && scope_depth_is_zero(square_depth, paren_depth, angle_depth) {
            parts = parts.push(trim_spaces_text(text.slice(start, index - start)))
            start = index + 1_usize
        }

        index = index + 1_usize
    }

    ret parts
}

fn join_strings(items: Vec[String], separator: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    loop {
        match string_get(items, index) {
            Some(item) => {
                if index > 0_usize {
                    out = out + separator
                }
                out = concat(out, item.as_str())
                index = index + 1_usize
            }
            None => {
                ret out
            }
        }
    }
}

fn join_lines(items: Vec[String]) -> str {
    ret join_strings(items, "\n")
}

fn indent_lines(items: Vec[String], prefix: str) -> Vec[String] {
    let mut out = Vec[String]::new()
    let mut index = 0_usize
    loop {
        match string_get(items, index) {
            Some(item) => {
                let mut line = String::from_str(prefix)
                line = line.concat(item.as_str())
                out = out.push(line)
                index = index + 1_usize
            }
            None => {
                ret out
            }
        }
    }
}

fn append_lines(lhs: Vec[String], rhs: Vec[String]) -> Vec[String] {
    let mut out = lhs
    let mut index = 0_usize
    loop {
        match string_get(rhs, index) {
            Some(line) => {
                out = out.push(line)
                index = index + 1_usize
            }
            None => {
                ret out
            }
        }
    }
}

fn render_typed(name: str, typ: str) -> String {
    let mut out = String::from_str(name)
    out = out.concat(": ")
    out = out.concat(typ)
    ret out
}

fn render_assignable(name: str, typ: str, opcode: str, args: str) -> String {
    let mut out = render_typed(name, typ)
    out = out.concat(" = ")
    out = out.concat(opcode)
    if !args == "" {
        out = out.concat(" ")
        out = out.concat(args)
    }
    ret out
}

fn qualify_name(module_name: str, symbol: str) -> String {
    let mut out = String::from_str(module_name)
    out = out.concat("::")
    out = out.concat(symbol)
    ret out
}

fn build_tuple_type_name(arity: usize) -> String {
    let mut out = String::from_str("__tuple_")
    out = out.concat(Debug::fmt(arity))
    ret out
}

fn build_array_type_name(size: str) -> String {
    let mut out = String::from_str("__array_")
    out = out.concat(size)
    ret out
}

fn integer_literal_type(text: str) -> String {
    let text_len = text.len()
    let mut index = 0_usize
    let mut underscore = Option[usize]::None
    loop {
        if index >= text_len {
            break
        }
        if text.byte_at(index) == 95_u8 {
            underscore = Option[usize]::Some(index)
        }
        index = index + 1_usize
    }

    match underscore {
        Some(pos) => {
            ret String::from_str(text.slice(pos + 1_usize, text_len - pos - 1_usize))
        }
        None => {
            ret String::from_str("usize")
        }
    }
}

fn float_literal_type(text: str) -> String {
    let text_len = text.len()
    let mut index = 0_usize
    let mut underscore = Option[usize]::None
    loop {
        if index >= text_len {
            break
        }
        if text.byte_at(index) == 95_u8 {
            underscore = Option[usize]::Some(index)
        }
        index = index + 1_usize
    }

    match underscore {
        Some(pos) => {
            ret String::from_str(text.slice(pos + 1_usize, text_len - pos - 1_usize))
        }
        None => {
            ret String::from_str("f32")
        }
    }
}

fn unbox_expr(node: ExprNode<H>) -> ExprNode {
    ret ExprNode{node.value}
}

impl for Translator {
    pub fn new(module_name: str, ast: Vec[Statement]) -> Translator {
        ret Translator{
            String::from_str(module_name),
            ast,
            Vec[TypeAlias]::new(),
            Vec[StructInfo]::new(),
            Vec[FunctionInfo]::new(),
            0_usize
        }
    }

    pub fn translate(mut self) -> str {
        self.collect_types()
        self.collect_functions()

        let mut chunks = Vec[String]::new()
        let mut index = 0_usize
        loop {
            match statement_get(self.ast, index) {
                Some(statement) => {
                    match statement {
                        Statement::Struct(struct_stmt) => {
                            chunks = chunks.push(self.emit_struct(struct_stmt))
                        }
                        Statement::Function(function_item) => {
                            chunks = chunks.push(self.emit_function(function_item))
                        }
                        _ => {}
                    }
                    index = index + 1_usize
                }
                None => {
                    ret join_strings(chunks, "\n\n")
                }
            }
        }
    }

    fn collect_types(mut self) -> () {
        let mut index = 0_usize
        loop {
            match statement_get(self.ast, index) {
                Some(statement) => {
                    match statement {
                        Statement::Struct(struct_stmt) => {
                            let internal_name = qualify_name(self.module_name.as_str(), struct_stmt.name.as_str())
                            self.type_aliases = self.type_aliases.push(TypeAlias{struct_stmt.name, internal_name})

                            let mut fields = Vec[StructField]::new()
                            let mut field_index = 0_usize
                            loop {
                                match named_field_get(struct_stmt.named_fields, field_index) {
                                    Some(field_item) => {
                                        fields = fields.push(
                                            StructField{
                                                field_item.name,
                                                self.normalize_type(field_item.typ.as_str())
                                            }
                                        )
                                        field_index = field_index + 1_usize
                                    }
                                    None => {
                                        break
                                    }
                                }
                            }

                            let mut tuple_index = 0_usize
                            loop {
                                match string_get(struct_stmt.tuple_fields, tuple_index) {
                                    Some(field_type) => {
                                        fields = fields.push(
                                            StructField{
                                                String::from_str(Debug::fmt(tuple_index)),
                                                self.normalize_type(field_type.as_str())
                                            }
                                        )
                                        tuple_index = tuple_index + 1_usize
                                    }
                                    None => {
                                        break
                                    }
                                }
                            }

                            self.structs = self.structs.push(StructInfo{struct_stmt.name, internal_name, fields})
                        }
                        _ => {}
                    }
                    index = index + 1_usize
                }
                None => {
                    ret ()
                }
            }
        }
    }

    fn collect_functions(mut self) -> () {
        let mut index = 0_usize
        loop {
            match statement_get(self.ast, index) {
                Some(statement) => {
                    match statement {
                        Statement::Function(function_item) => {
                            let mut params = Vec[FunctionParam]::new()
                            let mut param_index = 0_usize
                            loop {
                                match function_param_get(function_item.params, param_index) {
                                    Some(param_item) => {
                                        match param_item.typ {
                                            Some(raw_typ) => {
                                                params = params.push(FunctionParam{param_item.name, Option[String]::Some(self.normalize_type(raw_typ.as_str()))})
                                            }
                                            None => {
                                                panic("Function parameter type must be known before translation")
                                            }
                                        }
                                        param_index = param_index + 1_usize
                                    }
                                    None => {
                                        break
                                    }
                                }
                            }

                            let ret_type = match function_item.ret_type {
                                Some(raw_typ) => {
                                    self.normalize_type(raw_typ.as_str())
                                }
                                None => {
                                    String::from_str("void")
                                }
                            }

                            self.functions = self.functions.push(
                                FunctionInfo{
                                    function_item.name,
                                    qualify_name(self.module_name.as_str(), function_item.name.as_str()),
                                    params,
                                    ret_type
                                }
                            )
                        }
                        _ => {}
                    }
                    index = index + 1_usize
                }
                None => {
                    ret ()
                }
            }
        }
    }

    fn resolve_type_alias(self, name: str) -> Option[String] {
        let mut index = 0_usize
        loop {
            match self.type_aliases.get(index) {
                Some(alias) => {
                    if alias.source_name.as_str() == name {
                        ret Option[String]::Some(alias.internal_name)
                    }
                    index = index + 1_usize
                }
                None => {
                    ret Option[String]::None
                }
            }
        }
    }

    fn resolve_struct(self, typ: str) -> Option[StructInfo] {
        let mut index = 0_usize
        loop {
            match struct_info_get(self.structs, index) {
                Some(info) => {
                    if info.internal_name.as_str() == typ {
                        ret Option[StructInfo]::Some(info)
                    }
                    index = index + 1_usize
                }
                None => {
                    ret Option[StructInfo]::None
                }
            }
        }
    }

    fn resolve_function(self, name: str) -> Option[FunctionInfo] {
        let mut index = 0_usize
        loop {
            match function_info_get(self.functions, index) {
                Some(info) => {
                    if info.source_name.as_str() == name) || str_eq(info.internal_name.as_str(), name {
                        ret Option[FunctionInfo]::Some(info)
                    }
                    index = index + 1_usize
                }
                None => {
                    ret Option[FunctionInfo]::None
                }
            }
        }
    }

    fn normalize_type(self, raw_text: str) -> String {
        let mut text = trim_spaces_text(raw_text)
        if starts_with_text(text.as_str(), "mut ") {
            text = String::from_str(slice(text.as_str(), 4_usize, len(text.as_str()) - 4_usize))
        }

        if text.as_str() == "()" {
            ret String::from_str("void")
        }

        let mut pointer_suffix = String::new()
        if ends_with_text(text.as_str(), "<H>") {
            pointer_suffix = String::from_str("<H>")
            text = slice_without_suffix(text.as_str(), 3_usize)
        }
        elif ends_with_text(text.as_str(), "<S>") {
            pointer_suffix = String::from_str("<S>")
            text = slice_without_suffix(text.as_str(), 3_usize)
        }
        elif ends_with_text(text.as_str(), "&") {
            pointer_suffix = String::from_str("&")
            text = slice_without_suffix(text.as_str(), 1_usize)
        }
        elif ends_with_text(text.as_str(), "*") {
            pointer_suffix = String::from_str("*")
            text = slice_without_suffix(text.as_str(), 1_usize)
        }

        let normalized = self.normalize_type_base(text.as_str())
        if pointer_suffix.as_str() == "" {
            ret normalized
        }

        let mut out = normalized
        out = out.concat(pointer_suffix.as_str())
        ret out
    }

    fn normalize_type_base(self, raw_text: str) -> String {
        let text = trim_spaces_text(raw_text)
        let text_len = len(text.as_str())

        if text_len > 1_usize && starts_with_text(text.as_str(), "(") && ends_with_text(text.as_str(), ")") {
            let inner = slice(text.as_str(), 1_usize, text_len - 2_usize)
            let parts = split_top_level(inner, 44_u8)
            let mut normalized = Vec[String]::new()
            let mut index = 0_usize
            loop {
                match string_get(parts, index) {
                    Some(part) => {
                        if !part.as_str() == "" {
                            normalized = normalized.push(self.normalize_type(part.as_str()))
                        }
                        index = index + 1_usize
                    }
                    None => {
                        if line_count(normalized) == 0_usize {
                            ret String::from_str("void")
                        }
                        let mut out = build_tuple_type_name(line_count(normalized))
                        out = out.concat("[")
                        out = out.concat(join_strings(normalized, ", "))
                        out = out.concat("]")
                        ret out
                    }
                }
            }
        }

        if text_len > 1_usize && starts_with_text(text.as_str(), "[") && ends_with_text(text.as_str(), "]") {
            let inner = slice(text.as_str(), 1_usize, text_len - 2_usize)
            let parts = split_top_level(inner, 59_u8)
            let mut item_type = String::from_str("invalid")
            match string_get(parts, 0_usize) {
                Some(value) => {
                    item_type = self.normalize_type(value.as_str())
                }
                None => {
                    panic("Array type must contain item type")
                }
            }
            let mut size = String::from_str("0")
            match string_get(parts, 1_usize) {
                Some(value) => {
                    size = trim_spaces_text(value.as_str())
                }
                None => {
                    panic("Array type must contain size")
                }
            }

            let mut out = build_array_type_name(size.as_str())
            out = out.concat("[")
            out = out.concat(item_type.as_str())
            out = out.concat("]")
            ret out
        }

        match self.resolve_type_alias(text.as_str()) {
            Some(value) => {
                ret value
            }
            None => {
                ret text
            }
        }
    }

    fn lookup_local(self, locals: Vec[LocalBinding], name: str) -> Option[LocalBinding] {
        let mut index = 0_usize
        let mut found = Option[LocalBinding]::None
        loop {
            match local_binding_get(locals, index) {
                Some(binding) => {
                    if binding.name.as_str() == name {
                        found = Option[LocalBinding]::Some(binding)
                    }
                    index = index + 1_usize
                }
                None => {
                    ret found
                }
            }
        }
    }

    fn bind_local(self, locals: Vec[LocalBinding], name: String, var_name: String, typ: String) -> Vec[LocalBinding] {
        let mut out = locals
        out = out.push(LocalBinding{name, var_name, typ})
        ret out
    }

    fn fresh_temp(mut self, typ: str) -> String {
        let mut out = String::from_str("_")
        out = out.concat(Debug::fmt(self.next_temp))
        self.next_temp = self.next_temp + 1_usize
        ret out
    }

    fn qualify_function_name(self, raw_name: str) -> String {
        match self.resolve_function(raw_name) {
            Some(info) => {
                ret info.internal_name
            }
            None => {
                ret String::from_str(raw_name)
            }
        }
    }

    fn emit_struct(self, struct_stmt: StructStmt) -> String {
        let mut lines = Vec[String]::new()
        let struct_name = self.normalize_type(struct_stmt.name.as_str())
        let mut header = String::from_str("struct ")
        header = header.concat(struct_name.as_str())
        header = header.concat(" {")
        lines = lines.push(header)

        let mut index = 0_usize
        loop {
            match named_field_get(struct_stmt.named_fields, index) {
                Some(field_item) => {
                    let mut line = String::from_str("  ")
                    line = line.concat(field_item.name.as_str())
                    line = line.concat(": ")
                    line = line.concat(as_str(self.normalize_type(field_item.typ.as_str())))
                    lines = lines.push(line)
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        let mut tuple_index = 0_usize
        loop {
            match string_get(struct_stmt.tuple_fields, tuple_index) {
                Some(field_type) => {
                    let mut line = String::from_str("  ")
                    line = line.concat(Debug::fmt(tuple_index))
                    line = line.concat(": ")
                    line = line.concat(as_str(self.normalize_type(field_type.as_str())))
                    lines = lines.push(line)
                    tuple_index = tuple_index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        lines = lines.push(String::from_str("}"))
        ret String::from_str(join_lines(lines))
    }

    fn emit_function(mut self, function_item: FunctionItem) -> String {
        if function_item.is_extern {
            panic("Extern lowering is not implemented yet in self-hosted translator MVP")
        }

        let mut info = FunctionInfo{String::from_str("invalid"), String::from_str("invalid"), Vec[FunctionParam]::new(), String::from_str("void")}
        match self.resolve_function(function_item.name.as_str()) {
            Some(value) => {
                info = value
            }
            None => {
                panic("Function must be registered before translation")
            }
        }

        let mut out = String::from_str("fn ")
        out = out.concat(info.internal_name.as_str())
        out = out.concat("(")

        let mut rendered_params = Vec[String]::new()
        let mut param_index = 0_usize
        let mut locals = Vec[LocalBinding]::new()
        loop {
            match function_param_get(info.params, param_index) {
                Some(param_item) => {
                    match param_item.typ {
                        Some(typ) => {
                            rendered_params = rendered_params.push(render_typed(param_item.name.as_str(), typ.as_str()))
                            locals = self.bind_local(locals, param_item.name, param_item.name, typ)
                        }
                        None => {
                            panic("Function parameter type must be known before translation")
                        }
                    }
                    param_index = param_index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        out = out.concat(join_strings(rendered_params, ", "))
        out = out.concat(") -> ")
        out = out.concat(info.ret_type.as_str())
        out = out.concat(" {")

        let mut body_lines = Vec[String]::new()
        body_lines = body_lines.push(String::from_str("$entry:"))

        match function_item.body {
            Some(body) => {
                let lowered = self.lower_statements(body.statements, locals, info.ret_type.as_str())
                body_lines = append_lines(body_lines, indent_lines(lowered.lines, "  "))
            }
            None => {
                panic("Function body is required for translation")
            }
        }

        out = out.concat("\n")
        out = out.concat(join_lines(body_lines))
        out = out.concat("\n}")
        ret out
    }

    fn lower_statements(mut self, statements: Vec[Statement], locals: Vec[LocalBinding], ret_type: str) -> LoweredStmt {
        let mut lines = Vec[String]::new()
        let mut current_locals = locals
        let mut index = 0_usize
        loop {
            match statement_get(statements, index) {
                Some(statement) => {
                    let lowered = self.lower_statement(statement, current_locals, ret_type)
                    lines = append_lines(lines, lowered.lines)
                    current_locals = lowered.locals
                    if lowered.terminated {
                        ret LoweredStmt{lines, current_locals, true}
                    }
                    index = index + 1_usize
                }
                None => {
                    ret LoweredStmt{lines, current_locals, false}
                }
            }
        }
    }

    fn lower_statement(mut self, statement: Statement, locals: Vec[LocalBinding], ret_type: str) -> LoweredStmt {
        match statement {
            Statement::Let(let_stmt) => {
                ret self.lower_let(let_stmt, locals)
            }
            Statement::Assignment(assignment_stmt) => {
                ret self.lower_assignment(assignment_stmt, locals)
            }
            Statement::Ret(expr) => {
                let lowered = self.lower_expr(expr, locals, Option[String]::Some(String::from_str(ret_type)))
                let mut lines = lowered.lines
                let ret_line = {
                    let mut out = String::from_str("ret ")
                    out = out.concat(as_str(render_typed(lowered.var_name.as_str(), lowered.typ.as_str())))
                    out
                }
                lines = lines.push(ret_line)
                ret LoweredStmt{lines, locals, true}
            }
            Statement::Expr(expr) => {
                let lowered = self.lower_expr(expr, locals, Option[String]::None)
                ret LoweredStmt{lowered.lines, locals, false}
            }
            _ => {
                panic("Only straight-line let/assignment/ret/expr statements are supported in translator MVP")
                ret LoweredStmt{Vec[String]::new(), locals, false}
            }
        }
    }

    fn lower_let(mut self, let_stmt: LetStmt, locals: Vec[LocalBinding]) -> LoweredStmt {
        let hint = match let_stmt.typ {
            Some(typ) => {
                Option[String]::Some(self.normalize_type(typ.as_str()))
            }
            None => {
                Option[String]::None
            }
        }

        let lowered = self.lower_expr(let_stmt.expr, locals, hint)
        let new_locals = self.bind_local(locals, let_stmt.name, lowered.var_name, lowered.typ)
        ret LoweredStmt{lowered.lines, new_locals, false}
    }

    fn lower_assignment(mut self, assignment_stmt: AssignmentStmt, locals: Vec[LocalBinding]) -> LoweredStmt {
        match assignment_stmt.target.value {
            Expr::Path(name) => {
                let mut current = LocalBinding{String::from_str("invalid"), String::from_str("invalid"), String::from_str("invalid")}
                match self.lookup_local(locals, name.as_str()) {
                    Some(value) => {
                        current = value
                    }
                    None => {
                        panic("Assignment target must be a known local binding")
                    }
                }

                let lowered = self.lower_expr(assignment_stmt.expr, locals, Option[String]::Some(current.typ))
                let new_locals = self.bind_local(locals, name, lowered.var_name, current.typ)
                ret LoweredStmt{lowered.lines, new_locals, false}
            }
            _ => {
                panic("Only direct local-variable assignment is supported in translator MVP")
                ret LoweredStmt{Vec[String]::new(), locals, false}
            }
        }
    }

    fn lower_expr(mut self, expr: ExprNode, locals: Vec[LocalBinding], hint: Option[String]) -> LoweredExpr {
        match expr.value {
            Expr::Boolean(bool_value) => {
                let bool_typ = String::from_str("bool")
                let bool_out = self.fresh_temp(bool_typ.as_str())
                let literal = if bool_value { "true" } else { "false" }
                let line = render_assignable(bool_out.as_str(), bool_typ.as_str(), "lcpos", literal)
                let mut lines = Vec[String]::new()
                lines = lines.push(line)
                ret LoweredExpr{lines, bool_out, bool_typ}
            }
            Expr::Integer(int_value) => {
                let int_typ = integer_literal_type(int_value.as_str())
                let int_out = self.fresh_temp(int_typ.as_str())
                let line = render_assignable(int_out.as_str(), int_typ.as_str(), "lcpos", int_value.as_str())
                let mut lines = Vec[String]::new()
                lines = lines.push(line)
                ret LoweredExpr{lines, int_out, int_typ}
            }
            Expr::Float(float_value) => {
                let float_typ = float_literal_type(float_value.as_str())
                let float_out = self.fresh_temp(float_typ.as_str())
                let line = render_assignable(float_out.as_str(), float_typ.as_str(), "lcpos", float_value.as_str())
                let mut lines = Vec[String]::new()
                lines = lines.push(line)
                ret LoweredExpr{lines, float_out, float_typ}
            }
            Expr::StringLiteral(string_value) => {
                let string_typ = String::from_str("str")
                let string_out = self.fresh_temp(string_typ.as_str())
                let line = render_assignable(string_out.as_str(), string_typ.as_str(), "lcpos", string_value.as_str())
                let mut lines = Vec[String]::new()
                lines = lines.push(line)
                ret LoweredExpr{lines, string_out, string_typ}
            }
            Expr::Path(path) => {
                match self.lookup_local(locals, path.as_str()) {
                    Some(binding) => {
                        ret LoweredExpr{Vec[String]::new(), binding.var_name, binding.typ}
                    }
                    None => {
                        panic("Only local path expressions are supported in translator MVP")
                        ret LoweredExpr{Vec[String]::new(), String::from_str("invalid"), String::from_str("invalid")}
                    }
                }
            }
            Expr::Parenthesized(inner) => {
                ret self.lower_expr(unbox_expr(inner), locals, hint)
            }
            Expr::Binary(binary_expr) => {
                ret self.lower_binary(binary_expr, locals)
            }
            Expr::Call(call_expr) => {
                ret self.lower_call(call_expr, locals, hint)
            }
            Expr::Field(field_expr) => {
                ret self.lower_field(field_expr, locals)
            }
            Expr::StructInit(struct_init) => {
                ret self.lower_struct_init(struct_init, locals)
            }
            _ => {
                panic("Expression is not implemented in translator MVP")
                ret LoweredExpr{Vec[String]::new(), String::from_str("invalid"), String::from_str("invalid")}
            }
        }
    }

    fn lower_binary(mut self, binary_expr: BinaryExpr, locals: Vec[LocalBinding]) -> LoweredExpr {
        let lhs = self.lower_expr(unbox_expr(binary_expr.lhs), locals, Option[String]::None)
        let rhs = self.lower_expr(unbox_expr(binary_expr.rhs), locals, Option[String]::Some(lhs.typ))

        let mut lines = append_lines(lhs.lines, rhs.lines)
        let mut result_type = lhs.typ
        if binary_expr.operator.as_str() == "=="
            || binary_expr.operator.as_str() == "!="
            || binary_expr.operator.as_str() == "<"
            || binary_expr.operator.as_str() == "<="
            || binary_expr.operator.as_str() == ">"
            || binary_expr.operator.as_str() == ">="
            || binary_expr.operator.as_str() == "&&"
            || binary_expr.operator.as_str() == "||" {
            result_type = String::from_str("bool")
        }

        let mut opcode = "invalid"
        if binary_expr.operator.as_str() == "+" { opcode = "add" }
        elif binary_expr.operator.as_str() == "-" { opcode = "sub" }
        elif binary_expr.operator.as_str() == "*" { opcode = "mul" }
        elif binary_expr.operator.as_str() == "/" { opcode = "div" }
        elif binary_expr.operator.as_str() == "%" { opcode = "mod" }
        elif binary_expr.operator.as_str() == "<<" { opcode = "shl" }
        elif binary_expr.operator.as_str() == ">>" { opcode = "shr" }
        elif binary_expr.operator.as_str() == "<" { opcode = "les" }
        elif binary_expr.operator.as_str() == "<=" { opcode = "leq" }
        elif binary_expr.operator.as_str() == ">" { opcode = "grt" }
        elif binary_expr.operator.as_str() == ">=" { opcode = "geq" }
        elif binary_expr.operator.as_str() == "==" { opcode = "ieq" }
        elif binary_expr.operator.as_str() == "!=" { opcode = "neq" }
        elif binary_expr.operator.as_str() == "&&" { opcode = "and" }
        elif binary_expr.operator.as_str() == "||" { opcode = "or" }
        elif binary_expr.operator.as_str() == "&" { opcode = "and" }
        elif binary_expr.operator.as_str() == "|" { opcode = "or" }
        elif binary_expr.operator.as_str() == "^" { opcode = "xor" }
        else { panic("Binary operator is not implemented in translator MVP") }

        let out = self.fresh_temp(result_type.as_str())
        let mut args = render_typed(lhs.var_name.as_str(), lhs.typ.as_str())
        args = args.concat(", ")
        args = args.concat(render_typed(rhs.var_name.as_str(), rhs.typ.as_str()).as_str())
        lines = lines.push(render_assignable(out.as_str(), result_type.as_str(), opcode, args.as_str()))
        ret LoweredExpr{lines, out, result_type}
    }

    fn lower_call(mut self, call_expr: CallExpr, locals: Vec[LocalBinding], hint: Option[String]) -> LoweredExpr {
        match call_expr.callee.value {
            Expr::Path(path) => {
                let call_name = self.qualify_function_name(path.as_str())
                let mut lines = Vec[String]::new()
                let mut rendered_args = Vec[String]::new()
                let mut index = 0_usize
                loop {
                    match expr_get(call_expr.args, index) {
                        Some(arg_expr) => {
                            let lowered_arg = self.lower_expr(arg_expr, locals, Option[String]::None)
                            lines = append_lines(lines, lowered_arg.lines)
                            rendered_args = rendered_args.push(render_typed(lowered_arg.var_name.as_str(), lowered_arg.typ.as_str()))
                            index = index + 1_usize
                        }
                        None => {
                            break
                        }
                    }
                }

                let mut ret_type = String::from_str("invalid")
                match self.resolve_function(path.as_str()) {
                    Some(info) => {
                        ret_type = info.ret_type
                    }
                    None => {
                        match hint {
                            Some(value) => {
                                ret_type = value
                            }
                            None => {
                                panic("Unable to infer call return type in translator MVP")
                            }
                        }
                    }
                }

                let out = self.fresh_temp(ret_type.as_str())
                let mut args = String::from_str(call_name.as_str())
                args = args.concat("(")
                args = args.concat(join_strings(rendered_args, ", "))
                args = args.concat(")")
                lines = lines.push(render_assignable(out.as_str(), ret_type.as_str(), "call", args.as_str()))
                ret LoweredExpr{lines, out, ret_type}
            }
            _ => {
                panic("Only path callees are supported in translator MVP")
                ret LoweredExpr{Vec[String]::new(), String::from_str("invalid"), String::from_str("invalid")}
            }
        }
    }

    fn lower_field(mut self, field_expr: FieldExpr, locals: Vec[LocalBinding]) -> LoweredExpr {
        let base = self.lower_expr(unbox_expr(field_expr.base), locals, Option[String]::None)
        let mut struct_info = StructInfo{String::from_str("invalid"), String::from_str("invalid"), Vec[StructField]::new()}
        match self.resolve_struct(base.typ.as_str()) {
            Some(value) => {
                struct_info = value
            }
            None => {
                panic("Field access requires known local struct type")
            }
        }

        let mut field_type = String::from_str("invalid")
        let mut index = 0_usize
        loop {
            match struct_field_get(struct_info.fields, index) {
                Some(field_item) => {
                    if field_item.name.as_str() == field_expr.field.as_str()) || str_eq(field_item.name.as_str(), Debug::fmt(index) {
                        field_type = field_item.typ
                        break
                    }
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        if field_type.as_str() == "invalid" {
            panic("Unknown field in translator MVP")
        }

        let mut lines = base.lines
        let out = self.fresh_temp(field_type.as_str())
        let mut args = render_typed(base.var_name.as_str(), base.typ.as_str())
        args = args.concat(", ")
        args = args.concat(render_typed(field_expr.field.as_str(), field_type.as_str()).as_str())
        lines = lines.push(render_assignable(out.as_str(), field_type.as_str(), "getfield", args.as_str()))
        ret LoweredExpr{lines, out, field_type}
    }

    fn lower_struct_init(mut self, struct_init: StructInitExpr, locals: Vec[LocalBinding]) -> LoweredExpr {
        let typ = self.normalize_type(struct_init.path.as_str())
        let mut struct_info = StructInfo{String::from_str("invalid"), String::from_str("invalid"), Vec[StructField]::new()}
        match self.resolve_struct(typ.as_str()) {
            Some(value) => {
                struct_info = value
            }
            None => {
                panic("Struct init requires known local struct")
            }
        }

        let mut lines = Vec[String]::new()
        let mut rendered_args = Vec[String]::new()
        let mut index = 0_usize
        loop {
            match expr_get(struct_init.values, index) {
                Some(value_expr) => {
                    let lowered_value = self.lower_expr(value_expr, locals, Option[String]::None)
                    lines = append_lines(lines, lowered_value.lines)
                    rendered_args = rendered_args.push(render_typed(lowered_value.var_name.as_str(), lowered_value.typ.as_str()))
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        if line_count(rendered_args) != field_count(struct_info.fields) {
            panic("Struct init arity mismatch in translator MVP")
        }

        let out = self.fresh_temp(typ.as_str())
        let mut args = String::from_str(typ.as_str())
        args = args.concat("(")
        args = args.concat(join_strings(rendered_args, ", "))
        args = args.concat(")")
        lines = lines.push(render_assignable(out.as_str(), typ.as_str(), "lcsos", args.as_str()))
        ret LoweredExpr{lines, out, typ}
    }
}
