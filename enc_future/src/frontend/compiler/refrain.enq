import core::option::Option
import core::panic::panic
import std::path::Path
import std::vec::Vec

import mod::manifest::ProjectManifest
import mod::manifest::manifest_read


pub struct Refrain {
    name: str
    path: Path
    target: str
    dependencies: Vec[str]
}

pub fn resolve_project_target(root: Path) -> str {
    match manifest_read(root) {
        Some(manifest) => {
            if manifest.target != "auto" {
                ret manifest.target
            }

            if Path::exists(root / "src" / "main.enq") {
                ret "executable"
            }

            if Path::exists(root / "src" / "lib.enq") {
                ret "static_lib"
            }

            ret "object"
        }
        None => {
            ret "object"
        }
    }
}

pub fn load_refrain_graph(root: Path, target: str) -> Vec[Refrain] {
    ret load_refrain_recursive(root, target, Vec[Refrain]::new())
}

pub fn determine_entry_module(refrain: Refrain) -> Option[Path] {
    if refrain.target == "executable" {
        let main_path = refrain.path / "src" / "main.enq"
        if Path::exists(main_path) {
            ret Option[Path]::Some(main_path)
        }
        ret Option[Path]::None
    }

    let lib_path = refrain.path / "src" / "lib.enq"
    if Path::exists(lib_path) {
        ret Option[Path]::Some(lib_path)
    }

    let main_path = refrain.path / "src" / "main.enq"
    if Path::exists(main_path) {
        ret Option[Path]::Some(main_path)
    }

    ret Option[Path]::None
}

pub fn find_refrain_by_name(refrains: Vec[Refrain], name: str) -> Option[Refrain] {
    ret find_refrain_by_name_from(refrains, name, 0_usize)
}

fn load_refrain_recursive(root: Path, target: str, loaded: Vec[Refrain]) -> Vec[Refrain] {
    if has_refrain_path(loaded, root) {
        ret loaded
    }

    match manifest_read(root) {
        Some(manifest) => {
            let mut next = loaded
            let mut index = 0_usize
            loop {
                match Vec[str]::get(manifest.dependencies, index) {
                    Some(dep) => {
                        match resolve_dependency_path(dep, root) {
                            Some(dep_path) => {
                                next = load_refrain_recursive(dep_path, "object", next)
                            }
                            None => {
                                panic("Only path@ dependencies are supported in self-hosted compiler for now")
                            }
                        }
                        index = index + 1_usize
                    }
                    None => {
                        break
                    }
                }
            }

            ret Vec[Refrain]::push(
                next,
                Refrain{
                    manifest.name,
                    root,
                    target,
                    manifest.dependencies
                }
            )
        }
        None => {
            panic("Unable to read refrain manifest")
            ret loaded
        }
    }
}

fn resolve_dependency_path(dep: str, base: Path) -> Option[Path] {
    if !starts_with(dep, "path@") {
        ret Option[Path]::None
    }

    ret Option[Path]::Some(base / dep.slice(5_usize, dep.len() - 5_usize))
}

fn has_refrain_path(refrains: Vec[Refrain], path: Path) -> bool {
    let raw = Path::as_str(path)
    let mut index = 0_usize
    loop {
        match Vec[Refrain]::get(refrains, index) {
            Some(refrain) => {
                if Path::as_str(refrain.path) == raw {
                    ret true
                }
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }
    ret false
}

fn find_refrain_by_name_from(refrains: Vec[Refrain], name: str, index: usize) -> Option[Refrain] {
    match Vec[Refrain]::get(refrains, index) {
        Some(refrain) => {
            if refrain.name == name {
                ret Option[Refrain]::Some(refrain)
            }
            ret find_refrain_by_name_from(refrains, name, index + 1_usize)
        }
        None => {
            ret Option[Refrain]::None
        }
    }
}

fn starts_with(text: str, prefix: str) -> bool {
    if text.len() < prefix.len() {
        ret false
    }
    ret text.slice(0_usize, prefix.len()) == prefix
}
