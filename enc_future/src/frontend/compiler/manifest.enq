import core::option::Option
import std::path::Path
import std::string::String
import std::vec::Vec

import toml::TomlDocument
import toml::toml_get_string
import toml::toml_get_string_array
import toml::toml_parse_document


pub struct ProjectManifest {
    name: str
    target: str
    version: str
    description: str
    readme: str
    licence: str
    dependencies: Vec[str]
}

pub fn manifest_filename() -> str {
    ret "encore.toml"
}

pub fn manifest_read(root: Path) -> Option[ProjectManifest] {
    let manifest_path = root / manifest_filename()
    if !Path::exists(manifest_path) {
        ret Option[ProjectManifest]::None
    }

    let source = String::as_str(Path::read_text(manifest_path))
    let doc = toml_parse_document(source)

    match toml_get_string(doc, "project", "name") {
        Some(name) => {
            let target = manifest_get_string_or(doc, "project", "target", "auto")
            let version = manifest_get_string_or(doc, "project", "version", "0.0.0")
            let description = manifest_get_string_or(doc, "project", "description", "")
            let readme = manifest_get_string_or(doc, "project", "readme", "README.md")
            let licence = manifest_get_string_or(doc, "project", "licence", "MIT")
            let dependencies = manifest_get_string_array_or_empty(doc, "project", "dependencies")
            let manifest = ProjectManifest{
                name,
                target,
                version,
                description,
                readme,
                licence,
                dependencies
            }
            ret Option[ProjectManifest]::Some(manifest)
        }
        None => {
            ret Option[ProjectManifest]::None
        }
    }
}

fn manifest_get_string_or(doc: TomlDocument, section: str, key: str, fallback: str) -> str {
    match toml_get_string(doc, section, key) {
        Some(value) => {
            ret value
        }
        None => {
            ret fallback
        }
    }
}

fn manifest_get_string_array_or_empty(doc: TomlDocument, section: str, key: str) -> Vec[str] {
    match toml_get_string_array(doc, section, key) {
        Some(items) => {
            ret items
        }
        None => {
            ret Vec[str]::new()
        }
    }
}
