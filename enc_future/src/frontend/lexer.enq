import std::vec::Vec
import std::vec::push_front
import std::io::print
import std::io::println
import std::string::len
import std::string::byte_at
import std::string::slice
import std::string::str_eq
import repo::frontend::token::TokenType
import repo::frontend::token::Token
import repo::frontend::token::make_token
import repo::frontend::token::is_unknown
import repo::frontend::token::token_type_name

pub struct LexedToken {
    token: Token
    next: Lexer
}

pub struct Lexer {
    source: str
    line: usize
    column: usize
    consumed: usize
}

impl for Lexer {
    pub fn new() -> Lexer {
        ret Lexer{"", 1, 1, 0}
    }

    pub fn from_source(source: str) -> Lexer {
        ret Lexer{source, 1, 1, 0}
    }

    pub fn tokenize(self: Lexer, source: str) -> Vec[Token] {
        let start = Lexer::from_source(source)
        ret Lexer::tokenize_from(start)
    }

    pub fn print_tokens(self: Lexer, source: str) -> u32 {
        let start = Lexer::from_source(source)
        ret Lexer::print_tokens_from(start)
    }

    pub fn next_token(self: Lexer) -> LexedToken {
        ret Lexer::consume_token(self)
    }

    fn print_tokens_from(self: Lexer) -> u32 {
        let lexed = Lexer::consume_token(self)
        let token: Token = lexed.token
        if (is_eof(token.type)) {
            print("EOF: ")
            println("")
            ret 0_u32
        }

        print(token_type_name(token.type))
        print(": ")
        println(token.value)
        ret Lexer::print_tokens_from(lexed.next)
    }

    fn tokenize_from(self: Lexer) -> Vec[Token] {
        let lexed = Lexer::consume_token(self)
        let token: Token = lexed.token
        if (is_eof(token.type)) {
            ret push_front(Vec[Token]::Empty, token)
        }
        ret push_front(Lexer::tokenize_from(lexed.next), token)
    }

    fn consume_token(self: Lexer) -> LexedToken {
        let next = Lexer::skip_ignored(self)
        if (Lexer::is_at_end(next)) {
            let token = make_token(TokenType::EOF, "", next.line, next.column)
            ret LexedToken{token, next}
        }
        ret Lexer::lex_one(next)
    }

    fn skip_ignored(self: Lexer) -> Lexer {
        if (Lexer::is_at_end(self)) {
            ret self
        }

        let source = self.source
        let index = self.consumed
        let line = self.line
        let column = self.column
        let ch = byte_at(source, index)

        if (ch == 32) {
            ret Lexer::skip_ignored(Lexer{source, line, column + 1, index + 1})
        }
        if (ch == 9) {
            ret Lexer::skip_ignored(Lexer{source, line, column + 1, index + 1})
        }
        if (ch == 13) {
            ret Lexer::skip_ignored(Lexer{source, line, column + 1, index + 1})
        }
        if (ch == 10) {
            ret Lexer::skip_ignored(Lexer{source, line + 1, 1, index + 1})
        }

        ret self
    }

    fn lex_one(self: Lexer) -> LexedToken {
        let fixed = Lexer::try_fixed_token(self)
        let fixed_token = fixed.token
        if (is_unknown(fixed_token.type)) {
            let source = self.source
            let index = self.consumed
            let line = self.line
            let column = self.column
            let ch = byte_at(source, index)

            if (ch == 34) {
                ret Lexer::lex_string(self)
            }
            if (is_digit(ch)) {
                ret Lexer::lex_number(self)
            }
            if (is_identifier_start(ch)) {
                ret Lexer::lex_identifier(self)
            }

            let value = slice(source, index, 1)
            let token = make_token(TokenType::UNKNOWN, value, line, column)
            let next = Lexer{source, line, column + 1, index + 1}
            ret LexedToken{token, next}
        }
        ret fixed
    }

    fn try_fixed_token(self: Lexer) -> LexedToken {
        if (Lexer::starts_with(self, "<<=")) {
            ret Lexer::make_fixed_token(self, 3, TokenType::OP_LSHIFT_ASSIGN)
        }
        if (Lexer::starts_with(self, ">>=")) {
            ret Lexer::make_fixed_token(self, 3, TokenType::OP_RSHIFT_ASSIGN)
        }
        if (Lexer::starts_with(self, "::")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_SCOPE)
        }
        if (Lexer::starts_with(self, "=>")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_FAT_ARROW)
        }
        if (Lexer::starts_with(self, "==")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_EQUAL)
        }
        if (Lexer::starts_with(self, "!=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_NOT_EQUAL)
        }
        if (Lexer::starts_with(self, "<=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_LESS_EQUAL)
        }
        if (Lexer::starts_with(self, ">=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_GREATER_EQUAL)
        }
        if (Lexer::starts_with(self, "->")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_ARROW)
        }
        if (Lexer::starts_with(self, "&&")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_AND)
        }
        if (Lexer::starts_with(self, "||")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_OR)
        }
        if (Lexer::starts_with(self, "<<")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_LEFT_SHIFT)
        }
        if (Lexer::starts_with(self, ">>")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_RIGHT_SHIFT)
        }
        if (Lexer::starts_with(self, "+=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_PLUS_ASSIGN)
        }
        if (Lexer::starts_with(self, "-=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_MINUS_ASSIGN)
        }
        if (Lexer::starts_with(self, "*=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_MULT_ASSIGN)
        }
        if (Lexer::starts_with(self, "/=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_DIV_ASSIGN)
        }
        if (Lexer::starts_with(self, "%=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_MOD_ASSIGN)
        }
        if (Lexer::starts_with(self, "&=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_AND_ASSIGN)
        }
        if (Lexer::starts_with(self, "|=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_OR_ASSIGN)
        }
        if (Lexer::starts_with(self, "^=")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_XOR_ASSIGN)
        }
        if (Lexer::starts_with(self, "++")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_INCREMENT)
        }
        if (Lexer::starts_with(self, "--")) {
            ret Lexer::make_fixed_token(self, 2, TokenType::OP_DECREMENT)
        }

        let source = self.source
        let index = self.consumed
        let ch = byte_at(source, index)

        if (ch == 43) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_PLUS) }
        if (ch == 45) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_MINUS) }
        if (ch == 42) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_MULTIPLY) }
        if (ch == 47) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_DIVIDE) }
        if (ch == 37) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_MODULO) }
        if (ch == 60) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_LESS) }
        if (ch == 62) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_GREATER) }
        if (ch == 33) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_NOT) }
        if (ch == 63) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_TRY) }
        if (ch == 61) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_ASSIGN) }
        if (ch == 38) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_BIT_AND) }
        if (ch == 124) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_BIT_OR) }
        if (ch == 94) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_BIT_XOR) }
        if (ch == 126) { ret Lexer::make_fixed_token(self, 1, TokenType::OP_BIT_NOT) }
        if (ch == 40) { ret Lexer::make_fixed_token(self, 1, TokenType::LEFT_PAREN) }
        if (ch == 41) { ret Lexer::make_fixed_token(self, 1, TokenType::RIGHT_PAREN) }
        if (ch == 123) { ret Lexer::make_fixed_token(self, 1, TokenType::LEFT_BRACE) }
        if (ch == 125) { ret Lexer::make_fixed_token(self, 1, TokenType::RIGHT_BRACE) }
        if (ch == 91) { ret Lexer::make_fixed_token(self, 1, TokenType::LEFT_BRACKET) }
        if (ch == 93) { ret Lexer::make_fixed_token(self, 1, TokenType::RIGHT_BRACKET) }
        if (ch == 58) { ret Lexer::make_fixed_token(self, 1, TokenType::COLON) }
        if (ch == 44) { ret Lexer::make_fixed_token(self, 1, TokenType::COMMA) }
        if (ch == 46) { ret Lexer::make_fixed_token(self, 1, TokenType::DOT) }

        let token = make_token(TokenType::UNKNOWN, "", self.line, self.column)
        ret LexedToken{token, self}
    }

    fn make_fixed_token(self: Lexer, size: usize, token_type: TokenType) -> LexedToken {
        let source = self.source
        let index = self.consumed
        let line = self.line
        let column = self.column
        let value = slice(source, index, size)
        let token = make_token(token_type, value, line, column)
        let next = Lexer{source, line, column + size, index + size}
        ret LexedToken{token, next}
    }

    fn lex_string(self: Lexer) -> LexedToken {
        let source = self.source
        let index = self.consumed
        let line = self.line
        let column = self.column
        let end = scan_string_end(source, index + 1)
        let token_len = end - index
        let value = slice(source, index, token_len)
        let token = make_token(TokenType::STRING, value, line, column)
        let next = Lexer{source, line, column + token_len, end}
        ret LexedToken{token, next}
    }

    fn lex_number(self: Lexer) -> LexedToken {
        let source = self.source
        let index = self.consumed
        let line = self.line
        let column = self.column
        let source_len = len(source)
        let int_end = scan_digits(source, index)

        let has_fraction = next_is_fraction_digit(source, source_len, int_end)
        let ends_with_fraction = if (int_end < source_len) {
            let sep = byte_at(source, int_end)
            if (sep == 46) {
                has_fraction
            } else {
                false
            }
        } else {
            false
        }

        let number_end = if (ends_with_fraction) {
            scan_digits(source, int_end + 1)
        } else {
            int_end
        }

        let suffix_end = scan_numeric_suffix_end(source, number_end)
        let is_float_literal = if (ends_with_fraction) {
            true
        } else {
            is_float_suffix(source, number_end, suffix_end)
        }
        let token_type = if (is_float_literal) { TokenType::FLOAT } else { TokenType::INTEGER }

        let token_len = suffix_end - index
        let value = slice(source, index, token_len)
        let token = make_token(token_type, value, line, column)
        let next = Lexer{source, line, column + token_len, suffix_end}
        ret LexedToken{token, next}
    }

    fn lex_identifier(self: Lexer) -> LexedToken {
        let source = self.source
        let index = self.consumed
        let line = self.line
        let column = self.column
        let end = scan_identifier_end(source, index)
        let token_len = end - index
        let value = slice(source, index, token_len)
        let token = make_token(keyword_type(value), value, line, column)
        let next = Lexer{source, line, column + token_len, end}
        ret LexedToken{token, next}
    }

    fn peek_curr(self: Lexer) -> str {
        ret Lexer::peek_n(self, 0)
    }

    fn peek_next(self: Lexer) -> str {
        ret Lexer::peek_n(self, 1)
    }

    fn peek_n(self: Lexer, n: usize) -> str {
        if (self.consumed + n >= len(self.source)) {
            ret ""
        }
        ret slice(self.source, self.consumed + n, 1)
    }

    fn starts_with(self: Lexer, prefix: str) -> bool {
        let prefix_len = len(prefix)
        if (self.consumed + prefix_len > len(self.source)) {
            ret false
        }
        ret str_eq(slice(self.source, self.consumed, prefix_len), prefix)
    }

    fn is_at_end(self: Lexer) -> bool {
        ret self.consumed >= len(self.source)
    }
}

fn scan_string_end(source: str, index: usize) -> usize {
    if (index >= len(source)) {
        ret len(source)
    }

    let ch = byte_at(source, index)
    if (ch == 92) {
        if (index + 1 >= len(source)) {
            ret len(source)
        }
        ret scan_string_end(source, index + 2)
    }
    if (ch == 34) {
        ret index + 1
    }

    ret scan_string_end(source, index + 1)
}

fn scan_digits(source: str, index: usize) -> usize {
    if (index >= len(source)) {
        ret index
    }

    let ch = byte_at(source, index)
    if (is_digit(ch)) {
        ret scan_digits(source, index + 1)
    }

    if (ch == 95) {
        let next = index + 1
        if (next < len(source)) {
            if (is_digit(byte_at(source, next))) {
                ret scan_digits(source, next)
            }
        }
    }

    ret index
}

fn scan_numeric_suffix_end(source: str, start: usize) -> usize {
    if (start >= len(source)) {
        ret start
    }

    let ch = byte_at(source, start)
    if (ch == 95) {
        let suffix_start = start + 1
        if (suffix_start >= len(source)) {
            ret start
        }
        if (not is_suffix_start(byte_at(source, suffix_start))) {
            ret start
        }
        ret scan_identifier_end(source, suffix_start)
    }

    if (is_suffix_start(ch)) {
        ret scan_identifier_end(source, start)
    }

    ret start
}

fn is_float_suffix(source: str, number_end: usize, suffix_end: usize) -> bool {
    if (suffix_end <= number_end) {
        ret false
    }

    let suffix_start = if (byte_at(source, number_end) == 95) {
        number_end + 1
    } else {
        number_end
    }
    if (suffix_start >= suffix_end) {
        ret false
    }

    let first = byte_at(source, suffix_start)
    if (first == 102) {
        ret true
    }
    if (first == 70) {
        ret true
    }
    ret false
}

fn scan_identifier_end(source: str, index: usize) -> usize {
    if (index >= len(source)) {
        ret index
    }
    if (is_identifier_continue(byte_at(source, index))) {
        ret scan_identifier_end(source, index + 1)
    }
    ret index
}

fn is_digit(ch: u8) -> bool {
    if (ch >= 48) {
        if (ch <= 57) {
            ret true
        }
    }
    ret false
}

fn is_suffix_start(ch: u8) -> bool {
    if (ch >= 65) {
        if (ch <= 90) {
            ret true
        }
    }
    if (ch >= 97) {
        if (ch <= 122) {
            ret true
        }
    }
    ret false
}

fn is_identifier_start(ch: u8) -> bool {
    if (ch == 95) {
        ret true
    }
    if (ch >= 65) {
        if (ch <= 90) {
            ret true
        }
    }
    if (ch >= 97) {
        if (ch <= 122) {
            ret true
        }
    }
    ret false
}

fn is_identifier_continue(ch: u8) -> bool {
    if (is_identifier_start(ch)) {
        ret true
    }
    ret is_digit(ch)
}

fn next_is_fraction_digit(source: str, source_len: usize, int_end: usize) -> bool {
    if (int_end + 1 >= source_len) {
        ret false
    }
    ret is_digit(byte_at(source, int_end + 1))
}

fn keyword_type(value: str) -> TokenType {
    if str_eq(value, "fn") { ret TokenType::KW_FN }
    if str_eq(value, "struct") { ret TokenType::KW_STRUCT }
    if str_eq(value, "trait") { ret TokenType::KW_TRAIT }
    if str_eq(value, "enum") { ret TokenType::KW_ENUM }
    if str_eq(value, "impl") { ret TokenType::KW_IMPL }
    if str_eq(value, "for") { ret TokenType::KW_FOR }
    if str_eq(value, "let") { ret TokenType::KW_LET }
    if str_eq(value, "ret") { ret TokenType::KW_RET }
    if str_eq(value, "while") { ret TokenType::KW_WHILE }
    if str_eq(value, "loop") { ret TokenType::KW_LOOP }
    if str_eq(value, "do") { ret TokenType::KW_DO }
    if str_eq(value, "continue") { ret TokenType::KW_CONTINUE }
    if str_eq(value, "break") { ret TokenType::KW_BREAK }
    if str_eq(value, "if") { ret TokenType::KW_IF }
    if str_eq(value, "elif") { ret TokenType::KW_ELIF }
    if str_eq(value, "else") { ret TokenType::KW_ELSE }
    if str_eq(value, "match") { ret TokenType::KW_MATCH }
    if str_eq(value, "pub") { ret TokenType::KW_PUB }
    if str_eq(value, "import") { ret TokenType::KW_IMPORT }
    if str_eq(value, "extern") { ret TokenType::KW_EXTERN }
    if str_eq(value, "unsafe") { ret TokenType::KW_UNSAFE }
    if str_eq(value, "not") { ret TokenType::OP_NOT }
    ret TokenType::IDENTIFIER
}

fn is_eof(token_type: TokenType) -> bool {
    match token_type {
        EOF => {
            ret true
        }
        _ => {
            ret false
        }
    }
}
