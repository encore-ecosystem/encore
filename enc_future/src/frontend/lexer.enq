import std::vec::Vec
import std::vec::push_front
import std::vec::reverse
import std::io::print
import std::io::println
import std::string::len
import std::string::byte_at
import std::string::slice
import std::string::str_eq
import repo::frontend::token::TokenType
import repo::frontend::token::Token
import repo::frontend::token::make_token
import repo::frontend::token::is_unknown
import repo::frontend::token::token_type_name

pub struct LexerState {
    source: str
    index: usize
    line: usize
    column: usize
}

pub struct LexedToken {
    token: Token
    next: LexerState
}

pub fn tokenize(source: str) -> Vec[Token] {
    let start = LexerState{source, 0, 1, 1}
    ret reverse(tokenize_from(start, Vec[Token]::Empty))
}

pub fn print_tokens(source: str) -> u32 {
    let start = LexerState{source, 0, 1, 1}
    ret print_tokens_from(start)
}

fn print_tokens_from(state: LexerState) -> u32 {
    let next = skip_ignored(state)
    let source = next.source
    let index = next.index
    let line = next.line
    let column = next.column

    if (index >= len(source)) {
        print("EOF: ")
        println("")
        ret 0_u32
    }

    let lexed = lex_one(next)
    let token = lexed.token
    print(token_type_name(token.type))
    print(": ")
    println(token.value)
    ret print_tokens_from(lexed.next)
}

fn tokenize_from(state: LexerState, acc: Vec[Token]) -> Vec[Token] {
    let next = skip_ignored(state)
    let source = next.source
    let index = next.index
    let line = next.line
    let column = next.column

    if (index >= len(source)) {
        let eof = make_token(TokenType::EOF, "", line, column)
        ret push_front(acc, eof)
    }

    let lexed = lex_one(next)
    let token = lexed.token
    let next_state = lexed.next
    ret tokenize_from(next_state, push_front(acc, token))
}

fn skip_ignored(state: LexerState) -> LexerState {
    let source = state.source
    let index = state.index
    let line = state.line
    let column = state.column

    if (index >= len(source)) {
        ret state
    }

    let ch = byte_at(source, index)
    if (ch == 32) {
        ret skip_ignored(LexerState{source, index + 1, line, column + 1})
    }
    if (ch == 9) {
        ret skip_ignored(LexerState{source, index + 1, line, column + 1})
    }
    if (ch == 13) {
        ret skip_ignored(LexerState{source, index + 1, line, column + 1})
    }
    if (ch == 10) {
        ret skip_ignored(LexerState{source, index + 1, line + 1, 1})
    }

    ret state
}

fn lex_one(state: LexerState) -> LexedToken {
    let fixed = try_fixed_token(state)
    let fixed_token = fixed.token
    if (is_unknown(fixed_token.type)) {
        let source = state.source
        let index = state.index
        let line = state.line
        let column = state.column
        let ch = byte_at(source, index)

        if (ch == 34) {
            ret lex_string(state)
        }
        if (is_digit(ch)) {
            ret lex_number(state)
        }
        if (is_identifier_start(ch)) {
            ret lex_identifier(state)
        }

        let value = slice(source, index, 1)
        let token = make_token(TokenType::UNKNOWN, value, line, column)
        let next = LexerState{source, index + 1, line, column + 1}
        ret LexedToken{token, next}
    } else {
        ret fixed
    }
}

fn try_fixed_token(state: LexerState) -> LexedToken {
    let source = state.source
    let index = state.index

    if (starts_with_at(source, index, "<<=")) {
        ret make_fixed_token(state, 3, TokenType::OP_LSHIFT_ASSIGN)
    }
    if (starts_with_at(source, index, ">>=")) {
        ret make_fixed_token(state, 3, TokenType::OP_RSHIFT_ASSIGN)
    }

    if (starts_with_at(source, index, "::")) {
        ret make_fixed_token(state, 2, TokenType::OP_SCOPE)
    }
    if (starts_with_at(source, index, "=>")) {
        ret make_fixed_token(state, 2, TokenType::OP_FAT_ARROW)
    }
    if (starts_with_at(source, index, "==")) {
        ret make_fixed_token(state, 2, TokenType::OP_EQUAL)
    }
    if (starts_with_at(source, index, "!=")) {
        ret make_fixed_token(state, 2, TokenType::OP_NOT_EQUAL)
    }
    if (starts_with_at(source, index, "<=")) {
        ret make_fixed_token(state, 2, TokenType::OP_LESS_EQUAL)
    }
    if (starts_with_at(source, index, ">=")) {
        ret make_fixed_token(state, 2, TokenType::OP_GREATER_EQUAL)
    }
    if (starts_with_at(source, index, "->")) {
        ret make_fixed_token(state, 2, TokenType::OP_ARROW)
    }
    if (starts_with_at(source, index, "&&")) {
        ret make_fixed_token(state, 2, TokenType::OP_AND)
    }
    if (starts_with_at(source, index, "||")) {
        ret make_fixed_token(state, 2, TokenType::OP_OR)
    }
    if (starts_with_at(source, index, "<<")) {
        ret make_fixed_token(state, 2, TokenType::OP_LEFT_SHIFT)
    }
    if (starts_with_at(source, index, ">>")) {
        ret make_fixed_token(state, 2, TokenType::OP_RIGHT_SHIFT)
    }
    if (starts_with_at(source, index, "+=")) {
        ret make_fixed_token(state, 2, TokenType::OP_PLUS_ASSIGN)
    }
    if (starts_with_at(source, index, "-=")) {
        ret make_fixed_token(state, 2, TokenType::OP_MINUS_ASSIGN)
    }
    if (starts_with_at(source, index, "*=")) {
        ret make_fixed_token(state, 2, TokenType::OP_MULT_ASSIGN)
    }
    if (starts_with_at(source, index, "/=")) {
        ret make_fixed_token(state, 2, TokenType::OP_DIV_ASSIGN)
    }
    if (starts_with_at(source, index, "%=")) {
        ret make_fixed_token(state, 2, TokenType::OP_MOD_ASSIGN)
    }
    if (starts_with_at(source, index, "&=")) {
        ret make_fixed_token(state, 2, TokenType::OP_AND_ASSIGN)
    }
    if (starts_with_at(source, index, "|=")) {
        ret make_fixed_token(state, 2, TokenType::OP_OR_ASSIGN)
    }
    if (starts_with_at(source, index, "^=")) {
        ret make_fixed_token(state, 2, TokenType::OP_XOR_ASSIGN)
    }
    if (starts_with_at(source, index, "++")) {
        ret make_fixed_token(state, 2, TokenType::OP_INCREMENT)
    }
    if (starts_with_at(source, index, "--")) {
        ret make_fixed_token(state, 2, TokenType::OP_DECREMENT)
    }

    let ch = byte_at(source, index)
    if (ch == 43) { ret make_fixed_token(state, 1, TokenType::OP_PLUS) }
    if (ch == 45) { ret make_fixed_token(state, 1, TokenType::OP_MINUS) }
    if (ch == 42) { ret make_fixed_token(state, 1, TokenType::OP_MULTIPLY) }
    if (ch == 47) { ret make_fixed_token(state, 1, TokenType::OP_DIVIDE) }
    if (ch == 37) { ret make_fixed_token(state, 1, TokenType::OP_MODULO) }
    if (ch == 60) { ret make_fixed_token(state, 1, TokenType::OP_LESS) }
    if (ch == 62) { ret make_fixed_token(state, 1, TokenType::OP_GREATER) }
    if (ch == 33) { ret make_fixed_token(state, 1, TokenType::OP_NOT) }
    if (ch == 61) { ret make_fixed_token(state, 1, TokenType::OP_ASSIGN) }
    if (ch == 38) { ret make_fixed_token(state, 1, TokenType::OP_BIT_AND) }
    if (ch == 124) { ret make_fixed_token(state, 1, TokenType::OP_BIT_OR) }
    if (ch == 94) { ret make_fixed_token(state, 1, TokenType::OP_BIT_XOR) }
    if (ch == 126) { ret make_fixed_token(state, 1, TokenType::OP_BIT_NOT) }
    if (ch == 40) { ret make_fixed_token(state, 1, TokenType::LEFT_PAREN) }
    if (ch == 41) { ret make_fixed_token(state, 1, TokenType::RIGHT_PAREN) }
    if (ch == 123) { ret make_fixed_token(state, 1, TokenType::LEFT_BRACE) }
    if (ch == 125) { ret make_fixed_token(state, 1, TokenType::RIGHT_BRACE) }
    if (ch == 91) { ret make_fixed_token(state, 1, TokenType::LEFT_BRACKET) }
    if (ch == 93) { ret make_fixed_token(state, 1, TokenType::RIGHT_BRACKET) }
    if (ch == 58) { ret make_fixed_token(state, 1, TokenType::COLON) }
    if (ch == 44) { ret make_fixed_token(state, 1, TokenType::COMMA) }
    if (ch == 46) { ret make_fixed_token(state, 1, TokenType::DOT) }

    let token = make_token(TokenType::UNKNOWN, "", state.line, state.column)
    ret LexedToken{token, state}
}

fn make_fixed_token(state: LexerState, size: usize, type: TokenType) -> LexedToken {
    let source = state.source
    let index = state.index
    let line = state.line
    let column = state.column
    let value = slice(source, index, size)
    let token = make_token(type, value, line, column)
    let next = LexerState{source, index + size, line, column + size}
    ret LexedToken{token, next}
}

fn lex_string(state: LexerState) -> LexedToken {
    let source = state.source
    let index = state.index
    let line = state.line
    let column = state.column
    let end = scan_string_end(source, index + 1)
    let token_len = end - index
    let value = slice(source, index, token_len)
    let token = make_token(TokenType::STRING, value, line, column)
    let next = LexerState{source, end, line, column + token_len}
    ret LexedToken{token, next}
}

fn scan_string_end(source: str, index: usize) -> usize {
    if (index >= len(source)) {
        ret len(source)
    }

    let ch = byte_at(source, index)
    if (ch == 92) {
        if (index + 1 >= len(source)) {
            ret len(source)
        }
        ret scan_string_end(source, index + 2)
    }
    if (ch == 34) {
        ret index + 1
    }

    ret scan_string_end(source, index + 1)
}

fn lex_number(state: LexerState) -> LexedToken {
    let source = state.source
    let index = state.index
    let line = state.line
    let column = state.column
    let source_len = len(source)
    let int_end = scan_digits(source, index)

    if (int_end < source_len) {
        let sep = byte_at(source, int_end)
        let has_fraction = next_is_fraction_digit(source, source_len, int_end)
        if (sep == 46) {
            if (has_fraction) {
            let float_end = scan_digits(source, int_end + 1)
            let token_len = float_end - index
            let value = slice(source, index, token_len)
            let token = make_token(TokenType::FLOAT, value, line, column)
            let next = LexerState{source, float_end, line, column + token_len}
            ret LexedToken{token, next}
            }
        }
    }

    let token_len = int_end - index
    let value = slice(source, index, token_len)
    let token = make_token(TokenType::INTEGER, value, line, column)
    let next = LexerState{source, int_end, line, column + token_len}
    ret LexedToken{token, next}
}

fn scan_digits(source: str, index: usize) -> usize {
    if (index >= len(source)) {
        ret index
    }
    if (is_digit(byte_at(source, index))) {
        ret scan_digits(source, index + 1)
    }
    ret index
}

fn lex_identifier(state: LexerState) -> LexedToken {
    let source = state.source
    let index = state.index
    let line = state.line
    let column = state.column
    let end = scan_identifier_end(source, index)
    let token_len = end - index
    let value = slice(source, index, token_len)
    let token = make_token(keyword_type(value), value, line, column)
    let next = LexerState{source, end, line, column + token_len}
    ret LexedToken{token, next}
}

fn scan_identifier_end(source: str, index: usize) -> usize {
    if (index >= len(source)) {
        ret index
    }
    if (is_identifier_continue(byte_at(source, index))) {
        ret scan_identifier_end(source, index + 1)
    }
    ret index
}

fn starts_with_at(source: str, index: usize, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (index + prefix_len > len(source)) {
        ret false
    }
    ret str_eq(slice(source, index, prefix_len), prefix)
}

fn is_digit(ch: u8) -> bool {
    if (ch >= 48) {
        if (ch <= 57) {
            ret true
        }
    }
    ret false
}

fn is_identifier_start(ch: u8) -> bool {
    if (ch == 95) {
        ret true
    }
    if (ch >= 65) {
        if (ch <= 90) {
            ret true
        }
    }
    if (ch >= 97) {
        if (ch <= 122) {
            ret true
        }
    }
    ret false
}

fn is_identifier_continue(ch: u8) -> bool {
    if (is_identifier_start(ch)) {
        ret true
    }
    ret is_digit(ch)
}

fn next_is_fraction_digit(source: str, source_len: usize, int_end: usize) -> bool {
    if (int_end + 1 >= source_len) {
        ret false
    }
    ret is_digit(byte_at(source, int_end + 1))
}

fn keyword_type(value: str) -> TokenType {
    if str_eq(value, "fn") { ret TokenType::KW_FN }
    if str_eq(value, "struct") { ret TokenType::KW_STRUCT }
    if str_eq(value, "trait") { ret TokenType::KW_TRAIT }
    if str_eq(value, "enum") { ret TokenType::KW_ENUM }
    if str_eq(value, "impl") { ret TokenType::KW_IMPL }
    if str_eq(value, "for") { ret TokenType::KW_FOR }
    if str_eq(value, "let") { ret TokenType::KW_LET }
    if str_eq(value, "ret") { ret TokenType::KW_RET }
    if str_eq(value, "while") { ret TokenType::KW_WHILE }
    if str_eq(value, "loop") { ret TokenType::KW_LOOP }
    if str_eq(value, "do") { ret TokenType::KW_DO }
    if str_eq(value, "continue") { ret TokenType::KW_CONTINUE }
    if str_eq(value, "break") { ret TokenType::KW_BREAK }
    if str_eq(value, "if") { ret TokenType::KW_IF }
    if str_eq(value, "elif") { ret TokenType::KW_ELIF }
    if str_eq(value, "else") { ret TokenType::KW_ELSE }
    if str_eq(value, "match") { ret TokenType::KW_MATCH }
    if str_eq(value, "pub") { ret TokenType::KW_PUB }
    if str_eq(value, "import") { ret TokenType::KW_IMPORT }
    if str_eq(value, "extern") { ret TokenType::KW_EXTERN }
    if str_eq(value, "unsafe") { ret TokenType::KW_UNSAFE }
    ret TokenType::IDENTIFIER
}
