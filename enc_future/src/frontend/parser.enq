import std::string::concat
import std::string::len
import std::string::str_eq
import std::option::Option
import std::vec::Vec
import repo::frontend::lexer::Lexer
import repo::frontend::token::Token
import repo::frontend::token::TokenType
import repo::frontend::token::token_type_name

pub struct ParseError {
    message: str
    line: usize
    column: usize
}

pub enum ParsedDirectiveKind {
    Import
    CImport
    Struct
    Enum
    Trait
    Impl
    Function
    ExternFunction
    UnsafeFunction
    Unknown
}

pub struct ParsedDirective {
    kind: ParsedDirectiveKind
    is_public: bool
    name: str
    line: usize
    column: usize
}

pub struct ParsedModule {
    directives: usize
    imports: usize
    structs: usize
    enums: usize
    traits: usize
    impls: usize
    functions: usize
    extern_functions: usize
    unsafe_functions: usize
    import_bindings_outline: str
    public_import_bindings_outline: str
    cimport_bindings_outline: str
    directives_meta_outline: str
    directives_meta: Vec[ParsedDirective]
    outline: str
}

pub enum ParseOutcome {
    Success(ParsedModule)
    Failure(ParseError)
}

struct Cursor {
    lexer: Lexer
    current: Token
}

enum ParseStep {
    Continue(Cursor)
    Fail(ParseError)
}

pub fn parse(source: str) -> ParseOutcome {
    let start = init_cursor(source)
    ret parse_module(start, empty_parsed_module())
}

pub fn parsed_meta_count(module: ParsedModule) -> usize {
    ret parsed_meta_count_vec(module.directives_meta)
}

pub fn parsed_meta_outline(module: ParsedModule) -> str {
    ret parsed_meta_outline_vec(module.directives_meta)
}

fn parsed_meta_count_vec(meta: Vec[ParsedDirective]) -> usize {
    ret parsed_meta_count_from(meta, 0_usize)
}

fn parsed_meta_outline_vec(meta: Vec[ParsedDirective]) -> str {
    ret parsed_meta_outline_from(meta, 0_usize, "")
}

fn parsed_meta_count_from(meta: Vec[ParsedDirective], index: usize) -> usize {
    match meta.get(index) {
        Some(directive) => {
            ret 1_usize + parsed_meta_count_from(meta, index + 1_usize)
        }
        None => {
            ret 0_usize
        }
    }
    ret 0_usize
}

fn parsed_meta_outline_from(meta: Vec[ParsedDirective], index: usize, acc: str) -> str {
    match meta.get(index) {
        Some(directive) => {
            ret parsed_meta_outline_from(meta, index + 1_usize, append_lines(acc, parsed_meta_line(directive)))
        }
        None => {
            ret acc
        }
    }
    ret acc
}

fn parsed_meta_line(directive: ParsedDirective) -> str {
    let visibility = if (directive.is_public) { "pub" } else { "priv" }
    let kind = directive_kind_line_label(directive.kind)
    let position = concat(concat(usize_to_str(directive.line), ":"), usize_to_str(directive.column))
    ret concat(concat(concat(concat(concat(concat(kind, " "), visibility), " "), directive.name), " @"), position)
}

fn parse_module(cursor: Cursor, module: ParsedModule) -> ParseOutcome {
    if (is_cursor_eof(cursor)) {
        ret ParseOutcome::Success(finalize_parsed_module(module))
    }

    let counted = count_directive(module, cursor)
    let step = parse_directive(cursor)
    match step {
        Continue(next) => {
            if (is_cursor_eof(next)) {
                ret ParseOutcome::Success(finalize_parsed_module(counted))
            }
            ret parse_module(next, counted)
        }
        Fail(error) => {
            ret ParseOutcome::Failure(error)
        }
    }
}

fn init_cursor(source: str) -> Cursor {
    let lexer = Lexer::from_source(source)
    let lexed = Lexer::next_token(lexer)
    ret Cursor{lexed.next, lexed.token}
}

fn advance(cursor: Cursor) -> Cursor {
    let lexed = Lexer::next_token(cursor.lexer)
    ret Cursor{lexed.next, lexed.token}
}

fn parse_directive(cursor: Cursor) -> ParseStep {
    let no_pub = consume_optional_pub(cursor)
    if (is_cimp_keyword(no_pub)) {
        ret parse_import(no_pub)
    }
    match no_pub.current.type {
        KW_IMPORT => {
            ret parse_import(no_pub)
        }
        KW_STRUCT => {
            ret parse_struct(no_pub)
        }
        KW_ENUM => {
            ret parse_enum(no_pub)
        }
        KW_TRAIT => {
            ret parse_trait(no_pub)
        }
        KW_IMPL => {
            ret parse_impl(no_pub)
        }
        KW_EXTERN => {
            ret parse_extern_fn(no_pub)
        }
        KW_UNSAFE => {
            ret parse_unsafe_fn(no_pub)
        }
        KW_FN => {
            ret parse_fn(no_pub)
        }
        EOF => {
            ret ParseStep::Continue(no_pub)
        }
        _ => {
            ret fail(no_pub, "Unexpected top-level directive")
        }
    }
}

fn consume_optional_pub(cursor: Cursor) -> Cursor {
    match cursor.current.type {
        KW_PUB => {
            ret advance(cursor)
        }
        _ => {
            ret cursor
        }
    }
}

fn directive_is_public(cursor: Cursor) -> bool {
    match cursor.current.type {
        KW_PUB => {
            ret true
        }
        _ => {
            ret false
        }
    }
}

fn parse_import(cursor: Cursor) -> ParseStep {
    let after_kw = advance(cursor)
    ret parse_import_path(after_kw)
}

fn parse_import_path(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        IDENTIFIER => {
            let after_segment = advance(cursor)
            ret parse_import_tail(after_segment, true)
        }
        OP_MULTIPLY => {
            let after_glob = advance(cursor)
            ret parse_import_tail(after_glob, false)
        }
        _ => {
            ret fail(cursor, "Expected import segment")
        }
    }
}

fn parse_import_tail(cursor: Cursor, allow_scope: bool) -> ParseStep {
    match cursor.current.type {
        OP_SCOPE => {
            if (not allow_scope) {
                ret fail(cursor, "Wildcard '*' must be terminal in import path")
            }
            let after_scope = advance(cursor)
            ret parse_import_after_scope(after_scope)
        }
        COMMA => {
            ret ParseStep::Continue(cursor)
        }
        RIGHT_BRACE => {
            ret ParseStep::Continue(cursor)
        }
        _ => {
            if (is_top_level_start(cursor.current.type)) {
                ret ParseStep::Continue(cursor)
            }
            if (is_cimp_keyword(cursor)) {
                ret ParseStep::Continue(cursor)
            }
            ret fail(cursor, "Unexpected token in import path")
        }
    }
}

fn parse_import_after_scope(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        LEFT_BRACE => {
            let after_lbrace = advance(cursor)
            ret parse_import_group(after_lbrace)
        }
        IDENTIFIER => {
            let after_segment = advance(cursor)
            ret parse_import_tail(after_segment, true)
        }
        OP_MULTIPLY => {
            let after_glob = advance(cursor)
            ret parse_import_tail(after_glob, false)
        }
        _ => {
            ret fail(cursor, "Expected import segment after '::'")
        }
    }
}

fn parse_import_group(cursor: Cursor) -> ParseStep {
    let first = parse_import_path(cursor)
    match first {
        Continue(next) => {
            ret parse_import_group_tail(next)
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_import_group_tail(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            match after_comma.current.type {
                RIGHT_BRACE => {
                    let after_rbrace = advance(after_comma)
                    ret parse_import_tail(after_rbrace, true)
                }
                _ => {
                    ret parse_import_group(after_comma)
                }
            }
        }
        RIGHT_BRACE => {
            let after_rbrace = advance(cursor)
            ret parse_import_tail(after_rbrace, true)
        }
        _ => {
            ret fail(cursor, "Expected ',' or '}' in import group")
        }
    }
}

fn parse_named_block_directive(cursor: Cursor) -> ParseStep {
    let after_kw = advance(cursor)
    match after_kw.current.type {
        IDENTIFIER => {
            let after_name = advance(after_kw)
            let with_generics = parse_optional_generics(after_name)
            match with_generics {
                Continue(next) => {
                    match next.current.type {
                        LEFT_BRACE => {
                            let after_lbrace = advance(next)
                            ret consume_block_body(after_lbrace, 1_usize)
                        }
                        _ => {
                            ret fail(next, "Expected '{' in declaration body")
                        }
                    }
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            ret fail(after_kw, "Expected declaration name")
        }
    }
}

fn parse_struct(cursor: Cursor) -> ParseStep {
    let after_kw = advance(cursor)
    match after_kw.current.type {
        IDENTIFIER => {
            let after_name = advance(after_kw)
            let with_generics = parse_optional_generics(after_name)
            match with_generics {
                Continue(next) => {
                    match next.current.type {
                        LEFT_BRACE => {
                            let after_lbrace = advance(next)
                            ret parse_struct_fields(after_lbrace)
                        }
                        LEFT_PAREN => {
                            let after_lparen = advance(next)
                            ret parse_struct_tuple_fields(after_lparen)
                        }
                        _ => {
                            if (is_cimp_keyword(next)) {
                                ret ParseStep::Continue(next)
                            }
                            match next.current.type {
                                KW_IMPORT => { ret ParseStep::Continue(next) }
                                KW_STRUCT => { ret ParseStep::Continue(next) }
                                KW_ENUM => { ret ParseStep::Continue(next) }
                                KW_TRAIT => { ret ParseStep::Continue(next) }
                                KW_IMPL => { ret ParseStep::Continue(next) }
                                KW_EXTERN => { ret ParseStep::Continue(next) }
                                KW_UNSAFE => { ret ParseStep::Continue(next) }
                                KW_FN => { ret ParseStep::Continue(next) }
                                KW_PUB => { ret ParseStep::Continue(next) }
                                EOF => { ret ParseStep::Continue(next) }
                                _ => {}
                            }
                            ret fail(next, "Expected '{' or '(' in struct body")
                        }
                    }
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            ret fail(after_kw, "Expected struct name")
        }
    }
}

fn parse_struct_tuple_fields(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        RIGHT_PAREN => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            let with_type = consume_type_until_struct_tuple_boundary(cursor, 0_usize, 0_usize, 0_usize, false)
            match with_type {
                Continue(next) => {
                    ret parse_struct_tuple_fields_tail(next)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
    }
}

fn parse_struct_tuple_fields_tail(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            match after_comma.current.type {
                RIGHT_PAREN => {
                    ret ParseStep::Continue(advance(after_comma))
                }
                _ => {
                    ret parse_struct_tuple_fields(after_comma)
                }
            }
        }
        RIGHT_PAREN => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            ret fail(cursor, "Expected ',' or ')' in tuple struct fields")
        }
    }
}

fn consume_type_until_struct_tuple_boundary(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected tuple struct field type")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                match tt {
                    COMMA => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected tuple struct field type")
                    }
                    RIGHT_PAREN => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected tuple struct field type")
                    }
                    _ => {}
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in tuple struct field type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in tuple struct field type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in tuple struct field type")
    }

    ret consume_type_until_struct_tuple_boundary(advance(cursor), next_square, next_angle, next_paren, true)
}

fn parse_struct_fields(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        IDENTIFIER => {
            let after_name = advance(cursor)
            match after_name.current.type {
                COLON => {}
                _ => {
                    ret fail(after_name, "Expected ':' after struct field name")
                }
            }

            let after_colon = advance(after_name)
            let with_type = consume_type_until_struct_field_boundary(after_colon, 0_usize, 0_usize, 0_usize, false)
            match with_type {
                Continue(next) => {
                    ret parse_struct_fields_tail(next)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            ret fail(cursor, "Expected struct field name or '}'")
        }
    }
}

fn parse_struct_fields_tail(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            ret parse_struct_fields(after_comma)
        }
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        IDENTIFIER => {
            ret parse_struct_fields(cursor)
        }
        _ => {
            ret fail(cursor, "Expected next struct field or '}'")
        }
    }
}

fn consume_type_until_struct_field_boundary(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected struct field type")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                match tt {
                    RIGHT_BRACE => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected struct field type")
                    }
                    COMMA => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected struct field type")
                    }
                    IDENTIFIER => {
                        if (consumed) {
                            let maybe_colon = advance(cursor)
                            match maybe_colon.current.type {
                                COLON => {
                                    ret ParseStep::Continue(cursor)
                                }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in struct field type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in struct field type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in struct field type")
    }

    ret consume_type_until_struct_field_boundary(advance(cursor), next_square, next_angle, next_paren, true)
}

fn parse_enum(cursor: Cursor) -> ParseStep {
    let after_kw = advance(cursor)
    match after_kw.current.type {
        IDENTIFIER => {
            let after_name = advance(after_kw)
            let with_generics = parse_optional_generics(after_name)
            match with_generics {
                Continue(next) => {
                    match next.current.type {
                        LEFT_BRACE => {
                            let after_lbrace = advance(next)
                            ret parse_enum_variants(after_lbrace)
                        }
                        _ => {
                            ret fail(next, "Expected '{' in enum body")
                        }
                    }
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            ret fail(after_kw, "Expected enum name")
        }
    }
}

fn parse_enum_variants(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        IDENTIFIER => {
            ret parse_enum_variant(cursor)
        }
        _ => {
            ret fail(cursor, "Expected enum variant name or '}'")
        }
    }
}

fn parse_enum_variant(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        IDENTIFIER => {}
        _ => {
            ret fail(cursor, "Expected enum variant name")
        }
    }

    let after_name = advance(cursor)
    let with_payload = parse_optional_enum_variant_payload(after_name)
    match with_payload {
        Continue(next) => {
            ret parse_enum_variants_tail(next)
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_optional_enum_variant_payload(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        LEFT_PAREN => {
            let after_lparen = advance(cursor)
            ret parse_enum_variant_payload_types(after_lparen)
        }
        LEFT_BRACE => {
            let after_lbrace = advance(cursor)
            ret parse_struct_fields(after_lbrace)
        }
        _ => {
            ret ParseStep::Continue(cursor)
        }
    }
}

fn parse_enum_variant_payload_types(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        RIGHT_PAREN => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            let with_type = consume_type_until_enum_variant_payload_boundary(cursor, 0_usize, 0_usize, 0_usize, false)
            match with_type {
                Continue(next) => {
                    ret parse_enum_variant_payload_tail(next)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
    }
}

fn parse_enum_variant_payload_tail(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            match after_comma.current.type {
                RIGHT_PAREN => {
                    ret ParseStep::Continue(advance(after_comma))
                }
                _ => {
                    ret parse_enum_variant_payload_types(after_comma)
                }
            }
        }
        RIGHT_PAREN => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            ret fail(cursor, "Expected ',' or ')' in enum payload")
        }
    }
}

fn consume_type_until_enum_variant_payload_boundary(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected enum payload type")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                match tt {
                    COMMA => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected enum payload type")
                    }
                    RIGHT_PAREN => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected enum payload type")
                    }
                    _ => {}
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in enum payload type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in enum payload type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in enum payload type")
    }

    ret consume_type_until_enum_variant_payload_boundary(advance(cursor), next_square, next_angle, next_paren, true)
}

fn parse_enum_variants_tail(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            ret parse_enum_variants(after_comma)
        }
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        IDENTIFIER => {
            ret parse_enum_variants(cursor)
        }
        _ => {
            ret fail(cursor, "Expected next enum variant or '}'")
        }
    }
}

fn parse_trait(cursor: Cursor) -> ParseStep {
    let after_kw = advance(cursor)
    match after_kw.current.type {
        IDENTIFIER => {
            let after_name = advance(after_kw)
            let with_generics = parse_optional_generics(after_name)
            match with_generics {
                Continue(next) => {
                    match next.current.type {
                        LEFT_BRACE => {
                            let after_lbrace = advance(next)
                            ret parse_trait_methods(after_lbrace)
                        }
                        _ => {
                            ret fail(next, "Expected '{' in trait body")
                        }
                    }
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            ret fail(after_kw, "Expected trait name")
        }
    }
}

fn parse_trait_methods(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            let with_pub = consume_optional_pub(cursor)
            match with_pub.current.type {
                KW_FN => {
                    let after_fn = advance(with_pub)
                    let method = parse_fn_signature(after_fn, false, true, true, true)
                    match method {
                        Continue(next) => {
                            ret parse_trait_methods(next)
                        }
                        Fail(error) => {
                            ret ParseStep::Fail(error)
                        }
                    }
                }
                _ => {
                    ret fail(with_pub, "Expected trait method declaration")
                }
            }
        }
    }
}

fn parse_impl(cursor: Cursor) -> ParseStep {
    let after_kw = advance(cursor)
    let with_header = parse_impl_header(after_kw)
    match with_header {
        Continue(next) => {
            ret parse_impl_body(next)
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_impl_header(cursor: Cursor) -> ParseStep {
    let with_generics = parse_optional_generics(cursor)
    match with_generics {
        Continue(next0) => {
            let before_for = match next0.current.type {
                KW_FOR => ParseStep::Continue(next0)
                _ => consume_impl_trait_until_for(next0, 0_usize, 0_usize, 0_usize, false)
            }

            match before_for {
                Continue(next1) => {
                    if (not is_kw_for(next1.current.type)) {
                        ret fail(next1, "Expected 'for' in impl header")
                    }
                    let after_for = advance(next1)
                    ret consume_type_until_impl_body(after_for, 0_usize, 0_usize, 0_usize, false)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn consume_impl_trait_until_for(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected 'for' in impl header")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (is_kw_for(tt)) {
                    if (consumed) {
                        ret ParseStep::Continue(cursor)
                    }
                    ret fail(cursor, "Expected trait name or 'for'")
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in impl trait")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in impl trait")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in impl trait")
    }

    ret consume_impl_trait_until_for(advance(cursor), next_square, next_angle, next_paren, true)
}

fn consume_type_until_impl_body(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        if (consumed) {
            ret ParseStep::Continue(cursor)
        }
        ret fail(cursor, "Expected type after 'for' in impl header")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                match tt {
                    LEFT_BRACE => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected type after 'for' in impl header")
                    }
                    _ => {
                        if (is_top_level_start(tt)) {
                            if (consumed) {
                                ret ParseStep::Continue(cursor)
                            }
                            ret fail(cursor, "Expected type after 'for' in impl header")
                        }
                        if (is_cimp_keyword(cursor)) {
                            if (consumed) {
                                ret ParseStep::Continue(cursor)
                            }
                            ret fail(cursor, "Expected type after 'for' in impl header")
                        }
                    }
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in impl type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in impl type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in impl type")
    }

    ret consume_type_until_impl_body(advance(cursor), next_square, next_angle, next_paren, true)
}

fn parse_impl_body(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        LEFT_BRACE => {
            let after_lbrace = advance(cursor)
            ret parse_impl_methods(after_lbrace)
        }
        _ => {
            ret fail(cursor, "Expected '{' in impl body")
        }
    }
}

fn parse_impl_methods(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            let with_pub = consume_optional_pub(cursor)
            match with_pub.current.type {
                KW_FN => {
                    let after_fn = advance(with_pub)
                    let method = parse_fn_signature(after_fn, true, false, false, true)
                    match method {
                        Continue(next) => {
                            ret parse_impl_methods(next)
                        }
                        Fail(error) => {
                            ret ParseStep::Fail(error)
                        }
                    }
                }
                _ => {
                    ret fail(with_pub, "Expected impl method definition")
                }
            }
        }
    }
}

fn parse_extern_fn(cursor: Cursor) -> ParseStep {
    let after_extern = advance(cursor)
    let after_unsafe = match after_extern.current.type {
        KW_UNSAFE => advance(after_extern)
        _ => after_extern
    }

    match after_unsafe.current.type {
        KW_FN => {
            let after_fn = advance(after_unsafe)
            ret parse_fn_signature(after_fn, false, true, false, false)
        }
        _ => {
            ret fail(after_unsafe, "Expected 'fn' after 'extern'")
        }
    }
}

fn parse_unsafe_fn(cursor: Cursor) -> ParseStep {
    let after_unsafe = advance(cursor)
    match after_unsafe.current.type {
        KW_FN => {
            ret parse_fn(after_unsafe)
        }
        _ => {
            ret fail(after_unsafe, "Expected 'fn' after 'unsafe'")
        }
    }
}

fn parse_fn(cursor: Cursor) -> ParseStep {
    let after_fn = advance(cursor)
    ret parse_fn_signature(after_fn, true, false, false, false)
}

fn parse_fn_signature(
    cursor: Cursor, has_body: bool, require_return: bool, allow_member_boundary: bool, allow_self_param: bool
) -> ParseStep {
    match cursor.current.type {
        IDENTIFIER => {}
        _ => {
            ret fail(cursor, "Expected function name")
        }
    }

    let after_name = advance(cursor)
    let with_generics = parse_optional_generics(after_name)
    match with_generics {
        Continue(next0) => {
            match next0.current.type {
                LEFT_PAREN => {}
                _ => {
                    ret fail(next0, "Expected '(' after function name")
                }
            }

            let after_lparen = advance(next0)
            let with_params = parse_fn_params(after_lparen, allow_self_param)
            match with_params {
                Continue(next1) => {
                    ret parse_fn_tail(next1, has_body, require_return, allow_member_boundary)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_fn_params(cursor: Cursor, allow_self_param: bool) -> ParseStep {
    match cursor.current.type {
        RIGHT_PAREN => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            ret parse_fn_param(cursor, allow_self_param)
        }
    }
}

fn parse_fn_param(cursor: Cursor, allow_self_param: bool) -> ParseStep {
    match cursor.current.type {
        IDENTIFIER => {}
        _ => {
            ret fail(cursor, "Expected function parameter name")
        }
    }

    let after_name = advance(cursor)
    if (allow_self_param) {
        if (is_self_identifier(cursor)) {
            match after_name.current.type {
                COMMA => {
                    ret parse_fn_params_tail(after_name, allow_self_param)
                }
                RIGHT_PAREN => {
                    ret parse_fn_params_tail(after_name, allow_self_param)
                }
                _ => {}
            }
        }
    }
    match after_name.current.type {
        COLON => {}
        _ => {
            ret fail(after_name, "Expected ':' after function parameter name")
        }
    }

    let after_colon = advance(after_name)
    let with_type = consume_type_until_fn_param_boundary(after_colon, 0_usize, 0_usize, 0_usize, false)
    match with_type {
        Continue(next) => {
            ret parse_fn_params_tail(next, allow_self_param)
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_fn_params_tail(cursor: Cursor, allow_self_param: bool) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            match after_comma.current.type {
                RIGHT_PAREN => {
                    ret ParseStep::Continue(advance(after_comma))
                }
                _ => {
                    ret parse_fn_param(after_comma, allow_self_param)
                }
            }
        }
        RIGHT_PAREN => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            ret fail(cursor, "Expected ',' or ')' in parameter list")
        }
    }
}

fn consume_type_until_fn_param_boundary(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected function parameter type")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                match tt {
                    COMMA => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected function parameter type")
                    }
                    RIGHT_PAREN => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected function parameter type")
                    }
                    _ => {}
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in function parameter type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in function parameter type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in function parameter type")
    }

    ret consume_type_until_fn_param_boundary(advance(cursor), next_square, next_angle, next_paren, true)
}

fn parse_fn_tail(cursor: Cursor, has_body: bool, require_return: bool, allow_member_boundary: bool) -> ParseStep {
    match cursor.current.type {
        OP_ARROW => {
            let after_arrow = advance(cursor)
            let with_type = if (has_body) {
                consume_type_until_body(after_arrow, 0_usize, 0_usize, 0_usize, false)
            } else {
                consume_type_until_signature_boundary(after_arrow, 0_usize, 0_usize, 0_usize, false, allow_member_boundary)
            }
            match with_type {
                Continue(next) => {
                    ret finish_fn_tail(next, has_body, allow_member_boundary)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            if (require_return) {
                ret fail(cursor, "Expected return type after '->'")
            }
            ret finish_fn_tail(cursor, has_body, allow_member_boundary)
        }
    }
}

fn finish_fn_tail(cursor: Cursor, has_body: bool, allow_member_boundary: bool) -> ParseStep {
    if (has_body) {
        match cursor.current.type {
            LEFT_BRACE => {
                let after_lbrace = advance(cursor)
                ret parse_statement_block(after_lbrace, 0_usize)
            }
            _ => {
                ret fail(cursor, "Expected function body '{'")
            }
        }
    }

    match cursor.current.type {
        LEFT_BRACE => {
            ret fail(cursor, "Extern function must not have body")
        }
        _ => {
            if (is_top_level_start(cursor.current.type)) {
                ret ParseStep::Continue(cursor)
            }
            if (is_cimp_keyword(cursor)) {
                ret ParseStep::Continue(cursor)
            }
            if (allow_member_boundary) {
                if (is_trait_member_start(cursor.current.type)) {
                    ret ParseStep::Continue(cursor)
                }
            }
            ret fail(cursor, "Unexpected token after extern signature")
        }
    }
}

fn parse_statement_block(cursor: Cursor, loop_depth: usize) -> ParseStep {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            let parsed = parse_inner_statement(cursor, loop_depth)
            match parsed {
                Continue(next) => {
                    ret parse_statement_block(next, loop_depth)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
    }
}

fn parse_inner_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    match cursor.current.type {
        KW_LET => {
            ret parse_let_statement(cursor)
        }
        KW_RET => {
            ret parse_ret_statement(cursor)
        }
        KW_IF => {
            ret parse_if_statement(cursor, loop_depth)
        }
        KW_WHILE => {
            ret parse_while_statement(cursor, loop_depth)
        }
        KW_FOR => {
            ret parse_for_statement(cursor, loop_depth)
        }
        KW_LOOP => {
            ret parse_loop_statement(cursor, loop_depth)
        }
        KW_DO => {
            ret parse_do_while_statement(cursor, loop_depth)
        }
        KW_MATCH => {
            ret parse_match_statement(cursor, loop_depth)
        }
        KW_UNSAFE => {
            ret parse_unsafe_statement(cursor, loop_depth)
        }
        KW_BREAK => {
            if (loop_depth == 0_usize) {
                ret fail(cursor, "'break' is only allowed inside loop bodies")
            }
            ret ParseStep::Continue(advance(cursor))
        }
        KW_CONTINUE => {
            if (loop_depth == 0_usize) {
                ret fail(cursor, "'continue' is only allowed inside loop bodies")
            }
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            ret parse_expression_or_assignment_statement(cursor)
        }
    }
}

fn parse_let_statement(cursor: Cursor) -> ParseStep {
    let after_let = advance(cursor)
    match after_let.current.type {
        IDENTIFIER => {}
        _ => {
            ret fail(after_let, "Expected variable name after 'let'")
        }
    }

    let after_name = advance(after_let)
    match after_name.current.type {
        COLON => {
            let after_colon = advance(after_name)
            let with_type = consume_type_until_assignment(after_colon, 0_usize, 0_usize, 0_usize, false)
            match with_type {
                Continue(next0) => {
                    ret parse_let_assignment_value(next0)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        _ => {
            ret parse_let_assignment_value(after_name)
        }
    }
}

fn parse_let_assignment_value(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        OP_ASSIGN => {
            let after_assign = advance(cursor)
            ret consume_expression_until_statement_boundary(
                after_assign, 0_usize, 0_usize, 0_usize, 0_usize, false, false
            )
        }
        _ => {
            ret fail(cursor, "Expected '=' in let statement")
        }
    }
}

fn parse_ret_statement(cursor: Cursor) -> ParseStep {
    let after_ret = advance(cursor)
    ret consume_expression_until_statement_boundary(after_ret, 0_usize, 0_usize, 0_usize, 0_usize, false, false)
}

fn parse_if_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_if = advance(cursor)
    let condition = consume_expression_until_left_brace(after_if, 0_usize, 0_usize, 0_usize, false)
    match condition {
        Continue(next0) => {
            match next0.current.type {
                LEFT_BRACE => {
                    let after_lbrace = advance(next0)
                    let branch = parse_statement_block(after_lbrace, loop_depth)
                    match branch {
                        Continue(next1) => {
                            ret parse_if_suffix(next1, loop_depth)
                        }
                        Fail(error) => {
                            ret ParseStep::Fail(error)
                        }
                    }
                }
                _ => {
                    ret fail(next0, "Expected '{' after if condition")
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_if_suffix(cursor: Cursor, loop_depth: usize) -> ParseStep {
    match cursor.current.type {
        KW_ELIF => {
            let after_elif = advance(cursor)
            let condition = consume_expression_until_left_brace(after_elif, 0_usize, 0_usize, 0_usize, false)
            match condition {
                Continue(next0) => {
                    match next0.current.type {
                        LEFT_BRACE => {
                            let after_lbrace = advance(next0)
                            let branch = parse_statement_block(after_lbrace, loop_depth)
                            match branch {
                                Continue(next1) => {
                                    ret parse_if_suffix(next1, loop_depth)
                                }
                                Fail(error) => {
                                    ret ParseStep::Fail(error)
                                }
                            }
                        }
                        _ => {
                            ret fail(next0, "Expected '{' after elif condition")
                        }
                    }
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
        KW_ELSE => {
            let after_else = advance(cursor)
            match after_else.current.type {
                LEFT_BRACE => {
                    ret parse_statement_block(advance(after_else), loop_depth)
                }
                _ => {
                    ret fail(after_else, "Expected '{' after else")
                }
            }
        }
        _ => {
            ret ParseStep::Continue(cursor)
        }
    }
}

fn parse_while_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_while = advance(cursor)
    let condition = consume_expression_until_left_brace(after_while, 0_usize, 0_usize, 0_usize, false)
    match condition {
        Continue(next0) => {
            match next0.current.type {
                LEFT_BRACE => {
                    ret parse_statement_block(advance(next0), loop_depth + 1_usize)
                }
                _ => {
                    ret fail(next0, "Expected '{' after while condition")
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_for_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_for = advance(cursor)
    match after_for.current.type {
        IDENTIFIER => {}
        _ => {
            ret fail(after_for, "Expected loop binding after 'for'")
        }
    }

    let after_binding = advance(after_for)
    match after_binding.current.type {
        IDENTIFIER => {
            if (not str_eq(after_binding.current.value, "in")) {
                ret fail(after_binding, "Expected 'in' in for statement")
            }
        }
        _ => {
            ret fail(after_binding, "Expected 'in' in for statement")
        }
    }

    let after_in = advance(after_binding)
    let iterable = consume_expression_until_left_brace(after_in, 0_usize, 0_usize, 0_usize, false)
    match iterable {
        Continue(next0) => {
            match next0.current.type {
                LEFT_BRACE => {
                    ret parse_statement_block(advance(next0), loop_depth + 1_usize)
                }
                _ => {
                    ret fail(next0, "Expected '{' after for iterable expression")
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_loop_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_loop = advance(cursor)
    match after_loop.current.type {
        LEFT_BRACE => {
            ret parse_statement_block(advance(after_loop), loop_depth + 1_usize)
        }
        _ => {
            ret fail(after_loop, "Expected '{' after loop")
        }
    }
}

fn parse_do_while_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_do = advance(cursor)
    match after_do.current.type {
        LEFT_BRACE => {}
        _ => {
            ret fail(after_do, "Expected '{' after do")
        }
    }

    let body = parse_statement_block(advance(after_do), loop_depth + 1_usize)
    match body {
        Continue(next0) => {
            match next0.current.type {
                KW_WHILE => {
                    let after_while = advance(next0)
                    ret consume_expression_until_statement_boundary_relaxed(
                        after_while, 0_usize, 0_usize, 0_usize, 0_usize, false, false
                    )
                }
                _ => {
                    ret fail(next0, "Expected 'while' after do-block")
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn consume_expression_until_statement_boundary_relaxed(
    cursor: Cursor,
    square_depth: usize,
    angle_depth: usize,
    paren_depth: usize,
    brace_depth: usize,
    consumed: bool,
    prev_can_end: bool
) -> ParseStep {
    if (not consumed) {
        if (is_statement_boundary_token(cursor.current.type)) {
            if (should_stop_at_statement_boundary(cursor.current.type, prev_can_end)) {
                ret ParseStep::Continue(cursor)
            }
        }
    }
    ret consume_expression_until_statement_boundary(
        cursor, square_depth, angle_depth, paren_depth, brace_depth, consumed, prev_can_end
    )
}

fn consume_expression_until_match_arm_boundary(
    cursor: Cursor,
    square_depth: usize,
    angle_depth: usize,
    paren_depth: usize,
    brace_depth: usize,
    consumed: bool,
    prev_can_end: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        if (consumed) {
            ret ParseStep::Continue(cursor)
        }
        ret fail(cursor, "Expected expression in match arm")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (brace_depth == 0_usize) {
                    if (consumed) {
                        match tt {
                            COMMA => {
                                ret ParseStep::Continue(cursor)
                            }
                            RIGHT_BRACE => {
                                ret ParseStep::Continue(cursor)
                            }
                            _ => {}
                        }
                        if (prev_can_end) {
                            if (is_identifier_token(tt)) {
                                ret ParseStep::Continue(cursor)
                            }
                        }
                    }
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in match arm expression")
    }
    let next_angle = angle_depth
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in match arm expression")
    }
    let next_brace = next_brace_depth(tt, brace_depth)
    if (next_brace >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '{' / '}' in match arm expression")
    }

    ret consume_expression_until_match_arm_boundary(
        advance(cursor), next_square, next_angle, next_paren, next_brace, true, can_end_expression(tt)
    )
}

fn parse_match_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_match = advance(cursor)
    let scrutinee = consume_expression_until_left_brace(after_match, 0_usize, 0_usize, 0_usize, false)
    match scrutinee {
        Continue(next0) => {
            match next0.current.type {
                LEFT_BRACE => {
                    ret parse_match_arms(advance(next0), loop_depth)
                }
                _ => {
                    ret fail(next0, "Expected '{' after match scrutinee")
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_match_arms(cursor: Cursor, loop_depth: usize) -> ParseStep {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            let arm = parse_match_arm(cursor, loop_depth)
            match arm {
                Continue(next) => {
                    ret parse_match_arms_tail(next, loop_depth)
                }
                Fail(error) => {
                    ret ParseStep::Fail(error)
                }
            }
        }
    }
}

fn parse_match_arms_tail(cursor: Cursor, loop_depth: usize) -> ParseStep {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            match after_comma.current.type {
                RIGHT_BRACE => {
                    ret ParseStep::Continue(advance(after_comma))
                }
                _ => {
                    ret parse_match_arms(after_comma, loop_depth)
                }
            }
        }
        RIGHT_BRACE => {
            ret ParseStep::Continue(advance(cursor))
        }
        _ => {
            ret fail(cursor, "Expected ',' or '}' after match arm")
        }
    }
}

fn parse_match_arm(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let pattern = consume_match_pattern_until_fat_arrow(cursor, 0_usize, 0_usize, 0_usize, 0_usize, false)
    match pattern {
        Continue(next0) => {
            match next0.current.type {
                OP_FAT_ARROW => {
                    let after_arrow = advance(next0)
                    match after_arrow.current.type {
                        LEFT_BRACE => {
                            ret parse_statement_block(advance(after_arrow), loop_depth)
                        }
                        _ => {
                            ret consume_expression_until_match_arm_boundary(
                                after_arrow, 0_usize, 0_usize, 0_usize, 0_usize, false, false
                            )
                        }
                    }
                }
                _ => {
                    ret fail(next0, "Expected '=>' in match arm")
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn parse_unsafe_statement(cursor: Cursor, loop_depth: usize) -> ParseStep {
    let after_unsafe = advance(cursor)
    match after_unsafe.current.type {
        LEFT_BRACE => {
            ret parse_statement_block(advance(after_unsafe), loop_depth)
        }
        _ => {
            ret consume_expression_until_statement_boundary(
                after_unsafe, 0_usize, 0_usize, 0_usize, 0_usize, false, false
            )
        }
    }
}

fn parse_expression_or_assignment_statement(cursor: Cursor) -> ParseStep {
    let lhs = consume_expression_until_assignment_or_statement_boundary(
        cursor, 0_usize, 0_usize, 0_usize, 0_usize, false, false
    )
    match lhs {
        Continue(next0) => {
            match next0.current.type {
                OP_ASSIGN => {
                    let after_assign = advance(next0)
                    ret consume_expression_until_statement_boundary(
                        after_assign, 0_usize, 0_usize, 0_usize, 0_usize, false, false
                    )
                }
                _ => {
                    ret ParseStep::Continue(next0)
                }
            }
        }
        Fail(error) => {
            ret ParseStep::Fail(error)
        }
    }
}

fn consume_type_until_assignment(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected type in let statement")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (is_op_assign(tt)) {
                    if (consumed) {
                        ret ParseStep::Continue(cursor)
                    }
                    ret fail(cursor, "Expected type after ':'")
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in type")
    }

    ret consume_type_until_assignment(advance(cursor), next_square, next_angle, next_paren, true)
}

fn consume_expression_until_left_brace(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected condition expression")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (is_left_brace_token(tt)) {
                    if (consumed) {
                        ret ParseStep::Continue(cursor)
                    }
                    ret fail(cursor, "Expected expression before '{'")
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in expression")
    }
    let next_angle = angle_depth
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in expression")
    }

    ret consume_expression_until_left_brace(advance(cursor), next_square, next_angle, next_paren, true)
}

fn consume_match_pattern_until_fat_arrow(
    cursor: Cursor,
    square_depth: usize,
    angle_depth: usize,
    paren_depth: usize,
    brace_depth: usize,
    consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected match arm pattern")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (brace_depth == 0_usize) {
                    if (is_op_fat_arrow(tt)) {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected pattern before '=>'")
                    }
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in match pattern")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in match pattern")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in match pattern")
    }
    let next_brace = next_brace_depth(tt, brace_depth)
    if (next_brace >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '{' / '}' in match pattern")
    }

    ret consume_match_pattern_until_fat_arrow(
        advance(cursor), next_square, next_angle, next_paren, next_brace, true
    )
}

fn consume_expression_until_assignment_or_statement_boundary(
    cursor: Cursor,
    square_depth: usize,
    angle_depth: usize,
    paren_depth: usize,
    brace_depth: usize,
    consumed: bool,
    prev_can_end: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        if (consumed) {
            ret ParseStep::Continue(cursor)
        }
        ret fail(cursor, "Expected expression")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (brace_depth == 0_usize) {
                    if (consumed) {
                        if (is_op_assign(tt)) {
                            ret ParseStep::Continue(cursor)
                        }
                        if (is_statement_boundary_token(tt)) {
                            if (should_stop_at_statement_boundary(tt, prev_can_end)) {
                                ret ParseStep::Continue(cursor)
                            }
                        }
                        if (prev_can_end) {
                            if (is_identifier_token(tt)) {
                                ret ParseStep::Continue(cursor)
                            }
                        }
                    }
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in expression")
    }
    let next_angle = angle_depth
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in expression")
    }
    let next_brace = next_brace_depth(tt, brace_depth)
    if (next_brace >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '{' / '}' in expression")
    }

    ret consume_expression_until_assignment_or_statement_boundary(
        advance(cursor), next_square, next_angle, next_paren, next_brace, true, can_end_expression(tt)
    )
}

fn consume_expression_until_statement_boundary(
    cursor: Cursor,
    square_depth: usize,
    angle_depth: usize,
    paren_depth: usize,
    brace_depth: usize,
    consumed: bool,
    prev_can_end: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        if (consumed) {
            ret ParseStep::Continue(cursor)
        }
        ret fail(cursor, "Expected expression")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (brace_depth == 0_usize) {
                    if (consumed) {
                        if (is_statement_boundary_token(tt)) {
                            if (should_stop_at_statement_boundary(tt, prev_can_end)) {
                                ret ParseStep::Continue(cursor)
                            }
                        }
                        if (prev_can_end) {
                            if (is_identifier_token(tt)) {
                                ret ParseStep::Continue(cursor)
                            }
                        }
                    }
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in expression")
    }
    let next_angle = angle_depth
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in expression")
    }
    let next_brace = next_brace_depth(tt, brace_depth)
    if (next_brace >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '{' / '}' in expression")
    }

    ret consume_expression_until_statement_boundary(
        advance(cursor), next_square, next_angle, next_paren, next_brace, true, can_end_expression(tt)
    )
}

fn parse_optional_generics(cursor: Cursor) -> ParseStep {
    match cursor.current.type {
        LEFT_BRACKET => {
            let after_lbracket = advance(cursor)
            ret consume_square_group(after_lbracket, 1_usize)
        }
        _ => {
            ret ParseStep::Continue(cursor)
        }
    }
}

fn consume_square_group(cursor: Cursor, depth: usize) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Unclosed generic parameter list")
    }

    match cursor.current.type {
        LEFT_BRACKET => {
            ret consume_square_group(advance(cursor), depth + 1_usize)
        }
        RIGHT_BRACKET => {
            let after = advance(cursor)
            if (depth <= 1_usize) {
                ret ParseStep::Continue(after)
            }
            ret consume_square_group(after, depth - 1_usize)
        }
        _ => {
            ret consume_square_group(advance(cursor), depth)
        }
    }
}

fn consume_paren_group(cursor: Cursor, depth: usize) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Unclosed parameter list")
    }

    match cursor.current.type {
        LEFT_PAREN => {
            ret consume_paren_group(advance(cursor), depth + 1_usize)
        }
        RIGHT_PAREN => {
            let after = advance(cursor)
            if (depth <= 1_usize) {
                ret ParseStep::Continue(after)
            }
            ret consume_paren_group(after, depth - 1_usize)
        }
        _ => {
            ret consume_paren_group(advance(cursor), depth)
        }
    }
}

fn consume_type_until_body(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Expected function body '{'")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                match tt {
                    LEFT_BRACE => {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected return type after '->'")
                    }
                    _ => {}
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in return type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in return type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in return type")
    }

    ret consume_type_until_body(advance(cursor), next_square, next_angle, next_paren, true)
}

fn consume_type_until_signature_boundary(
    cursor: Cursor, square_depth: usize, angle_depth: usize, paren_depth: usize, consumed: bool, allow_member_boundary: bool
) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        if (consumed) {
            ret ParseStep::Continue(cursor)
        }
        ret fail(cursor, "Expected return type after '->'")
    }

    let tt = cursor.current.type
    if (square_depth == 0_usize) {
        if (angle_depth == 0_usize) {
            if (paren_depth == 0_usize) {
                if (is_top_level_start(tt)) {
                    if (consumed) {
                        ret ParseStep::Continue(cursor)
                    }
                    ret fail(cursor, "Expected return type after '->'")
                }
                if (is_cimp_keyword(cursor)) {
                    if (consumed) {
                        ret ParseStep::Continue(cursor)
                    }
                    ret fail(cursor, "Expected return type after '->'")
                }
                if (allow_member_boundary) {
                    if (is_trait_member_start(tt)) {
                        if (consumed) {
                            ret ParseStep::Continue(cursor)
                        }
                        ret fail(cursor, "Expected return type after '->'")
                    }
                }
            }
        }
    }

    let next_square = next_square_depth(tt, square_depth)
    if (next_square >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '[' / ']' in return type")
    }
    let next_angle = next_angle_depth(tt, angle_depth)
    if (next_angle >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '<' / '>' in return type")
    }
    let next_paren = next_paren_depth(tt, paren_depth)
    if (next_paren >= 1000000_usize) {
        ret fail(cursor, "Unbalanced '(' / ')' in return type")
    }

    ret consume_type_until_signature_boundary(
        advance(cursor), next_square, next_angle, next_paren, true, allow_member_boundary
    )
}

fn consume_block_body(cursor: Cursor, depth: usize) -> ParseStep {
    if (is_cursor_eof(cursor)) {
        ret fail(cursor, "Unclosed block")
    }

    match cursor.current.type {
        LEFT_BRACE => {
            ret consume_block_body(advance(cursor), depth + 1_usize)
        }
        RIGHT_BRACE => {
            let after = advance(cursor)
            if (depth <= 1_usize) {
                ret ParseStep::Continue(after)
            }
            ret consume_block_body(after, depth - 1_usize)
        }
        _ => {
            ret consume_block_body(advance(cursor), depth)
        }
    }
}

fn next_square_depth(tt: TokenType, depth: usize) -> usize {
    match tt {
        LEFT_BRACKET => {
            ret depth + 1_usize
        }
        RIGHT_BRACKET => {
            if (depth == 0_usize) {
                ret 1000000_usize
            }
            ret depth - 1_usize
        }
        _ => {
            ret depth
        }
    }
}

fn next_angle_depth(tt: TokenType, depth: usize) -> usize {
    match tt {
        OP_LESS => {
            ret depth + 1_usize
        }
        OP_GREATER => {
            if (depth == 0_usize) {
                ret 1000000_usize
            }
            ret depth - 1_usize
        }
        OP_RIGHT_SHIFT => {
            if (depth == 0_usize) {
                ret 1000000_usize
            }
            if (depth == 1_usize) {
                ret 0_usize
            }
            ret depth - 2_usize
        }
        _ => {
            ret depth
        }
    }
}

fn next_paren_depth(tt: TokenType, depth: usize) -> usize {
    match tt {
        LEFT_PAREN => {
            ret depth + 1_usize
        }
        RIGHT_PAREN => {
            if (depth == 0_usize) {
                ret 1000000_usize
            }
            ret depth - 1_usize
        }
        _ => {
            ret depth
        }
    }
}

fn next_brace_depth(tt: TokenType, depth: usize) -> usize {
    match tt {
        LEFT_BRACE => {
            ret depth + 1_usize
        }
        RIGHT_BRACE => {
            if (depth == 0_usize) {
                ret 1000000_usize
            }
            ret depth - 1_usize
        }
        _ => {
            ret depth
        }
    }
}

fn is_top_level_start(tt: TokenType) -> bool {
    match tt {
        KW_IMPORT => { ret true }
        KW_STRUCT => { ret true }
        KW_ENUM => { ret true }
        KW_TRAIT => { ret true }
        KW_IMPL => { ret true }
        KW_EXTERN => { ret true }
        KW_UNSAFE => { ret true }
        KW_FN => { ret true }
        KW_PUB => { ret true }
        EOF => { ret true }
        _ => { ret false }
    }
}

fn is_trait_member_start(tt: TokenType) -> bool {
    match tt {
        RIGHT_BRACE => { ret true }
        KW_FN => { ret true }
        KW_PUB => { ret true }
        _ => { ret false }
    }
}

fn is_statement_boundary_token(tt: TokenType) -> bool {
    match tt {
        KW_LET => { ret true }
        KW_RET => { ret true }
        KW_IF => { ret true }
        KW_ELIF => { ret true }
        KW_ELSE => { ret true }
        KW_WHILE => { ret true }
        KW_FOR => { ret true }
        KW_LOOP => { ret true }
        KW_DO => { ret true }
        KW_MATCH => { ret true }
        KW_BREAK => { ret true }
        KW_CONTINUE => { ret true }
        KW_UNSAFE => { ret true }
        RIGHT_BRACE => { ret true }
        EOF => { ret true }
        _ => { ret false }
    }
}

fn should_stop_at_statement_boundary(tt: TokenType, prev_can_end: bool) -> bool {
    match tt {
        KW_IF => { ret prev_can_end }
        KW_MATCH => { ret prev_can_end }
        KW_UNSAFE => { ret prev_can_end }
        _ => { ret true }
    }
}

fn can_end_expression(tt: TokenType) -> bool {
    match tt {
        IDENTIFIER => { ret true }
        INTEGER => { ret true }
        FLOAT => { ret true }
        STRING => { ret true }
        RIGHT_PAREN => { ret true }
        RIGHT_BRACKET => { ret true }
        RIGHT_BRACE => { ret true }
        OP_TRY => { ret true }
        _ => { ret false }
    }
}

fn is_kw_for(tt: TokenType) -> bool {
    match tt {
        KW_FOR => { ret true }
        _ => { ret false }
    }
}

fn is_op_assign(tt: TokenType) -> bool {
    match tt {
        OP_ASSIGN => { ret true }
        OP_PLUS_ASSIGN => { ret true }
        OP_MINUS_ASSIGN => { ret true }
        OP_MULT_ASSIGN => { ret true }
        OP_DIV_ASSIGN => { ret true }
        OP_MOD_ASSIGN => { ret true }
        OP_AND_ASSIGN => { ret true }
        OP_OR_ASSIGN => { ret true }
        OP_XOR_ASSIGN => { ret true }
        OP_LSHIFT_ASSIGN => { ret true }
        OP_RSHIFT_ASSIGN => { ret true }
        _ => { ret false }
    }
}

fn is_left_brace_token(tt: TokenType) -> bool {
    match tt {
        LEFT_BRACE => { ret true }
        _ => { ret false }
    }
}

fn is_op_fat_arrow(tt: TokenType) -> bool {
    match tt {
        OP_FAT_ARROW => { ret true }
        _ => { ret false }
    }
}

fn is_identifier_token(tt: TokenType) -> bool {
    match tt {
        IDENTIFIER => { ret true }
        _ => { ret false }
    }
}

fn is_self_identifier(cursor: Cursor) -> bool {
    if is_identifier_token(cursor.current.type) {
        ret str_eq(cursor.current.value, "self")
    }
    ret false
}

fn is_cursor_eof(cursor: Cursor) -> bool {
    match cursor.current.type {
        EOF => { ret true }
        _ => { ret false }
    }
}

fn make_error(cursor: Cursor, message: str) -> ParseError {
    ret ParseError{message, cursor.current.line, cursor.current.column}
}

fn fail(cursor: Cursor, message: str) -> ParseStep {
    let current_name = token_type_name(cursor.current.type)
    let with_type = concat(concat(concat(message, " ["), current_name), "]")
    if (len(cursor.current.value) > 0_usize) {
        ret ParseStep::Fail(make_error(cursor, concat(concat(with_type, ": "), cursor.current.value)))
    }
    ret ParseStep::Fail(make_error(cursor, with_type))
}

fn empty_parsed_module() -> ParsedModule {
    ret ParsedModule{
        0_usize,
        0_usize,
        0_usize,
        0_usize,
        0_usize,
        0_usize,
        0_usize,
        0_usize,
        0_usize,
        "",
        "",
        "",
        "",
        Vec[ParsedDirective]::new(),
        ""
    }
}

fn finalize_parsed_module(module: ParsedModule) -> ParsedModule {
    ret ParsedModule{
        module.directives,
        module.imports,
        module.structs,
        module.enums,
        module.traits,
        module.impls,
        module.functions,
        module.extern_functions,
        module.unsafe_functions,
        module.import_bindings_outline,
        module.public_import_bindings_outline,
        module.cimport_bindings_outline,
        module.directives_meta_outline,
        module.directives_meta,
        module.outline
    }
}

fn prepend_directive_meta(meta: Vec[ParsedDirective], cursor: Cursor) -> Vec[ParsedDirective] {
    ret meta.push(directive_meta(cursor))
}

fn count_directive(module: ParsedModule, cursor: Cursor) -> ParsedModule {
    let is_public = directive_is_public(cursor)
    let no_pub = consume_optional_pub(cursor)
    if (is_cimp_keyword(no_pub)) {
        let collected = collect_import_bindings_outline(no_pub)
        ret ParsedModule{
            module.directives + 1_usize,
            module.imports + 1_usize,
            module.structs,
            module.enums,
            module.traits,
            module.impls,
            module.functions,
            module.extern_functions,
            module.unsafe_functions,
            append_lines(module.import_bindings_outline, collected),
            append_lines(module.public_import_bindings_outline, collected),
            append_lines(module.cimport_bindings_outline, collected),
            append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
            prepend_directive_meta(module.directives_meta, cursor),
            append_outline(module.outline, directive_header(cursor))
        }
    }
    match no_pub.current.type {
        KW_IMPORT => {
            let collected = collect_import_bindings_outline(no_pub)
            let next_public_imports = if (is_public) {
                append_lines(module.public_import_bindings_outline, collected)
            } else {
                module.public_import_bindings_outline
            }
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports + 1_usize,
                module.structs,
                module.enums,
                module.traits,
                module.impls,
                module.functions,
                module.extern_functions,
                module.unsafe_functions,
                append_lines(module.import_bindings_outline, collected),
                next_public_imports,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_STRUCT => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs + 1_usize,
                module.enums,
                module.traits,
                module.impls,
                module.functions,
                module.extern_functions,
                module.unsafe_functions,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_ENUM => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs,
                module.enums + 1_usize,
                module.traits,
                module.impls,
                module.functions,
                module.extern_functions,
                module.unsafe_functions,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_TRAIT => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs,
                module.enums,
                module.traits + 1_usize,
                module.impls,
                module.functions,
                module.extern_functions,
                module.unsafe_functions,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_IMPL => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs,
                module.enums,
                module.traits,
                module.impls + 1_usize,
                module.functions,
                module.extern_functions,
                module.unsafe_functions,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_EXTERN => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs,
                module.enums,
                module.traits,
                module.impls,
                module.functions,
                module.extern_functions + 1_usize,
                module.unsafe_functions,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_UNSAFE => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs,
                module.enums,
                module.traits,
                module.impls,
                module.functions,
                module.extern_functions,
                module.unsafe_functions + 1_usize,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        KW_FN => {
            ret ParsedModule{
                module.directives + 1_usize,
                module.imports,
                module.structs,
                module.enums,
                module.traits,
                module.impls,
                module.functions + 1_usize,
                module.extern_functions,
                module.unsafe_functions,
                module.import_bindings_outline,
                module.public_import_bindings_outline,
                module.cimport_bindings_outline,
                append_lines(module.directives_meta_outline, directive_meta_line(cursor)),
                prepend_directive_meta(module.directives_meta, cursor),
                append_outline(module.outline, directive_header(cursor))
            }
        }
        _ => {
            ret module
        }
    }
}

struct ImportLineCollect {
    cursor: Cursor
    lines: str
}

struct ImportRoot {
    cursor: Cursor
    is_refrain: bool
}

fn collect_import_bindings_outline(import_cursor: Cursor) -> str {
    let after_kw = advance(import_cursor)
    let rooted = consume_refrain_import_root(after_kw)
    let parsed = parse_import_line_expr(rooted.cursor, "", rooted.is_refrain)
    ret parsed.lines
}

fn consume_refrain_import_root(cursor: Cursor) -> ImportRoot {
    match cursor.current.type {
        IDENTIFIER => {
            if (str_eq(cursor.current.value, "refrain")) {
                let after_name = advance(cursor)
                match after_name.current.type {
                    OP_SCOPE => {
                        ret ImportRoot{advance(after_name), true}
                    }
                    _ => {}
                }
            }
            ret ImportRoot{cursor, false}
        }
        _ => {
            ret ImportRoot{cursor, false}
        }
    }
}

fn parse_import_line_expr(cursor: Cursor, prefix: str, is_refrain: bool) -> ImportLineCollect {
    match cursor.current.type {
        IDENTIFIER => {
            ret parse_import_line_segment(cursor, cursor.current.value, prefix, is_refrain)
        }
        OP_MULTIPLY => {
            ret parse_import_line_segment(cursor, "*", prefix, is_refrain)
        }
        _ => {
            ret ImportLineCollect{cursor, ""}
        }
    }
}

fn parse_import_line_segment(cursor: Cursor, segment: str, prefix: str, is_refrain: bool) -> ImportLineCollect {
    let path = join_import_path(prefix, segment)
    let after_segment = advance(cursor)
    match after_segment.current.type {
        OP_SCOPE => {
            let after_scope = advance(after_segment)
            match after_scope.current.type {
                LEFT_BRACE => {
                    ret parse_import_line_group(advance(after_scope), path, is_refrain)
                }
                _ => {
                    ret parse_import_line_expr(after_scope, path, is_refrain)
                }
            }
        }
        _ => {
            ret ImportLineCollect{after_segment, with_refrain_prefix(path, is_refrain)}
        }
    }
}

fn parse_import_line_group(cursor: Cursor, prefix: str, is_refrain: bool) -> ImportLineCollect {
    match cursor.current.type {
        RIGHT_BRACE => {
            ret ImportLineCollect{advance(cursor), ""}
        }
        _ => {
            let first = parse_import_line_expr(cursor, prefix, is_refrain)
            ret parse_import_line_group_tail(first.cursor, prefix, is_refrain, first.lines)
        }
    }
}

fn parse_import_line_group_tail(cursor: Cursor, prefix: str, is_refrain: bool, acc: str) -> ImportLineCollect {
    match cursor.current.type {
        COMMA => {
            let after_comma = advance(cursor)
            match after_comma.current.type {
                RIGHT_BRACE => {
                    ret ImportLineCollect{advance(after_comma), acc}
                }
                _ => {
                    let next = parse_import_line_expr(after_comma, prefix, is_refrain)
                    ret parse_import_line_group_tail(
                        next.cursor, prefix, is_refrain, append_lines(acc, next.lines)
                    )
                }
            }
        }
        RIGHT_BRACE => {
            ret ImportLineCollect{advance(cursor), acc}
        }
        _ => {
            ret ImportLineCollect{cursor, acc}
        }
    }
}

fn join_import_path(prefix: str, segment: str) -> str {
    if (len(prefix) == 0_usize) {
        ret segment
    }
    ret concat(concat(prefix, "::"), segment)
}

fn with_refrain_prefix(path: str, is_refrain: bool) -> str {
    if (is_refrain) {
        ret concat("refrain::", path)
    }
    ret path
}

fn append_lines(lhs: str, rhs: str) -> str {
    if (len(lhs) == 0_usize) {
        ret rhs
    }
    if (len(rhs) == 0_usize) {
        ret lhs
    }
    ret concat(concat(lhs, "\n"), rhs)
}

fn append_outline(outline: str, line: str) -> str {
    if (len(outline) == 0_usize) {
        ret line
    }
    ret concat(concat(outline, "\n"), line)
}

fn directive_header(cursor: Cursor) -> str {
    let is_public = directive_is_public(cursor)
    let pub_prefix = if (is_public) { "pub " } else { "" }
    let no_pub = consume_optional_pub(cursor)
    if (is_cimp_keyword(no_pub)) {
        let after_kw = advance(no_pub)
        let head = first_import_segment(after_kw)
        ret concat(concat(pub_prefix, "cimp "), head)
    }

    match no_pub.current.type {
        KW_IMPORT => {
            let after_kw = advance(no_pub)
            let head = first_import_segment(after_kw)
            ret concat(concat(pub_prefix, "import "), head)
        }
        KW_STRUCT => {
            ret concat(concat(pub_prefix, "struct "), identifier_after_keyword(no_pub))
        }
        KW_ENUM => {
            ret concat(concat(pub_prefix, "enum "), identifier_after_keyword(no_pub))
        }
        KW_TRAIT => {
            ret concat(concat(pub_prefix, "trait "), identifier_after_keyword(no_pub))
        }
        KW_IMPL => {
            ret concat(pub_prefix, "impl")
        }
        KW_EXTERN => {
            let after_extern = advance(no_pub)
            let after_fn = skip_optional_unsafe(after_extern)
            let name = identifier_after_keyword(after_fn)
            ret concat(concat(pub_prefix, "extern fn "), name)
        }
        KW_UNSAFE => {
            let name = identifier_after_keyword(advance(no_pub))
            ret concat(concat(pub_prefix, "unsafe fn "), name)
        }
        KW_FN => {
            ret concat(concat(pub_prefix, "fn "), identifier_after_keyword(no_pub))
        }
        _ => {
            ret "<unknown>"
        }
    }
}

fn directive_meta(cursor: Cursor) -> ParsedDirective {
    let is_public = directive_is_public(cursor)
    let no_pub = consume_optional_pub(cursor)
    let name = directive_name(no_pub)

    ret ParsedDirective{
        directive_kind(no_pub),
        is_public,
        name,
        no_pub.current.line,
        no_pub.current.column
    }
}

fn directive_meta_line(cursor: Cursor) -> str {
    let is_public = directive_is_public(cursor)
    let no_pub = consume_optional_pub(cursor)
    let visibility = if (is_public) { "pub" } else { "priv" }
    let kind = directive_kind_line_label(directive_kind(no_pub))
    let name = directive_name(no_pub)
    ret concat(
        concat(
            concat(kind, " "),
            concat(visibility, " ")
        ),
        name
    )
}

fn directive_name(no_pub: Cursor) -> str {
    if (is_cimp_keyword(no_pub)) {
        let after_kw = advance(no_pub)
        ret first_import_segment(after_kw)
    }
    match no_pub.current.type {
        KW_IMPORT => {
            let after_kw = advance(no_pub)
            ret first_import_segment(after_kw)
        }
        KW_STRUCT => {
            ret identifier_after_keyword(no_pub)
        }
        KW_ENUM => {
            ret identifier_after_keyword(no_pub)
        }
        KW_TRAIT => {
            ret identifier_after_keyword(no_pub)
        }
        KW_IMPL => {
            ret "<impl>"
        }
        KW_EXTERN => {
            let after_extern = advance(no_pub)
            let after_fn = skip_optional_unsafe(after_extern)
            ret identifier_after_keyword(after_fn)
        }
        KW_UNSAFE => {
            ret identifier_after_keyword(advance(no_pub))
        }
        KW_FN => {
            ret identifier_after_keyword(no_pub)
        }
        _ => {
            ret "<unknown>"
        }
    }
}

fn directive_kind(cursor: Cursor) -> ParsedDirectiveKind {
    if (is_cimp_keyword(cursor)) {
        ret ParsedDirectiveKind::CImport
    }
    match cursor.current.type {
        KW_IMPORT => { ret ParsedDirectiveKind::Import }
        KW_STRUCT => { ret ParsedDirectiveKind::Struct }
        KW_ENUM => { ret ParsedDirectiveKind::Enum }
        KW_TRAIT => { ret ParsedDirectiveKind::Trait }
        KW_IMPL => { ret ParsedDirectiveKind::Impl }
        KW_FN => { ret ParsedDirectiveKind::Function }
        KW_EXTERN => { ret ParsedDirectiveKind::ExternFunction }
        KW_UNSAFE => { ret ParsedDirectiveKind::UnsafeFunction }
        _ => { ret ParsedDirectiveKind::Unknown }
    }
}

fn directive_kind_line_label(kind: ParsedDirectiveKind) -> str {
    match kind {
        Import => { ret "import" }
        CImport => { ret "cimp" }
        Struct => { ret "struct" }
        Enum => { ret "enum" }
        Trait => { ret "trait" }
        Impl => { ret "impl" }
        Function => { ret "fn" }
        ExternFunction => { ret "extern_fn" }
        UnsafeFunction => { ret "unsafe_fn" }
        Unknown => { ret "unknown" }
    }
}

fn identifier_after_keyword(cursor: Cursor) -> str {
    let next = advance(cursor)
    if is_identifier_token(next.current.type) {
        ret next.current.value
    }
    ret "<unknown>"
}

fn first_import_segment(cursor: Cursor) -> str {
    if is_identifier_token(cursor.current.type) {
        ret cursor.current.value
    }
    match cursor.current.type {
        OP_MULTIPLY => {
            ret "*"
        }
        _ => {
        }
    }
    ret "<unknown>"
}

fn skip_optional_unsafe(cursor: Cursor) -> Cursor {
    match cursor.current.type {
        KW_UNSAFE => {
            ret advance(cursor)
        }
        _ => {
            ret cursor
        }
    }
}

fn is_cimp_keyword(cursor: Cursor) -> bool {
    if is_identifier_token(cursor.current.type) {
        ret str_eq(cursor.current.value, "cimp")
    }
    ret false
}

fn usize_to_str(value: usize) -> str {
    if (value < 10_usize) {
        ret digit_to_str(value)
    }

    let q = value / 10_usize
    let r = value - q * 10_usize
    ret concat(usize_to_str(q), digit_to_str(r))
}

fn digit_to_str(value: usize) -> str {
    if (value == 0_usize) { ret "0" }
    if (value == 1_usize) { ret "1" }
    if (value == 2_usize) { ret "2" }
    if (value == 3_usize) { ret "3" }
    if (value == 4_usize) { ret "4" }
    if (value == 5_usize) { ret "5" }
    if (value == 6_usize) { ret "6" }
    if (value == 7_usize) { ret "7" }
    if (value == 8_usize) { ret "8" }
    if (value == 9_usize) { ret "9" }
    ret "?"
}
