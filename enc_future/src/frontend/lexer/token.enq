import std::string::String


pub struct Token {
    type   : TokenType
    value  : String
    line   : usize
    column : usize
}

impl for Token {
    pub fn new(type: TokenType, value: String, line: usize, column: usize) -> Token {
        ret Token {type, value, line, column}
    }
}

pub enum TokenType {
    INTEGER
    FLOAT
    BOOLEAN
    STRING
    IDENTIFIER

    ONE_LINE_COMMENT
    MULTI_LINE_COMMENT

    KW_FN
    KW_STRUCT
    KW_TRAIT
    KW_ENUM
    KW_IMPL
    KW_FOR
    KW_LET
    KW_MUT
    KW_RET
    KW_WHILE
    KW_LOOP
    KW_DO
    KW_CONTINUE
    KW_BREAK
    KW_IF
    KW_ELIF
    KW_ELSE
    KW_MATCH
    KW_PUB
    KW_IMPORT
    KW_EXTERN
    KW_UNSAFE
    KW_EHIR

    SCOPE

    PLUS
    MINUS
    ASTERISK
    SLASH
    PERCENT

    EQUAL_EQUAL
    BANG_EQUAL
    LESS
    GREATER
    LESS_EQUAL
    GREATER_EQUAL

    AND_AND
    PIPE_PIPE
    BANG

    AMPERSAND
    PIPE
    CARET
    TILDE
    LEFT_SHIFT
    RIGHT_SHIFT

    ASSIGN
    PLUS_EQUAL
    MINUS_EQUAL
    ASTERISK_EQUAL
    SLASH_EQUAL
    PERCENT_EQUAL
    AMPERSAND_EQUAL
    PIPE_EQUAL
    CARET_EQUAL
    LEFT_SHIFT_EQUAL
    RIGHT_SHIFT_EQUAL

    INCREMENT
    DECREMENT
    QUESTION

    ARROW
    FAT_ARROW

    LEFT_PAREN
    RIGHT_PAREN
    LEFT_BRACE
    RIGHT_BRACE
    LEFT_BRACKET
    RIGHT_BRACKET
    SEMICOLON
    COLON
    COMMA
    DOT
    QUOTE

    WHITESPACE
    NEWLINE
    EOF
    UNKNOWN
}
