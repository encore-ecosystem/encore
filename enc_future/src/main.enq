import std::os::*
import std::io::print
import std::io::println
import std::option::Option
import std::string::String
import std::string::str_eq
import refrain::modes::build::*

fn main() -> u32 {
    let mut mode = ""
    match argv(1_usize) {
        Option[str]::Some(m) => {
            mode = m
        }
        Option[str]::None => {
            println("Please, provide mode!")
            ret 1
        }
    }

    if mode == "run" {
        println("Not implemented yet!")
        ret 1
    }
    if mode == "build" {
        ret run_build()
    }
    if mode == "add" {
        println("Not implemented yet!")
        ret 1
    }
    if mode == "update" {
        println("Not implemented yet!")
        ret 1
    }
    if mode == "test" {
        println("Not implemented yet!")
        ret 1
    }

    print("Unknown mode: ")
    println(mode)
    ret 1
}
