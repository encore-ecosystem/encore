import std::os::argv
import std::os::argc
import std::io::println
import std::string::str_eq
import modes::build::run_build
import modes::init::run_init
import modes::run::run_run
import modes::add::run_add
import modes::update::run_update

fn main() -> u32 {
    if argc() <= 1_usize {
        println("enc_future: build")
        ret run_build()
    }

    let raw = argv(1_usize)
    if str_eq(raw, "add") {
        println("enc_future: add")
        ret run_add()
    }
    if str_eq(raw, "build") {
        println("enc_future: build")
        ret run_build()
    }
    if str_eq(raw, "init") {
        println("enc_future: init")
        ret run_init()
    }
    if str_eq(raw, "run") {
        println("enc_future: run")
        ret run_run()
    }
    if str_eq(raw, "update") {
        println("enc_future: update")
        ret run_update()
    }

    println("encore <add|build|init|run|update>")
    ret 1_u32
}
