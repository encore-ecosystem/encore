import std::os::argv
import std::io::print
import std::io::println
import core::option::Option
import std::string::String
import refrain::modes


fn main() -> u32 {
    let mut mode = ""
    match argv(1_usize) {
        Option[str]::Some(m) => {
            mode = m
        }
        Option[str]::None => {
            println("Please, provide mode!")
            ret 1
        }
    }

    match mode {
        "run" => {
            println("Not implemented yet!")
            ret 1
        }
        "build" => {
            ret modes::build::run_build()
        }
        "add" => {
            println("Not implemented yet!")
            ret 1
        }
        "update" => {
            println("Not implemented yet!")
            ret 1
        }
        "test" => {
            println("Not implemented yet!")
            ret 1
        }
        _ => {
            print("Unknown mode: ")
            println(mode)
            ret 1
        }
    }
}
