import std::os::*
import std::io::print
import std::io::println
import std::option::Option
import std::string::String
import std::string::str_eq
import refrain::modes::build::*


fn main() -> u32 {
    let mut mode = ""
    match argv(1_usize) {
        Option[str]::Some(m) => {
            mode = m
        }
        Option[str]::None => {
            println("Please, provide mode!")
            ret 1
        }
    }

    if str_eq(mode, "build") {
        ret run_build()
    }

    print("Unknown mode: ")
    println(mode)
    ret 1
}
