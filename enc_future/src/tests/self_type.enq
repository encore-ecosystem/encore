import core::testing::*

struct Counter {
    value: u32
}

impl for Counter {
    fn new(value: u32) -> Self {
        ret Counter{value}
    }

    fn get(self) -> u32 {
        ret self.value
    }
}

fn main() -> u32 {
    let counter = Counter::new(5_u32)
    if !assert(counter.get() == 5_u32) {
        ret 1_u32
    }
    ret 0_u32
}
