import core::testing::*
import std::string::String

struct Holder {
    value: String
}

impl for Holder {
    pub fn new() -> Holder {
        ret Holder{String::new()}
    }

    pub fn set_and_len(mut self, text: str) -> usize {
        self.value = String::from_str(text)
        ret self.value.len()
    }
}

fn main() -> u32 {
    let holder = Holder::new()
    let len = holder.set_and_len("hello")
    if !assert(len == 5_usize) {
        ret 1_u32
    }
    ret 0_u32
}
