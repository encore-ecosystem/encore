import core::testing::*
import std::option::Option
import std::string::String
import std::vec::Vec

fn unwrap_or_zero(opt: Option[usize]) -> usize {
    ret match opt {
        Some(value) => value
        None => 0_usize
    }
}

fn main() -> u32 {
    let mut vec: Vec[usize] = Vec[usize]::new()
    vec = vec.push(5_usize)
    vec = vec.push(7_usize)

    let first = unwrap_or_zero(vec.get(0_usize))
    let second = unwrap_or_zero(vec.get(1_usize))
    let meta = vec.len() + vec.capacity()

    let s = String::from_str("abc")
    let total = first + second + meta + s.len()

    vec.free()

    if !assert(total == 21_usize) {
        ret 1_u32
    }
    ret 0_u32
}
