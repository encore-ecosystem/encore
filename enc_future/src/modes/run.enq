import std::io::println
import std::string::concat
import std::string::len
import std::string::str_eq
import std::os::argc
import std::os::argv
import std::os::file_exists
import std::os::run_command
import repo::modes::build::run_build
import repo::modes::manifest::load_build_settings
import repo::modes::manifest::BuildSettings

pub fn run_run() -> u32 {
    let status = run_build()
    if (status != 0_u32) {
        ret status
    }

    let settings = load_build_settings("encore.toml")
    let target = settings.target
    if (str_eq(target, "static_lib")) {
        println("run: static_lib target is not runnable")
        ret 1_u32
    }
    if (str_eq(target, "object")) {
        println("run: object target is not runnable")
        ret 1_u32
    }
    if (str_eq(target, "dynamic_lib")) {
        println("run: dynamic_lib target is not runnable")
        ret 1_u32
    }

    let artifact_path = resolve_artifact_path(settings)
    if (not file_exists(artifact_path)) {
        println(concat("run: artifact not found: ", artifact_path))
        ret 1_u32
    }

    let cmd = join_run_command(artifact_path, 2_usize, "")
    let run_status: i32 = run_command(cmd)
    if (run_status < 0_i32) {
        ret 1_u32
    }
    ret i32_to_u32(run_status)
}

fn resolve_artifact_path(settings: BuildSettings) -> str {
    let profile = settings.profile
    let target = settings.target
    let project_name = settings.project_name
    let base_dir = concat("target/", profile)

    if (str_eq(target, "object")) {
        let filename = concat(project_name, ".o")
        ret concat(concat(base_dir, "/object/"), filename)
    }
    if (str_eq(target, "static_lib")) {
        let filename = concat(concat("lib", project_name), ".a")
        ret concat(concat(base_dir, "/"), filename)
    }
    if (str_eq(target, "dynamic_lib")) {
        let filename = concat(concat("lib", project_name), ".so")
        ret concat(concat(base_dir, "/"), filename)
    }
    ret concat(concat(base_dir, "/"), project_name)
}

fn join_run_command(binary_path: str, arg_index: usize, arg_acc: str) -> str {
    if (arg_index >= argc()) {
        if (len(arg_acc) == 0_usize) {
            ret binary_path
        }
        ret concat(concat(binary_path, " "), arg_acc)
    }

    let next_arg = argv(arg_index)
    let next_acc = if (len(arg_acc) == 0_usize) {
        next_arg
    } else {
        concat(concat(arg_acc, " "), next_arg)
    }
    ret join_run_command(binary_path, arg_index + 1_usize, next_acc)
}

