import std::io::println
import std::os::argc
import std::os::argv
import std::os::file_exists
import std::os::read_file
import std::os::write_file
import std::os::ensure_parent_dirs
import std::os::run_command
import std::string::len
import std::string::slice
import std::string::concat
import std::string::str_eq
import std::string::byte_at

pub fn run_add() -> u32 {
    if (argc() <= 2_usize) {
        println("add: usage: encore add <path@...|git@...>")
        ret 1_u32
    }

    let dependency = argv(2_usize)
    if (not is_supported_dependency(dependency)) {
        println(concat("add: unsupported dependency format: ", dependency))
        println("add: expected path@... or git@...")
        ret 1_u32
    }

    if (not file_exists("encore.toml")) {
        println("add: project is not initialized (missing encore.toml)")
        ret 1_u32
    }

    let contents = read_file("encore.toml")
    let deps_outline = parse_dependency_entries_outline(contents)
    if (contains_line(deps_outline, dependency)) {
        println(concat("add: dependency already exists: ", dependency))
        ret 0_u32
    }

    let next_deps = append_lines(deps_outline, dependency)
    let next_contents = write_dependencies_list(contents, next_deps)
    if (len(next_contents) == 0_usize) {
        println("add: unable to patch dependencies list in encore.toml")
        ret 1_u32
    }

    let write_status: i32 = write_file("encore.toml", next_contents)
    if (write_status != 0_i32) {
        println("add: unable to write encore.toml")
        ret 1_u32
    }

    let resolve_status = resolve_dependency(dependency)
    if (resolve_status != 0_u32) {
        ret resolve_status
    }

    println(concat("add: added dependency ", dependency))
    ret 0_u32
}

fn resolve_dependency(dep: str) -> u32 {
    if (starts_with(dep, "path@")) {
        let path = slice(dep, 5_usize, len(dep) - 5_usize)
        if (file_exists(path)) {
            ret 0_u32
        }
        println(concat("add: path dependency does not exist: ", path))
        ret 1_u32
    }

    if (starts_with(dep, "git@")) {
        ret ensure_git_dependency(dep, false)
    }

    ret 1_u32
}

fn ensure_git_dependency(dep: str, update_existing: bool) -> u32 {
    let url = slice(dep, 4_usize, len(dep) - 4_usize)
    let path = git_cache_path(url)
    if (len(path) == 0_usize) {
        println(concat("add: unable to resolve git dependency path: ", dep))
        ret 1_u32
    }

    let git_dir = concat(path, "/.git")
    if (file_exists(git_dir)) {
        if (update_existing) {
            let pull_cmd = concat("git -C ", concat(path, " pull"))
            let pull_status: i32 = run_command(pull_cmd)
            if (pull_status != 0_i32) {
                println(concat("add: git pull failed: ", dep))
                ret 1_u32
            }
            println(concat("add: updated ", dep))
        }
        ret 0_u32
    }

    let mkdir_status = ensure_parent_dirs(concat(path, "/.gitkeep"))
    if (mkdir_status != 0_i32) {
        println(concat("add: unable to create cache dir for ", dep))
        ret 1_u32
    }

    let clone_cmd = concat(concat("git clone ", url), concat(" ", path))
    let clone_status: i32 = run_command(clone_cmd)
    if (clone_status != 0_i32) {
        println(concat("add: git clone failed: ", dep))
        ret 1_u32
    }

    println(concat("add: fetched ", dep))
    ret 0_u32
}

fn git_cache_path(url: str) -> str {
    let org = basename(dirname(url))
    let repo = strip_suffix(basename(url), ".git")
    if (len(org) == 0_usize) {
        ret ""
    }
    if (len(repo) == 0_usize) {
        ret ""
    }
    ret concat(".ehir/cache/git/", concat(org, concat("/", repo)))
}

fn write_dependencies_list(contents: str, deps_outline: str) -> str {
    let rendered = render_dependency_array(deps_outline)
    let key_start = find_substring(contents, "dependencies", 0_usize)
    if (key_start >= len(contents)) {
        let tail = if (len(contents) == 0_usize) {
            ""
        } else {
            if (ends_with_newline(contents)) {
                ""
            } else {
                "\n"
            }
        }
        let appended = concat("dependencies = ", rendered)
        ret concat(concat(contents, tail), concat(appended, "\n"))
    }

    let list_start = find_char(contents, 91, key_start)
    if (list_start >= len(contents)) {
        ret ""
    }
    let list_end = find_char(contents, 93, list_start + 1_usize)
    if (list_end >= len(contents)) {
        ret ""
    }

    let prefix = slice(contents, 0_usize, list_start)
    let suffix_start = list_end + 1_usize
    let suffix = if (suffix_start >= len(contents)) {
        ""
    } else {
        slice(contents, suffix_start, len(contents) - suffix_start)
    }
    ret concat(prefix, concat(rendered, suffix))
}

fn render_dependency_array(entries_outline: str) -> str {
    if (len(entries_outline) == 0_usize) {
        ret "[]"
    }
    ret concat("[\n", concat(render_dependency_entries(entries_outline, 0_usize), "]"))
}

fn render_dependency_entries(entries_outline: str, index: usize) -> str {
    if (index >= len(entries_outline)) {
        ret ""
    }

    let line_end = find_line_end(entries_outline, index)
    let entry = slice(entries_outline, index, line_end - index)
    let next_index = next_line_index(entries_outline, line_end)
    if (len(entry) == 0_usize) {
        ret render_dependency_entries(entries_outline, next_index)
    }

    let rendered = concat("    \"", concat(entry, "\""))
    let rest = render_dependency_entries(entries_outline, next_index)
    if (len(rest) == 0_usize) {
        ret concat(rendered, "\n")
    }
    ret concat(rendered, concat(",\n", rest))
}

fn parse_dependency_entries_outline(contents: str) -> str {
    let key_start = find_substring(contents, "dependencies", 0_usize)
    if (key_start >= len(contents)) {
        ret ""
    }

    let list_start = find_char(contents, 91, key_start)
    if (list_start >= len(contents)) {
        ret ""
    }
    let list_end = find_char(contents, 93, list_start + 1_usize)
    if (list_end >= len(contents)) {
        ret ""
    }

    ret parse_dependency_entry_values(contents, list_start + 1_usize, list_end, "")
}

fn parse_dependency_entry_values(contents: str, index: usize, list_end: usize, acc: str) -> str {
    if (index >= list_end) {
        ret acc
    }

    let quote = find_char(contents, 34, index)
    if (quote >= list_end) {
        ret acc
    }
    let close_quote = find_char(contents, 34, quote + 1_usize)
    if (close_quote >= list_end) {
        ret acc
    }

    let raw_dep = slice(contents, quote + 1_usize, close_quote - quote - 1_usize)
    let next_acc = append_lines(acc, raw_dep)
    ret parse_dependency_entry_values(contents, close_quote + 1_usize, list_end, next_acc)
}

fn is_supported_dependency(dep: str) -> bool {
    if (starts_with(dep, "path@")) {
        ret true
    }
    if (starts_with(dep, "git@")) {
        ret true
    }
    ret false
}

fn starts_with(value: str, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (prefix_len > len(value)) {
        ret false
    }
    ret str_eq(slice(value, 0_usize, prefix_len), prefix)
}

fn ends_with_newline(value: str) -> bool {
    if (len(value) == 0_usize) {
        ret false
    }
    let last = byte_at(value, len(value) - 1_usize)
    if (last == 10) {
        ret true
    }
    if (last == 13) {
        ret true
    }
    ret false
}

fn append_lines(lhs: str, rhs: str) -> str {
    if (len(lhs) == 0_usize) {
        ret rhs
    }
    if (len(rhs) == 0_usize) {
        ret lhs
    }
    ret concat(concat(lhs, "\n"), rhs)
}

fn contains_line(lines: str, target: str) -> bool {
    ret contains_line_from(lines, target, 0_usize)
}

fn contains_line_from(lines: str, target: str, index: usize) -> bool {
    if (index >= len(lines)) {
        ret false
    }
    let line_end = find_line_end(lines, index)
    let line = slice(lines, index, line_end - index)
    if (str_eq(line, target)) {
        ret true
    }
    ret contains_line_from(lines, target, next_line_index(lines, line_end))
}

fn basename(path: str) -> str {
    if (len(path) == 0_usize) {
        ret ""
    }
    let slash = find_last_char(path, 47, len(path))
    if (slash >= 1000000_usize) {
        ret path
    }
    let start = slash + 1_usize
    if (start >= len(path)) {
        ret ""
    }
    ret slice(path, start, len(path) - start)
}

fn dirname(path: str) -> str {
    if (len(path) == 0_usize) {
        ret "."
    }
    let slash = find_last_char(path, 47, len(path))
    if (slash >= 1000000_usize) {
        ret "."
    }
    if (slash == 0_usize) {
        ret "/"
    }
    ret slice(path, 0_usize, slash)
}

fn strip_suffix(value: str, suffix: str) -> str {
    let value_len = len(value)
    let suffix_len = len(suffix)
    if (suffix_len > value_len) {
        ret value
    }
    let start = value_len - suffix_len
    if (str_eq(slice(value, start, suffix_len), suffix)) {
        ret slice(value, 0_usize, start)
    }
    ret value
}

fn find_substring(text: str, pattern: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret len(text)
    }
    if (starts_with_at(text, index, pattern)) {
        ret index
    }
    ret find_substring(text, pattern, index + 1_usize)
}

fn starts_with_at(text: str, index: usize, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (index + prefix_len > len(text)) {
        ret false
    }
    ret str_eq(slice(text, index, prefix_len), prefix)
}

fn find_char(text: str, code: u8, index: usize) -> usize {
    if (index >= len(text)) {
        ret len(text)
    }
    if (byte_at(text, index) == code) {
        ret index
    }
    ret find_char(text, code, index + 1_usize)
}

fn find_last_char(text: str, code: u8, index: usize) -> usize {
    if (index == 0_usize) {
        ret 1000000_usize
    }
    let i = index - 1_usize
    if (byte_at(text, i) == code) {
        ret i
    }
    ret find_last_char(text, code, i)
}

fn find_line_end(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 10) {
        ret index
    }
    if (ch == 13) {
        ret index
    }
    ret find_line_end(text, index + 1_usize)
}

fn next_line_index(text: str, line_end: usize) -> usize {
    if (line_end >= len(text)) {
        ret line_end
    }

    let ch = byte_at(text, line_end)
    if (ch == 13) {
        if (line_end + 1_usize < len(text)) {
            if (byte_at(text, line_end + 1_usize) == 10) {
                ret line_end + 2_usize
            }
        }
        ret line_end + 1_usize
    }
    if (ch == 10) {
        ret line_end + 1_usize
    }
    ret line_end + 1_usize
}
