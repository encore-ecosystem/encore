import std::io::println
import std::os::argc
import std::os::argv
import std::os::file_exists
import std::os::write_file
import std::os::ensure_parent_dirs
import std::os::run_command
import std::string::len
import std::string::slice
import std::string::concat
import std::string::str_eq

pub fn run_init() -> u32 {
    let project_name = resolve_project_name()
    if (len(project_name) == 0_usize) {
        ret 1_u32
    }

    let manifest_status = write_file_if_missing("encore.toml", default_manifest(project_name))
    if (manifest_status != 0_u32) {
        println("init: unable to create encore.toml")
        ret 1_u32
    }

    let mkdir_status = ensure_parent_dirs("src/main.enq")
    if (mkdir_status != 0_i32) {
        println("init: unable to create src directory")
        ret 1_u32
    }

    let main_status = write_file_if_missing("src/main.enq", default_main_source())
    if (main_status != 0_u32) {
        println("init: unable to create src/main.enq")
        ret 1_u32
    }

    let readme_status = write_file_if_missing("README.md", "")
    if (readme_status != 0_u32) {
        println("init: unable to create README.md")
        ret 1_u32
    }

    let gitignore_status = write_file_if_missing(".gitignore", default_gitignore())
    if (gitignore_status != 0_u32) {
        println("init: unable to create .gitignore")
        ret 1_u32
    }

    if (not file_exists(".git")) {
        let git_status: i32 = run_command("git init")
        if (git_status != 0_i32) {
            println("init: git init failed")
            ret 1_u32
        }
    }

    println(concat("init: project ready (name=", concat(project_name, ")")))
    ret 0_u32
}

fn resolve_project_name() -> str {
    if (argc() <= 2_usize) {
        ret "encore"
    }

    let arg = argv(2_usize)
    if (str_eq(arg, "--name")) {
        if (argc() <= 3_usize) {
            println("init: expected value after --name")
            ret ""
        }
        ret argv(3_usize)
    }

    if (starts_with(arg, "--name=")) {
        ret slice(arg, 7_usize, len(arg) - 7_usize)
    }

    println(concat("init: unknown argument: ", arg))
    println("init: usage: encore init [--name <project_name>]")
    ret ""
}

fn write_file_if_missing(path: str, contents: str) -> u32 {
    if (file_exists(path)) {
        ret 0_u32
    }

    let status: i32 = write_file(path, contents)
    if (status != 0_i32) {
        ret 1_u32
    }
    ret 0_u32
}

fn default_manifest(project_name: str) -> str {
    let header = "[project]\n"
    let name_line = concat(concat("name = \"", project_name), "\"\n")
    let target_line = "target = \"auto\"\n"
    let version_line = "version = \"0.1.0\"\n"
    let description_line = "description = \"\"\n"
    let readme_line = "readme = \"README.md\"\n"
    let dependencies_lines = "dependencies = [\n    \"git@https://github.com/encore-language/std\"\n]\n"

    ret concat(
        header,
        concat(
            name_line,
            concat(
                target_line,
                concat(
                    version_line,
                    concat(
                        description_line,
                        concat(
                            readme_line,
                            dependencies_lines
                        )
                    )
                )
            )
        )
    )
}

fn default_main_source() -> str {
    ret "fn main() -> u32 {\n    ret 0_u32\n}\n"
}

fn default_gitignore() -> str {
    ret ".ehir\ntarget\n"
}

fn starts_with(value: str, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (prefix_len > len(value)) {
        ret false
    }
    ret str_eq(slice(value, 0_usize, prefix_len), prefix)
}
