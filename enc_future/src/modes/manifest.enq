import std::string::len
import std::string::byte_at
import std::string::slice
import std::string::str_eq
import std::string::concat
import std::os::file_exists
import std::os::read_file

pub struct BuildSettings {
    project_name: str
    target: str
    backend: str
    profile: str
    dependency_roots_outline: str
    dependency_paths_outline: str
}

struct MaybeString {
    found: bool
    value: str
}

struct DependencyScan {
    roots_outline: str
    paths_outline: str
    visited_manifests: str
}

pub fn load_build_settings(path: str) -> BuildSettings {
    let contents = read_file(path)
    let project_name = find_last_string_value_or(contents, "name", "encore")
    let target_raw = find_last_string_value_or(contents, "target", "auto")
    let backend_raw = find_last_string_value_or(contents, "backend", "llvm")
    let profile_raw = find_last_string_value_or(contents, "profile", "debug")
    let dependency_scan = collect_dependency_scan_from_manifest(path, "", "", "")
    let dependency_roots_outline = dependency_scan.roots_outline
    let dependency_paths_outline = dependency_scan.paths_outline

    let target = normalize_target(target_raw)
    let backend = normalize_backend(backend_raw)
    let profile = normalize_profile(profile_raw)
    ret BuildSettings{project_name, target, backend, profile, dependency_roots_outline, dependency_paths_outline}
}

fn collect_dependency_scan_from_manifest(
    manifest_path: str,
    roots_outline: str,
    paths_outline: str,
    visited_manifests: str
) -> DependencyScan {
    if (contains_line(visited_manifests, manifest_path)) {
        ret DependencyScan{roots_outline, paths_outline, visited_manifests}
    }
    if (not file_exists(manifest_path)) {
        ret DependencyScan{roots_outline, paths_outline, append_unique_line(visited_manifests, manifest_path)}
    }

    let contents = read_file(manifest_path)
    let deps = parse_dependency_entries_outline(contents)
    let base_dir = dirname(manifest_path)
    let next_visited = append_unique_line(visited_manifests, manifest_path)
    ret collect_dependency_scan_entries(
        deps, base_dir, roots_outline, paths_outline, next_visited, 0_usize
    )
}

fn collect_dependency_scan_entries(
    deps_outline: str,
    base_dir: str,
    roots_outline: str,
    paths_outline: str,
    visited_manifests: str,
    index: usize
) -> DependencyScan {
    if (index >= len(deps_outline)) {
        ret DependencyScan{roots_outline, paths_outline, visited_manifests}
    }

    let line_end = find_line_end(deps_outline, index)
    let dep = slice(deps_outline, index, line_end - index)
    let next_index = next_line_index(deps_outline, line_end)
    if (len(dep) == 0_usize) {
        ret collect_dependency_scan_entries(
            deps_outline, base_dir, roots_outline, paths_outline, visited_manifests, next_index
        )
    }

    if (starts_with(dep, "path@")) {
        let rel_path = slice(dep, 5_usize, len(dep) - 5_usize)
        let dep_path = resolve_relative_path(base_dir, rel_path)
        let root = basename(dep_path)
        let next_roots = append_unique_line(roots_outline, root)
        let next_paths = if (len(root) == 0_usize) {
            paths_outline
        } else {
            append_unique_line(paths_outline, concat(concat(root, "="), dep_path))
        }

        let dep_manifest = concat(dep_path, "/encore.toml")
        let nested = collect_dependency_scan_from_manifest(dep_manifest, next_roots, next_paths, visited_manifests)
        ret collect_dependency_scan_entries(
            deps_outline,
            base_dir,
            nested.roots_outline,
            nested.paths_outline,
            nested.visited_manifests,
            next_index
        )
    }

    if (starts_with(dep, "git@")) {
        let root = dependency_root(dep)
        let next_roots = append_unique_line(roots_outline, root)
        ret collect_dependency_scan_entries(
            deps_outline, base_dir, next_roots, paths_outline, visited_manifests, next_index
        )
    }

    ret collect_dependency_scan_entries(
        deps_outline, base_dir, roots_outline, paths_outline, visited_manifests, next_index
    )
}

fn parse_dependency_entries_outline(contents: str) -> str {
    let key_start = find_substring(contents, "dependencies", 0_usize)
    if (key_start >= len(contents)) {
        ret ""
    }

    let list_start = find_char(contents, 91, key_start)
    if (list_start >= len(contents)) {
        ret ""
    }

    let list_end = find_char(contents, 93, list_start + 1_usize)
    if (list_end >= len(contents)) {
        ret ""
    }

    ret parse_dependency_entry_values(contents, list_start + 1_usize, list_end, "")
}

fn parse_dependency_entry_values(contents: str, index: usize, list_end: usize, acc: str) -> str {
    if (index >= list_end) {
        ret acc
    }

    let quote = find_char(contents, 34, index)
    if (quote >= list_end) {
        ret acc
    }
    let close_quote = find_char(contents, 34, quote + 1_usize)
    if (close_quote >= list_end) {
        ret acc
    }

    let raw_dep = slice(contents, quote + 1_usize, close_quote - quote - 1_usize)
    let next_acc = append_lines(acc, raw_dep)
    ret parse_dependency_entry_values(contents, close_quote + 1_usize, list_end, next_acc)
}

fn parse_dependency_roots_outline(contents: str) -> str {
    let key_start = find_substring(contents, "dependencies", 0_usize)
    if (key_start >= len(contents)) {
        ret ""
    }

    let list_start = find_char(contents, 91, key_start)
    if (list_start >= len(contents)) {
        ret ""
    }

    let list_end = find_char(contents, 93, list_start + 1_usize)
    if (list_end >= len(contents)) {
        ret ""
    }

    ret parse_dependency_values(contents, list_start + 1_usize, list_end, "")
}

fn parse_dependency_values(contents: str, index: usize, list_end: usize, acc: str) -> str {
    if (index >= list_end) {
        ret acc
    }

    let quote = find_char(contents, 34, index)
    if (quote >= list_end) {
        ret acc
    }
    let close_quote = find_char(contents, 34, quote + 1_usize)
    if (close_quote >= list_end) {
        ret acc
    }

    let raw_dep = slice(contents, quote + 1_usize, close_quote - quote - 1_usize)
    let root = dependency_root(raw_dep)
    let next_acc = if (len(root) == 0_usize) {
        acc
    } else {
        append_lines(acc, root)
    }
    ret parse_dependency_values(contents, close_quote + 1_usize, list_end, next_acc)
}

fn parse_dependency_paths_outline(contents: str) -> str {
    let key_start = find_substring(contents, "dependencies", 0_usize)
    if (key_start >= len(contents)) {
        ret ""
    }

    let list_start = find_char(contents, 91, key_start)
    if (list_start >= len(contents)) {
        ret ""
    }

    let list_end = find_char(contents, 93, list_start + 1_usize)
    if (list_end >= len(contents)) {
        ret ""
    }

    ret parse_dependency_path_values(contents, list_start + 1_usize, list_end, "")
}

fn parse_dependency_path_values(contents: str, index: usize, list_end: usize, acc: str) -> str {
    if (index >= list_end) {
        ret acc
    }

    let quote = find_char(contents, 34, index)
    if (quote >= list_end) {
        ret acc
    }
    let close_quote = find_char(contents, 34, quote + 1_usize)
    if (close_quote >= list_end) {
        ret acc
    }

    let raw_dep = slice(contents, quote + 1_usize, close_quote - quote - 1_usize)
    let pair = dependency_root_path_pair(raw_dep)
    let next_acc = if (len(pair) == 0_usize) {
        acc
    } else {
        append_lines(acc, pair)
    }
    ret parse_dependency_path_values(contents, close_quote + 1_usize, list_end, next_acc)
}

fn dependency_root(raw_dep: str) -> str {
    if (starts_with(raw_dep, "path@")) {
        let path = slice(raw_dep, 5_usize, len(raw_dep) - 5_usize)
        ret basename(path)
    }
    if (starts_with(raw_dep, "git@")) {
        let url = slice(raw_dep, 4_usize, len(raw_dep) - 4_usize)
        let base = basename(url)
        ret strip_suffix(base, ".git")
    }
    ret ""
}

fn dependency_root_path_pair(raw_dep: str) -> str {
    if (starts_with(raw_dep, "path@")) {
        let path = slice(raw_dep, 5_usize, len(raw_dep) - 5_usize)
        let root = basename(path)
        if (len(root) == 0_usize) {
            ret ""
        }
        ret concat(concat(root, "="), path)
    }
    ret ""
}

fn basename(path: str) -> str {
    if (len(path) == 0_usize) {
        ret ""
    }
    let slash = find_last_char(path, 47, len(path))
    if (slash >= 1000000_usize) {
        ret path
    }
    let start = slash + 1_usize
    if (start >= len(path)) {
        ret ""
    }
    ret slice(path, start, len(path) - start)
}

fn dirname(path: str) -> str {
    if (len(path) == 0_usize) {
        ret "."
    }
    let slash = find_last_char(path, 47, len(path))
    if (slash >= 1000000_usize) {
        ret "."
    }
    if (slash == 0_usize) {
        ret "/"
    }
    ret slice(path, 0_usize, slash)
}

fn resolve_relative_path(base_dir: str, path: str) -> str {
    if (starts_with(path, "/")) {
        ret path
    }
    if (starts_with(path, "./")) {
        let rest = slice(path, 2_usize, len(path) - 2_usize)
        ret join_path(base_dir, rest)
    }
    ret join_path(base_dir, path)
}

fn join_path(base: str, child: str) -> str {
    if (len(base) == 0_usize) {
        ret child
    }
    if (str_eq(base, ".")) {
        ret child
    }
    if (len(child) == 0_usize) {
        ret base
    }
    if (byte_at(base, len(base) - 1_usize) == 47) {
        ret concat(base, child)
    }
    ret concat(concat(base, "/"), child)
}

fn strip_suffix(value: str, suffix: str) -> str {
    let value_len = len(value)
    let suffix_len = len(suffix)
    if (suffix_len > value_len) {
        ret value
    }
    let start = value_len - suffix_len
    if (str_eq(slice(value, start, suffix_len), suffix)) {
        ret slice(value, 0_usize, start)
    }
    ret value
}

fn find_substring(text: str, pattern: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret len(text)
    }
    if (starts_with_at(text, index, pattern)) {
        ret index
    }
    ret find_substring(text, pattern, index + 1_usize)
}

fn find_char(text: str, code: u8, index: usize) -> usize {
    if (index >= len(text)) {
        ret len(text)
    }
    if (byte_at(text, index) == code) {
        ret index
    }
    ret find_char(text, code, index + 1_usize)
}

fn find_last_char(text: str, code: u8, index: usize) -> usize {
    if (index == 0_usize) {
        ret 1000000_usize
    }
    let i = index - 1_usize
    if (byte_at(text, i) == code) {
        ret i
    }
    ret find_last_char(text, code, i)
}

fn starts_with(value: str, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (prefix_len > len(value)) {
        ret false
    }
    ret str_eq(slice(value, 0_usize, prefix_len), prefix)
}

fn starts_with_at(text: str, index: usize, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (index + prefix_len > len(text)) {
        ret false
    }
    ret str_eq(slice(text, index, prefix_len), prefix)
}

fn append_lines(lhs: str, rhs: str) -> str {
    if (len(lhs) == 0_usize) {
        ret rhs
    }
    if (len(rhs) == 0_usize) {
        ret lhs
    }
    ret concat(concat(lhs, "\n"), rhs)
}

fn append_unique_line(lines: str, line: str) -> str {
    if (len(line) == 0_usize) {
        ret lines
    }
    if (contains_line(lines, line)) {
        ret lines
    }
    ret append_lines(lines, line)
}

fn contains_line(lines: str, target: str) -> bool {
    ret contains_line_from(lines, target, 0_usize)
}

fn contains_line_from(lines: str, target: str, index: usize) -> bool {
    if (index >= len(lines)) {
        ret false
    }
    let line_end = find_line_end(lines, index)
    let line = slice(lines, index, line_end - index)
    if (str_eq(line, target)) {
        ret true
    }
    ret contains_line_from(lines, target, next_line_index(lines, line_end))
}

fn normalize_target(raw: str) -> str {
    if (str_eq(raw, "auto")) { ret "auto" }
    if (str_eq(raw, "executable")) { ret "executable" }
    if (str_eq(raw, "static_lib")) { ret "static_lib" }
    if (str_eq(raw, "object")) { ret "object" }
    if (str_eq(raw, "dynamic_lib")) { ret "dynamic_lib" }
    ret "auto"
}

fn normalize_backend(raw: str) -> str {
    if (str_eq(raw, "llvm")) { ret "llvm" }
    ret "llvm"
}

fn normalize_profile(raw: str) -> str {
    if (str_eq(raw, "debug")) { ret "debug" }
    if (str_eq(raw, "release")) { ret "release" }
    if (str_eq(raw, "extreme")) { ret "extreme" }
    ret "debug"
}

fn find_last_string_value_or(contents: str, key: str, default_value: str) -> str {
    ret find_last_string_value_or_from(contents, key, 0, default_value)
}

fn find_last_string_value_or_from(contents: str, key: str, index: usize, current: str) -> str {
    if (index >= len(contents)) {
        ret current
    }

    let line_end = find_line_end(contents, index)
    let line = slice(contents, index, line_end - index)
    let parsed = parse_string_value_line(line, key)
    let next_current = if (parsed.found) {
        parsed.value
    } else {
        current
    }

    let next_index = next_line_index(contents, line_end)
    ret find_last_string_value_or_from(contents, key, next_index, next_current)
}

fn parse_string_value_line(line: str, key: str) -> MaybeString {
    let start = skip_spaces(line, 0)
    if (start >= len(line)) {
        ret none_string()
    }

    if (byte_at(line, start) == 35) {
        ret none_string()
    }

    if (not starts_with_at(line, start, key)) {
        ret none_string()
    }

    let after_key = skip_spaces(line, start + len(key))
    if (after_key >= len(line)) {
        ret none_string()
    }
    if (byte_at(line, after_key) != 61) {
        ret none_string()
    }

    let after_equal = skip_spaces(line, after_key + 1)
    ret parse_quoted_value(line, after_equal)
}

fn parse_quoted_value(line: str, index: usize) -> MaybeString {
    if (index >= len(line)) {
        ret none_string()
    }
    if (byte_at(line, index) != 34) {
        ret none_string()
    }

    let close_quote = find_quote_end(line, index + 1)
    if (close_quote >= len(line)) {
        ret none_string()
    }

    ret some_string(slice(line, index + 1, close_quote - index - 1))
}

fn starts_with_at(text: str, index: usize, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (index + prefix_len > len(text)) {
        ret false
    }
    ret str_eq(slice(text, index, prefix_len), prefix)
}

fn skip_spaces(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 32) {
        ret skip_spaces(text, index + 1)
    }
    if (ch == 9) {
        ret skip_spaces(text, index + 1)
    }
    ret index
}

fn find_line_end(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 10) {
        ret index
    }
    if (ch == 13) {
        ret index
    }
    ret find_line_end(text, index + 1)
}

fn next_line_index(text: str, line_end: usize) -> usize {
    if (line_end >= len(text)) {
        ret line_end
    }

    let ch = byte_at(text, line_end)
    if (ch == 13) {
        if (line_end + 1 < len(text)) {
            if (byte_at(text, line_end + 1) == 10) {
                ret line_end + 2
            }
        }
        ret line_end + 1
    }
    if (ch == 10) {
        ret line_end + 1
    }
    ret line_end + 1
}

fn find_quote_end(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 34) {
        ret index
    }
    ret find_quote_end(text, index + 1)
}

fn none_string() -> MaybeString {
    ret MaybeString{false, ""}
}

fn some_string(value: str) -> MaybeString {
    ret MaybeString{true, value}
}
