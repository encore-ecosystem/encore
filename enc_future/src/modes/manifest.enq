import std::string::len
import std::string::byte_at
import std::string::slice
import std::string::str_eq
import std::os::read_file

pub struct BuildSettings {
    project_name: str
    target: str
    backend: str
    profile: str
}

struct MaybeString {
    found: bool
    value: str
}

pub fn load_build_settings(path: str) -> BuildSettings {
    let contents = read_file(path)
    let project_name = find_last_string_value_or(contents, "name", "encore")
    let target_raw = find_last_string_value_or(contents, "target", "auto")
    let backend_raw = find_last_string_value_or(contents, "backend", "llvm")
    let profile_raw = find_last_string_value_or(contents, "profile", "debug")

    let target = normalize_target(target_raw)
    let backend = normalize_backend(backend_raw)
    let profile = normalize_profile(profile_raw)
    ret BuildSettings{project_name, target, backend, profile}
}

fn normalize_target(raw: str) -> str {
    if (str_eq(raw, "auto")) { ret "auto" }
    if (str_eq(raw, "executable")) { ret "executable" }
    if (str_eq(raw, "static_lib")) { ret "static_lib" }
    if (str_eq(raw, "object")) { ret "object" }
    if (str_eq(raw, "dynamic_lib")) { ret "dynamic_lib" }
    ret "auto"
}

fn normalize_backend(raw: str) -> str {
    if (str_eq(raw, "llvm")) { ret "llvm" }
    ret "llvm"
}

fn normalize_profile(raw: str) -> str {
    if (str_eq(raw, "debug")) { ret "debug" }
    if (str_eq(raw, "release")) { ret "release" }
    if (str_eq(raw, "extreme")) { ret "extreme" }
    ret "debug"
}

fn find_last_string_value_or(contents: str, key: str, default_value: str) -> str {
    ret find_last_string_value_or_from(contents, key, 0, default_value)
}

fn find_last_string_value_or_from(contents: str, key: str, index: usize, current: str) -> str {
    if (index >= len(contents)) {
        ret current
    }

    let line_end = find_line_end(contents, index)
    let line = slice(contents, index, line_end - index)
    let parsed = parse_string_value_line(line, key)
    let next_current = if (parsed.found) {
        parsed.value
    } else {
        current
    }

    let next_index = next_line_index(contents, line_end)
    ret find_last_string_value_or_from(contents, key, next_index, next_current)
}

fn parse_string_value_line(line: str, key: str) -> MaybeString {
    let start = skip_spaces(line, 0)
    if (start >= len(line)) {
        ret none_string()
    }

    if (byte_at(line, start) == 35) {
        ret none_string()
    }

    if (not starts_with_at(line, start, key)) {
        ret none_string()
    }

    let after_key = skip_spaces(line, start + len(key))
    if (after_key >= len(line)) {
        ret none_string()
    }
    if (byte_at(line, after_key) != 61) {
        ret none_string()
    }

    let after_equal = skip_spaces(line, after_key + 1)
    ret parse_quoted_value(line, after_equal)
}

fn parse_quoted_value(line: str, index: usize) -> MaybeString {
    if (index >= len(line)) {
        ret none_string()
    }
    if (byte_at(line, index) != 34) {
        ret none_string()
    }

    let close_quote = find_quote_end(line, index + 1)
    if (close_quote >= len(line)) {
        ret none_string()
    }

    ret some_string(slice(line, index + 1, close_quote - index - 1))
}

fn starts_with_at(text: str, index: usize, prefix: str) -> bool {
    let prefix_len = len(prefix)
    if (index + prefix_len > len(text)) {
        ret false
    }
    ret str_eq(slice(text, index, prefix_len), prefix)
}

fn skip_spaces(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 32) {
        ret skip_spaces(text, index + 1)
    }
    if (ch == 9) {
        ret skip_spaces(text, index + 1)
    }
    ret index
}

fn find_line_end(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 10) {
        ret index
    }
    if (ch == 13) {
        ret index
    }
    ret find_line_end(text, index + 1)
}

fn next_line_index(text: str, line_end: usize) -> usize {
    if (line_end >= len(text)) {
        ret line_end
    }

    let ch = byte_at(text, line_end)
    if (ch == 13) {
        if (line_end + 1 < len(text)) {
            if (byte_at(text, line_end + 1) == 10) {
                ret line_end + 2
            }
        }
        ret line_end + 1
    }
    if (ch == 10) {
        ret line_end + 1
    }
    ret line_end + 1
}

fn find_quote_end(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 34) {
        ret index
    }
    ret find_quote_end(text, index + 1)
}

fn none_string() -> MaybeString {
    ret MaybeString{false, ""}
}

fn some_string(value: str) -> MaybeString {
    ret MaybeString{true, value}
}
