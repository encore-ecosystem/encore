import std::io::println
import std::option::Option
import std::os::read_file
import std::string::len
import std::string::slice
import std::string::byte_at
import std::string::concat
import std::string::str_eq
import std::vec::Vec
import toml::toml_get_string_array
import toml::toml_parse_document
import toml::TomlDocument
import repo::frontend::import_graph::build_import_graph
import repo::frontend::import_graph::ImportGraphResult

pub fn run_build() -> u32 {
    let manifest_source: str = read_file("encore.toml")
    let manifest: TomlDocument = toml_parse_document(manifest_source)
    let dependency_paths: str = collect_dependency_paths_outline(manifest)
    let dependency_roots: str = collect_dependency_roots_outline(dependency_paths)
    let bindings: str = collect_module_bindings("src/main.enq")
    let graph: ImportGraphResult = build_import_graph(
        "src/main.enq", bindings, dependency_roots, dependency_paths
    )

    println("Import graph:")
    println(graph.outline)

    if graph.unresolved > 0_usize {
        println("Unresolved imports:")
        println(graph.unresolved_outline)
        ret 1_u32
    }

    println("Build graph ok")
    ret 0_u32
}

fn collect_dependency_paths_outline(manifest: TomlDocument) -> str {
    ret match toml_get_string_array(manifest, "project", "dependencies") {
        Some(deps) => {
            collect_dependency_paths_from_vec(deps, 0_usize, "")
        }
        None => {
            ""
        }
    }
}

fn collect_dependency_paths_from_vec(deps: Vec[str], index: usize, acc: str) -> str {
    ret match deps.get(index) {
        Some(dep) => {
            let next_acc = append_line_if_present(acc, dependency_outline_line(dep))
            collect_dependency_paths_from_vec(deps, index + 1_usize, next_acc)
        }
        None => {
            acc
        }
    }
}

fn dependency_outline_line(dep: str) -> str {
    if (not starts_with(dep, "path@")) {
        ret ""
    }

    let raw_path = slice(dep, 5_usize, len(dep) - 5_usize)
    let root = path_basename(raw_path)
    if (len(root) == 0_usize) {
        ret ""
    }

    ret concat(concat(root, "="), raw_path)
}

fn collect_dependency_roots_outline(paths_outline: str) -> str {
    ret collect_dependency_roots_from_outline(paths_outline, 0_usize, "")
}

fn collect_dependency_roots_from_outline(paths_outline: str, index: usize, acc: str) -> str {
    if (index >= len(paths_outline)) {
        ret acc
    }

    let line_end = find_line_end(paths_outline, index)
    let line = slice(paths_outline, index, line_end - index)
    let next_index = next_line_index(paths_outline, line_end)

    if (len(line) == 0_usize) {
        ret collect_dependency_roots_from_outline(paths_outline, next_index, acc)
    }

    let eq = find_char(line, 61_u8, 0_usize)
    if (eq >= len(line)) {
        ret collect_dependency_roots_from_outline(paths_outline, next_index, acc)
    }

    let root = slice(line, 0_usize, eq)
    ret collect_dependency_roots_from_outline(paths_outline, next_index, append_line_if_present(acc, root))
}

fn collect_module_bindings(module_path: str) -> str {
    let source = read_file(module_path)
    ret collect_import_bindings_from_source(source, 0_usize, "")
}

fn collect_import_bindings_from_source(source: str, index: usize, acc: str) -> str {
    if (index >= len(source)) {
        ret acc
    }

    let line_end = find_line_end(source, index)
    let line = trim(slice(source, index, line_end - index))
    let next_index = next_line_index(source, line_end)

    if (starts_with(line, "import ")) {
        let binding = trim(slice(line, 7_usize, len(line) - 7_usize))
        ret collect_import_bindings_from_source(source, next_index, append_line_if_present(acc, binding))
    }

    if (starts_with(line, "cimport ")) {
        let binding = trim(slice(line, 8_usize, len(line) - 8_usize))
        ret collect_import_bindings_from_source(source, next_index, append_line_if_present(acc, binding))
    }

    ret collect_import_bindings_from_source(source, next_index, acc)
}

fn path_basename(value: str) -> str {
    let end = trim_trailing_slashes(value, len(value))
    if (end == 0_usize) {
        ret ""
    }

    ret match last_slash_index(value, end) {
        Some(index) => slice(value, index + 1_usize, end - index - 1_usize)
        None => slice(value, 0_usize, end)
    }
}

fn trim(value: str) -> str {
    let start = trim_start(value, 0_usize)
    if (start >= len(value)) {
        ret ""
    }

    let end = trim_end(value, len(value))
    if (end <= start) {
        ret ""
    }

    ret slice(value, start, end - start)
}

fn trim_start(value: str, index: usize) -> usize {
    if (index >= len(value)) {
        ret index
    }

    let ch = byte_at(value, index)
    if (ch == 32_u8 || ch == 9_u8) {
        ret trim_start(value, index + 1_usize)
    }
    ret index
}

fn trim_end(value: str, end: usize) -> usize {
    if (end == 0_usize) {
        ret 0_usize
    }

    let index = end - 1_usize
    let ch = byte_at(value, index)
    if (ch == 32_u8 || ch == 9_u8) {
        ret trim_end(value, index)
    }
    ret end
}

fn trim_trailing_slashes(value: str, end: usize) -> usize {
    if (end == 0_usize) {
        ret 0_usize
    }

    let index = end - 1_usize
    let ch = byte_at(value, index)
    if (ch == 47_u8 || ch == 92_u8) {
        ret trim_trailing_slashes(value, index)
    }
    ret end
}

fn last_slash_index(value: str, end: usize) -> Option[usize] {
    if (end == 0_usize) {
        ret Option[usize]::None
    }

    let index = end - 1_usize
    let ch = byte_at(value, index)
    if (ch == 47_u8 || ch == 92_u8) {
        ret Option[usize]::Some(index)
    }
    ret last_slash_index(value, index)
}

fn starts_with(value: str, prefix: str) -> bool {
    if (len(prefix) > len(value)) {
        ret false
    }
    ret str_eq(slice(value, 0_usize, len(prefix)), prefix)
}

fn append_line_if_present(lhs: str, rhs: str) -> str {
    if (len(rhs) == 0_usize) {
        ret lhs
    }
    if (len(lhs) == 0_usize) {
        ret rhs
    }
    ret concat(concat(lhs, "\n"), rhs)
}

fn find_line_end(text: str, index: usize) -> usize {
    if (index >= len(text)) {
        ret index
    }

    let ch = byte_at(text, index)
    if (ch == 10_u8 || ch == 13_u8) {
        ret index
    }
    ret find_line_end(text, index + 1_usize)
}

fn next_line_index(text: str, line_end: usize) -> usize {
    if (line_end >= len(text)) {
        ret line_end
    }

    let ch = byte_at(text, line_end)
    if (ch == 13_u8) {
        let next = line_end + 1_usize
        if (next < len(text)) {
            if (byte_at(text, next) == 10_u8) {
                ret next + 1_usize
            }
        }
        ret next
    }

    if (ch == 10_u8) {
        ret line_end + 1_usize
    }

    ret line_end + 1_usize
}

fn find_char(value: str, target: u8, index: usize) -> usize {
    if (index >= len(value)) {
        ret len(value)
    }

    if (byte_at(value, index) == target) {
        ret index
    }
    ret find_char(value, target, index + 1_usize)
}
