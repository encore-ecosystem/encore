import std::io::println
import std::option::Option
import std::os::read_file
import std::string::len
import std::string::slice
import std::string::byte_at
import std::string::concat
import std::string::str_eq
import std::vec::Vec
import toml::toml_get_string_array
import toml::toml_parse_document
import toml::TomlDocument

import std::path::Path
import std::os::read_file
import refrain::frontend::lexer::Lexer
import refrain::frontend::parser::Parser
// import std::fmt::Debug

pub fn run_build() -> u32 {
    let cwd = Path::cwd()
    let manifest_path = cwd / "encore.toml"

    if !manifest_path.exists() {
        println("Unable to find manifest file!")
        ret 1
    }

    let manifest: TomlDocument = toml_parse_document(
        read_file(
            manifest_path.as_str()
        )
    )

    let program_path = cwd / "src" / "main.enq"
    let program_source = read_file(program_path.as_str())

    let mut lexer = Lexer::new()
    let tokens = lexer.tokenize(program_source)
    // println(Debug::fmt(tokens))

    let mut parser = Parser::new()
    let ast = parser.parse(tokens)
    // let n = ast.len()
    // println(Debug::fmt(n))

    ret 0_u32
}
