extern fn __ehir_rt_time_time() -> f64
extern fn __ehir_rt_time_perf_counter() -> f64
extern fn __ehir_rt_time_perf_counter_ms() -> u64
extern fn __ehir_rt_time_sleep_ms(ms: u64) -> bool

pub fn time() -> f64 {
    unsafe {
        ret __ehir_rt_time_time()
    }
}

pub fn perf_counter() -> f64 {
    unsafe {
        ret __ehir_rt_time_perf_counter()
    }
}

pub fn sleep_ms(ms: u64) -> bool {
    unsafe {
        ret __ehir_rt_time_sleep_ms(ms)
    }
}

pub fn perf_counter_ms() -> u64 {
    unsafe {
        ret __ehir_rt_time_perf_counter_ms()
    }
}
