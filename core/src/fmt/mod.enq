pub trait Debug {
    fn fmt(self) -> str
}

extern fn __ehir_rt_fmt_u64(value: u64) -> str
extern fn __ehir_rt_fmt_i64(value: i64) -> str
extern fn __ehir_rt_fmt_f64(value: f64) -> str

impl Debug for str {
    pub fn fmt(self: str) -> str {
        ret self
    }
}

impl Debug for bool {
    pub fn fmt(self: bool) -> str {
        if self {
            ret "true"
        }
        ret "false"
    }
}

impl Debug for u8 {
    pub fn fmt(self: u8) -> str {
        unsafe {
            ret __ehir_rt_fmt_u64(self)
        }
    }
}

impl Debug for u16 {
    pub fn fmt(self: u16) -> str {
        unsafe {
            ret __ehir_rt_fmt_u64(self)
        }
    }
}

impl Debug for u32 {
    pub fn fmt(self: u32) -> str {
        unsafe {
            ret __ehir_rt_fmt_u64(self)
        }
    }
}

impl Debug for u64 {
    pub fn fmt(self: u64) -> str {
        unsafe {
            ret __ehir_rt_fmt_u64(self)
        }
    }
}

impl Debug for usize {
    pub fn fmt(self: usize) -> str {
        unsafe {
            ret __ehir_rt_fmt_u64(self)
        }
    }
}

impl Debug for i8 {
    pub fn fmt(self: i8) -> str {
        unsafe {
            ret __ehir_rt_fmt_i64(self)
        }
    }
}

impl Debug for i16 {
    pub fn fmt(self: i16) -> str {
        unsafe {
            ret __ehir_rt_fmt_i64(self)
        }
    }
}

impl Debug for i32 {
    pub fn fmt(self: i32) -> str {
        unsafe {
            ret __ehir_rt_fmt_i64(self)
        }
    }
}

impl Debug for i64 {
    pub fn fmt(self: i64) -> str {
        unsafe {
            ret __ehir_rt_fmt_i64(self)
        }
    }
}

impl Debug for isize {
    pub fn fmt(self: isize) -> str {
        unsafe {
            ret __ehir_rt_fmt_i64(self)
        }
    }
}

impl Debug for f32 {
    pub fn fmt(self: f32) -> str {
        unsafe {
            ret __ehir_rt_fmt_f64(self)
        }
    }
}

impl Debug for f64 {
    pub fn fmt(self: f64) -> str {
        unsafe {
            ret __ehir_rt_fmt_f64(self)
        }
    }
}
