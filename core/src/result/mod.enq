import core::fmt::Debug


pub enum Result[T, E] {
    Ok(T)
    Err(E)
}

impl[T, E] for Result[T, E] {
    pub fn is_ok(self: Result[T, E]) -> bool {
        ret is_ok[T, E](self)
    }

    pub fn is_err(self: Result[T, E]) -> bool {
        ret is_err[T, E](self)
    }

    pub fn unwrap_or(self: Result[T, E], default: T) -> T {
        ret unwrap_or[T, E](self, default)
    }

    pub fn unwrap_err_or(self: Result[T, E], default: E) -> E {
        ret unwrap_err_or[T, E](self, default)
    }
}

pub fn is_ok[T, E](res: Result[T, E]) -> bool {
    ret match res {
        Ok(value) => true
        Err(err) => false
    }
}

pub fn is_err[T, E](res: Result[T, E]) -> bool {
    ret match res {
        Ok(value) => false
        Err(err) => true
    }
}

pub fn unwrap_or[T, E](res: Result[T, E], default: T) -> T {
    ret match res {
        Ok(value) => value
        Err(err) => default
    }
}

pub fn unwrap_err_or[T, E](res: Result[T, E], default: E) -> E {
    ret match res {
        Ok(value) => default
        Err(err) => err
    }
}

impl[T:Debug, E:Debug] Debug for Result[T, E] {
    pub fn fmt(self: Result[T, E]) -> str {
        ret match self {
            Ok(value) => "Ok(" + Debug::fmt(value) + ")"
            Err(err) => "Err(" + Debug::fmt(err) + ")"
        }
    }
}
