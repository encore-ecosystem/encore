extern fn __ehir_rt_io_write(fd: i32, value: str) -> i32

pub fn print(value: str) -> i32 {
    unsafe {
        ret __ehir_rt_io_write(1_i32, value)
    }
}

pub fn println(value: str) -> i32 {
    ret print(value + "\n")
}

pub fn eprint(value: str) -> i32 {
    unsafe {
        ret __ehir_rt_io_write(2_i32, value)
    }
}

pub fn eprintln(value: str) -> i32 {
    ret eprint(value + "\n")
}
