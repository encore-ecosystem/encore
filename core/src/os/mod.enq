import core::option::Option
import core::vec::Vec

extern fn __ehir_rt_os_argc() -> usize
extern fn __ehir_rt_os_argv(index: usize) -> str
extern fn __ehir_rt_os_cwd() -> str

extern fn __ehir_rt_fs_read_file(path: str) -> str
extern fn __ehir_rt_fs_write_file(path: str, contents: str) -> i32
extern fn __ehir_rt_fs_status(path: str) -> i32
extern fn __ehir_rt_fs_remove_file(path: str) -> i32
extern fn __ehir_rt_fs_mkdir(path: str) -> i32
extern fn __ehir_rt_fs_read_dir(path: str) -> str

pub fn argc() -> usize {
    unsafe {
        ret __ehir_rt_os_argc()
    }
}

pub fn argv(index: usize) -> Option[str] {
    if index >= argc() {
        ret Option[str]::None
    }

    unsafe {
        ret Option[str]::Some(__ehir_rt_os_argv(index))
    }
}

pub fn args() -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize
    loop {
        match argv(index) {
            Option[str]::Some(value) => {
                out = out.push(value)
                index = index + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }
    ret out
}

pub fn cwd() -> str {
    unsafe {
        ret __ehir_rt_os_cwd()
    }
}

pub fn read_file(path: str) -> str {
    unsafe {
        ret __ehir_rt_fs_read_file(path)
    }
}

pub fn write_file(path: str, contents: str) -> i32 {
    unsafe {
        ret __ehir_rt_fs_write_file(path, contents)
    }
}

pub fn file_exists(path: str) -> bool {
    unsafe {
        ret __ehir_rt_fs_status(path) == 0_i32
    }
}

pub fn remove_file(path: str) -> i32 {
    unsafe {
        ret __ehir_rt_fs_remove_file(path)
    }
}

pub fn mkdir(path: str) -> i32 {
    unsafe {
        ret __ehir_rt_fs_mkdir(path)
    }
}

pub fn read_dir(path: str) -> Vec[str] {
    let raw = unsafe {
        __ehir_rt_fs_read_dir(path)
    }
    ret split_lines(raw)
}

fn split_lines(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let total = value.len()
    if total == 0_usize {
        ret out
    }

    let mut start = 0_usize
    let mut index = 0_usize
    loop {
        if index >= total {
            break
        }

        match value.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    if index > start {
                        out = out.push(value.slice(start, index - start))
                    }
                    start = index + 1_usize
                }
            }
            Option[str]::None => {
                break
            }
        }
        index = index + 1_usize
    }

    if start < total {
        out = out.push(value.slice(start, total - start))
    }

    ret out
}
