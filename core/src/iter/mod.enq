import core::option::Option

pub trait Iterator[T] {
    fn next(self: Self) -> (Self, Option[T])
}

pub trait IntoIterator[T, Iter] {
    fn into_iter(self: Self) -> Iter
}

pub struct Range {
    current: usize
    end: usize
    inclusive: bool
    done: bool
}

impl Iterator[usize] for Range {
    pub fn next(self: Range) -> (Range, Option[usize]) {
        if self.done {
            ret (self, Option[usize]::None)
        }

        if self.inclusive {
            if self.current > self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        } else {
            if self.current >= self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        }

        let out = self.current
        ret (
            Range{self.current + 1_usize, self.end, self.inclusive, false},
            Option[usize]::Some(out),
        )
    }
}

impl for Range {
    pub fn iter(self: Range) -> Range {
        ret self
    }

    pub fn next(self: Range) -> (Range, Option[usize]) {
        if self.done {
            ret (self, Option[usize]::None)
        }

        if self.inclusive {
            if self.current > self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        } else {
            if self.current >= self.end {
                ret (Range{self.current, self.end, self.inclusive, true}, Option[usize]::None)
            }
        }

        let out = self.current
        ret (
            Range{self.current + 1_usize, self.end, self.inclusive, false},
            Option[usize]::Some(out),
        )
    }

    pub fn into_iter(self: Range) -> Range {
        ret self
    }
}

impl IntoIterator[usize, Range] for Range {
    pub fn into_iter(self: Range) -> Range {
        ret self
    }
}

pub fn range(start: usize, end: usize) -> Range {
    ret Range{start, end, false, false}
}

pub fn range_inclusive(start: usize, end: usize) -> Range {
    ret Range{start, end, true, false}
}
