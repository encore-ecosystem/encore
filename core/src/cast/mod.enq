pub trait Cast[T] {
    fn cast(self: Self) -> T
}

fn cast_u16_to_u32(value: u16) -> u32 {
    unsafe {
        unsafe ehir {
            out: u32 = pcast value: u16, u32
        }
        ret out
    }
}

fn cast_u16_to_usize(value: u16) -> usize {
    unsafe {
        unsafe ehir {
            out: usize = pcast value: u16, usize
        }
        ret out
    }
}

fn cast_u16_to_i32(value: u16) -> i32 {
    unsafe {
        unsafe ehir {
            out: i32 = pcast value: u16, i32
        }
        ret out
    }
}

fn cast_i32_to_u32(value: i32) -> u32 {
    unsafe {
        unsafe ehir {
            out: u32 = pcast value: i32, u32
        }
        ret out
    }
}

fn cast_i32_to_usize(value: i32) -> usize {
    unsafe {
        unsafe ehir {
            out: usize = pcast value: i32, usize
        }
        ret out
    }
}

fn cast_usize_to_i32(value: usize) -> i32 {
    unsafe {
        unsafe ehir {
            out: i32 = pcast value: usize, i32
        }
        ret out
    }
}

fn cast_usize_to_u32(value: usize) -> u32 {
    unsafe {
        unsafe ehir {
            out: u32 = pcast value: usize, u32
        }
        ret out
    }
}

fn cast_u32_to_usize(value: u32) -> usize {
    unsafe {
        unsafe ehir {
            out: usize = pcast value: u32, usize
        }
        ret out
    }
}

impl Cast[u16] for u16 {
    fn cast(self: u16) -> u16 {
        ret self
    }
}

impl Cast[u32] for u16 {
    fn cast(self: u16) -> u32 {
        ret cast_u16_to_u32(self)
    }
}

impl Cast[usize] for u16 {
    fn cast(self: u16) -> usize {
        ret cast_u16_to_usize(self)
    }
}

impl Cast[i32] for u16 {
    fn cast(self: u16) -> i32 {
        ret cast_u16_to_i32(self)
    }
}

impl Cast[u32] for i32 {
    fn cast(self: i32) -> u32 {
        ret cast_i32_to_u32(self)
    }
}

impl Cast[usize] for i32 {
    fn cast(self: i32) -> usize {
        ret cast_i32_to_usize(self)
    }
}

impl Cast[i32] for usize {
    fn cast(self: usize) -> i32 {
        ret cast_usize_to_i32(self)
    }
}

impl Cast[u32] for usize {
    fn cast(self: usize) -> u32 {
        ret cast_usize_to_u32(self)
    }
}

impl Cast[usize] for u32 {
    fn cast(self: u32) -> usize {
        ret cast_u32_to_usize(self)
    }
}
