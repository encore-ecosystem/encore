import core::fmt::Debug
import core::iter::IntoIterator
import core::iter::Iterator
import core::option::Option

struct VecStorage[T] {
    ref_count: usize
    ptr: T*
    len: usize
    cap: usize
}

pub struct Vec[T] {
    storage: VecStorage[T]*
}

pub struct VecIter[T] {
    vec: Vec[T]
    index: usize
}

#attr(safe)
fn __vec_null_ptr[T]() -> T* {
    unsafe {
        unsafe ehir {
            zero: usize = lcpos 0_usize
            ptr: T* = pcast zero: usize, T*
        }
        ret ptr
    }
}

#attr(safe)
fn __vec_realloc[T](ptr: T*, count: usize) -> T* {
    unsafe {
        unsafe ehir {
            next_ptr: T* = hrealloc ptr: T*, count: usize
        }
        ret next_ptr
    }
}

#attr(safe)
fn __vec_storage_new[T](cap: usize) -> VecStorage[T]* {
    unsafe {
        unsafe ehir {
            storage: VecStorage[T]* = halloc VecStorage[T]
            ref_ptr: usize* = getfieldptr storage: VecStorage[T]* > 0: usize
            ptr_ptr: T** = getfieldptr storage: VecStorage[T]* > 1: T*
            len_ptr: usize* = getfieldptr storage: VecStorage[T]* > 2: usize
            cap_ptr: usize* = getfieldptr storage: VecStorage[T]* > 3: usize
            one: usize = lcpos 1_usize
            zero: usize = lcpos 0_usize
            null_ptr: T* = pcast zero: usize, T*
            store one: usize, ref_ptr: usize*
            store null_ptr: T*, ptr_ptr: T**
            store zero: usize, len_ptr: usize*
            store zero: usize, cap_ptr: usize*
        }
        if cap > 0_usize {
            let ptr = __vec_realloc[T](__vec_null_ptr[T](), cap)
            __vec_set_ptr[T](storage, ptr)
            __vec_set_cap[T](storage, cap)
        }
        ret storage
    }
}

#attr(safe)
fn __vec_storage[T](vec: Vec[T]) -> VecStorage[T]* {
    unsafe {
        unsafe ehir {
            storage: VecStorage[T]* = getfield vec: Vec[T] > 0: VecStorage[T]*
        }
        ret storage
    }
}

#attr(safe)
fn __vec_ptr[T](storage: VecStorage[T]*) -> T* {
    unsafe {
        unsafe ehir {
            ptr_ptr: T** = getfieldptr storage: VecStorage[T]* > 1: T*
            ptr: T* = load ptr_ptr: T**
        }
        ret ptr
    }
}

#attr(safe)
fn __vec_len[T](storage: VecStorage[T]*) -> usize {
    unsafe {
        unsafe ehir {
            len_ptr: usize* = getfieldptr storage: VecStorage[T]* > 2: usize
            len: usize = load len_ptr: usize*
        }
        ret len
    }
}

#attr(safe)
fn __vec_cap[T](storage: VecStorage[T]*) -> usize {
    unsafe {
        unsafe ehir {
            cap_ptr: usize* = getfieldptr storage: VecStorage[T]* > 3: usize
            cap: usize = load cap_ptr: usize*
        }
        ret cap
    }
}

#attr(safe)
fn __vec_set_ptr[T](storage: VecStorage[T]*, ptr: T*) -> bool {
    unsafe {
        unsafe ehir {
            ptr_ptr: T** = getfieldptr storage: VecStorage[T]* > 1: T*
            store ptr: T*, ptr_ptr: T**
        }
        ret true
    }
}

#attr(safe)
fn __vec_set_len[T](storage: VecStorage[T]*, len: usize) -> bool {
    unsafe {
        unsafe ehir {
            len_ptr: usize* = getfieldptr storage: VecStorage[T]* > 2: usize
            store len: usize, len_ptr: usize*
        }
        ret true
    }
}

#attr(safe)
fn __vec_set_cap[T](storage: VecStorage[T]*, cap: usize) -> bool {
    unsafe {
        unsafe ehir {
            cap_ptr: usize* = getfieldptr storage: VecStorage[T]* > 3: usize
            store cap: usize, cap_ptr: usize*
        }
        ret true
    }
}

#attr(safe)
fn __vec_load[T](ptr: T*, index: usize) -> T {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            value: T = load elem_ptr: T*
        }
        ret value
    }
}

#attr(safe)
fn __vec_store[T](ptr: T*, index: usize, value: T) -> bool {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            store value: T, elem_ptr: T*
        }
        ret true
    }
}

#attr(safe)
fn __vec_replace[T](ptr: T*, index: usize, value: T) -> bool {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            old: T = load elem_ptr: T*
            drop old: T
            store value: T, elem_ptr: T*
        }
        ret true
    }
}

#attr(safe)
fn __vec_drop_at[T](ptr: T*, index: usize) -> bool {
    unsafe {
        unsafe ehir {
            elem_ptr: T* = gep ptr: T*, index: usize
            old: T = load elem_ptr: T*
            drop old: T
        }
        ret true
    }
}

#attr(safe)
fn __vec_free_ptr[T](ptr: T*) -> bool {
    unsafe {
        unsafe ehir {
            hfree ptr: T*
        }
        ret true
    }
}

fn __vec_next_cap(current: usize) -> usize {
    if current == 0_usize {
        ret 4_usize
    }
    ret current * 2_usize
}

fn __vec_reserve_exact[T](vec: Vec[T], new_cap: usize) -> () {
    unsafe {
        let storage = __vec_storage[T](vec)
        let cap = __vec_cap[T](storage)
        if new_cap <= cap {
            ret ()
        }

        let next_ptr = __vec_realloc[T](__vec_ptr[T](storage), new_cap)
        __vec_set_ptr[T](storage, next_ptr)
        __vec_set_cap[T](storage, new_cap)
    }
    ret ()
}

impl[T] for Vec[T] {
    pub fn new() -> Vec[T] {
        ret Vec[T]::with_capacity(0_usize)
    }

    pub fn with_capacity(cap: usize) -> Vec[T] {
        unsafe {
            ret Vec[T]{__vec_storage_new[T](cap)}
        }
    }

    pub fn singleton(value: T) -> Vec[T] {
        let mut out = Vec[T]::new()
        out.push(value)
        ret out
    }

    pub fn len(self: Vec[T]) -> usize {
        unsafe {
            ret __vec_len[T](__vec_storage[T](self))
        }
    }

    pub fn capacity(self: Vec[T]) -> usize {
        unsafe {
            ret __vec_cap[T](__vec_storage[T](self))
        }
    }

    pub fn is_empty(self: Vec[T]) -> bool {
        ret self.len() == 0_usize
    }

    pub fn reserve(self: mut Vec[T], additional: usize) -> () {
        let required = self.len() + additional
        if required <= self.capacity() {
            ret ()
        }

        let mut next_cap = __vec_next_cap(self.capacity())
        while next_cap < required {
            next_cap = __vec_next_cap(next_cap)
        }

        __vec_reserve_exact[T](self, next_cap)
        ret ()
    }

    pub fn push(self: mut Vec[T], value: T) -> () {
        let required = self.len() + 1_usize
        if required > self.capacity() {
            self.reserve(1_usize)
        }
        unsafe {
            let storage = __vec_storage[T](self)
            let len = __vec_len[T](storage)
            __vec_store[T](__vec_ptr[T](storage), len, value)
            __vec_set_len[T](storage, len + 1_usize)
        }
        ret ()
    }

    pub fn set(self: mut Vec[T], index: usize, value: T) -> () {
        if index >= self.len() {
            ret ()
        }

        unsafe {
            __vec_replace[T](__vec_ptr[T](__vec_storage[T](self)), index, value)
        }
        ret ()
    }

    pub fn get(self: Vec[T], index: usize) -> Option[T] {
        if index >= self.len() {
            ret Option[T]::None
        }

        unsafe {
            let value = __vec_load[T](__vec_ptr[T](__vec_storage[T](self)), index)
            ret Option[T]::Some(value)
        }
    }

    pub fn first(self: Vec[T]) -> Option[T] {
        ret self.get(0_usize)
    }

    pub fn last(self: Vec[T]) -> Option[T] {
        if self.len() == 0_usize {
            ret Option[T]::None
        }
        ret self.get(self.len() - 1_usize)
    }

    pub fn clear(self: mut Vec[T]) -> () {
        let mut index = 0_usize
        while index < self.len() {
            unsafe {
                __vec_drop_at[T](__vec_ptr[T](__vec_storage[T](self)), index)
            }
            index = index + 1_usize
        }
        unsafe {
            __vec_set_len[T](__vec_storage[T](self), 0_usize)
        }
        ret ()
    }

    pub fn pop(self: mut Vec[T]) -> Option[T] {
        if self.len() == 0_usize {
            ret Option[T]::None
        }

        let index = self.len() - 1_usize
        match self.get(index) {
            Option[T]::Some(value) => {
                unsafe {
                    __vec_drop_at[T](__vec_ptr[T](__vec_storage[T](self)), index)
                    __vec_set_len[T](__vec_storage[T](self), index)
                }
                ret Option[T]::Some(value)
            }
            Option[T]::None => {
                ret Option[T]::None
            }
        }
    }

    pub fn extend(self: mut Vec[T], other: Vec[T]) -> () {
        self.reserve(other.len())
        let mut index = 0_usize
        loop {
            match other.get(index) {
                Option[T]::Some(value) => {
                    self.push(value)
                    index = index + 1_usize
                }
                Option[T]::None => {
                    break
                }
            }
        }
        ret ()
    }

    pub fn free(self: Vec[T]) -> bool {
        ret true
    }

    pub fn iter(self: Vec[T]) -> VecIter[T] {
        ret VecIter[T]{self, 0_usize}
    }

    pub fn into_iter(self: Vec[T]) -> VecIter[T] {
        ret self.iter()
    }
}

impl[T] IntoIterator[T, VecIter[T]] for Vec[T] {
    pub fn into_iter(self: Vec[T]) -> VecIter[T] {
        ret self.iter()
    }
}

impl[T] Iterator[T] for VecIter[T] {
    pub fn next(self: VecIter[T]) -> (VecIter[T], Option[T]) {
        match self.vec.get(self.index) {
            Option[T]::Some(value) => {
                ret (VecIter[T]{self.vec, self.index + 1_usize}, Option[T]::Some(value))
            }
            Option[T]::None => {
                ret (self, Option[T]::None)
            }
        }
    }
}

impl[T] for VecIter[T] {
    pub fn iter(self: VecIter[T]) -> VecIter[T] {
        ret self
    }

    pub fn next(self: VecIter[T]) -> (VecIter[T], Option[T]) {
        match self.vec.get(self.index) {
            Option[T]::Some(value) => {
                ret (VecIter[T]{self.vec, self.index + 1_usize}, Option[T]::Some(value))
            }
            Option[T]::None => {
                ret (self, Option[T]::None)
            }
        }
    }

    pub fn into_iter(self: VecIter[T]) -> VecIter[T] {
        ret self
    }
}

impl[T] IntoIterator[T, VecIter[T]] for VecIter[T] {
    pub fn into_iter(self: VecIter[T]) -> VecIter[T] {
        ret self
    }
}

pub fn iter_next[T](iter: VecIter[T]) -> (VecIter[T], Option[T]) {
    match iter.vec.get(iter.index) {
        Option[T]::Some(value) => {
            ret (VecIter[T]{iter.vec, iter.index + 1_usize}, Option[T]::Some(value))
        }
        Option[T]::None => {
            ret (iter, Option[T]::None)
        }
    }
}

pub fn iter_next_iter[T](iter: VecIter[T]) -> VecIter[T] {
    let step = iter_next[T](iter)
    ret step.0
}

pub fn iter_next_item[T](iter: VecIter[T]) -> Option[T] {
    let step = iter_next[T](iter)
    ret step.1
}

impl[T:Debug] Debug for Vec[T] {
    pub fn fmt(self: Vec[T]) -> str {
        let mut out: str = "["
        let mut index: usize = 0_usize

        loop {
            match self.get(index) {
                Some(value) => {
                    if index > 0_usize {
                        out = out + ", "
                    }
                    let item_str: str = Debug::fmt(value)
                    out = out + item_str
                    index = index + 1_usize
                }
                None => {
                    break
                }
            }
        }

        ret out + "]"
    }
}

#attr(test)
fn vec_contract() -> bool {
    let mut vec = Vec[u32]::new()
    let initial_len = vec.len()
    vec.push(3_u32)
    vec.push(5_u32)
    vec.push(8_u32)
    vec.reserve(2_usize)
    ret initial_len == 0_usize
        && vec.len() == 3_usize
        && !vec.is_empty()
        && vec.capacity() >= 3_usize
}
