import core::fmt::Debug


pub enum Option[T] {
    Some(T)
    None
}

impl[T] for Option[T] {
    pub fn is_some(self: Option[T]) -> bool {
        ret is_some[T](self)
    }

    pub fn is_none(self: Option[T]) -> bool {
        ret is_none[T](self)
    }

    pub fn unwrap_or(self: Option[T], default: T) -> T {
        ret unwrap_or[T](self, default)
    }

    pub fn and(self: Option[T], rhs: Option[T]) -> Option[T] {
        ret and[T](self, rhs)
    }

    pub fn or(self: Option[T], rhs: Option[T]) -> Option[T] {
        ret or[T](self, rhs)
    }

    pub fn xor(self: Option[T], rhs: Option[T]) -> Option[T] {
        ret xor[T](self, rhs)
    }
}

pub fn is_some[T](opt: Option[T]) -> bool {
    ret match opt {
        Some(value) => true
        None => false
    }
}

pub fn is_none[T](opt: Option[T]) -> bool {
    ret match opt {
        Some(value) => false
        None => true
    }
}

pub fn unwrap_or[T](opt: Option[T], default: T) -> T {
    ret match opt {
        Some(value) => value
        None => default
    }
}

pub fn and[T](lhs: Option[T], rhs: Option[T]) -> Option[T] {
    ret match lhs {
        Some(value) => rhs
        None => Option[T]::None
    }
}

pub fn or[T](lhs: Option[T], rhs: Option[T]) -> Option[T] {
    ret match lhs {
        Some(value) => lhs
        None => rhs
    }
}

pub fn xor[T](lhs: Option[T], rhs: Option[T]) -> Option[T] {
    ret match lhs {
        Some(left) => match rhs {
            Some(right) => Option[T]::None
            None => lhs
        }
        None => rhs
    }
}

pub fn flatten[T](opt: Option[Option[T]]) -> Option[T] {
    ret match opt {
        Some(inner) => inner
        None => Option[T]::None
    }
}

impl[T:Debug] Debug for Option[T] {
    pub fn fmt(self: Option[T]) -> str {
        ret match self {
            Some(value) => "Some(" + Debug::fmt(value) + ")"
            None => "None"
        }
    }
}
