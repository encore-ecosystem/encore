import core::testing::*
import std::os::home_dir
import std::path::Path

fn main() -> u32 {
    let p = Path::new("/tmp/example.tar.gz")
    if !assert(p.as_str() == "/tmp/example.tar.gz") {
        ret 1_u32
    }
    if !assert(p.is_absolute()) {
        ret 1_u32
    }

    let child = p.join("child.txt")
    if !assert(child.as_str() == "/tmp/example.tar.gz/child.txt") {
        ret 1_u32
    }
    if !assert(p.join("/var/log").as_str() == "/var/log") {
        ret 1_u32
    }

    match p.name() {
        Some(name) => {
            if !assert(name == "example.tar.gz") {
                ret 1_u32
            }
        }
        None => {
            ret 1_u32
        }
    }

    match p.stem() {
        Some(stem) => {
            if !assert(stem == "example.tar") {
                ret 1_u32
            }
        }
        None => {
            ret 1_u32
        }
    }

    match p.suffix() {
        Some(suffix) => {
            if !assert(suffix == ".gz") {
                ret 1_u32
            }
        }
        None => {
            ret 1_u32
        }
    }

    match p.extension() {
        Some(extension) => {
            if !assert(extension == "gz") {
                ret 1_u32
            }
        }
        None => {
            ret 1_u32
        }
    }

    let replaced = p.with_suffix(".txt")
    if !assert(replaced.as_str() == "/tmp/example.tar.txt") {
        ret 1_u32
    }
    if !assert(p.with_name("next.md").as_str() == "/tmp/next.md") {
        ret 1_u32
    }

    match Path::new("/tmp/file.txt").parent() {
        Some(parent) => {
            if !assert(parent.as_str() == "/tmp") {
                ret 1_u32
            }
        }
        None => {
            ret 1_u32
        }
    }
    match Path::new("/tmp").parent() {
        Some(parent) => {
            if !assert(parent.as_str() == "/") {
                ret 1_u32
            }
        }
        None => {
            ret 1_u32
        }
    }

    let rel = Path::new("a//b///c")
    if !assert(rel.as_str() == "a/b/c") {
        ret 1_u32
    }
    if !assert(rel.is_relative()) {
        ret 1_u32
    }

    let home = home_dir()
    let tilde = Path::new("~/tmp").expanduser()
    if !assert(tilde.as_str() == home + "/tmp") {
        ret 1_u32
    }

    let norm = Path::new("a/./b/../c").normalize()
    if !assert(norm.as_str() == "a/c") {
        ret 1_u32
    }

    let abs = Path::new("tmp/x").absolute()
    if !assert(abs.is_absolute()) {
        ret 1_u32
    }

    let resolved = Path::new("~/x/./y/../z").resolve()
    if !assert(resolved.as_str() == home + "/x/z") {
        ret 1_u32
    }

    ret 0_u32
}
