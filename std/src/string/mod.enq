import core::option::Option
import core::fmt::Debug

import refrain::vec::Vec

pub struct String {
    value: str
}

impl for String {
    pub fn new() -> String {
        ret String{""}
    }

    pub fn from_str(s: str) -> String {
        ret String{s}
    }

    pub fn as_str(self: String) -> str {
        ret self.value
    }

    pub fn len(self: String) -> usize {
        ret self.value.len()
    }

    pub fn is_empty(self: String) -> bool {
        ret self.len() == 0_usize
    }

    pub fn byte_at(self: String, index: usize) -> Option[u8] {
        ret self.value.get_byte_at(index)
    }

    pub fn char_at(self: String, index: usize) -> Option[str] {
        ret self.value.get(index)
    }

    pub fn concat(self: String, rhs: str) -> String {
        ret String::from_str(self.value + rhs)
    }

    pub fn push_str(self: String, rhs: str) -> String {
        ret self.concat(rhs)
    }

    pub fn slice(self: String, start: usize, slice_len: usize) -> String {
        ret String::from_str(self.value.slice(start, slice_len))
    }

    pub fn starts_with(self: String, prefix: str) -> bool {
        ret str_starts_at(self.value, prefix, 0_usize)
    }

    pub fn ends_with(self: String, suffix: str) -> bool {
        if suffix.len() > self.len() {
            ret false
        }
        ret str_starts_at(self.value, suffix, self.len() - suffix.len())
    }

    pub fn contains(self: String, needle: str) -> bool {
        if needle.len() == 0_usize {
            ret true
        }
        if needle.len() > self.len() {
            ret false
        }

        let limit = self.len() - needle.len()
        let mut index = 0_usize
        loop {
            if str_starts_at(self.value, needle, index) {
                ret true
            }
            if index >= limit {
                break
            }
            index = index + 1_usize
        }
        ret false
    }

    pub fn trim_start(self: String) -> String {
        let start = trim_start_index(self.value)
        ret String::from_str(self.value.slice(start, self.len() - start))
    }

    pub fn trim_end(self: String) -> String {
        let end = trim_end_index(self.value)
        ret String::from_str(self.value.slice(0_usize, end))
    }

    pub fn trim(self: String) -> String {
        ret self.trim_start().trim_end()
    }

    pub fn split_char(self: String, char: str) -> Vec[String] {
        let mut parts = Vec[String]::new()

        let mut curr_part = ""
        let mut i = 0_usize
        while i < self.len() {
            match self.char_at(i) {
                Option[str]::Some(c) => {
                    if c == char {
                        parts = parts.push(String::from_str(curr_part))
                        curr_part = ""
                    }
                    else {
                        curr_part = curr_part + c
                    }
                }
                Option[str]::None => {
                    break
                }
            }
            i = i + 1_usize
        }
        parts = parts.push(String::from_str(curr_part))
        ret parts
    }

    pub fn split_whitespace(self: String) -> Vec[String] {
        let mut parts = Vec[String]::new()
        let mut start = 0_usize
        let mut index = 0_usize
        let mut in_part = false

        loop {
            match self.char_at(index) {
                Option[str]::Some(ch) => {
                    if is_ascii_whitespace(ch) {
                        if in_part {
                            parts = parts.push(self.slice(start, index - start))
                            in_part = false
                        }
                    }
                    else {
                        if !in_part {
                            start = index
                            in_part = true
                        }
                    }
                    index = index + 1_usize
                }
                Option[str]::None => {
                    break
                }
            }
        }

        if in_part {
            parts = parts.push(self.slice(start, self.len() - start))
        }
        ret parts
    }
}

impl Debug for String {
    pub fn fmt(self: String) -> str {
        ret self.value
    }
}

fn str_starts_at(value: str, needle: str, offset: usize) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if offset + needle.len() > value.len() {
        ret false
    }

    let mut index = 0_usize
    while index < needle.len() {
        match value.get(offset + index) {
            Option[str]::Some(left) => {
                match needle.get(index) {
                    Option[str]::Some(right) => {
                        if left != right {
                            ret false
                        }
                    }
                    Option[str]::None => {
                        ret false
                    }
                }
            }
            Option[str]::None => {
                ret false
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn trim_start_index(value: str) -> usize {
    let mut index = 0_usize
    loop {
        match value.get(index) {
            Option[str]::Some(ch) => {
                if !is_ascii_whitespace(ch) {
                    ret index
                }
                index = index + 1_usize
            }
            Option[str]::None => {
                ret value.len()
            }
        }
    }
    ret index
}

fn trim_end_index(value: str) -> usize {
    let mut end = value.len()
    loop {
        if end == 0_usize {
            ret 0_usize
        }

        match value.get(end - 1_usize) {
            Option[str]::Some(ch) => {
                if !is_ascii_whitespace(ch) {
                    ret end
                }
                end = end - 1_usize
            }
            Option[str]::None => {
                ret end
            }
        }
    }
    ret end
}

fn is_ascii_whitespace(ch: str) -> bool {
    if ch == " " {
        ret true
    }
    if ch == "\n" {
        ret true
    }
    if ch == "\t" {
        ret true
    }
    if ch == "\r" {
        ret true
    }
    ret false
}
