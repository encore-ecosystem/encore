import core::time

pub fn spawn_sleep(ms: u64) -> u64 {
    let now = time::perf_counter_ms()
    ret now + ms
}

pub fn is_ready(task_deadline_ms: u64) -> bool {
    ret time::perf_counter_ms() >= task_deadline_ms
}

pub fn wait(task_deadline_ms: u64) -> bool {
    loop {
        if is_ready(task_deadline_ms) {
            break
        }
        time::sleep_ms(1_u64)
    }
    ret true
}

pub fn join2(first_deadline_ms: u64, second_deadline_ms: u64) -> bool {
    loop {
        let first_ready = is_ready(first_deadline_ms)
        let second_ready = is_ready(second_deadline_ms)
        if first_ready && second_ready {
            break
        }
        time::sleep_ms(1_u64)
    }
    ret true
}

pub async fn sleep(ms: u64) -> bool {
    ret wait(spawn_sleep(ms))
}

pub async fn parallel_sleep(first_ms: u64, second_ms: u64) -> bool {
    let first = spawn_sleep(first_ms)
    let second = spawn_sleep(second_ms)
    ret join2(first, second)
}
