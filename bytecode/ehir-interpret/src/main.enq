import std::io::{eprintln, println}
import std::os::{argc, argv, file_exists, read_file}

import refrain::interpret

fn main() -> u32 {
    let path = argv(1_usize).unwrap_or("")
    if path == "--help" || path == "-h" {
        println("Usage: ehir-interpret <input.ehir>")
        ret 0_u32
    }
    if argc() != 2_usize {
        eprintln("Usage: ehir-interpret <input.ehir>")
        ret 2_u32
    }
    if !file_exists(path) {
        eprintln("ehir-interpret: input not found: " + path)
        ret 2_u32
    }
    ret match interpret(read_file(path)) {
        Ok(code) => code
        Err(message) => {
            eprintln(path + ":" + message)
            1_u32
        }
    }
}
