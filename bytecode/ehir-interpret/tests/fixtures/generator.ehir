enum Option[T] {
  Some(T)
  None
}

struct Generator[T] {
  state: dyn __GeneratorResume[T]
}

trait __GeneratorResume[T] {
  fn resume(self: Self) -> Option[T]
}

trait Iterator[T] {
  fn next(self: Self) -> __tuple_2[Self, Option[T]]
}

impl[T] Iterator[T] for Generator[T] {
  fn next(self: Generator[T]) -> __tuple_2[Generator[T], Option[T]] {
  $entry:
    state: dyn __GeneratorResume[T] = getfield self: Generator[T], 0
    retain state: dyn __GeneratorResume[T]
    option: Option[T] = call __GeneratorResume::resume[T](state: dyn __GeneratorResume[T])
    step: __tuple_2[Generator[T], Option[T]] = capstruct __tuple_2[Generator[T], Option[T]](self: Generator[T], option: Option[T])
    ret step: __tuple_2[Generator[T], Option[T]]
  }
}

extern fn ehir_println_u64(value: u64) -> ()

fn close(value: u64) -> () {
  $entry:
    closed: () = call ehir_println_u64(value: u64)
    ret void: ()
}

generator fn values(start: u64) -> u64 => Generator[u64] {
  $entry:
    entered: () = call ehir_println_u64(start: u64)
    next: u64 = capprim 13_u64
    yield start: u64 cleanup [closed: () = call close(next: u64)]
    yield next: u64 cleanup [closed: () = call close(next: u64)]
    closed: () = call close(next: u64)
    ret void: ()
}

fn main() -> u32 {
  $entry:
    start: u64 = capprim 7_u64
    cursor: Generator[u64] = call values(start: u64)
    before_next: u64 = capprim 99_u64
    created: () = call ehir_println_u64(before_next: u64)
    retain cursor: Generator[u64]
    step1: __tuple_2[Generator[u64], Option[u64]] = call Generator::next[u64](cursor: Generator[u64])
    next1: Generator[u64] = getfield step1: __tuple_2[Generator[u64], Option[u64]], 0
    result1: Option[u64] = getfield step1: __tuple_2[Generator[u64], Option[u64]], 1
    value1: u64 = getfield result1: Option[u64], Some
    printed1: () = call ehir_println_u64(value1: u64)
    drop result1: Option[u64]
    drop next1: Generator[u64]
    step2: __tuple_2[Generator[u64], Option[u64]] = call Generator::next[u64](cursor: Generator[u64])
    next2: Generator[u64] = getfield step2: __tuple_2[Generator[u64], Option[u64]], 0
    result2: Option[u64] = getfield step2: __tuple_2[Generator[u64], Option[u64]], 1
    value2: u64 = getfield result2: Option[u64], Some
    printed2: () = call ehir_println_u64(value2: u64)
    drop result2: Option[u64]
    step3: __tuple_2[Generator[u64], Option[u64]] = call Generator::next[u64](next2: Generator[u64])
    next3: Generator[u64] = getfield step3: __tuple_2[Generator[u64], Option[u64]], 0
    result3: Option[u64] = getfield step3: __tuple_2[Generator[u64], Option[u64]], 1
    match result3: Option[u64], $wrong {
      None => $again
    }
  $again:
    step4: __tuple_2[Generator[u64], Option[u64]] = call Generator::next[u64](next3: Generator[u64])
    result4: Option[u64] = getfield step4: __tuple_2[Generator[u64], Option[u64]], 1
    drop step4: __tuple_2[Generator[u64], Option[u64]]
    match result4: Option[u64], $wrong {
      None => $early
    }
  $early:
    early: Generator[u64] = call values(start: u64)
    partial: __tuple_2[Generator[u64], Option[u64]] = call Generator::next[u64](early: Generator[u64])
    drop partial: __tuple_2[Generator[u64], Option[u64]]
    abandoned: Generator[u64] = call values(start: u64)
    drop abandoned: Generator[u64]
    success: u32 = capprim 0_u32
    ret success: u32
  $wrong:
    fail: u32 = capprim 1_u32
    ret fail: u32
}
