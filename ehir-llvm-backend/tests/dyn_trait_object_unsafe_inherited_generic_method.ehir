;@expect.compile_error=is not object-safe
trait Parent {
  fn id[T](self: Self, value: T) -> T
}

trait Child < Parent {
  fn ping(self: Self) -> usize
}

fn use_it(v: dyn Child) -> usize {
  $entry:
    z = capprim 0_usize
    ret z
}

fn main() -> usize {
  $entry:
    z = capprim 0_usize
    ret z
}
