trait Show {
  fn show(self: Self) -> usize
}

struct Number {
  value: usize
}

impl Show for Number {
  fn show(self: Number) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

fn accept_obj(v: dyn Show) -> usize {
  $entry:
    out = call Show::show(v)
    ret out
}

fn main() -> usize {
  $entry:
    value = capprim 17_usize
    number = capstruct Number(value)
    dyn_number = pcast number, dyn Show
    got = call accept_obj(dyn_number)
    exp = capprim 17_usize
    ok = ieq got, exp
    cbr ok, $pass, $fail

  $pass:
    z0 = capprim 0_usize
    ret z0

  $fail:
    z1 = capprim 1_usize
    ret z1
}
