struct Counter {
  value: usize
}

impl Counter {
  fn inc(self: Self) -> Self {
    $entry:
      one = capprim 1_usize
      curr = sgetfield self, value
      next = add curr, one
      out = capstruct Counter(next)
      ret out
  }

  fn get(self: Self) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

fn main() -> usize {
  $entry:
    zero = capprim 0_usize
    c0 = capstruct Counter(zero)
    callvoid c0::inc()
    callvoid c0::inc()
    v = call c0::get()
    exp = capprim 2_usize
    ok = ieq v, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
