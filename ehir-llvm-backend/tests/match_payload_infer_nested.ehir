enum Option[T] {
  Some(T)
  None
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    inner = capenum Option[usize]::Some(one)
    outer = capenum Option[Option[usize]]::Some(inner)
    match outer, $outer_none {
      Some(x) => $outer_some
    }
  $outer_some:
    match x, $inner_none {
      Some(y) => $inner_some
    }
  $inner_some:
    exp = capprim 1_usize
    ok = ieq y, exp
    cbr ok, $ok, $fail
  $ok:
    zero_ok = capprim 0_usize
    ret zero_ok
  $fail:
    one_fail = capprim 1_usize
    ret one_fail
  $inner_none:
    one_inner = capprim 1_usize
    ret one_inner
  $outer_none:
    one_outer = capprim 1_usize
    ret one_outer
}
