#cfg(target_os = "linux")
fn selected() -> usize {
  $entry:
    zero = capprim 0_usize
    ret zero
}

#cfg(windows)
fn selected() -> usize {
  $entry:
    one = capprim 1_usize
    ret one
}

#cfg(all(unix, not(windows)))
fn main() -> usize {
  $entry:
    value = call selected()
    ret value
}

#cfg(windows)
fn main() -> usize {
  $entry:
    one = capprim 1_usize
    ret one
}
