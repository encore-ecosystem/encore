struct Id[T] {
  value: T
}

impl[T] Id[T] {
  fn get(self: Self) -> T {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

fn main() -> usize {
  $entry:
    seven = capprim 7_usize
    v = capstruct Id[usize](seven)
    out = call v::get()
    exp = capprim 7_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
