trait Parent {
  fn base(self: Self) -> usize
}

trait Child < Parent {
  fn child(self: Self) -> usize
}

impl Child for usize {
  fn base(self: usize) -> usize {
    $entry:
      ret self
  }

  fn child(self: usize) -> usize {
    $entry:
      one = capprim 1_usize
      out = add self, one
      ret out
  }
}

fn main() -> usize {
  $entry:
    v = capprim 41_usize
    a = call Parent::base(v)
    b = call Child::child(v)
    one = capprim 1_usize
    exp = add a, one
    ok = ieq b, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
