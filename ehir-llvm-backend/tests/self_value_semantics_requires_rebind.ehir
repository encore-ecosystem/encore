struct Acc {
  value: usize
}

impl Acc {
  fn push(self: Self, delta: usize) -> Self {
    $entry:
      curr = sgetfield self, value
      next = add curr, delta
      out = capstruct Acc(next)
      ret out
  }
}

fn main() -> usize {
  $entry:
    zero = capprim 0_usize
    five = capprim 5_usize
    acc = capstruct Acc(zero)
    acc = call Acc::push(acc, five)
    out = sgetfield acc, value
    exp = capprim 5_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
