;@expect.compile_error=Unreachable match default branch
enum Option[T] {
  Some(T)
  None
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    val = capenum Option[usize]::Some(one)
    match val, $fallback {
      Some => $a
      None => $b
    }
  $a:
    ret one
  $b:
    zero = capprim 0_usize
    ret zero
  $fallback:
    two = capprim 2_usize
    ret two
}
