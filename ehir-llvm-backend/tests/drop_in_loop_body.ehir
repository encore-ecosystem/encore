;@cfree.free_ids=loop_payload
struct Payload {
  id: str
  value: usize
}

fn main() -> usize {
  $entry:
    id = capprim "loop_payload"_str
    value = capprim 7_usize
    raw = capstruct Payload(id, value)
    boxed = wraph raw
    index_ptr = salloc usize
    zero_init = capprim 0_usize
    store zero_init, index_ptr
    br $cond
  $cond:
    index = load index_ptr
    one_limit = capprim 1_usize
    keep_going = les index, one_limit
    cbr keep_going, $body, $done
  $body:
    drop boxed
    one_next = capprim 1_usize
    store one_next, index_ptr
    br $cond
  $done:
    zero = capprim 0_usize
    ret zero
}
