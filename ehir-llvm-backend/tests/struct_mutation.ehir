struct Pair {
  left: usize
  right: usize
}

fn main() -> usize {
  $entry:
    l0 = capprim 10_usize
    r0 = capprim 20_usize
    p = capstruct Pair(l0, r0)

    l1 = capprim 11_usize
    r1 = capprim 22_usize
    setfield p > left, l1
    setfield p > right, r1

    a = getfield p > left
    b = getfield p > right
    s = add a, b

    exp = capprim 33_usize
    ok = ieq s, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
