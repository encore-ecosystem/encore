;@cfree.free_ids=root,left,right,leaf
enum Option[T] {
  Some(T)
  None
}

struct DiamondNode {
  id: str
  index: usize
  left: Option[Box[DiamondNode]]
  right: Option[Box[DiamondNode]]
}

impl DiamondNode {
  pub fn new(id: str, index: usize) -> Box[Self] {
    $entry:
      none = capenum Option[Box[DiamondNode]]::None
      raw = capstruct DiamondNode(id, index, none, none)
      boxed = wraph raw
      ret boxed
  }
}

fn main() -> usize {
  $entry:
    id1s = capprim "root"_str
    id2s = capprim "left"_str
    id3s = capprim "right"_str
    id4s = capprim "leaf"_str
    i1 = capprim 1_usize
    i2 = capprim 2_usize
    i3 = capprim 3_usize
    i4 = capprim 4_usize
    root = call DiamondNode::new(id1s, i1)
    left = call DiamondNode::new(id2s, i2)
    right = call DiamondNode::new(id3s, i3)
    leaf = call DiamondNode::new(id4s, i4)

    some_left = capenum Option[Box[DiamondNode]]::Some(left)
    setfield root > left, some_left

    some_right = capenum Option[Box[DiamondNode]]::Some(right)
    setfield root > right, some_right

    some_leaf_l = capenum Option[Box[DiamondNode]]::Some(leaf)
    setfield left > left, some_leaf_l

    some_leaf_r = capenum Option[Box[DiamondNode]]::Some(leaf)
    setfield right > right, some_leaf_r

    a = getfield root > index
    b = getfield left > index
    c = getfield right > index
    d = getfield leaf > index
    sum = add a, b
    sum = add sum, c
    sum = add sum, d
    exp = capprim 10_usize
    ok = ieq sum, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
