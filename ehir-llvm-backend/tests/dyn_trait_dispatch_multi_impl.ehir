trait Show {
  fn show(self: Self) -> usize
}

struct A {
  value: usize
}

struct B {
  value: usize
}

impl Show for A {
  fn show(self: A) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

impl Show for B {
  fn show(self: B) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

fn main() -> usize {
  $entry:
    va = capprim 11_usize
    vb = capprim 29_usize
    a = capstruct A(va)
    b = capstruct B(vb)

    da = pcast a, dyn Show
    db = pcast b, dyn Show

    ga = call Show::show(da)
    gb = call Show::show(db)
    sum = add ga, gb

    exp = capprim 40_usize
    ok = ieq sum, exp
    cbr ok, $pass, $fail

  $pass:
    z0 = capprim 0_usize
    ret z0

  $fail:
    z1 = capprim 1_usize
    ret z1
}
