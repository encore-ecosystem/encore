struct Vector2D {
  x: usize
  y: usize
}

fn sum(self: &Vector2D) -> usize {
  $entry:
    x = getfield self > x
    y = getfield self > y
    s = add x, y
    ret s
}

fn main() -> usize {
  $entry:
    x   = capprim 15_usize
    y   = capprim 10_usize
    vec = capstruct Vector2D(x, y)

    heap_ref  = wraph vec
    stack_ref = wraps vec

    v1 = call sum(heap_ref)
    v2 = call sum(stack_ref)
    s = add v1, v2

    exp = capprim 50_usize
    ok = ieq s, exp
    cbr ok, $ok, $err

  $ok:
    z0 = capprim 0_usize
    ret z0

  $err:
    z1 = capprim 1_usize
    ret z1
}
