struct Counter {
  value: usize
}

impl Counter {
  fn add_n(self: Self, delta: usize) -> Self {
    $entry:
      curr = sgetfield self, value
      next = add curr, delta
      out = capstruct Counter(next)
      ret out
  }

  fn get(self: Self) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }
}

fn main() -> usize {
  $entry:
    zero = capprim 0_usize
    two = capprim 2_usize
    three = capprim 3_usize
    c0 = capstruct Counter(zero)
    c1 = call c0::add_n(two)
    c2 = call c1::add_n(three)
    out = call c2::get()
    exp = capprim 5_usize
    ok = ieq out, exp
    cbr ok, $pass, $fail
  $pass:
    z0 = capprim 0_usize
    ret z0
  $fail:
    z1 = capprim 1_usize
    ret z1
}
