enum Option[T] {
  Some(T)
  None
}

fn main() -> usize {
  $entry:
    two = capprim 2_usize
    forty = capprim 40_usize
    val = capenum Option[usize]::Some(forty)
    match val, $none {
      Some(x) => $some
    }
  $some:
    sum = add x, two
    exp = capprim 42_usize
    ok = ieq sum, exp
    cbr ok, $ok, $fail
  $ok:
    zero = capprim 0_usize
    ret zero
  $fail:
    one = capprim 1_usize
    ret one
  $none:
    two_fail = capprim 2_usize
    ret two_fail
}
