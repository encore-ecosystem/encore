trait Parent {
  fn base(self: Self) -> usize
}

trait Child < Parent {
  fn child(self: Self) -> usize
}

struct Counter {
  value: usize
}

impl Child for Counter {
  fn base(self: Counter) -> usize {
    $entry:
      out = sgetfield self, value
      ret out
  }

  fn child(self: Counter) -> usize {
    $entry:
      out = sgetfield self, value
      one = capprim 1_usize
      next = add out, one
      ret next
  }
}

fn main() -> usize {
  $entry:
    v = capprim 41_usize
    c = capstruct Counter(v)
    d = pcast c, dyn Child
    a = call Parent::base(d)
    b = call Child::child(d)
    one = capprim 1_usize
    exp = add a, one
    ok = ieq b, exp
    cbr ok, $pass, $fail

  $pass:
    z0 = capprim 0_usize
    ret z0

  $fail:
    z1 = capprim 1_usize
    ret z1
}
