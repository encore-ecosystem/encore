trait Metrics {
  fn id(self: Self) -> usize
  fn level(self: Self) -> usize
  fn is_hot(self: Self) -> usize
}

struct Sensor {
  ident: usize
  heat: usize
}

impl Metrics for Sensor {
  fn id(self: Sensor) -> usize {
    $entry:
      out = sgetfield self, ident
      ret out
  }

  fn level(self: Sensor) -> usize {
    $entry:
      out = sgetfield self, heat
      ret out
  }

  fn is_hot(self: Sensor) -> usize {
    $entry:
      heat = sgetfield self, heat
      limit = capprim 10_usize
      hot = grt heat, limit
      cbr hot, $yes, $no

    $yes:
      one = capprim 1_usize
      ret one

    $no:
      zero = capprim 0_usize
      ret zero
  }
}

struct Holder {
  item: dyn Metrics
  tag: usize
}

fn accept(v: dyn Metrics) -> usize {
  $entry:
    ident = call Metrics::id(v)
    level = call Metrics::level(v)
    hot = call Metrics::is_hot(v)
    subtotal = add ident, level
    out = add subtotal, hot
    ret out
}

fn forward(v: dyn Metrics) -> dyn Metrics {
  $entry:
    ret v
}

fn holder_score(holder: Holder) -> usize {
  $entry:
    item = sgetfield holder, item
    tag = sgetfield holder, tag
    base = call accept(item)
    out = add base, tag
    ret out
}

fn main() -> usize {
  $entry:
    ident = capprim 7_usize
    heat = capprim 15_usize
    tag = capprim 5_usize
    sensor = capstruct Sensor(ident, heat)
    dyn_sensor = pcast sensor, dyn Metrics
    forwarded = call forward(dyn_sensor)
    holder = capstruct Holder(forwarded, tag)
    got = call holder_score(holder)
    exp = capprim 28_usize
    ok = ieq got, exp
    cbr ok, $pass, $fail

  $pass:
    z0 = capprim 0_usize
    ret z0

  $fail:
    z1 = capprim 1_usize
    ret z1
}
