trait Logger {
  fn flush(self: Self) -> usize
}

struct FileLogger {
  pending: usize
}

impl Logger for FileLogger {
  fn flush(self: FileLogger) -> usize {
    $entry:
      out = sgetfield self, pending
      ret out
  }
}

struct Service {
  current: dyn Logger
  tag: usize
}

fn flush_service(service: Service) -> usize {
  $entry:
    current = sgetfield service, current
    tag = sgetfield service, tag
    flushed = call Logger::flush(current)
    out = add flushed, tag
    ret out
}

fn pass_through(v: dyn Logger) -> dyn Logger {
  $entry:
    ret v
}

fn main() -> usize {
  $entry:
    pending = capprim 31_usize
    tag = capprim 9_usize
    logger = capstruct FileLogger(pending)
    dyn_logger = pcast logger, dyn Logger
    forwarded = call pass_through(dyn_logger)
    service = capstruct Service(forwarded, tag)
    got = call flush_service(service)
    exp = capprim 40_usize
    ok = ieq got, exp
    cbr ok, $pass, $fail

  $pass:
    z0 = capprim 0_usize
    ret z0

  $fail:
    z1 = capprim 1_usize
    ret z1
}
