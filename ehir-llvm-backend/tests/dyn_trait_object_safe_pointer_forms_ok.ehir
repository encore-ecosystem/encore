trait Logger {
  fn flush(self: Self) -> usize
}

struct Service {
  current: dyn Logger
  next: dyn Logger*
}

fn pin(v: dyn Logger*) -> usize {
  $entry:
    z = capprim 0_usize
    ret z
}

fn borrow(v: &dyn Logger) -> usize {
  $entry:
    z = capprim 0_usize
    ret z
}

fn main() -> usize {
  $entry:
    z0 = capprim 0_usize
    ret z0
}
