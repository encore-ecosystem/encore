;@expect.compile_error=Unknown match variant 'Missing'
enum Option[T] {
  Some(T)
  None
}

fn main() -> usize {
  $entry:
    one = capprim 1_usize
    val = capenum Option[usize]::Some(one)
    match val, $fallback {
      Missing => $a
    }
  $a:
    ret one
  $fallback:
    zero = capprim 0_usize
    ret zero
}
