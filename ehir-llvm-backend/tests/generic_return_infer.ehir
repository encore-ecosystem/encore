enum Option[T] {
  Some(T)
  None
}

fn make_none[T]() -> Option[T] {
  $entry:
    out = capenum Option[T]::None()
    ret out
}

fn main() -> usize {
  $entry:
    val: Option[usize] = call make_none()
    match val, $none {
      Some(x) => $some
    }
  $some:
    ret x
  $none:
    zero = capprim 0_usize
    ret zero
}
