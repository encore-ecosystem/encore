enum Option[T] {
  Some(T)
  None
}

struct Node {
  index: usize
  next: Option[Box[Node]]
}

impl Node {
  pub fn new(index: usize) -> Box[Self] {
    $entry:
      none = capenum Option[Box[Node]]::None
      raw = capstruct Node(index, none)
      boxed = wraph raw
      ret boxed
  }
}

fn main() -> usize {
  $entry:
    i0 = capprim 0_usize
    i1 = capprim 1_usize
    i2 = capprim 2_usize
    n0 = call Node::new(i0)
    n1 = call Node::new(i1)
    n2 = call Node::new(i2)

    s1 = capenum Option[Box[Node]]::Some(n1)
    setfield n0 > next, s1

    s2 = capenum Option[Box[Node]]::Some(n2)
    setfield n1 > next, s2

    s0 = capenum Option[Box[Node]]::Some(n0)
    setfield n2 > next, s0

    a = getfield n0 > index
    b = getfield n1 > index
    c = getfield n2 > index
    sum = add a, b
    sum = add sum, c
    exp = capprim 3_usize
    ok = ieq sum, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
