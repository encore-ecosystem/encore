enum Option[T] {
  Some(T)
  None
}

struct SharedNode {
  index: usize
  left: Option[Box[SharedNode]]
  right: Option[Box[SharedNode]]
}

impl SharedNode {
  pub fn new(index: usize) -> Box[Self] {
    $entry:
      none = capenum Option[Box[SharedNode]]::None
      raw = capstruct SharedNode(index, none, none)
      boxed = wraph raw
      ret boxed
  }
}

fn main() -> usize {
  $entry:
    i10 = capprim 10_usize
    i20 = capprim 20_usize
    i30 = capprim 30_usize
    p1 = call SharedNode::new(i10)
    p2 = call SharedNode::new(i20)
    child = call SharedNode::new(i30)

    some_child_a = capenum Option[Box[SharedNode]]::Some(child)
    setfield p1 > left, some_child_a

    some_child_b = capenum Option[Box[SharedNode]]::Some(child)
    setfield p2 > right, some_child_b

    a = getfield p1 > index
    b = getfield p2 > index
    c = getfield child > index
    sum = add a, b
    sum = add sum, c
    exp = capprim 60_usize
    ok = ieq sum, exp
    cbr ok, $ok, $err
  $ok:
    z = capprim 0_usize
    ret z
  $err:
    o = capprim 1_usize
    ret o
}
