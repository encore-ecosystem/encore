import std::os

fn main() -> u32 {
    let output = os::argv(1_usize).unwrap_or("")
    let metadata = "{\"native\":{\"libraries\":[{\"name\":\"encore_asyncio\",\"path\":\"native/runtime.c\"}]}}"
    ret if os::write_file(output, metadata) == 0_i32 {
        0_u32
    } else {
        1_u32
    }
}
