import std::os
import std::process::run_args

fn main() -> u32 {
    let path = os::argv(1_usize).unwrap_or("")
    if path == "" { ret 2_u32 }
    let prefix = os::env("OPENSSL_DIR").unwrap_or(if os::file_exists("/opt/homebrew/opt/openssl@3/include/openssl/ssl.h") { "/opt/homebrew/opt/openssl@3" } else { "/usr" })
    let object = path + ".o"
    let args = vec!["-std=c11", "-O2", "-fPIC", "-pthread", "-I" + prefix + "/include", "-c", "native/runtime.c", "-o", object]
    if run_args(os::env("CC").unwrap_or("clang"), args) != 0_i32 { ret 1_u32 }
    let payload = "{\"native\":{\"libraries\":[{\"name\":\"mf_network\",\"path\":\"" + object + "\"}],\"search_paths\":[\"" + prefix + "/lib\"],\"frameworks\":[],\"link_args\":[\"-lssl\",\"-lcrypto\",\"-pthread\"]}}"
    ret if os::write_file(path, payload) == 0_i32 { 0_u32 } else { 1_u32 }
}
