import std::io::eprintln
import std::os
import std::path::Path
import std::process::run_args

fn find(text: str, needle: str) -> usize {
    let mut index = 0_usize
    while index + needle.byte_len() <= text.byte_len() {
        if text.slice_bytes(index, needle.byte_len()) == needle {
            ret index
        }
        index += 1_usize
    }
    ret text.byte_len()
}

fn quote(text: str) -> str {
    let mut escaped = "\""
    let mut start = 0_usize
    for index in 0_usize..text.byte_len() {
        let byte = text.byte_at(index)
        if byte == 92_u8 || byte == 34_u8 {
            escaped = escaped + text.slice_bytes(start, index - start) + "\\" + text.slice_bytes(index, 1_usize)
            start = index + 1_usize
        }
    }
    ret escaped + text.slice_bytes(start, text.byte_len() - start) + "\""
}

fn main() -> u32 {
    let output = os::argv(1_usize).unwrap_or("")
    let target = os::argv(2_usize).unwrap_or("")
    if output == "" {
        ret 2_u32
    }
    let windows = find(target, "-windows-") < target.byte_len()
    let darwin = find(target, "-apple-") < target.byte_len()
    let bundled = Path::new(os::core_dir()).parent().unwrap_or(Path::new(".")).join("openssl").join(target)
    let kits = Path::new(os::env("ENCORE_TARGETS_DIR").unwrap_or(os::home_dir() + "/.encore/targets"))
    let kit = kits.join("0.1").join(target)
    let system = if os::file_exists(bundled.join("include/openssl/ssl.h").as_str()) {
        bundled.as_str()
    } elif windows {
        if os::file_exists(bundled.join("include/openssl/ssl.h").as_str()) {
            bundled.as_str()
        } else {
            kit.join("openssl").as_str()
        }
    } elif os::file_exists("/opt/homebrew/opt/openssl@3/include/openssl/ssl.h") {
        "/opt/homebrew/opt/openssl@3"
    } else {
        "/usr"
    }
    let prefix = Path::new(os::env("OPENSSL_DIR").unwrap_or(system)).resolve()
    let object = output + ".o"
    let compiler = os::env("CC")
    let mut args = vec!["-std=c11", "-O2", "-I" + prefix.join("include").as_str(), "-c", "native/runtime.c", "-o", object]
    if compiler.is_none() && target != "" {
        args.push("--target=" + target)
    }
    let mut libraries = "{\"name\":\"encore_network\",\"path\":" + quote(object) + "}"
    let link = if windows || darwin {
        let extension = if find(target, "-msvc") < target.byte_len() {
            ".lib"
        } else {
            ".a"
        }
        let ssl = prefix.join("lib").join("libssl" + extension).as_str()
        let crypto = prefix.join("lib").join("libcrypto" + extension).as_str()
        if !os::file_exists(ssl) || !os::file_exists(crypto) {
            eprintln("missing OpenSSL static libraries for " + target + " at " + prefix.as_str())
            ret 1_u32
        }
        libraries = libraries + ",{\"path\":" + quote(ssl) + "},{\"path\":" + quote(crypto) + "}"
        if windows {
            args.push("-D_WIN32_WINNT=0x0601")
            "\"-lcrypt32\",\"-lws2_32\",\"-lbcrypt\",\"-ladvapi32\",\"-luser32\""
        } else {
            args.push("-fPIC") args.push("-pthread")
            "\"-pthread\""
        }
    } else {
        args.push("-fPIC")
        args.push("-pthread")
        "\"-lssl\",\"-lcrypto\",\"-pthread\""
    }
    let driver = if windows && os::file_exists(kit.join("toolchain/bin/clang").as_str()) {
        kit.join("toolchain/bin/clang").as_str()
    } else {
        os::env("ENCORE_CC").unwrap_or("clang")
    }
    if run_args(compiler.unwrap_or(driver), args) != 0_i32 {
        ret 1_u32
    }
    let payload = "{\"native\":{\"libraries\":[" + libraries + "],\"search_paths\":[" + quote(prefix.join("lib").as_str()) + "],\"link_args\":[" + link + "]}}"
    ret if os::write_file(output, payload) == 0_i32 {
        0_u32
    } else {
        1_u32
    }
}
