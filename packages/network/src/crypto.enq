//! Byte-oriented digest/encoding helpers. No cryptographic key generation.
import core::vec::Vec
import network::byte

fn rotate(value: u32, count: u32) -> u32 { ret (value >> count) | (value << (32_u32 - count)) }
fn left(value: u32, count: u32) -> u32 { ret (value << count) | (value >> (32_u32 - count)) }
fn padded(input: str) -> str {
    let mut data = input + byte(128_u8)
    while data.byte_len() % 64_usize != 56_usize { data = data + byte(0_u8) }
    let length = (input.byte_len() as u64) * 8_u64
    for i in 0_usize..8_usize { data = data + byte((length >> ((7_usize-i)*8_usize) as u64) as u8) }
    ret data
}
fn word(data: str, offset: usize) -> u32 {
    ret ((data.byte_at(offset) as u32) << 24_u32) | ((data.byte_at(offset+1_usize) as u32) << 16_u32) | ((data.byte_at(offset+2_usize) as u32) << 8_u32) | (data.byte_at(offset+3_usize) as u32)
}
fn digest(words: Vec[u32]) -> str {
    let mut out = ""
    for value in words { for i in 0_usize..4_usize { out = out + byte((value >> ((3_usize-i)*8_usize) as u32) as u8) } }
    ret out
}
pub fn sha1(input: str) -> str {
    let data = padded(input)
    let mut state = vec![1732584193_u32, 4023233417_u32, 2562383102_u32, 271733878_u32, 3285377520_u32]
    let mut offset = 0_usize
    while offset < data.byte_len() {
        let mut w = Vec[u32]::new()
        for i in 0_usize..16_usize { w.push(word(data, offset + i*4_usize)) }
        for i in 16_usize..80_usize { w.push(left(w.get(i-3_usize).unwrap_or(0_u32) ^ w.get(i-8_usize).unwrap_or(0_u32) ^ w.get(i-14_usize).unwrap_or(0_u32) ^ w.get(i-16_usize).unwrap_or(0_u32), 1_u32)) }
        let mut a = state.get(0_usize).unwrap_or(0_u32)
        let mut b = state.get(1_usize).unwrap_or(0_u32)
        let mut c = state.get(2_usize).unwrap_or(0_u32)
        let mut d = state.get(3_usize).unwrap_or(0_u32)
        let mut e = state.get(4_usize).unwrap_or(0_u32)
        for i in 0_usize..80_usize {
            let f = if i < 20_usize { (b & c) | ((b ^ 4294967295_u32) & d) } elif i < 40_usize { b ^ c ^ d } elif i < 60_usize { (b & c) | (b & d) | (c & d) } else { b ^ c ^ d }
            let k = if i < 20_usize { 1518500249_u32 } elif i < 40_usize { 1859775393_u32 } elif i < 60_usize { 2400959708_u32 } else { 3395469782_u32 }
            let next = left(a, 5_u32) + f + e + k + w.get(i).unwrap_or(0_u32)
            e = d d = c c = left(b, 30_u32) b = a a = next
        }
        let values = vec![a,b,c,d,e]
        for i in 0_usize..5_usize { state.set(i, state.get(i).unwrap_or(0_u32) + values.get(i).unwrap_or(0_u32)) }
        offset += 64_usize
    }
    ret digest(state)
}
pub fn sha256(input: str) -> str {
    let k = vec![1116352408_u32,1899447441_u32,3049323471_u32,3921009573_u32,961987163_u32,1508970993_u32,2453635748_u32,2870763221_u32,3624381080_u32,310598401_u32,607225278_u32,1426881987_u32,1925078388_u32,2162078206_u32,2614888103_u32,3248222580_u32,3835390401_u32,4022224774_u32,264347078_u32,604807628_u32,770255983_u32,1249150122_u32,1555081692_u32,1996064986_u32,2554220882_u32,2821834349_u32,2952996808_u32,3210313671_u32,3336571891_u32,3584528711_u32,113926993_u32,338241895_u32,666307205_u32,773529912_u32,1294757372_u32,1396182291_u32,1695183700_u32,1986661051_u32,2177026350_u32,2456956037_u32,2730485921_u32,2820302411_u32,3259730800_u32,3345764771_u32,3516065817_u32,3600352804_u32,4094571909_u32,275423344_u32,430227734_u32,506948616_u32,659060556_u32,883997877_u32,958139571_u32,1322822218_u32,1537002063_u32,1747873779_u32,1955562222_u32,2024104815_u32,2227730452_u32,2361852424_u32,2428436474_u32,2756734187_u32,3204031479_u32,3329325298_u32]
    let mut state = vec![1779033703_u32,3144134277_u32,1013904242_u32,2773480762_u32,1359893119_u32,2600822924_u32,528734635_u32,1541459225_u32]
    let data = padded(input)
    let mut offset = 0_usize
    while offset < data.byte_len() {
        let mut w = Vec[u32]::new()
        for i in 0_usize..16_usize { w.push(word(data, offset + i*4_usize)) }
        for i in 16_usize..64_usize {
            let x = w.get(i-15_usize).unwrap_or(0_u32)
            let y = w.get(i-2_usize).unwrap_or(0_u32)
            let s0 = rotate(x,7_u32) ^ rotate(x,18_u32) ^ (x >> 3_u32)
            let s1 = rotate(y,17_u32) ^ rotate(y,19_u32) ^ (y >> 10_u32)
            w.push(w.get(i-16_usize).unwrap_or(0_u32) + s0 + w.get(i-7_usize).unwrap_or(0_u32) + s1)
        }
        let mut a=state.get(0_usize).unwrap_or(0_u32) let mut b=state.get(1_usize).unwrap_or(0_u32)
        let mut c=state.get(2_usize).unwrap_or(0_u32) let mut d=state.get(3_usize).unwrap_or(0_u32)
        let mut e=state.get(4_usize).unwrap_or(0_u32) let mut f=state.get(5_usize).unwrap_or(0_u32)
        let mut g=state.get(6_usize).unwrap_or(0_u32) let mut h=state.get(7_usize).unwrap_or(0_u32)
        for i in 0_usize..64_usize {
            let s1=rotate(e,6_u32) ^ rotate(e,11_u32) ^ rotate(e,25_u32)
            let ch=(e & f) ^ ((e ^ 4294967295_u32) & g)
            let t1=h+s1+ch+k.get(i).unwrap_or(0_u32)+w.get(i).unwrap_or(0_u32)
            let s0=rotate(a,2_u32) ^ rotate(a,13_u32) ^ rotate(a,22_u32)
            let maj=(a & b) ^ (a & c) ^ (b & c)
            let t2=s0+maj
            h=g g=f f=e e=d+t1 d=c c=b b=a a=t1+t2
        }
        let values=vec![a,b,c,d,e,f,g,h]
        for i in 0_usize..8_usize { state.set(i,state.get(i).unwrap_or(0_u32)+values.get(i).unwrap_or(0_u32)) }
        offset+=64_usize
    }
    ret digest(state)
}
pub fn hmac_sha256(key: str, message: str) -> str {
    let mut secret = if key.byte_len() > 64_usize { sha256(key) } else { key }
    while secret.byte_len() < 64_usize { secret = secret + byte(0_u8) }
    let mut inner="" let mut outer=""
    for i in 0_usize..64_usize { inner=inner+byte(secret.byte_at(i)^54_u8) outer=outer+byte(secret.byte_at(i)^92_u8) }
    ret sha256(outer+sha256(inner+message))
}
pub fn hex(bytes: str) -> str {
    let digits="0123456789abcdef" let mut out=""
    for i in 0_usize..bytes.byte_len() { let b=bytes.byte_at(i) as usize out=out+digits.slice_bytes(b/16_usize,1_usize)+digits.slice_bytes(b%16_usize,1_usize) }
    ret out
}
pub fn base64(bytes: str) -> str {
    let alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let mut out="" let mut i=0_usize
    while i<bytes.byte_len() {
        let a=bytes.byte_at(i) as usize let b=bytes.byte_at(i+1_usize) as usize let c=bytes.byte_at(i+2_usize) as usize
        out=out+alphabet.slice_bytes(a>>2_usize,1_usize)+alphabet.slice_bytes(((a & 3_usize)<<4_usize)|(b>>4_usize),1_usize)
        out=out+if i+1_usize<bytes.byte_len() { alphabet.slice_bytes(((b & 15_usize)<<2_usize)|(c>>6_usize),1_usize) } else { "=" }
        out=out+if i+2_usize<bytes.byte_len() { alphabet.slice_bytes(c & 63_usize,1_usize) } else { "=" }
        i+=3_usize
    }
    ret out
}
pub fn constant_time_equal(a: str, b: str) -> bool {
    if a.byte_len()!=b.byte_len() { ret false }
    let mut difference=0_u8
    for i in 0_usize..a.byte_len() { difference=difference | (a.byte_at(i)^b.byte_at(i)) }
    ret difference==0_u8
}
