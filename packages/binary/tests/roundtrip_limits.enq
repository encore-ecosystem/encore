import binary
import core::result::Result
import core::vec::Vec
import serialize::Limits
struct Leaf {
    value: u32
}
struct Pair {
    first: Leaf<H>
    second: Leaf<H>
}
fn main() -> u32 {
    let leaf = Leaf<H>{ 42_u32 }
    let encoded = match binary::encode(Pair { leaf, leaf }) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let mut restored = match binary::decode[Pair](encoded) {
        Ok(value) => value Err(_) => {
            ret 2
        }
    }
    restored.first.value = 7_u32
    if restored.second.value != 42_u32 {
        ret 3
    }
    let mut numbers = Vec[u32]::with_capacity(100000)
    let mut index = 0_usize
    while index < 100000 {
        numbers.push(index as u32) index += 1
    }
    let bytes = match binary::encode(numbers) {
        Ok(value) => value Err(_) => {
            ret 4
        }
    }
    if bytes.len() != 400026 {
        ret 5
    }
    let values = match binary::decode[Vec[u32]](bytes) {
        Ok(value) => value Err(_) => {
            ret 6
        }
    }
    if values.len() != 100000 || values.get(99999).unwrap_or(0) != 99999_u32 {
        ret 7
    }
    if binary::decode_with[Vec[u32]](bytes, binary::DecodeOptions::new().with_limits(Limits::new().with_max_allocation_bytes(128))).is_ok() {
        ret 8
    }
    ret 0
}
