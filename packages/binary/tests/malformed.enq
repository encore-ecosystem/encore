//! Lengths and field identities are validated before constructing values.
import binary
import core::option::Option
import core::result::Result
import core::vec::Vec
import serialize::ErrorKind
struct Pair {
    a: u32
    b: u32
}
struct Subset {
    a: u32
    missing: Option[str]
}
struct Renamed {
    #serialize(rename = "a") name: u32
}
struct Collision {
    #serialize(rename = "same") a: u32
    #serialize(rename = "same") b: u32
}
fn copy(bytes: Vec[u8]) -> Vec[u8] {
    let mut result = Vec[u8]::new()
    for byte in bytes {
        result.push(byte)
    }
    ret result
}
fn main() -> u32 {
    let bytes = match binary::encode(Pair { 42_u32, 7_u32 }) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    match binary::decode[Subset](bytes) {
        Ok(value) => {
            if value.a != 42_u32 || value.missing.is_some() {
                ret 2
            }
        }
        Err(_) => {
            ret 3
        }
    }
    match binary::decode[Renamed](bytes) {
        Ok(value) => {
            if value.name != 42_u32 {
                ret 4
            }
        }
        Err(_) => {
            ret 5
        }
    }
    let mut duplicate = copy(bytes)
    let mut index = 0_usize
    while index < 8 {
        duplicate.set(46 + index, bytes.get(25 + index).unwrap_or(0)) index += 1
    }
    match binary::decode[Pair](duplicate) {
        Err(error) => {
            match error.kind() {
                ErrorKind::DuplicateField => {
                }
                _ => {
                    ret 6
                }
            }
        }
        Ok(_) => {
            ret 7
        }
    }
    let mut version = copy(bytes)
    version.set(4, 2_u8)
    match binary::decode[Pair](version) {
        Err(error) => {
            match error.kind() {
                ErrorKind::UnsupportedVersion => {
                }
                _ => {
                    ret 8
                }
            }
        }
        Ok(_) => {
            ret 9
        }
    }
    let mut oversized = copy(bytes)
    index = 9
    while index < 17 {
        oversized.set(index, 255_u8) index += 1
    }
    if binary::decode[Pair](oversized).is_ok() {
        ret 10
    }
    let mut trailing = copy(bytes)
    trailing.push(0_u8)
    if binary::decode[Pair](trailing).is_ok() {
        ret 11
    }
    let mut text = match binary::encode("x") {
        Ok(value) => value Err(_) => {
            ret 12
        }
    }
    text.set(17, 255_u8)
    if binary::decode[str](text).is_ok() {
        ret 13
    }
    let mut packed = match binary::encode(vec![42_u32]) {
        Ok(value) => value Err(_) => {
            ret 14
        }
    }
    index = 18
    while index < 26 {
        packed.set(index, 255_u8) index += 1
    }
    if binary::decode[Vec[u32]](packed).is_ok() {
        ret 15
    }
    if binary::encode(Collision { 1_u32, 2_u32 }).is_ok() {
        ret 16
    }
    ret 0
}
