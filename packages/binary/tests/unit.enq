import binary
import core::result::Result
fn main() -> u32 {
    let encoded = match binary::encode(()) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    match binary::decode[()](encoded) {
        Ok(_) => {
            ret 0
        }
        Err(_) => {
            ret 2
        }
    }
}
