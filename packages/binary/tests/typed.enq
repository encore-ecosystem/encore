import binary
import binary::{BinarySerializer, BinaryDeserializer}
import core::fmt::Debug
import core::option::Option
import core::result::Result
import core::vec::Vec
import serialize::{Serializer, Deserializer, Limits}
import std::io::eprintln
extern fn encore_codec_f64_from_bits(bits: u64) -> f64
extern fn encore_codec_f64_bits(value: f64) -> u64
struct Sample {
    name: str
    count: u64
    values: Vec[f64]
    optional: Option[u32]
}
enum Event {
    Empty
    Data(Sample)
}
struct Renamed {
    #serialize(rename = "old_name") new_name: u32
}
fn main() -> u32 {
    let negative_zero = unsafe {
        encore_codec_f64_from_bits(0x8000000000000000_u64)
    }
    let nan = unsafe {
        encore_codec_f64_from_bits(0x7ff8000000001234_u64)
    }
    let source = Sample {
        "Камень 🪨", 18446744073709551615_u64, vec![negative_zero, nan], Option[u32]::Some(42_u32)
    }
    let encoded = match binary::encode(source) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let decoded = match binary::decode[Sample](encoded) {
        Ok(value) => value Err(error) => {
            eprintln(error.message() + " at " + error.path() + " byte " + Debug::fmt(error.offset().unwrap_or(0))) ret 2
        }
    }
    if decoded.name != source.name || decoded.count != source.count || decoded.values.len() != 2 {
        ret 3
    }
    if unsafe {
        encore_codec_f64_bits(decoded.values.get(0).unwrap_or(1.0))
    }
    != 0x8000000000000000_u64 {
        ret 4
    }
    if unsafe {
        encore_codec_f64_bits(decoded.values.get(1).unwrap_or(1.0))
    }
    != 0x7ff8000000001234_u64 {
        ret 5
    }
    let packed = match binary::encode(vec![1_u32, 2_u32, 3_u32]) {
        Ok(value) => value Err(_) => {
            ret 6
        }
    }
    if packed.len() != 38 {
        ret 7
    }
    if binary::decode[Vec[u16]](packed).is_ok() {
        ret 8
    }
    let mut truncated = Vec[u8]::new()
    for byte in encoded {
        truncated.push(byte)
    }
    truncated.pop()
    if binary::decode[Sample](truncated).is_ok() {
        ret 9
    }
    let event = match binary::encode(Event::Data(source)) {
        Ok(value) => value Err(_) => {
            ret 10
        }
    }
    match binary::decode[Event](event) {
        Ok(value) => {
            match value {
                Data(item) => {
                    if item.name != source.name {
                        ret 11
                    }
                }
                _ => {
                    ret 12
                }
            }
        }
        Err(_) => {
            ret 13
        }
    }
    let tuple = match binary::encode((42_u32, "ok")) {
        Ok(value) => value Err(_) => {
            ret 14
        }
    }
    match binary::decode[(u32, str)](tuple) {
        Ok(value) => {
            if value.0 != 42_u32 || value.1 != "ok" {
                ret 15
            }
        }
        Err(_) => {
            ret 16
        }
    }
    if binary::decode_with[Sample](encoded, binary::DecodeOptions::new().with_limits(Limits::new().with_max_allocation_bytes(1))).is_ok() {
        ret 17
    }
    let via_trait = match Serializer::serialize(BinarySerializer::new(source)) {
        Ok(value) => value Err(_) => {
            ret 18
        }
    }
    match BinaryDeserializer[Sample]::new(via_trait).deserialize() {
        Ok(value) => {
            if value.count != source.count {
                ret 19
            }
        }
        Err(_) => {
            ret 20
        }
    }
    let rename_data = match binary::encode(Renamed { 42_u32 }) {
        Ok(value) => value Err(_) => {
            ret 30
        }
    }
    match binary::decode[Renamed](rename_data) {
        Ok(value) => {
            if value.new_name != 42_u32 {
                ret 31
            }
        }
        Err(_) => {
            ret 32
        }
    }
    ret 0
}
