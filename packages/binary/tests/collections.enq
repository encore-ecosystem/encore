import binary
import core::option::Option
import core::result::Result
import core::vec::Vec
import std::dict::Dict
struct Envelope[T] {
    label: str
    value: T
}
fn main() -> u32 {
    let mut map = Dict[u32, Option[str]]::new()
    map.insert(10_u32, Option[str]::Some("present"))
    map.insert(20_u32, Option[str]::None)
    let bytes = match binary::encode(map) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let restored = match binary::decode[Dict[u32, Option[str]]](bytes) {
        Ok(value) => value Err(_) => {
            ret 2
        }
    }
    if restored.len() != 2 || restored.get(10_u32).unwrap_or(Option[str]::None).unwrap_or("") != "present" {
        ret 3
    }
    let item = Envelope[Vec[u32]] { "nested", vec![10_u32, 20_u32] }
    let value = Result[Envelope[Vec[u32]], str]::Ok(item)
    let data = match binary::encode(value) {
        Ok(value) => value Err(_) => {
            ret 4
        }
    }
    match binary::decode[Result[Envelope[Vec[u32]], str]](data) {
        Ok(decoded) => {
            match decoded {
                Ok(payload) => {
                    if payload.label != "nested" || payload.value.len() != 2 {
                        ret 5
                    }
                }
                Err(_) => {
                    ret 6
                }
            }
        }
        Err(_) => {
            ret 7
        }
    }
    ret 0
}
