//! Sequentially consistent atomics. Copying a handle shares the same cell.
import core::panic::panic
import core::result::Result

import platform::sync as native
import platform::sync::__Lease

pub struct AtomicU64 {
    state: __Lease
}

impl for AtomicU64 {
    #attr(safe)
    pub fn new(value: u64) -> Self {
        let handle = native::encore_sync_atomic_new(value)
        if handle == 0_usize {
            panic("cannot allocate atomic cell")
        }
        ret Self { native::__adopt(handle) }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn load(self: Self) -> u64 {
        ret native::encore_sync_atomic_load(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn store(self: Self, value: u64) ->() {
        native::encore_sync_atomic_store(self.state.raw(), value)
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn swap(self: Self, value: u64) -> u64 {
        ret native::encore_sync_atomic_fetch(self.state.raw(), value, 5_u32)
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn compare_exchange(self: Self, expected: u64, desired: u64) -> Result[u64, u64] {
        let actual = native::encore_sync_atomic_compare_exchange(self.state.raw(), expected, desired)
        ret if actual == expected {
            Result[u64, u64]::Ok(actual)
        } else {
            Result[u64, u64]::Err(actual)
        }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn fetch_add(self: Self, value: u64) -> u64 {
        ret native::encore_sync_atomic_fetch(self.state.raw(), value, 0_u32)
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn fetch_sub(self: Self, value: u64) -> u64 {
        ret native::encore_sync_atomic_fetch(self.state.raw(), value, 1_u32)
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn fetch_and(self: Self, value: u64) -> u64 {
        ret native::encore_sync_atomic_fetch(self.state.raw(), value, 2_u32)
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn fetch_or(self: Self, value: u64) -> u64 {
        ret native::encore_sync_atomic_fetch(self.state.raw(), value, 3_u32)
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn fetch_xor(self: Self, value: u64) -> u64 {
        ret native::encore_sync_atomic_fetch(self.state.raw(), value, 4_u32)
    }
}

pub struct AtomicBool {
    value: AtomicU64
}

impl for AtomicBool {
    pub fn new(value: bool) -> Self {
        ret Self {
            AtomicU64::new(if value {
                    1_u64
                } else {
                    0_u64
                }
            )
        }
    }
    #attr(borrowed_self)
    pub fn load(self: Self) -> bool {
        ret self.value.load() != 0_u64
    }
    #attr(borrowed_self)
    pub fn store(self: Self, value: bool) ->() {
        self.value.store(if value {
                1_u64
            } else {
                0_u64
            }
        )
    }
    #attr(borrowed_self)
    pub fn swap(self: Self, value: bool) -> bool {
        ret self.value.swap(if value {
                1_u64
            } else {
                0_u64
            }
        ) != 0_u64
    }
    #attr(borrowed_self)
    pub fn compare_exchange(self: Self, expected: bool, desired: bool) -> Result[bool, bool] {
        match self.value.compare_exchange(if expected {
                1_u64
            } else {
                0_u64
            }
            , if desired {
                1_u64
            } else {
                0_u64
            }
            ,
        ) {
            Result::Ok(value) => {
                ret Result[bool, bool]::Ok(value != 0_u64)
            }
            Result::Err(value) => {
                ret Result[bool, bool]::Err(value != 0_u64)
            }
        }
    }
    #attr(borrowed_self)
    pub fn fetch_and(self: Self, value: bool) -> bool {
        ret self.value.fetch_and(if value {
                1_u64
            } else {
                0_u64
            }
        ) != 0_u64
    }
    #attr(borrowed_self)
    pub fn fetch_or(self: Self, value: bool) -> bool {
        ret self.value.fetch_or(if value {
                1_u64
            } else {
                0_u64
            }
        ) != 0_u64
    }
    #attr(borrowed_self)
    pub fn fetch_xor(self: Self, value: bool) -> bool {
        ret self.value.fetch_xor(if value {
                1_u64
            } else {
                0_u64
            }
        ) != 0_u64
    }
}
