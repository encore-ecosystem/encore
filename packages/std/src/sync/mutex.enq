//! A guarded owned slot. Values leave the lock only by exclusive transfer.
import core::future::{Context, Future, Poll}
import core::ops::ContextManager
import core::option::Option
import core::panic::panic
import core::result::Result

import std::future::block_on

import platform::sync as native
import platform::sync::__Lease

pub enum MutexError {
    WouldBlock
    WouldDeadlock
    Released
}
pub struct GuardError[T] {
    value: T
}
pub struct Mutex[T] {
    state: __Lease
}
pub struct MutexGuard[T] {
    state: __Lease
}
pub struct LockFuture[T] {
    mutex: Mutex[T]
    registration: __Lease
}

#attr(safe)
#attr(reflection_template)
fn boxed[T](value: sending T) -> __Lease {
    let payload = native::__payload_new[T](value)
    let handle = native::encore_sync_box_new(payload, native::__payload_drop_address[T]())
    if handle == 0_usize {
        native::__payload_drop[T](payload) panic("cannot allocate mutex value")
    }
    ret native::__adopt(handle)
}
#attr(safe)
fn take[T](handle: usize) -> sending Option[T] {
    if handle == 0_usize {
        ret Option::None
    }
    let owned = native::__adopt(handle)
    let payload = native::encore_sync_box_take(owned.raw())
    if payload == 0_usize {
        panic("mutex payload already consumed") ret Option::None
    }
    ret Option::Some(native::__payload_take[T](payload))
}

impl[T] for Mutex[T] {
    #attr(safe)
    #attr(reflection_template)
    #attr(scoped_reflection_template)
    pub fn new(value: sending T) -> Self {
        let storage = boxed[T](value)
        let handle = native::encore_sync_mutex_new(storage.raw())
        if handle == 0_usize {
            panic("cannot allocate mutex")
        }
        ret Self { native::__adopt(handle) }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn try_lock(self: Self) -> Result[MutexGuard[T], MutexError] {
        let handle = native::encore_sync_mutex_acquire(self.state.raw())
        if handle == 0_usize {
            ret Result::Err(MutexError::WouldBlock)
        }
        if handle == 18446744073709551614_usize {
            ret Result::Err(MutexError::WouldDeadlock)
        }
        if handle == 18446744073709551615_usize {
            panic("cannot allocate mutex guard")
        }
        ret Result::Ok(MutexGuard[T] { native::__adopt(handle) })
    }
    #attr(safe)
    pub fn lock_async(self: Self) -> LockFuture[T] {
        ret LockFuture[T] {
            self, native::__adopt(0_usize)
        }
    }
    pub fn lock(self: Self) -> Result[MutexGuard[T], MutexError] {
        ret block_on[Result[MutexGuard[T], MutexError], LockFuture[T]](self.lock_async())
    }
}

impl[T] Future[Result[MutexGuard[T], MutexError]] for LockFuture[T] {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[MutexGuard[T], MutexError]] {
        loop {
            match self.mutex.try_lock() {
                Result[MutexGuard[T], MutexError]::Ok(guard) => {
                    ret Poll::Ready(Result::Ok(guard))
                }
                Result[MutexGuard[T], MutexError]::Err(error) => {
                    match error {
                        MutexError::WouldDeadlock => {
                            ret Poll::Ready(Result::Err(error))
                        }
                        _ => {
                        }
                    }
                }
            }
            let handle = native::encore_sync_mutex_register(self.mutex.state.raw(), context.waker.raw_token())
            if handle == 18446744073709551615_usize {
                panic("cannot allocate mutex registration")
            }
            if handle != 0_usize {
                ret Poll::Pending(Self { self.mutex, native::__adopt(handle) })
            }
        }
    }
}

impl[T] for MutexGuard[T] {
    #attr(safe)
    #attr(borrowed_self)
    pub fn release(self: Self) ->() {
        native::encore_sync_guard_close(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn take(self: Self) -> sending Result[Option[T], MutexError] {
        if !native::encore_sync_guard_active(self.state.raw()) {
            ret Result::Err(MutexError::Released)
        }
        ret Result::Ok(take[T](native::encore_sync_guard_replace(self.state.raw(), 0_usize)))
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn replace(self: Self, value: sending T) -> sending Result[Option[T], GuardError[T]] {
        if !native::encore_sync_guard_active(self.state.raw()) {
            ret Result::Err(GuardError[T] {
                    value
                }
            )
        }
        let replacement = boxed[T](value)
        ret Result::Ok(take[T](native::encore_sync_guard_replace(self.state.raw(), replacement.raw())))
    }
}

impl[T] ContextManager for MutexGuard[T] {
    pub fn with_enter(self: Self) -> Self {
        ret self
    }
    pub fn with_exit(self: Self) -> bool {
        self.release() ret true
    }
}
