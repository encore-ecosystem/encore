//! Share immutable snapshots across threads without exposing mutable aliases.
import core::panic::panic
import platform::sync as native
import platform::sync::__Lease

pub struct Frozen[T] {
    state: __Lease
}

impl[T] for Frozen[T] {
    #attr(safe)
    #attr(reflection_template)
    #attr(scoped_reflection_template)
    pub fn new(value: frozen T) -> Self {
        let payload = freeze_payload[T](value)
        let handle = native::encore_sync_box_new(payload, native::__payload_drop_address[T]())
        if handle == 0_usize {
            native::__payload_drop[T](payload) panic("cannot allocate frozen snapshot")
        }
        ret Self { native::__adopt(handle) }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn get(self: Self) -> frozen T {
        ret read_payload[T](native::encore_sync_box_peek(self.state.raw()))
    }
}
fn freeze_payload[T](value: frozen T) -> usize {
    unsafe {
        unsafe ehir {
            zero: usize = lcpos 0_usize
            one: usize = lcpos 1_usize
            empty: T * = pcast zero: usize, T *
            pointer: T * = hrealloc empty: T *, one: usize
            store value: T, pointer: T *
            token: usize = pcast pointer: T *, usize
        }
        ret token
    }
}
#attr(borrowed_return)
fn read_payload[T](token: usize) -> frozen T {
    unsafe {
        unsafe ehir {
            pointer: T * = pcast token: usize, T *
            item: T = load pointer: T *
        }
        ret item
    }
}
