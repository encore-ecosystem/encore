//! Cooperative cancellation. Dropping a token does not request cancellation.
import core::future::{Context, Future, Poll, Waker}
import core::option::Option
import core::panic::panic

import platform::sync as native
import platform::sync::__Lease

pub struct CancellationToken {
    state: __Lease
}

impl for CancellationToken {
    #attr(safe)
    pub fn new() -> Self {
        let handle = native::encore_sync_cancel_new(0_usize)
        if handle == 0_usize {
            panic("cannot allocate cancellation token")
        }
        ret Self { native::__adopt(handle) }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn child(self: Self) -> Self {
        let handle = native::encore_sync_cancel_new(self.state.raw())
        if handle == 0_usize {
            panic("cannot allocate child cancellation token")
        }
        ret Self { native::__adopt(handle) }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn is_cancelled(self: Self) -> bool {
        ret native::encore_sync_cancelled(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn cancel(self: Self) ->() {
        native::encore_sync_cancel_request(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn wait(self: Self) ->() {
        if !native::encore_sync_cancel_wait(self.state.raw()) {
            panic("cannot allocate cancellation waiter")
        }
    }
    #attr(safe)
    pub fn cancelled(self: Self) -> Cancelled {
        ret Cancelled { self, native::__adopt(0_usize) }
    }
    /// SDK registration lease. None means cancellation is already observable.
    #attr(safe)
    #attr(borrowed_self)
    pub fn __register(self: Self, waker: Waker) -> Option[__Lease] {
        let handle = native::encore_sync_cancel_register(self.state.raw(), waker.raw_token())
        if handle == 0_usize {
            ret Option::None
        }
        if handle == 18446744073709551615_usize {
            panic("cannot allocate cancellation registration")
        }
        ret Option::Some(native::__adopt(handle))
    }
}

pub struct Cancelled {
    token: CancellationToken
    registration: __Lease
}

impl Future[()] for Cancelled {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self,()] {
        let registration = native::encore_sync_cancel_register(self.token.state.raw(), context.waker.raw_token())
        if registration == 0_usize {
            ret Poll[Self,()]::Ready(())
        }
        if registration == 18446744073709551615_usize {
            panic("cannot allocate cancellation registration")
        }
        ret Poll[Self,()]::Pending(Self { self.token, native::__adopt(registration) })
    }
}
