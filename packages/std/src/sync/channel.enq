//! Bounded MPSC channels. Senders share an endpoint; the receiver moves exclusively.
import core::future::{Context, Future, Poll}
import core::option::Option
import core::panic::panic
import core::result::Result

import std::future::block_on
import std::sync::cancellation::CancellationToken

import platform::sync as native
import platform::sync::__Lease

pub enum ChannelError {
    InvalidCapacity
    AllocationFailed
}
pub enum SendErrorKind {
    Full
    Closed
    Cancelled
    AlreadyCompleted
}
pub enum ReceiveError {
    Empty
    Closed
    Cancelled
}
pub struct SendError[T] {
    kind: SendErrorKind
    value: Option[T]
}
pub struct Sender[T] {
    state: __Lease
}
pub struct Receiver[T] {
    state: __Lease
}
pub struct SendFuture[T] {
    sender: Sender[T]
    boxed: __Lease
    cancel: CancellationToken
    registration: __Lease
    cancellation: __Lease
}
pub struct ReceiveFuture[T] {
    receiver: Receiver[T]
    cancel: CancellationToken
    registration: __Lease
    cancellation: __Lease
}

#attr(safe)
pub fn bounded[T](capacity: usize) -> sending Result[(Sender[T], Receiver[T]), ChannelError] {
    if capacity == 0_usize {
        ret Result::Err(ChannelError::InvalidCapacity)
    }
    let token = native::encore_sync_queue_new(capacity)
    if token == 0_usize {
        ret Result::Err(ChannelError::AllocationFailed)
    }
    let queue = native::__adopt(token)
    let sender = native::encore_sync_endpoint_new(queue.raw(), true)
    if sender == 0_usize {
        ret Result::Err(ChannelError::AllocationFailed)
    }
    let owned_sender = native::__adopt(sender)
    let receiver = native::encore_sync_endpoint_new(queue.raw(), false)
    if receiver == 0_usize {
        ret Result::Err(ChannelError::AllocationFailed)
    }
    ret Result::Ok((Sender[T] { owned_sender }, Receiver[T] { native::__adopt(receiver) }))
}

/// Consumes the pair after copying its sender, leaving one owned receiver.
pub fn into_receiver[T](pair: sending(Sender[T], Receiver[T])) -> sending Receiver[T] {
    ret pair.1
}

#attr(safe)
#attr(reflection_template)
fn box_value[T](value: sending T) -> __Lease {
    let payload = native::__payload_new[T](value)
    let token = native::encore_sync_box_new(payload, native::__payload_drop_address[T]())
    if token == 0_usize {
        native::__payload_drop[T](payload) panic("cannot allocate channel payload")
    }
    ret native::__adopt(token)
}
#attr(safe)
fn take_value[T](boxed: __Lease) -> sending Option[T] {
    let payload = native::encore_sync_box_take(boxed.raw())
    if payload == 0_usize {
        ret Option::None
    }
    ret Option::Some(native::__payload_take[T](payload))
}
fn send_kind(status: u32) -> SendErrorKind {
    ret if status == 1_u32 {
        SendErrorKind::Full
    } elif status == 2_u32 {
        SendErrorKind::Closed
    } elif status == 3_u32 {
        SendErrorKind::Cancelled
    } else {
        SendErrorKind::AlreadyCompleted
    }
}

impl[T] for Sender[T] {
    #attr(safe)
    #attr(borrowed_self)
    pub fn close(self: Self) ->() {
        native::encore_sync_endpoint_close(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn is_closed(self: Self) -> bool {
        ret native::encore_sync_queue_closed(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn try_send(self: Self, value: sending T) -> sending Result[(), SendError[T]] {
        let boxed = box_value[T](value)
        let status = native::encore_sync_queue_send(self.state.raw(), boxed.raw(), 0_usize)
        if status == 0_u32 {
            ret Result::Ok(())
        }
        ret Result::Err(SendError[T] { send_kind(status), take_value[T](boxed) })
    }
    pub fn send(self: Self, value: sending T) -> SendFuture[T] {
        ret self.send_cancellable(value, CancellationToken::new())
    }
    #attr(safe)
    pub fn send_cancellable(self: Self, value: sending T, cancel: CancellationToken) -> SendFuture[T] {
        ret SendFuture[T] {
            self, box_value[T](value), cancel, native::__adopt(0_usize), native::__adopt(0_usize)
        }
    }
    pub fn send_blocking(self: Self, value: sending T) -> sending Result[(), SendError[T]] {
        ret block_on[Result[(), SendError[T]], SendFuture[T]](self.send(value))
    }
}

impl[T] Future[Result[(), SendError[T]]] for SendFuture[T] {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[(), SendError[T]]] {
        loop {
            let status = native::encore_sync_queue_send(self.sender.state.raw(), self.boxed.raw(), self.cancel.state.raw())
            if status == 0_u32 {
                ret Poll::Ready(Result::Ok(()))
            }
            if status != 1_u32 {
                ret Poll::Ready(Result::Err(SendError[T] {
                            send_kind(status), take_value[T](self.boxed)
                        }
                    ))
            }
            let registration = native::encore_sync_queue_register(self.sender.state.raw(), context.waker.raw_token())
            if registration == 18446744073709551615_usize {
                panic("cannot allocate sender registration")
            }
            if registration != 0_usize {
                let owned = native::__adopt(registration)
                let cancellation = native::encore_sync_cancel_register(self.cancel.state.raw(), context.waker.raw_token())
                if cancellation == 18446744073709551615_usize {
                    panic("cannot allocate cancellation registration")
                }
                if cancellation != 0_usize {
                    ret Poll::Pending(Self {
                            self.sender, self.boxed, self.cancel, owned, native::__adopt(cancellation)
                        }
                    )
                }
            }
        }
    }
}

impl[T] for SendFuture[T] {
    /// Recovers an uncommitted payload, including a future returned by timeout.
    /// None means this payload was already committed or recovered by an alias.
    #attr(safe)
    pub fn into_unsent(self: Self) -> sending Option[T] {
        ret take_value[T](self.boxed)
    }
}

impl[T] for Receiver[T] {
    #attr(safe)
    #attr(borrowed_self)
    pub fn close(self: Self) ->() {
        native::encore_sync_endpoint_close(self.state.raw())
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn try_receive(self: Self) -> sending Result[T, ReceiveError] {
        let boxed = native::encore_sync_queue_receive(self.state.raw())
        if boxed != 0_usize {
            let owned = native::__adopt(boxed)
            let payload = native::encore_sync_box_take_received(owned.raw())
            let value = if payload == 0_usize {
                Option[T]::None
            } else {
                Option::Some(native::__payload_take[T](payload))
            }
            match value {
                Option[T]::Some(item) => {
                    ret Result::Ok(item)
                }
                Option[T]::None => {
                }
            }
            panic("channel payload was already consumed")
        }
        ret Result::Err(if native::encore_sync_queue_closed(self.state.raw()) {
                ReceiveError::Closed
            } else {
                ReceiveError::Empty
            }
        )
    }
    #attr(safe)
    pub fn receive(self: Self) -> ReceiveFuture[T] {
        ret self.receive_cancellable(CancellationToken::new())
    }
    #attr(safe)
    pub fn receive_cancellable(self: Self, cancel: CancellationToken) -> ReceiveFuture[T] {
        ret ReceiveFuture[T] { self, cancel, native::__adopt(0_usize), native::__adopt(0_usize) }
    }
    pub fn receive_blocking(self: Self) -> sending Result[T, ReceiveError] {
        ret block_on[Result[T, ReceiveError], ReceiveFuture[T]](self.receive())
    }
}

impl[T] Future[Result[T, ReceiveError]] for ReceiveFuture[T] {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[T, ReceiveError]] {
        loop {
            if self.cancel.is_cancelled() {
                ret Poll::Ready(Result::Err(ReceiveError::Cancelled))
            }
            match self.receiver.try_receive() {
                Result[T, ReceiveError]::Ok(value) => {
                    ret Poll::Ready(Result::Ok(value))
                }
                Result[T, ReceiveError]::Err(error) => {
                    match error {
                        ReceiveError::Closed => {
                            ret Poll::Ready(Result::Err(ReceiveError::Closed))
                        }
                        _ => {
                        }
                    }
                }
            }
            let registration = native::encore_sync_queue_register(self.receiver.state.raw(), context.waker.raw_token())
            if registration == 18446744073709551615_usize {
                panic("cannot allocate receiver registration")
            }
            if registration != 0_usize {
                let owned = native::__adopt(registration)
                let cancellation = native::encore_sync_cancel_register(self.cancel.state.raw(), context.waker.raw_token())
                if cancellation == 18446744073709551615_usize {
                    panic("cannot allocate cancellation registration")
                }
                if cancellation != 0_usize {
                    ret Poll::Pending(Self {
                            self.receiver, self.cancel, owned, native::__adopt(cancellation)
                        }
                    )
                }
            }
        }
    }
}
