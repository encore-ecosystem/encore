//! Provides filesystem operations.

import core::ops::ContextManager
import core::option::Option
import core::result::Result

import std::os::{file_exists, mkdir, mkdir_all, read_file, write_file}
import std::string::String
import std::vec::Vec

pub import platform::io::checked::File
import platform::io::checked::IoError

/// Reads a file in chunks. Unlike legacy read_to_str, reports open/read/close errors.
pub fn read(path: str) -> Result[str, IoError] {
    let file = File::open(path)?
    with file as stream {
        let data = stream.read_all()?
        stream.close()?
        ret Result::Ok(data)
    }
}

/// Writes a complete file and checks close-time errors as well as write errors.
pub fn write(path: str, data: str) -> Result[(), IoError] {
    let file = File::create(path)?
    with file as stream {
        stream.write_all(data)?
        stream.close()?
        ret Result::Ok(())
    }
}

extern fn encore_fs_remove_file(path: str) -> i32
extern fn encore_fs_read_dir(path: str) -> str

/// Returns whether `path` exists.
pub fn exists(path: str) -> bool {
    ret file_exists(path)
}

/// Reads a UTF-8 file into an owned string.
pub fn read_to_string(path: str) -> String {
    ret String::from_str(read_file(path))
}

/// Reads a UTF-8 file into a string value.
pub fn read_to_str(path: str) -> str {
    ret read_file(path)
}

/// Replaces a file with `contents` and returns the platform status code.
pub fn fs_write(path: str, contents: str) -> i32 {
    ret write_file(path, contents)
}

/// Removes a file and returns the platform status code.
#attr(safe)
pub fn remove_file(path: str) -> i32 {
    unsafe {
        ret encore_fs_remove_file(path)
    }
}

/// Creates one directory and returns the platform status code.
pub fn create_dir(path: str) -> i32 {
    ret mkdir(path)
}

/// Creates a directory and missing parents.
pub fn create_dir_all(path: str) -> i32 {
    ret mkdir_all(path)
}

/// Returns the names contained directly in a directory.
#attr(safe)
pub fn read_dir(path: str) -> Vec[str] {
    let raw = unsafe {
        encore_fs_read_dir(path)
    }
    ret split_lines(raw)
}

// Newline is ASCII: byte search avoids repeatedly decoding UTF-8 prefixes.
fn split_lines(value: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let total = value.byte_len()
    let mut start = 0_usize
    while start < total {
        let end = value.find_byte_from(10_u8, start)
        if end > start {
            out.push(value.slice_bytes(start, end - start))
        }
        if end >= total {
            break
        }
        start = end + 1_usize
    }
    ret out
}
