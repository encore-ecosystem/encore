//! Bounded OS-thread task groups. Dropping the last group cancels and joins.
import core::future::{Context, Future, Poll}
import core::option::Option
import core::panic::panic
import core::result::Result
import core::vec::Vec

import std::future::block_on
import std::sync::{CancellationToken, ReceiveError, Receiver, SendError, Sender, bounded}
import std::thread::JoinHandle

import platform::sync as native
import platform::sync::__Lease

pub trait TaskJob[Output] {
    fn run(self: Self, cancellation: CancellationToken) -> sending Result[Output, str]
}
pub enum TaskPolicy {
    CancelOnError
    CollectAll
}
pub enum TaskError {
    InvalidCapacity
    AllocationFailed
    Closed
    Busy
}
pub enum TaskOutcome[Output] {
    Completed(Output)
    Failed(str)
    Cancelled
}
pub struct TaskResult[Output] {
    id: u64
    outcome: TaskOutcome[Output]
}
pub enum SubmitErrorKind {
    Full
    Closed
    Cancelled
    IdExhausted
}
pub struct SubmitError[Job] {
    kind: SubmitErrorKind
    value: Option[Job]
}
pub struct TaskGroup[Job, Output] {
    state: __Lease
}
pub struct GroupJoinFuture[Job, Output] {
    group: TaskGroup[Job, Output]
    registration: __Lease
}
struct Queued[Job] {
    id: u64
    job: Job
}
struct Bundle[Job, Output] {
    workers: Vec[JoinHandle[u32]]
    senders: Vec[Sender[Queued[Job]]]
    receiver: Receiver[TaskResult[Output]]
    cancellation: CancellationToken
    submitted: u64
    results: Vec[TaskResult[Output]]
    closing: bool
    joined: bool
}
struct Builder[Job, Output] {
    cleanup: __Lease
    workers: Vec[JoinHandle[u32]]
    senders: Vec[Sender[Queued[Job]]]
    receiver: Receiver[TaskResult[Output]]
    cancellation: CancellationToken
}

fn worker[Job: TaskJob[Output], Output](input: sending Receiver[Queued[Job]], output: Sender[TaskResult[Output]], cancellation: CancellationToken, policy: TaskPolicy) -> u32 {
    loop {
        match input.receive_blocking() {
            Result[Queued[Job], ReceiveError]::Ok(queued) => {
                let outcome = if cancellation.is_cancelled() {
                    TaskOutcome[Output]::Cancelled
                } else {
                    match queued.job.run(cancellation.child()) {
                        Result[Output, str]::Ok(value) => TaskOutcome[Output]::Completed(value)
                        Result[Output, str]::Err(error) => {
                            match policy {
                                TaskPolicy::CancelOnError => {
                                    cancellation.cancel()
                                }
                                _ => {
                                }
                            }
                            TaskOutcome[Output]::Failed(error)
                        }
                    }
                }
                if output.send_blocking(TaskResult[Output] { queued.id, outcome }).is_err() {
                    break
                }
            }
            Result[Queued[Job], ReceiveError]::Err(_) => {
                break
            }
        }
    }
    ret 0_u32
}
#attr(safe)
fn access[Job, Output](state: __Lease) -> Bundle[Job, Output] {
    let payload = native::encore_sync_group_take(state.raw())
    if payload == 0_usize || payload == 18446744073709551615_usize {
        panic("task group is busy or belongs to a different thread")
    }
    ret native::__payload_take_local[Bundle[Job, Output]](payload)
}
#attr(safe)
fn restore[Job, Output](state: __Lease, bundle: Bundle[Job, Output]) ->() {
    let payload = native::__payload_new[Bundle[Job, Output]](bundle)
    if !native::encore_sync_group_put(state.raw(), payload) {
        native::__payload_drop[Bundle[Job, Output]](payload) panic("cannot restore task group")
    }
}
fn drain[Job, Output](bundle: mut Bundle[Job, Output]) ->() {
    loop {
        match bundle.receiver.try_receive() {
            Result[TaskResult[Output], ReceiveError]::Ok(value) => {
                bundle.results.push(value)
            }
            _ => {
                break
            }
        }
    }
}

impl[Job: TaskJob[Output], Output] for TaskGroup[Job, Output] {
    #attr(safe)
    #attr(reflection_template)
    #attr(scoped_reflection_template)
    pub fn new(workers: usize, capacity: usize) -> Result[Self, TaskError] {
        ret Self::with_policy(workers, capacity, TaskPolicy::CancelOnError)
    }
    #attr(safe)
    #attr(reflection_template)
    pub fn with_policy(workers: usize, capacity: usize, policy: TaskPolicy) -> Result[Self, TaskError] {
        if workers == 0_usize || workers > 256_usize || capacity == 0_usize {
            ret Result::Err(TaskError::InvalidCapacity)
        }
        let completed = match bounded[TaskResult[Output]](workers) {
            Ok(value) => value Err(_) => {
                ret Result::Err(TaskError::AllocationFailed)
            }
        }
        let cancellation = CancellationToken::new()
        let token = native::encore_sync_group_new(cancellation.state.raw(), completed.1.state.raw(), workers, native::__payload_drop_address[Bundle[Job, Output]]())
        if token == 0_usize {
            ret Result::Err(TaskError::AllocationFailed)
        }
        let mut builder = Builder[Job, Output] {
            native::__adopt(token), Vec[JoinHandle[u32]]::new(), Vec[Sender[Queued[Job]]]::new(), completed.1, cancellation
        }
        for _index in 0_usize..workers {
            let queued = native::encore_sync_queue_new(capacity)
            if queued == 0_usize {
                ret Result::Err(TaskError::AllocationFailed)
            }
            let queue = native::__adopt(queued)
            let sender_id = native::encore_sync_endpoint_new(queue.raw(), true)
            if sender_id == 0_usize {
                ret Result::Err(TaskError::AllocationFailed)
            }
            let sender = Sender[Queued[Job]] { native::__adopt(sender_id) }
            let receiver_id = native::encore_sync_endpoint_new(queue.raw(), false)
            if receiver_id == 0_usize {
                ret Result::Err(TaskError::AllocationFailed)
            }
            if !native::encore_sync_group_add_sender(builder.cleanup.raw(), sender.state.raw()) {
                let abandoned = native::__adopt(receiver_id) ret Result::Err(TaskError::AllocationFailed)
            }
            let handle = spawn worker[Job, Output](Receiver[Queued[Job]] {
                    native::__adopt(receiver_id)
                }
                , completed.0, cancellation, policy,)
            builder.senders.push(sender)
            builder.workers.push(handle)
        }
        let bundle = Bundle[Job, Output] {
            builder.workers, builder.senders, builder.receiver, builder.cancellation, 0_u64, Vec[TaskResult[Output]]::new(), false, false
        }
        restore[Job, Output](builder.cleanup, bundle)
        ret Result::Ok(Self { builder.cleanup })
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn cancellation(self: Self) -> CancellationToken {
        let bundle = access[Job, Output](self.state)
        let token = bundle.cancellation
        restore[Job, Output](self.state, bundle)
        ret token
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn cancel(self: Self) ->() {
        self.cancellation().cancel()
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn try_submit(self: Self, job: sending Job) -> sending Result[u64, SubmitError[Job]] {
        let mut bundle = access[Job, Output](self.state)
        drain[Job, Output](bundle)
        if bundle.closing || bundle.cancellation.is_cancelled() || bundle.submitted == 18446744073709551615_u64 {
            let kind = if bundle.closing {
                SubmitErrorKind::Closed
            } elif bundle.cancellation.is_cancelled() {
                SubmitErrorKind::Cancelled
            } else {
                SubmitErrorKind::IdExhausted
            }
            restore[Job, Output](self.state, bundle)
            ret Result::Err(SubmitError[Job] { kind, Option::Some(job) })
        }
        let id = bundle.submitted
        let mut pending = Option[Queued[Job]]::Some(Queued[Job] { id, job })
        let mut index = 0_usize
        while index < bundle.senders.len() {
            let queued = match pending {
                Option[Queued[Job]]::Some(value) => value _ => {
                    panic("task payload already consumed") break
                }
            }
            let sender = match bundle.senders.get((id as usize % bundle.senders.len() + index) % bundle.senders.len()) {
                Option[Sender[Queued[Job]]]::Some(value) => value _ => {
                    panic("missing worker sender") break
                }
            }
            match sender.try_send(queued) {
                Result[(), SendError[Queued[Job]]]::Ok(_) => {
                    bundle.submitted += 1_u64
                    restore[Job, Output](self.state, bundle)
                    ret Result::Ok(id)
                }
                Result[(), SendError[Queued[Job]]]::Err(error) => {
                    pending = error.value
                }
            }
            index += 1_usize
        }
        restore[Job, Output](self.state, bundle)
        let value = match pending {
            Option[Queued[Job]]::Some(queued) => Option[Job]::Some(queued.job) _ => Option[Job]::None
        }
        ret Result::Err(SubmitError[Job] { SubmitErrorKind::Full, value })
    }
    pub fn submit(self: Self, job: sending Job) -> sending Result[u64, SubmitError[Job]] {
        let mut pending = Option[Job]::Some(job)
        loop {
            let value = match pending {
                Option[Job]::Some(item) => item Option[Job]::None => {
                    ret Result::Err(SubmitError[Job] {
                            SubmitErrorKind::Closed, Option::None
                        }
                    )
                }
            }
            match self.try_submit(value) {
                Result[u64, SubmitError[Job]]::Ok(id) => {
                    ret Result::Ok(id)
                }
                Result[u64, SubmitError[Job]]::Err(error) => {
                    match error.kind {
                        SubmitErrorKind::Full => {
                            pending = error.value
                        }
                        _ => {
                            ret Result::Err(error)
                        }
                    }
                }
            }
            block_on[(), CapacityFuture[Job, Output]](CapacityFuture[Job, Output] {
                    self, native::__adopt(0_usize)
                }
            )
        }
    }
    #attr(safe)
    pub fn join(self: Self) -> GroupJoinFuture[Job, Output] {
        let mut bundle = access[Job, Output](self.state)
        bundle.closing = true
        for sender in bundle.senders {
            sender.close()
        }
        restore[Job, Output](self.state, bundle)
        ret GroupJoinFuture[Job, Output] { self, native::__adopt(0_usize) }
    }
}

impl[Job, Output] for GroupJoinFuture[Job, Output] {
    pub fn into_group(self: Self) -> TaskGroup[Job, Output] {
        ret self.group
    }
}

impl[Job: TaskJob[Output], Output] Future[Result[Vec[TaskResult[Output]], TaskError]] for GroupJoinFuture[Job, Output] {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[Vec[TaskResult[Output]], TaskError]] {
        loop {
            let mut bundle = access[Job, Output](self.group.state)
            if bundle.joined {
                restore[Job, Output](self.group.state, bundle) ret Poll::Ready(Result::Err(TaskError::Closed))
            }
            drain[Job, Output](bundle)
            if bundle.results.len() as u64 == bundle.submitted {
                for worker in bundle.workers {
                    worker.join()
                }
                let mut slots = Vec[Option[TaskResult[Output]]]::new()
                for _index in 0_usize..bundle.results.len() {
                    slots.push(Option[TaskResult[Output]]::None)
                }
                loop {
                    match bundle.results.pop() {
                        Option[TaskResult[Output]]::Some(result) => {
                            slots.set(result.id as usize, Option::Some(result))
                        }
                        Option[TaskResult[Output]]::None => {
                            break
                        }
                    }
                }
                let mut sorted = Vec[TaskResult[Output]]::new()
                for value in slots {
                    match value {
                        Option[TaskResult[Output]]::Some(result) => {
                            sorted.push(result)
                        }
                        _ => {
                        }
                    }
                }
                bundle.joined = true
                restore[Job, Output](self.group.state, bundle)
                ret Poll::Ready(Result::Ok(sorted))
            }
            restore[Job, Output](self.group.state, bundle)
            let handle = native::encore_sync_group_register(self.group.state.raw(), context.waker.raw_token(), true)
            if handle == 18446744073709551615_usize {
                panic("cannot allocate task group registration")
            }
            if handle != 0_usize {
                ret Poll::Pending(Self { self.group, native::__adopt(handle) })
            }
        }
    }
}

struct CapacityFuture[Job, Output] {
    group: TaskGroup[Job, Output]
    registration: __Lease
}

impl[Job, Output] Future[()] for CapacityFuture[Job, Output] {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self,()] {
        let handle = native::encore_sync_group_register(self.group.state.raw(), context.waker.raw_token(), false)
        if handle == 18446744073709551615_usize {
            panic("cannot allocate task submission registration")
        }
        if handle == 0_usize {
            ret Poll::Ready(())
        }
        ret Poll::Pending(Self { self.group, native::__adopt(handle) })
    }
}
