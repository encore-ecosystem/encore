//! Provides clocks, counters, and sleeping.

import core::option::Option

pub import platform::time::*

pub import mod::clock::{Clock, ClockError, ClockInstant, SystemClock, Timer, VirtualClock}
pub import mod::duration::Duration

/// An opaque monotonic clock reading, unrelated to wall-clock time.
pub struct Instant {
    ticks: u64
}

impl for Instant {
    #attr(safe)
    pub fn now() -> Self {
        ret Self {
            perf_counter_ns()
        }
    }
    pub fn duration_since(self: Self, earlier: Self) -> Option[Duration] {
        if self.ticks < earlier.ticks {
            ret Option::None
        }
        ret Option::Some(Duration::from_nanos(self.ticks - earlier.ticks))
    }
    /// Saturates to zero if the platform clock unexpectedly moves backwards.
    pub fn elapsed(self: Self) -> Duration {
        ret Instant::now().duration_since(self).unwrap_or(Duration::from_secs(0))
    }
}
