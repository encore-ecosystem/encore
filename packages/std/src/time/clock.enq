//! Explicit clock domains. Virtual time advances only when its owner requests it.
import core::future::{Context, Future, Poll}
import core::ops::ContextManager
import core::option::Option
import core::panic::panic
import core::result::Result

import std::time::duration::Duration

import platform::sync as native
import platform::sync::__Lease

pub enum ClockError {
    Closed
    Cancelled
    Overflow
    MismatchedClock
    NotVirtual
}
pub struct ClockInstant {
    domain: u64
    ticks: u64
}
pub struct Clock {
    state: __Lease
}
pub struct SystemClock {
}
pub struct VirtualClock {
    clock: Clock
}

impl for SystemClock {
    #attr(safe)
    pub fn new() -> Clock {
        let handle = native::encore_sync_clock_new(false, 0_u64)
        if handle == 0_usize {
            panic("cannot allocate system clock")
        }
        ret Clock { native::__adopt(handle) }
    }
}

impl for VirtualClock {
    #attr(safe)
    pub fn new() -> Self {
        let handle = native::encore_sync_clock_new(true, 0_u64)
        if handle == 0_usize {
            panic("cannot allocate virtual clock")
        }
        ret Self {
            Clock { native::__adopt(handle) }
        }
    }
    #attr(borrowed_self)
    pub fn clock(self: Self) -> Clock {
        ret self.clock
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn advance(self: Self, duration: Duration) -> Result[(), ClockError] {
        let delta = match duration.as_nanos() {
            Option[u64]::Some(value) => value
            Option[u64]::None => {
                ret Result::Err(ClockError::Overflow)
            }
        }
        match native::encore_sync_clock_advance(self.clock.state.raw(), delta) {
            0_u32 => {
                ret Result::Ok(())
            }
            1_u32 => {
                ret Result::Err(ClockError::NotVirtual)
            }
            2_u32 => {
                ret Result::Err(ClockError::Overflow)
            }
            _ => {
                ret Result::Err(ClockError::Closed)
            }
        }
    }
}

impl for ClockInstant {
    pub fn duration_since(self: Self, earlier: Self) -> Result[Duration, ClockError] {
        if self.domain != earlier.domain {
            ret Result::Err(ClockError::MismatchedClock)
        }
        if self.ticks < earlier.ticks {
            ret Result::Err(ClockError::Overflow)
        }
        ret Result::Ok(Duration::from_nanos(self.ticks - earlier.ticks))
    }
}

impl for Clock {
    #attr(safe)
    #attr(borrowed_self)
    pub fn now(self: Self) -> ClockInstant {
        ret ClockInstant {
            native::encore_sync_clock_domain(self.state.raw()), native::encore_sync_clock_now(self.state.raw())
        }
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn sleep(self: Self, duration: Duration) -> Result[Timer, ClockError] {
        let nanos = match duration.as_nanos() {
            Option[u64]::Some(value) => value
            Option[u64]::None => {
                ret Result::Err(ClockError::Overflow)
            }
        }
        let now = self.now()
        if nanos > 18446744073709551615_u64 - now.ticks {
            ret Result::Err(ClockError::Overflow)
        }
        ret self.sleep_until(ClockInstant { now.domain, now.ticks + nanos })
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn sleep_until(self: Self, deadline: ClockInstant) -> Result[Timer, ClockError] {
        if deadline.domain != native::encore_sync_clock_domain(self.state.raw()) {
            ret Result::Err(ClockError::MismatchedClock)
        }
        let handle = native::encore_sync_timer_new(self.state.raw(), deadline.ticks)
        if handle == 0_usize {
            panic("cannot allocate timer")
        }
        ret Result::Ok(Timer { native::__adopt(handle), native::__adopt(0_usize) })
    }
    #attr(safe)
    #attr(borrowed_self)
    pub fn close(self: Self) ->() {
        native::encore_sync_clock_close(self.state.raw())
    }
}
pub struct Timer {
    state: __Lease
    registration: __Lease
}

impl for Timer {
    #attr(safe)
    #attr(borrowed_self)
    pub fn cancel(self: Self) ->() {
        native::encore_sync_timer_cancel(self.state.raw())
    }
}

impl Future[Result[(), ClockError]] for Timer {
    #attr(safe)
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[(), ClockError]] {
        let handle = native::encore_sync_timer_register(self.state.raw(), context.waker.raw_token())
        if handle == 18446744073709551615_usize {
            panic("cannot allocate timer registration")
        }
        if handle != 0_usize {
            ret Poll::Pending(Self { self.state, native::__adopt(handle) })
        }
        let status = native::encore_sync_timer_status(self.state.raw())
        if status == 1_u32 {
            ret Poll::Ready(Result::Ok(()))
        }
        ret Poll::Ready(Result::Err(if status == 3_u32 {
                    ClockError::Closed
                } else {
                    ClockError::Cancelled
                }
            ))
    }
}

impl ContextManager for Clock {
    pub fn with_enter(self: Self) -> Self {
        ret self
    }
    pub fn with_exit(self: Self) -> bool {
        self.close() ret true
    }
}
