//! Blocking facade over the same HTTP request, response and error types.
import core::ops::ContextManager
import core::result::Result
import std::future::block_on
import std::http::async_client::{HTTPAsyncClient, HTTPResponseFuture}
import std::http::errors::{HTTPError, HTTPErrorKind}
import std::http::legacy::HttpClient
import std::http::types::{HttpRequest, HttpResponse, HttpClientConfig, Url}

pub struct HTTPSyncClient {
    config: HttpClientConfig
}

impl for HTTPSyncClient {
    pub fn new() -> Self {
        ret Self { HttpClientConfig::default() }
    }
    pub fn with_config(config: HttpClientConfig) -> Self {
        ret Self { config }
    }

    /// Sends one request; redirects and retries are never implicit.
    pub fn send(self: Self, request: HttpRequest) -> Result[HttpResponse, HTTPError] {
        ret send_sync(self.config, request)
    }
    pub fn get(self: Self, value: str) -> Result[HttpResponse, HTTPError] {
        let url = match Url::parse(value) {
            Result::Ok(url) => url
            Result::Err(_) => {
                ret Result::Err(HTTPError {
                        HTTPErrorKind::Configuration, "invalid HTTP request URL"
                    }
                    ,
                )
            }
        }
        ret self.send(HttpRequest::get(url))
    }
}

#cfg(linux)
fn send_sync(config: HttpClientConfig, request: HttpRequest) -> Result[HttpResponse, HTTPError] {
    let client = HTTPAsyncClient::with_capacity(1_usize)?.with_config(config)
    with client as client {
        ret block_on[Result[HttpResponse, HTTPError], HTTPResponseFuture](client.send(request))
    }
}

#cfg(not(linux))
fn send_sync(config: HttpClientConfig, request: HttpRequest) -> Result[HttpResponse, HTTPError] {
    match HttpClient::with_config(config).send(request) {
        Result::Ok(response) => {
            ret Result::Ok(response)
        }
        Result::Err(_) => {
            ret Result::Err(HTTPError { HTTPErrorKind::Io, "HTTP transfer failed" })
        }
    }
}
