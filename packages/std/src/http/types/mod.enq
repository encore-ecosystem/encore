//! Common request, response, URL and configuration types.
import core::fmt::Debug
import core::option::Option
import core::result::Result
import core::vec::Vec

/// A parsed HTTPS URL or explicit local IPv4 HTTP URL.
pub struct Url {
    scheme_value: str
    host_value: str
    port_value: usize
    target_value: str
}

/// One HTTP header. Header lookup is ASCII case-insensitive.
pub struct HttpHeader {
    name: str
    value: str
}

/// An HTTP/1.1 request.
pub struct HttpRequest {
    method: str
    url: Url
    headers: Vec[HttpHeader]
    body_value: str
}

/// A decoded HTTP/1.1 response.
pub struct HttpResponse {
    status_value: u16
    reason_value: str
    headers: Vec[HttpHeader]
    body_value: str
}

/// Limits redirects and response allocation for an HTTP client.
pub struct HttpClientConfig {
    ca_file: str
    max_redirects: usize
    max_body_size: usize
    timeout_ms: usize
    connect_timeout_ms: usize
    max_header_size: usize
}

impl for Url {
    pub fn empty() -> Self {
        ret Self {
            "", "", 0_usize, ""
        }
    }
    pub fn scheme(self: Self) -> str {
        ret self.scheme_value
    }
    pub fn host(self: Self) -> str {
        ret self.host_value
    }
    pub fn port(self: Self) -> usize {
        ret self.port_value
    }
    pub fn target(self: Self) -> str {
        ret self.target_value
    }

    /// Parses HTTPS, or HTTP on localhost/127.0.0.1 only. No user-info/fragments.
    pub fn parse(value: str) -> Result[Url, str] {
        let mut i = 0_usize
        while i < value.len() {
            let byte = value.byte_at(i)
            if byte <= 32_u8 || byte >= 127_u8 || byte == 92_u8 {
                ret Result::Err("URL must contain only escaped ASCII characters")
            }
            i += 1_usize
        }
        let local = starts_with(value, "http://")
        let prefix = if local {
            "http://"
        } else {
            "https://"
        }
        if !starts_with(value, prefix) {
            ret Result::Err("only HTTPS or loopback HTTP URLs are supported")
        }
        let remainder = value.slice(prefix.len(), value.len() - prefix.len())
        if contains(remainder, "@") {
            ret Result::Err("URL user-info is not supported")
        }
        if contains(remainder, "#") {
            ret Result::Err("URL fragments are not supported")
        }
        let slash = first_of(remainder, "/?")
        let authority = if slash < remainder.len() {
            remainder.slice(0_usize, slash)
        } else {
            remainder
        }
        if authority == "" {
            ret Result::Err("URL host is empty")
        }
        let mut host = authority
        let mut port = if local {
            80_usize
        } else {
            443_usize
        }
        let colon = last_index_of(authority, ":")
        if colon < authority.len() {
            host = authority.slice(0_usize, colon)
            let raw_port = authority.slice(colon + 1_usize, authority.len() - colon - 1_usize)
            match parse_decimal(raw_port) {
                Option::Some(value) => {
                    if value == 0_usize || value > 65535_usize {
                        ret Result::Err("URL port is out of range")
                    }
                    port = value
                }
                Option::None => {
                    ret Result::Err("URL port is invalid")
                }
            }
        }
        if host == "" || contains(host, "[") || contains(host, "]") {
            ret Result::Err("URL host is invalid")
        }
        if local && host != "localhost" && host != "127.0.0.1" {
            ret Result::Err("plaintext HTTP requires localhost or 127.0.0.1")
        }
        let target = if slash == remainder.len() {
            "/"
        } elif remainder.slice(slash, 1_usize) == "?" {
            "/" + remainder.slice(slash, remainder.len() - slash)
        } else {
            remainder.slice(slash, remainder.len() - slash)
        }
        ret Result::Ok(Self {
                if local {
                    "http"
                } else {
                    "https"
                }
                , host, port, target
            }
            ,
        )
    }
}

impl for HttpRequest {
    pub fn get(url: Url) -> Self {
        ret Self {
            "GET", url, Vec[HttpHeader]::new(), ""
        }
    }

    /// Creates a request. Validation happens before any network access in send.
    pub fn new(method: str, url: Url) -> Self {
        ret Self {
            method, url, Vec[HttpHeader]::new(), ""
        }
    }

    /// Sets the exact byte body; Content-Length is generated by the client.
    pub fn with_body(self: Self, body: str) -> Self {
        ret Self {
            self.method, self.url, self.headers, body
        }
    }

    /// Rejects invalid syntax and caller-controlled transport framing.
    pub fn validate(self: Self) -> Result[bool, str] {
        if invalid_header(self.method) {
            ret Result::Err("invalid HTTP method")
        }
        if (self.url.scheme_value != "https" && self.url.scheme_value != "http") || self.url.host_value == "" {
            ret Result::Err("invalid request URL")
        }
        if self.url.scheme_value == "http" && self.url.host_value != "localhost" && self.url.host_value != "127.0.0.1" {
            ret Result::Err("plaintext HTTP is restricted to IPv4 loopback")
        }
        for header in self.headers {
            if invalid_header(header.name) || invalid_header_value(header.value) {
                ret Result::Err("invalid HTTP request header")
            }
            let name = ascii_lower(header.name)
            if name == "host" || name == "content-length" || name == "transfer-encoding" ||
            name == "connection" || name == "expect" || name == "trailer" || name == "upgrade" || name == "accept-encoding" {
                ret Result::Err("HTTP transport headers are managed by the client")
            }
            if header_count(self.headers, name) != 1_usize {
                ret Result::Err("duplicate HTTP request header")
            }
        }
        ret Result::Ok(true)
    }

    pub fn with_header(self: mut Self, name: str, value: str) -> Self {
        self.headers.push(HttpHeader {
                name, value
            }
            ,
        )
        ret self
    }

    /// Encodes the request with safe default Host and Connection headers.
    pub fn encode(self: Self) -> str {
        if self.validate().is_err() {
            ret ""
        }
        let mut out = self.method + " " + self.url.target_value + " HTTP/1.1\r\nAccept-Encoding: identity\r\n"
        let default_port = if self.url.scheme_value == "http" {
            80_usize
        } else {
            443_usize
        }
        let authority = if self.url.port_value == default_port {
            self.url.host_value
        } else {
            self.url.host_value + ":" + Debug::fmt(self.url.port_value)
        }
        if !headers_contain(self.headers, "host") {
            out += "Host: " + authority + "\r\n"
        }
        if !headers_contain(self.headers, "connection") {
            out += "Connection: close\r\n"
        }
        if !headers_contain(self.headers, "user-agent") {
            out += "User-Agent: encore-http/0.1\r\n"
        }
        for header in self.headers {
            if invalid_header(header.name) || contains(header.value, "\r") || contains(header.value, "\n") {
                continue
            }
            out += header.name + ": " + header.value + "\r\n"
        }
        if self.body_value != "" || self.method == "POST" || self.method == "PUT" || self.method == "PATCH" {
            out += "Content-Length: " + Debug::fmt(self.body_value.len()) + "\r\n"
        }
        ret out + "\r\n" + self.body_value
    }
}

impl for HttpResponse {
    pub fn empty() -> Self {
        ret Self {
            0_u16, "", Vec[HttpHeader]::new(), ""
        }
    }
    pub fn status(self: Self) -> u16 {
        ret self.status_value
    }
    pub fn reason(self: Self) -> str {
        ret self.reason_value
    }
    pub fn body(self: Self) -> str {
        ret self.body_value
    }
    pub fn header(self: Self, name: str) -> Option[str] {
        for header in self.headers {
            if ascii_lower(header.name) == ascii_lower(name) {
                ret Option::Some(header.value)
            }
        }
        ret Option::None
    }
}

impl for HttpClientConfig {
    pub fn default() -> Self {
        ret Self {
            "", 5_usize, 16777216_usize, 30000_usize, 10000_usize, 65536_usize
        }
    }
    pub fn with_ca_file(self: Self, path: str) -> Self {
        ret Self {
            path, self.max_redirects, self.max_body_size, self.timeout_ms, self.connect_timeout_ms, self.max_header_size
        }
    }
    pub fn with_max_redirects(self: Self, value: usize) -> Self {
        ret Self {
            self.ca_file, value, self.max_body_size, self.timeout_ms, self.connect_timeout_ms, self.max_header_size
        }
    }
    pub fn with_max_body_size(self: Self, value: usize) -> Self {
        ret Self {
            self.ca_file, self.max_redirects, value, self.timeout_ms, self.connect_timeout_ms, self.max_header_size
        }
    }
    pub fn with_timeout_ms(self: Self, value: usize) -> Self {
        ret Self {
            self.ca_file, self.max_redirects, self.max_body_size, value, self.connect_timeout_ms, self.max_header_size
        }
    }
    pub fn with_connect_timeout_ms(self: Self, value: usize) -> Self {
        ret Self {
            self.ca_file, self.max_redirects, self.max_body_size, self.timeout_ms, value, self.max_header_size
        }
    }
    pub fn with_max_header_size(self: Self, value: usize) -> Self {
        ret Self {
            self.ca_file, self.max_redirects, self.max_body_size, self.timeout_ms, self.connect_timeout_ms, value
        }
    }
}

fn header_value(headers: Vec[HttpHeader], name: str) -> Option[str] {
    let needle = ascii_lower(name)
    for header in headers {
        if ascii_lower(header.name) == needle {
            ret Option::Some(header.value)
        }
    }
    ret Option::None
}

fn headers_contain(headers: Vec[HttpHeader], name: str) -> bool {
    ret header_value(headers, name).is_some()
}

fn header_count(headers: Vec[HttpHeader], name: str) -> usize {
    let needle = ascii_lower(name)
    let mut count = 0_usize
    for header in headers {
        if ascii_lower(header.name) == needle {
            count += 1_usize
        }
    }
    ret count
}

pub fn invalid_header(value: str) -> bool {
    if value == "" {
        ret true
    }
    let punctuation = "!#$%&'*+-.^_`|~"
    for index in 0_usize..value.len() {
        let byte = value.byte_at(index)
        let alphanumeric =(byte >= 48_u8 && byte <= 57_u8) ||(byte >= 65_u8 && byte <= 90_u8) ||(byte >= 97_u8 && byte <= 122_u8)
        if !alphanumeric && !contains(punctuation, value.slice(index, 1_usize)) {
            ret true
        }
    }
    ret false
}

fn invalid_header_value(value: str) -> bool {
    let mut i = 0_usize
    while i < value.len() {
        let byte = value.byte_at(i)
        if (byte < 32_u8 && byte != 9_u8) || byte == 127_u8 {
            ret true
        }
        i += 1_usize
    }
    ret false
}

pub fn ascii_lower(value: str) -> str {
    let mut out = ""
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let mut index = 0_usize
    while index < value.len() {
        let byte = value.byte_at(index)
        if byte >= 65_u8 && byte <= 90_u8 {
            out += lower.slice((byte - 65_u8) as usize, 1_usize)
        } else {
            out += value.slice(index, 1_usize)
        }
        index += 1_usize
    }
    ret out
}

fn trim_ascii(value: str) -> str {
    let mut start = 0_usize
    let mut end = value.len()
    while start < end &&(value.byte_at(start) == 32_u8 || value.byte_at(start) == 9_u8) {
        start += 1_usize
    }
    while end > start &&(value.byte_at(end - 1_usize) == 32_u8 || value.byte_at(end - 1_usize) == 9_u8) {
        end -= 1_usize
    }
    ret value.slice(start, end - start)
}

fn parse_decimal(value: str) -> Option[usize] {
    if value == "" {
        ret Option::None
    }
    let mut out = 0_usize
    let mut index = 0_usize
    while index < value.len() {
        let byte = value.byte_at(index)
        if byte < 48_u8 || byte > 57_u8 {
            ret Option::None
        }
        let digit =(byte - 48_u8) as usize
        // Protocol lengths are deliberately bounded below either pointer width.
        if out >(1073741824_usize - digit) / 10_usize {
            ret Option::None
        }
        out = out * 10_usize + digit
        index += 1_usize
    }
    ret Option::Some(out)
}

pub fn index_of(value: str, needle: str, start: usize) -> usize {
    if needle == "" {
        ret if start <= value.len() {
            start
        } else {
            value.len()
        }
    }
    let mut index = start
    while index + needle.len() <= value.len() {
        if value.slice(index, needle.len()) == needle {
            ret index
        }
        index += 1_usize
    }
    ret value.len()
}

fn first_of(value: str, needles: str) -> usize {
    let mut index = 0_usize
    while index < value.len() {
        let mut needle = 0_usize
        while needle < needles.len() {
            if value.byte_at(index) == needles.byte_at(needle) {
                ret index
            }
            needle += 1_usize
        }
        index += 1_usize
    }
    ret value.len()
}

fn last_index_of(value: str, needle: str) -> usize {
    if needle.len() != 1_usize {
        ret value.len()
    }
    let mut index = value.len()
    while index > 0_usize {
        index -= 1_usize
        if value.byte_at(index) == needle.byte_at(0_usize) {
            ret index
        }
    }
    ret value.len()
}

pub fn starts_with(value: str, prefix: str) -> bool {
    ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix
}

pub fn contains(value: str, needle: str) -> bool {
    ret index_of(value, needle, 0_usize) < value.len()
}
