//! Typed bounded channels preserve ownership through full, close and cancellation.
import core::future::{Poll, context}
import core::result::Result
import core::testing::assert

import std::future::block_on
import std::sync::{CancellationToken, SendError, SendFuture, Sender, bounded}

fn producer(sender: Sender[str]) -> u32 {
    for _index in 0_usize..1000_usize {
        if sender.send_blocking("payload").is_err() {
            ret 1_u32
        }
    }
    ret 0_u32
}
fn transfer() -> u32 {
    let pair = match bounded[str](2_usize) {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let sender = pair.0
    let receiver = pair.1
    let first = spawn producer(sender)
    let second = spawn producer(sender)
    for _index in 0_usize..2000_usize {
        if !assert(receiver.receive_blocking().unwrap_or("") == "payload") {
            ret 2_u32
        }
    }
    if !assert(first.join() == 0_u32 && second.join() == 0_u32) {
        ret 3_u32
    }
    if !assert(sender.try_send("first").is_ok() && sender.try_send("second").is_ok()) {
        ret 4_u32
    }
    let unsent = match sender.try_send("unsent") {
        Err(error) => error.value.unwrap_or("") Ok(_) => ""
    }
    if !assert(unsent == "unsent") {
        ret 5_u32
    }
    let cancel = CancellationToken::new()
    let pending = sender.send_cancellable("cancelled", cancel).poll(context(0_usize))
    let sending = match pending {
        Poll[SendFuture[str], Result[(), SendError[str]]]::Pending(value) => value _ => {
            ret 6_u32
        }
    }
    cancel.cancel()
    let result = block_on[Result[(), SendError[str]], SendFuture[str]](sending)
    let cancelled = match result {
        Err(error) => error.value.unwrap_or("") Ok(_) => ""
    }
    if !assert(cancelled == "cancelled") {
        ret 7_u32
    }
    let clock = std::time::VirtualClock::new()
    let timed = match std::future::timeout[Result[(), SendError[str]], SendFuture[str]](clock.clock(), std::time::Duration::from_nanos(0_u64), sender.send("timed out")) {
        Ok(value) => value Err(_) => {
            ret 10_u32
        }
    }
    let recovered = match block_on[std::future::TimeoutOutcome[SendFuture[str], Result[(), SendError[str]]], std::future::TimeoutFuture[SendFuture[str], Result[(), SendError[str]]]](timed) {
        std::future::TimeoutOutcome[SendFuture[str], Result[(), SendError[str]]]::Elapsed(value) => value.into_unsent().unwrap_or("")
        _ => ""
    }
    clock.clock().close()
    if !assert(recovered == "timed out") {
        ret 11_u32
    }
    receiver.close()
    let closed = match sender.try_send("closed") {
        Err(error) => error.value.unwrap_or("") Ok(_) => ""
    }
    ret if assert(closed == "closed" && sender.is_closed()) {
        0_u32
    } else {
        8_u32
    }
}
extern fn encore_sync_live_objects() -> usize
fn main() -> u32 {
    let before = unsafe {
        encore_sync_live_objects()
    }
    let result = transfer()
    if result != 0_u32 {
        ret result
    }
    ret if assert(unsafe {
            encore_sync_live_objects()
        }
        == before) {
        0_u32
    } else {
        9_u32
    }
}
