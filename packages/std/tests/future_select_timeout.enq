//! Fair ties and timeout return the unfinished future for later execution.
import core::future::{Context, Future, Poll, Ready, ready}
import core::result::Result
import core::testing::assert
import std::future::{block_on, Selector, Selected2, Select2, TimeoutFuture, TimeoutOutcome, timeout}
import std::sync::AtomicBool
import std::time::{Duration, VirtualClock}
struct Waiting { flag: AtomicBool value: str }
impl Future[str] for Waiting {
    pub fn poll(self: Self, context: Context) -> Poll[Self, str] {
        if self.flag.load() { ret Poll::Ready(self.value) }
        ret Poll::Pending(self)
    }
}
fn three_way() -> bool {
    let selector = Selector::new()
    let mut a = 0_u32 let mut b = 0_u32 let mut c = 0_u32
    for _index in 0_usize..9_usize {
        let race = selector.select3[u32, u32, u32, Ready[u32], Ready[u32], Ready[u32]](ready(1_u32), ready(2_u32), ready(3_u32))
        match block_on[std::future::Selected3[Ready[u32], Ready[u32], Ready[u32], u32, u32, u32], std::future::Select3[Ready[u32], Ready[u32], Ready[u32], u32, u32, u32]](race) {
            std::future::Selected3[Ready[u32], Ready[u32], Ready[u32], u32, u32, u32]::First(_) => { a += 1_u32 }
            std::future::Selected3[Ready[u32], Ready[u32], Ready[u32], u32, u32, u32]::Second(_) => { b += 1_u32 }
            std::future::Selected3[Ready[u32], Ready[u32], Ready[u32], u32, u32, u32]::Third(_) => { c += 1_u32 }
        }
    }
    ret a == 3_u32 && b == 3_u32 && c == 3_u32
}
fn cancelled_future() -> bool {
    let flag = AtomicBool::new(false)
    let token = std::sync::CancellationToken::new()
    let future = std::future::cancellable[str, Waiting](Waiting{flag, "cancelled"}, token)
    token.cancel()
    let retained = match block_on[std::future::CancellationOutcome[Waiting, str], std::future::CancellationFuture[Waiting, str]](future) {
        std::future::CancellationOutcome[Waiting, str]::Cancelled(value) => value
        _ => { ret false }
    }
    flag.store(true)
    ret block_on[str, Waiting](retained) == "cancelled"
}
fn exercise() -> u32 {
    if !assert(three_way() && cancelled_future()) { ret 6_u32 }
    let selector = Selector::new()
    let mut first = 0_u32
    for _index in 0_usize..10_usize {
        let race = selector.select2[u32, u32, Ready[u32], Ready[u32]](ready(1_u32), ready(2_u32))
        match block_on[Selected2[Ready[u32], Ready[u32], u32, u32], Select2[Ready[u32], Ready[u32], u32, u32]](race) {
            Selected2[Ready[u32], Ready[u32], u32, u32]::First(_) => { first += 1_u32 }
            _ => {}
        }
    }
    if !assert(first == 5_u32) { ret 1_u32 }
    let virtual = VirtualClock::new()
    let flag = AtomicBool::new(false)
    let pending = Waiting{flag, "retained"}
    let timed = match timeout[str, Waiting](virtual.clock(), Duration::from_nanos(0_u64), pending) { Ok(value) => value Err(_) => { ret 2_u32 } }
    let retained = match block_on[TimeoutOutcome[Waiting, str], TimeoutFuture[Waiting, str]](timed) {
        TimeoutOutcome[Waiting, str]::Elapsed(value) => value
        _ => { ret 3_u32 }
    }
    flag.store(true)
    if !assert(block_on[str, Waiting](retained) == "retained") { ret 4_u32 }
    virtual.clock().close()
    ret 0_u32
}
extern fn encore_sync_live_objects() -> usize
fn main() -> u32 {
    let before = unsafe { encore_sync_live_objects() }
    let result = exercise()
    if result != 0_u32 { ret result }
    ret if assert(unsafe { encore_sync_live_objects() } == before) { 0_u32 } else { 5_u32 }
}
