//! Deriving a command leaves the original and sibling argument lists intact.
import core::testing::assert
import std::process::Command
#cfg(not(target_os = "windows"))
fn main() -> u32 {
    let base = Command::new("printf").arg("%s")
    let first = base.arg("alpha")
    let second = base.arg("beta")
    ret if assert(first.output().text() == "alpha" && second.output().text() == "beta" && base.output().text() == "") {
        0_u32
    } else {
        1_u32
    }
}
#cfg(target_os = "windows")
fn main() -> u32 {
    ret 0_u32
}
