import core::testing::assert
import std::path::Path

fn main() -> u32 {
    let base = Path::cwd()
    let joined = base / "root" / "данные.env"
    if !assert(joined.as_str() == base.join("root").join("данные.env").as_str()) {
        ret 1
    }
    if !assert((base / "").as_str() == base.as_str()) {
        ret 2
    }
    if !assert((base / "/tmp").as_str() == Path::new("/tmp").as_str()) {
        ret 3
    }
    if !assert(base.as_str() == Path::cwd().as_str()) {
        ret 4
    }
    ret 0
}
