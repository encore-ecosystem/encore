//! Mutable payloads transfer once; a consumed pair supplies one owned receiver.
import core::option::Option
import core::result::Result
import core::testing::assert
import core::vec::Vec
import std::sync::{bounded, into_receiver, Receiver, CancellationToken}
fn consume(receiver: sending Receiver[Vec[str]]) -> u32 {
    let mut values = match receiver.receive_blocking() { Ok(value) => value Err(_) => { ret 1_u32 } }
    values.push("consumer")
    ret if assert(values.len() == 2_usize) { 0_u32 } else { 2_u32 }
}
fn exercise() -> u32 {
    let pair = match bounded[Vec[str]](1_usize) { Ok(value) => value Err(_) => { ret 3_u32 } }
    let sender = pair.0
    let receiver = into_receiver[Vec[str]](pair)
    let worker = spawn consume(receiver)
    let mut values = Vec[str]::new()
    values.push("producer")
    if sender.send_blocking(values).is_err() { ret 4_u32 }
    ret worker.join()
}
extern fn encore_sync_live_objects() -> usize
extern fn encore_node_debug_live_count() -> usize
fn main() -> u32 {
    let native_before = unsafe { encore_sync_live_objects() }
    let nodes_before = unsafe { encore_node_debug_live_count() }
    let result = exercise()
    if result != 0_u32 { ret result }
    ret if assert(unsafe { encore_sync_live_objects() } == native_before && unsafe { encore_node_debug_live_count() } == nodes_before) { 0_u32 } else { 5_u32 }
}
