//! Real process signals wake a subscription and closing restores ownership.
import core::result::Result
import core::testing::assert

import std::signal::{Signal, SignalError, Signals}
#cfg(not(target_os = "windows"))
extern fn raise(number: i32) -> i32
#cfg(not(target_os = "windows"))
fn main() -> u32 {
    let signals = match Signals::subscribe() {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    if !assert(Signals::subscribe().is_err()) {
        ret 2_u32
    }
    unsafe {
        raise(2_i32)
    }
    match signals.wait() {
        Result[Signal, SignalError]::Ok(value) => {
            match value {
                Signal::Interrupt => {
                }
                _ => {
                    ret 3_u32
                }
            }
        }
        _ => {
            ret 3_u32
        }
    }
    unsafe {
        raise(15_i32)
    }
    match signals.wait() {
        Result[Signal, SignalError]::Ok(value) => {
            match value {
                Signal::Terminate => {
                }
                _ => {
                    ret 4_u32
                }
            }
        }
        _ => {
            ret 4_u32
        }
    }
    signals.close()
    if !assert(signals.wait().is_err()) {
        ret 5_u32
    }
    let again = match Signals::subscribe() {
        Ok(value) => value Err(_) => {
            ret 6_u32
        }
    }
    again.close()
    ret 0_u32
}

#cfg(target_os = "windows")
fn main() -> u32 {
    ret match Signals::subscribe() {
        Result[Signals, SignalError]::Err(error) => match error {
            SignalError::Unsupported => 0_u32
            _ => 7_u32
        }
        _ => 7_u32
    }
}
