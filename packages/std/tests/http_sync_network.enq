import core::result::Result
import std::http::{HTTPSyncClient, HttpClientConfig, HttpRequest, Url}
import std::os::env

fn main() -> u32 {
    let base = env("JEV_TEST_URL").unwrap_or("")
    if base == "" {
        ret 0
    }
    let client = HTTPSyncClient::with_config(HttpClientConfig::default().with_ca_file(env("JEV_TEST_CA").unwrap_or("")))
    let response = match client.get(base + "/binary") {
        Result::Ok(response) => response Result::Err(_) => {
            ret 1
        }
    }
    if response.status() != 200_u16 || response.body().len() != 4_usize || response.body().byte_at(1_usize) != 0_u8 || response.body().byte_at(2_usize) != 255_u8 {
        ret 2
    }
    let url = Url::parse(base + "/echo").unwrap_or(Url::empty())
    for method in vec!["POST", "PUT", "DELETE"] {
        let response = match client.send(HttpRequest::new(method, url).with_body("Привет")) {
            Result::Ok(response) => response Result::Err(_) => {
                ret 3
            }
        }
        if response.body() != method + ":Привет" {
            ret 4
        }
    }
    ret 0
}
