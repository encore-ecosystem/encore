//! Returning a Waker keeps its event alive after the executor returns Ready.
import core::future::{Context, Future, Poll, Waker, context}
import std::future::block_on

struct SaveWaker {}
impl Future[Waker] for SaveWaker {
    fn poll(self: Self, context: Context) -> Poll[Self, Waker] {
        ret Poll[Self, Waker]::Ready(context.waker)
    }
}

fn main() -> u32 {
    let saved = block_on[Waker, SaveWaker](SaveWaker{})
    saved.wake()
    let copied = context(saved.raw_token())
    copied.waker.wake()
    ret 0_u32
}
