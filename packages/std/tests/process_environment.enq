import core::option::Option

import std::os::{argv, env, executable_path, set_env}
import std::process::Command

fn environment_matches() -> bool {
    ret env("ENCORE_TEST_EMPTY_VALUE") == Option[str]::Some("") &&
    env("ENCORE_TEST_UNICODE_имя") == Option[str]::Some("значение 🦊")
}

fn main() -> u32 {
    if argv(1_usize).unwrap_or("") == "environment-child" {
        ret if environment_matches() {
            0_u32
        } else {
            1_u32
        }
    }
    if set_env("ENCORE_TEST_EMPTY_VALUE", "").is_err() ||
    set_env("ENCORE_TEST_UNICODE_имя", "значение 🦊").is_err() || !environment_matches() {
        ret 1
    }
    for name in vec!["", "invalid=name", "invalid\x00name"] {
        if set_env(name, "private-value").is_ok() || env(name).is_some() {
            ret 2
        }
    }
    if set_env("ENCORE_TEST_EMPTY_VALUE", "invalid\x00value").is_ok() || !environment_matches() {
        ret 3
    }
    ret if Command::new(executable_path()).arg("environment-child").output().success() {
        0_u32
    } else {
        4_u32
    }
}
