//! Pending HTTP requests survive executor handoff and clean up on final drop.
import core::future::{Context, Future, Poll}
import core::option::Option
import core::result::Result
import core::testing::assert

import std::fs::read_dir
import std::future::block_on
import std::http::{HTTPAsyncClient, HTTPError, HTTPErrorKind, HTTPResponseFuture, HttpResponse}
import std::os::env
import std::sync::CancellationToken
extern fn encore_sync_live_objects() -> usize
extern fn encore_node_debug_live_count() -> usize
struct Park {
    request: HTTPResponseFuture
}

impl Future[Option[HTTPResponseFuture]] for Park {
    pub fn poll(self: Self, context: Context) -> Poll[Self, Option[HTTPResponseFuture]] {
        ret match self.request.poll(context) {
            Poll[HTTPResponseFuture, Result[HttpResponse, HTTPError]]::Pending(next) => Poll::Ready(Option::Some(next))
            Poll[HTTPResponseFuture, Result[HttpResponse, HTTPError]]::Ready(_) => Poll::Ready(Option::None)
        }
    }
}
fn handoff(url: str) -> u32 {
    let client = match HTTPAsyncClient::new() {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let pending = match block_on[Option[HTTPResponseFuture], Park](Park {
            client.get(url + "/delayed")
        }
    ) {
        Option[HTTPResponseFuture]::Some(value) => value _ => {
            ret 2_u32
        }
    }
    let response = match block_on[Result[HttpResponse, HTTPError], HTTPResponseFuture](pending) {
        Ok(value) => value Err(_) => {
            ret 3_u32
        }
    }
    if !assert(response.status() == 200_u16 && response.body() == "ready") {
        ret 4_u32
    }
    let token = CancellationToken::new()
    let cancelled = match block_on[Option[HTTPResponseFuture], Park](Park {
            client.get(url + "/slow").with_token(token)
        }
    ) {
        Option[HTTPResponseFuture]::Some(value) => value _ => {
            ret 5_u32
        }
    }
    token.cancel()
    ret match block_on[Result[HttpResponse, HTTPError], HTTPResponseFuture](cancelled) {
        Result[HttpResponse, HTTPError]::Err(error) => match error.kind {
            HTTPErrorKind::Cancelled => 0_u32 _ => 6_u32
        }
        _ => 7_u32
    }
}
fn abandon(url: str) -> u32 {
    let client = match HTTPAsyncClient::new() {
        Ok(value) => value Err(_) => {
            ret 8_u32
        }
    }
    let pending = block_on[Option[HTTPResponseFuture], Park](Park { client.get(url + "/slow") })
    ret if pending.is_some() {
        0_u32
    } else {
        9_u32
    }
}
fn main() -> u32 {
    let url = env("JEV_TEST_URL").unwrap_or("")
    if url == "" {
        ret 0_u32
    }
    let warmup = handoff(url)
    if warmup != 0_u32 {
        ret warmup
    }
    let objects = unsafe {
        encore_sync_live_objects()
    }
    let nodes = unsafe {
        encore_node_debug_live_count()
    }
    let threads = read_dir("/proc/self/task").len()
    let descriptors = read_dir("/proc/self/fd").len()
    for _index in 0_usize..20_usize {
        let result = abandon(url)
        if result != 0_u32 {
            ret result
        }
    }
    ret if assert(unsafe {
            encore_sync_live_objects()
        }
        == objects && unsafe {
            encore_node_debug_live_count()
        }
        == nodes && read_dir("/proc/self/task").len() == threads && read_dir("/proc/self/fd").len() == descriptors) {
        0_u32
    } else {
        10_u32
    }
}
