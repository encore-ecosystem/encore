//! Virtual clock domains, deterministic wakeups and explicit shutdown.
import core::future::{Poll, context}
import core::result::Result
import core::testing::assert

import std::future::block_on
import std::time::{ClockError, Duration, SystemClock, Timer, VirtualClock}

fn main() -> u32 {
    let virtual = VirtualClock::new()
    let clock = virtual.clock()
    let start = clock.now()
    let initial = match clock.sleep(Duration::from_millis(10_u64)) {
        Ok(value) => value Err(_) => {
            ret 10_u32
        }
    }
    let pending = initial.poll(context(0_usize))
    let timer = match pending {
        Poll[Timer, Result[(), ClockError]]::Pending(value) => value
        _ => {
            ret 1_u32
        }
    }
    if !assert(virtual.advance(Duration::from_millis(10_u64)).is_ok()) {
        ret 2_u32
    }
    let elapsed = match clock.now().duration_since(start) {
        Ok(value) => value Err(_) => {
            ret 11_u32
        }
    }
    if !assert(block_on[Result[(), ClockError], Timer](timer).is_ok() && elapsed.as_millis().unwrap_or(0_u64) == 10_u64) {
        ret 3_u32
    }
    let other = VirtualClock::new()
    if !assert(clock.sleep_until(other.clock().now()).is_err()) {
        ret 4_u32
    }
    let cancelled = match clock.sleep(Duration::from_secs(1_u64)) {
        Ok(value) => value Err(_) => {
            ret 12_u32
        }
    }
    cancelled.cancel()
    if !assert(block_on[Result[(), ClockError], Timer](cancelled).is_err()) {
        ret 5_u32
    }
    let closed = match clock.sleep(Duration::from_secs(1_u64)) {
        Ok(value) => value Err(_) => {
            ret 12_u32
        }
    }
    clock.close()
    if !assert(block_on[Result[(), ClockError], Timer](closed).is_err() && virtual.advance(Duration::from_nanos(1_u64)).is_err()) {
        ret 6_u32
    }
    let system = SystemClock::new()
    let real_timer = match system.sleep(Duration::from_millis(1_u64)) {
        Ok(value) => value Err(_) => {
            ret 13_u32
        }
    }
    if !assert(block_on[Result[(), ClockError], Timer](real_timer).is_ok()) {
        ret 7_u32
    }
    system.close()
    let overflow = VirtualClock::new()
    if !assert(overflow.advance(Duration::from_nanos(18446744073709551615_u64)).is_ok() && overflow.advance(Duration::from_nanos(1_u64)).is_err() && overflow.clock().sleep(Duration::from_nanos(1_u64)).is_err()) {
        ret 14_u32
    }
    let scoped = overflow.clock()
    with scoped as owned {
        let _instant = owned.now()
    }
    if !assert(overflow.advance(Duration::from_nanos(0_u64)).is_err()) {
        ret 15_u32
    }
    ret 0_u32
}
