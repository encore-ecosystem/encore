//! Provider and portable SHA256 paths must agree with independent test vectors.
import core::testing::assert
import core::vec::Vec
import std::os::{file_sha256, remove_file, write_file}

extern fn encore_text_sha256(value: str) -> str
extern fn encore_str_from_buffer(data: u8*, length: usize) -> str

#attr(safe)
fn bytes(size: usize) -> str {
    let mut values = Vec[u8]::new()
    for index in 0_usize..size { values.push(((index * 73_usize + 19_usize) % 256_usize) as u8) }
    unsafe { ret encore_str_from_buffer(values.as_ptr(), values.len()) }
}
#attr(safe)
fn text_digest(value: str) -> str { unsafe { ret encore_text_sha256(value) } }

fn main() -> u32 {
    let path = "target/std_sha256_vectors.bin"
    for sample in vec![
        (0_usize, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
        (1_usize, "ab897fbdedfa502b2d839b6a56100887dccdc507555c282e59589e06300a62e2"),
        (55_usize, "0c43a30970ee9525a6603d5656803c325bded148fa65bbd363df54cb3ac3dee5"),
        (56_usize, "f4dcdc09c846d1b3621701516b300055c1e7875e216ba019dd4423f5a420f2d0"),
        (63_usize, "ba3bb62c4369fe74e7b94392d0f04ed284a7b5d7295bfa48fabdb25c01d85ab7"),
        (64_usize, "cb6862268ca7c02e7b6af558f0e3d236ce9ec7ff41cc746b2848c04c582da94e"),
        (65_usize, "b68af55df9ce8ee60870e45d10e36b2e8363c9896f6e62478dcb6f593a4d7133"),
        (4095_usize, "66f39c4765119a21f5af5de45c21baa547434fbe4c4b355cad80ce76f7e7d3cb"),
        (4096_usize, "f965b526538d757ca2d6114af6517c57cbcb3650b71d8cfb92046a04ef2f566b"),
        (65535_usize, "bbd612f3115d5867b8c6a32d12161ca09c9825f0c85a2f1809bf33fa31b08398"),
        (65536_usize, "0bca3b5b2577c1341e7c61a10d9b664333ab04ed8976c8b594a75353dc2fb0ef"),
        (65537_usize, "3de64cc9b10cf0ea75ae16e504038ad9fccc779afbf5e5dad18324b5511e12db")
    ] {
        let value = bytes(sample.0)
        if !assert(write_file(path, value) == 0_i32) { ret 1_u32 }
        if !assert(file_sha256(path) == sample.1 && text_digest(value) == sample.1) {
            remove_file(path)
            ret 2_u32
        }
    }
    remove_file(path)
    ret 0_u32
}
