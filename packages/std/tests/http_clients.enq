import core::ops::ContextManager
import core::result::Result
import std::future::block_on
import std::http::{HTTPAsyncClient, HTTPSyncClient, HTTPResponseFuture, HTTPError, HTTPErrorKind, HttpRequest, HttpResponse, HttpClientConfig, Url}

async fn invalid(client: HTTPAsyncClient) -> Result[HttpResponse, HTTPError] {
    let result = await client.get("http://external.example/")
    ret result
}

#cfg(not(target_os = "linux"))
fn main() -> u32 {
    match HTTPAsyncClient::new() {
        Result::Err(error) => {
            ret match error.kind {
                HTTPErrorKind::Configuration => 0_u32 _ => 1_u32
            }
        }
        Result::Ok(client) => {
            client.close() ret 2_u32
        }
    }
}

#cfg(target_os = "linux")
fn main() -> u32 {
    let client = match HTTPAsyncClient::new() {
        Result::Ok(client) => client
        Result::Err(_) => {
            ret 1
        }
    }
    with client as client {
        let outcome = block_on[Result[HttpResponse, HTTPError], __encore_future_invalid](invalid(client))
        match outcome {
            Result::Ok(_) => {
                ret 2
            }
            Result::Err(error) => {
                match error.kind {
                    HTTPErrorKind::Configuration => {
                    }
                    _ => {
                        ret 3
                    }
                }
            }
        }
        let url = Url::parse("https://example.com/").unwrap_or(Url::empty())
        let request = HttpRequest::get(url).with_header("Content-Length", "2")
        if HTTPSyncClient::new().send(request).is_ok() {
            ret 4
        }
        let rejected = block_on[Result[HttpResponse, HTTPError], HTTPResponseFuture](client.send(request))
        if rejected.is_ok() {
            ret 5
        }
        let closed = client.close()
        let result = block_on[Result[HttpResponse, HTTPError], HTTPResponseFuture](client.get("https://example.com/"))
        match result {
            Result::Ok(_) => {
                ret 6
            }
            Result::Err(error) => {
                match error.kind {
                    HTTPErrorKind::Closed => {
                    }
                    _ => {
                        ret 7
                    }
                }
            }
        }
    }
    ret 0
}
