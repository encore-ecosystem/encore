//! Bounded groups keep IDs ordered and join cooperative workers on final drop.
import core::result::Result
import core::option::Option
import core::testing::assert
import core::vec::Vec

import std::future::block_on
import std::sync::{AtomicBool, CancellationToken}
import std::task::{GroupJoinFuture, TaskError, TaskGroup, TaskJob, TaskOutcome, TaskPolicy, TaskResult}
struct Square {
    value: u64
}

impl TaskJob[u64] for Square {
    pub fn run(self: Self, cancellation: CancellationToken) -> sending Result[u64, str] {
        ret Result::Ok(self.value * self.value)
    }
}
struct Failing {
    fail: bool
}

impl TaskJob[u64] for Failing {
    pub fn run(self: Self, cancellation: CancellationToken) -> sending Result[u64, str] {
        if self.fail {
            ret Result::Err("expected failure")
        }
        ret Result::Ok(42_u64)
    }
}
fn normal() -> u32 {
    let group = match TaskGroup[Square, u64]::new(2_usize, 2_usize) {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    for index in 0_usize..50_usize {
        if !assert(group.submit(Square { index as u64 }).unwrap_or(999_u64) == index as u64) {
            ret 2_u32
        }
    }
    let results = match block_on[Result[Vec[TaskResult[u64]], TaskError], GroupJoinFuture[Square, u64]](group.join()) {
        Ok(value) => value Err(_) => {
            ret 3_u32
        }
    }
    if !assert(results.len() == 50_usize) {
        ret 4_u32
    }
    let mut expected = 0_u64
    for result in results {
        if !assert(result.id == expected) {
            ret 5_u32
        }
        match result.outcome {
            TaskOutcome[u64]::Completed(value) => {
                if !assert(value == expected * expected) {
                    ret 6_u32
                }
            }
            _ => {
                ret 7_u32
            }
        }
        expected += 1_u64
    }
    ret 0_u32
}
fn collect_all() -> u32 {
    let group = match TaskGroup[Failing, u64]::with_policy(2_usize, 1_usize, TaskPolicy::CollectAll) {
        Ok(value) => value Err(_) => {
            ret 8_u32
        }
    }
    if group.submit(Failing { true }).is_err() || group.submit(Failing { false }).is_err() {
        ret 9_u32
    }
    let results = match block_on[Result[Vec[TaskResult[u64]], TaskError], GroupJoinFuture[Failing, u64]](group.join()) {
        Ok(value) => value Err(_) => {
            ret 10_u32
        }
    }
    if !assert(results.len() == 2_usize) {
        ret 11_u32
    }
    let mut failed = 0_u32
    let mut completed = 0_u32
    for result in results {
        match result.outcome {
            TaskOutcome[u64]::Failed(_) => {
                failed += 1_u32
            }
            TaskOutcome[u64]::Completed(_) => {
                completed += 1_u32
            }
            _ => {
            }
        }
    }
    ret if assert(failed == 1_u32 && completed == 1_u32) {
        0_u32
    } else {
        12_u32
    }
}
fn idle_drop() -> u32 {
    let group = match TaskGroup[Square, u64]::new(2_usize, 1_usize) {
        Ok(value) => value Err(_) => {
            ret 13_u32
        }
    }
    ret 0_u32
}
extern fn encore_sync_live_objects() -> usize
extern fn encore_node_debug_live_count() -> usize
fn main() -> u32 {
    let before = unsafe {
        encore_sync_live_objects()
    }
    let nodes = unsafe {
        encore_node_debug_live_count()
    }
    let active = active_drop()
    if active != 0_u32 {
        ret active
    }
    let failed = cancel_on_error()
    if failed != 0_u32 {
        ret failed
    }
    let result = normal()
    if result != 0_u32 {
        ret result
    }
    let collected = collect_all()
    if collected != 0_u32 {
        ret collected
    }
    let deadline = deadline_retains_workers()
    if deadline != 0_u32 {
        ret deadline
    }
    let dropped = idle_drop()
    if dropped != 0_u32 {
        ret dropped
    }
    ret if assert(unsafe {
            encore_sync_live_objects()
        }
        == before && unsafe {
            encore_node_debug_live_count()
        }
        == nodes) {
        0_u32
    } else {
        14_u32
    }
}

struct WaitingJob {
    gate: CancellationToken
}

impl TaskJob[u64] for WaitingJob {
    pub fn run(self: Self, cancellation: CancellationToken) -> sending Result[u64, str] {
        self.gate.wait() ret Result::Ok(42_u64)
    }
}
fn pending_group(gate: CancellationToken) -> Option[GroupJoinFuture[WaitingJob, u64]] {
    let group = match TaskGroup[WaitingJob, u64]::new(1_usize, 1_usize) {
        Ok(value) => value Err(_) => {
            ret Option::None
        }
    }
    if group.submit(WaitingJob { gate }).is_err() {
        ret Option::None
    }
    ret Option::Some(group.join())
}
fn deadline_retains_workers() -> u32 {
    let gate = CancellationToken::new()
    let pending = match pending_group(gate) {
        Option[GroupJoinFuture[WaitingJob, u64]]::Some(value) => value _ => {
            ret 15_u32
        }
    }
    let clock = std::time::VirtualClock::new()
    let timed = match std::future::timeout[Result[Vec[TaskResult[u64]], TaskError], GroupJoinFuture[WaitingJob, u64]](clock.clock(), std::time::Duration::from_nanos(0_u64), pending) {
        Ok(value) => value Err(_) => {
            ret 16_u32
        }
    }
    let retained = match block_on[std::future::TimeoutOutcome[GroupJoinFuture[WaitingJob, u64], Result[Vec[TaskResult[u64]], TaskError]], std::future::TimeoutFuture[GroupJoinFuture[WaitingJob, u64], Result[Vec[TaskResult[u64]], TaskError]]](timed) {
        std::future::TimeoutOutcome[GroupJoinFuture[WaitingJob, u64], Result[Vec[TaskResult[u64]], TaskError]]::Elapsed(value) => value.into_group()
        _ => {
            ret 17_u32
        }
    }
    gate.cancel()
    let results = match block_on[Result[Vec[TaskResult[u64]], TaskError], GroupJoinFuture[WaitingJob, u64]](retained.join()) {
        Ok(value) => value Err(_) => {
            ret 18_u32
        }
    }
    clock.clock().close()
    ret if assert(results.len() == 1_usize) {
        0_u32
    } else {
        19_u32
    }
}

struct Cooperative {
    started: CancellationToken
    finished: AtomicBool
}

impl TaskJob[u64] for Cooperative {
    pub fn run(self: Self, cancellation: CancellationToken) -> sending Result[u64, str] {
        self.started.cancel()
        cancellation.wait()
        self.finished.store(true)
        ret Result::Ok(0_u64)
    }
}
fn drop_running(started: CancellationToken, finished: AtomicBool) -> u32 {
    let group = match TaskGroup[Cooperative, u64]::new(1_usize, 1_usize) {
        Ok(value) => value Err(_) => {
            ret 20_u32
        }
    }
    if group.submit(Cooperative { started, finished }).is_err() {
        ret 21_u32
    }
    started.wait()
    ret 0_u32
}
fn active_drop() -> u32 {
    let started = CancellationToken::new()
    let finished = AtomicBool::new(false)
    let result = drop_running(started, finished)
    if result != 0_u32 {
        ret result
    }
    ret if assert(finished.load()) {
        0_u32
    } else {
        22_u32
    }
}
struct GatedFailure {
    gate: CancellationToken
    fail: bool
}

impl TaskJob[u64] for GatedFailure {
    pub fn run(self: Self, cancellation: CancellationToken) -> sending Result[u64, str] {
        self.gate.wait()
        ret if self.fail {
            Result::Err("expected failure")
        } else {
            Result::Ok(42_u64)
        }
    }
}
fn cancel_on_error() -> u32 {
    if TaskGroup[Square, u64]::new(0_usize, 1_usize).is_ok() || TaskGroup[Square, u64]::new(257_usize, 1_usize).is_ok() || TaskGroup[Square, u64]::new(1_usize, 0_usize).is_ok() {
        ret 23_u32
    }
    let gate = CancellationToken::new()
    let group = match TaskGroup[GatedFailure, u64]::new(1_usize, 1_usize) {
        Ok(value) => value Err(_) => {
            ret 24_u32
        }
    }
    if group.submit(GatedFailure { gate, true }).is_err() || group.submit(GatedFailure {
            gate, false
        }
    ).is_err() {
        gate.cancel() ret 25_u32
    }
    gate.cancel()
    let results = match block_on[Result[Vec[TaskResult[u64]], TaskError], GroupJoinFuture[GatedFailure, u64]](group.join()) {
        Ok(value) => value Err(_) => {
            ret 26_u32
        }
    }
    if !assert(results.len() == 2_usize) {
        ret 27_u32
    }
    let mut failed = 0_u32
    let mut cancelled = 0_u32
    for result in results {
        match result.outcome {
            TaskOutcome[u64]::Failed(_) => {
                failed += 1_u32
            }
            TaskOutcome[u64]::Cancelled => {
                cancelled += 1_u32
            }
            _ => {
            }
        }
    }
    if !assert(failed == 1_u32 && cancelled == 1_u32) {
        ret 28_u32
    }
    ret if assert(block_on[Result[Vec[TaskResult[u64]], TaskError], GroupJoinFuture[GatedFailure, u64]](group.join()).is_err()) {
        0_u32
    } else {
        29_u32
    }
}
