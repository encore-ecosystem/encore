import core::option::Option
import core::vec::Vec
import json
import serialize::Limits
struct Collision {
    #serialize(rename = "same") a: u32
    #serialize(rename = "same") b: u32
}
struct Record {
    value: u8
    optional: Option[str]
}
fn main() -> u32 {
    for text in vec!["01", "1.", "1e", "+1", "NaN", "Infinity", "1 2", "[1,]", "{\"value\":1,}"] {
        if json::decode[u32](text).is_ok() {
            ret 1
        }
    }
    if json::decode[u32]("1.0").is_ok() || json::decode[u32]("1e0").is_ok() || json::decode[u32]("-1").is_ok() {
        ret 2
    }
    if json::decode[f32]("1e999").is_ok() {
        ret 3
    }
    if json::decode[Record]("{\"value\":256}").is_ok() {
        ret 4
    }
    if json::decode[Record]("{\"value\":1,\"value\":2}").is_ok() {
        ret 5
    }
    if json::decode[Record]("{}").is_ok() {
        ret 6
    }
    if json::encode(Collision { 1_u32, 2_u32 }).is_ok() {
        ret 7
    }
    if json::decode[Collision]("{\"same\":1}").is_ok() {
        ret 8
    }
    let options = json::DecodeOptions::new().with_limits(Limits::new().with_max_collection_items(1))
    if json::decode_with[Vec[u32]]("[1,2]", options).is_ok() {
        ret 9
    }
    ret 0
}
