import core::option::Option
import core::result::Result
import core::vec::Vec
import json
import std::dict::Dict
struct Envelope[T] {
    label: str
    value: T
}
fn main() -> u32 {
    let mut map = Dict[str, Option[u32]]::new()
    map.insert("present", Option[u32]::Some(42_u32))
    map.insert("empty", Option[u32]::None)
    let text = match json::encode(map) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let restored = match json::decode[Dict[str, Option[u32]]](text) {
        Ok(value) => value Err(_) => {
            ret 2
        }
    }
    if restored.len() != 2 || restored.get("present").unwrap_or(Option[u32]::None).unwrap_or(0) != 42_u32 {
        ret 3
    }
    let item = Envelope[Vec[u32]] { "nested", vec![10_u32, 20_u32] }
    let value = Result[Envelope[Vec[u32]], str]::Ok(item)
    let data = match json::encode(value) {
        Ok(value) => value Err(_) => {
            ret 4
        }
    }
    match json::decode[Result[Envelope[Vec[u32]], str]](data) {
        Ok(decoded) => {
            match decoded {
                Ok(payload) => {
                    if payload.label != "nested" || payload.value.len() != 2 {
                        ret 5
                    }
                }
                Err(_) => {
                    ret 6
                }
            }
        }
        Err(_) => {
            ret 7
        }
    }
    ret 0
}
