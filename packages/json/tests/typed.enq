import core::option::Option
import core::result::Result
import core::vec::Vec
import json
import json::{JsonSerializer, JsonDeserializer}
import serialize::{Serializer, Deserializer, ErrorKind, Limits}
struct User {
    name: str
    score: u64
    active: bool
    note: Option[str]
}
enum Event {
    Idle
    Joined(User)
}
struct Renamed {
    #serialize(rename = "old_name") new_name: str
}
fn main() -> u32 {
    let user = User { "Рыба 🐟", 18446744073709551615_u64, true, Option[str]::None }
    let text = match json::encode(user) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    let decoded = match json::decode[User](text) {
        Ok(value) => value Err(_) => {
            ret 2
        }
    }
    if decoded.name != user.name || decoded.score != user.score || !decoded.active || decoded.note.is_some() {
        ret 3
    }
    let pretty = match json::encode_with(user, json::EncodeOptions::new().pretty(2)) {
        Ok(value) => value Err(_) => {
            ret 4
        }
    }
    if !pretty.contains("\n  \"name\": ") {
        ret 5
    }
    if json::decode[User]("{\"name\":\"x\",\"score\":1,\"active\":true,\"extra\":[1,2]}").is_err() {
        ret 6
    }
    if json::decode[User]("{\"name\":\"x\",\"name\":\"y\",\"score\":1,\"active\":true}").is_ok() {
        ret 7
    }
    if json::decode[u8]("256").is_ok() || json::decode[bool]("1").is_ok() {
        ret 8
    }
    let tuple = match json::decode[(u32, str)]("[42,\"ok\"]") {
        Ok(value) => value Err(_) => {
            ret 9
        }
    }
    if tuple.0 != 42_u32 || tuple.1 != "ok" {
        ret 10
    }
    let event = match json::encode(Event::Joined(user)) {
        Ok(value) => value Err(_) => {
            ret 11
        }
    }
    match json::decode[Event](event) {
        Ok(value) => {
            match value {
                Joined(item) => {
                    if item.name != user.name {
                        ret 12
                    }
                }
                _ => {
                    ret 13
                }
            }
        }
        Err(_) => {
            ret 14
        }
    }
    let numbers = vec![0_u64, 18446744073709551615_u64]
    let array = match json::encode(numbers) {
        Ok(value) => value Err(_) => {
            ret 15
        }
    }
    match json::decode[Vec[u64]](array) {
        Ok(value) => {
            if value.len() != 2 || value.get(1).unwrap_or(0) != user.score {
                ret 16
            }
        }
        Err(_) => {
            ret 17
        }
    }
    if json::decode_with[Vec[u32]]("[[[0]]]", json::DecodeOptions::new().with_limits(Limits::new().with_max_depth(1))).is_ok() {
        ret 18
    }
    let via_trait = match Serializer::serialize(JsonSerializer::new(user)) {
        Ok(value) => value Err(_) => {
            ret 19
        }
    }
    match JsonDeserializer[User]::new(via_trait).deserialize() {
        Ok(value) => {
            if value.name != user.name {
                ret 20
            }
        }
        Err(_) => {
            ret 21
        }
    }
    let rename_data = match json::encode(Renamed { "stable" }) {
        Ok(value) => value Err(_) => {
            ret 30
        }
    }
    match json::decode[Renamed](rename_data) {
        Ok(value) => {
            if value.new_name != "stable" {
                ret 31
            }
        }
        Err(_) => {
            ret 32
        }
    }
    ret 0
}
