import core::result::Result
import json
fn main() -> u32 {
    let encoded = match json::encode(()) {
        Ok(value) => value Err(_) => {
            ret 1
        }
    }
    match json::decode[()](encoded) {
        Ok(_) => {
            ret 0
        }
        Err(_) => {
            ret 2
        }
    }
}
