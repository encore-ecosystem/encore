//! Command-owned animated progress with thread-safe, non-owning reporters.

import refrain::spinner::Spinner

extern fn encore_rich_live_start(label: str, frames: str, interval_ms: usize) -> usize
extern fn encore_rich_live_current() -> usize
extern fn encore_rich_live_stage(session: usize, label: str, total: usize) ->()
extern fn encore_rich_live_task(session: usize, id: usize, label: str, stage: str, complete: bool) ->()
extern fn encore_rich_live_stop(session: usize) ->()

/// Own one terminal session with `with progress as scope`. A nested owner is
/// inert, and reporters from a closed session cannot affect a later session.
pub struct LiveProgress {
    session: usize
}

impl for LiveProgress {
    #attr(safe)
    pub fn auto(label: str) -> Self {
        let spinner = Spinner::dots()
        let session = unsafe {
            encore_rich_live_start(label, spinner.encoded_frames(), spinner.interval())
        }
        ret Self { session }
    }

    pub fn reporter(self: Self) -> ProgressReporter {
        ret ProgressReporter { self.session }
    }

    #attr(safe)
    pub fn finish(self: Self) ->() {
        unsafe {
            encore_rich_live_stop(self.session)
        }
        ret()
    }
}

impl ContextManager for LiveProgress {
    pub fn with_enter(self: Self) -> Self {
        ret self
    }

    pub fn with_exit(self: Self) -> bool {
        self.finish()
        ret true
    }
}

/// Copies event strings into native state; no Encore objects are shared across
/// worker threads. With redirected stderr every operation is a no-op.
pub struct ProgressReporter {
    session: usize
}

impl for ProgressReporter {
    #attr(safe)
    pub fn is_active(self: Self) -> bool {
        unsafe {
            ret self.session != 0_usize && self.session == encore_rich_live_current()
        }
    }

    #attr(safe)
    pub fn current() -> Self {
        let session = unsafe {
            encore_rich_live_current()
        }
        ret Self { session }
    }

    #attr(safe)
    pub fn stage(self: Self, label: str, total: usize) ->() {
        unsafe {
            encore_rich_live_stage(self.session, label, total)
        }
        ret()
    }

    #attr(safe)
    pub fn task(self: Self, id: usize, label: str, stage: str) ->() {
        unsafe {
            encore_rich_live_task(self.session, id, label, stage, false)
        }
        ret()
    }

    #attr(safe)
    pub fn complete(self: Self, id: usize, label: str) ->() {
        unsafe {
            encore_rich_live_task(self.session, id, label, "", true)
        }
        ret()
    }

    #attr(safe)
    pub fn finish(self: Self) ->() {
        unsafe {
            encore_rich_live_stop(self.session)
        }
        ret()
    }
}
