//! Internal typed synchronization ABI. Raw adoption requires a valid owned token.
pub struct __Lease {
    token: usize
}
extern fn encore_sync_retain(token: usize) ->()
extern fn encore_sync_release(token: usize) ->()

impl for __Lease {
    #attr(safe)
    #attr(borrowed_self)
    pub fn raw(self: Self) -> usize {
        ret self.token
    }
}
pub fn __adopt(token: usize) -> __Lease {
    unsafe {
        ret __Lease { token }
    }
}

