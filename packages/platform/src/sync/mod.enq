// Owned local payloads may contain structured thread handles. This operation
// does not claim that the value can cross a thread boundary.
pub fn __payload_take_local[Value](token: usize) -> Value {
    unsafe {
        unsafe ehir {
            pointer: Value * = pcast token: usize, Value *
            item: Value = load pointer: Value *
            hfree pointer: Value *
        }
        ret item
    }
}
