//! Private ABI. Handles are validated in the shim; no pointers cross the API.
extern fn encore_http_async_runtime_new(capacity: usize) -> usize
extern fn encore_http_async_reactor_enter() ->()
extern fn encore_http_async_runtime_stopping(runtime: usize) -> i32
extern fn encore_http_async_runtime_stop(runtime: usize) ->()
extern fn encore_http_async_runtime_destroy(runtime: usize) ->()
extern fn encore_http_async_submit(runtime: usize, host: str, port: i32, tls: i32, ca: str, wire: str, token: usize, body_limit: usize, header_limit: usize, connect_ms: usize, total_ms: usize) -> usize
extern fn encore_http_async_slot(runtime: usize, slot: usize) -> usize
extern fn encore_http_async_wire(request: usize) -> str
extern fn encore_http_async_status(request: usize, waker: usize) -> i32
extern fn encore_http_async_result(request: usize) -> str
extern fn encore_http_async_headers(request: usize) -> str
extern fn encore_http_async_http_status(request: usize) -> i32
extern fn encore_http_async_setting(request: usize, key: i32) -> usize
extern fn encore_http_async_release(request: usize) ->()
extern fn encore_http_async_complete(request: usize, status: i32, http_status: i32, headers: str, result: str) ->()
extern fn encore_http_async_cancelled(request: usize) -> i32
extern fn encore_http_async_detach(runtime: usize, waker: usize) ->()
extern fn encore_http_async_token_new(runtime: usize) -> usize
extern fn encore_http_async_token_cancel(runtime: usize, token: usize) ->()
extern fn encore_http_async_dns_step(request: usize) -> i32
extern fn encore_http_async_dns_timeout(request: usize) -> i32
extern fn encore_http_async_connect_step(request: usize) -> i32
extern fn encore_http_async_tls_step(request: usize) -> i32
extern fn encore_http_async_write(request: usize, offset: usize) -> i32
extern fn encore_http_async_read_interest(request: usize) ->()
extern fn encore_http_async_read(request: usize) -> str
extern fn encore_http_async_read_status(request: usize) -> i32
extern fn encore_http_async_wait(runtime: usize, timeout: i32) ->()

// Only the library implementation imports these trusted, checked-handle wrappers.
#attr(safe)
pub fn create(capacity: usize) -> usize {
    ret encore_http_async_runtime_new(capacity)
}
#attr(safe)
pub fn reactor_enter() ->() {
    encore_http_async_reactor_enter()
}
#attr(safe)
pub fn stopping(runtime: usize) -> bool {
    ret encore_http_async_runtime_stopping(runtime) != 0_i32
}
#attr(safe)
pub fn stop(runtime: usize) ->() {
    encore_http_async_runtime_stop(runtime)
}
#attr(safe)
pub fn destroy(runtime: usize) ->() {
    encore_http_async_runtime_destroy(runtime)
}
#attr(safe)
pub fn submit(runtime: usize, host: str, port: i32, tls: i32, ca: str, wire: str, token: usize, body_limit: usize, header_limit: usize, connect_ms: usize, total_ms: usize) -> usize {
    ret encore_http_async_submit(runtime, host, port, tls, ca, wire, token, body_limit, header_limit, connect_ms, total_ms)
}
#attr(safe)
pub fn slot(runtime: usize, index: usize) -> usize {
    ret encore_http_async_slot(runtime, index)
}
#attr(safe)
pub fn wire(request: usize) -> str {
    ret encore_http_async_wire(request)
}
#attr(safe)
pub fn status(request: usize, waker: usize) -> i32 {
    ret encore_http_async_status(request, waker)
}
#attr(safe)
pub fn result(request: usize) -> str {
    ret encore_http_async_result(request)
}
#attr(safe)
pub fn headers(request: usize) -> str {
    ret encore_http_async_headers(request)
}
#attr(safe)
pub fn http_status(request: usize) -> i32 {
    ret encore_http_async_http_status(request)
}
#attr(safe)
pub fn setting(request: usize, key: i32) -> usize {
    ret encore_http_async_setting(request, key)
}
#attr(safe)
pub fn release(request: usize) ->() {
    encore_http_async_release(request)
}
#attr(safe)
pub fn complete(request: usize, status: i32, http_status: i32, headers: str, result: str) ->() {
    encore_http_async_complete(request, status, http_status, headers, result)
}
#attr(safe)
pub fn cancelled(request: usize) -> bool {
    ret encore_http_async_cancelled(request) != 0_i32
}
#attr(safe)
pub fn detach(runtime: usize, waker: usize) ->() {
    encore_http_async_detach(runtime, waker)
}
#attr(safe)
pub fn token(runtime: usize) -> usize {
    ret encore_http_async_token_new(runtime)
}
#attr(safe)
pub fn cancel(runtime: usize, token: usize) ->() {
    encore_http_async_token_cancel(runtime, token)
}
#attr(safe)
pub fn dns(request: usize) -> i32 {
    ret encore_http_async_dns_step(request)
}
#attr(safe)
pub fn dns_timeout(request: usize) -> i32 {
    ret encore_http_async_dns_timeout(request)
}
#attr(safe)
pub fn connect(request: usize) -> i32 {
    ret encore_http_async_connect_step(request)
}
#attr(safe)
pub fn handshake(request: usize) -> i32 {
    ret encore_http_async_tls_step(request)
}
#attr(safe)
pub fn write(request: usize, offset: usize) -> i32 {
    ret encore_http_async_write(request, offset)
}
#attr(safe)
pub fn read_interest(request: usize) ->() {
    encore_http_async_read_interest(request)
}
#attr(safe)
pub fn read(request: usize) -> str {
    ret encore_http_async_read(request)
}
#attr(safe)
pub fn read_status(request: usize) -> i32 {
    ret encore_http_async_read_status(request)
}
#attr(safe)
pub fn wait(runtime: usize, timeout: i32) ->() {
    encore_http_async_wait(runtime, timeout)
}

extern fn encore_http_async_supported() -> i32
#attr(safe)
pub fn supported() -> bool { ret encore_http_async_supported() != 0_i32 }
