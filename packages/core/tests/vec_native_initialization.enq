//! Native integrations can initialize reserved storage before publishing length.
import core::testing::assert
import core::vec::Vec

fn main() -> u32 {
    let mut bytes = Vec[u8]::with_capacity(1_usize)
    let pointer = bytes.as_ptr()
    unsafe {
        unsafe ehir {
            value: u8 = lcpos 42_u8
            store value: u8, pointer: u8 *
        }
        bytes.set_len(1_usize)
    }
    if !assert(bytes.len() == 1_usize && bytes.get(0_usize).unwrap_or(0_u8) == 42_u8) {
        ret 1
    }
    bytes.push(17_u8)
    if !assert(bytes.len() == 2_usize && bytes.get(1_usize).unwrap_or(0_u8) == 17_u8) {
        ret 2
    }
    ret 0
}
