import core::ops::*

fn main() -> u32 {
    if !"".contains("") || !"alpha".contains("") || "".contains("a") {
        ret 1
    }
    if !"alpha".contains("alpha") || !"alpha".contains("pha") || "alpha".contains("alphabet") {
        ret 2
    }
    if !"Рыба 🐟 日本語".contains("🐟 日本") || "Рыба 🐟 日本語".contains("日本🐟") {
        ret 3
    }
    if !"a\x00b".contains("\x00b") || "a\x00b".contains("ab") {
        ret 4
    }
    if "a\x00b" != "a\x00b" || "a\x00b" == "a\x00c" {
        ret 5
    }
    let mut long = ""
    for _ in 0..1024 {
        long += "prefix_"
    }
    long += "TypeInfo[value]"
    if !long.contains("TypeInfo[") || long.contains("FieldInfo[") {
        ret 6
    }
    ret 0
}
