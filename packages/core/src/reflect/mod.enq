//! Typed compile-time reflection. Metadata operations are expanded by Encore.
//!
//! Field sequences are heterogeneous compile-time sequences, not runtime Vecs.
//! A normal `for` over such a sequence specializes its body for each field.

import core::option::Option
import core::panic::panic
import core::result::Result

/// Classifies the logical shape of a reflected type.
pub enum Kind {
    Unit
    Bool
    U8
    U16
    U32
    U64
    Usize
    I8
    I16
    I32
    I64
    Isize
    F32
    F64
    String
    Struct
    Tuple
    Enum
    Node
    Pointer
    Unsupported
}

/// Compile-time description of T. Construct it with type_info[T]().
pub struct TypeInfo[T] {
}

/// A compile-time heterogeneous sequence of T's declared fields.
pub struct Fields[T] {
}

/// Description of one field, retaining its owner and value types.
pub struct FieldInfo[Owner, Value] {
}

fn unavailable[T]() -> T {
    panic("reflection metadata must be expanded by the compiler")
    loop {
    }
}

/// Requests the compiler's resolved type description.
#attr(reflection)
pub fn type_info[T]() -> TypeInfo[T] {
    ret TypeInfo[T] {}
}

impl[T] for TypeInfo[T] {
    /// Returns the type's name as a constant string.
    #attr(reflection)
    pub fn name(self: Self) -> str {
        ret unavailable[str]()
    }

    /// Returns the logical type category at compile time.
    #attr(reflection)
    pub fn kind(self: Self) -> Kind {
        ret unavailable[Kind]()
    }

    /// Tests the nominal generic declaration before selecting a concrete branch.
    #attr(reflection)
    pub fn is_template[Template](self: Self) -> bool {
        ret unavailable[bool]()
    }

    /// Selects a concrete type argument at a constant index.
    #attr(reflection)
    pub fn argument(self: Self, index: usize) -> TypeInfo[()] {
        ret unavailable[TypeInfo[()]]()
    }

    /// Returns the declared enum variants, including their concrete payload types.
    #attr(reflection)
    pub fn variants(self: Self) -> Variants[T] {
        ret unavailable[Variants[T]]()
    }

    /// Conservative inline storage bound for checked collection allocation.
    #attr(reflection)
    pub fn size_bound(self: Self) -> usize {
        ret unavailable[usize]()
    }

    /// Returns the heterogeneous field sequence of a struct or tuple.
    #attr(reflection)
    pub fn fields(self: Self) -> Fields[T] {
        ret unavailable[Fields[T]]()
    }
}

impl[Owner, Value] for FieldInfo[Owner, Value] {
    /// Returns a string annotation such as `serialize.rename`.
    #attr(reflection)
    pub fn attribute(self: Self, key: str) -> Option[str] {
        ret unavailable[Option[str]]()
    }

    /// Returns the declared field name.
    #attr(reflection)
    pub fn name(self: Self) -> str {
        ret unavailable[str]()
    }

    /// Returns the concrete type description of this field.
    #attr(reflection)
    pub fn type(self: Self) -> TypeInfo[Value] {
        ret unavailable[TypeInfo[Value]]()
    }

    /// Returns the declaration index; it is not a persistent wire identifier.
    #attr(reflection)
    pub fn index(self: Self) -> usize {
        ret unavailable[usize]()
    }

    /// Reads the selected field using the ordinary typed ownership rules.
    #attr(reflection)
    pub fn get(self: Self, value: Owner) -> Value {
        ret unavailable[Value]()
    }
}

/// Construction failures never expose a partially initialized value.
pub enum BuildError {
    MissingField(str)
}

/// Collects typed fields and constructs T only after every field is present.
pub struct Builder[T] {
}

impl[T] for Builder[T] {
    #attr(reflection)
    pub fn new() -> Self {
        ret Self {}
    }

    #attr(reflection)
    pub fn set[Value](mut self: Self, field: FieldInfo[T, Value], value: Value) ->() {
        unavailable[()]()
    }

    #attr(reflection)
    pub fn finish(self: Self) -> Result[T, BuildError] {
        ret unavailable[Result[T, BuildError]]()
    }
}

/// Compile-time enum variant sequence.
pub struct Variants[T] {
}

/// Typed descriptor of one enum variant.
pub struct VariantInfo[Owner, Value] {
}

impl[Owner, Value] for VariantInfo[Owner, Value] {
    #attr(reflection)
    pub fn name(self: Self) -> str {
        ret unavailable[str]()
    }
    #attr(reflection)
    pub fn type(self: Self) -> TypeInfo[Value] {
        ret unavailable[TypeInfo[Value]]()
    }
    #attr(reflection)
    pub fn has_payload(self: Self) -> bool {
        ret unavailable[bool]()
    }
    #attr(reflection)
    pub fn is_active(self: Self, value: Owner) -> bool {
        ret unavailable[bool]()
    }
    #attr(reflection)
    pub fn get(self: Self, value: Owner) -> Option[Value] {
        ret unavailable[Option[Value]]()
    }
    #attr(reflection)
    pub fn construct(self: Self, payload: Value) -> Owner {
        ret unavailable[Owner]()
    }
}
