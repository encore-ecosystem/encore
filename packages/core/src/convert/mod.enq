//! Explicit value conversions. From also supplies the reciprocal Into contract.
import core::cast::Cast

pub trait From[Source] {
    fn from(value: Source) -> Self
}
pub trait Into[Target] {
    fn into(self: Self) -> Target
}
impl[T] From[T] for T {
    pub fn from(value: T) -> T { ret value }
}
impl[Source, Target: From[Source]] Into[Target] for Source {
    pub fn into(self: Source) -> Target { ret Target::from(self) }
}

impl From[u8] for u16 {
    #attr(safe)
    pub fn from(value: u8) -> u16 { ret value as u16 }
}

impl From[u8] for u32 {
    #attr(safe)
    pub fn from(value: u8) -> u32 { ret value as u32 }
}

impl From[u8] for u64 {
    #attr(safe)
    pub fn from(value: u8) -> u64 { ret value as u64 }
}

impl From[u8] for i16 {
    #attr(safe)
    pub fn from(value: u8) -> i16 { ret value as i16 }
}

impl From[u8] for i32 {
    #attr(safe)
    pub fn from(value: u8) -> i32 { ret value as i32 }
}

impl From[u8] for i64 {
    #attr(safe)
    pub fn from(value: u8) -> i64 { ret value as i64 }
}

impl From[u8] for f32 {
    #attr(safe)
