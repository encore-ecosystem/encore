//! Prepared functions round-trip as typed binary data and bind their identity.
import core::testing::assert
import std::vec::Vec

import refrain::{Directive, decode_prepared_function, encode_prepared_function, fn_to_string, parse_module_text}
fn main() -> u32 {
    let module = parse_module_text("test", "fn answer() -> u32 {\n$entry:\nvalue: u32 = capprim 42_u32\nret value: u32\n}\n")
    for directive in module.directives {
        match directive {
            Directive::Function(function) => {
                let bytes = match encode_prepared_function(function, "context-a") {
                    Ok(value) => value Err(_) => {
                        ret 2_u32
                    }
                }
                let restored = match decode_prepared_function(bytes, "context-a") {
                    Ok(value) => value Err(_) => {
                        ret 3_u32
                    }
                }
                let raw = restored
                if !assert(fn_to_string(raw) == fn_to_string(function)) {
                    ret 5_u32
                }
                if !assert(decode_prepared_function(bytes, "context-b").is_err()) {
                    ret 6_u32
                }
                let mut truncated = Vec[u8]::new()
                for byte in bytes {
                    truncated.push(byte)
                }
                let _last = truncated.pop()
                if !assert(decode_prepared_function(truncated, "context-a").is_err()) {
                    ret 7_u32
                }
            }
            _ => {
            }
        }
    }
    // A valid binary envelope cannot smuggle an invalid SSA graph into LLVM.
    let invalid = parse_module_text("bad", "fn bad(value: u32) -> u64 {\n$entry:\nret value: u64\n}\n")
    for directive in invalid.directives {
        match directive {
            Directive::Function(function) => {
                let bytes = match encode_prepared_function(function, "bad-ssa") {
                    Ok(value) => value Err(_) => {
                        ret 8_u32
                    }
                }
                if !assert(decode_prepared_function(bytes, "bad-ssa").is_err()) {
                    ret 9_u32
                }
            }
            _ => {
            }
        }
    }
    ret 0_u32
}
