//! Canonical values are typed at construction; name binding never repairs IR.
import core::testing::assert
import std::vec::Vec
import refrain::{Directive, PreparationOutcome, ValueKind, parse_module_text, prepare_module, try_parse_instruction_text, try_parse_module_text}

fn rejected(source: str) -> bool {
    match try_parse_module_text("invalid", source) {
        Err(_) => { ret true }
        Ok(module) => { match prepare_module(module) {
            PreparationOutcome::Error(_) => { ret true }
            PreparationOutcome::Ready(_) => { ret false }
        } }
    }
    ret false
}

fn main() -> u32 {
    if !assert(try_parse_instruction_text("result = ieq left: u32, right: u32").is_err()) { ret 1_u32 }
    if !assert(try_parse_instruction_text("result: u32 = add left, right").is_err()) { ret 2_u32 }
    if !assert(rejected("fn broken() -> u32 {\n$entry:\nret unknown\n}\n")) { ret 3_u32 }
    if !assert(rejected("fn broken(value: u32) -> u64 {\n$entry:\nret value: u64\n}\n")) { ret 4_u32 }
    if !assert(rejected("fn broken() -> u32 {\n$entry:\nret absent: u32\n}\n")) { ret 5_u32 }
    let module = parse_module_text("binding", "fn compare(None: u32, other: u32) -> bool {\n$entry:\nequal: bool = ieq other, None\nret equal\n}\n")
    let mut checked = false
    for directive in module.directives {
        match directive {
            Directive::Function(function) => { for block in function.blocks { for instruction in block.instructions {
                match instruction {
                    refrain::Instruction::Binary(item) => {
                        checked = item.lhs.typ.name == "u32" && item.rhs.typ.name == "u32" && item.rhs.kind == ValueKind::Ssa
                    }
                    _ => {}
                }
            } } }
            _ => {}
        }
    }
    if !assert(checked) { ret 6_u32 }
    ret 0_u32
}
