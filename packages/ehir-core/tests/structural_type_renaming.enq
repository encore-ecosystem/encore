//! Renaming preserves value namespaces, literals, selectors and generic binders.
import core::option::Option
import core::testing::assert
import std::vec::Vec
import refrain::*
fn main() -> u32 {
    let nominal = plain_type("Outer", Vec[Type]::new())
    let string = plain_type("str", Vec[Type]::new())
    let definition = struct_directive("Outer", Vec[Type]::new(), vec![param("Outer", nominal)])
    let generic = FnDirective { "identity", vec![nominal], vec![param("value", nominal)], nominal,
        vec![block("entry", Vec[Instruction]::new(), ret_term(var("value", nominal)))], false, false }
    let ordinary = FnDirective { "Outer", Vec[Type]::new(), vec![param("value", nominal)], nominal,
        vec![block("entry", vec![lcpos(var("literal", string), "\"Outer = lcpos\"_str"),
            getfield(var("field", nominal), var("value", nominal), field("Outer")),
            call(var("called", nominal), "Outer::method", Vec[Type]::new(), vec![var("value", nominal)], false)],
            ret_term(var("called", nominal)))], false, false }
    let renamed = rename_module_types(make_module("test", vec![definition, Directive::Function(generic), Directive::Function(ordinary)]),
        vec![("Outer", "First"), ("First", "Final")])
    let text = module_to_string(renamed)
    if !assert(text.contains("struct Final") && text.contains("Outer: Final") && text.contains("fn identity[Outer](value: Outer) -> Outer")) { ret 1_u32 }
    if !assert(text.contains("fn Outer(value: Final) -> Final") && text.contains("Final::method") && text.contains("\"Outer = lcpos\"_str")) { ret 2_u32 }
    let mut selector_preserved = false
    for directive in renamed.directives {
        match directive {
            Directive::Function(function) => {
                if function.name != "Outer" { continue }
                for body in function.blocks { for item in body.instructions {
                    match item { Instruction::GetField(field) => { selector_preserved = field.field.name == "Outer" && field.src.typ.name == "Final" && field.out.typ.name == "Final" } _ => {} }
                } }
            }
            _ => {}
        }
    }
    if !assert(selector_preserved) { ret 3_u32 }
    let unicode = rename_module_types(make_module("unicode", vec![struct_directive("Сущность", Vec[Type]::new(), Vec[Parameter]::new())]), vec![("Сущность", "Entity")])
    if !assert(module_to_string(unicode).contains("struct Entity")) { ret 4_u32 }
    ret 0_u32
}
