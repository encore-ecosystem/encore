//! Extension/backend symbols can outgrow a conservative parser estimate.
import core::fmt::Debug
import core::testing::assert

import refrain::string_index::{string_index_get, string_index_insert, string_index_set, string_index_with_capacity}
fn main() -> u32 {
    let mut index = string_index_with_capacity(1_usize)
    for value in 0_usize..2048_usize {
        string_index_insert(index, Debug::fmt(value), value)
    }
    for value in 0_usize..2048_usize {
        if !assert(string_index_get(index, Debug::fmt(value)) == value + 1_usize) {
            ret 1_u32
        }
    }
    string_index_insert(index, "1024", 1_usize)
    if !assert(string_index_get(index, "1024") == 1025_usize) {
        ret 2_u32
    }
    string_index_set(index, "1024", 7_usize)
    if !assert(string_index_get(index, "1024") == 8_usize) {
        ret 3_u32
    }
    ret 0_u32
}
