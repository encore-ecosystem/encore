//! Typed construction retains values, preserves fragments and reports bad frames.
import core::option::Option
import core::testing::assert
import std::vec::Vec
import refrain::*
extern fn encore_node_debug_live_count() -> usize

fn run() -> bool {
    let typ = plain_type("u32", Vec[Type]::new())
    let signature = FnDirective { "answer", Vec[Type]::new(), Vec[Parameter]::new(), typ, Vec[Block]::new(), false, false }
    let child = IrBuilder::new().emit(lcpos(var("value", typ), "42_u32"))
    let stream = IrBuilder::new().documentation("The answer.").function_start(signature).label("entry")
        .append(child).terminate(ret_term(var("value", typ))).function_end()
    if child.finish_items().len() != 1_usize { ret false }
    let module = match module_from_ir_items("direct", Vec[EhirImport]::new(), Option[str]::None, stream.finish_items()) {
        Ok(value) => value Err(_) => { ret false }
    }
    if module.symbol_documentation.len() != 1_usize || module.directives.len() != 1_usize { ret false }
    match module.directives.get_unchecked_borrowed(0_usize) {
        Directive::Function(function) => {
            if function.blocks.len() != 1_usize || function.ret_type.name != "u32" { ret false }
        }
        _ => { ret false }
    }
    let duplicate = IrBuilder::new().append(child).append(child)
    if duplicate.finish_items().len() != 2_usize || child.finish_items().len() != 1_usize { ret false }
    let snapshot = child.finish_items()
    let doubled = child.append(child)
    if doubled.finish_items().len() != 2_usize || snapshot.len() != 1_usize { ret false }
    let invalid = IrBuilder::new().function_start(signature).label("entry").function_end()
    if module_from_ir_items("bad", Vec[EhirImport]::new(), Option[str]::None, invalid.finish_items()).is_ok() { ret false }
    ret true
}
fn main() -> u32 {
    let before = unsafe { encore_node_debug_live_count() }
    if !assert(run()) { ret 1_u32 }
    if !assert(unsafe { encore_node_debug_live_count() } == before) { ret 2_u32 }
    ret 0_u32
}
