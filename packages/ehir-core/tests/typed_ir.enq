//! Indexed values preserve semantics and reject unresolved or corrupt references.
import core::testing::assert
import std::vec::Vec

import refrain::{Block, Directive, Instruction, Parameter, RepresentationKind, Type, TypeId, TypedDirective, TypedFunction, TypedValue, alias, any_node_type, block, fn_item, freeze_function, freeze_program, make_module_bundle, module_bundle_to_string, param, parse_module_text, plain_type, ret_term, thaw_function, thaw_program, var}

fn main() -> u32 {
    let source = "struct Pair {\nleft: u32\nright: u32\n}\n" +
    "fn read(pair: Pair) -> u32 {\n$entry:\nvalue: u32 = getfield pair > 0\nret value: u32\n}\n" +
    "fn choose(flag: bool) -> u32 {\n$entry:\ncbr flag, $left, $right\n" +
    "$left:\na: u32 = capprim 41_u32\nbr $done\n" +
    "$right:\nb: u32 = capprim 42_u32\nbr $done\n" +
    "$done:\nanswer: u32 = phi a: u32 $left, b: u32 $right\nret answer: u32\n}\n"
    let bundle = make_module_bundle("test", vec![parse_module_text("test", source)])
    let frozen = match freeze_program(bundle) {
        Ok(value) => value Err(_) => {
            ret 1_u32
        }
    }
    let restored = match thaw_program(frozen) {
        Ok(value) => value Err(_) => {
            ret 2_u32
        }
    }
    if !assert(module_bundle_to_string(bundle) == module_bundle_to_string(restored)) {
        ret 3_u32
    }
    let missing = parse_module_text("missing", "fn broken() -> u32 {\n$entry:\nret absent: u32\n}\n")
    if !assert(freeze_program(make_module_bundle("missing", vec![missing])).is_err()) {
        ret 4_u32
    }
    for module in frozen.modules {
        for directive in module.directives {
            match directive {
                TypedDirective::Function(function) => {
                    if function.signature.name == "read" {
                        let mut values = Vec[TypedValue]::new()
                        for value in function.values {
                            values.push(TypedValue {
                                    value.name, TypeId {
                                        999999_usize
                                    }
                                }
                            )
                        }
                        let corrupt = TypedFunction {
                            function.signature, function.symbols, function.types, values, function.blocks
                        }
                        if !assert(thaw_function(corrupt).is_err()) {
                            ret 5_u32
                        }
                    }
                }
                _ => {
                }
            }
        }
    }
    let address = any_node_type(plain_type("Element", Vec[Type]::new()))
    let ambiguous = Type { "Element&", Vec[Type]::new(), RepresentationKind::Inline }
    let bad = fn_item("bad", Vec[Type]::new(), vec![param("input", address)], ambiguous,
        vec![block("entry", vec![alias(var("copy", ambiguous), var("input", ambiguous))], ret_term(var("copy", ambiguous)))],)
    if !assert(freeze_function(bad).is_err()) {
        ret 6_u32
    }
    ret 0_u32
}
