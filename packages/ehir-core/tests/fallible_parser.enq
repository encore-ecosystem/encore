//! Invalid text returns an error and leaves the caller able to keep compiling.
import core::testing::assert
import refrain::{try_parse_instruction_text, try_parse_module_bundle_text, try_parse_type_text}

fn main() -> u32 {
    if !assert(try_parse_type_text("").is_err()) {
        ret 1_u32
    }
    if !assert(try_parse_type_text("Vec[u32").is_err()) {
        ret 2_u32
    }
    if !assert(try_parse_instruction_text("nonsense").is_err()) {
        ret 3_u32
    }
    if !assert(try_parse_instruction_text("result: u32 = unsupported 1").is_err()) {
        ret 4_u32
    }
    if !assert(try_parse_module_bundle_text("bad", "not a module").is_err()) {
        ret 5_u32
    }
    let valid = "fn answer() -> u32 {\n$entry:\nvalue: u32 = capprim 42_u32\nret value: u32\n}\n"
    if !assert(try_parse_module_bundle_text("good", "module good {\n" + valid + "}\n").is_ok()) {
        ret 6_u32
    }
    ret 0_u32
}
