//! Type demand follows structural rename positions and lexical generic scopes.
import core::option::Option
import core::testing::assert

import std::vec::Vec

import refrain::*

fn contains(names: Vec[str], expected: str) -> bool {
    for name in names {
        if name == expected {
            ret true
        }
    }
    ret false
}

fn main() -> u32 {
    let binder = plain_type("Bound", Vec[Type]::new())
    let scalar = plain_type("u32", Vec[Type]::new())
    let pointer = plain_type("Pointer*", vec![plain_type("Argument", Vec[Type]::new())])
    let generic = FnDirective {
        "Literal", vec![binder], vec![param("Field", binder)], binder,
        vec![block("Label", vec![comment("Comment"), lcpos(var("Variable", scalar), "\"String\"_str"),
                    call(var("result", scalar), "Owner::method", vec![pointer], Vec[Variable]::new(), false),
                    getfield(var("field", scalar), var("source", scalar), annotated_field("Selector", plain_type("Annotation", Vec[Type]::new())))],
                ret_term(var("Variable", binder)),)], false, false, Option[Type]::None
    }
    let module = make_module_with_metadata("Module", vec![ehir_import("Import")], Option[str]::Some("ModuleDoc"),
        vec![ehir_documentation("impl Documentation", "DocText")], vec![Directive::Function(generic)],)
    let before = module_to_string(module)
    let names = module_nominal_type_names(module)
    for expected in vec!["u32", "Owner", "Pointer", "Argument", "Annotation", "Documentation"] {
        if !assert(contains(names, expected)) {
            ret 1_u32
        }
    }
    for excluded in vec!["Bound", "Literal", "Field", "Label", "Comment", "Variable", "String", "method", "Selector", "Module", "Import", "ModuleDoc", "DocText"] {
        if !assert(!contains(names, excluded)) {
            ret 2_u32
        }
    }
    if !assert(module_to_string(module) == before) {
        ret 3_u32
    }
    let empty = module_nominal_type_names(make_module("empty", Vec[Directive]::new()))
    if !assert(empty.is_empty()) {
        ret 4_u32
    }
    ret 0_u32
}
