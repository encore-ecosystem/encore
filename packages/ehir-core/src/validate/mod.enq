import core::option::Option
import core::result::Result

import std::vec::Vec

import refrain::core::{BinaryOpKind, Block, Directive, EdgeInstruction, FnDirective, Instruction, Module, RepresentationKind, Terminator, Type, ValueKind, Variable, instruction_inputs, instruction_result, memory_value_type, var}
import refrain::coroutine::validate_coroutine_moves
import refrain::string_index::{StringIndex, string_index_get, string_index_set, string_index_with_capacity}
import refrain::string_set::{StringSet, string_set_contains, string_set_contains_or_insert, string_set_with_capacity}

pub fn validate_module(module: Module) -> Result[Module, str] {
    for directive in module.directives {
        match directive {
            Directive::Function(function) => {
                match validate_function(function) {
                    Some(message) => {
                        ret Result[Module, str]::Err(message)
                    }
                    None => {
                    }
                }
            }
            Directive::Impl(item) => {
                for method in item.methods {
                    match validate_function(method) {
                        Some(message) => {
                            ret Result[Module, str]::Err(message)
                        }
                        None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    ret Result[Module, str]::Ok(module)
}

fn validate_function(function: FnDirective) -> Option[str] {
    if function.is_extern {
        if function.is_async {
            ret invalid(function.name, "extern function must not be async")
        }
        if function.blocks.len() > 0_usize {
            ret invalid(function.name, "extern function must not contain blocks")
        }
        ret Option[str]::None
    }
    if function.blocks.len() == 0_usize {
        ret invalid(function.name, "function must contain at least one block")
    }

    let mut labels = string_set_with_capacity(function.blocks.len())
    for block_item in function.blocks {
        if block_item.name == "" {
            ret invalid(function.name, "block name must not be empty")
        }
        if string_set_contains_or_insert(labels, block_item.name) {
            ret invalid(function.name, "duplicate block '" + block_item.name + "'")
        }
    }

    match validate_phi_nodes(function) {
        Some(message) => {
            ret Option[str]::Some(message)
        }
        None => {
        }
    }
    if function.is_async {
        match validate_coroutine_moves(function) {
            Some(message) => {
                ret invalid(function.name, message)
            }
            None => {
            }
        }
    }

    let mut definitions = ValueDefinitions {
        string_index_with_capacity(function_value_count(function)), Vec[Variable]::new()
    }
    for parameter in function.params {
        match add_definition(definitions, var(parameter.name, parameter.typ), function.name) {
            Some(message) => {
                ret Option[str]::Some(message)
            }
            None => {
            }
        }
    }
    for block_item in function.blocks {
        for instruction in block_item.instructions {
            match instruction_result(instruction) {
                Some(value) => {
                    match add_definition(definitions, value, function.name) {
                        Some(message) => {
                            ret Option[str]::Some(message)
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
        }
        match block_item.terminator {
            Terminator::Match(item) => {
                for arm in item.arms {
                    match arm.payload_var {
                        Some(value) => {
                            match add_definition(definitions, value, function.name) {
                                Some(message) => {
                                    ret Option[str]::Some(message)
                                }
                                None => {
                                }
                            }
                        }
                        None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }

    for block_item in function.blocks {
        for instruction in block_item.instructions {
            for value in instruction_inputs(instruction) {
                match validate_use(definitions, value, function.name) {
                    Some(message) => {
                        ret Option[str]::Some(message)
                    }
                    None => {
                    }
                }
            }
            match validate_instruction(function.name, function.is_async, instruction) {
                Some(message) => {
                    ret Option[str]::Some(message)
                }
                None => {
                }
            }
        }
        let mut uses = Vec[Variable]::new()
        match block_item.terminator {
            Terminator::Ret(item) => uses.push(item.value)
            Terminator::Cbr(item) => uses.push(item.cond)
            Terminator::Match(item) => uses.push(item.scrutinee)
            Terminator::Switch(item) => uses.push(item.scrutinee)
            _ => {
            }
        }
        for value in uses {
            match validate_use(definitions, value, function.name) {
                Some(message) => {
                    ret Option[str]::Some(message)
                }
                None => {
                }
            }
        }
        match validate_terminator(function, block_item, labels) {
            Some(message) => {
                ret Option[str]::Some(message)
            }
            None => {
            }
        }
    }
    ret Option[str]::None
}

fn function_value_count(function: FnDirective) -> usize {
    let mut count = function.params.len()
    for block_item in function.blocks {
        count += block_item.instructions.len()
    }
    ret count
}

fn validate_instruction(function_name: str, is_async: bool, instruction: Instruction) -> Option[str] {
    match instruction {
        Instruction::Store(item) => {
            let dst_type = item.dst.typ
            if !is_memory_place(dst_type) {
                ret invalid(function_name, "store destination '" + item.dst.name + "' is not a raw address or local place")
            }
            let src_type = item.src.typ
            if !same_type(src_type, memory_value_type(dst_type)) {
                ret invalid(function_name, "store source and destination types do not match")
            }
        }
        Instruction::Load(item) => {
            let src_type = item.src.typ
            if !is_memory_place(src_type) {
                ret invalid(function_name, "load source '" + item.src.name + "' is not a raw address or local place")
            }
            let out_type = item.out.typ
            if !same_type(out_type, memory_value_type(src_type)) {
                ret invalid(function_name, "load result and source types do not match")
            }
        }
        Instruction::SetField(item) => {
            let src_type = item.src.typ
            if !is_field_place(src_type) {
                ret invalid(function_name, "setfield target '" + item.src.name + "' is neither a node handle nor an addressable place")
            }
        }
        Instruction::Lcsos(item) => {
            let out_type = item.out.typ
            if !same_type(out_type, item.typ) {
                ret invalid(function_name, "lcsos result type does not match its construction type")
            }
            if !is_constructible_value_or_node(item.typ) {
                ret invalid(function_name, "lcsos requires inline, <S>, or <H> placement; '&' is placement-erased and cannot be constructed")
            }
        }
        Instruction::StackAlloc(item) => {
            let out_type = item.out.typ
            if !is_raw_address(out_type) {
                ret invalid(function_name, "salloc result must be a raw address")
            }
            // salloc reserves storage *for a value*.  The stored value may be
            // an inline aggregate, a node handle, a raw address, or the
            // transitional LocalPlace used before local-to-SSA lowering.
            // Placement of the storage is not placement of the referenced
            // node, so restricting this to Inline rejects valid coroutine
            // spill slots and conflates two independent concepts.
        }
        Instruction::HeapAlloc(item) => {
            let out_type = item.out.typ
            if !is_raw_address(out_type) {
                ret invalid(function_name, "halloc result must be a raw address")
            }
            // Like salloc, halloc allocates untyped storage for one value; a
            // handle stored there keeps its own node placement semantics.
        }
        Instruction::HeapRealloc(item) => {
            let out_type = item.out.typ
            if !is_raw_address(out_type) {
                ret invalid(function_name, "hrealloc result must be a raw address")
            }
            let src_type = item.src.typ
            if !is_raw_address(src_type) {
                ret invalid(function_name, "hrealloc source must be a raw address")
            }
        }
        Instruction::Binary(item) => {
            let lhs_type = item.lhs.typ
            let rhs_type = item.rhs.typ
            if item.rhs.kind == ValueKind::EnumTag {
                if !is_equality(item.op) {
                    ret invalid(function_name, "enum tags require an equality comparison")
                }
            } elif !same_type(lhs_type, rhs_type) {
                ret invalid(function_name, "binary operand types do not match")
            }
            let out_type = item.out.typ
            if is_comparison(item.op) && !is_plain_named(out_type, "bool") {
                ret invalid(function_name, "comparison result must have type 'bool'")
            }
        }
        Instruction::Alias(item) => {
            ret validate_same_variables(function_name, item.out, item.src, "alias")
        }
        Instruction::Await(item) => {
            if !is_async {
                ret invalid(function_name, "await instruction requires an async function")
            }
        }
        Instruction::HeapFree(item) => {
            let src_type = item.src.typ
            if !is_raw_address(src_type) {
                ret invalid(function_name, "hfree operand is not a raw address")
            }
        }
        Instruction::Cfree(item) => {
            let value_type = item.value.typ
            if !is_node_handle(value_type) {
                ret invalid(function_name, "cfree requires an owning node handle")
            }
        }
        Instruction::AddEdge(item) => {
            ret validate_edge_instruction(function_name, item)
        }
        Instruction::RemoveEdge(item) => {
            ret validate_edge_instruction(function_name, item)
        }
        Instruction::Drop(item) => {
            let value_type = item.value.typ
            if is_memory_place(value_type) {
                ret invalid(function_name, "drop cannot consume a raw address or local place")
            }
        }
        Instruction::Retain(item) => {
            let value_type = item.value.typ
            if is_memory_place(value_type) {
                ret invalid(function_name, "retain cannot copy a raw address or local place")
            }
        }
        _ => {
        }
    }
    ret Option[str]::None
}
fn validate_edge_instruction(function_name: str, item: EdgeInstruction) -> Option[str] {
    let owner_type = item.owner.typ
    if !is_node_handle(owner_type) {
        ret invalid(function_name, "graph edge owner must be an owning node handle")
    }
    ret Option[str]::None
}

fn validate_phi_nodes(function: FnDirective) -> Option[str] {
    for block_item in function.blocks {
        // Most lowered Encore blocks do not contain a phi. Computing their
        // predecessor list scans the complete CFG, so doing it unconditionally
        // made validation quadratic for large generated state machines.
        if !block_has_phi(block_item) {
            continue
        }
        let predecessors = predecessor_names(function.blocks, block_item.name)
        let mut saw_non_phi = false
        for instruction in block_item.instructions {
            match instruction {
                Instruction::Phi(item) => {
                    if saw_non_phi {
                        ret invalid(function.name, "phi instructions must appear at the start of block '" + block_item.name + "'")
                    }
                    if item.pairs.len() != predecessors.len() {
                        ret invalid(function.name, "phi in block '" + block_item.name + "' must have one value for every predecessor")
                    }
                    let out_type = item.out.typ
                    let mut seen = Vec[str]::new()
                    for pair in item.pairs {
                        if !contains(predecessors, pair.label) {
                            ret invalid(function.name, "phi references non-predecessor block '" + pair.label + "'")
                        }
                        if contains(seen, pair.label) {
                            ret invalid(function.name, "phi contains duplicate predecessor '" + pair.label + "'")
                        }
                        seen.push(pair.label)

                        let value_type = pair.value.typ

                        if !same_type(out_type, value_type) {
                            ret invalid(function.name, "phi input and output types do not match")
                        }

                    }
                }
                _ => {
                    saw_non_phi = true
                }
            }
        }
    }
    ret Option[str]::None
}

fn block_has_phi(block_item: Block) -> bool {
    for instruction in block_item.instructions {
        match instruction {
            Instruction::Phi(_) => {
                ret true
            }
            _ => {
            }
        }
    }
    ret false
}

fn predecessor_names(blocks: Vec[Block], target: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    for block_item in blocks {
        if terminator_targets(block_item.terminator, target) {
            out.push(block_item.name)
        }
    }
    ret out
}

fn terminator_targets(terminator: Terminator, target: str) -> bool {
    match terminator {
        Terminator::Br(item) => {
            ret item.label == target
        }
        Terminator::Cbr(item) => {
            ret item.true_label == target || item.false_label == target
        }
        Terminator::Match(item) => {
            if item.default_label == target {
                ret true
            }
            for arm in item.arms {
                if arm.label == target {
                    ret true
                }
            }
        }
        Terminator::Switch(item) => {
            if item.default_label == target {
                ret true
            }
            for case_item in item.cases {
                if case_item.label == target {
                    ret true
                }
            }
        }
        _ => {
        }
    }
    ret false
}

fn validate_terminator(function: FnDirective, block_item: Block, labels: mut StringSet) -> Option[str] {
    match block_item.terminator {
        Terminator::Ret(item) => {

            let value_type = item.value.typ

            if !same_type(value_type, function.ret_type) {
                ret invalid(function.name, "return type does not match function result type")
            }

        }
        Terminator::Br(item) => {
            if !string_set_contains(labels, item.label) {
                ret invalid(function.name, "branch targets unknown block '" + item.label + "'")
            }
        }
        Terminator::Cbr(item) => {

            let cond_type = item.cond.typ

            if !is_plain_named(cond_type, "bool") {
                ret invalid(function.name, "conditional branch condition must have type 'bool'")
            }

            if !string_set_contains(labels, item.true_label) {
                ret invalid(function.name, "branch targets unknown block '" + item.true_label + "'")
            }
            if !string_set_contains(labels, item.false_label) {
                ret invalid(function.name, "branch targets unknown block '" + item.false_label + "'")
            }
        }
        Terminator::Match(item) => {

            if !string_set_contains(labels, item.default_label) {
                ret invalid(function.name, "match targets unknown block '" + item.default_label + "'")
            }
            for arm in item.arms {
                if !string_set_contains(labels, arm.label) {
                    ret invalid(function.name, "match targets unknown block '" + arm.label + "'")
                }
            }
        }
        Terminator::Switch(item) => {

            if !string_set_contains(labels, item.default_label) {
                ret invalid(function.name, "switch targets unknown block '" + item.default_label + "'")
            }
            for case_item in item.cases {
                if !string_set_contains(labels, case_item.label) {
                    ret invalid(function.name, "switch targets unknown block '" + case_item.label + "'")
                }
            }
        }
        Terminator::Unreachable => {
        }
    }
    ret Option[str]::None
}

fn validate_same_variables(function_name: str, lhs: Variable, rhs: Variable, operation: str) -> Option[str] {

    let lhs_type = lhs.typ

    let rhs_type = rhs.typ

    if !same_type(lhs_type, rhs_type) {
        ret invalid(function_name, operation + " operand types do not match")
    }

    ret Option[str]::None
}

fn same_value_type(lhs: Type, rhs: Type) -> bool {
    if !same_type_name(lhs.name, rhs.name) || lhs.generics.len() != rhs.generics.len() {
        ret false
    }
    let mut index = 0_usize
    while index < lhs.generics.len() {
        match lhs.generics.get(index) {
            Some(lhs_arg) => {
                match rhs.generics.get(index) {
                    Some(rhs_arg) => {
                        if !same_type(lhs_arg, rhs_arg) {
                            ret false
                        }
                    }
                    None => {
                        ret false
                    }
                }
            }
            None => {
                ret false
            }
        }
        index = index + 1_usize
    }
    ret true
}

fn same_type_name(lhs: str, rhs: str) -> bool {
    if lhs == rhs {
        ret true
    }
    if (lhs == "bool" && rhs == "u1") ||(lhs == "u1" && rhs == "bool") {
        ret true
    }
    if (lhs == "()" && rhs == "void") ||(lhs == "void" && rhs == "()") {
        ret true
    }
    ret false
}

fn same_type(lhs: Type, rhs: Type) -> bool {
    if !same_representation(lhs.representation, rhs.representation) {
        ret false
    }
    ret same_value_type(lhs, rhs)
}

fn same_representation(lhs: RepresentationKind, rhs: RepresentationKind) -> bool {
    match lhs {
        RepresentationKind::Inline => {
            match rhs {
                RepresentationKind::Inline => {
                    ret true
                }
                _ => {
                    ret false
                }
            }
        }
        RepresentationKind::NodeStack => {
            match rhs {
                RepresentationKind::NodeStack => {
                    ret true
                }
                _ => {
                    ret false
                }
            }
        }
        RepresentationKind::NodeHeap => {
            match rhs {
                RepresentationKind::NodeHeap => {
                    ret true
                }
                _ => {
                    ret false
                }
            }
        }
        RepresentationKind::NodeAny => {
            match rhs {
                RepresentationKind::NodeAny => {
                    ret true
                }
                _ => {
                    ret false
                }
            }
        }
        RepresentationKind::Raw => {
            match rhs {
                RepresentationKind::Raw => {
                    ret true
                }
                _ => {
                    ret false
                }
            }
        }
        RepresentationKind::LocalPlace => {
            match rhs {
                RepresentationKind::LocalPlace => {
                    ret true
                }
                _ => {
                    ret false
                }
            }
        }
    }
    ret false
}

fn is_raw_address(typ: Type) -> bool {
    ret typ.representation == RepresentationKind::Raw
}

fn is_memory_place(typ: Type) -> bool {
    ret typ.representation == RepresentationKind::Raw || typ.representation == RepresentationKind::LocalPlace
}

fn is_node_handle(typ: Type) -> bool {
    ret typ.representation == RepresentationKind::NodeStack ||
    typ.representation == RepresentationKind::NodeHeap ||
    typ.representation == RepresentationKind::NodeAny
}

fn is_field_place(typ: Type) -> bool {
    ret is_node_handle(typ) || is_memory_place(typ)
}

fn is_constructible_value_or_node(typ: Type) -> bool {
    ret typ.representation == RepresentationKind::Inline ||
    typ.representation == RepresentationKind::NodeStack ||
    typ.representation == RepresentationKind::NodeHeap
}

fn is_plain_named(typ: Type, name: str) -> bool {
    if typ.name != name {
        ret false
    }
    match typ.representation {
        RepresentationKind::Inline => {
            ret true
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn is_comparison(kind: BinaryOpKind) -> bool {
    match kind {
        BinaryOpKind::LES => {
            ret true
        }
        BinaryOpKind::LEQ => {
            ret true
        }
        BinaryOpKind::GRT => {
            ret true
        }
        BinaryOpKind::GEQ => {
            ret true
        }
        BinaryOpKind::IEQ => {
            ret true
        }
        BinaryOpKind::NEQ => {
            ret true
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn is_equality(kind: BinaryOpKind) -> bool {
    match kind {
        BinaryOpKind::IEQ => {
            ret true
        }
        BinaryOpKind::NEQ => {
            ret true
        }
        _ => {
            ret false
        }
    }
    ret false
}

fn contains(values: Vec[str], expected: str) -> bool {
    for value in values {
        if value == expected {
            ret true
        }
    }
    ret false
}

fn invalid(function_name: str, message: str) -> Option[str] {
    ret Option[str]::Some("function '" + function_name + "': " + message)
}

struct ValueDefinitions {
    index: StringIndex
    values: Vec[Variable]
}
fn add_definition(table: mut ValueDefinitions, value: Variable, owner: str) -> Option[str] {
    if value.name.is_empty() {
        ret invalid(owner, "SSA definition name must not be empty")
    }
    if string_index_get(table.index, value.name) != 0_usize {
        ret invalid(owner, "duplicate value '" + value.name + "'")
    }
    if value.kind != ValueKind::Ssa {
        ret invalid(owner, "a literal cannot be an SSA definition")
    }
    string_index_set(table.index, value.name, table.values.len())
    table.values.push(value)
    ret Option[str]::None
}
fn validate_use(table: mut ValueDefinitions, value: Variable, owner: str) -> Option[str] {
    if value.kind == ValueKind::Unit {
        if value.name != "void" || !value.typ.generics.is_empty() ||
        (!is_plain_named(value.typ, "void") && !is_plain_named(value.typ, "()")) {
            ret invalid(owner, "invalid unit literal")
        }
        ret Option[str]::None
    }
    if value.kind == ValueKind::EnumTag {
        if value.name.is_empty() || !is_plain_named(value.typ, "u32") {
            ret invalid(owner, "invalid enum tag literal")
        }
        ret Option[str]::None
    }
    let position = string_index_get(table.index, value.name)
    if position == 0_usize {
        ret invalid(owner, "undefined SSA value: " + value.name)
    }
    if !same_declared_type(table.values.get_unchecked_borrowed(position - 1_usize).typ, value.typ) {
        ret invalid(owner, "inconsistent type for SSA value: " + value.name)
    }
    ret Option[str]::None
}
fn same_declared_type(left: Type, right: Type) -> bool {
    if left.name != right.name || left.representation != right.representation || left.generics.len() != right.generics.len() {
        ret false
    }
    for index in 0_usize..left.generics.len() {
        if !same_declared_type(left.generics.get_unchecked_borrowed(index), right.generics.get_unchecked_borrowed(index)) {
            ret false
        }
    }
    ret true
}
