fn write_RepresentationKind(writer: mut SnapshotWriter, value: frozen RepresentationKind) ->() {
    if !writer_enter(writer) {
        ret()
    }
    match value {
        Inline => {
            write_u8(writer, 0_u8)
        }
        NodeStack => {
            write_u8(writer, 1_u8)
        }
        NodeHeap => {
            write_u8(writer, 2_u8)
        }
        NodeAny => {
            write_u8(writer, 3_u8)
        }
        Raw => {
            write_u8(writer, 4_u8)
        }
        LocalPlace => {
            write_u8(writer, 5_u8)
        }
    }
    writer.depth -= 1_usize
}

fn read_RepresentationKind(reader: mut SnapshotReader) -> Result[RepresentationKind, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => RepresentationKind::Inline
        1_u8 => RepresentationKind::NodeStack
        2_u8 => RepresentationKind::NodeHeap
        3_u8 => RepresentationKind::NodeAny
        4_u8 => RepresentationKind::Raw
        5_u8 => RepresentationKind::LocalPlace
        _ => {
            ret Result::Err("invalid EHIR variant tag")
        }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

