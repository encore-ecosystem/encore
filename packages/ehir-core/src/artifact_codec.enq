fn write_YieldInstruction(writer: mut SnapshotWriter, value: frozen YieldInstruction) ->() {
    if !writer_enter(writer) { ret() }
    write_Variable(writer, value.value)
    write_Vec_CallInstruction(writer, value.cleanups)
    writer.depth -= 1_usize
}

fn read_YieldInstruction(reader: mut SnapshotReader) -> Result[YieldInstruction, str] {
    reader_enter(reader)?
    let value = YieldInstruction { read_Variable(reader)?, read_Vec_CallInstruction(reader)? }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}
pub fn encode_snapshot_Module(value: Module, identity: str) -> Result[Vec[u8], str] {
    let mut writer = new_snapshot_writer("ENQTM002", identity)
    write_Module(writer, value)
    unsafe {
        encore_strmap_free(writer.strings)
    }
    if writer.failed {
        ret Result::Err("EHIR snapshot " + writer.failure + " limit (" + Debug::fmt(writer.bytes.len()) + " bytes)")
    }
    ret Result::Ok(writer.bytes)
}
pub fn decode_snapshot_Module(bytes: Vec[u8], identity: str) -> Result[Module, str] {
    let mut reader = new_snapshot_reader(bytes, "ENQTM002", identity)?
    let value = read_Module(reader)?
    if reader.cursor != reader.bytes.len() {
        ret Result::Err("trailing EHIR snapshot bytes")
    }
    ret Result::Ok(value)
}

pub fn encode_snapshot_FnDirective(value: FnDirective, identity: str) -> Result[Vec[u8], str] {
    let mut writer = new_snapshot_writer("ENQTF002", identity)
