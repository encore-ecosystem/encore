fn write_Option_Type(writer: mut SnapshotWriter, value: frozen Option[Type]) ->() {
    if !writer_enter(writer) {
        ret()
    }
    match value {
        Some(item) => {
            write_u8(writer, 1_u8) write_Type(writer, item)
        }
        None => {
            write_u8(writer, 0_u8)
        }
    }
    writer.depth -= 1_usize
}

fn read_Option_Type(reader: mut SnapshotReader) -> Result[Option[Type], str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = if tag == 0_u8 {
        Option[Type]::None
    } elif tag == 1_u8 {
        Option[Type]::Some(read_Type(reader)?)
    } else {
        ret Result::Err("invalid EHIR optional tag")
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

fn write_Option_Variable(writer: mut SnapshotWriter, value: frozen Option[Variable]) ->() {
