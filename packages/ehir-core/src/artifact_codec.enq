fn write_Terminator(writer: mut SnapshotWriter, value: frozen Terminator) ->() {
    if !writer_enter(writer) {
        ret()
    }
    match value {
        Unreachable => {
            write_u8(writer, 0_u8)
        }
        Ret(item) => {
            write_u8(writer, 1_u8) write_ReturnInstruction(writer, item)
        }
        Br(item) => {
            write_u8(writer, 2_u8) write_BranchInstruction(writer, item)
        }
        Cbr(item) => {
            write_u8(writer, 3_u8) write_ConditionalBranchInstruction(writer, item)
        }
        Match(item) => {
            write_u8(writer, 4_u8) write_MatchInstruction(writer, item)
        }
        Switch(item) => {
            write_u8(writer, 5_u8) write_SwitchInstruction(writer, item)
        }
    }
    writer.depth -= 1_usize
}

fn read_Terminator(reader: mut SnapshotReader) -> Result[Terminator, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => Terminator::Unreachable
        1_u8 => Terminator::Ret(read_ReturnInstruction(reader)?)
        2_u8 => Terminator::Br(read_BranchInstruction(reader)?)
        3_u8 => Terminator::Cbr(read_ConditionalBranchInstruction(reader)?)
        4_u8 => Terminator::Match(read_MatchInstruction(reader)?)
        5_u8 => Terminator::Switch(read_SwitchInstruction(reader)?)
        _ => {
            ret Result::Err("invalid EHIR variant tag")
        }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

