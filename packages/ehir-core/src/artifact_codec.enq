    writer.depth -= 1_usize
}

fn read_Vec_Block(reader: mut SnapshotReader) -> Result[Vec[Block], str] {
    reader_enter(reader)?
    let count = read_count(reader, 256_usize)?
    let mut value = Vec[Block]::with_capacity(count)
    for _index in 0_usize..count {
        value.push(read_Block(reader)?)
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

