        EnumTag => {
            write_u8(writer, 1_u8)
        }
        Unit => {
            write_u8(writer, 2_u8)
        }
    }
    writer.depth -= 1_usize
}

fn read_ValueKind(reader: mut SnapshotReader) -> Result[ValueKind, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => ValueKind::Ssa
        1_u8 => ValueKind::EnumTag
        2_u8 => ValueKind::Unit
        _ => {
            ret Result::Err("invalid EHIR variant tag")
        }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

