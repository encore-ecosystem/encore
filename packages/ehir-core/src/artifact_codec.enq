fn write_Instruction(writer: mut SnapshotWriter, value: frozen Instruction) ->() {
    if !writer_enter(writer) {
        ret()
    }
    match value {
        Comment(item) => {
            write_u8(writer, 0_u8) write_CommentInstruction(writer, item)
        }
        Lcpos(item) => {
            write_u8(writer, 1_u8) write_LcposInstruction(writer, item)
        }
        Alias(item) => {
            write_u8(writer, 2_u8) write_AliasInstruction(writer, item)
        }
        Lcsos(item) => {
            write_u8(writer, 3_u8) write_LcsosInstruction(writer, item)
        }
        Lceos(item) => {
            write_u8(writer, 4_u8) write_LceosInstruction(writer, item)
        }
        Call(item) => {
            write_u8(writer, 5_u8) write_CallInstruction(writer, item)
        }
        Await(item) => {
            write_u8(writer, 6_u8) write_AwaitInstruction(writer, item)
        }

Yield(item) => { write_u8(writer, 7_u8) write_YieldInstruction(writer, item) }
Store(item) => {
            write_u8(writer, 8_u8) write_StoreInstruction(writer, item)
        }
        Load(item) => {
            write_u8(writer, 9_u8) write_LoadInstruction(writer, item)
        }
        GetField(item) => {
            write_u8(writer, 10_u8) write_GetFieldInstruction(writer, item)
        }
        SetField(item) => {
            write_u8(writer, 11_u8) write_SetFieldInstruction(writer, item)
        }
        GetFieldPtr(item) => {
            write_u8(writer, 12_u8) write_GetFieldPtrInstruction(writer, item)
        }
        SGetField(item) => {
            write_u8(writer, 13_u8) write_SGetFieldInstruction(writer, item)
        }
        SGetFieldPtr(item) => {
            write_u8(writer, 14_u8) write_SGetFieldPtrInstruction(writer, item)
        }
        GetPtr(item) => {
            write_u8(writer, 15_u8) write_GetPtrInstruction(writer, item)
        }
        Gep(item) => {
            write_u8(writer, 16_u8) write_GepInstruction(writer, item)
        }
        PtrCast(item) => {
            write_u8(writer, 17_u8) write_PtrCastInstruction(writer, item)
        }
        StackAlloc(item) => {
            write_u8(writer, 18_u8) write_StackAllocInstruction(writer, item)
        }
        HeapAlloc(item) => {
            write_u8(writer, 19_u8) write_HeapAllocInstruction(writer, item)
        }
        HeapRealloc(item) => {
            write_u8(writer, 20_u8) write_HeapReallocInstruction(writer, item)
        }
        HeapFree(item) => {
            write_u8(writer, 21_u8) write_HeapFreeInstruction(writer, item)
        }
        Put(item) => {
            write_u8(writer, 22_u8) write_PutInstruction(writer, item)
        }
        Binary(item) => {
            write_u8(writer, 23_u8) write_BinaryInstruction(writer, item)
        }
        Phi(item) => {
            write_u8(writer, 24_u8) write_PhiInstruction(writer, item)
        }
        AddEdge(item) => {
            write_u8(writer, 25_u8) write_EdgeInstruction(writer, item)
        }
        RemoveEdge(item) => {
            write_u8(writer, 26_u8) write_EdgeInstruction(writer, item)
        }
        Cfree(item) => {
            write_u8(writer, 27_u8) write_CfreeInstruction(writer, item)
        }
        Drop(item) => {
            write_u8(writer, 28_u8) write_DropInstruction(writer, item)
        }
        Retain(item) => {
            write_u8(writer, 29_u8) write_RetainInstruction(writer, item)
        }
    }
    writer.depth -= 1_usize
}

fn read_Instruction(reader: mut SnapshotReader) -> Result[Instruction, str] {
    reader_enter(reader)?
    let tag = read_u8(reader)?
    let value = match tag {
        0_u8 => Instruction::Comment(read_CommentInstruction(reader)?)
        1_u8 => Instruction::Lcpos(read_LcposInstruction(reader)?)
        2_u8 => Instruction::Alias(read_AliasInstruction(reader)?)
        3_u8 => Instruction::Lcsos(read_LcsosInstruction(reader)?)
        4_u8 => Instruction::Lceos(read_LceosInstruction(reader)?)
        5_u8 => Instruction::Call(read_CallInstruction(reader)?)
        6_u8 => Instruction::Await(read_AwaitInstruction(reader)?)
        7_u8 => Instruction::
Yield(read_YieldInstruction(reader)?)
        8_u8 => Instruction::
Store(read_StoreInstruction(reader)?)
        9_u8 => Instruction::Load(read_LoadInstruction(reader)?)
        10_u8 => Instruction::GetField(read_GetFieldInstruction(reader)?)
        11_u8 => Instruction::SetField(read_SetFieldInstruction(reader)?)
        12_u8 => Instruction::GetFieldPtr(read_GetFieldPtrInstruction(reader)?)
        13_u8 => Instruction::SGetField(read_SGetFieldInstruction(reader)?)
        14_u8 => Instruction::SGetFieldPtr(read_SGetFieldPtrInstruction(reader)?)
        15_u8 => Instruction::GetPtr(read_GetPtrInstruction(reader)?)
        16_u8 => Instruction::Gep(read_GepInstruction(reader)?)
        17_u8 => Instruction::PtrCast(read_PtrCastInstruction(reader)?)
        18_u8 => Instruction::StackAlloc(read_StackAllocInstruction(reader)?)
        19_u8 => Instruction::HeapAlloc(read_HeapAllocInstruction(reader)?)
        20_u8 => Instruction::HeapRealloc(read_HeapReallocInstruction(reader)?)
        21_u8 => Instruction::HeapFree(read_HeapFreeInstruction(reader)?)
        22_u8 => Instruction::Put(read_PutInstruction(reader)?)
        23_u8 => Instruction::Binary(read_BinaryInstruction(reader)?)
        24_u8 => Instruction::Phi(read_PhiInstruction(reader)?)
        25_u8 => Instruction::AddEdge(read_EdgeInstruction(reader)?)
        26_u8 => Instruction::RemoveEdge(read_EdgeInstruction(reader)?)
        27_u8 => Instruction::Cfree(read_CfreeInstruction(reader)?)
        28_u8 => Instruction::Drop(read_DropInstruction(reader)?)
        29_u8 => Instruction::Retain(read_RetainInstruction(reader)?)
        _ => {
            ret Result::Err("invalid EHIR variant tag")
        }
    }
    reader.depth -= 1_usize
    ret Result::Ok(value)
}

