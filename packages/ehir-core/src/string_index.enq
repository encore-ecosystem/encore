//! Pass-local string positions, with zero reserved for a missing entry.
import std::vec::Vec

pub struct StringIndex {
    keys: Vec[str]
    positions: Vec[usize]
    count: usize
}

pub fn string_index_with_capacity(expected: usize) -> StringIndex {
    let mut capacity = 16_usize
    while capacity < expected * 2 + 1 {
        capacity *= 2
    }
    let mut keys = Vec[str]::with_capacity(capacity)
    let mut positions = Vec[usize]::with_capacity(capacity)
    for _ in 0..capacity {
        keys.push("") positions.push(0)
    }
    ret StringIndex { keys, positions, 0_usize }
}

fn key_hash(key: str) -> usize {
    let mut hash = 1469598103934665603_u64
    for index in 0..key.byte_len() {
        hash =(hash ^ key.byte_at(index) as u64) * 1099511628211_u64
    }
    ret hash as usize
}

pub fn string_index_get(index: mut StringIndex, key: str) -> usize {
    let mask = index.keys.len() - 1
    let mut slot = key_hash(key) & mask
    loop {
        let value = index.positions.get(slot).unwrap_or(0)
        if value == 0 || index.keys.get(slot).unwrap_or("") == key {
            ret value
        }
        slot =(slot + 1) & mask
    }
}

/// The first declaration owns a spelling, including the empty spelling.
pub fn string_index_insert(index: mut StringIndex, key: str, position: usize) ->() {
    set_position(index, key, position, false)
}

/// Replaces an existing position; useful for lexically shadowed bindings.
pub fn string_index_set(index: mut StringIndex, key: str, position: usize) ->() {
    set_position(index, key, position, true)
}

fn set_position(index: mut StringIndex, key: str, position: usize, replace: bool) ->() {
    if index.count >= index.keys.len() / 2_usize {
        let mut grown = string_index_with_capacity(index.keys.len())
        for slot in 0_usize..index.keys.len() {
            let old = index.positions.get(slot).unwrap_or(0_usize)
            if old != 0_usize {
                set_position(grown, index.keys.get(slot).unwrap_or(""), old - 1_usize, true)
            }
        }
        index.keys = grown.keys
        index.positions = grown.positions
        index.count = grown.count
    }
    let mask = index.keys.len() - 1
    let mut slot = key_hash(key) & mask
    loop {
        let value = index.positions.get(slot).unwrap_or(0)
        if value == 0 {
            index.keys.set(slot, key)
            index.positions.set(slot, position + 1)
            index.count += 1_usize
            ret()
        }
        if index.keys.get(slot).unwrap_or("") == key {
            if replace {
                index.positions.set(slot, position + 1)
            }
            ret()
        }
        slot =(slot + 1) & mask
    }
}
