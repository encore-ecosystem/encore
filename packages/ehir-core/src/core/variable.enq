import core::option::Option

import std::vec::Vec

import refrain::core::types::{RepresentationKind, Type, plain_type}

pub struct Parameter {
    name: str
    typ: Type
}

pub enum ValueKind {
    Ssa
    EnumTag
    Unit
}

/// Every value has a resolved type at construction. Selectors are not values.
pub struct Variable {
    name: str
    typ: Type
    kind: ValueKind
}

pub struct FieldSelector {
    name: str
    annotation: Option[Type]
}

pub fn param(name: str, typ: Type) -> Parameter {
    ret Parameter {
        name, typ
    }
}

pub fn var(name: str, typ: Type) -> Variable {
    let kind = if name == "void" && typ.representation == RepresentationKind::Inline && typ.generics.is_empty() &&(typ.name == "void" || typ.name == "()") {
        ValueKind::Unit
    } else {
        ValueKind::Ssa
    }
    ret Variable {
        name, typ, kind
    }
}

pub fn enum_tag(name: str) -> Variable {
    ret Variable { name, plain_type("u32", Vec[Type]::new()), ValueKind::EnumTag }
}

pub fn field(name: str) -> FieldSelector {
    ret FieldSelector { name, Option[Type]::None }
}

pub fn annotated_field(name: str, typ: Type) -> FieldSelector {
    ret FieldSelector { name, Option[Type]::Some(typ) }
}
