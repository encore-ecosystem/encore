/// Result definition, shared by validation and structured frontends.
pub fn instruction_result(item: Instruction) -> Option[Variable] {
    match item {
        Instruction::Lcpos(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Alias(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Lcsos(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Lceos(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Call(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Await(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Load(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::GetField(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::GetFieldPtr(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::SGetField(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::SGetFieldPtr(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::GetPtr(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Gep(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::PtrCast(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::StackAlloc(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::HeapAlloc(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::HeapRealloc(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Binary(data) => {
            ret Option[Variable]::Some(data.out)
        }
        Instruction::Phi(data) => {
            ret Option[Variable]::Some(data.out)
        }
        _ => {
        }
    }
    ret Option[Variable]::None
}

/// Typed value uses; field selectors and control-flow labels are not SSA uses.
pub fn instruction_inputs(item: Instruction) -> Vec[Variable] {
    let mut values = Vec[Variable]::new()
    match item {
        Instruction::Alias(data) => {
            values.push(data.src)
        }
        Instruction::Lcsos(data) => {
            values.extend(data.args)
        }
        Instruction::Lceos(data) => {
            match data.value.payload {
                Some(value) => values.push(value) None => {
                }
            }
        }
        Instruction::Call(data) => {
            values.extend(data.args)
        }
        Instruction::Await(data) => {
            values.push(data.future)
        }
        Instruction::Store(data) => {
            values.push(data.src) values.push(data.dst)
        }
        Instruction::Load(data) => {
            values.push(data.src)
        }
        Instruction::GetField(data) => {
            values.push(data.src)
        }
        Instruction::SetField(data) => {
            values.push(data.src) values.push(data.value)
        }
        Instruction::GetFieldPtr(data) => {
            values.push(data.src)
        }
        Instruction::SGetField(data) => {
            values.push(data.src)
        }
        Instruction::SGetFieldPtr(data) => {
            values.push(data.src)
        }
        Instruction::GetPtr(data) => {
            values.push(data.src)
        }
        Instruction::Gep(data) => {
            values.push(data.src) values.push(data.offset)
        }
        Instruction::PtrCast(data) => {
            values.push(data.src)
        }
        Instruction::HeapRealloc(data) => {
            values.push(data.src) values.push(data.count)
        }
        Instruction::HeapFree(data) => {
            values.push(data.src)
        }
        Instruction::Put(data) => {
            values.push(data.dst)
        }
        Instruction::Binary(data) => {
            values.push(data.lhs) values.push(data.rhs)
        }
        Instruction::Phi(data) => {
            for pair in data.pairs {
                values.push(pair.value)
            }
        }
        Instruction::AddEdge(data) => {
            values.push(data.owner) values.push(data.value)
        }
        Instruction::RemoveEdge(data) => {
            values.push(data.owner) values.push(data.value)
        }
        Instruction::Cfree(data) => {
            values.push(data.value)
        }
        Instruction::Drop(data) => {
            values.push(data.value)
        }
        Instruction::Retain(data) => {
            values.push(data.value)
        }
        _ => {
        }
    }
    ret values
}
