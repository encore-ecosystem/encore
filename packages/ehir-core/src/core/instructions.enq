    field: FieldSelector
}

pub struct SGetFieldInstruction {
    out: Variable
    src: Variable
    field: FieldSelector
}

pub struct SGetFieldPtrInstruction {
    out: Variable
    src: Variable
    field: FieldSelector
}

pub struct GetPtrInstruction {
    out: Variable
    src: Variable
}

pub struct GepInstruction {
    out: Variable
    src: Variable
    offset: Variable
}

pub struct PtrCastInstruction {
    out: Variable
    src: Variable
    target_type: Type
}

pub struct StackAllocInstruction {
    out: Variable
    typ: Type
}

pub struct HeapAllocInstruction {
    out: Variable
    typ: Type
}

pub struct HeapReallocInstruction {
    out: Variable
