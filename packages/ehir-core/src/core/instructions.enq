    dst: Variable
}

pub enum BinaryOpKind {
    ADD
    SUB
    MUL
    DIV
    MOD
    SHL
    SHR
    LES
    LEQ
    GRT
    GEQ
    IEQ
    NEQ
    AND
    OR
    XOR
}

pub struct BinaryInstruction {
    out: Variable
    lhs: Variable
    rhs: Variable
    op: BinaryOpKind
}

pub struct PhiPair {
    value: Variable
    label: str
}

pub struct PhiInstruction {
    out: Variable
    pairs: Vec[PhiPair]
}

pub struct CfreeInstruction {
    value: Variable
}

/// Updates the graph topology owned by `owner` for every node handle nested
/// in `value`. The backend expands this structurally for aggregates.
pub struct EdgeInstruction {
    owner: Variable
    value: Variable
}

pub struct DropInstruction {
    value: Variable
}

pub struct RetainInstruction {
    value: Variable
}

pub struct ReturnInstruction {
    value: Variable
}

pub struct BranchInstruction {
    label: str
}

pub struct ConditionalBranchInstruction {
    cond: Variable
    true_label: str
    false_label: str
}

pub struct MatchArm {
    variant: str
    payload_var: Option[Variable]
    label: str
}

pub struct MatchInstruction {
    scrutinee: Variable
    default_label: str
    arms: Vec[MatchArm]
}

pub struct SwitchCase {
    value: str
    label: str
}

pub struct SwitchInstruction {
    scrutinee: Variable
    default_label: str
    cases: Vec[SwitchCase]
}

pub enum Instruction {
    Comment(CommentInstruction)
    Lcpos(LcposInstruction)
    Alias(AliasInstruction)
    Lcsos(LcsosInstruction)
    Lceos(LceosInstruction)
    Call(CallInstruction)
    Await(AwaitInstruction)
    Store(StoreInstruction)
    Load(LoadInstruction)
    GetField(GetFieldInstruction)
    SetField(SetFieldInstruction)
    GetFieldPtr(GetFieldPtrInstruction)
    SGetField(SGetFieldInstruction)
    SGetFieldPtr(SGetFieldPtrInstruction)
    GetPtr(GetPtrInstruction)
    Gep(GepInstruction)
    PtrCast(PtrCastInstruction)
    StackAlloc(StackAllocInstruction)
    HeapAlloc(HeapAllocInstruction)
    HeapRealloc(HeapReallocInstruction)
    HeapFree(HeapFreeInstruction)
    Put(PutInstruction)
    Binary(BinaryInstruction)
    Phi(PhiInstruction)
    AddEdge(EdgeInstruction)
    RemoveEdge(EdgeInstruction)
    Cfree(CfreeInstruction)
    Drop(DropInstruction)
    Retain(RetainInstruction)
}

pub enum Terminator {
    Unreachable
    Ret(ReturnInstruction)
    Br(BranchInstruction)
    Cbr(ConditionalBranchInstruction)
    Match(MatchInstruction)
    Switch(SwitchInstruction)
}

pub fn unreachable_term() -> Terminator {
    ret Terminator::Unreachable
}

pub fn comment(text: str) -> Instruction {
    ret Instruction::Comment(CommentInstruction {
            text
        }
    )
}

/// A typed indirect call. Keeping the callee as operand zero makes every SSA,
/// substitution and liveness pass treat it like any other used value.
pub fn indirect_call(out: Variable, callee: Variable, arguments: Vec[Variable]) -> Instruction {
    let mut operands = vec![callee]
    operands.extend(arguments)
    ret call(out, "__ehir_call_indirect", Vec[Type]::new(), operands, true)
}

