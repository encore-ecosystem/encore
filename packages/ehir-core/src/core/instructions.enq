import core::option::Option

import std::vec::Vec

import refrain::core::enum_value::EnumValue
import refrain::core::types::Type
import refrain::core::variable::{FieldSelector, Variable}

pub struct CommentInstruction {
    text: str
}

pub struct LcposInstruction {
