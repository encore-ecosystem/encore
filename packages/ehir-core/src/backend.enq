//! Backend-independent compiler inputs, outputs and extension contract.
import core::result::Result
import std::vec::Vec

import mod::typed::TypedProgram

pub struct CompilerDiagnostic {
    stage: str
    message: str
}

pub enum EmitKind {
    BackendIr
    Object
}

pub struct CompileOptions {
    target: str
    pointer_width: usize
    profile: str
    jobs: usize
}

/// Produced by the common preparation pipeline. Ordinary backends consume
/// normalized, verified IR and never invoke the Encore frontend.
pub struct PreparedProgram {
    program: TypedProgram
}

pub struct GeneratedModule {
    module_id: str
    text: str
}

pub struct BackendOutput {
    backend: str
    format: str
    modules: Vec[GeneratedModule]
}

pub trait Backend {
    fn name(self: Self) -> str
    fn version(self: Self) -> str
    fn supports(self: Self, options: CompileOptions) -> bool
    fn generate(self: Self, program: PreparedProgram, options: CompileOptions) -> Result[BackendOutput, CompilerDiagnostic]
}
