fn freeze_MatchArm(context: mut TypedContext, item: MatchArm) -> Result[TypedMatchArm, str] {
    ret Result::Ok(TypedMatchArm {
            intern_symbol(context, item.variant),
            match item.payload_var {
                Some(value) => Option[ValueId]::Some(value_reference(context, value)?) None => Option[ValueId]::None
            }
            ,
            intern_symbol(context, item.label)
        }
    )
}

fn thaw_MatchArm(function: TypedFunction, item: TypedMatchArm) -> Result[MatchArm, str] {
