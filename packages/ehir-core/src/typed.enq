        TypedInstruction::SGetField(item) => {
            ret Result::Ok(Instruction::SGetField(thaw_SGetFieldInstruction(function, item)?))
        }
        TypedInstruction::SGetFieldPtr(item) => {
            ret Result::Ok(Instruction::SGetFieldPtr(thaw_SGetFieldPtrInstruction(function, item)?))
        }
        TypedInstruction::GetPtr(item) => {
            ret Result::Ok(Instruction::GetPtr(thaw_GetPtrInstruction(function, item)?))
        }
        TypedInstruction::Gep(item) => {
            ret Result::Ok(Instruction::Gep(thaw_GepInstruction(function, item)?))
        }
        TypedInstruction::PtrCast(item) => {
            ret Result::Ok(Instruction::PtrCast(thaw_PtrCastInstruction(function, item)?))
        }
        TypedInstruction::StackAlloc(item) => {
            ret Result::Ok(Instruction::StackAlloc(thaw_StackAllocInstruction(function, item)?))
        }
        TypedInstruction::HeapAlloc(item) => {
            ret Result::Ok(Instruction::HeapAlloc(thaw_HeapAllocInstruction(function, item)?))
        }
        TypedInstruction::HeapRealloc(item) => {
            ret Result::Ok(Instruction::HeapRealloc(thaw_HeapReallocInstruction(function, item)?))
        }
        TypedInstruction::HeapFree(item) => {
            ret Result::Ok(Instruction::HeapFree(thaw_HeapFreeInstruction(function, item)?))
        }
        TypedInstruction::Put(item) => {
            ret Result::Ok(Instruction::Put(thaw_PutInstruction(function, item)?))
        }
        TypedInstruction::Binary(item) => {
            ret Result::Ok(Instruction::Binary(thaw_BinaryInstruction(function, item)?))
        }
        TypedInstruction::Phi(item) => {
            ret Result::Ok(Instruction::Phi(thaw_PhiInstruction(function, item)?))
        }
        TypedInstruction::AddEdge(item) => {
            ret Result::Ok(Instruction::AddEdge(thaw_EdgeInstruction(function, item)?))
        }
        TypedInstruction::RemoveEdge(item) => {
            ret Result::Ok(Instruction::RemoveEdge(thaw_EdgeInstruction(function, item)?))
        }
        TypedInstruction::Cfree(item) => {
            ret Result::Ok(Instruction::Cfree(thaw_CfreeInstruction(function, item)?))
        }
        TypedInstruction::Drop(item) => {
            ret Result::Ok(Instruction::Drop(thaw_DropInstruction(function, item)?))
        }
        TypedInstruction::Retain(item) => {
            ret Result::Ok(Instruction::Retain(thaw_RetainInstruction(function, item)?))
        }
    }
    ret Result::Err("invalid Instruction")
}

fn freeze_Terminator(context: mut TypedContext, item: Terminator) -> Result[TypedTerminator, str] {
    match item {
        Terminator::Unreachable => {
            ret Result::Ok(TypedTerminator::Unreachable)
        }
        Terminator::Ret(item) => {
            ret Result::Ok(TypedTerminator::Ret(freeze_ReturnInstruction(context, item)?))
        }
        Terminator::Br(item) => {
            ret Result::Ok(TypedTerminator::Br(freeze_BranchInstruction(context, item)?))
        }
        Terminator::Cbr(item) => {
            ret Result::Ok(TypedTerminator::Cbr(freeze_ConditionalBranchInstruction(context, item)?))
        }
        Terminator::Match(item) => {
            ret Result::Ok(TypedTerminator::Match(freeze_MatchInstruction(context, item)?))
        }
        Terminator::Switch(item) => {
            ret Result::Ok(TypedTerminator::Switch(freeze_SwitchInstruction(context, item)?))
        }
    }
    ret Result::Err("invalid Terminator")
}

fn thaw_Terminator(function: TypedFunction, item: TypedTerminator) -> Result[Terminator, str] {
    match item {
        TypedTerminator::Unreachable => {
            ret Result::Ok(Terminator::Unreachable)
        }
        TypedTerminator::Ret(item) => {
            ret Result::Ok(Terminator::Ret(thaw_ReturnInstruction(function, item)?))
        }
        TypedTerminator::Br(item) => {
            ret Result::Ok(Terminator::Br(thaw_BranchInstruction(function, item)?))
        }
        TypedTerminator::Cbr(item) => {
            ret Result::Ok(Terminator::Cbr(thaw_ConditionalBranchInstruction(function, item)?))
        }
        TypedTerminator::Match(item) => {
            ret Result::Ok(Terminator::Match(thaw_MatchInstruction(function, item)?))
        }
        TypedTerminator::Switch(item) => {
            ret Result::Ok(Terminator::Switch(thaw_SwitchInstruction(function, item)?))
        }
    }
    ret Result::Err("invalid Terminator")
}

fn instruction_definition(item: Instruction) -> Option[Variable] {
    match item {

        Instruction::Lcpos(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Alias(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Lcsos(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Lceos(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Call(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Await(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Load(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::GetField(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::GetFieldPtr(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::SGetField(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::SGetFieldPtr(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::GetPtr(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Gep(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::PtrCast(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::StackAlloc(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::HeapAlloc(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::HeapRealloc(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Binary(value) => {
            ret Option[Variable]::Some(value.out)
        }

        Instruction::Phi(value) => {
            ret Option[Variable]::Some(value.out)
        }

        _ => {
            ret Option[Variable]::None
        }
    }
    ret Option[Variable]::None
}

pub fn freeze_function(function: FnDirective) -> Result[TypedFunction, str] {
    let mut count = function.params.len() + 1_usize
    for block in function.blocks {
        count += block.instructions.len() + 1_usize
        match block.terminator {
            Terminator::Match(item) => {
                count += item.arms.len()
            }
            _ => {
            }
        }
    }
    let mut context = TypedContext {
        Vec[str]::new(), Vec[Type]::new(), Vec[TypedValue]::new(),
        string_index_with_capacity(count * 8_usize), string_index_with_capacity(count * 4_usize), string_index_with_capacity(count)
    }
    for parameter in function.params {
        let _value = define_value(context, var(parameter.name, parameter.typ))?
    }
    for block in function.blocks {
        for instruction in block.instructions {
            match instruction_definition(instruction) {
                Some(value) => {
                    let _value = define_value(context, value)?
                }
                None => {
                }
            }
        }
        match block.terminator {
            Terminator::Match(item) => {
                for arm in item.arms {
                    match arm.payload_var {
                        Some(value) => {
                            let _value = define_value(context, value)?
                        }
                        None => {
                        }
                    }
                }
            }
            _ => {
            }
        }
    }
    let mut blocks = Vec[TypedBlock]::new()
    for block in function.blocks {
        let mut instructions = Vec[TypedInstruction]::new()
        for instruction in block.instructions {
            instructions.push(freeze_Instruction(context, instruction)?)
        }
        blocks.push(TypedBlock {
                intern_symbol(context, block.name), instructions, freeze_Terminator(context, block.terminator)?
            }
        )
    }
    let signature = FnDirective {
        function.name, function.generics, function.params, function.ret_type,
        Vec[Block]::new(), function.is_extern, function.is_async
    }
    ret Result::Ok(TypedFunction {
            signature, context.symbols, context.types, context.values, blocks
        }
    )
}

pub fn thaw_function(function: TypedFunction) -> Result[FnDirective, str] {
    if !function.signature.blocks.is_empty() {
        ret Result::Err("typed signature contains an ordinary body")
    }
    for value in function.values {
        let _name = thaw_symbol(function, value.name)?
        let _type = thaw_type(function, value.typ)?
    }
    let mut blocks = Vec[Block]::new()
    for block in function.blocks {
        let mut instructions = Vec[Instruction]::new()
        for instruction in block.instructions {
            instructions.push(thaw_Instruction(function, instruction)?)
        }
        blocks.push(Block {
                thaw_symbol(function, block.name)?, instructions, thaw_Terminator(function, block.terminator)?
            }
        )
    }
    let item = function.signature
    ret Result::Ok(FnDirective {
            item.name, item.generics, item.params, item.ret_type, blocks, item.is_extern, item.is_async
        }
    )
}

pub fn freeze_program(bundle: ModuleBundle) -> Result[TypedProgram, str] {
    let mut modules = Vec[TypedModule]::new()
    for module in bundle.modules {
        let mut directives = Vec[TypedDirective]::new()
        for directive in module.directives {
            match directive {
                Directive::Struct(item) => directives.push(TypedDirective::Struct(item))
                Directive::Enum(item) => directives.push(TypedDirective::Enum(item))
                Directive::Trait(item) => directives.push(TypedDirective::Trait(item))
                Directive::Function(item) => directives.push(TypedDirective::Function(freeze_function(item)?))
                Directive::Impl(item) => {
                    let mut methods = Vec[TypedFunction]::new()
                    for method in item.methods {
                        methods.push(freeze_function(method)?)
                    }
                    let declaration = ImplDirective {
                        item.trait_name, item.trait_args, item.for_type, item.generics, Vec[FnDirective]::new()
                    }
                    directives.push(TypedDirective::Impl(TypedImpl { declaration, methods }))
                }
            }
        }
        let header = Module {
            module.name, module.imports, module.documentation, module.symbol_documentation, Vec[Directive]::new()
        }
        modules.push(TypedModule { header, directives })
    }
    ret Result::Ok(TypedProgram { bundle.entry_module, modules })
}

pub fn thaw_program(program: TypedProgram) -> Result[ModuleBundle, str] {
    let mut modules = Vec[Module]::new()
    for module in program.modules {
        let mut directives = Vec[Directive]::new()
        for directive in module.directives {
            match directive {
                TypedDirective::Struct(item) => directives.push(Directive::Struct(item))
                TypedDirective::Enum(item) => directives.push(Directive::Enum(item))
                TypedDirective::Trait(item) => directives.push(Directive::Trait(item))
                TypedDirective::Function(item) => directives.push(Directive::Function(thaw_function(item)?))
                TypedDirective::Impl(item) => {
                    let mut methods = Vec[FnDirective]::new()
                    for method in item.methods {
                        methods.push(thaw_function(method)?)
                    }
                    let value = item.declaration
                    directives.push(Directive::Impl(ImplDirective {
                                value.trait_name, value.trait_args, value.for_type, value.generics, methods
                            }
                        ))
                }
            }
        }
        let header = module.header
        modules.push(Module {
                header.name, header.imports, header.documentation, header.symbol_documentation, directives
            }
        )
    }
    ret Result::Ok(make_module_bundle(program.entry_module, modules))
}
