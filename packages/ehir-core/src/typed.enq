    ret Result::Ok(TypedLceosInstruction {
            value_reference(context, item.out)?,
            freeze_EnumValue(context, item.value)?
        }
    )
}

fn thaw_LceosInstruction(function: TypedFunction, item: TypedLceosInstruction) -> Result[LceosInstruction, str] {
    ret Result::Ok(LceosInstruction {
            thaw_value(function, item.out)?,
            thaw_EnumValue(function, item.value)?
        }
    )
}

fn freeze_LcposInstruction(context: mut TypedContext, item: LcposInstruction) -> Result[TypedLcposInstruction, str] {
    ret Result::Ok(TypedLcposInstruction {
            value_reference(context, item.out)?,
            item.value
        }
    )
}

fn thaw_LcposInstruction(function: TypedFunction, item: TypedLcposInstruction) -> Result[LcposInstruction, str] {
    ret Result::Ok(LcposInstruction {
            thaw_value(function, item.out)?,
            item.value
        }
    )
}

