//! Canonical backend input: SSA values always have a TypeId. Field and enum
//! selectors have distinct representations and cannot masquerade as values.
import core::option::Option
import core::fmt::Debug
import core::result::Result

import std::vec::Vec

import mod::core::*
import mod::string_index::{StringIndex, string_index_get, string_index_set, string_index_with_capacity}

pub struct TypeId {
    index: usize
}
pub struct ValueId {
    index: usize
}
pub struct SymbolId {
    index: usize
}
pub struct TypedValue {
    name: SymbolId,
    typ: TypeId
}
pub struct TypedField {
    name: SymbolId,
    annotation: Option[TypeId]
}
pub enum TypedOperand {
    Value(ValueId)
    Variant(SymbolId)
    Unit(TypeId)
}

pub struct TypedAliasInstruction {
    out: ValueId
    src: TypedOperand
}

pub struct TypedAwaitInstruction {
    out: ValueId
    future: TypedOperand
}

pub struct TypedBinaryInstruction {
    out: ValueId
    lhs: TypedOperand
    rhs: TypedOperand
    op: BinaryOpKind
}

pub struct TypedBranchInstruction {
    label: SymbolId
}

pub struct TypedCallInstruction {
    out: ValueId
    name: SymbolId
    generics: Vec[TypeId]
    args: Vec[TypedOperand]
    is_unsafe: bool
}

pub struct TypedCfreeInstruction {
    value: TypedOperand
}

pub struct TypedCommentInstruction {
