pub enum TypedInstruction {
    Comment(TypedCommentInstruction)
    Lcpos(TypedLcposInstruction)
    Alias(TypedAliasInstruction)
    Lcsos(TypedLcsosInstruction)
    Lceos(TypedLceosInstruction)
    Call(TypedCallInstruction)
    Await(TypedAwaitInstruction)
    Store(TypedStoreInstruction)
    Load(TypedLoadInstruction)
    GetField(TypedGetFieldInstruction)
    SetField(TypedSetFieldInstruction)
    GetFieldPtr(TypedGetFieldPtrInstruction)
    SGetField(TypedSGetFieldInstruction)
    SGetFieldPtr(TypedSGetFieldPtrInstruction)
    GetPtr(TypedGetPtrInstruction)
    Gep(TypedGepInstruction)
    PtrCast(TypedPtrCastInstruction)
    StackAlloc(TypedStackAllocInstruction)
    HeapAlloc(TypedHeapAllocInstruction)
    HeapRealloc(TypedHeapReallocInstruction)
    HeapFree(TypedHeapFreeInstruction)
    Put(TypedPutInstruction)
    Binary(TypedBinaryInstruction)
    Phi(TypedPhiInstruction)
    AddEdge(TypedEdgeInstruction)
    RemoveEdge(TypedEdgeInstruction)
    Cfree(TypedCfreeInstruction)
    Drop(TypedDropInstruction)
    Retain(TypedRetainInstruction)
}

pub enum TypedTerminator {
    Unreachable
    Ret(TypedReturnInstruction)
    Br(TypedBranchInstruction)
    Cbr(TypedConditionalBranchInstruction)
    Match(TypedMatchInstruction)
    Switch(TypedSwitchInstruction)
}

pub struct TypedBlock {
    name: SymbolId
    instructions: Vec[TypedInstruction]
    terminator: TypedTerminator
}
pub struct TypedFunction {
    signature: FnDirective
    symbols: Vec[str]
    types: Vec[Type]
    values: Vec[TypedValue]
    blocks: Vec[TypedBlock]
}
pub struct TypedImpl {
    declaration: ImplDirective
    methods: Vec[TypedFunction]
}
pub enum TypedDirective {
    Struct(StructDirective)
    Enum(EnumDirective)
    Function(TypedFunction)
    Trait(TraitDirective)
    Impl(TypedImpl)
}
pub struct TypedModule {
    header: Module
    directives: Vec[TypedDirective]
}
pub struct TypedProgram {
    entry_module: str
    modules: Vec[TypedModule]
}
struct TypedContext {
    symbols: Vec[str]
    types: Vec[Type]
    values: Vec[TypedValue]
    names: StringIndex
    type_names: StringIndex
    value_names: StringIndex
}
fn intern_symbol(context: mut TypedContext, name: str) -> SymbolId {
    let existing = string_index_get(context.names, name)
    if existing != 0_usize {
        ret SymbolId { existing - 1_usize }
    }
    let index = context.symbols.len()
    context.symbols.push(name)
    string_index_set(context.names, name, index)
    ret SymbolId { index }
}
fn type_identity(typ: Type) -> str {
    let representation = match typ.representation {
        RepresentationKind::Inline => "inline"
        RepresentationKind::Raw => "raw"
        RepresentationKind::NodeHeap => "heap"
        RepresentationKind::NodeStack => "stack"
        RepresentationKind::NodeAny => "any"
        RepresentationKind::LocalPlace => "place"
    }
    let mut key = representation + ":" + Debug::fmt(typ.name.byte_len()) + ":" + typ.name
    for argument in typ.generics {
        let nested = type_identity(argument)
        key += ":" + Debug::fmt(nested.byte_len()) + ":" + nested
    }
    ret key
}

fn intern_type(context: mut TypedContext, typ: Type) -> TypeId {
    let key = type_identity(typ)
    let existing = string_index_get(context.type_names, key)
    if existing != 0_usize {
        ret TypeId { existing - 1_usize }
    }
    let index = context.types.len()
    context.types.push(typ)
    string_index_set(context.type_names, key, index)
    ret TypeId { index }
}
fn intern_types(context: mut TypedContext, types: Vec[Type]) -> Vec[TypeId] {
    let mut out = Vec[TypeId]::new()
    for typ in types {
        out.push(intern_type(context, typ))
    }
    ret out
}
fn define_value(context: mut TypedContext, value: Variable) -> Result[ValueId, str] {
    if string_index_get(context.value_names, value.name) != 0_usize {
        ret Result::Err("duplicate SSA value: " + value.name)
    }
    let index = context.values.len()
    context.values.push(TypedValue {
            intern_symbol(context, value.name), intern_type(context, value.typ)
        }
    )
    string_index_set(context.value_names, value.name, index)
    ret Result::Ok(ValueId { index })
}
fn value_reference(context: mut TypedContext, value: Variable) -> Result[ValueId, str] {
    let index = string_index_get(context.value_names, value.name)
    if index == 0_usize {
        ret Result::Err("undefined SSA value: " + value.name)
    }
    let definition = context.values.get_unchecked_borrowed(index - 1_usize)
    if type_identity(value.typ) != type_identity(context.types.get_unchecked_borrowed(definition.typ.index)) {
        ret Result::Err("inconsistent type for SSA value: " + value.name)
    }
    ret Result::Ok(ValueId { index - 1_usize })
}
fn freeze_operand(context: mut TypedContext, value: Variable) -> Result[TypedOperand, str] {
    match value.kind {
        ValueKind::EnumTag => {
            ret Result::Ok(TypedOperand::Variant(intern_symbol(context, value.name)))
        }
        ValueKind::Unit => {
            ret Result::Ok(TypedOperand::Unit(intern_type(context, value.typ)))
        }
        ValueKind::Ssa => {
            ret Result::Ok(TypedOperand::Value(value_reference(context, value)?))
        }
    }
}
fn freeze_operands(context: mut TypedContext, values: Vec[Variable]) -> Result[Vec[TypedOperand], str] {
    let mut out = Vec[TypedOperand]::new()
    for value in values {
        out.push(freeze_operand(context, value)?)
    }
    ret Result::Ok(out)
}
fn freeze_field(context: mut TypedContext, value: FieldSelector) -> TypedField {
    let annotation = match value.annotation {
        Some(typ) => Option[TypeId]::Some(intern_type(context, typ))
        None => Option[TypeId]::None
    }
    ret TypedField { intern_symbol(context, value.name), annotation }
}
fn thaw_symbol(function: TypedFunction, symbol: SymbolId) -> Result[str, str] {
    match function.symbols.get(symbol.index) {
        Some(value) => {
            ret Result::Ok(value)
        }
        None => {
            ret Result::Err("invalid EHIR SymbolId")
        }
    }
}
fn thaw_type(function: TypedFunction, typ: TypeId) -> Result[Type, str] {
    match function.types.get(typ.index) {
        Some(value) => {
            ret Result::Ok(value)
        }
        None => {
            ret Result::Err("invalid EHIR TypeId")
        }
    }
}
fn thaw_types(function: TypedFunction, types: Vec[TypeId]) -> Result[Vec[Type], str] {
    let mut out = Vec[Type]::new()
    for typ in types {
        out.push(thaw_type(function, typ)?)
    }
    ret Result::Ok(out)
}
fn thaw_value(function: TypedFunction, reference: ValueId) -> Result[Variable, str] {
    let value = match function.values.get(reference.index) {
        Some(value) => value
        None => {
            ret Result::Err("invalid EHIR ValueId")
        }
    }
    ret Result::Ok(var(thaw_symbol(function, value.name)?, thaw_type(function, value.typ)?))
}
fn thaw_operand(function: TypedFunction, operand: TypedOperand) -> Result[Variable, str] {
    match operand {
        TypedOperand::Value(id) => {
            ret thaw_value(function, id)
        }
        TypedOperand::Variant(id) => {
            ret Result::Ok(enum_tag(thaw_symbol(function, id)?))
        }
        TypedOperand::Unit(id) => {
            ret Result::Ok(var("void", thaw_type(function, id)?))
        }
    }
    ret Result::Err("invalid typed operand")
}
fn thaw_operands(function: TypedFunction, operands: Vec[TypedOperand]) -> Result[Vec[Variable], str] {
    let mut out = Vec[Variable]::new()
    for operand in operands {
        out.push(thaw_operand(function, operand)?)
    }
    ret Result::Ok(out)
}
fn thaw_field(function: TypedFunction, field: TypedField) -> Result[FieldSelector, str] {
    let typ = match field.annotation {
        Some(id) => Option[Type]::Some(thaw_type(function, id)?)
        None => Option[Type]::None
    }
    ret Result::Ok(FieldSelector { thaw_symbol(function, field.name)?, typ })
}

fn freeze_AliasInstruction(context: mut TypedContext, item: AliasInstruction) -> Result[TypedAliasInstruction, str] {
    ret Result::Ok(TypedAliasInstruction {
            value_reference(context, item.out)?,
            freeze_operand(context, item.src)?
        }
    )
}

fn thaw_AliasInstruction(function: TypedFunction, item: TypedAliasInstruction) -> Result[AliasInstruction, str] {
    ret Result::Ok(AliasInstruction {
            thaw_value(function, item.out)?,
            thaw_operand(function, item.src)?
        }
    )
}

fn freeze_AwaitInstruction(context: mut TypedContext, item: AwaitInstruction) -> Result[TypedAwaitInstruction, str] {
    ret Result::Ok(TypedAwaitInstruction {
            value_reference(context, item.out)?,
            freeze_operand(context, item.future)?
        }
    )
}

fn thaw_AwaitInstruction(function: TypedFunction, item: TypedAwaitInstruction) -> Result[AwaitInstruction, str] {
    ret Result::Ok(AwaitInstruction {
            thaw_value(function, item.out)?,
            thaw_operand(function, item.future)?
        }
    )
}

fn freeze_BinaryInstruction(context: mut TypedContext, item: BinaryInstruction) -> Result[TypedBinaryInstruction, str] {
    ret Result::Ok(TypedBinaryInstruction {
            value_reference(context, item.out)?,
            freeze_operand(context, item.lhs)?,
            freeze_operand(context, item.rhs)?,
            item.op
        }
    )
}

fn thaw_BinaryInstruction(function: TypedFunction, item: TypedBinaryInstruction) -> Result[BinaryInstruction, str] {
    ret Result::Ok(BinaryInstruction {
            thaw_value(function, item.out)?,
            thaw_operand(function, item.lhs)?,
            thaw_operand(function, item.rhs)?,
            item.op
        }
    )
}

fn freeze_BranchInstruction(context: mut TypedContext, item: BranchInstruction) -> Result[TypedBranchInstruction, str] {
    ret Result::Ok(TypedBranchInstruction {
            intern_symbol(context, item.label)
        }
    )
}

fn thaw_BranchInstruction(function: TypedFunction, item: TypedBranchInstruction) -> Result[BranchInstruction, str] {
    ret Result::Ok(BranchInstruction {
            thaw_symbol(function, item.label)?
        }
    )
}

fn freeze_CallInstruction(context: mut TypedContext, item: CallInstruction) -> Result[TypedCallInstruction, str] {
    ret Result::Ok(TypedCallInstruction {
            value_reference(context, item.out)?,
            intern_symbol(context, item.name),
            intern_types(context, item.generics),
            freeze_operands(context, item.args)?,
            item.is_unsafe
        }
    )
}

fn thaw_CallInstruction(function: TypedFunction, item: TypedCallInstruction) -> Result[CallInstruction, str] {
    ret Result::Ok(CallInstruction {
            thaw_value(function, item.out)?,
            thaw_symbol(function, item.name)?,
            thaw_types(function, item.generics)?,
            thaw_operands(function, item.args)?,
            item.is_unsafe
        }
    )
}

fn freeze_CfreeInstruction(context: mut TypedContext, item: CfreeInstruction) -> Result[TypedCfreeInstruction, str] {
    ret Result::Ok(TypedCfreeInstruction {
            freeze_operand(context, item.value)?
        }
    )
}

fn thaw_CfreeInstruction(function: TypedFunction, item: TypedCfreeInstruction) -> Result[CfreeInstruction, str] {
    ret Result::Ok(CfreeInstruction {
            thaw_operand(function, item.value)?
        }
    )
}

fn freeze_CommentInstruction(context: mut TypedContext, item: CommentInstruction) -> Result[TypedCommentInstruction, str] {
    ret Result::Ok(TypedCommentInstruction {
            item.text
        }
    )
}

fn thaw_CommentInstruction(function: TypedFunction, item: TypedCommentInstruction) -> Result[CommentInstruction, str] {
    ret Result::Ok(CommentInstruction {
            item.text
        }
    )
}

fn freeze_ConditionalBranchInstruction(context: mut TypedContext, item: ConditionalBranchInstruction) -> Result[TypedConditionalBranchInstruction, str] {
    ret Result::Ok(TypedConditionalBranchInstruction {
            freeze_operand(context, item.cond)?,
            intern_symbol(context, item.true_label),
            intern_symbol(context, item.false_label)
        }
    )
}

fn thaw_ConditionalBranchInstruction(function: TypedFunction, item: TypedConditionalBranchInstruction) -> Result[ConditionalBranchInstruction, str] {
    ret Result::Ok(ConditionalBranchInstruction {
            thaw_operand(function, item.cond)?,
            thaw_symbol(function, item.true_label)?,
            thaw_symbol(function, item.false_label)?
        }
    )
}

fn freeze_DropInstruction(context: mut TypedContext, item: DropInstruction) -> Result[TypedDropInstruction, str] {
    ret Result::Ok(TypedDropInstruction {
            freeze_operand(context, item.value)?
        }
    )
}

fn thaw_DropInstruction(function: TypedFunction, item: TypedDropInstruction) -> Result[DropInstruction, str] {
    ret Result::Ok(DropInstruction {
            thaw_operand(function, item.value)?
        }
    )
}

fn freeze_EdgeInstruction(context: mut TypedContext, item: EdgeInstruction) -> Result[TypedEdgeInstruction, str] {
    ret Result::Ok(TypedEdgeInstruction {
            freeze_operand(context, item.owner)?,
            freeze_operand(context, item.value)?
        }
    )
}

fn thaw_EdgeInstruction(function: TypedFunction, item: TypedEdgeInstruction) -> Result[EdgeInstruction, str] {
    ret Result::Ok(EdgeInstruction {
            thaw_operand(function, item.owner)?,
            thaw_operand(function, item.value)?
        }
    )
}

fn freeze_EnumValue(context: mut TypedContext, item: EnumValue) -> Result[TypedEnumValue, str] {
    ret Result::Ok(TypedEnumValue {
            intern_symbol(context, item.name),
            intern_types(context, item.generics),
            intern_symbol(context, item.variant),
            match item.payload {
                Some(value) => Option[TypedOperand]::Some(freeze_operand(context, value)?) None => Option[TypedOperand]::None
            }
        }
    )
}

fn thaw_EnumValue(function: TypedFunction, item: TypedEnumValue) -> Result[EnumValue, str] {
    ret Result::Ok(EnumValue {
            thaw_symbol(function, item.name)?,
            thaw_types(function, item.generics)?,
            thaw_symbol(function, item.variant)?,
            match item.payload {
                Some(value) => Option[Variable]::Some(thaw_operand(function, value)?) None => Option[Variable]::None
            }
        }
    )
}

fn freeze_GepInstruction(context: mut TypedContext, item: GepInstruction) -> Result[TypedGepInstruction, str] {
    ret Result::Ok(TypedGepInstruction {
            value_reference(context, item.out)?,
            freeze_operand(context, item.src)?,
            freeze_operand(context, item.offset)?
        }
    )
}

fn thaw_GepInstruction(function: TypedFunction, item: TypedGepInstruction) -> Result[GepInstruction, str] {
    ret Result::Ok(GepInstruction {
            thaw_value(function, item.out)?,
            thaw_operand(function, item.src)?,
            thaw_operand(function, item.offset)?
        }
    )
}

fn freeze_GetFieldInstruction(context: mut TypedContext, item: GetFieldInstruction) -> Result[TypedGetFieldInstruction, str] {
    ret Result::Ok(TypedGetFieldInstruction {
            value_reference(context, item.out)?,
            freeze_operand(context, item.src)?,
            freeze_field(context, item.field)
        }
    )
}

fn thaw_GetFieldInstruction(function: TypedFunction, item: TypedGetFieldInstruction) -> Result[GetFieldInstruction, str] {
