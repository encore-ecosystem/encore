fn freeze_Instruction(context: mut TypedContext, item: Instruction) -> Result[TypedInstruction, str] {
    match item {
        Instruction::Comment(item) => {
            ret Result::Ok(TypedInstruction::Comment(freeze_CommentInstruction(context, item)?))
        }
        Instruction::Lcpos(item) => {
            ret Result::Ok(TypedInstruction::Lcpos(freeze_LcposInstruction(context, item)?))
        }
        Instruction::Alias(item) => {
            ret Result::Ok(TypedInstruction::Alias(freeze_AliasInstruction(context, item)?))
        }
        Instruction::Lcsos(item) => {
            ret Result::Ok(TypedInstruction::Lcsos(freeze_LcsosInstruction(context, item)?))
        }
        Instruction::Lceos(item) => {
            ret Result::Ok(TypedInstruction::Lceos(freeze_LceosInstruction(context, item)?))
        }
        Instruction::Call(item) => {
            ret Result::Ok(TypedInstruction::Call(freeze_CallInstruction(context, item)?))
        }
        Instruction::Await(item) => {
            ret Result::Ok(TypedInstruction::Await(freeze_AwaitInstruction(context, item)?))
        }
        Instruction::Store(item) => {
            ret Result::Ok(TypedInstruction::Store(freeze_StoreInstruction(context, item)?))
        }
        Instruction::Load(item) => {
            ret Result::Ok(TypedInstruction::Load(freeze_LoadInstruction(context, item)?))
        }
        Instruction::GetField(item) => {
            ret Result::Ok(TypedInstruction::GetField(freeze_GetFieldInstruction(context, item)?))
        }
        Instruction::SetField(item) => {
            ret Result::Ok(TypedInstruction::SetField(freeze_SetFieldInstruction(context, item)?))
        }
        Instruction::GetFieldPtr(item) => {
            ret Result::Ok(TypedInstruction::GetFieldPtr(freeze_GetFieldPtrInstruction(context, item)?))
        }
        Instruction::SGetField(item) => {
            ret Result::Ok(TypedInstruction::SGetField(freeze_SGetFieldInstruction(context, item)?))
        }
        Instruction::SGetFieldPtr(item) => {
            ret Result::Ok(TypedInstruction::SGetFieldPtr(freeze_SGetFieldPtrInstruction(context, item)?))
        }
        Instruction::GetPtr(item) => {
            ret Result::Ok(TypedInstruction::GetPtr(freeze_GetPtrInstruction(context, item)?))
        }
        Instruction::Gep(item) => {
            ret Result::Ok(TypedInstruction::Gep(freeze_GepInstruction(context, item)?))
        }
        Instruction::PtrCast(item) => {
            ret Result::Ok(TypedInstruction::PtrCast(freeze_PtrCastInstruction(context, item)?))
        }
        Instruction::StackAlloc(item) => {
            ret Result::Ok(TypedInstruction::StackAlloc(freeze_StackAllocInstruction(context, item)?))
        }
        Instruction::HeapAlloc(item) => {
            ret Result::Ok(TypedInstruction::HeapAlloc(freeze_HeapAllocInstruction(context, item)?))
        }
        Instruction::HeapRealloc(item) => {
            ret Result::Ok(TypedInstruction::HeapRealloc(freeze_HeapReallocInstruction(context, item)?))
        }
        Instruction::HeapFree(item) => {
            ret Result::Ok(TypedInstruction::HeapFree(freeze_HeapFreeInstruction(context, item)?))
        }
        Instruction::Put(item) => {
            ret Result::Ok(TypedInstruction::Put(freeze_PutInstruction(context, item)?))
        }
        Instruction::Binary(item) => {
            ret Result::Ok(TypedInstruction::Binary(freeze_BinaryInstruction(context, item)?))
        }
        Instruction::Phi(item) => {
            ret Result::Ok(TypedInstruction::Phi(freeze_PhiInstruction(context, item)?))
        }
        Instruction::AddEdge(item) => {
            ret Result::Ok(TypedInstruction::AddEdge(freeze_EdgeInstruction(context, item)?))
        }
        Instruction::RemoveEdge(item) => {
            ret Result::Ok(TypedInstruction::RemoveEdge(freeze_EdgeInstruction(context, item)?))
        }
        Instruction::Cfree(item) => {
            ret Result::Ok(TypedInstruction::Cfree(freeze_CfreeInstruction(context, item)?))
        }
        Instruction::Drop(item) => {
            ret Result::Ok(TypedInstruction::Drop(freeze_DropInstruction(context, item)?))
        }
        Instruction::Retain(item) => {
            ret Result::Ok(TypedInstruction::Retain(freeze_RetainInstruction(context, item)?))
        }
    }
    ret Result::Err("invalid Instruction")
}

fn thaw_Instruction(function: TypedFunction, item: TypedInstruction) -> Result[Instruction, str] {
    match item {
        TypedInstruction::Comment(item) => {
            ret Result::Ok(Instruction::Comment(thaw_CommentInstruction(function, item)?))
        }
        TypedInstruction::Lcpos(item) => {
