//! Versioned function records suitable for verified content-addressed storage.
import core::result::Result
import std::vec::Vec

import mod::artifact_codec::{decode_snapshot_FnDirective, decode_snapshot_Module, decode_snapshot_ModuleBundle, encode_snapshot_FnDirective, encode_snapshot_Module, encode_snapshot_ModuleBundle}
import mod::core::{Directive, FnDirective, Module, ModuleBundle, make_module}
import mod::validate::validate_module

pub struct PreparedFunctionArtifact {
    schema: u32
    identity: str
    function: FnDirective
}

/// Typed snapshots bind the full schema and logical compiler cache identity.
pub fn encode_typed_module(module: Module, identity: str) -> Result[str, str] {
    ret Result::Ok(prepared_bytes_payload(encode_snapshot_Module(module, identity)?))
}

pub fn decode_typed_module(payload: str, identity: str) -> Result[Module, str] {
    let module = decode_snapshot_Module(prepared_payload_bytes(payload), identity)?
    let _checked = validate_module(module)?
    ret Result::Ok(module)
}

pub fn encode_typed_bundle(bundle: ModuleBundle, identity: str) -> Result[str, str] {
    ret Result::Ok(prepared_bytes_payload(encode_snapshot_ModuleBundle(bundle, identity)?))
}

pub fn decode_typed_bundle(payload: str, identity: str) -> Result[ModuleBundle, str] {
    let bundle = decode_snapshot_ModuleBundle(prepared_payload_bytes(payload), identity)?
    for module in bundle.modules {
        let _checked = validate_module(module)?
    }
    ret Result::Ok(bundle)
}

pub fn encode_prepared_function(function: FnDirective, identity: str) -> Result[Vec[u8], str] {
    ret encode_snapshot_FnDirective(function, identity)
}

pub fn decode_prepared_function(bytes: Vec[u8], identity: str) -> Result[FnDirective, str] {
    let function = decode_snapshot_FnDirective(bytes, identity)?
    let _checked = validate_module(make_module("prepared", vec![Directive::Function(function)]))?
    ret Result::Ok(function)
}

/// Storage adapters own locking, integrity verification, accounting and pruning.
pub trait PreparedFunctionStore {
    fn read(self: Self, key: str) -> Result[core::option::Option[Vec[u8]], str]
    fn write(self: Self, key: str, bytes: Vec[u8]) -> Result[(), str]
}

/// Keys are supplied by the host and bind compiler/pass versions,
/// target/profile/features and the fully resolved function input. Backend
/// layouts and templates are validated separately from common preparation.
pub struct FunctionPreparationKey {
    module_name: str
    directive: usize
    method: usize
    key: str
}

extern fn encore_codec_string(bytes: u8*, len: usize) -> str
extern fn encore_str_data(value: str) -> u8*
extern fn memcpy(destination: u8*, source: u8*, len: usize) -> u8*
pub fn prepared_bytes_payload(bytes: Vec[u8]) -> str {
    ret unsafe {
        encore_codec_string(bytes.as_ptr(), bytes.len())
    }
}
pub fn prepared_payload_bytes(payload: str) -> Vec[u8] {
    let mut bytes = Vec[u8]::with_capacity(payload.byte_len())
    // The native call borrows both buffers synchronously. Only byte values are
    // copied, and no uninitialized element becomes visible before completion.
    if payload.byte_len() != 0_usize {
        unsafe {
            let _copied = memcpy(bytes.as_ptr(), encore_str_data(payload), payload.byte_len())
        }
        bytes.set_len(payload.byte_len())
    }
    ret bytes
}
