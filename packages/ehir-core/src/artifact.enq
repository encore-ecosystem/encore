//! Versioned function records suitable for verified content-addressed storage.
import core::result::Result
import std::vec::Vec

import binary

import mod::typed::{TypedFunction, thaw_function}

pub struct PreparedFunctionArtifact {
    schema: u32
    identity: str
    function: TypedFunction
}

pub fn encode_prepared_function(function: TypedFunction, identity: str) -> Result[Vec[u8], str] {
    match binary::encode(PreparedFunctionArtifact { 1_u32, identity, function }) {
        Ok(bytes) => {
            ret Result::Ok(bytes)
        }
        Err(error) => {
            ret Result::Err(error.message())
        }
    }
    ret Result::Err("cannot encode prepared function")
}

pub fn decode_prepared_function(bytes: Vec[u8], identity: str) -> Result[TypedFunction, str] {
    let artifact = match binary::decode[PreparedFunctionArtifact](bytes) {
        Ok(value) => value
        Err(error) => {
            ret Result::Err(error.message())
        }
    }
    if artifact.schema != 1_u32 || artifact.identity != identity {
        ret Result::Err("prepared EHIR identity or schema mismatch")
    }
    // Bounds-check every used value/type/symbol reference before publishing.
    let _checked = thaw_function(artifact.function)?
    ret Result::Ok(artifact.function)
}

/// Storage adapters own locking, integrity verification, accounting and pruning.
pub trait PreparedFunctionStore {
    fn read(self: Self, key: str) -> Result[core::option::Option[Vec[u8]], str]
    fn write(self: Self, key: str, bytes: Vec[u8]) -> Result[(), str]
}

/// Keys are supplied by the host and bind compiler/pass versions,
/// target/profile/features and the fully resolved function input. Backend
/// layouts and templates are validated separately from common preparation.
pub struct FunctionPreparationKey {
    module_name: str
    directive: usize
    method: usize
    key: str
}

extern fn encore_codec_string(bytes: u8*, len: usize) -> str
pub fn prepared_bytes_payload(bytes: Vec[u8]) -> str {
    ret unsafe {
        encore_codec_string(bytes.as_ptr(), bytes.len())
    }
}
pub fn prepared_payload_bytes(payload: str) -> Vec[u8] {
    let mut bytes = Vec[u8]::with_capacity(payload.byte_len())
    for index in 0_usize..payload.byte_len() {
        bytes.push(payload.byte_at(index))
    }
    ret bytes
}
