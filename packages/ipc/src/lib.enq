//! Byte streams over local Unix sockets.
import core::future::{Context, Future, Poll}
import core::result::Result

import std::future::block_on

import network::{Listener, NetworkConnectFuture, NetworkError, NetworkListenFuture, NetworkReadFuture, NetworkWriteFuture, Stream}

pub struct LocalStream {
    stream: Stream
}

pub struct LocalListener {
    listener: Listener
}

pub struct LocalConnectFuture {
    pending: NetworkConnectFuture
}

pub struct LocalBindFuture {
    pending: NetworkListenFuture
}

impl Future[Result[LocalStream, NetworkError]] for LocalConnectFuture {
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[LocalStream, NetworkError]] {
        match self.pending.poll(context) {
            Poll::Ready(result) => {
                match result {
                    Result::Ok(stream) => {
                        ret Poll::Ready(Result::Ok(LocalStream { stream }))
                    }
                    Result::Err(error) => {
                        ret Poll::Ready(Result::Err(error))
                    }
                }
            }
            Poll::Pending(next) => {
                ret Poll::Pending(Self { next })
            }
        }
    }
}

impl Future[Result[LocalListener, NetworkError]] for LocalBindFuture {
    pub fn poll(self: Self, context: Context) -> Poll[Self, Result[LocalListener, NetworkError]] {
        match self.pending.poll(context) {
            Poll::Ready(result) => {
                match result {
                    Result::Ok(listener) => {
                        ret Poll::Ready(Result::Ok(LocalListener { listener }))
                    }
                    Result::Err(error) => {
                        ret Poll::Ready(Result::Err(error))
                    }
                }
            }
            Poll::Pending(next) => {
                ret Poll::Pending(Self { next })
            }
        }
    }
}

impl for LocalStream {
    pub fn connect_async(path: str, timeout_ms: usize) -> LocalConnectFuture {
        ret LocalConnectFuture { Stream::local_connect_async(path, timeout_ms) }
    }
    pub fn connect(path: str, timeout_ms: usize) -> Result[Self, NetworkError] {
        ret block_on[Result[Self, NetworkError], LocalConnectFuture](Self::connect_async(path, timeout_ms))
    }
    pub fn read_async(self: Self, max_bytes: usize) -> NetworkReadFuture {
        ret self.stream.read_async(max_bytes)
    }
    pub fn read(self: Self, max_bytes: usize) -> Result[str, NetworkError] {
        ret self.stream.read(max_bytes)
    }
    pub fn write_all_async(self: Self, bytes: str) -> NetworkWriteFuture {
        ret self.stream.write_all_async(bytes)
    }
    pub fn write_all(self: Self, bytes: str) -> Result[(), NetworkError] {
        ret self.stream.write_all(bytes)
    }
    pub fn shutdown_write_async(self: Self) -> NetworkWriteFuture {
        ret self.stream.local_shutdown_write_async()
    }
    pub fn shutdown_write(self: Self) -> Result[(), NetworkError] {
        ret block_on[Result[(), NetworkError], NetworkWriteFuture](self.shutdown_write_async())
    }
    pub fn close(self: Self) ->() {
        self.stream.close()
    }
}

impl for LocalListener {
    /// The caller owns the socket pathname and must remove it after closing.
    pub fn bind_async(path: str, timeout_ms: usize) -> LocalBindFuture {
        ret LocalBindFuture { Listener::local_bind_async(path, timeout_ms) }
    }
    pub fn bind(path: str, timeout_ms: usize) -> Result[Self, NetworkError] {
        ret block_on[Result[Self, NetworkError], LocalBindFuture](Self::bind_async(path, timeout_ms))
    }
    pub fn accept_async(self: Self) -> LocalConnectFuture {
        ret LocalConnectFuture { self.listener.accept_async() }
    }
    pub fn accept(self: Self) -> Result[LocalStream, NetworkError] {
        ret block_on[Result[LocalStream, NetworkError], LocalConnectFuture](self.accept_async())
    }
    pub fn close(self: Self) ->() {
        self.listener.close()
    }
}
