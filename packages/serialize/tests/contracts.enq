import core::option::Option
import core::result::Result
import serialize::{Serializer, Deserializer, Error, ErrorKind, Limits}

struct Encoder {
    value: u32
}
struct Decoder {
    value: u32
}

impl Serializer[u32] for Encoder {
    fn serialize(self: Self) -> Result[u32, Error] {
        ret Result::Ok(self.value)
    }
}

impl Deserializer[u32] for Decoder {
    fn deserialize(self: Self) -> Result[u32, Error] {
        ret Result::Ok(self.value)
    }
}

fn encode[Output, Codec: Serializer[Output]](codec: Codec) -> Result[Output, Error] {
    ret codec.serialize()
}

fn decode[Value, Codec: Deserializer[Value]](codec: Codec) -> Result[Value, Error] {
    ret codec.deserialize()
}

fn main() -> u32 {
    if encode[u32, Encoder](Encoder { 42 }).unwrap_or(0) != 42 {
        ret 1
    }
    if decode[u32, Decoder](Decoder { 42 }).unwrap_or(0) != 42 {
        ret 2
    }
    let error = Error::new(ErrorKind::InvalidData, "invalid value").with_offset(13).at("name").at("users[2]")
    if error.path() != "users[2].name" || error.message() != "invalid value" {
        ret 3
    }
    if error.offset().unwrap_or(0) != 13 {
        ret 4
    }
    let limits = Limits::new().with_max_depth(4).with_max_input_bytes(1024)
    .with_max_allocation_bytes(2048).with_max_collection_items(32)
    if limits.max_depth() != 4 || limits.max_input_bytes() != 1024 ||
    limits.max_allocation_bytes() != 2048 || limits.max_collection_items() != 32 {
        ret 5
    }
    ret 0
}
