//! Third-party formats need only core::reflect and the two codec contracts.
import core::fmt::Debug
import core::reflect
import core::result::Result
import serialize::{Serializer, Error}
struct Pair {
    a: u32
    b: u32
}
struct Lines[Value] {
    value: Value
}

impl[Value] Serializer[str] for Lines[Value] {
    pub fn serialize(self: Self) -> Result[str, Error] {
        let info = reflect::type_info[Value]()
        let mut output = ""
        for field in info.fields() {
            output = output + field.name() + "=" + Debug::fmt(field.get(self.value)) + "\n"
        }
        ret Result::Ok(output)
    }
}
fn main() -> u32 {
    match Serializer::serialize(Lines[Pair] {
            Pair { 10_u32, 20_u32 }
        }
        ,
    ) {
        Ok(value) => {
            if value != "a=10\nb=20\n" {
                ret 1
            }
        }
        Err(_) => {
            ret 2
        }
    }
    ret 0
}
