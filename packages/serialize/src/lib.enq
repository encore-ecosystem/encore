//! Format-independent codec contracts. Formats own their traversal and wire rules.

import core::option::Option
import core::result::Result

/// Classifies failures without requiring callers to inspect message text.
pub enum ErrorKind {
    UnsupportedType
    InvalidData
    MissingField
    DuplicateField
    UnknownVariant
    OutOfRange
    LimitExceeded
    InvalidSchema
    UnsupportedVersion
}

/// A codec failure with an optional input byte offset and a value path.
pub struct Error {
    category: ErrorKind
    description: str
    value_path: str
    input_offset: Option[usize]
}

impl for Error {
    /// Creates a failure at the current value.
    pub fn new(category: ErrorKind, description: str) -> Self {
        ret Self { category, description, "", Option[usize]::None }
    }

    /// Returns the failure category.
    pub fn kind(self: Self) -> ErrorKind {
        ret self.category
    }

    /// Returns a human-readable explanation.
    pub fn message(self: Self) -> str {
        ret self.description
    }

    /// Returns the path from the document root to the failed value.
    pub fn path(self: Self) -> str {
        ret self.value_path
    }

    /// Returns the input byte offset when it is available.
    pub fn offset(self: Self) -> Option[usize] {
        ret self.input_offset
    }

    /// Associates a byte offset with this failure.
    pub fn with_offset(self: Self, offset: usize) -> Self {
        ret Self { self.category, self.description, self.value_path, Option[usize]::Some(offset) }
    }

    /// Prepends one field or collection segment while unwinding traversal.
    pub fn at(self: Self, segment: str) -> Self {
        let path = if self.value_path == "" {
            segment
        } else {
            segment + "." + self.value_path
        }
        ret Self { self.category, self.description, path, self.input_offset }
    }
}

/// A format implementation which owns its source value and produces Output.
pub trait Serializer[Output] {
    fn serialize(self: Self) -> Result[Output, Error]
}

/// A format implementation which owns its input and constructs Value.
pub trait Deserializer[Value] {
    fn deserialize(self: Self) -> Result[Value, Error]
}

/// Resource bounds shared by codec options. Callers can raise them for large assets.
pub struct Limits {
    depth: usize
    input_bytes: usize
    allocation_bytes: usize
    collection_items: usize
}

impl for Limits {
    /// Defaults to depth 128, 64 MiB input, 256 MiB allocations and 16M items.
    pub fn new() -> Self {
        ret Self { 128, 67108864, 268435456, 16777216 }
    }

    /// Returns the maximum nesting depth.
    pub fn max_depth(self: Self) -> usize {
        ret self.depth
    }
    /// Returns the maximum input byte length.
    pub fn max_input_bytes(self: Self) -> usize {
        ret self.input_bytes
    }
    /// Returns the maximum cumulative requested allocation size.
    pub fn max_allocation_bytes(self: Self) -> usize {
        ret self.allocation_bytes
    }
    /// Returns the maximum number of items in any one collection.
    pub fn max_collection_items(self: Self) -> usize {
        ret self.collection_items
    }

    /// Replaces the maximum nesting depth.
    pub fn with_max_depth(self: Self, value: usize) -> Self {
        ret Self { value, self.input_bytes, self.allocation_bytes, self.collection_items }
    }
    /// Replaces the maximum input byte length.
    pub fn with_max_input_bytes(self: Self, value: usize) -> Self {
        ret Self { self.depth, value, self.allocation_bytes, self.collection_items }
    }
    /// Replaces the maximum cumulative allocation size.
    pub fn with_max_allocation_bytes(self: Self, value: usize) -> Self {
        ret Self { self.depth, self.input_bytes, value, self.collection_items }
    }
    /// Replaces the maximum item count of a collection.
    pub fn with_max_collection_items(self: Self, value: usize) -> Self {
        ret Self { self.depth, self.input_bytes, self.allocation_bytes, value }
    }
}
