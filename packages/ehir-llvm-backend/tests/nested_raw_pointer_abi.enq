//! Pointer layers and generic pointees stay addresses, without node helpers.
import core::testing::assert
import ehir_core::{parse_module_text, parse_type_text, type_to_string}

import refrain::codegen::emit_ir

fn main() -> u32 {
    if !assert(type_to_string(parse_type_text("Box[u8]***")) == "Box[u8]***") {
        ret 1
    }
    let source = "struct Box[T] {\n  value: T\n}\n" +
    "extern fn observe(value: u8**) -> ()\n" +
    "extern fn generic(value: Box[u8]**) -> ()\n" +
    "fn forward(value: u8**) -> u8** {\n  $entry:\n    ret value: u8**\n}\n"
    let llvm = emit_ir(parse_module_text("nested_raw_pointer", source))
    if !assert(llvm.contains("declare void @observe(i8** %value)")) {
        ret 2
    }
    if !assert(llvm.contains("define i8** @forward(i8** %value)")) {
        ret 3
    }
    if !assert(!llvm.contains("%u8_")) {
        ret 4
    }
    if !assert(!llvm.contains("__replace_place_edges_u8_")) {
        ret 5
    }
    if !assert(llvm.contains("** %value)")) {
        ret 6
    }
    let generic = "fn element[T](ptr: T*, index: usize, value: T) -> () {\n  $entry:\n    address: T* = gep ptr: T*, index: usize\n    store value: T, address: T*\n    ret void: ()\n}\n" +
    "fn use(ptr: u8**, index: usize, value: u8*) -> () {\n  $entry:\n    result: () = call element[u8*](ptr: u8**, index: usize, value: u8*)\n    ret void: ()\n}\n"
    let specialized = emit_ir(parse_module_text("generic_pointer", generic))
    if !assert(specialized.contains("getelementptr inbounds i8*, i8** %ptr")) {
        ret 7
    }
    if !assert(specialized.contains("store i8* %value, i8** %address")) {
        ret 8
    }
    ret 0
}
