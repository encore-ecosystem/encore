//! Unit parameters retain their source types without becoming LLVM void operands.
import ehir_core::parse_module_text
import refrain::codegen::emit_ir
fn main() -> u32 {
    let source = "fn take(unit: (), value: u32) -> u32 {\n" +
    "  $entry:\n    ret value: u32\n}\n" +
    "fn forward(unit: (), value: u32) -> u32 {\n" +
    "  $entry:\n    result: u32 = call take(unit: (), value: u32)\n" +
    "    ret result: u32\n}\n"
    let llvm = emit_ir(parse_module_text("unit_parameters", source))
    if llvm.contains("void %unit") {
        ret 1
    }
    if !llvm.contains("@take(i32 %value)") || !llvm.contains("call i32 @take(i32 %value)") {
        ret 2
    }
    ret 0
}
