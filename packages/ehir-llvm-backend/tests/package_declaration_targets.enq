//! Shared declarations are scoped to each target and emission invocation.
import core::testing::assert
import std::vec::Vec

import ehir_core::parse_module_bundle_text

import refrain::codegen::{emit_unit_codegen_selected_parallel, prepare_unit_codegen}

fn main() -> u32 {
    let dependencies = parse_module_bundle_text("", "module dependency {\nextern fn tick(value: usize) -> usize\n}\n")
    let owned = parse_module_bundle_text("", "module alpha {\nfn alpha(value: usize) -> usize {\n$entry:\nret value: usize\n}\n}\n" +
        "module beta {\nfn beta(value: usize) -> usize {\n$entry:\nanswer: usize = call tick(value: usize)\nret answer: usize\n}\n}\n",)
    for target in vec![("i686-unknown-linux-gnu", 32_usize),
        ("x86_64-pc-windows-msvc", 64_usize),("aarch64-apple-darwin", 64_usize),
        ("i686-unknown-linux-gnu", 32_usize)] {
        let unit = prepare_unit_codegen(owned, dependencies, target.0, target.1, 2_usize)
        let outputs = emit_unit_codegen_selected_parallel(unit, target.0, target.1, vec![0_usize, 1_usize], 2_usize)
        if !assert(outputs.len() == 2_usize) {
            ret 1_u32
        }
        let expected = if target.1 == 32_usize {
            "i32"
        } else {
            "i64"
        }
        let other = if target.1 == 32_usize {
            "i64"
        } else {
            "i32"
        }
        for output in outputs {
            if !assert(output.diagnostic.is_empty()) {
                ret 2_u32
            }
            if !assert(output.ir.contains("declare " + expected + " @tick(" + expected + " %value)")) {
                ret 3_u32
            }
            if !assert(!output.ir.contains("declare " + other + " @tick(")) {
                ret 4_u32
            }
        }
    }
    ret 0_u32
}
