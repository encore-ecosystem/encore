//! The file API produces a linkable object rather than text with an .o suffix.
import core::testing::assert
import std::os::{file_exists, mkdir_all, os_name, read_file, write_file_atomic}
import std::process::Command

import ehir_core::parse_module_text

import refrain::backend::{compile_to_file, new}
import refrain::types::{BackendOptProfile, BackendTarget, backend_config, compiled_refrain}
fn main() -> u32 {
    if mkdir_all("target/native-artifact-contract") != 0_i32 {
        ret 1_u32
    }
    let module = parse_module_text("native", "fn answer() -> u32 {\n$entry:\nvalue: u32 = capprim 42_u32\nret value: u32\n}\n")
    let backend = new(backend_config("target/native-artifact-contract", BackendOptProfile::DEBUG))
    let output = "target/native-artifact-contract/answer.o"
    let artifact = compile_to_file(backend, compiled_refrain("native", BackendTarget::OBJECT, module), output)
    if !assert(artifact.status == 0_i32 && file_exists(output)) {
        ret 2_u32
    }
    if write_file_atomic("target/native-artifact-contract/main.c", "extern unsigned answer(void); int main(void) { return answer() != 42u; }\n") != 0_i32 {
        ret 3_u32
    }
    let executable = "target/native-artifact-contract/run" + if os_name() == "windows" {
        ".exe"
    } else {
        ""
    }
    let linked = Command::new("clang").arg("target/native-artifact-contract/main.c").arg(output).arg("-o").arg(executable).output()
    if !assert(linked.success()) {
        ret 4_u32
    }
    if !assert(Command::new(executable).output().success()) {
        ret 5_u32
    }
    ret 0_u32
}
