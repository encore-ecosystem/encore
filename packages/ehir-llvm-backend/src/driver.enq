//! LLVM implementation of the backend-independent compiler contract.
import core::result::Result
import std::vec::Vec

import ehir_core::{Backend, BackendOutput, CompileOptions, CompilerDiagnostic, GeneratedModule, PreparedProgram}

import mod::codegen::{clear_codegen_error, emit_prepared_ir_bundle_for_target, take_codegen_error}

pub struct LLVMBackend {
}

impl Backend for LLVMBackend {
    pub fn name(self: Self) -> str {
        ret "llvm"
    }
    pub fn version(self: Self) -> str {
        ret "1"
    }
    pub fn supports(self: Self, options: CompileOptions) -> bool {
        let mut length = 0_usize
        while length < options.target.byte_len() && options.target.byte_at(length) != 45_u8 {
            length += 1_usize
        }
        let arch = options.target.slice_bytes(0_usize, length)
        ret((arch == "x86_64" || arch == "aarch64" || arch == "riscv64") && options.pointer_width == 64_usize) ||
        ((arch == "wasm32" || arch == "i686") && options.pointer_width == 32_usize)
    }
    pub fn generate(self: Self, program: PreparedProgram, options: CompileOptions) -> Result[BackendOutput, CompilerDiagnostic] {
        clear_codegen_error()
        let mut modules = Vec[GeneratedModule]::new()
        let bundle = program.program
        for module in emit_prepared_ir_bundle_for_target(bundle, options.target, options.pointer_width, options.jobs) {
            if !module.diagnostic.is_empty() {
                ret Result::Err(CompilerDiagnostic { "codegen", module.diagnostic })
            }
            modules.push(GeneratedModule { module.module_id, module.ir })
        }
        let message = take_codegen_error()
        if !message.is_empty() {
            ret Result::Err(CompilerDiagnostic { "codegen", message })
        }
        ret Result::Ok(BackendOutput { "llvm", "llvm-ir", modules })
    }
}
