import std::os::{arch_name, os_name}

import refrain::assembler::emit_native_payload
import refrain::codegen::{clear_codegen_error, emit_ir_for_target, take_codegen_error}
import refrain::optimizer::optimize_ir
import refrain::types::{BackendConfig, BackendTarget, BuildArtifact, CompiledRefrain, build_artifact}

pub struct EHIRLLVMBackend {
    config: BackendConfig
}

pub fn new(config: BackendConfig) -> EHIRLLVMBackend {
    ret EHIRLLVMBackend {
        config
    }
}

pub fn compile_to_file(backend: EHIRLLVMBackend, input: CompiledRefrain, output_path: str) -> BuildArtifact {
    let config = backend.config
    clear_codegen_error()
    let raw_arch = arch_name()
    let arch = if raw_arch == "x86" {
        "i686"
    } else {
        raw_arch
    }
    let triple = arch + match os_name() {
        "windows" => "-pc-windows-msvc" "macos" => "-apple-darwin" _ => "-unknown-linux-gnu"
    }
    let width = if arch == "i686" || arch == "x86" {
        32_usize
    } else {
        64_usize
    }
    let raw_ir = emit_ir_for_target(input.module, triple, width)
    if !take_codegen_error().is_empty() {
        ret build_artifact(output_path, input.target, 1_i32)
    }
    let optimized_ir = optimize_ir(raw_ir, config.profile)
    let status = emit_native_payload(optimized_ir, output_path, input.target, config.profile)
    ret build_artifact(output_path, input.target, status)
}
