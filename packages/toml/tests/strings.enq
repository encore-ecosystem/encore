import toml::{TomlDocument, toml_get_string, toml_get_string_array, toml_parse_document}

fn equal(doc: TomlDocument, key: str, expected: str) -> bool {
    match toml_get_string(doc, "project", key) {
        Some(value) => {
            ret value == expected
        }
        None => {
            ret false
        }
    }
}

fn main() -> u32 {
    let source = "[project]\nname = \"набор\" # inline comment\nversion = \"β\\\"\\\\\\n\\t\\u03b2\\U0001F642\" # metadata\nliteral = 'C:\\new\\file' # no unescaping\nvalues = [\"α\\\"quoted\", \"\\\\tmp\", 'C:\\literal']\ncontrols = \"\\b\\f\"\n"
    let document = toml_parse_document(source)
    if !equal(document, "name", "набор") || !equal(document, "version", "β\"\\\n\tβ🙂") ||
    !equal(document, "literal", "C:\\new\\file") {
        ret 1_u32
    }
    match toml_get_string_array(document, "project", "values") {
        Some(values) => {
            if values.len() != 3_usize || values.get(0_usize).unwrap_or("") != "α\"quoted" ||
            values.get(1_usize).unwrap_or("") != "\\tmp" || values.get(2_usize).unwrap_or("") != "C:\\literal" {
                ret 2_u32
            }
        }
        None => {
            ret 3_u32
        }
    }
    match toml_get_string(document, "project", "controls") {
        Some(value) => {
            if value.byte_len() != 2_usize || value.byte_at(0_usize) != 8_u8 || value.byte_at(1_usize) != 12_u8 {
                ret 4_u32
            }
        }
        None => {
            ret 5_u32
        }
    }
    ret 0_u32
}
