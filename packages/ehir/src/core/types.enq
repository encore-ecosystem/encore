import core::option::Option

import std::vec::Vec

pub enum RepresentationKind {
    Inline
    NodeStack
    NodeHeap
    NodeAny
    Raw
    // Transitional addressable local emitted before local-to-SSA lowering.
    // This is a place category, not an EHIR value representation.
    LocalPlace
}

pub struct Type {
    name: str
    generics: Vec[Type]
    representation: RepresentationKind
}

pub fn make_type(name: str, generics: Vec[Type], representation: RepresentationKind) -> Type {
    ret Type {
        name, generics, representation
    }
}

pub fn plain_type(name: str, generics: Vec[Type]) -> Type {
    ret Type {
        name, generics, RepresentationKind::Inline
    }
}

pub fn heap_type(inner: Type) -> Type {
    ret Type {
        inner.name, inner.generics, RepresentationKind::NodeHeap
    }
}

pub fn stack_type(inner: Type) -> Type {
    ret Type {
        inner.name, inner.generics, RepresentationKind::NodeStack
    }
}

pub fn any_node_type(inner: Type) -> Type {
    ret Type {
        inner.name, inner.generics, RepresentationKind::NodeAny
    }
}

pub fn raw_type(inner: Type) -> Type {
    ret Type {
        represented_type_name(inner), inner.generics, RepresentationKind::Raw
    }
}

pub fn local_place_type(inner: Type) -> Type {
    ret Type {
        represented_type_name(inner), inner.generics, RepresentationKind::LocalPlace
    }
}

/// Preserve the stored value's representation when adding an address layer.
/// Generic arguments remain structured and are never reparsed from IR text.
pub fn represented_type_name(inner: Type) -> str {
    match inner.representation {
        Inline => {
            ret inner.name
        }
        Raw => {
            ret inner.name + "*"
        }
        NodeHeap => {
            ret inner.name + "<H>"
        }
        NodeStack => {
            ret inner.name + "<S>"
        }
        NodeAny => {
            ret inner.name + "&"
        }
        LocalPlace => {
            ret "mut " + inner.name
        }
    }
}

/// Remove one address layer while keeping an inner raw/node handle intact.
pub fn memory_value_type(place: Type) -> Type {
    let name = place.name
    let length = name.char_len()
    if length > 0 && name.slice(length - 1, 1) == "*" {
        ret Type { name.slice(0, length - 1), place.generics, RepresentationKind::Raw }
    }
    if length >= 3 && name.slice(length - 3, 3) == "<H>" {
        ret Type { name.slice(0, length - 3), place.generics, RepresentationKind::NodeHeap }
    }
    if length >= 3 && name.slice(length - 3, 3) == "<S>" {
        ret Type { name.slice(0, length - 3), place.generics, RepresentationKind::NodeStack }
    }
    if length > 0 && name.slice(length - 1, 1) == "&" {
        ret Type { name.slice(0, length - 1), place.generics, RepresentationKind::NodeAny }
    }
    ret Type { name, place.generics, RepresentationKind::Inline }
}

fn join_mangled_generics(generics: frozen Vec[Type]) -> str {
    let mut out = ""
    let mut index = 0_usize

    loop {
        match generics.get(index) {
            Some(generic) => {
                if index > 0_usize {
                    out = out + "_"
                }
                out = out + mangle_type_name(generic)
                index = index + 1_usize
            }
            None => {
                break
            }
        }
    }

    ret out
}

pub fn mangle_plain_type_name(name: str, generics: frozen Vec[Type]) -> str {
    if generics.len() == 0_usize {
        ret name
    }
    ret name + "_" + join_mangled_generics(generics)
}

pub fn mangle_type_name(typ: frozen Type) -> str {
    let mut out = mangle_plain_type_name("" + typ.name, typ.generics)
    match typ.representation {
        RepresentationKind::NodeHeap => {
            out = out + "_H"
        }
        RepresentationKind::NodeStack => {
            out = out + "_S"
        }
        RepresentationKind::NodeAny => {
            out = out + "_A"
        }
        RepresentationKind::Raw => {
            out = out + "_ptr"
        }
        RepresentationKind::LocalPlace => {
            out = out + "_local"
        }
        RepresentationKind::Inline => {
        }
    }
    ret out
}
