import core::testing::assert

import ehirlib::{Directive, directive_to_string, instruction_to_string, parse_instruction_text, parse_struct_text}

fn main() -> u32 {
    let source = "struct NativeToken {\n  // @retain native_retain\n  // @release native_release\n  token: usize\n}"
    let restored = parse_struct_text(source)
    match restored {
        Directive::Struct(item) => {
            if !assert(item.resource_retain == "native_retain" && item.resource_release == "native_release" && item.fields.len() == 1) {
                ret 1
            }
        }
        _ => {
            ret 2
        }
    }
    if !assert(directive_to_string(restored) == source) {
        ret 3
    }
    let call = "answer: u32 = icall callback: usize(value: u32)"
    if !assert(instruction_to_string(parse_instruction_text(call)) == call) {
        ret 4
    }
    ret 0
}
