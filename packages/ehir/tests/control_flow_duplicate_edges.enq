//! Two branch arms from one block are one SSA predecessor, not a join.
import core::result::Result
import ehirlib::{Directive, Instruction, normalize_control_flow, parse_module_text, validate_module}

fn main() -> u32 {
    let source = "fn choose(flag: bool) -> u32 {\n$entry:\nslot: u32* = salloc u32\nvalue: u32 = lcpos 7_u32\nstore value, slot\ncbr flag, $join, $join\n$join:\nresult: u32 = load slot\nret result: u32\n}\n"
    let normalized = normalize_control_flow(parse_module_text("duplicate_edges", source))
    match validate_module(normalized) {
        Result::Err(_) => {
            ret 1
        }
        Result::Ok(module) => {
            for directive in module.directives {
                match directive {
                    Directive::Function(function) => {
                        for block in function.blocks {
                            for instruction in block.instructions {
                                match instruction {
                                    Instruction::Phi(_) => {
                                        ret 2
                                    }
                                    Instruction::StackAlloc(_) => {
                                        ret 3
                                    }
                                    Instruction::Load(_) => {
                                        ret 4
                                    }
                                    Instruction::Store(_) => {
                                        ret 5
                                    }
                                    _ => {
                                    }
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
        }
    }
    ret 0
}
