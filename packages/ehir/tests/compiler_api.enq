//! The default compiler consumes an in-memory bundle and returns actual LLVM IR.
import core::testing::assert
import core::result::Result

import std::vec::Vec

import ehirlib::{CompileOptions, Module, compile, compile_prepared, make_module_bundle, parse_module_text, prepare}

fn main() -> u32 {
    let source = "fn answer() -> u32 {\n$entry:\nvalue: u32 = capprim 42_u32\nret value: u32\n}\n"
    let module = parse_module_text("api", source)
    let bundle = make_module_bundle("api", vec![module])
    let options = CompileOptions { "x86_64-unknown-linux-gnu", 64_usize, "dev", 2_usize }
    match compile(bundle, options) {
        Result::Ok(output) => {
            if !assert(output.backend == "llvm" && output.modules.len() == 1_usize) {
                ret 1_u32
            }
            let text = output.modules.get(0_usize).unwrap_or(output.modules.get_unchecked_borrowed(0_usize)).text
            if !assert(text.contains("define i32 @answer") && text.contains("42")) {
                ret 2_u32
            }
        }
        Result::Err(error) => {
            ret 3_u32
        }
    }
    if !assert(compile(bundle, CompileOptions { options.target, 64_usize, "dev", 0_usize }).is_err()) {
        ret 4_u32
    }
    if !assert(compile(bundle, CompileOptions { "unsupported", 64_usize, "dev", 1_usize }).is_err()) {
        ret 5_u32
    }
    if !assert(compile(bundle, CompileOptions { options.target, 32_usize, "dev", 1_usize }).is_err()) {
        ret 6_u32
    }
    let invalid = parse_module_text("invalid", "fn broken() -> usize {\n$entry:\np: usize = call __ehir_call_indirect()\nret p: usize\n}\n")
    if !assert(compile(make_module_bundle("invalid", vec![invalid]), options).is_err()) {
        ret 7_u32
    }
    if !assert(compile(bundle, options).is_ok()) {
        ret 8_u32
    }
    let prepared = match prepare(bundle) {
        Ok(value) => value Err(_) => {
            ret 9_u32
        }
    }
    if !assert(compile_prepared(prepared, options).is_ok()) {
        ret 10_u32
    }
    ret 0_u32
}
