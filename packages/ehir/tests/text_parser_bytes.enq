//! EHIR delimiters are ASCII; quoted UTF-8, escapes and NUL remain payload.
import ehirlib::{module_to_string, parse_module_text}
import ehirlib::text::parser::split_top_level_text

fn main() -> u32 {
    let parts = split_top_level_text("  Pair[α, Option[β]], (\"x,y\", \"😀)\"), \"a\\\",b\", tail ", ",")
    if parts.len() != 4 {
        ret 1
    }
    if parts.get(0).unwrap_or("") != "Pair[α, Option[β]]" {
        ret 2
    }
    if parts.get(1).unwrap_or("") != "(\"x,y\", \"😀)\")" {
        ret 3
    }
    if parts.get(2).unwrap_or("") != "\"a\\\",b\"" {
        ret 4
    }
    if parts.get(3).unwrap_or("") != "tail" {
        ret 5
    }
    let binary = split_top_level_text("\"a\x00b\",tail", ",")
    let first = binary.get(0).unwrap_or("")
    if binary.len() != 2 || first.byte_len() != 5 || first.byte_at(2) != 0_u8 {
        ret 6
    }
    let empty = split_top_level_text(" a,, b,", ",")
    if empty.len() != 3 || empty.get(1).unwrap_or("wrong") != "" {
        ret 7
    }
    let rendered = module_to_string(parse_module_text("unicode", "fn display() -> str {\n$entry:\nvalue: str = lcpos \"Привет {,} 😀\"\nret value: str\n}\n"))
    if !rendered.contains("Привет {,} 😀") {
        ret 8
    }
    if module_to_string(parse_module_text("unicode", rendered)) != rendered {
        ret 9
    }
    ret 0
}
