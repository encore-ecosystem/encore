import core::testing::assert

import refrain::{Instruction, parse_instruction_text}

fn main() -> u32 {
    for name in vec!["call", "unsafe", "alias", "load", "getptr", "getfield", "pcast", "await", "lcpos", "capprim", "capenum", "salloc", "halloc", "and"] {
        match parse_instruction_text("result: bool = " + name + ": bool") {
            Alias(value) => {
                if !assert(value.src.name == name) {
                    ret 1
                }
            }
            _ => {
                ret 2
            }
        }
    }
    ret 0
}
