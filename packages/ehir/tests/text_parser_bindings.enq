//! Typed variable inference remains function-local and uses the latest binding.
import core::fmt::Debug
import ehirlib::{module_to_string, parse_module_text}
import ehirlib::text::parser::parse_function_text

fn main() -> u32 {
    let mut source = "//! module\nfn first(seed: u32) -> u32 {\n$entry:\n"
    for index in 0..1500 {
        source += "value_" + Debug::fmt(index) + ": u32 = alias seed\n"
    }
    source += "ret value_1499\n}\n/// second\nfn second(seed: str) -> str {\n$entry:\nret seed\n}\n"
    let rendered = module_to_string(parse_module_text("bindings", source))
    if !rendered.contains("value_1499: u32 = alias seed: u32") ||
    !rendered.contains("ret value_1499: u32") || !rendered.contains("ret seed: str") {
        ret 1
    }
    if module_to_string(parse_module_text("bindings", rendered)) != rendered {
        ret 2
    }
    // The parser historically resolves an untyped spelling to its latest
    // explicitly typed occurrence, even before validation rejects invalid SSA.
    let shadow = "fn shadow(seed: u32) -> str {\n$entry:\nseed: str = lcpos \"😀\"\nret seed\n}\n"
    let function = parse_function_text(shadow)
    if function.name != "shadow" || function.blocks.len() != 1 {
        ret 3
    }
    let shadowed = module_to_string(parse_module_text("shadow", shadow))
    if !shadowed.contains("ret seed: str") {
        ret 4
    }
    ret 0
}
