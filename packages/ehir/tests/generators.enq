//! Yield carries cancellation roots through typed snapshots and text IR.
import core::option::Option
import core::testing::assert
import ehirlib::*

fn main() -> u32 {
    let source = "generator fn values(keep: str) -> str => Generator[str] {\n  $entry:\n    yield keep: str cleanup [closed: bool = call Resource::with_exit(keep: str)]\n    drop keep: str\n    ret void\n}\n"
    let module = parse_module_text("generator_ir", source)
    let function = match module.directives.get(0_usize) {
        Some(item) => {
            match item { Directive::Function(value) => value _ => { ret 1_u32 } }
        }
        None => { ret 2_u32 }
    }
    if !assert(function.generator_type.is_some()) { ret 3_u32 }
    let frozen = freeze_function(function)
    if !assert(frozen.is_ok()) { ret 4_u32 }
    match frozen {
        Ok(value) => { if !assert(thaw_function(value).is_ok()) { ret 5_u32 } }
        Err(_) => { ret 6_u32 }
    }
    let text = module_to_string(module)
    let restored = parse_module_text("generator_ir", text)
    let lowered = lower_coroutines(restored)
    let mut constructors = 0_usize
    let mut resumptions = 0_usize
    for directive in lowered.directives {
        match directive {
            Directive::Function(value) => {
                if value.name == "values" { constructors += 1_usize }
                if !assert(value.generator_type.is_none()) { ret 7_u32 }
                for block in value.blocks {
                    for instruction in block.instructions {
                        match instruction { Instruction::Yield(_) => { ret 8_u32 } _ => {} }
                    }
                }
            }
            Directive::Impl(value) => {
                for method in value.methods {
                    if method.name == "resume" { resumptions += 1_usize }
                    for block in method.blocks {
                        for instruction in block.instructions {
                            match instruction { Instruction::Yield(_) => { ret 9_u32 } _ => {} }
                        }
                    }
                }
            }
            _ => {}
        }
    }
    if !assert(constructors == 1_usize && resumptions == 1_usize) { ret 10_u32 }
    ret 0_u32
}
