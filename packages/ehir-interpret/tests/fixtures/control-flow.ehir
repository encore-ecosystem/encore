struct Pair {
  left: u32
  right: u32
}

enum Answer {
  Full(u32)
  Empty
}

fn identity[T](value: T) -> T {
  $entry:
    ret value: T
}

fn countdown(limit: u32) -> u32 {
  $entry:
    zero: u32 = capprim 0_u32
    one: u32 = capprim 1_u32
    br $loop
  $loop:
    n: u32 = phi limit: u32 $entry, decremented: u32 $body
    sum: u32 = phi zero: u32 $entry, total: u32 $body
    done: bool = ieq n: u32, zero: u32
    cbr done: bool, $done, $body
  $body:
    total: u32 = add sum: u32, n: u32
    decremented: u32 = sub n: u32, one: u32
    br $loop
  $done:
    ret sum: u32
}

fn main() -> u32 {
  $entry:
    six: u32 = capprim 6_u32
    left: u32 = call countdown(six: u32)
    pair: Pair = capstruct Pair(left: u32, left: u32)
    right: u32 = getfield pair: Pair, 1
    sum: u32 = add left: u32, right: u32
    result: Answer = capenum Answer::Full(sum: u32)
    match result: Answer, $empty {
      Full => $full
    }
  $full:
    payload: u32 = getfield result: Answer, Full
    answer: u32 = call identity[u32](payload: u32)
    ret answer: u32
  $empty:
    ret six: u32
}
