import std::path::Path
import std::os::read_dir
import std::vec::Vec
import core::option::Option
import std::io::println

fn main() -> u32 {
    let cwd = Path::cwd()
    let base = cwd.as_str()

    let entries = read_dir(base)
    let mut i = 0_usize

    loop {
        match entries.get(i) {
            Option[str]::Some(name) => {
                println(name)
                i = i + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }

    ret 0_u32
}
