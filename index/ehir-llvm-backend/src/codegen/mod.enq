import core::option::Option
import std::vec::Vec
import std::vec::append
import std::vec::singleton
import ehir::core::Module
import ehir::core::Directive
import ehir::core::FnDirective
import ehir::core::Parameter
import ehir::core::Block
import ehir::core::Instruction
import ehir::core::Terminator
import ehir::core::Variable
import ehir::core::Type
import ehir::core::PointerKind
import ehir::core::BinaryOpKind
import ehir::core::PhiPair
import llvm::core::LLVMFunction
import llvm::core::LLVMParam
import llvm::core::LLVMBasicBlock
import llvm::core::LLVMInstruction
import llvm::core::LLVMTerminator
import llvm::value::LLVMValue
import llvm::types::LLVMType
import llvm::builder::llvm_new
import llvm::builder::llvm_to_text
import llvm::builder::llvm_define_fn
import llvm::builder::llvm_declare_fn
import llvm::builder::llvm_make_param
import llvm::builder::llvm_block
import llvm::builder::llvm_inst_add
import llvm::builder::llvm_inst_sub
import llvm::builder::llvm_inst_call
import llvm::builder::llvm_inst_alloca
import llvm::builder::llvm_inst_load
import llvm::builder::llvm_inst_store
import llvm::builder::llvm_inst_gep
import llvm::builder::llvm_term_ret
import llvm::builder::llvm_term_ret_void
import llvm::builder::llvm_term_br
import llvm::builder::llvm_term_cbr
import llvm::types::void_type
import llvm::types::i1_type
import llvm::types::i8_type
import llvm::types::i16_type
import llvm::types::i32_type
import llvm::types::i64_type
import llvm::types::f16_type
import llvm::types::f32_type
import llvm::types::f64_type
import llvm::types::ptr_type
import llvm::types::named_struct_type
import llvm::value::reg
import llvm::value::const_i32

pub struct LoweredModule {
    module: Module
    ir: str
}

extern fn encore_str_len(value: str) -> usize

pub fn lower(module: Module) -> LoweredModule {
    let directives = module.directives
    let module_name = module.name
    let functions = lower_directives(directives, Vec[LLVMFunction]::Empty)
    let safe_module_name = sanitize_symbol(module_name)
    let llvm_module = llvm_new(safe_module_name, functions)
    let ir = llvm_to_text(llvm_module)
    ret LoweredModule{module, ir}
}

pub fn emit_ir(module: Module) -> str {
    let lowered = lower(module)
    ret lowered.ir
}

fn str_len(value: str) -> usize {
    ret unsafe {
        encore_str_len(value)
    }
}

fn lower_directives(directives: Vec[Directive]<H>, acc: Vec[LLVMFunction]) -> Vec[LLVMFunction] {
    match directives {
        Cons(node) => {
            let current: Directive = node.head
            let rest: Vec[Directive] = node.tail
            let lowered: Vec[LLVMFunction] = lower_directive(current)
            let next_acc: Vec[LLVMFunction] = append(acc, lowered)
            ret lower_directives(rest, next_acc)
        }
        Empty => {
            ret acc
        }
    }
}

fn lower_directive(directive: Directive) -> Vec[LLVMFunction] {
    match directive {
        Import(import_data) => {
            ret Vec[LLVMFunction]::Empty
        }
        Struct(struct_data) => {
            ret Vec[LLVMFunction]::Empty
        }
        Enum(enum_data) => {
            ret Vec[LLVMFunction]::Empty
        }
        Function(function_data) => {
            ret singleton(lower_function(function_data))
        }
        Trait(trait_data) => {
            ret Vec[LLVMFunction]::Empty
        }
        Impl(impl_data) => {
            ret Vec[LLVMFunction]::Empty
        }
    }
}

fn lower_function(function: FnDirective) -> LLVMFunction {
    let function_name = function.name
    let function_ret_type = function.ret_type
    let function_params = function.params
    let function_blocks = function.blocks
    let is_extern = function.is_extern

    let fn_name = sanitize_symbol(function_name)
    let ret_type = lower_type(function_ret_type)
    let params = lower_params(function_params, Vec[LLVMParam]::Empty)

    if (is_extern) {
        ret llvm_declare_fn(fn_name, ret_type, params, Vec[LLVMBasicBlock]::Empty)
    }
    let blocks = lower_blocks(function_blocks, Vec[LLVMBasicBlock]::Empty)
    ret llvm_define_fn(fn_name, ret_type, params, blocks)
}

fn lower_params(params: Vec[Parameter]<H>, acc: Vec[LLVMParam]) -> Vec[LLVMParam] {
    match params {
        Cons(node) => {
            let current: Parameter = node.head
            let rest: Vec[Parameter] = node.tail
            let current_name: str = current.name
            let current_type: Type = current.typ
            let name: str = sanitize_symbol(current_name)
            let typ: LLVMType = lower_type(current_type)
            let lowered: LLVMParam = llvm_make_param(name, typ)
            let next_acc: Vec[LLVMParam] = append(acc, singleton(lowered))
            ret lower_params(rest, next_acc)
        }
        Empty => {
            ret acc
        }
    }
}

fn lower_blocks(blocks: Vec[Block]<H>, acc: Vec[LLVMBasicBlock]) -> Vec[LLVMBasicBlock] {
    match blocks {
        Cons(node) => {
            let current: Block = node.head
            let rest: Vec[Block] = node.tail
            let lowered: LLVMBasicBlock = lower_block(current)
            let next_acc: Vec[LLVMBasicBlock] = append(acc, singleton(lowered))
            ret lower_blocks(rest, next_acc)
        }
        Empty => {
            ret acc
        }
    }
}

fn lower_block(block: Block) -> LLVMBasicBlock {
    let raw_block_name = block.name
    let raw_instructions = block.instructions
    let raw_terminator = block.terminator
    let block_name = sanitize_symbol(raw_block_name)
    let instructions = lower_instructions(raw_instructions, Vec[LLVMInstruction]::Empty)
    let terminator = lower_terminator(raw_terminator)
    ret llvm_block(block_name, instructions, terminator)
}

fn lower_instructions(instructions: Vec[Instruction]<H>, acc: Vec[LLVMInstruction]) -> Vec[LLVMInstruction] {
    match instructions {
        Cons(node) => {
            let current: Instruction = node.head
            let rest: Vec[Instruction] = node.tail
            let lowered: Vec[LLVMInstruction] = lower_instruction(current)
            let next_acc: Vec[LLVMInstruction] = append(acc, lowered)
            ret lower_instructions(rest, next_acc)
        }
        Empty => {
            ret acc
        }
    }
}

fn lower_instruction(instruction: Instruction) -> Vec[LLVMInstruction] {
    match instruction {
        Comment(comment_data) => {
            ret Vec[LLVMInstruction]::Empty
        }
        Literal(literal_data) => {
            let out_var: Variable = literal_data.out
            let literal_value: str = literal_data.value
            let lowered: LLVMInstruction = lower_literal(out_var, literal_value)
            ret singleton(lowered)
        }
        Call(call_data) => {
            let out_var: Variable = call_data.out
            let callee_name: str = call_data.name
            let call_args: Vec[Variable]<H> = call_data.args
            let lowered: LLVMInstruction = lower_call(out_var, callee_name, call_args)
            ret singleton(lowered)
        }
        Store(store_data) => {
            let src_var: Variable = store_data.src
            let dst_var: Variable = store_data.dst
            let value: LLVMValue = lower_variable(src_var)
            let ptr: LLVMValue = lower_variable(dst_var)
            ret singleton(llvm_inst_store(value, ptr))
        }
        Load(load_data) => {
            let out_var: Variable = load_data.out
            let src_var: Variable = load_data.src
            let out: LLVMValue = lower_variable(out_var)
            let ptr: LLVMValue = lower_variable(src_var)
            ret singleton(llvm_inst_load(out, ptr))
        }
        GetField(getfield_data) => {
            let out_var: Variable = getfield_data.out
            let src_var: Variable = getfield_data.src
            let field_var: Variable = getfield_data.field
            let out_name: str = out_var.name
            let out_type: Type = out_var.typ

            let out_value: LLVMValue = lower_variable(out_var)
            let safe_out_name: str = sanitize_symbol(out_name)
            let ptr_name: str = safe_out_name + "_field_ptr"
            let out_llvm_type: LLVMType = lower_type(out_type)
            let ptr_llvm_type: LLVMType = ptr_type(out_llvm_type)
            let ptr_value: LLVMValue = reg(ptr_name, ptr_llvm_type)
            let gep: LLVMInstruction = lower_getfieldptr_with(ptr_value, src_var, field_var)
            let load: LLVMInstruction = llvm_inst_load(out_value, ptr_value)
            ret append(singleton(gep), singleton(load))
        }
        GetFieldPtr(getfieldptr_data) => {
            let out_var: Variable = getfieldptr_data.out
            let src_var: Variable = getfieldptr_data.src
            let field_var: Variable = getfieldptr_data.field
            let lowered: LLVMInstruction = lower_getfieldptr(out_var, src_var, field_var)
            ret singleton(lowered)
        }
        ConstructStruct(construct_data) => {
            let out_var: Variable = construct_data.out
            let struct_name: str = construct_data.name
            let raw_args: Vec[Variable]<H> = construct_data.args
            let out_type: Type = out_var.typ

            let out: LLVMValue = lower_variable(out_var)
            let args: Vec[LLVMValue] = lower_variables(raw_args, Vec[LLVMValue]::Empty)
            let safe_struct_name: str = sanitize_symbol(struct_name)
            let fn_name: str = "__ehir_construct_" + safe_struct_name
            let ret_type: LLVMType = lower_type(out_type)
            ret singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, fn_name, args))
        }
        GetPtr(getptr_data) => {
            let out_var: Variable = getptr_data.out
            let src_var: Variable = getptr_data.src
            let out_type: Type = out_var.typ

            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(out_type)
            let src_value: LLVMValue = lower_variable(src_var)
            let args: Vec[LLVMValue] = singleton(src_value)
            ret singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_getptr", args))
        }
        PtrCast(pcast_data) => {
            let out_var: Variable = pcast_data.out
            let src_var: Variable = pcast_data.src
            let target_type: Type = pcast_data.target_type

            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(target_type)
            let src_value: LLVMValue = lower_variable(src_var)
            let args: Vec[LLVMValue] = singleton(src_value)
            ret singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_pcast", args))
        }
        StackAlloc(salloc_data) => {
            let out_var: Variable = salloc_data.out
            let out_type: Type = out_var.typ
            let out: LLVMValue = lower_variable(out_var)
            let alloc_type: LLVMType = alloc_target_type(out_type)
            ret singleton(llvm_inst_alloca(out, alloc_type))
        }
        HeapAlloc(halloc_data) => {
            let out_var: Variable = halloc_data.out
            let out_type: Type = out_var.typ
            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(out_type)
            ret singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_halloc", Vec[LLVMValue]::Empty))
        }
        HeapFree(hfree_data) => {
            let src_var: Variable = hfree_data.src
            let src_value: LLVMValue = lower_variable(src_var)
            let args: Vec[LLVMValue] = singleton(src_value)
            let inst: LLVMInstruction = llvm_inst_call(Option[LLVMValue]::None, void_type(), "__ehir_hfree", args)
            ret singleton(inst)
        }
        Put(put_data) => {
            let out_var: Variable = put_data.out
            let src_var: Variable = put_data.src
            let out_type: Type = out_var.typ
            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(out_type)
            let src_value: LLVMValue = lower_variable(src_var)
            let args: Vec[LLVMValue] = singleton(src_value)
            ret singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_put", args))
        }
        Binary(binary_data) => {
            let out_var: Variable = binary_data.out
            let lhs_var: Variable = binary_data.lhs
            let rhs_var: Variable = binary_data.rhs
            let op: BinaryOpKind = binary_data.op
            let lowered: LLVMInstruction = lower_binary(out_var, lhs_var, rhs_var, op)
            ret singleton(lowered)
        }
        Phi(phi_data) => {
            let out_var: Variable = phi_data.out
            let out_type: Type = out_var.typ
            let pairs: Vec[PhiPair]<H> = phi_data.pairs
            let out: LLVMValue = lower_variable(out_var)
            let ret_type: LLVMType = lower_type(out_type)
            let args: Vec[LLVMValue] = lower_phi_values(pairs, Vec[LLVMValue]::Empty)
            ret singleton(llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, "__ehir_phi", args))
        }
    }
}

fn lower_literal(out_var: Variable, value: str) -> LLVMInstruction {
    let out = lower_variable(out_var)
    let out_type = out_var.typ
    let ret_type = lower_type(out_type)
    let fn_name = concat("__ehir_lit_", sanitize_symbol(value))
    ret llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, fn_name, Vec[LLVMValue]::Empty)
}

fn lower_call(out_var: Variable, callee_name: str, args: Vec[Variable]<H>) -> LLVMInstruction {
    let out = lower_variable(out_var)
    let out_type = out_var.typ
    let ret_type = lower_type(out_type)
    let callee = sanitize_symbol(callee_name)
    let lowered_args = lower_variables(args, Vec[LLVMValue]::Empty)
    ret llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, callee, lowered_args)
}

fn lower_getfieldptr(out_var: Variable, src_var: Variable, field_var: Variable) -> LLVMInstruction {
    let out_ptr = lower_variable(out_var)
    ret lower_getfieldptr_with(out_ptr, src_var, field_var)
}

fn lower_getfieldptr_with(out_ptr: LLVMValue, src_var: Variable, field_var: Variable) -> LLVMInstruction {
    let src_value = lower_variable(src_var)
    let src_type = src_var.typ
    let field_name = field_var.name
    let element_type = lower_pointee_type(src_type)
    let indices = field_indices(field_name)
    ret llvm_inst_gep(out_ptr, element_type, src_value, indices, true)
}

fn lower_binary(out_var: Variable, lhs_var: Variable, rhs_var: Variable, op: BinaryOpKind) -> LLVMInstruction {
    let out = lower_variable(out_var)
    let lhs = lower_variable(lhs_var)
    let rhs = lower_variable(rhs_var)

    match op {
        ADD => {
            ret llvm_inst_add(out, lhs, rhs)
        }
        SUB => {
            ret llvm_inst_sub(out, lhs, rhs)
        }
        _ => {
            let fn_name = concat("__ehir_bin_", binary_suffix(op))
            let out_type = out_var.typ
            let ret_type = lower_type(out_type)
            let args = append(singleton(lhs), singleton(rhs))
            ret llvm_inst_call(Option[LLVMValue]::Some(out), ret_type, fn_name, args)
        }
    }
}

fn lower_phi_values(pairs: Vec[PhiPair]<H>, acc: Vec[LLVMValue]) -> Vec[LLVMValue] {
    match pairs {
        Cons(node) => {
            let current: PhiPair = node.head
            let rest: Vec[PhiPair] = node.tail
            let current_value: Variable = current.value
            let value: LLVMValue = lower_variable(current_value)
            let next_acc: Vec[LLVMValue] = append(acc, singleton(value))
            ret lower_phi_values(rest, next_acc)
        }
        Empty => {
            ret acc
        }
    }
}

fn lower_terminator(terminator: Terminator) -> LLVMTerminator {
    match terminator {
        Ret(ret_data) => {
            let ret_value_var: Variable = ret_data.value
            let ret_value_type: Type = ret_value_var.typ
            let value: LLVMValue = lower_variable(ret_value_var)
            let ret_type: LLVMType = lower_type(ret_value_type)
            ret llvm_term_ret(Option[LLVMValue]::Some(value), ret_type)
        }
        Br(br_data) => {
            let label: str = br_data.label
            let safe_label: str = sanitize_symbol(label)
            ret llvm_term_br(safe_label)
        }
        Cbr(cbr_data) => {
            let cond_var: Variable = cbr_data.cond
            let true_label_raw: str = cbr_data.true_label
            let false_label_raw: str = cbr_data.false_label
            let cond: LLVMValue = lower_variable(cond_var)
            let true_label: str = sanitize_symbol(true_label_raw)
            let false_label: str = sanitize_symbol(false_label_raw)
            ret llvm_term_cbr(cond, true_label, false_label)
        }
        Match(match_data) => {
            let default_label: str = match_data.default_label
            let safe_default_label: str = sanitize_symbol(default_label)
            ret llvm_term_br(safe_default_label)
        }
        Switch(switch_data) => {
            let default_label: str = switch_data.default_label
            let safe_default_label: str = sanitize_symbol(default_label)
            ret llvm_term_br(safe_default_label)
        }
        Cfree(cfree_data) => {
            ret llvm_term_ret_void()
        }
    }
}

fn lower_variables(variables: Vec[Variable]<H>, acc: Vec[LLVMValue]) -> Vec[LLVMValue] {
    match variables {
        Cons(node) => {
            let current: Variable = node.head
            let rest: Vec[Variable] = node.tail
            let value: LLVMValue = lower_variable(current)
            let next_acc: Vec[LLVMValue] = append(acc, singleton(value))
            ret lower_variables(rest, next_acc)
        }
        Empty => {
            ret acc
        }
    }
}

fn lower_variable(var_data: Variable) -> LLVMValue {
    let var_name = var_data.name
    let var_type = var_data.typ
    let name = sanitize_symbol(var_name)
    let typ = lower_type(var_type)
    ret reg(name, typ)
}

fn lower_type(typ: Type) -> LLVMType {
    let raw_name = typ.name
    let base = lower_plain_type(raw_name)
    let pointer = typ.pointer
    match pointer {
        None => {
            ret base
        }
        Stack => {
            ret ptr_type(base)
        }
        Heap => {
            ret ptr_type(base)
        }
        Raw => {
            ret ptr_type(base)
        }
    }
}

fn lower_pointee_type(typ: Type) -> LLVMType {
    let pointer = typ.pointer
    let raw_name = typ.name
    match pointer {
        None => {
            ret lower_type(typ)
        }
        Stack => {
            ret lower_plain_type(raw_name)
        }
        Heap => {
            ret lower_plain_type(raw_name)
        }
        Raw => {
            ret lower_plain_type(raw_name)
        }
    }
}

fn alloc_target_type(typ: Type) -> LLVMType {
    let pointer = typ.pointer
    let raw_name = typ.name
    match pointer {
        None => {
            ret lower_type(typ)
        }
        Stack => {
            ret lower_plain_type(raw_name)
        }
        Heap => {
            ret lower_plain_type(raw_name)
        }
        Raw => {
            ret lower_plain_type(raw_name)
        }
    }
}

fn lower_plain_type(type_name: str) -> LLVMType {
    if (type_name == "void") { ret void_type() }
    if (type_name == "bool") { ret i1_type() }

    if (type_name == "u8") { ret i8_type() }
    if (type_name == "i8") { ret i8_type() }
    if (type_name == "u16") { ret i16_type() }
    if (type_name == "i16") { ret i16_type() }
    if (type_name == "u32") { ret i32_type() }
    if (type_name == "i32") { ret i32_type() }
    if (type_name == "u64") { ret i64_type() }
    if (type_name == "i64") { ret i64_type() }
    if (type_name == "usize") { ret i64_type() }
    if (type_name == "isize") { ret i64_type() }

    if (type_name == "f16") { ret f16_type() }
    if (type_name == "f32") { ret f32_type() }
    if (type_name == "f64") { ret f64_type() }

    if (type_name == "str") { ret named_struct_type("str") }
    ret named_struct_type(sanitize_symbol(type_name))
}

fn field_indices(field_name: str) -> Vec[LLVMValue] {
    let first = const_i32("0")
    let second = const_i32(field_index_text(field_name))
    ret append(singleton(first), singleton(second))
}

fn field_index_text(field_name: str) -> str {
    if (str_len(field_name) == 0_usize) {
        ret "0"
    }

    let first = field_name.byte_at(0_usize)
    if (is_digit(first)) {
        ret take_digits(field_name, 0_usize, "")
    }
    ret "0"
}

fn take_digits(text: str, index: usize, acc: str) -> str {
    if (index >= str_len(text)) {
        if (acc == "") {
            ret "0"
        }
        ret acc
    }

    let ch = text.byte_at(index)
    if (is_digit(ch)) {
        let piece = text.slice(index, 1_usize)
        ret take_digits(text, index + 1_usize, acc + piece)
    }

    if (acc == "") {
        ret "0"
    }
    ret acc
}

fn binary_suffix(op: BinaryOpKind) -> str {
    match op {
        ADD => { ret "add" }
        SUB => { ret "sub" }
        MUL => { ret "mul" }
        DIV => { ret "div" }
        AND => { ret "and" }
        OR => { ret "or" }
        IEQ => { ret "ieq" }
        NEQ => { ret "neq" }
        LES => { ret "les" }
        LEQ => { ret "leq" }
        GRT => { ret "grt" }
        GEQ => { ret "geq" }
    }
}

fn sanitize_symbol(value: str) -> str {
    ret sanitize_symbol_from(value, 0_usize, "")
}

fn sanitize_symbol_from(value: str, index: usize, acc: str) -> str {
    if (index >= str_len(value)) {
        if (acc == "") {
            ret "_"
        }
        ret acc
    }

    let ch = value.byte_at(index)
    let piece = if (is_symbol_char(ch)) {
        value.slice(index, 1_usize)
    } else {
        "_"
    }
    ret sanitize_symbol_from(value, index + 1_usize, acc + piece)
}

fn is_symbol_char(ch: u8) -> bool {
    if (ch == 95_u8) {
        ret true
    }
    if (ch >= 48_u8) {
        if (ch <= 57_u8) {
            ret true
        }
    }
    if (ch >= 65_u8) {
        if (ch <= 90_u8) {
            ret true
        }
    }
    if (ch >= 97_u8) {
        if (ch <= 122_u8) {
            ret true
        }
    }
    ret false
}

fn is_digit(ch: u8) -> bool {
    if (ch >= 48_u8) {
        if (ch <= 57_u8) {
            ret true
        }
    }
    ret false
}
