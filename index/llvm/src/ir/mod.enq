import core::option::Option
import std::vec::Vec
import std::vec::append
import std::vec::is_empty
import std::vec::head_or
import std::vec::tail_or
import std::vec::singleton
import std::os::write_file
import refrain::types::LLVMType
import refrain::types::type_text
import refrain::types::void_type
import refrain::types::i32_type
import refrain::value::LLVMValue
import refrain::value::value_text
import refrain::value::value_type
import refrain::value::const_text
import refrain::core::LLVMModule
import refrain::core::LLVMFunction
import refrain::core::LLVMParam
import refrain::core::LLVMBasicBlock
import refrain::core::LLVMInstruction
import refrain::core::LLVMTerminator
import refrain::core::llvm_store_instruction
import refrain::core::llvm_br_term
import refrain::core::llvm_basic_block
import refrain::core::llvm_param

pub fn emit_module_lines(module: LLVMModule) -> Vec[str] {
    let header = "; ModuleID = '" + module.name + "'"
    let with_header = append(single_line(header), single_line(""))
    ret append(with_header, emit_functions(module.functions, Vec[str]::Empty))
}

pub fn emit_module_text(module: LLVMModule) -> str {
    ret join_lines(emit_module_lines(module))
}

pub fn emit_module_to_file(module: LLVMModule, path: str) -> i32 {
    ret write_file(path, emit_module_text(module))
}

fn emit_functions(functions: Vec[LLVMFunction], acc: Vec[str]) -> Vec[str] {
    if (is_empty(functions)) {
        ret acc
    }

    let current = head_or(functions, default_function())
    let rest = tail_or(functions, Vec[LLVMFunction]::Empty)
    let with_fn = append(acc, emit_function_lines(current))
    ret emit_functions(rest, append(with_fn, single_line("")))
}

fn emit_function_lines(func: LLVMFunction) -> Vec[str] {
    if (func.is_extern) {
        ret single_line(render_function_signature(func, true))
    }

    let header = render_function_signature(func, false) + " {"
    let with_header = append(single_line(header), emit_blocks_lines(func.blocks, Vec[str]::Empty))
    ret append(with_header, single_line("}"))
}

fn emit_blocks_lines(blocks: Vec[LLVMBasicBlock], acc: Vec[str]) -> Vec[str] {
    if (is_empty(blocks)) {
        ret acc
    }

    let current = head_or(blocks, default_block())
    let rest = tail_or(blocks, Vec[LLVMBasicBlock]::Empty)
    ret emit_blocks_lines(rest, append(acc, emit_block_lines(current)))
}

fn emit_block_lines(block: LLVMBasicBlock) -> Vec[str] {
    let label = block.name + ":"
    let with_body = append(single_line(label), emit_instruction_lines(block.instructions, Vec[str]::Empty))
    ret append(with_body, single_line(render_terminator_line(block.terminator)))
}

fn emit_instruction_lines(instructions: Vec[LLVMInstruction], acc: Vec[str]) -> Vec[str] {
    if (is_empty(instructions)) {
        ret acc
    }

    let current = head_or(instructions, default_instruction())
    let rest = tail_or(instructions, Vec[LLVMInstruction]::Empty)
    ret emit_instruction_lines(rest, append(acc, single_line(render_instruction_line(current))))
}

fn single_line(line: str) -> Vec[str] {
    ret singleton(line)
}

fn render_function_signature(func: LLVMFunction, as_declare: bool) -> str {
    let prefix = signature_prefix(as_declare)
    let typed_prefix = prefix + type_text(func.ret_type)
    let with_name = typed_prefix + " @" + func.name
    let with_open = with_name + "("
    let with_params = with_open + render_params(func.params)
    ret with_params + ")"
}

fn signature_prefix(as_declare: bool) -> str {
    if (as_declare) {
        ret "declare "
    }
    ret "define "
}

fn render_params(params: Vec[LLVMParam]) -> str {
    ret render_params_acc(params, "", true)
}

fn render_params_acc(params: Vec[LLVMParam], acc: str, is_first: bool) -> str {
    if (is_empty(params)) {
        ret acc
    }

    let current = head_or(params, default_param())
    let rest = tail_or(params, Vec[LLVMParam]::Empty)
    let head = render_param(current)
    let next_acc = concat_with_sep(acc, head, is_first, ", ")
    ret render_params_acc(rest, next_acc, false)
}

fn render_param(param: LLVMParam) -> str {
    let typed = type_text(param.typ) + " %"
    ret typed + param.name
}

fn render_instruction_line(instr: LLVMInstruction) -> str {
    match instr {
        Add(add_data) => {
            ret render_binary_instruction("add", add_data.out, add_data.lhs, add_data.rhs)
        }
        Sub(sub_data) => {
            ret render_binary_instruction("sub", sub_data.out, sub_data.lhs, sub_data.rhs)
        }
        Call(call_data) => {
            ret render_call_instruction(call_data.out, call_data.ret_type, call_data.callee, call_data.args)
        }
        Alloca(alloca_data) => {
            let begin = "  " + value_text(alloca_data.out)
            let with_eq = begin + " = alloca "
            ret with_eq + type_text(alloca_data.alloc_type)
        }
        Load(load_data) => {
            let begin = "  " + value_text(load_data.out)
            let with_eq = begin + " = load "
            let typed_out = with_eq + type_text(value_type(load_data.out))
            let with_ptr_type = typed_out + ", " + type_text(value_type(load_data.ptr))
            let with_ptr_sep = with_ptr_type + " "
            ret with_ptr_sep + value_text(load_data.ptr)
        }
        Store(store_data) => {
            let begin = "  store " + type_text(value_type(store_data.value))
            let with_value = begin + " " + value_text(store_data.value)
            let with_ptr_type = with_value + ", " + type_text(value_type(store_data.ptr))
            let with_ptr_sep = with_ptr_type + " "
            ret with_ptr_sep + value_text(store_data.ptr)
        }
        Gep(gep_data) => {
            let begin = "  " + value_text(gep_data.out)
            let with_eq = begin + " = "
            let op = gep_op(gep_data.inbounds)

            let base = with_eq + op + type_text(gep_data.element_type)
            let with_ptr_type = base + ", " + type_text(value_type(gep_data.ptr))
            let with_ptr_value = with_ptr_type + " " + value_text(gep_data.ptr)
            let rendered_indices = render_typed_values(gep_data.indices)

            if (rendered_indices == "") {
                ret with_ptr_value
            }
            ret with_ptr_value + ", " + rendered_indices
        }
    }
}

fn gep_op(inbounds: bool) -> str {
    if (inbounds) {
        ret "getelementptr inbounds "
    }
    ret "getelementptr "
}

fn render_binary_instruction(op: str, out: LLVMValue, lhs: LLVMValue, rhs: LLVMValue) -> str {
    let begin = "  " + value_text(out)
    let with_eq = begin + " = "
    let with_op = with_eq + op
    let with_type = with_op + " " + type_text(out.typ)
    let with_lhs = with_type + " " + value_text(lhs)
    ret with_lhs + ", " + value_text(rhs)
}

fn render_call_instruction(
    out: Option[LLVMValue],
    ret_type: LLVMType,
    callee: str,
    args: Vec[LLVMValue]
) -> str {
    let with_ret = "call " + type_text(ret_type)
    let with_name = with_ret + " @" + callee
    let with_open = with_name + "("
    let with_args = with_open + render_typed_values(args)
    let call_expr = with_args + ")"

    match out {
        Some(var_out) => {
            let begin = "  " + value_text(var_out)
            ret begin + " = " + call_expr
        }
        None => {
            ret "  " + call_expr
        }
    }
}

fn render_typed_values(values: Vec[LLVMValue]) -> str {
    ret render_typed_values_acc(values, "", true)
}

fn render_typed_values_acc(values: Vec[LLVMValue], acc: str, is_first: bool) -> str {
    if (is_empty(values)) {
        ret acc
    }

    let current = head_or(values, default_value())
    let rest = tail_or(values, Vec[LLVMValue]::Empty)
    let typed = render_typed_value(current)
    let next_acc = concat_with_sep(acc, typed, is_first, ", ")
    ret render_typed_values_acc(rest, next_acc, false)
}

fn render_typed_value(value: LLVMValue) -> str {
    let with_type = type_text(value.typ) + " "
    ret with_type + value_text(value)
}

fn render_terminator_line(term: LLVMTerminator) -> str {
    match term {
        Ret(ret_data) => {
            ret render_ret_terminator(ret_data.value, ret_data.ret_type)
        }
        Br(br_data) => {
            ret "  br label %" + br_data.label
        }
        Cbr(cbr_data) => {
            let begin = "  br " + type_text(value_type(cbr_data.cond)) + " "
            let with_cond = begin + value_text(cbr_data.cond)
            let with_true = with_cond + ", label %" + cbr_data.true_label
            ret with_true + ", label %" + cbr_data.false_label
        }
    }
}

fn render_ret_terminator(value: Option[LLVMValue], ret_type: LLVMType) -> str {
    match value {
        Some(result) => {
            let begin = "  ret " + type_text(value_type(result))
            ret begin + " " + value_text(result)
        }
        None => {
            ret "  ret " + type_text(ret_type)
        }
    }
}

fn join_lines(lines: Vec[str]) -> str {
    ret join_lines_acc(lines, "", true)
}

fn join_lines_acc(lines: Vec[str], acc: str, is_first: bool) -> str {
    if (is_empty(lines)) {
        ret acc
    }

    let current = head_or(lines, "")
    let rest = tail_or(lines, Vec[str]::Empty)
    let next_acc = concat_with_sep(acc, current, is_first, "\n")
    ret join_lines_acc(rest, next_acc, false)
}

fn concat_with_sep(acc: str, piece: str, is_first: bool, sep: str) -> str {
    if (is_first) {
        ret acc + piece
    }
    ret acc + sep + piece
}

fn default_function() -> LLVMFunction {
    ret LLVMFunction{"", void_type(), Vec[LLVMParam]::Empty, Vec[LLVMBasicBlock]::Empty, true}
}

fn default_param() -> LLVMParam {
    ret llvm_param("", void_type())
}

fn default_value() -> LLVMValue {
    ret const_text("0", i32_type())
}

fn default_instruction() -> LLVMInstruction {
    let value = default_value()
    ret llvm_store_instruction(value, value)
}

fn default_block() -> LLVMBasicBlock {
    ret llvm_basic_block("", Vec[LLVMInstruction]::Empty, llvm_br_term(""))
}
