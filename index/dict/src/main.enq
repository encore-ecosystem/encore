import std::io::println
import std::option::Option
import std::vec::Vec
import std::ops::Eq

trait Hashable {
    fn hash(self: Self) -> u64
}

impl Hashable for str {
    fn hash(self: str) -> u64 {
        let mut h = 1469598103934665603_u64
        let prime = 1099511628211_u64
        for i in 0..self.len() {
            match self.get_byte(i) {
                Option::Some(b) => {
                    h = h ^ (b as u64)
                    h = h * prime
                }
                Option::None => {
                    break
                }
            }
        }
        ret h
    }
}

struct Dict[K, V] {
    buckets: Vec[Vec[(K, V)]]
    len: usize
}

impl[K: Hashable + Eq, V] for Dict[K, V] {
    pub fn new() -> Dict[K, V] {
        ret Dict[K, V]::with_capacity(16_usize)
    }

    pub fn with_capacity(capacity: usize) -> Dict[K, V] {
        let mut buckets = Vec[Vec[(K, V)]]::with_capacity(capacity)
        let mut i = 0_usize
        while i < capacity {
            buckets = buckets.push(Vec[(K, V)]::new())
            i = i + 1_usize
        }
        ret Dict[K, V] { buckets, 0_usize }
    }

    pub fn len(self: Dict[K, V]) -> usize {
        ret self.len
    }

    pub fn is_empty(self: Dict[K, V]) -> bool {
        ret self.len == 0_usize
    }

    pub fn capacity(self: Dict[K, V]) -> usize {
        ret self.buckets.len()
    }

    fn index_for(self: Dict[K, V], key: K) -> usize {
        let cap = self.capacity()
        if cap == 0_usize {
            ret 0_usize
        }
        ret (key.hash() as usize) % cap
    }

    fn find_in_bucket(self: Dict[K, V], bucket: Vec[(K, V)], key: K) -> Option[usize] {
        let mut i = 0_usize
        loop {
            match bucket.get(i) {
                Option::Some(entry) => {
                    if entry.0 == key {
                        ret Option[usize]::Some(i)
                    }
                    i = i + 1_usize
                }
                Option::None => {
                    ret Option[usize]::None
                }
            }
        }
    }

    pub fn get(self: Dict[K, V], key: K) -> Option[V] {
        let idx = self.index_for(key)
        let bucket_opt: Option[Vec[(K, V)]] = self.buckets.get(idx)
        match bucket_opt {
            Option::Some(bucket) => {
                let pos_opt: Option[usize] = self.find_in_bucket(bucket, key)
                match pos_opt {
                    Option::Some(pos) => {
                        let entry_opt: Option[(K, V)] = bucket.get(pos)
                        match entry_opt {
                            Option::Some(entry) => {
                                ret Option[V]::Some(entry.1)
                            }
                            Option::None => {
                                ret Option[V]::None
                            }
                        }
                    }
                    Option::None => {
                        ret Option[V]::None
                    }
                }
            }
            Option::None => {
                ret Option[V]::None
            }
        }
    }

    pub fn contains_key(self: Dict[K, V], key: K) -> bool {
        ret self.get(key).is_some()
    }

    pub fn insert(self: Dict[K, V], key: K, value: V) -> Dict[K, V] {
        let idx = self.index_for(key)
        let bucket_opt: Option[Vec[(K, V)]] = self.buckets.get(idx)
        match bucket_opt {
            Option::Some(bucket) => {
                let pos_opt: Option[usize] = self.find_in_bucket(bucket, key)
                match pos_opt {
                    Option::Some(pos) => {
                        let next_bucket = bucket.set(pos, (key, value))
                        let next_buckets = self.buckets.set(idx, next_bucket)
                        ret Dict[K, V] { next_buckets, self.len }
                    }
                    Option::None => {
                        let next_bucket = bucket.push((key, value))
                        let next_buckets = self.buckets.set(idx, next_bucket)
                        ret Dict[K, V] { next_buckets, self.len + 1_usize }
                    }
                }
            }
            Option::None => {
                ret self
            }
        }
    }

    pub fn remove(self: Dict[K, V], key: K) -> (Dict[K, V], Option[V]) {
        let idx = self.index_for(key)
        let bucket_opt: Option[Vec[(K, V)]] = self.buckets.get(idx)
        match bucket_opt {
            Option::Some(bucket) => {
                let pos_opt: Option[usize] = self.find_in_bucket(bucket, key)
                match pos_opt {
                    Option::Some(pos) => {
                        let mut out = Vec[(K, V)]::new()
                        let mut i = 0_usize
                        let mut removed = Option[V]::None
                        loop {
                            let entry_opt: Option[(K, V)] = bucket.get(i)
                            match entry_opt {
                                Option::Some(entry) => {
                                    if i == pos {
                                        removed = Option[V]::Some(entry.1)
                                    } else {
                                        out = out.push(entry)
                                    }
                                    i = i + 1_usize
                                }
                                Option::None => {
                                    break
                                }
                            }
                        }
                        let next_buckets = self.buckets.set(idx, out)
                        ret (Dict[K, V] { next_buckets, self.len - 1_usize }, removed)
                    }
                    Option::None => {
                        ret (self, Option[V]::None)
                    }
                }
            }
            Option::None => {
                ret (self, Option[V]::None)
            }
        }
    }
}

fn main() -> u32 {
    let mut dict = Dict[str, u32]::new()
    dict = dict.insert("alpha", 1_u32)
    dict = dict.insert("beta", 2_u32)
    dict = dict.insert("gamma", 3_u32)
    dict = dict.insert("alpha", 10_u32)

    if dict.len() != 3_usize {
        println("len check failed")
        ret 1_u32
    }

    match dict.get("alpha") {
        Option::Some(v) => {
            if v != 10_u32 {
                println("get(alpha) mismatch")
                ret 1_u32
            }
        }
        Option::None => {
            println("get(alpha) none")
            ret 1_u32
        }
    }

    let removed = dict.remove("beta")
    dict = removed.0
    if dict.contains_key("beta") {
        println("remove(beta) failed")
        ret 1_u32
    }

    println("hashmap example: ok")
    ret 0_u32
}
