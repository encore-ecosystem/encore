pub enum Poll[S, T] {
    Ready(T)
    Pending(S)
}

// Polling consumes the previous state. Pending owns the next state, while
// Ready owns only the output, so a completed future cannot be polled again.
pub trait Future[T] {
    fn poll(self: Self) -> Poll[Self, T]
}

pub struct Ready[T] {
    value: T
}

impl[T] Future[T] for Ready[T] {
    fn poll(self: Ready[T]) -> Poll[Ready[T], T] {
        ret Poll[Ready[T], T]::Ready(self.value)
    }
}

pub fn ready[T](value: T) -> Ready[T] {
    ret Ready[T]{value}
}
