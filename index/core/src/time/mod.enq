extern fn encore_clock_ms(kind: u8) -> u64
extern fn encore_sleep_ms(ms: u64) -> bool

pub fn time() -> u64 {
    ret time_ms()
}

pub fn time_ms() -> u64 {
    unsafe {
        ret encore_clock_ms(0_u8)
    }
}

pub fn perf_counter() -> u64 {
    ret perf_counter_ms()
}

pub fn sleep_ms(ms: u64) -> bool {
    unsafe {
        ret encore_sleep_ms(ms)
    }
}

pub fn perf_counter_ms() -> u64 {
    unsafe {
        ret encore_clock_ms(1_u8)
    }
}
