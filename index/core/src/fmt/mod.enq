pub trait Debug {
    fn fmt(self) -> str
}

extern fn __ehir_rt_fmt_bool(value: bool) -> str

extern fn __ehir_rt_fmt_u8(value: u8) -> str
extern fn __ehir_rt_fmt_u16(value: u16) -> str
extern fn __ehir_rt_fmt_u32(value: u32) -> str
extern fn __ehir_rt_fmt_u64(value: u64) -> str
extern fn __ehir_rt_fmt_usize(value: usize) -> str

extern fn __ehir_rt_fmt_i8(value: i8) -> str
extern fn __ehir_rt_fmt_i16(value: i16) -> str
extern fn __ehir_rt_fmt_i32(value: i32) -> str
extern fn __ehir_rt_fmt_i64(value: i64) -> str
extern fn __ehir_rt_fmt_isize(value: isize) -> str

extern fn __ehir_rt_fmt_f32(value: f32) -> str
extern fn __ehir_rt_fmt_f64(value: f64) -> str

impl Debug for str {
    pub fn fmt(self: str) -> str {
        ret self
    }
}

impl Debug for bool {
    pub fn fmt(self: bool) -> str {
        unsafe {
            ret __ehir_rt_fmt_bool(self)
        }
    }
}

impl Debug for u8 {
    pub fn fmt(self: u8) -> str {
        unsafe {
            ret __ehir_rt_fmt_u8(self)
        }
    }
}

impl Debug for u16 {
    pub fn fmt(self: u16) -> str {
        unsafe {
            ret __ehir_rt_fmt_u16(self)
        }
    }
}

impl Debug for u32 {
    pub fn fmt(self: u32) -> str {
        unsafe {
            ret __ehir_rt_fmt_u32(self)
        }
    }
}

impl Debug for u64 {
    pub fn fmt(self: u64) -> str {
        unsafe {
            ret __ehir_rt_fmt_u64(self)
        }
    }
}

impl Debug for usize {
    pub fn fmt(self: usize) -> str {
        unsafe {
            ret __ehir_rt_fmt_usize(self)
        }
    }
}

impl Debug for i8 {
    pub fn fmt(self: i8) -> str {
        unsafe {
            ret __ehir_rt_fmt_i8(self)
        }
    }
}

impl Debug for i16 {
    pub fn fmt(self: i16) -> str {
        unsafe {
            ret __ehir_rt_fmt_i16(self)
        }
    }
}

impl Debug for i32 {
    pub fn fmt(self: i32) -> str {
        unsafe {
            ret __ehir_rt_fmt_i32(self)
        }
    }
}

impl Debug for i64 {
    pub fn fmt(self: i64) -> str {
        unsafe {
            ret __ehir_rt_fmt_i64(self)
        }
    }
}

impl Debug for isize {
    pub fn fmt(self: isize) -> str {
        unsafe {
            ret __ehir_rt_fmt_isize(self)
        }
    }
}

impl Debug for f32 {
    pub fn fmt(self: f32) -> str {
        unsafe {
            ret __ehir_rt_fmt_f32(self)
        }
    }
}

impl Debug for f64 {
    pub fn fmt(self: f64) -> str {
        unsafe {
            ret __ehir_rt_fmt_f64(self)
        }
    }
}
