import core::fmt::Debug


pub enum ReflectSymbolKind {
    Function
    Struct
    Enum
    Variant
    Trait
    Impl
}

pub struct ReflectSymbolInfo {
    kind: ReflectSymbolKind
    name: str
    qualified_name: str
    is_public: bool
    owner_kind: str
    owner_name: str
    detail: str
}

pub struct ReflectModuleInfo {
    module_id: str
    import_count: usize
    struct_count: usize
    enum_count: usize
    trait_count: usize
    impl_count: usize
    function_count: usize
    imports: str
    structs: str
    enums: str
    traits: str
    impls: str
    functions: str
}

impl Debug for ReflectSymbolKind {
    pub fn fmt(self: ReflectSymbolKind) -> str {
        ret match self {
            Function => "function"
            Struct => "struct"
            Enum => "enum"
            Variant => "variant"
            Trait => "trait"
            Impl => "impl"
        }
    }
}

impl Debug for ReflectSymbolInfo {
    pub fn fmt(self: ReflectSymbolInfo) -> str {
        let mut out = "ReflectSymbolInfo{kind=" + Debug::fmt(self.kind)
        out = out + ", name=\"" + self.name + "\""
        out = out + ", qualified_name=\"" + self.qualified_name + "\""
        out = out + ", is_public=" + Debug::fmt(self.is_public)
        out = out + ", owner_kind=\"" + self.owner_kind + "\""
        out = out + ", owner_name=\"" + self.owner_name + "\""
        out = out + ", detail=\"" + self.detail + "\""
        ret out + "}"
    }
}

impl Debug for ReflectModuleInfo {
    pub fn fmt(self: ReflectModuleInfo) -> str {
        let mut out = "ReflectModuleInfo{module_id=\"" + self.module_id + "\""
        out = out + ", import_count=" + Debug::fmt(self.import_count)
        out = out + ", struct_count=" + Debug::fmt(self.struct_count)
        out = out + ", enum_count=" + Debug::fmt(self.enum_count)
        out = out + ", trait_count=" + Debug::fmt(self.trait_count)
        out = out + ", impl_count=" + Debug::fmt(self.impl_count)
        out = out + ", function_count=" + Debug::fmt(self.function_count)
        out = out + ", imports=\"" + self.imports + "\""
        out = out + ", structs=\"" + self.structs + "\""
        out = out + ", enums=\"" + self.enums + "\""
        out = out + ", traits=\"" + self.traits + "\""
        out = out + ", impls=\"" + self.impls + "\""
        out = out + ", functions=\"" + self.functions + "\""
        ret out + "}"
    }
}
