import core::option::Option
import core::vec::Vec
import color::{Color, black}
import geometry::{Insets, Rect, Size}
import refrain::layout::{FlexItem, align_center, align_end, flex_layout_directional, flex_wrap_layout, grid_layout_gaps, grid_layout_intrinsic_placed, horizontal, vertical}
import refrain::style::{GridPlacement, LayoutStyle, Style, text_center}
import refrain::svg::SvgDocument

pub fn widget_panel() -> usize { ret 0_usize }
pub fn widget_label() -> usize { ret 1_usize }
pub fn widget_button() -> usize { ret 2_usize }
pub fn widget_spacer() -> usize { ret 3_usize }
pub fn widget_input() -> usize { ret 4_usize }
pub fn widget_textarea() -> usize { ret 5_usize }
pub fn widget_checkbox() -> usize { ret 6_usize }
pub fn widget_radio() -> usize { ret 7_usize }
pub fn widget_switch() -> usize { ret 8_usize }
pub fn widget_select() -> usize { ret 9_usize }
pub fn widget_slider() -> usize { ret 10_usize }
pub fn widget_progress() -> usize { ret 11_usize }
pub fn widget_separator() -> usize { ret 12_usize }
pub fn widget_heading() -> usize { ret 13_usize }
pub fn widget_link() -> usize { ret 14_usize }
pub fn widget_color_picker() -> usize { ret 15_usize }
pub fn widget_color_swatch() -> usize { ret 16_usize }
pub fn widget_color_channel() -> usize { ret 17_usize }
pub fn widget_icon() -> usize { ret 18_usize }
pub fn widget_icon_button() -> usize { ret 19_usize }
pub fn widget_icon_card() -> usize { ret 20_usize }

pub struct TextSelection {
    start: usize
    end: usize
}

pub struct WidgetAttribute {
    name: str
    value: str
}

impl for WidgetAttribute {
    pub fn new(name: str, value: str) -> WidgetAttribute { ret WidgetAttribute { name, value } }
    pub fn name(self: Self) -> str { ret self.name }
    pub fn value(self: Self) -> str { ret self.value }
}

impl for TextSelection {
    pub fn caret(value: usize) -> TextSelection { ret TextSelection { value, value } }
    pub fn range(start: usize, end: usize, length: usize) -> TextSelection {
        let a = if start > length { length } else { start }
        let b = if end > length { length } else { end }
        ret if a < b { TextSelection { a, b } } else { TextSelection { b, a } }
    }
    pub fn start(self: Self) -> usize { ret self.start }
    pub fn end(self: Self) -> usize { ret self.end }
}

pub struct Widget {
    kind: usize
    id: str
    classes: str
    attributes: Vec[WidgetAttribute]
    text: str
    cursor: usize
    selection: TextSelection
    style: Style
    direction: usize
    basis: f32
    grow: f32
    checked: bool
    focused: bool
    disabled: bool
    value: f32
    children: Vec[Widget]
    svg: SvgDocument
}

impl for Widget {
    pub fn panel(id: str) -> Widget {
        ret widget_value(widget_panel(), id, "", Style::panel(), vertical(), 0.0_f32, 1.0_f32, false, 0.0_f32)
    }
    pub fn label(text: str) -> Widget {
        ret widget_value(widget_label(), "", text, Style::default(), horizontal(), 24.0_f32, 0.0_f32, false, 0.0_f32)
    }
    pub fn button(id: str, text: str) -> Widget {
        ret widget_value(widget_button(), id, text, Style::panel().with_overflow_hidden(true).with_text_align(text_center()), horizontal(), 36.0_f32, 0.0_f32, false, 0.0_f32)
    }
    pub fn spacer(grow: f32) -> Widget {
        ret widget_value(widget_spacer(), "", "", Style::default(), horizontal(), 0.0_f32, grow, false, 0.0_f32)
    }
    pub fn input(id: str, value: str) -> Widget {
        ret widget_value(widget_input(), id, value, control_style(), horizontal(), 38.0_f32, 0.0_f32, false, 0.0_f32).with_attribute("type", "text")
    }
    pub fn textarea(id: str, value: str) -> Widget {
        ret widget_value(widget_textarea(), id, value, control_style(), vertical(), 82.0_f32, 0.0_f32, false, 0.0_f32).with_attribute("type", "textarea")
    }
    pub fn checkbox(id: str, text: str, checked: bool) -> Widget {
        ret widget_value(widget_checkbox(), id, text, Style::default(), horizontal(), 32.0_f32, 0.0_f32, checked, 0.0_f32).with_attribute("type", "checkbox")
    }
    pub fn radio(id: str, text: str, checked: bool) -> Widget {
        ret widget_value(widget_radio(), id, text, Style::default(), horizontal(), 32.0_f32, 0.0_f32, checked, 0.0_f32).with_attribute("type", "radio")
    }
    pub fn toggle(id: str, text: str, checked: bool) -> Widget {
        ret widget_value(widget_switch(), id, text, Style::default(), horizontal(), 32.0_f32, 0.0_f32, checked, 0.0_f32)
    }
    pub fn select(id: str, value: str) -> Widget {
        ret widget_value(widget_select(), id, value, control_style(), horizontal(), 38.0_f32, 0.0_f32, false, 0.0_f32)
    }
    pub fn slider(id: str, value: f32) -> Widget {
        ret widget_value(widget_slider(), id, "", Style::default(), horizontal(), 32.0_f32, 0.0_f32, false, clamp_unit(value)).with_attribute("type", "range")
    }
    pub fn progress(value: f32) -> Widget {
        ret widget_value(widget_progress(), "", "", Style::default(), horizontal(), 18.0_f32, 0.0_f32, false, clamp_unit(value))
    }
    pub fn separator() -> Widget {
        ret widget_value(widget_separator(), "", "", Style::default(), horizontal(), 1.0_f32, 0.0_f32, false, 0.0_f32)
    }
    pub fn heading(text: str) -> Widget {
        ret widget_value(widget_heading(), "", text, Style::default().with_font_size(22.0_f32), horizontal(), 34.0_f32, 0.0_f32, false, 0.0_f32)
    }
    pub fn link(id: str, text: str) -> Widget {
        ret widget_value(widget_link(), id, text, Style::default(), horizontal(), 28.0_f32, 0.0_f32, false, 0.0_f32)
    }
    pub fn color_picker(id: str, text: str, color: Color) -> Widget {
        ret widget_value(widget_color_picker(), id, text,
            control_style().with_border(3.0_f32, color), horizontal(), 40.0_f32, 0.0_f32, false, 0.0_f32).with_attribute("type", "color")
    }
    pub fn color_swatch(id: str, color: Color, selected: bool) -> Widget {
        ret widget_value(widget_color_swatch(), id, "",
            Style::default().with_background(color).with_border(if selected { 3.0_f32 } else { 1.0_f32 },
                if selected { black() } else { color }), horizontal(), 32.0_f32, 0.0_f32, selected, 0.0_f32)
    }
    pub fn color_channel(id: str, color: Color, value: f32, channel: str) -> Widget {
        ret widget_value(widget_color_channel(), id, "", Style::default().with_background(color),
            horizontal(), 26.0_f32, 0.0_f32, channel == "alpha", clamp_unit(value))
            .with_attribute("type", "range").with_attribute("channel", channel)
    }
    pub fn icon(id: str, document: SvgDocument) -> Widget {
        ret widget_value(widget_icon(), id, "", Style::default(), horizontal(), 24.0_f32, 0.0_f32, false, 0.0_f32).with_svg(document)
    }
    pub fn icon_button(id: str, text: str, document: SvgDocument) -> Widget {
        ret widget_value(widget_icon_button(), id, text,
            Style::panel().with_overflow_hidden(true), horizontal(), 38.0_f32, 0.0_f32, false, 0.0_f32).with_svg(document)
    }
    pub fn icon_card(id: str, text: str, document: SvgDocument) -> Widget {
        ret widget_value(widget_icon_card(), id, text,
            Style::panel().with_overflow_hidden(true).with_text_align(text_center()), vertical(), 88.0_f32, 0.0_f32, false, 0.0_f32).with_svg(document)
    }
    pub fn with_style(self: Self, value: Style) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, value, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_direction(self: Self, value: usize) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, self.style, value, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_flex(self: Self, basis: f32, grow: f32) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, self.style, self.direction, basis, grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_focus(self: Self, value: bool) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, self.style, self.direction, self.basis, self.grow, self.checked, value, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_classes(self: Self, value: str) -> Widget {
        ret Widget { self.kind, self.id, value, self.attributes, self.text, self.cursor, self.selection, self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_attribute(self: Self, name: str, value: str) -> Widget {
        let mut attributes = self.attributes
        let mut index = 0_usize
        while index < attributes.len() {
            match attributes.get(index) {
                Option[WidgetAttribute]::Some(attribute) => {
                    if attribute.name() == name {
                        attributes.set(index, WidgetAttribute::new(name, value))
                        ret Widget { self.kind, self.id, self.classes, attributes, self.text, self.cursor, self.selection,
                            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
                    }
                }
                Option[WidgetAttribute]::None => {}
            }
            index = index + 1_usize
        }
        attributes.push(WidgetAttribute::new(name, value))
        ret Widget { self.kind, self.id, self.classes, attributes, self.text, self.cursor, self.selection,
            self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_children(self: Self, value: Vec[Widget]) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, self.style, self.direction, self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, value, self.svg }
    }
    pub fn with_disabled(self: Self, value: bool) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, self.style, self.direction, self.basis,
            self.grow, self.checked, self.focused, value, self.value, self.children, self.svg }
    }
    pub fn with_cursor(self: Self, value: usize) -> Widget {
        let cursor = if value > self.text.char_len() { self.text.char_len() } else { value }
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, cursor, TextSelection::caret(cursor), self.style, self.direction, self.basis,
            self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_selection(self: Self, start: usize, end: usize) -> Widget {
        let selection = TextSelection::range(start, end, self.text.char_len())
        let cursor = if end > self.text.char_len() { self.text.char_len() } else { end }
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, cursor, selection, self.style, self.direction,
            self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, self.svg }
    }
    pub fn with_svg(self: Self, value: SvgDocument) -> Widget {
        ret Widget { self.kind, self.id, self.classes, self.attributes, self.text, self.cursor, self.selection, self.style, self.direction,
            self.basis, self.grow, self.checked, self.focused, self.disabled, self.value, self.children, value }
    }
    pub fn push(self: mut Self, child: Widget) -> () { self.children.push(child) ret () }
    pub fn kind(self: Self) -> usize { ret self.kind }
    pub fn id(self: Self) -> str { ret self.id }
    pub fn classes(self: Self) -> str { ret self.classes }
    pub fn attribute(self: Self, name: str) -> Option[str] {
        let mut index = 0_usize
        while index < self.attributes.len() {
            match self.attributes.get(index) {
                Option[WidgetAttribute]::Some(attribute) => { if attribute.name() == name { ret Option[str]::Some(attribute.value()) } }
                Option[WidgetAttribute]::None => {}
            }
            index = index + 1_usize
        }
        ret Option[str]::None
    }
    pub fn text(self: Self) -> str { ret self.text }
    pub fn cursor(self: Self) -> usize { ret self.cursor }
    pub fn selection(self: Self) -> TextSelection { ret self.selection }
    pub fn style(self: Self) -> Style { ret self.style }
    pub fn direction(self: Self) -> usize { ret self.direction }
    pub fn basis(self: Self) -> f32 { ret self.basis }
    pub fn grow(self: Self) -> f32 { ret self.grow }
    pub fn checked(self: Self) -> bool { ret self.checked }
    pub fn focused(self: Self) -> bool { ret self.focused }
    pub fn disabled(self: Self) -> bool { ret self.disabled }
    pub fn value(self: Self) -> f32 { ret self.value }
    pub fn children(self: Self) -> Vec[Widget] { ret self.children }
    pub fn svg(self: Self) -> SvgDocument { ret self.svg }
    pub fn preferred_size(self: Self) -> Size {
        if self.kind == widget_label() { ret Size::new((self.text.len() as f32) * 8.0_f32, self.basis) }
        if self.kind == widget_button() { ret Size::new((self.text.len() as f32) * 8.0_f32 + 24.0_f32, self.basis) }
        ret Size::new(self.basis, self.basis)
    }
    pub fn min_content_size(self: Self) -> Size { ret intrinsic_widget_size(self, false) }
    pub fn max_content_size(self: Self) -> Size { ret intrinsic_widget_size(self, true) }
}

fn intrinsic_widget_size(widget: Widget, maximum: bool) -> Size {
    let children = widget.children()
    let style = widget.style()
    let padding = style.padding()
    let chrome_width = padding.left() + padding.right() + style.border_width() * 2.0_f32
    let chrome_height = padding.top() + padding.bottom() + style.border_width() * 2.0_f32
    if children.len() > 0_usize {
        let mut width = 0.0_f32
        let mut height = 0.0_f32
        let mut index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    let size = if maximum { child.max_content_size() } else { child.min_content_size() }
                    if widget.direction() == horizontal() {
                        width = width + size.width()
                        if size.height() > height { height = size.height() }
                    } else {
                        height = height + size.height()
                        if size.width() > width { width = size.width() }
                    }
                }
                Option[Widget]::None => {}
            }
            index = index + 1_usize
        }
        if children.len() > 1_usize {
            if widget.direction() == horizontal() { width = width + style.gap() * ((children.len() - 1_usize) as f32) }
            else { height = height + style.gap() * ((children.len() - 1_usize) as f32) }
        }
        ret Size::new(width + chrome_width, height + chrome_height)
    }
    if widget.text() != "" {
        let characters = if maximum { widget.text().char_len() } else { longest_text_word(widget.text()) }
        let width = (characters as f32) * style.font_size() * 0.56_f32
        ret Size::new(width + chrome_width, style.font_size() * 1.35_f32 + chrome_height)
    }
    let preferred = widget.preferred_size()
    ret Size::new(preferred.width() + chrome_width, preferred.height() + chrome_height)
}

fn longest_text_word(value: str) -> usize {
    let mut longest = 0_usize
    let mut current = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        let character = value.slice(index, 1_usize)
        if character == " " || character == "\t" || character == "\n" || character == "\r" {
            if current > longest { longest = current }
            current = 0_usize
        } else { current = current + 1_usize }
        index = index + 1_usize
    }
    ret if current > longest { current } else { longest }
}

fn widget_value(kind: usize, id: str, text: str, style: Style, direction: usize, basis: f32, grow: f32, checked: bool, value: f32) -> Widget {
    ret Widget { kind, id, "", Vec[WidgetAttribute]::new(), text, text.char_len(), TextSelection::caret(text.char_len()), style,
        direction, basis, grow, checked, false, false, value, Vec[Widget]::new(), SvgDocument::empty() }
}

fn control_style() -> Style {
    ret Style::panel().with_padding(Insets::symmetric(8.0_f32, 10.0_f32)).with_radius(4.0_f32).with_overflow_hidden(true)
}

fn clamp_unit(value: f32) -> f32 {
    if value < 0.0_f32 { ret 0.0_f32 }
    if value > 1.0_f32 { ret 1.0_f32 }
    ret value
}

pub struct WidgetLayout {
    widget: Widget
    bounds: Rect
    children: Vec[WidgetLayout]
}

impl for WidgetLayout {
    pub fn widget(self: Self) -> Widget { ret self.widget }
    pub fn bounds(self: Self) -> Rect { ret self.bounds }
    pub fn children(self: Self) -> Vec[WidgetLayout] { ret self.children }
    pub fn hit(self: Self, x: f32, y: f32) -> str {
        let inside = x >= self.bounds.x() && y >= self.bounds.y() &&
            x < self.bounds.right() && y < self.bounds.bottom()
        if self.widget.style().layout().overflow_hidden() && !inside { ret "" }
        let mut index = self.children.len()
        while index > 0_usize {
            index = index - 1_usize
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let found = child.hit(x, y)
                    if found != "" { ret found }
                }
                Option[WidgetLayout]::None => {}
            }
        }
        if inside {
            if self.widget.disabled() || !self.widget.style().visible() || !self.widget.style().pointer_events() { ret "" }
            ret self.widget.id()
        }
        ret ""
    }
    pub fn find_bounds(self: Self, id: str) -> Option[Rect] {
        if self.widget.id() == id { ret Option[Rect]::Some(self.bounds) }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    match child.find_bounds(id) {
                        Option[Rect]::Some(bounds) => { ret Option[Rect]::Some(bounds) }
                        Option[Rect]::None => {}
                    }
                }
                Option[WidgetLayout]::None => {}
            }
            index = index + 1_usize
        }
        ret Option[Rect]::None
    }
    pub fn find_widget(self: Self, id: str) -> Option[Widget] {
        if self.widget.id() == id { ret Option[Widget]::Some(self.widget) }
        let mut index = 0_usize
        while index < self.children.len() {
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    match child.find_widget(id) {
                        Option[Widget]::Some(widget) => { ret Option[Widget]::Some(widget) }
                        Option[Widget]::None => {}
                    }
                }
                Option[WidgetLayout]::None => {}
            }
            index = index + 1_usize
        }
        ret Option[Widget]::None
    }
}

pub fn layout_widget(widget: Widget, bounds: Rect) -> WidgetLayout {
    let content = bounds.inset(widget.style().padding())
    let scroll = widget.style().layout().scroll()
    let scrolled_content = Rect::new(content.x() - scroll.x(), content.y() - scroll.y(), content.width(), content.height())
    let widget_flex = widget.style().layout().flex()
    let direction = if widget_flex.direction_set() { widget_flex.direction() } else { widget.direction() }
    let all_children = widget.children()
    let mut children = Vec[Widget]::new()
    let mut positioned = Vec[Widget]::new()
    let mut child_index = 0_usize
    while child_index < all_children.len() {
        match all_children.get(child_index) {
            Option[Widget]::Some(child) => {
                if child.style().layout().flex().displayed() {
                    if child.style().layout().position().absolute() { positioned.push(child) }
                    else { children.push(child) }
                }
            }
            Option[Widget]::None => {}
        }
        child_index = child_index + 1_usize
    }
    children = ordered_widgets(children)
    let mut flex_items = Vec[FlexItem]::new()
    let mut cross_extents = Vec[f32]::new()
    let mut grid_placements = Vec[GridPlacement]::new()
    let mut grid_minimum_content = Vec[Size]::new()
    let mut grid_maximum_content = Vec[Size]::new()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                let layout = child.style().layout()
                let flex = layout.flex()
                let margin = layout.margin()
                let horizontal_parent = direction == horizontal()
                let explicit = if horizontal_parent { resolved_width(child, scrolled_content.width()) }
                    else { resolved_height(child, scrolled_content.height()) }
                let minimum = if horizontal_parent { resolved_min_width(child) } else { resolved_min_height(child) }
                let maximum = if horizontal_parent { resolved_max_width(child) } else { resolved_max_height(child) }
                let margin_size = if horizontal_parent { margin.left() + margin.right() } else { margin.top() + margin.bottom() }
                let default_basis = if flex.basis() >= 0.0_f32 { flex.basis() } else { child.basis() }
                let basis = (if explicit >= 0.0_f32 { explicit } else { default_basis }) + margin_size
                let grow = if flex.grow() >= 0.0_f32 { flex.grow() } else { child.grow() }
                let shrink = if flex.shrink() >= 0.0_f32 { flex.shrink() } else { 1.0_f32 }
                flex_items.push(FlexItem::sized(basis, grow, shrink, minimum + margin_size, maximum + margin_size))
                let cross_explicit = if horizontal_parent { resolved_height(child, scrolled_content.height()) }
                    else { resolved_width(child, scrolled_content.width()) }
                let cross_default = if horizontal_parent { child.preferred_size().height() } else { child.preferred_size().width() }
                let cross_margin = if horizontal_parent { margin.top() + margin.bottom() } else { margin.left() + margin.right() }
                cross_extents.push((if cross_explicit >= 0.0_f32 { cross_explicit } else { cross_default }) + cross_margin)
                grid_placements.push(layout.grid_placement())
                grid_minimum_content.push(child.min_content_size())
                grid_maximum_content.push(child.max_content_size())
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    let row_gap = if widget_flex.row_gap() >= 0.0_f32 { widget_flex.row_gap() } else { widget.style().gap() }
    let column_gap = if widget_flex.column_gap() >= 0.0_f32 { widget_flex.column_gap() } else { widget.style().gap() }
    let main_gap = if direction == horizontal() { column_gap } else { row_gap }
    let cross_gap = if direction == horizontal() { row_gap } else { column_gap }
    let rects = if widget_flex.grid() {
        if widget_flex.column_template() != "" || widget_flex.auto_column_template() != "" ||
            widget_flex.auto_row_template() != "" || has_grid_placement(grid_placements) {
            grid_layout_intrinsic_placed(scrolled_content, widget_flex.column_template(), widget_flex.row_template(),
                widget_flex.auto_column_template(), widget_flex.auto_row_template(), row_gap, column_gap, grid_placements,
                grid_minimum_content, grid_maximum_content, widget_flex.auto_flow_column(), widget_flex.auto_flow_dense())
        } else { grid_layout_gaps(scrolled_content, widget_flex.columns(), row_gap, column_gap, children.len()) }
    } elif widget_flex.wrap() {
        flex_wrap_layout(scrolled_content, direction, main_gap, cross_gap, widget_flex.justify(), flex_items,
            cross_extents, widget_flex.direction_reverse(), widget_flex.wrap_reverse(), widget_flex.align_content())
    } else { flex_layout_directional(scrolled_content, direction, main_gap, widget_flex.justify(), flex_items, widget_flex.direction_reverse()) }
    let mut layouts = Vec[WidgetLayout]::new()
    index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                match rects.get(index) {
                    Option[Rect]::Some(rect) => {
                        let self_align = child.style().layout().flex().self_align()
                        let effective_align = if self_align >= 0_i32 { self_align as usize } else { widget_flex.align() }
                        let child_bounds = if widget_flex.grid() { styled_grid_rect(child, rect, effective_align) }
                            else { styled_child_rect(child, rect, direction, effective_align) }
                        layouts.push(layout_widget(child, child_bounds))
                    }
                    Option[Rect]::None => {}
                }
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    index = 0_usize
    while index < positioned.len() {
        match positioned.get(index) {
            Option[Widget]::Some(child) => { layouts.push(layout_widget(child, absolute_child_rect(child, scrolled_content))) }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    layouts = stacked_layouts(layouts)
    ret WidgetLayout { widget, bounds, layouts }
}

fn has_grid_placement(values: Vec[GridPlacement]) -> bool {
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[GridPlacement]::Some(value) => {
                if value.column() > 0_usize || value.row() > 0_usize || value.column_span() > 1_usize || value.row_span() > 1_usize { ret true }
            }
            Option[GridPlacement]::None => {}
        }
        index = index + 1_usize
    }
    ret false
}

fn stacked_layouts(source: Vec[WidgetLayout]) -> Vec[WidgetLayout] {
    let mut result = Vec[WidgetLayout]::new()
    let mut used = Vec[bool]::new()
    let mut index = 0_usize
    while index < source.len() { used.push(false) index = index + 1_usize }
    while result.len() < source.len() {
        let mut best = source.len()
        let mut best_z = 2147483647_i32
        index = 0_usize
        while index < source.len() {
            match used.get(index) {
                Option[bool]::Some(is_used) => {
                    if !is_used {
                        match source.get(index) {
                            Option[WidgetLayout]::Some(layout) => {
                                let z = layout.widget().style().layout().position().z_index()
                                if best == source.len() || z < best_z { best = index best_z = z }
                            }
                            Option[WidgetLayout]::None => {}
                        }
                    }
                }
                Option[bool]::None => {}
            }
            index = index + 1_usize
        }
        if best == source.len() { break }
        match source.get(best) {
            Option[WidgetLayout]::Some(layout) => { result.push(layout) used.set(best, true) }
            Option[WidgetLayout]::None => { break }
        }
    }
    ret result
}

fn ordered_widgets(source: Vec[Widget]) -> Vec[Widget] {
    let mut result = Vec[Widget]::new()
    let mut used = Vec[bool]::new()
    let mut index = 0_usize
    while index < source.len() { used.push(false) index = index + 1_usize }
    while result.len() < source.len() {
        let mut best = source.len()
        let mut best_order = 2147483647_i32
        index = 0_usize
        while index < source.len() {
            match used.get(index) {
                Option[bool]::Some(is_used) => {
                    if !is_used {
                        match source.get(index) {
                            Option[Widget]::Some(widget) => {
                                let order = widget.style().layout().flex().order()
                                if best == source.len() || order < best_order { best = index best_order = order }
                            }
                            Option[Widget]::None => {}
                        }
                    }
                }
                Option[bool]::None => {}
            }
            index = index + 1_usize
        }
        if best == source.len() { break }
        match source.get(best) {
            Option[Widget]::Some(widget) => { result.push(widget) used.set(best, true) }
            Option[Widget]::None => { break }
        }
    }
    ret result
}

pub fn inherit_widget_styles(root: Widget) -> Widget {
    ret inherit_widget_node(root, Option[Style]::None)
}

fn inherit_widget_node(widget: Widget, parent: Option[Style]) -> Widget {
    let styled = match parent {
        Option[Style]::Some(parent_style) => { widget.with_style(widget.style().inherit_text(parent_style)) }
        Option[Style]::None => { widget }
    }
    let source = styled.children()
    let mut children = Vec[Widget]::new()
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[Widget]::Some(child) => {
                children.push(inherit_widget_node(child, Option[Style]::Some(styled.style())))
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret styled.with_children(children)
}

fn absolute_child_rect(widget: Widget, containing: Rect) -> Rect {
    let layout = widget.style().layout()
    let position = layout.position()
    let margin = layout.margin()
    let available_width = containing.width() - margin.left() - margin.right()
    let available_height = containing.height() - margin.top() - margin.bottom()
    let explicit_width = resolved_width(widget, available_width)
    let explicit_height = resolved_height(widget, available_height)
    let automatic_width = if position.left_set() && position.right_set() {
        available_width - position.left() - position.right()
    } else { widget.preferred_size().width() }
    let automatic_height = if position.top_set() && position.bottom_set() {
        available_height - position.top() - position.bottom()
    } else { widget.basis() }
    let width = clamp_dimension(if explicit_width >= 0.0_f32 { explicit_width } else { automatic_width },
        resolved_min_width(widget), resolved_max_width(widget), available_width)
    let height = clamp_dimension(if explicit_height >= 0.0_f32 { explicit_height } else { automatic_height },
        resolved_min_height(widget), resolved_max_height(widget), available_height)
    let x = if position.left_set() { containing.x() + position.left() + margin.left() }
        elif position.right_set() { containing.right() - position.right() - margin.right() - width }
        else { containing.x() + margin.left() }
    let y = if position.top_set() { containing.y() + position.top() + margin.top() }
        elif position.bottom_set() { containing.bottom() - position.bottom() - margin.bottom() - height }
        else { containing.y() + margin.top() }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn styled_child_rect(widget: Widget, allocated: Rect, parent_direction: usize, align: usize) -> Rect {
    let layout = widget.style().layout()
    let inner = allocated.inset(layout.margin())
    let explicit_width = if parent_direction == horizontal() { -1.0_f32 } else { resolved_width(widget, inner.width()) }
    let explicit_height = if parent_direction == vertical() { -1.0_f32 } else { resolved_height(widget, inner.height()) }
    let requested_width = if explicit_width >= 0.0_f32 { explicit_width } else { inner.width() }
    let requested_height = if explicit_height >= 0.0_f32 { explicit_height } else { inner.height() }
    let width = clamp_dimension(requested_width, resolved_min_width(widget), resolved_max_width(widget), inner.width())
    let height = clamp_dimension(requested_height, resolved_min_height(widget), resolved_max_height(widget), inner.height())
    let x = if parent_direction == vertical() && align == align_center() { inner.x() + (inner.width() - width) / 2.0_f32 }
        elif parent_direction == vertical() && align == align_end() { inner.right() - width }
        else { inner.x() }
    let y = if parent_direction == horizontal() && align == align_center() { inner.y() + (inner.height() - height) / 2.0_f32 }
        elif parent_direction == horizontal() && align == align_end() { inner.bottom() - height }
        else { inner.y() }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn relative_child_rect(widget: Widget, bounds: Rect) -> Rect {
    let position = widget.style().layout().position()
    if !position.relative() { ret bounds }
    let x = bounds.x() + if position.left_set() { position.left() }
        elif position.right_set() { -position.right() } else { 0.0_f32 }
    let y = bounds.y() + if position.top_set() { position.top() }
        elif position.bottom_set() { -position.bottom() } else { 0.0_f32 }
    ret Rect::new(x, y, bounds.width(), bounds.height())
}

fn styled_grid_rect(widget: Widget, allocated: Rect, align: usize) -> Rect {
    let layout = widget.style().layout()
    let inner = allocated.inset(layout.margin())
    let explicit_width = resolved_width(widget, inner.width())
    let explicit_height = resolved_height(widget, inner.height())
    let width = clamp_dimension(if explicit_width >= 0.0_f32 { explicit_width } else { inner.width() },
        resolved_min_width(widget), resolved_max_width(widget), inner.width())
    let height = clamp_dimension(if explicit_height >= 0.0_f32 { explicit_height } else { inner.height() },
        resolved_min_height(widget), resolved_max_height(widget), inner.height())
    let x = if align == align_center() { inner.x() + (inner.width() - width) / 2.0_f32 }
        elif align == align_end() { inner.right() - width } else { inner.x() }
    let y = if align == align_center() { inner.y() + (inner.height() - height) / 2.0_f32 }
        elif align == align_end() { inner.bottom() - height } else { inner.y() }
    ret relative_child_rect(widget, Rect::new(x, y, width, height))
}

fn resolved_width(widget: Widget, available: f32) -> f32 {
    let layout = widget.style().layout()
    let value = if layout.relative().width() >= 0.0_f32 { available * layout.relative().width() } else { layout.width() }
    ret if value >= 0.0_f32 && layout.content_box() { value + box_width_extra(widget) } else { value }
}

fn resolved_height(widget: Widget, available: f32) -> f32 {
    let layout = widget.style().layout()
    let value = if layout.relative().height() >= 0.0_f32 { available * layout.relative().height() } else { layout.height() }
    ret if value >= 0.0_f32 && layout.content_box() { value + box_height_extra(widget) } else { value }
}

fn box_width_extra(widget: Widget) -> f32 {
    let style = widget.style()
    ret style.padding().left() + style.padding().right() + style.border_width() * 2.0_f32
}

fn box_height_extra(widget: Widget) -> f32 {
    let style = widget.style()
    ret style.padding().top() + style.padding().bottom() + style.border_width() * 2.0_f32
}

fn resolved_min_width(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() { box_width_extra(widget) } else { 0.0_f32 }
    ret widget.style().layout().min_width() + extra
}
fn resolved_min_height(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() { box_height_extra(widget) } else { 0.0_f32 }
    ret widget.style().layout().min_height() + extra
}
fn resolved_max_width(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() { box_width_extra(widget) } else { 0.0_f32 }
    ret widget.style().layout().max_width() + extra
}
fn resolved_max_height(widget: Widget) -> f32 {
    let extra = if widget.style().layout().content_box() { box_height_extra(widget) } else { 0.0_f32 }
    ret widget.style().layout().max_height() + extra
}

fn clamp_dimension(value: f32, minimum: f32, maximum: f32, available: f32) -> f32 {
    let mut result = value
    if result < minimum { result = minimum }
    if result > maximum { result = maximum }
    if result > available { result = available }
    if result < 0.0_f32 { ret 0.0_f32 }
    ret result
}
