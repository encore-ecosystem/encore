import core::option::Option
import core::vec::Vec
import geometry::{Rect, Size}
import refrain::layout::{FlexItem, flex_layout, horizontal, vertical}
import refrain::style::Style

pub fn widget_panel() -> usize { ret 0_usize }
pub fn widget_label() -> usize { ret 1_usize }
pub fn widget_button() -> usize { ret 2_usize }
pub fn widget_spacer() -> usize { ret 3_usize }

pub struct Widget {
    kind: usize
    id: str
    text: str
    style: Style
    direction: usize
    basis: f32
    grow: f32
    children: Vec[Widget]
}

impl for Widget {
    pub fn panel(id: str) -> Widget {
        ret Widget { widget_panel(), id, "", Style::panel(), vertical(), 0.0_f32, 1.0_f32, Vec[Widget]::new() }
    }
    pub fn label(text: str) -> Widget {
        ret Widget { widget_label(), "", text, Style::default(), horizontal(), 24.0_f32, 0.0_f32, Vec[Widget]::new() }
    }
    pub fn button(id: str, text: str) -> Widget {
        ret Widget { widget_button(), id, text, Style::panel(), horizontal(), 34.0_f32, 0.0_f32, Vec[Widget]::new() }
    }
    pub fn spacer(grow: f32) -> Widget {
        ret Widget { widget_spacer(), "", "", Style::default(), horizontal(), 0.0_f32, grow, Vec[Widget]::new() }
    }
    pub fn with_style(self: Self, value: Style) -> Widget {
        ret Widget { self.kind, self.id, self.text, value, self.direction, self.basis, self.grow, self.children }
    }
    pub fn with_direction(self: Self, value: usize) -> Widget {
        ret Widget { self.kind, self.id, self.text, self.style, value, self.basis, self.grow, self.children }
    }
    pub fn with_flex(self: Self, basis: f32, grow: f32) -> Widget {
        ret Widget { self.kind, self.id, self.text, self.style, self.direction, basis, grow, self.children }
    }
    pub fn push(self: mut Self, child: Widget) -> () { self.children.push(child) ret () }
    pub fn kind(self: Self) -> usize { ret self.kind }
    pub fn id(self: Self) -> str { ret self.id }
    pub fn text(self: Self) -> str { ret self.text }
    pub fn style(self: Self) -> Style { ret self.style }
    pub fn direction(self: Self) -> usize { ret self.direction }
    pub fn basis(self: Self) -> f32 { ret self.basis }
    pub fn grow(self: Self) -> f32 { ret self.grow }
    pub fn children(self: Self) -> Vec[Widget] { ret self.children }
    pub fn preferred_size(self: Self) -> Size {
        if self.kind == widget_label() { ret Size::new((self.text.len() as f32) * 8.0_f32, self.basis) }
        if self.kind == widget_button() { ret Size::new((self.text.len() as f32) * 8.0_f32 + 24.0_f32, self.basis) }
        ret Size::new(self.basis, self.basis)
    }
}

pub struct WidgetLayout {
    widget: Widget
    bounds: Rect
    children: Vec[WidgetLayout]
}

impl for WidgetLayout {
    pub fn widget(self: Self) -> Widget { ret self.widget }
    pub fn bounds(self: Self) -> Rect { ret self.bounds }
    pub fn children(self: Self) -> Vec[WidgetLayout] { ret self.children }
    pub fn hit(self: Self, x: f32, y: f32) -> str {
        let mut index = self.children.len()
        while index > 0_usize {
            index = index - 1_usize
            match self.children.get(index) {
                Option[WidgetLayout]::Some(child) => {
                    let found = child.hit(x, y)
                    if found != "" { ret found }
                }
                Option[WidgetLayout]::None => {}
            }
        }
        if x >= self.bounds.x() && y >= self.bounds.y() &&
            x < self.bounds.right() && y < self.bounds.bottom() {
            ret self.widget.id()
        }
        ret ""
    }
}

pub fn layout_widget(widget: Widget, bounds: Rect) -> WidgetLayout {
    let content = bounds.inset(widget.style().padding())
    let children = widget.children()
    let mut flex_items = Vec[FlexItem]::new()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => { flex_items.push(FlexItem::constrained(child.basis(), child.grow(), 0.0_f32, 1000000.0_f32)) }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    let rects = flex_layout(content, widget.direction(), widget.style().gap(), flex_items)
    let mut layouts = Vec[WidgetLayout]::new()
    index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                match rects.get(index) {
                    Option[Rect]::Some(rect) => { layouts.push(layout_widget(child, rect)) }
                    Option[Rect]::None => {}
                }
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret WidgetLayout { widget, bounds, layouts }
}
