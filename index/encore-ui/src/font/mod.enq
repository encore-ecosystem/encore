import core::option::Option
import core::os::{file_exists, read_dir}
import core::vec::Vec
import refrain::application::{Window, backend_error}

pub struct FontFace {
    family: str
    path: str
    bundled: bool
}

impl for FontFace {
    pub fn new(family: str, path: str) -> FontFace { ret FontFace { family, path, false } }
    pub fn bundled(family: str, path: str) -> FontFace { ret FontFace { family, path, true } }
    pub fn family(self: Self) -> str { ret self.family }
    pub fn path(self: Self) -> str { ret self.path }
    pub fn is_bundled(self: Self) -> bool { ret self.bundled }
}

pub struct FontManager {
    faces: Vec[FontFace]
    default_family: str
    active_family: str
    active_size: f32
    active_weight: u32
    error: str
}

impl for FontManager {
    pub fn new() -> FontManager {
        ret FontManager { Vec[FontFace]::new(), "Built-in bitmap", "Built-in bitmap", 8.0_f32, 400_u32, "" }
    }

    pub fn with_bundled(root: str) -> FontManager {
        let mut manager = FontManager::new()
        manager.register_bundled("Open Sans", root + "/OpenSans/OpenSans-VariableFont_wdth,wght.ttf")
        manager.register_bundled("Inter", root + "/Inter/Inter-VariableFont_opsz,wght.ttf")
        manager.register_bundled("Roboto", root + "/Roboto/Roboto-VariableFont_wdth,wght.ttf")
        manager.register_bundled("Roboto Mono", root + "/RobotoMono/RobotoMono-VariableFont_wght.ttf")
        manager.default_family = "Open Sans"
        ret manager
    }

    pub fn register(self: mut Self, family: str, path: str) -> bool {
        if family == "" || path == "" || !file_exists(path) { ret false }
        self.faces.push(FontFace::new(family, path))
        ret true
    }

    pub fn register_bundled(self: mut Self, family: str, path: str) -> bool {
        if family == "" || path == "" || !file_exists(path) { ret false }
        self.faces.push(FontFace::bundled(family, path))
        ret true
    }

    pub fn load_directory(self: mut Self, path: str) -> usize {
        let entries = read_dir(path)
        let mut loaded = 0_usize
        let mut index = 0_usize
        while index < entries.len() {
            match entries.get(index) {
                Option[str]::Some(name) => {
                    if is_font_file(name) {
                        if self.register(name, path + "/" + name) { loaded = loaded + 1_usize }
                    }
                }
                Option[str]::None => {}
            }
            index = index + 1_usize
        }
        ret loaded
    }

    #cfg(feature = "fonts")
    pub fn register_all(self: Self, window: Window) -> usize {
        let mut registered = 0_usize
        let mut index = 0_usize
        while index < self.faces.len() {
            match self.faces.get(index) {
                Option[FontFace]::Some(face) => {
                    if window.register_font(face.family(), face.path()) { registered = registered + 1_usize }
                }
                Option[FontFace]::None => {}
            }
            index = index + 1_usize
        }
        ret registered
    }

    #cfg(feature = "fonts")
    pub fn activate(self: Self, window: Window, family: str, size: f32, weight: u32) -> FontManager {
        if family == "Built-in bitmap" {
            window.clear_font()
            ret FontManager { self.faces, self.default_family, family, 8.0_f32, 400_u32, "" }
        }
        match self.find(family) {
            Option[FontFace]::Some(face) => {
                window.register_font(face.family(), face.path())
                if window.select_font(face.family(), size, normalized_weight(weight)) {
                    ret FontManager { self.faces, self.default_family, family, size, normalized_weight(weight), "" }
                }
            }
            Option[FontFace]::None => {
                ret FontManager { self.faces, self.default_family, self.active_family,
                    self.active_size, self.active_weight, "Unknown font family: " + family }
            }
        }
        ret FontManager { self.faces, self.default_family, self.active_family,
            self.active_size, self.active_weight, backend_error() }
    }

    #cfg(feature = "fonts")
    pub fn activate_default(self: Self, window: Window, size: f32, weight: u32) -> FontManager {
        ret self.activate(window, self.default_family, size, weight)
    }

    pub fn find(self: Self, family: str) -> Option[FontFace] {
        let mut index = 0_usize
        while index < self.faces.len() {
            match self.faces.get(index) {
                Option[FontFace]::Some(face) => {
                    if face.family() == family { ret Option[FontFace]::Some(face) }
                }
                Option[FontFace]::None => {}
            }
            index = index + 1_usize
        }
        ret Option[FontFace]::None
    }

    pub fn faces(self: Self) -> Vec[FontFace] { ret self.faces }
    pub fn default_family(self: Self) -> str { ret self.default_family }
    pub fn active_family(self: Self) -> str { ret self.active_family }
    pub fn active_size(self: Self) -> f32 { ret self.active_size }
    pub fn active_weight(self: Self) -> u32 { ret self.active_weight }
    pub fn error(self: Self) -> str { ret self.error }
}

fn normalized_weight(weight: u32) -> u32 {
    if weight < 150_u32 { ret 100_u32 }
    if weight < 250_u32 { ret 200_u32 }
    if weight < 350_u32 { ret 300_u32 }
    if weight < 450_u32 { ret 400_u32 }
    if weight < 550_u32 { ret 500_u32 }
    if weight < 650_u32 { ret 600_u32 }
    if weight < 750_u32 { ret 700_u32 }
    if weight < 850_u32 { ret 800_u32 }
    ret 900_u32
}

fn weight_name(weight: u32) -> str {
    let value = normalized_weight(weight)
    if value == 100_u32 { ret "Thin" }
    if value == 200_u32 { ret "ExtraLight" }
    if value == 300_u32 { ret "Light" }
    if value == 400_u32 { ret "Regular" }
    if value == 500_u32 { ret "Medium" }
    if value == 600_u32 { ret "SemiBold" }
    if value == 700_u32 { ret "Bold" }
    if value == 800_u32 { ret "ExtraBold" }
    ret "Black"
}

fn face_path_for_weight(face: FontFace, weight: u32) -> str {
    if !face.is_bundled() { ret face.path() }
    if face.family() == "Open Sans" {
        let normalized = normalized_weight(weight)
        let name = if normalized < 300_u32 { "Light" } elif normalized > 800_u32 { "ExtraBold" } else { weight_name(weight) }
        ret parent_path(face.path()) + "/static/OpenSans-" + name + ".ttf"
    }
    if face.family() == "Inter" {
        let name = weight_name(weight)
        ret parent_path(face.path()) + "/static/Inter_18pt-" + name + ".ttf"
    }
    if face.family() == "Roboto" {
        let name = weight_name(weight)
        ret parent_path(face.path()) + "/static/Roboto-" + name + ".ttf"
    }
    ret face.path()
}

fn parent_path(path: str) -> str {
    let mut index = path.char_len()
    while index > 0_usize {
        index = index - 1_usize
        let current = path.slice(index, 1_usize)
        if current == "/" || current == "\\" { ret path.slice(0_usize, index) }
    }
    ret "."
}

fn is_font_file(name: str) -> bool {
    let extension = file_extension(name)
    if extension == "ttf" { ret true }
    if extension == "otf" { ret true }
    if extension == "ttc" { ret true }
    if extension == "woff" { ret true }
    if extension == "woff2" { ret true }
    ret false
}

fn file_extension(name: str) -> str {
    let mut index = name.char_len()
    while index > 0_usize {
        index = index - 1_usize
        let current = name.slice(index, 1_usize)
        if current == "." { ret name.slice(index + 1_usize, name.char_len() - index - 1_usize) }
        if current == "/" || current == "\\" { ret "" }
    }
    ret ""
}
