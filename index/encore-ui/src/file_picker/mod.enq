import core::option::Option
import core::os::{file_exists, home_dir, is_directory, mkdir, read_dir}
import core::vec::Vec
import color::Color
import geometry::Insets
import refrain::interaction::TextEditor
import refrain::layout::{horizontal, vertical}
import refrain::style::Style
import refrain::svg::SvgDocument
import refrain::widget::Widget

pub struct FilePickerEntry { name: str path: str directory: bool }
pub struct FilePickerIcons { folder: SvgDocument file: SvgDocument home: SvgDocument up: SvgDocument refresh: SvgDocument add: SvgDocument hidden: SvgDocument }
pub struct FilePicker {
    directory: str
    entries: Vec[FilePickerEntry]
    selected: str
    path_editor: TextEditor
    folder_editor: TextEditor
    focus: str
    show_hidden: bool
    creating_folder: bool
    error: str
    scroll: f32
}

impl for FilePickerEntry {
    pub fn name(self: Self) -> str { ret self.name }
    pub fn path(self: Self) -> str { ret self.path }
    pub fn directory(self: Self) -> bool { ret self.directory }
}

impl for FilePickerIcons {
    pub fn new(folder: SvgDocument, file: SvgDocument, home: SvgDocument, up: SvgDocument,
        refresh: SvgDocument, add: SvgDocument, hidden: SvgDocument) -> FilePickerIcons {
        ret FilePickerIcons { folder, file, home, up, refresh, add, hidden }
    }
}

fn join_path(base: str, name: str) -> str {
    if base == "/" { ret "/" + name }
    if base.char_len() > 0_usize && (base.slice(base.char_len() - 1_usize, 1_usize) == "/" || base.slice(base.char_len() - 1_usize, 1_usize) == "\\") { ret base + name }
    ret base + "/" + name
}

fn parent_path(path: str) -> str {
    let mut end = path.char_len()
    while end > 1_usize && (path.slice(end - 1_usize, 1_usize) == "/" || path.slice(end - 1_usize, 1_usize) == "\\") { end = end - 1_usize }
    let mut index = end
    while index > 0_usize {
        let token = path.slice(index - 1_usize, 1_usize)
        if token == "/" || token == "\\" { ret if index == 1_usize { path.slice(0_usize, 1_usize) } else { path.slice(0_usize, index - 1_usize) } }
        index = index - 1_usize
    }
    ret path
}

fn hidden_name(name: str) -> bool { ret name.char_len() > 0_usize && name.slice(0_usize, 1_usize) == "." }

fn load_entries(directory: str, show_hidden: bool) -> Vec[FilePickerEntry] {
    let mut directories = Vec[FilePickerEntry]::new()
    let mut files = Vec[FilePickerEntry]::new()
    for name in read_dir(directory) {
        if name != "." && name != ".." && (show_hidden || !hidden_name(name)) {
            let path = join_path(directory, name)
            let entry = FilePickerEntry { name, path, is_directory(path) }
            if entry.directory { directories.push(entry) } else { files.push(entry) }
        }
    }
    directories.extend(files)
    ret directories
}

impl for FilePicker {
    pub fn new(directory: str) -> FilePicker {
        let initial = if is_directory(directory) { directory } else { home_dir() }
        ret FilePicker { initial, load_entries(initial, false), "", TextEditor::new(initial), TextEditor::new(""),
            "path", false, false, "", 0.0_f32 }
    }
    pub fn directory(self: Self) -> str { ret self.directory }
    pub fn selected(self: Self) -> str { ret self.selected }
    pub fn error(self: Self) -> str { ret self.error }
    pub fn entries(self: Self) -> Vec[FilePickerEntry] { ret self.entries }
    pub fn focus(self: Self) -> str { ret self.focus }
    pub fn creating_folder(self: Self) -> bool { ret self.creating_folder }
    pub fn navigate(self: Self, directory: str) -> FilePicker {
        if !is_directory(directory) { ret FilePicker { self.directory, self.entries, self.selected, self.path_editor,
            self.folder_editor, self.focus, self.show_hidden, self.creating_folder, "Directory does not exist", self.scroll } }
        ret FilePicker { directory, load_entries(directory, self.show_hidden), "", TextEditor::new(directory), self.folder_editor,
            "path", self.show_hidden, false, "", 0.0_f32 }
    }
    pub fn refresh(self: Self) -> FilePicker { ret self.navigate(self.directory) }
    pub fn click(self: Self, target: str) -> FilePicker {
        if target == "file-picker-home" { ret self.navigate(home_dir()) }
        if target == "file-picker-up" { ret self.navigate(parent_path(self.directory)) }
        if target == "file-picker-refresh" { ret self.refresh() }
        if target == "file-picker-hidden" {
            ret FilePicker { self.directory, load_entries(self.directory, !self.show_hidden), "", self.path_editor,
                self.folder_editor, self.focus, !self.show_hidden, self.creating_folder, "", 0.0_f32 }
        }
        if target == "file-picker-new-folder" {
            ret FilePicker { self.directory, self.entries, self.selected, self.path_editor, TextEditor::new("New Folder"),
                "folder", self.show_hidden, true, "", self.scroll }
        }
        if target == "file-picker-path" { ret FilePicker { self.directory, self.entries, self.selected, self.path_editor,
            self.folder_editor, "path", self.show_hidden, self.creating_folder, self.error, self.scroll } }
        if target == "file-picker-folder-name" { ret FilePicker { self.directory, self.entries, self.selected, self.path_editor,
            self.folder_editor, "folder", self.show_hidden, self.creating_folder, self.error, self.scroll } }
        let mut index = 0_usize
        while index < self.entries.len() {
            if target == "file-picker-entry-" + index.fmt() {
                match self.entries.get(index) {
                    Option::Some(entry) => { ret if entry.directory { self.navigate(entry.path) } else {
                        FilePicker { self.directory, self.entries, entry.path, self.path_editor, self.folder_editor,
                            self.focus, self.show_hidden, self.creating_folder, "", self.scroll }
                    } }
                    Option::None => {}
                }
            }
            index = index + 1_usize
        }
        ret self
    }
    pub fn confirm_path(self: Self) -> FilePicker { ret self.navigate(self.path_editor.value()) }
    pub fn create_folder(self: Self) -> FilePicker {
        let name = self.folder_editor.value()
        if name == "" || name.contains("/") || name.contains("\\") { ret FilePicker { self.directory, self.entries, self.selected,
            self.path_editor, self.folder_editor, self.focus, self.show_hidden, true, "Invalid folder name", self.scroll } }
        let path = join_path(self.directory, name)
        if file_exists(path) || mkdir(path) != 0_i32 { ret FilePicker { self.directory, self.entries, self.selected,
            self.path_editor, self.folder_editor, self.focus, self.show_hidden, true, "Unable to create folder", self.scroll } }
        ret self.navigate(path)
    }
    pub fn input(self: Self, value: str) -> FilePicker {
        ret if self.focus == "folder" { FilePicker { self.directory, self.entries, self.selected, self.path_editor,
            self.folder_editor.insert(value), self.focus, self.show_hidden, self.creating_folder, "", self.scroll } } else {
            FilePicker { self.directory, self.entries, self.selected, self.path_editor.insert(value), self.folder_editor,
                self.focus, self.show_hidden, self.creating_folder, "", self.scroll }
        }
    }
    pub fn backspace(self: Self) -> FilePicker {
        ret if self.focus == "folder" { FilePicker { self.directory, self.entries, self.selected, self.path_editor,
            self.folder_editor.backspace(), self.focus, self.show_hidden, self.creating_folder, self.error, self.scroll } } else {
            FilePicker { self.directory, self.entries, self.selected, self.path_editor.backspace(), self.folder_editor,
                self.focus, self.show_hidden, self.creating_folder, self.error, self.scroll }
        }
    }
    pub fn scroll_by(self: Self, amount: f32) -> FilePicker {
        let next = self.scroll + amount
        ret FilePicker { self.directory, self.entries, self.selected, self.path_editor, self.folder_editor, self.focus,
            self.show_hidden, self.creating_folder, self.error, if next < 0.0_f32 { 0.0_f32 } else { next } }
    }
    pub fn view(self: Self, icons: FilePickerIcons) -> Widget {
        let mut root = Widget::panel("file-picker").with_direction(vertical()).with_style(
            Style::default().with_background(Color::rgb(22_u8, 23_u8, 27_u8)).with_padding(Insets::all(8.0_f32)).with_gap(6.0_f32))
        let mut tools = Widget::panel("file-picker-tools").with_direction(horizontal()).with_flex(34.0_f32, 0.0_f32).with_style(Style::default().with_gap(4.0_f32))
        tools.push(Widget::icon_button("file-picker-home", "", icons.home).with_flex(34.0_f32, 0.0_f32))
        tools.push(Widget::icon_button("file-picker-up", "", icons.up).with_flex(34.0_f32, 0.0_f32))
        tools.push(Widget::input("file-picker-path", self.path_editor.value()).with_flex(0.0_f32, 1.0_f32).with_focus(self.focus == "path"))
        tools.push(Widget::icon_button("file-picker-refresh", "", icons.refresh).with_flex(34.0_f32, 0.0_f32))
        tools.push(Widget::icon_button("file-picker-hidden", "", icons.hidden).with_flex(34.0_f32, 0.0_f32).with_style(
            Style::default().with_background(if self.show_hidden { Color::rgb(35_u8, 102_u8, 142_u8) } else { Color::rgb(31_u8, 32_u8, 36_u8) })))
        tools.push(Widget::icon_button("file-picker-new-folder", "", icons.add).with_flex(34.0_f32, 0.0_f32))
        root.push(tools)
        if self.creating_folder {
            let mut create = Widget::panel("file-picker-create-row").with_direction(horizontal()).with_flex(34.0_f32, 0.0_f32).with_style(Style::default().with_gap(5.0_f32))
            create.push(Widget::input("file-picker-folder-name", self.folder_editor.value()).with_flex(0.0_f32, 1.0_f32).with_focus(self.focus == "folder"))
            create.push(Widget::button("file-picker-create-folder", "Create").with_flex(80.0_f32, 0.0_f32))
            root.push(create)
        }
        let mut list = Widget::panel("file-picker-list").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_background(Color::rgb(16_u8, 17_u8, 20_u8)).with_border(1.0_f32, Color::rgb(49_u8, 51_u8, 57_u8))
                .with_radius(3.0_f32).with_padding(Insets::all(4.0_f32)).with_gap(2.0_f32).with_overflow_hidden(true).with_scroll(0.0_f32, self.scroll))
        let mut index = 0_usize
        while index < self.entries.len() {
            match self.entries.get(index) {
                Option::Some(entry) => {
                    list.push(Widget::icon_button("file-picker-entry-" + index.fmt(), entry.name,
                        if entry.directory { icons.folder } else { icons.file }).with_flex(30.0_f32, 0.0_f32))
                }
                Option::None => {}
            }
            index = index + 1_usize
        }
        root.push(list)
        root.push(Widget::label(self.error).with_flex(20.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(220_u8, 102_u8, 94_u8)).with_font_size(10.0_f32)))
        ret root
    }
}
