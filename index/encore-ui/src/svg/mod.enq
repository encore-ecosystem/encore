import core::vec::Vec

pub struct SvgPoint { x: f32 y: f32 }

impl for SvgPoint {
    pub fn new(x: f32, y: f32) -> SvgPoint { ret SvgPoint { x, y } }
    pub fn x(self: Self) -> f32 { ret self.x }
    pub fn y(self: Self) -> f32 { ret self.y }
}

pub struct SvgLine { start: SvgPoint finish: SvgPoint }

impl for SvgLine {
    pub fn new(x0: f32, y0: f32, x1: f32, y1: f32) -> SvgLine {
        ret SvgLine { SvgPoint::new(x0, y0), SvgPoint::new(x1, y1) }
    }
    pub fn start(self: Self) -> SvgPoint { ret self.start }
    pub fn finish(self: Self) -> SvgPoint { ret self.finish }
}

pub struct SvgDocument {
    width: f32
    height: f32
    lines: Vec[SvgLine]
    valid: bool
}

impl for SvgDocument {
    pub fn empty() -> SvgDocument { ret SvgDocument { 24.0_f32, 24.0_f32, Vec[SvgLine]::new(), false } }
    pub fn parse(source: str) -> SvgDocument { ret parse_svg(source) }
    pub fn width(self: Self) -> f32 { ret self.width }
    pub fn height(self: Self) -> f32 { ret self.height }
    pub fn lines(self: Self) -> Vec[SvgLine] { ret self.lines }
    pub fn valid(self: Self) -> bool { ret self.valid }
}

struct SvgNumber { value: f32 next: usize valid: bool }

fn number(value: f32, next: usize, valid: bool) -> SvgNumber { ret SvgNumber { value, next, valid } }

fn parse_svg(source: str) -> SvgDocument {
    if source == "" { ret SvgDocument::empty() }
    let root = first_tag(source, "svg")
    if root == "" { ret SvgDocument::empty() }
    let view_box = attribute(root, "viewBox")
    let dimensions = numbers(view_box)
    let width = if dimensions.len() >= 4_usize { number_at(dimensions, 2_usize, 24.0_f32) } else { 24.0_f32 }
    let height = if dimensions.len() >= 4_usize { number_at(dimensions, 3_usize, 24.0_f32) } else { 24.0_f32 }
    let mut lines = Vec[SvgLine]::new()
    let mut cursor = 0_usize
    while cursor < source.char_len() {
        let opening = find_from(source, "<", cursor)
        if opening >= source.char_len() { break }
        let closing = find_from(source, ">", opening + 1_usize)
        if closing >= source.char_len() { break }
        let tag = source.slice(opening + 1_usize, closing - opening - 1_usize)
        if starts_tag(tag, "path") { append_path(lines, attribute(tag, "d")) }
        elif starts_tag(tag, "line") { append_line_tag(lines, tag) }
        elif starts_tag(tag, "polyline") { append_points(lines, attribute(tag, "points"), false) }
        elif starts_tag(tag, "polygon") { append_points(lines, attribute(tag, "points"), true) }
        elif starts_tag(tag, "circle") { append_ellipse(lines, value_attr(tag, "cx"), value_attr(tag, "cy"), value_attr(tag, "r"), value_attr(tag, "r")) }
        elif starts_tag(tag, "ellipse") { append_ellipse(lines, value_attr(tag, "cx"), value_attr(tag, "cy"), value_attr(tag, "rx"), value_attr(tag, "ry")) }
        elif starts_tag(tag, "rect") { append_rect(lines, tag) }
        cursor = closing + 1_usize
    }
    ret SvgDocument { if width > 0.0_f32 { width } else { 24.0_f32 }, if height > 0.0_f32 { height } else { 24.0_f32 }, lines, true }
}

fn append_line_tag(lines: mut Vec[SvgLine], tag: str) -> () {
    lines.push(SvgLine::new(value_attr(tag, "x1"), value_attr(tag, "y1"), value_attr(tag, "x2"), value_attr(tag, "y2")))
    ret ()
}

fn append_rect(lines: mut Vec[SvgLine], tag: str) -> () {
    let x = value_attr(tag, "x")
    let y = value_attr(tag, "y")
    let width = value_attr(tag, "width")
    let height = value_attr(tag, "height")
    let radius = value_attr(tag, "rx")
    if radius <= 0.0_f32 {
        lines.push(SvgLine::new(x, y, x + width, y))
        lines.push(SvgLine::new(x + width, y, x + width, y + height))
        lines.push(SvgLine::new(x + width, y + height, x, y + height))
        lines.push(SvgLine::new(x, y + height, x, y))
        ret ()
    }
    let r = if radius * 2.0_f32 > width || radius * 2.0_f32 > height {
        (if width < height { width } else { height }) / 2.0_f32
    } else { radius }
    lines.push(SvgLine::new(x + r, y, x + width - r, y))
    append_quadratic(lines, SvgPoint::new(x + width - r, y), SvgPoint::new(x + width, y), SvgPoint::new(x + width, y + r))
    lines.push(SvgLine::new(x + width, y + r, x + width, y + height - r))
    append_quadratic(lines, SvgPoint::new(x + width, y + height - r), SvgPoint::new(x + width, y + height), SvgPoint::new(x + width - r, y + height))
    lines.push(SvgLine::new(x + width - r, y + height, x + r, y + height))
    append_quadratic(lines, SvgPoint::new(x + r, y + height), SvgPoint::new(x, y + height), SvgPoint::new(x, y + height - r))
    lines.push(SvgLine::new(x, y + height - r, x, y + r))
    append_quadratic(lines, SvgPoint::new(x, y + r), SvgPoint::new(x, y), SvgPoint::new(x + r, y))
    ret ()
}

fn append_ellipse(lines: mut Vec[SvgLine], cx: f32, cy: f32, rx: f32, ry: f32) -> () {
    if rx <= 0.0_f32 || ry <= 0.0_f32 { ret () }
    let segments = 48_usize
    let mut previous = SvgPoint::new(cx + rx, cy)
    let mut index = 1_usize
    while index <= segments {
        let angle = 6.2831853_f32 * (index as f32) / (segments as f32)
        let current = SvgPoint::new(cx + rx * cosine(angle), cy + ry * sine(angle))
        lines.push(SvgLine { previous, current })
        previous = current
        index = index + 1_usize
    }
    ret ()
}

fn append_points(lines: mut Vec[SvgLine], source: str, close: bool) -> () {
    let values = numbers(source)
    if values.len() < 4_usize { ret () }
    let first = SvgPoint::new(number_at(values, 0_usize, 0.0_f32), number_at(values, 1_usize, 0.0_f32))
    let mut previous = first
    let mut index = 2_usize
    while index + 1_usize < values.len() {
        let current = SvgPoint::new(number_at(values, index, 0.0_f32), number_at(values, index + 1_usize, 0.0_f32))
        lines.push(SvgLine { previous, current })
        previous = current
        index = index + 2_usize
    }
    if close { lines.push(SvgLine { previous, first }) }
    ret ()
}

fn append_path(lines: mut Vec[SvgLine], source: str) -> () {
    let mut index = 0_usize
    let mut command = ""
    let mut current = SvgPoint::new(0.0_f32, 0.0_f32)
    let mut start = SvgPoint::new(0.0_f32, 0.0_f32)
    let mut control = SvgPoint::new(0.0_f32, 0.0_f32)
    let mut previous_command = ""
    let mut move_pair = true
    while index < source.char_len() {
        index = skip_separators(source, index)
        if index >= source.char_len() { break }
        let token = source.slice(index, 1_usize)
        if is_command(token) {
            command = token
            index = index + 1_usize
            move_pair = true
            if token == "Z" || token == "z" {
                lines.push(SvgLine { current, start })
                current = start
                previous_command = command
                continue
            }
        }
        if command == "" { break }
        let relative = is_lower(command)
        if command == "M" || command == "m" || command == "L" || command == "l" {
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let point = relative_point(current, x.value, y.value, relative)
            if command == "M" || command == "m" {
                if move_pair {
                    current = point
                    start = point
                    move_pair = false
                } else {
                    lines.push(SvgLine { current, point })
                    current = point
                }
            } else {
                lines.push(SvgLine { current, point })
                current = point
            }
            control = current
        }
        elif command == "H" || command == "h" {
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let point = SvgPoint::new(if relative { current.x + x.value } else { x.value }, current.y)
            lines.push(SvgLine { current, point })
            current = point
            control = current
        }
        elif command == "V" || command == "v" {
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let point = SvgPoint::new(current.x, if relative { current.y + y.value } else { y.value })
            lines.push(SvgLine { current, point })
            current = point
            control = current
        }
        elif command == "C" || command == "c" {
            let x1 = next_number(source, index) if !x1.valid { break } index = x1.next
            let y1 = next_number(source, index) if !y1.valid { break } index = y1.next
            let x2 = next_number(source, index) if !x2.valid { break } index = x2.next
            let y2 = next_number(source, index) if !y2.valid { break } index = y2.next
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let first = relative_point(current, x1.value, y1.value, relative)
            let second = relative_point(current, x2.value, y2.value, relative)
            let finish = relative_point(current, x.value, y.value, relative)
            append_cubic(lines, current, first, second, finish)
            current = finish
            control = second
        }
        elif command == "S" || command == "s" {
            let x2 = next_number(source, index) if !x2.valid { break } index = x2.next
            let y2 = next_number(source, index) if !y2.valid { break } index = y2.next
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let first = if previous_command == "C" || previous_command == "c" || previous_command == "S" || previous_command == "s" {
                SvgPoint::new(current.x * 2.0_f32 - control.x, current.y * 2.0_f32 - control.y)
            } else { current }
            let second = relative_point(current, x2.value, y2.value, relative)
            let finish = relative_point(current, x.value, y.value, relative)
            append_cubic(lines, current, first, second, finish)
            current = finish
            control = second
        }
        elif command == "Q" || command == "q" {
            let x1 = next_number(source, index) if !x1.valid { break } index = x1.next
            let y1 = next_number(source, index) if !y1.valid { break } index = y1.next
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let first = relative_point(current, x1.value, y1.value, relative)
            let finish = relative_point(current, x.value, y.value, relative)
            append_quadratic(lines, current, first, finish)
            current = finish
            control = first
        }
        elif command == "T" || command == "t" {
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let first = if previous_command == "Q" || previous_command == "q" || previous_command == "T" || previous_command == "t" {
                SvgPoint::new(current.x * 2.0_f32 - control.x, current.y * 2.0_f32 - control.y)
            } else { current }
            let finish = relative_point(current, x.value, y.value, relative)
            append_quadratic(lines, current, first, finish)
            current = finish
            control = first
        }
        elif command == "A" || command == "a" {
            let rx = next_number(source, index) if !rx.valid { break } index = rx.next
            let ry = next_number(source, index) if !ry.valid { break } index = ry.next
            let rotation = next_number(source, index) if !rotation.valid { break } index = rotation.next
            let large = next_number(source, index) if !large.valid { break } index = large.next
            let sweep = next_number(source, index) if !sweep.valid { break } index = sweep.next
            let x = next_number(source, index) if !x.valid { break } index = x.next
            let y = next_number(source, index) if !y.valid { break } index = y.next
            let finish = relative_point(current, x.value, y.value, relative)
            append_arc(lines, current, absolute(rx.value), absolute(ry.value), rotation.value, large.value != 0.0_f32, sweep.value != 0.0_f32, finish)
            current = finish
            control = current
        } else { break }
        previous_command = command
    }
    ret ()
}

fn append_cubic(lines: mut Vec[SvgLine], start: SvgPoint, first: SvgPoint, second: SvgPoint, finish: SvgPoint) -> () {
    flatten_cubic(lines, start, first, second, finish, 0_usize)
    ret ()
}

// Adaptive de Casteljau subdivision, ported from NanoVG's nvg__tesselateBezier.
fn flatten_cubic(lines: mut Vec[SvgLine], start: SvgPoint, first: SvgPoint, second: SvgPoint,
    finish: SvgPoint, level: usize) -> () {
    if level > 10_usize { lines.push(SvgLine { start, finish }) ret () }
    let p12 = midpoint(start, first)
    let p23 = midpoint(first, second)
    let p34 = midpoint(second, finish)
    let p123 = midpoint(p12, p23)
    let p234 = midpoint(p23, p34)
    let center = midpoint(p123, p234)
    let dx = finish.x - start.x
    let dy = finish.y - start.y
    let d2 = absolute((first.x - finish.x) * dy - (first.y - finish.y) * dx)
    let d3 = absolute((second.x - finish.x) * dy - (second.y - finish.y) * dx)
    if (d2 + d3) * (d2 + d3) < 0.04_f32 * (dx * dx + dy * dy) {
        lines.push(SvgLine { start, finish }) ret ()
    }
    flatten_cubic(lines, start, p12, p123, center, level + 1_usize)
    flatten_cubic(lines, center, p234, p34, finish, level + 1_usize)
    ret ()
}

fn midpoint(first: SvgPoint, second: SvgPoint) -> SvgPoint {
    ret SvgPoint::new((first.x + second.x) / 2.0_f32, (first.y + second.y) / 2.0_f32)
}

fn append_quadratic(lines: mut Vec[SvgLine], start: SvgPoint, control: SvgPoint, finish: SvgPoint) -> () {
    let first = SvgPoint::new(start.x + (control.x - start.x) * 0.6666667_f32,
        start.y + (control.y - start.y) * 0.6666667_f32)
    let second = SvgPoint::new(finish.x + (control.x - finish.x) * 0.6666667_f32,
        finish.y + (control.y - finish.y) * 0.6666667_f32)
    append_cubic(lines, start, first, second, finish)
    ret ()
}

fn append_arc(lines: mut Vec[SvgLine], start: SvgPoint, rx_value: f32, ry_value: f32, rotation: f32, large: bool, sweep: bool, finish: SvgPoint) -> () {
    if rx_value <= 0.0_f32 || ry_value <= 0.0_f32 || (start.x == finish.x && start.y == finish.y) {
        lines.push(SvgLine { start, finish }) ret ()
    }
    let phi = rotation * 0.017453292_f32
    let cos_phi = cosine(phi)
    let sin_phi = sine(phi)
    let dx = (start.x - finish.x) / 2.0_f32
    let dy = (start.y - finish.y) / 2.0_f32
    let x1 = cos_phi * dx + sin_phi * dy
    let y1 = 0.0_f32 - sin_phi * dx + cos_phi * dy
    let mut rx = rx_value
    let mut ry = ry_value
    let lambda = x1 * x1 / (rx * rx) + y1 * y1 / (ry * ry)
    if lambda > 1.0_f32 { let scale = square_root(lambda) rx = rx * scale ry = ry * scale }
    let numerator = rx * rx * ry * ry - rx * rx * y1 * y1 - ry * ry * x1 * x1
    let denominator = rx * rx * y1 * y1 + ry * ry * x1 * x1
    let sign = if large == sweep { -1.0_f32 } else { 1.0_f32 }
    let factor = sign * square_root(if numerator > 0.0_f32 && denominator > 0.0_f32 { numerator / denominator } else { 0.0_f32 })
    let cx1 = factor * (rx * y1 / ry)
    let cy1 = factor * (0.0_f32 - ry * x1 / rx)
    let cx = cos_phi * cx1 - sin_phi * cy1 + (start.x + finish.x) / 2.0_f32
    let cy = sin_phi * cx1 + cos_phi * cy1 + (start.y + finish.y) / 2.0_f32
    let ux = (x1 - cx1) / rx
    let uy = (y1 - cy1) / ry
    let vx = (0.0_f32 - x1 - cx1) / rx
    let vy = (0.0_f32 - y1 - cy1) / ry
    let start_angle = angle_of(ux, uy)
    let mut delta = angle_between(ux, uy, vx, vy)
    if !sweep && delta > 0.0_f32 { delta = delta - 6.2831853_f32 }
    if sweep && delta < 0.0_f32 { delta = delta + 6.2831853_f32 }
    let magnitude = absolute(delta)
    let divisions = if magnitude > 4.712389_f32 { 4_usize }
        elif magnitude > 3.14159265_f32 { 3_usize }
        elif magnitude > 1.5707963_f32 { 2_usize }
        else { 1_usize }
    let step = delta / divisions as f32
    let half = step / 2.0_f32
    let ratio = if absolute(half) < 0.001_f32 { half / 2.0_f32 }
        else { (1.0_f32 - cosine(half)) / sine(half) }
    let kappa_value = absolute(1.3333333_f32 * ratio)
    let kappa = if delta < 0.0_f32 { 0.0_f32 - kappa_value } else { kappa_value }
    let mut previous = start
    let mut previous_tangent = SvgPoint::new(0.0_f32, 0.0_f32)
    let mut index = 0_usize
    while index <= divisions {
        let angle = start_angle + step * index as f32
        let axis_x = cosine(angle)
        let axis_y = sine(angle)
        let point = if index == divisions { finish } else {
            SvgPoint::new(cx + cos_phi * rx * axis_x - sin_phi * ry * axis_y,
                cy + sin_phi * rx * axis_x + cos_phi * ry * axis_y)
        }
        let tangent = SvgPoint::new(cos_phi * (0.0_f32 - axis_y * rx * kappa) - sin_phi * (axis_x * ry * kappa),
            sin_phi * (0.0_f32 - axis_y * rx * kappa) + cos_phi * (axis_x * ry * kappa))
        if index > 0_usize {
            append_cubic(lines, previous,
                SvgPoint::new(previous.x + previous_tangent.x, previous.y + previous_tangent.y),
                SvgPoint::new(point.x - tangent.x, point.y - tangent.y), point)
        }
        previous = point
        previous_tangent = tangent
        index = index + 1_usize
    }
    ret ()
}

fn angle_of(x: f32, y: f32) -> f32 { ret atan2_approx(y, x) }
fn angle_between(ux: f32, uy: f32, vx: f32, vy: f32) -> f32 { ret atan2_approx(ux * vy - uy * vx, ux * vx + uy * vy) }

fn atan2_approx(y: f32, x: f32) -> f32 {
    if x == 0.0_f32 { ret if y >= 0.0_f32 { 1.5707963_f32 } else { -1.5707963_f32 } }
    let abs_y = absolute(y) + 0.000001_f32
    let angle = if x >= 0.0_f32 {
        let r = (x - abs_y) / (x + abs_y)
        0.78539816_f32 + (0.1963_f32 * r * r - 0.9817_f32) * r
    } else {
        let r = (x + abs_y) / (abs_y - x)
        2.3561945_f32 + (0.1963_f32 * r * r - 0.9817_f32) * r
    }
    ret if y < 0.0_f32 { 0.0_f32 - angle } else { angle }
}

fn sine(value: f32) -> f32 {
    let x = normalize_angle(value)
    let x2 = x * x
    ret x - x * x2 / 6.0_f32 + x * x2 * x2 / 120.0_f32 - x * x2 * x2 * x2 / 5040.0_f32 +
        x * x2 * x2 * x2 * x2 / 362880.0_f32 - x * x2 * x2 * x2 * x2 * x2 / 39916800.0_f32
}
fn cosine(value: f32) -> f32 {
    let x = normalize_angle(value)
    let x2 = x * x
    ret 1.0_f32 - x2 / 2.0_f32 + x2 * x2 / 24.0_f32 - x2 * x2 * x2 / 720.0_f32 +
        x2 * x2 * x2 * x2 / 40320.0_f32 - x2 * x2 * x2 * x2 * x2 / 3628800.0_f32
}
fn normalize_angle(value: f32) -> f32 {
    let mut result = value
    while result > 3.14159265_f32 { result = result - 6.2831853_f32 }
    while result < -3.14159265_f32 { result = result + 6.2831853_f32 }
    ret result
}
fn square_root(value: f32) -> f32 {
    if value <= 0.0_f32 { ret 0.0_f32 }
    let mut result = if value > 1.0_f32 { value } else { 1.0_f32 }
    let mut index = 0_usize
    while index < 10_usize { result = (result + value / result) / 2.0_f32 index = index + 1_usize }
    ret result
}
fn absolute(value: f32) -> f32 { ret if value < 0.0_f32 { 0.0_f32 - value } else { value } }

fn relative_point(origin: SvgPoint, x: f32, y: f32, relative: bool) -> SvgPoint {
    ret if relative { SvgPoint::new(origin.x + x, origin.y + y) } else { SvgPoint::new(x, y) }
}

fn numbers(source: str) -> Vec[f32] {
    let mut result = Vec[f32]::new()
    let mut index = 0_usize
    while index < source.char_len() {
        let parsed = next_number(source, index)
        if parsed.valid { result.push(parsed.value) index = parsed.next }
        else { index = index + 1_usize }
    }
    ret result
}

fn next_number(source: str, start: usize) -> SvgNumber {
    let mut index = skip_separators(source, start)
    if index >= source.char_len() { ret number(0.0_f32, index, false) }
    let begin = index
    let sign = source.slice(index, 1_usize)
    if sign == "-" || sign == "+" { index = index + 1_usize }
    let mut digits = false
    let mut dot = false
    while index < source.char_len() {
        let token = source.slice(index, 1_usize)
        if is_digit(token) { digits = true index = index + 1_usize }
        elif token == "." && !dot { dot = true index = index + 1_usize }
        else { break }
    }
    if !digits { ret number(0.0_f32, if index > begin { index } else { begin + 1_usize }, false) }
    ret number(parse_decimal(source.slice(begin, index - begin)), index, true)
}

fn parse_decimal(source: str) -> f32 {
    let mut value = 0.0_f32
    let mut fraction = 0.1_f32
    let mut decimal = false
    let mut negative = false
    let mut index = 0_usize
    while index < source.char_len() {
        let token = source.slice(index, 1_usize)
        if index == 0_usize && token == "-" { negative = true }
        elif token == "+" {}
        elif token == "." { decimal = true }
        else {
            let digit = digit_value(token)
            if decimal { value = value + (digit as f32) * fraction fraction = fraction * 0.1_f32 }
            else { value = value * 10.0_f32 + digit as f32 }
        }
        index = index + 1_usize
    }
    ret if negative { 0.0_f32 - value } else { value }
}

fn value_attr(tag: str, name: str) -> f32 { ret parse_decimal(attribute(tag, name)) }
fn attribute(tag: str, name: str) -> str {
    let marker = name + "="
    let position = find_from(tag, marker, 0_usize)
    if position >= tag.char_len() { ret "" }
    let quote_index = position + marker.char_len()
    if quote_index >= tag.char_len() { ret "" }
    let quote = tag.slice(quote_index, 1_usize)
    if quote != "\"" && quote != "'" { ret "" }
    let finish = find_from(tag, quote, quote_index + 1_usize)
    if finish >= tag.char_len() { ret "" }
    ret tag.slice(quote_index + 1_usize, finish - quote_index - 1_usize)
}
fn first_tag(source: str, name: str) -> str {
    let opening = find_from(source, "<" + name, 0_usize)
    if opening >= source.char_len() { ret "" }
    let closing = find_from(source, ">", opening)
    if closing >= source.char_len() { ret "" }
    ret source.slice(opening + 1_usize, closing - opening - 1_usize)
}
fn starts_tag(tag: str, name: str) -> bool {
    if tag.char_len() < name.char_len() || tag.slice(0_usize, name.char_len()) != name { ret false }
    if tag.char_len() == name.char_len() { ret true }
    let next = tag.slice(name.char_len(), 1_usize)
    ret next == " " || next == "\t" || next == "\n" || next == "\r" || next == "/"
}
fn find_from(source: str, needle: str, start: usize) -> usize {
    if needle == "" { ret start }
    let mut index = start
    while index + needle.char_len() <= source.char_len() {
        if source.slice(index, needle.char_len()) == needle { ret index }
        index = index + 1_usize
    }
    ret source.char_len()
}
fn skip_separators(source: str, start: usize) -> usize {
    let mut index = start
    while index < source.char_len() {
        let token = source.slice(index, 1_usize)
        if token == " " || token == "\t" || token == "\n" || token == "\r" || token == "," { index = index + 1_usize }
        else { break }
    }
    ret index
}
fn is_command(value: str) -> bool { ret value == "M" || value == "m" || value == "L" || value == "l" || value == "H" || value == "h" || value == "V" || value == "v" || value == "C" || value == "c" || value == "S" || value == "s" || value == "Q" || value == "q" || value == "T" || value == "t" || value == "A" || value == "a" || value == "Z" || value == "z" }
fn is_lower(value: str) -> bool { ret value == "m" || value == "l" || value == "h" || value == "v" || value == "c" || value == "s" || value == "q" || value == "t" || value == "a" || value == "z" }
fn is_digit(value: str) -> bool { ret digit_value(value) >= 0_i32 }
fn digit_value(value: str) -> i32 {
    if value == "0" { ret 0_i32 } if value == "1" { ret 1_i32 } if value == "2" { ret 2_i32 }
    if value == "3" { ret 3_i32 } if value == "4" { ret 4_i32 } if value == "5" { ret 5_i32 }
    if value == "6" { ret 6_i32 } if value == "7" { ret 7_i32 } if value == "8" { ret 8_i32 }
    if value == "9" { ret 9_i32 } ret -1_i32
}
fn number_at(values: Vec[f32], index: usize, fallback: f32) -> f32 {
    match values.get(index) { Some(value) => { ret value } None => { ret fallback } }
}
