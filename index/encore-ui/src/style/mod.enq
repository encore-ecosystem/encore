    pub fn with_columns(self: Self, value: usize) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, if value > 0_usize { value } else { 1_usize }, "", self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
