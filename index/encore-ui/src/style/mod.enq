    pub fn with_auto_column_template(self: Self, value: str) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, value, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense,
            self.self_align, self.order, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_auto_row_template(self: Self, value: str) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, value, self.auto_flow_column, self.auto_flow_dense,
            self.self_align, self.order, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_auto_flow(self: Self, column: bool, dense: bool) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template,
            self.auto_column_template, self.auto_row_template, column, dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_self_align(self: Self, value: i32) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template,
            self.auto_flow_column, self.auto_flow_dense, value, self.order, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_order(self: Self, value: i32) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, value, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_wrap(self: Self, value: bool, reverse: bool) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            value, value && reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_row_gap(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, if value >= 0.0_f32 { value } else { 0.0_f32 }, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_column_gap(self: Self, value: f32) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, if value >= 0.0_f32 { value } else { 0.0_f32 }, self.direction_reverse, self.align_content }
    }
    pub fn with_direction_reverse(self: Self, value: bool) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, value, self.align_content }
    }
    pub fn with_align_content(self: Self, value: usize) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense, self.self_align, self.order,
            self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, value }
    }
    pub fn direction(self: Self) -> usize { ret self.direction }
    pub fn direction_set(self: Self) -> bool { ret self.direction_set }
    pub fn basis(self: Self) -> f32 { ret self.basis }
    pub fn grow(self: Self) -> f32 { ret self.grow }
    pub fn shrink(self: Self) -> f32 { ret self.shrink }
    pub fn justify(self: Self) -> usize { ret self.justify }
    pub fn align(self: Self) -> usize { ret self.align }
    pub fn displayed(self: Self) -> bool { ret self.displayed }
    pub fn grid(self: Self) -> bool { ret self.grid }
    pub fn columns(self: Self) -> usize { ret self.columns }
    pub fn column_template(self: Self) -> str { ret self.column_template }
    pub fn row_template(self: Self) -> str { ret self.row_template }
    pub fn auto_column_template(self: Self) -> str { ret self.auto_column_template }
    pub fn auto_row_template(self: Self) -> str { ret self.auto_row_template }
    pub fn auto_flow_column(self: Self) -> bool { ret self.auto_flow_column }
    pub fn auto_flow_dense(self: Self) -> bool { ret self.auto_flow_dense }
    pub fn self_align(self: Self) -> i32 { ret self.self_align }
    pub fn order(self: Self) -> i32 { ret self.order }
    pub fn wrap(self: Self) -> bool { ret self.wrap }
    pub fn wrap_reverse(self: Self) -> bool { ret self.wrap_reverse }
    pub fn row_gap(self: Self) -> f32 { ret self.row_gap }
    pub fn column_gap(self: Self) -> f32 { ret self.column_gap }
    pub fn direction_reverse(self: Self) -> bool { ret self.direction_reverse }
    pub fn align_content(self: Self) -> usize { ret self.align_content }
}

pub struct PositionStyle {
    absolute: bool
    relative: bool
    top: f32
    right: f32
    bottom: f32
    left: f32
    top_set: bool
    right_set: bool
    bottom_set: bool
    left_set: bool
    z_index: i32
}

impl for PositionStyle {
    pub fn default() -> PositionStyle { ret PositionStyle { false, false, 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, false, false, false, false, 0_i32 } }
    pub fn with_absolute(self: Self, value: bool) -> PositionStyle {
        ret PositionStyle { value, if value { false } else { self.relative }, self.top, self.right, self.bottom, self.left,
            self.top_set, self.right_set, self.bottom_set, self.left_set, self.z_index }
    }
    pub fn with_relative(self: Self, value: bool) -> PositionStyle {
        ret PositionStyle { if value { false } else { self.absolute }, value, self.top, self.right, self.bottom, self.left,
            self.top_set, self.right_set, self.bottom_set, self.left_set, self.z_index }
    }
    pub fn with_top(self: Self, value: f32) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, value, self.right, self.bottom, self.left, true, self.right_set, self.bottom_set, self.left_set, self.z_index } }
    pub fn with_right(self: Self, value: f32) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, value, self.bottom, self.left, self.top_set, true, self.bottom_set, self.left_set, self.z_index } }
    pub fn with_bottom(self: Self, value: f32) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, value, self.left, self.top_set, self.right_set, true, self.left_set, self.z_index } }
    pub fn with_left(self: Self, value: f32) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, self.bottom, value, self.top_set, self.right_set, self.bottom_set, true, self.z_index } }
    pub fn without_top(self: Self) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, self.bottom, self.left, false, self.right_set, self.bottom_set, self.left_set, self.z_index } }
    pub fn without_right(self: Self) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set, false, self.bottom_set, self.left_set, self.z_index } }
    pub fn without_bottom(self: Self) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set, self.right_set, false, self.left_set, self.z_index } }
    pub fn without_left(self: Self) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set, self.right_set, self.bottom_set, false, self.z_index } }
    pub fn with_z_index(self: Self, value: i32) -> PositionStyle { ret PositionStyle { self.absolute, self.relative, self.top, self.right, self.bottom, self.left, self.top_set, self.right_set, self.bottom_set, self.left_set, value } }
    pub fn absolute(self: Self) -> bool { ret self.absolute }
    pub fn relative(self: Self) -> bool { ret self.relative }
    pub fn top(self: Self) -> f32 { ret self.top }
    pub fn right(self: Self) -> f32 { ret self.right }
    pub fn bottom(self: Self) -> f32 { ret self.bottom }
    pub fn left(self: Self) -> f32 { ret self.left }
    pub fn top_set(self: Self) -> bool { ret self.top_set }
    pub fn right_set(self: Self) -> bool { ret self.right_set }
    pub fn bottom_set(self: Self) -> bool { ret self.bottom_set }
    pub fn left_set(self: Self) -> bool { ret self.left_set }
    pub fn z_index(self: Self) -> i32 { ret self.z_index }
}

pub struct RelativeSize {
    width: f32
    height: f32
}

impl for RelativeSize {
    pub fn default() -> RelativeSize { ret RelativeSize { -1.0_f32, -1.0_f32 } }
    pub fn with_width(self: Self, value: f32) -> RelativeSize { ret RelativeSize { value, self.height } }
    pub fn with_height(self: Self, value: f32) -> RelativeSize { ret RelativeSize { self.width, value } }
    pub fn width(self: Self) -> f32 { ret self.width }
    pub fn height(self: Self) -> f32 { ret self.height }
}

pub struct ScrollOffset {
    x: f32
    y: f32
}

pub struct GridPlacement {
    column: usize
    row: usize
    column_end: usize
    row_end: usize
    column_span: usize
    row_span: usize
}

impl for GridPlacement {
    pub fn auto() -> GridPlacement { ret GridPlacement { 0_usize, 0_usize, 0_usize, 0_usize, 0_usize, 0_usize } }
    pub fn with_column(self: Self, value: usize) -> GridPlacement { ret GridPlacement { value, self.row, self.column_end, self.row_end, self.column_span, self.row_span } }
    pub fn with_row(self: Self, value: usize) -> GridPlacement { ret GridPlacement { self.column, value, self.column_end, self.row_end, self.column_span, self.row_span } }
    pub fn with_column_end(self: Self, value: usize) -> GridPlacement { ret GridPlacement { self.column, self.row, value, self.row_end, self.column_span, self.row_span } }
    pub fn with_row_end(self: Self, value: usize) -> GridPlacement { ret GridPlacement { self.column, self.row, self.column_end, value, self.column_span, self.row_span } }
    pub fn with_column_span(self: Self, value: usize) -> GridPlacement { ret GridPlacement { self.column, self.row, self.column_end, self.row_end, value, self.row_span } }
    pub fn with_row_span(self: Self, value: usize) -> GridPlacement { ret GridPlacement { self.column, self.row, self.column_end, self.row_end, self.column_span, value } }
    pub fn column(self: Self) -> usize { ret self.column }
    pub fn row(self: Self) -> usize { ret self.row }
    pub fn column_span(self: Self) -> usize {
        ret if self.column_span > 0_usize { self.column_span }
            elif self.column > 0_usize && self.column_end > self.column { self.column_end - self.column } else { 1_usize }
    }
    pub fn row_span(self: Self) -> usize {
        ret if self.row_span > 0_usize { self.row_span }
            elif self.row > 0_usize && self.row_end > self.row { self.row_end - self.row } else { 1_usize }
    }
}

impl for ScrollOffset {
    pub fn zero() -> ScrollOffset { ret ScrollOffset { 0.0_f32, 0.0_f32 } }
    pub fn new(x: f32, y: f32) -> ScrollOffset {
        ret ScrollOffset { if x > 0.0_f32 { x } else { 0.0_f32 }, if y > 0.0_f32 { y } else { 0.0_f32 } }
    }
    pub fn x(self: Self) -> f32 { ret self.x }
    pub fn y(self: Self) -> f32 { ret self.y }
}

pub struct LayoutStyle {
    margin: Insets
    width: f32
    height: f32
    min_width: f32
    min_height: f32
    max_width: f32
    max_height: f32
    flex: FlexStyle
    overflow_hidden: bool
    position: PositionStyle
    relative: RelativeSize
    scroll: ScrollOffset
    content_box: bool
    grid_placement: GridPlacement
}

impl for LayoutStyle {
    pub fn default() -> LayoutStyle {
        ret LayoutStyle { Insets::all(0.0_f32), -1.0_f32, -1.0_f32,
            0.0_f32, 0.0_f32, 1000000.0_f32, 1000000.0_f32,
            FlexStyle::default(), false, PositionStyle::default(), RelativeSize::default(), ScrollOffset::zero(), false, GridPlacement::auto() }
    }
    pub fn with_margin(self: Self, value: Insets) -> LayoutStyle {
        ret LayoutStyle { value, self.width, self.height, self.min_width, self.min_height, self.max_width, self.max_height, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_width(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle { self.margin, value, self.height, self.min_width, self.min_height, self.max_width, self.max_height, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_height(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle { self.margin, self.width, value, self.min_width, self.min_height, self.max_width, self.max_height, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_min_width(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle { self.margin, self.width, self.height, value, self.min_height, self.max_width, self.max_height, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_min_height(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle { self.margin, self.width, self.height, self.min_width, value, self.max_width, self.max_height, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_max_width(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle { self.margin, self.width, self.height, self.min_width, self.min_height, value, self.max_height, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_max_height(self: Self, value: f32) -> LayoutStyle {
        ret LayoutStyle { self.margin, self.width, self.height, self.min_width, self.min_height, self.max_width, value, self.flex, self.overflow_hidden, self.position, self.relative, self.scroll, self.content_box, self.grid_placement }
    }
    pub fn with_flex_direction(self: Self, value: usize) -> LayoutStyle { ret self.with_flex(self.flex.with_direction(value)) }
    pub fn with_flex_direction_reverse(self: Self, value: bool) -> LayoutStyle { ret self.with_flex(self.flex.with_direction_reverse(value)) }
    pub fn with_flex_basis(self: Self, value: f32) -> LayoutStyle { ret self.with_flex(self.flex.with_basis(value)) }
    pub fn with_flex_grow(self: Self, value: f32) -> LayoutStyle { ret self.with_flex(self.flex.with_grow(value)) }
    pub fn with_flex_shrink(self: Self, value: f32) -> LayoutStyle { ret self.with_flex(self.flex.with_shrink(value)) }
    pub fn with_justify(self: Self, value: usize) -> LayoutStyle { ret self.with_flex(self.flex.with_justify(value)) }
