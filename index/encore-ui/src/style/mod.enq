import color::{Color, black, transparent, white}
import geometry::Insets

pub struct Style {
    background: Color
    foreground: Color
    border_color: Color
    border_width: f32
    radius: f32
    padding: Insets
    gap: f32
    font_size: f32
}

impl for Style {
    pub fn default() -> Style {
        ret Style {
            transparent(), black(), transparent(), 0.0_f32, 0.0_f32,
            Insets::all(0.0_f32), 0.0_f32, 14.0_f32
        }
    }

    pub fn panel() -> Style {
        ret Style {
            white(), black(), Color::rgb(210_u8, 216_u8, 224_u8),
            1.0_f32, 4.0_f32, Insets::all(12.0_f32), 8.0_f32, 14.0_f32
        }
    }

    pub fn with_background(self: Self, value: Color) -> Style {
        ret Style { value, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_size }
    }
    pub fn with_foreground(self: Self, value: Color) -> Style {
        ret Style { self.background, value, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_size }
    }
    pub fn with_border(self: Self, width: f32, color: Color) -> Style {
        ret Style { self.background, self.foreground, color, width,
            self.radius, self.padding, self.gap, self.font_size }
    }
    pub fn with_radius(self: Self, value: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, value, self.padding, self.gap, self.font_size }
    }
    pub fn with_padding(self: Self, value: Insets) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, value, self.gap, self.font_size }
    }
    pub fn with_gap(self: Self, value: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, value, self.font_size }
    }
    pub fn with_font_size(self: Self, value: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, self.gap, value }
    }
    pub fn background(self: Self) -> Color { ret self.background }
    pub fn foreground(self: Self) -> Color { ret self.foreground }
    pub fn border_color(self: Self) -> Color { ret self.border_color }
    pub fn border_width(self: Self) -> f32 { ret self.border_width }
    pub fn radius(self: Self) -> f32 { ret self.radius }
    pub fn padding(self: Self) -> Insets { ret self.padding }
    pub fn gap(self: Self) -> f32 { ret self.gap }
    pub fn font_size(self: Self) -> f32 { ret self.font_size }
}
