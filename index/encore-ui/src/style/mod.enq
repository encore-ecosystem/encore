        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, if columns > 0_usize { columns } else { 1_usize }, value, self.row_template, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense,
            self.self_align, self.order, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
    }
    pub fn with_row_template(self: Self, value: str) -> FlexStyle {
        ret FlexStyle { self.direction, self.direction_set, self.basis, self.grow, self.shrink,
            self.justify, self.align, self.displayed, self.grid, self.columns, self.column_template, value, self.auto_column_template, self.auto_row_template, self.auto_flow_column, self.auto_flow_dense,
            self.self_align, self.order, self.wrap, self.wrap_reverse, self.row_gap, self.column_gap, self.direction_reverse, self.align_content }
