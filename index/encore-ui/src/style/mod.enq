    pub fn with_grid_auto_rows(self: Self, value: str) -> Style { ret self.with_layout(self.layout.with_grid_auto_rows(value)) }
    pub fn with_grid_auto_flow(self: Self, column: bool, dense: bool) -> Style { ret self.with_layout(self.layout.with_grid_auto_flow(column, dense)) }
    pub fn with_grid_column(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_column(value)) }
    pub fn with_grid_row(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_row(value)) }
    pub fn with_grid_column_end(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_column_end(value)) }
    pub fn with_grid_row_end(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_row_end(value)) }
    pub fn with_grid_column_span(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_column_span(value)) }
    pub fn with_grid_row_span(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_row_span(value)) }
    pub fn with_overflow_hidden(self: Self, value: bool) -> Style { ret self.with_layout(self.layout.with_overflow_hidden(value)) }
    pub fn with_position(self: Self, value: PositionStyle) -> Style { ret self.with_layout(self.layout.with_position(value)) }
    pub fn with_absolute(self: Self, value: bool) -> Style { ret self.with_layout(self.layout.with_absolute(value)) }
    pub fn with_relative_position(self: Self, value: bool) -> Style { ret self.with_layout(self.layout.with_relative_position(value)) }
    pub fn with_top(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_top(value)) }
    pub fn with_right(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_right(value)) }
    pub fn with_bottom(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_bottom(value)) }
    pub fn with_left(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_left(value)) }
    pub fn without_top(self: Self) -> Style { ret self.with_layout(self.layout.without_top()) }
    pub fn without_right(self: Self) -> Style { ret self.with_layout(self.layout.without_right()) }
    pub fn without_bottom(self: Self) -> Style { ret self.with_layout(self.layout.without_bottom()) }
    pub fn without_left(self: Self) -> Style { ret self.with_layout(self.layout.without_left()) }
    pub fn with_z_index(self: Self, value: i32) -> Style { ret self.with_layout(self.layout.with_z_index(value)) }
    pub fn with_width_percent(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_width_percent(value)) }
    pub fn with_height_percent(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_height_percent(value)) }
    pub fn with_scroll(self: Self, x: f32, y: f32) -> Style { ret self.with_layout(self.layout.with_scroll(ScrollOffset::new(x, y))) }
    pub fn with_content_box(self: Self, value: bool) -> Style { ret self.with_layout(self.layout.with_content_box(value)) }
    pub fn with_layout(self: Self, value: LayoutStyle) -> Style {
        ret Style { self.background, self.foreground, self.border_color, self.border_width, self.radius,
            self.padding, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, value,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn inherit_text(self: Self, parent: Style) -> Style {
        ret Style { self.background,
            if self.foreground_set { self.foreground } else { parent.foreground },
            self.border_color, self.border_width, self.radius, self.padding, self.gap,
            if self.font_family_set { self.font_family } else { parent.font_family },
            if self.font_size_set { self.font_size } else { parent.font_size },
            if self.font_weight_set { self.font_weight } else { parent.font_weight },
            if self.text_align_set { self.text_align } else { parent.text_align },
            self.opacity, self.layout, self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            if self.visibility_set { self.visible } else { parent.visible },
            if self.pointer_events_set { self.pointer_events } else { parent.pointer_events },
            self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn background(self: Self) -> Color { ret self.background }
    pub fn foreground(self: Self) -> Color { ret self.foreground }
    pub fn border_color(self: Self) -> Color { ret self.border_color }
    pub fn border_width(self: Self) -> f32 { ret self.border_width }
    pub fn radius(self: Self) -> f32 { ret self.radius }
    pub fn padding(self: Self) -> Insets { ret self.padding }
    pub fn gap(self: Self) -> f32 { ret self.gap }
    pub fn font_family(self: Self) -> str { ret self.font_family }
    pub fn font_size(self: Self) -> f32 { ret self.font_size }
    pub fn font_weight(self: Self) -> u32 { ret self.font_weight }
    pub fn text_align(self: Self) -> usize { ret self.text_align }
    pub fn opacity(self: Self) -> f32 { ret self.opacity }
    pub fn visible(self: Self) -> bool { ret self.visible }
    pub fn pointer_events(self: Self) -> bool { ret self.pointer_events }
    pub fn outline(self: Self) -> OutlineStyle { ret self.outline }
    pub fn shadow(self: Self) -> ShadowStyle { ret self.shadow }
    pub fn decoration(self: Self) -> TextDecorationStyle { ret self.decoration }
    pub fn layout(self: Self) -> LayoutStyle { ret self.layout }
}

pub struct Theme {
    canvas: Color
    surface: Color
    ink: Color
    muted: Color
    line: Color
    primary: Color
    secondary: Color
    danger: Color
    warning: Color
}

impl for Theme {
    pub fn light() -> Theme {
        ret Theme {
            Color::rgb(238_u8, 242_u8, 246_u8),
            Color::rgb(255_u8, 255_u8, 255_u8),
            Color::rgb(31_u8, 36_u8, 43_u8),
            Color::rgb(102_u8, 112_u8, 125_u8),
            Color::rgb(203_u8, 211_u8, 220_u8),
            Color::rgb(18_u8, 153_u8, 126_u8),
            Color::rgb(74_u8, 85_u8, 99_u8),
            Color::rgb(207_u8, 72_u8, 72_u8),
            Color::rgb(224_u8, 157_u8, 49_u8)
        }
    }

    pub fn canvas(self: Self) -> Color { ret self.canvas }
    pub fn surface(self: Self) -> Color { ret self.surface }
    pub fn ink(self: Self) -> Color { ret self.ink }
    pub fn muted(self: Self) -> Color { ret self.muted }
    pub fn line(self: Self) -> Color { ret self.line }
    pub fn primary(self: Self) -> Color { ret self.primary }
    pub fn secondary(self: Self) -> Color { ret self.secondary }
    pub fn danger(self: Self) -> Color { ret self.danger }
    pub fn warning(self: Self) -> Color { ret self.warning }

    pub fn root(self: Self) -> Style {
        ret Style::default().with_background(self.canvas)
            .with_foreground(self.ink).with_padding(Insets::all(18.0_f32)).with_gap(12.0_f32)
    }
    pub fn surface_style(self: Self) -> Style {
        ret Style::panel().with_background(self.surface).with_foreground(self.ink)
            .with_border(1.0_f32, self.line).with_padding(Insets::all(12.0_f32)).with_gap(8.0_f32)
    }
    pub fn primary_button(self: Self) -> Style { ret themed_button(self.primary, white()) }
    pub fn secondary_button(self: Self) -> Style { ret themed_button(self.secondary, white()) }
    pub fn danger_button(self: Self) -> Style { ret themed_button(self.danger, white()) }
    pub fn outline_button(self: Self) -> Style {
        ret Style::panel().with_background(self.surface).with_foreground(self.ink)
            .with_border(1.0_f32, self.muted).with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
    }
    pub fn ghost_button(self: Self) -> Style {
        ret Style::default().with_background(self.canvas).with_foreground(self.ink)
            .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
    }
    pub fn tab(self: Self, selected: bool) -> Style {
        if selected { ret self.primary_button() }
        ret self.secondary_button()
    }
}

fn themed_button(background: Color, foreground: Color) -> Style {
    ret Style::panel().with_background(background).with_foreground(foreground)
        .with_border(1.0_f32, background).with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}
