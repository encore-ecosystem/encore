import color::{Color, black, transparent, white}
import geometry::Insets

pub fn text_start() -> usize { ret 0_usize }
pub fn text_center() -> usize { ret 1_usize }
pub fn text_end() -> usize { ret 2_usize }
pub fn align_content_stretch() -> usize { ret 0_usize }
pub fn align_content_start() -> usize { ret 1_usize }
pub fn align_content_center() -> usize { ret 2_usize }
pub fn align_content_end() -> usize { ret 3_usize }
pub fn align_content_space_between() -> usize { ret 4_usize }
pub fn align_content_space_around() -> usize { ret 5_usize }
pub fn align_content_space_evenly() -> usize { ret 6_usize }

pub struct FlexStyle {
    direction: usize
    direction_set: bool
    basis: f32
    grow: f32
    shrink: f32
    justify: usize
    align: usize
    displayed: bool
    grid: bool
    columns: usize
    column_template: str
    row_template: str
    auto_column_template: str
    auto_row_template: str
    auto_flow_column: bool
    auto_flow_dense: bool
    self_align: i32
    order: i32
    wrap: bool
    wrap_reverse: bool
    row_gap: f32
    column_gap: f32
    direction_reverse: bool
    align_content: usize
}

