    pub fn with_align_content(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_align_content(value)) }
    pub fn with_displayed(self: Self, value: bool) -> Style { ret self.with_layout(self.layout.with_displayed(value)) }
    pub fn with_grid(self: Self, value: bool) -> Style { ret self.with_layout(self.layout.with_grid(value)) }
    pub fn with_grid_columns(self: Self, value: usize) -> Style { ret self.with_layout(self.layout.with_grid_columns(value)) }
    pub fn with_grid_column_template(self: Self, value: str, columns: usize) -> Style {
        ret self.with_layout(self.layout.with_grid_column_template(value, columns))
    }
