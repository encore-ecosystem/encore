pub struct OutlineStyle {
    width: f32
    color: Color
    offset: f32
}

impl for OutlineStyle {
    pub fn none() -> OutlineStyle { ret OutlineStyle { 0.0_f32, transparent(), 0.0_f32 } }
    pub fn new(width: f32, color: Color, offset: f32) -> OutlineStyle {
        ret OutlineStyle {
            if width > 0.0_f32 { width } else { 0.0_f32 }, color, offset
        }
    }
    pub fn width(self: Self) -> f32 { ret self.width }
    pub fn color(self: Self) -> Color { ret self.color }
    pub fn offset(self: Self) -> f32 { ret self.offset }
}

pub struct ShadowStyle {
    x: f32
    y: f32
    blur: f32
    spread: f32
    color: Color
    inset: bool
}

impl for ShadowStyle {
    pub fn none() -> ShadowStyle { ret ShadowStyle { 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, transparent(), false } }
    pub fn new(x: f32, y: f32, blur: f32, spread: f32, color: Color, inset: bool) -> ShadowStyle {
        ret ShadowStyle { x, y, if blur > 0.0_f32 { blur } else { 0.0_f32 }, spread, color, inset }
    }
    pub fn x(self: Self) -> f32 { ret self.x }
    pub fn y(self: Self) -> f32 { ret self.y }
    pub fn blur(self: Self) -> f32 { ret self.blur }
    pub fn spread(self: Self) -> f32 { ret self.spread }
    pub fn color(self: Self) -> Color { ret self.color }
    pub fn inset(self: Self) -> bool { ret self.inset }
}

pub struct TextDecorationStyle {
    underline: bool
    overline: bool
    line_through: bool
    color: Color
    color_set: bool
    thickness: f32
}

impl for TextDecorationStyle {
    pub fn none() -> TextDecorationStyle {
        ret TextDecorationStyle { false, false, false, transparent(), false, 1.0_f32 }
    }
    pub fn new(underline: bool, overline: bool, line_through: bool, color: Color,
        color_set: bool, thickness: f32) -> TextDecorationStyle {
        ret TextDecorationStyle { underline, overline, line_through, color, color_set,
            if thickness > 0.0_f32 { thickness } else { 1.0_f32 } }
    }
    pub fn underline(self: Self) -> bool { ret self.underline }
    pub fn overline(self: Self) -> bool { ret self.overline }
    pub fn line_through(self: Self) -> bool { ret self.line_through }
    pub fn color(self: Self) -> Color { ret self.color }
    pub fn color_set(self: Self) -> bool { ret self.color_set }
    pub fn thickness(self: Self) -> f32 { ret self.thickness }
}

pub struct Style {
    background: Color
    foreground: Color
    border_color: Color
    border_width: f32
    radius: f32
    padding: Insets
    gap: f32
    font_family: str
    font_size: f32
    font_weight: u32
    text_align: usize
    opacity: f32
    layout: LayoutStyle
    foreground_set: bool
    font_family_set: bool
    font_size_set: bool
    font_weight_set: bool
    text_align_set: bool
    visible: bool
    pointer_events: bool
    visibility_set: bool
    pointer_events_set: bool
    outline: OutlineStyle
    shadow: ShadowStyle
    decoration: TextDecorationStyle
}

impl for Style {
    pub fn default() -> Style {
        ret Style {
            transparent(), black(), transparent(), 0.0_f32, 0.0_f32,
            Insets::all(0.0_f32), 0.0_f32, "", 14.0_f32, 400_u32, text_start(), 1.0_f32, LayoutStyle::default(),
            false, false, false, false, false, true, true, false, false, OutlineStyle::none(), ShadowStyle::none(), TextDecorationStyle::none()
        }
    }

    pub fn panel() -> Style {
        ret Style {
            white(), black(), Color::rgb(210_u8, 216_u8, 224_u8),
            1.0_f32, 4.0_f32, Insets::all(12.0_f32), 8.0_f32, "", 14.0_f32, 400_u32, text_start(), 1.0_f32,
            LayoutStyle::default(), false, false, false, false, false, true, true, false, false, OutlineStyle::none(), ShadowStyle::none(), TextDecorationStyle::none()
        }
    }

    pub fn with_background(self: Self, value: Color) -> Style {
        ret Style { value, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_foreground(self: Self, value: Color) -> Style {
        ret Style { self.background, value, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            true, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_border(self: Self, width: f32, color: Color) -> Style {
        ret Style { self.background, self.foreground, color, width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_radius(self: Self, value: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, value, self.padding, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_padding(self: Self, value: Insets) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, value, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_gap(self: Self, value: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, value, self.font_family, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_font_family(self: Self, value: str) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, self.gap, value, self.font_size, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, true, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_font_size(self: Self, value: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, self.gap, self.font_family, value, self.font_weight, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, true, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_font_weight(self: Self, value: u32) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, self.gap, self.font_family, self.font_size, value, self.text_align, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, true, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_text_align(self: Self, value: usize) -> Style {
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight, value, self.opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, true,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_opacity(self: Self, value: f32) -> Style {
        let opacity = if value < 0.0_f32 { 0.0_f32 } elif value > 1.0_f32 { 1.0_f32 } else { value }
        ret Style { self.background, self.foreground, self.border_color,
            self.border_width, self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight, self.text_align, opacity, self.layout,
            self.foreground_set, self.font_family_set, self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_visibility(self: Self, value: bool) -> Style {
        ret Style { self.background, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight,
            self.text_align, self.opacity, self.layout, self.foreground_set, self.font_family_set,
            self.font_size_set, self.font_weight_set, self.text_align_set,
            value, self.pointer_events, true, self.pointer_events_set, self.outline, self.shadow, self.decoration }
    }
    pub fn with_pointer_events(self: Self, value: bool) -> Style {
        ret Style { self.background, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight,
            self.text_align, self.opacity, self.layout, self.foreground_set, self.font_family_set,
            self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, value, self.visibility_set, true, self.outline, self.shadow, self.decoration }
    }
    pub fn with_outline(self: Self, width: f32, color: Color, offset: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight,
            self.text_align, self.opacity, self.layout, self.foreground_set, self.font_family_set,
            self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set,
            OutlineStyle::new(width, color, offset), self.shadow, self.decoration }
    }
    pub fn with_shadow(self: Self, x: f32, y: f32, blur: f32, spread: f32, color: Color, inset: bool) -> Style {
        ret Style { self.background, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight,
            self.text_align, self.opacity, self.layout, self.foreground_set, self.font_family_set,
            self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set,
            self.outline, ShadowStyle::new(x, y, blur, spread, color, inset), self.decoration }
    }
    pub fn with_text_decoration(self: Self, underline: bool, overline: bool, line_through: bool,
        color: Color, color_set: bool, thickness: f32) -> Style {
        ret Style { self.background, self.foreground, self.border_color, self.border_width,
            self.radius, self.padding, self.gap, self.font_family, self.font_size, self.font_weight,
            self.text_align, self.opacity, self.layout, self.foreground_set, self.font_family_set,
            self.font_size_set, self.font_weight_set, self.text_align_set,
            self.visible, self.pointer_events, self.visibility_set, self.pointer_events_set,
            self.outline, self.shadow,
            TextDecorationStyle::new(underline, overline, line_through, color, color_set, thickness) }
    }
    pub fn with_margin(self: Self, value: Insets) -> Style { ret self.with_layout(self.layout.with_margin(value)) }
    pub fn with_width(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_width(value)) }
    pub fn with_height(self: Self, value: f32) -> Style { ret self.with_layout(self.layout.with_height(value)) }
