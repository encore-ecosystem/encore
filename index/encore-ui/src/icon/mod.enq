import core::option::Option
import core::os::{file_exists, read_dir, read_file}
import core::vec::Vec
import refrain::svg::SvgDocument

pub struct IconAsset {
    name: str
    path: str
    bundled: bool
}

impl for IconAsset {
    pub fn new(name: str, path: str) -> IconAsset { ret IconAsset { name, path, false } }
    pub fn bundled(name: str, path: str) -> IconAsset { ret IconAsset { name, path, true } }
    pub fn name(self: Self) -> str { ret self.name }
    pub fn path(self: Self) -> str { ret self.path }
    pub fn is_bundled(self: Self) -> bool { ret self.bundled }
    pub fn document(self: Self) -> SvgDocument {
        if !file_exists(self.path) { ret SvgDocument::empty() }
        ret SvgDocument::parse(read_file(self.path))
    }
}

pub struct IconManager {
    icons: Vec[IconAsset]
    root: str
}

impl for IconManager {
    pub fn new() -> IconManager { ret IconManager { Vec[IconAsset]::new(), "" } }
    pub fn with_bundled(root: str) -> IconManager {
        let mut manager = IconManager { Vec[IconAsset]::new(), root }
        manager.load_directory(root, true)
        ret manager
    }
    pub fn register(self: mut Self, name: str, path: str) -> bool {
        if name == "" || !is_svg(path) || !file_exists(path) { ret false }
        if self.contains(name) { ret false }
        self.icons.push(IconAsset::new(name, path))
        ret true
    }
    pub fn register_bundled(self: mut Self, name: str, path: str) -> bool {
        if name == "" || !is_svg(path) || !file_exists(path) { ret false }
        if self.contains(name) { ret false }
        self.icons.push(IconAsset::bundled(name, path))
        ret true
    }
    pub fn load_directory(self: mut Self, path: str, bundled: bool) -> usize {
        let entries = read_dir(path)
        let mut loaded = 0_usize
        let mut index = 0_usize
        while index < entries.len() {
            match entries.get(index) {
                Option[str]::Some(filename) => {
                    if is_svg(filename) {
                        let name = icon_name(filename)
                        let accepted = if bundled { self.register_bundled(name, path + "/" + filename) }
                            else { self.register(name, path + "/" + filename) }
                        if accepted { loaded = loaded + 1_usize }
                    }
                }
                Option[str]::None => {}
            }
            index = index + 1_usize
        }
        ret loaded
    }
    pub fn find(self: Self, name: str) -> Option[IconAsset] {
        let mut index = 0_usize
        while index < self.icons.len() {
            match self.icons.get(index) {
                Option[IconAsset]::Some(icon) => { if icon.name() == name { ret Option[IconAsset]::Some(icon) } }
                Option[IconAsset]::None => {}
            }
            index = index + 1_usize
        }
        ret Option[IconAsset]::None
    }
    pub fn document(self: Self, name: str) -> SvgDocument {
        match self.find(name) {
            Option[IconAsset]::Some(icon) => { ret icon.document() }
            Option[IconAsset]::None => { ret SvgDocument::empty() }
        }
    }
    pub fn contains(self: Self, name: str) -> bool {
        match self.find(name) { Option[IconAsset]::Some(_) => { ret true } Option[IconAsset]::None => { ret false } }
    }
    pub fn icons(self: Self) -> Vec[IconAsset] { ret self.icons }
    pub fn len(self: Self) -> usize { ret self.icons.len() }
    pub fn root(self: Self) -> str { ret self.root }
}

fn icon_name(filename: str) -> str {
    if filename.char_len() > 4_usize { ret filename.slice(0_usize, filename.char_len() - 4_usize) }
    ret filename
}
fn is_svg(path: str) -> bool {
    if path.char_len() < 4_usize { ret false }
    ret path.slice(path.char_len() - 4_usize, 4_usize) == ".svg"
}
