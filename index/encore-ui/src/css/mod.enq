import core::option::Option
import core::vec::Vec
import color::{Color, black, transparent, white}
import geometry::Insets
import refrain::layout::{align_center, align_end, align_start, align_stretch, horizontal,
    justify_center, justify_end, justify_space_around, justify_space_between, justify_space_evenly, justify_start, vertical}
import refrain::style::{Style, align_content_center, align_content_end, align_content_space_around,
    align_content_space_between, align_content_space_evenly, align_content_start, align_content_stretch,
    text_center, text_end, text_start}
import refrain::widget::{Widget, widget_button, widget_checkbox, widget_color_picker, widget_color_swatch,
    widget_heading, widget_input, widget_label, widget_link, widget_panel, widget_progress, widget_radio,
    widget_select, widget_separator, widget_slider, widget_spacer, widget_switch, widget_textarea, widget_icon, widget_icon_button, widget_icon_card}

pub struct StyleRule {
    selector: str
    declarations: str
    specificity: usize
}

pub struct CssVariable {
    name: str
    value: str
}

struct SelectorNode {
    widget: Widget
    index: usize
    count: usize
    siblings: Vec[Widget]
}

struct SelectorCombinator {
    index: usize
    kind: usize
}

pub struct StyleSheet {
    rules: Vec[StyleRule]
}

impl for StyleSheet {
    pub fn parse(source: str) -> StyleSheet {
        let mut rules = Vec[StyleRule]::new()
        let source = strip_comments(source)
        let mut cursor = 0_usize
        while cursor < source.char_len() {
            let open = rule_open(source, cursor)
            if open == source.char_len() { break }
            let close = rule_close(source, open)
            if close == source.char_len() { break }
            let selector = trim(source.slice(cursor, open - cursor))
            if selector != "" {
                let declarations = source.slice(open + 1_usize, close - open - 1_usize)
                append_selector_rules(rules, selector, declarations)
            }
            cursor = close + 1_usize
        }
        ret StyleSheet { rules }
    }

    pub fn style(self: Self, widget: Widget, hovered: bool, active: bool, focused: bool) -> Style {
        let ancestors = Vec[SelectorNode]::new()
        let siblings = singleton_widget(widget)
        let variables = compute_variables(self, widget, ancestors, siblings, 0_usize, 1_usize,
            hovered, active, focused, focused, Vec[CssVariable]::new())
        ret compute_style(self, widget, ancestors, siblings, 0_usize, 1_usize,
            hovered, active, focused, focused, variables)
    }

    pub fn apply(self: Self, root: Widget, hovered_id: str, active_id: str, focused_id: str) -> Widget {
        let state_root = mark_widget_focus(root, focused_id)
        ret apply_stylesheet_node(self, state_root, hovered_id, active_id, focused_id, Option[Style]::None,
            Vec[SelectorNode]::new(), Vec[CssVariable]::new(), singleton_widget(state_root), 0_usize, 1_usize)
    }

    pub fn len(self: Self) -> usize { ret self.rules.len() }

    fn maximum_specificity(self: Self) -> usize {
        let mut maximum = 0_usize
        let mut index = 0_usize
        while index < self.rules.len() {
            match self.rules.get(index) {
                Option[StyleRule]::Some(rule) => { if rule.specificity > maximum { maximum = rule.specificity } }
                Option[StyleRule]::None => {}
            }
            index = index + 1_usize
        }
        ret maximum
    }
}

fn rule_open(value: str, start: usize) -> usize {
    let mut index = start
    let mut quote = ""
    let mut escaped = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "{" { ret index }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn rule_close(value: str, open: usize) -> usize {
    let mut index = open
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "{" { depth = depth + 1_usize }
            elif current == "}" {
                if depth == 1_usize { ret index }
                if depth > 0_usize { depth = depth - 1_usize }
            }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn mark_widget_focus(widget: Widget, focused_id: str) -> Widget {
    let source = widget.children()
    let mut children = Vec[Widget]::new()
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[Widget]::Some(child) => { children.push(mark_widget_focus(child, focused_id)) }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    let focused = if focused_id == "" { widget.focused() } else { widget.id() == focused_id }
    ret widget.with_focus(focused).with_children(children)
}

fn compute_style(sheet: StyleSheet, widget: Widget, ancestors: Vec[SelectorNode], siblings: Vec[Widget],
    child_index: usize, sibling_count: usize,
    hovered: bool, active: bool, focused: bool, focus_within: bool, variables: Vec[CssVariable]) -> Style {
        let mut result = widget.style()
        let mut score = 0_usize
        let maximum = sheet.maximum_specificity()
        while score <= maximum {
            let mut index = 0_usize
            while index < sheet.rules.len() {
                match sheet.rules.get(index) {
                    Option[StyleRule]::Some(rule) => {
                        if rule.specificity == score && selector_tree_matches(rule.selector, widget, ancestors,
                            ancestors.len(), siblings, child_index, sibling_count, hovered, active, focused, focus_within) {
                            result = apply_css(result, resolve_variables(rule.declarations, variables))
                        }
                    }
                    Option[StyleRule]::None => {}
                }
                index = index + 1_usize
            }
            score = score + 1_usize
        }
        ret result
}

fn compute_variables(sheet: StyleSheet, widget: Widget, ancestors: Vec[SelectorNode], siblings: Vec[Widget],
    child_index: usize, sibling_count: usize, hovered: bool,
    active: bool, focused: bool, focus_within: bool, inherited: Vec[CssVariable]) -> Vec[CssVariable] {
    let mut result = copy_variables(inherited)
    let mut score = 0_usize
    let maximum = sheet.maximum_specificity()
    while score <= maximum {
        let mut index = 0_usize
        while index < sheet.rules.len() {
            match sheet.rules.get(index) {
                Option[StyleRule]::Some(rule) => {
                    if rule.specificity == score && selector_tree_matches(rule.selector, widget, ancestors,
                        ancestors.len(), siblings, child_index, sibling_count, hovered, active, focused, focus_within) {
                        collect_variables(result, rule.declarations)
                    }
                }
                Option[StyleRule]::None => {}
            }
            index = index + 1_usize
        }
        score = score + 1_usize
    }
    ret result
}

fn copy_variables(source: Vec[CssVariable]) -> Vec[CssVariable] {
    let mut result = Vec[CssVariable]::new()
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[CssVariable]::Some(variable) => { result.push(variable) }
            Option[CssVariable]::None => {}
        }
        index = index + 1_usize
    }
    ret result
}

fn apply_stylesheet_node(sheet: StyleSheet, widget: Widget, hovered_id: str, active_id: str,
    focused_id: str, parent: Option[Style], ancestors: Vec[SelectorNode], inherited_variables: Vec[CssVariable],
    siblings: Vec[Widget], child_index: usize, sibling_count: usize) -> Widget {
    let inherited = match parent {
        Option[Style]::Some(parent_style) => { widget.with_style(widget.style().inherit_text(parent_style)) }
        Option[Style]::None => { widget }
    }
    let id = inherited.id()
    let hovered = hovered_id != "" && widget_contains_id(inherited, hovered_id)
    let active = active_id != "" && widget_contains_id(inherited, active_id)
    let focused = id != "" && id == focused_id
    let focus_within = focused_id != "" && widget_contains_id(inherited, focused_id)
    let variables = compute_variables(sheet, inherited, ancestors, siblings, child_index, sibling_count,
        hovered, active, focused, focus_within, inherited_variables)
    let styled = inherited.with_style(compute_style(sheet, inherited, ancestors, siblings, child_index, sibling_count,
        hovered, active, focused, focus_within, variables))
    let source = styled.children()
    let mut children = Vec[Widget]::new()
    let child_ancestors = append_ancestor(ancestors, styled, child_index, sibling_count, siblings)
    let mut index = 0_usize
    while index < source.len() {
        match source.get(index) {
            Option[Widget]::Some(child) => {
                children.push(apply_stylesheet_node(sheet, child, hovered_id, active_id, focused_id,
                    Option[Style]::Some(styled.style()), child_ancestors, variables, source, index, source.len()))
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret styled.with_children(children)
}

fn widget_contains_id(widget: Widget, expected: str) -> bool {
    if widget.id() == expected { ret true }
    let children = widget.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => { if widget_contains_id(child, expected) { ret true } }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret false
}

pub fn css_style(declarations: str) -> Style { ret apply_css(Style::default(), declarations) }

pub fn apply_css(base: Style, declarations: str) -> Style {
    let mut style = base
    let values = css_declarations(declarations)
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[str]::Some(declaration) => { style = apply_declaration(style, declaration) }
            Option[str]::None => {}
        }
        index = index + 1_usize
    }
    ret style
}

fn apply_declaration(style: Style, declaration: str) -> Style {
    let colon = declaration_colon(declaration)
    if colon == declaration.char_len() { ret style }
    let property = trim(declaration.slice(0_usize, colon))
    let value = trim(declaration.slice(colon + 1_usize, declaration.char_len() - colon - 1_usize))
    if property == "background" || property == "background-color" { ret style.with_background(css_color(value)) }
    if property == "color" { ret style.with_foreground(css_color(value)) }
    if property == "border-color" { ret style.with_border(style.border_width(), css_color(value)) }
    if property == "border-width" { ret style.with_border(css_number(value), style.border_color()) }
    if property == "border" { ret css_border(style, value) }
    if property == "border-style" && value == "none" { ret style.with_border(0.0_f32, style.border_color()) }
    if property == "border-radius" { ret style.with_radius(css_number(value)) }
    if property == "outline" { ret css_outline(style, value) }
    if property == "outline-width" {
        ret style.with_outline(css_number(value), style.outline().color(), style.outline().offset())
    }
    if property == "outline-color" {
        ret style.with_outline(style.outline().width(), css_color(value), style.outline().offset())
    }
    if property == "outline-offset" {
        ret style.with_outline(style.outline().width(), style.outline().color(), css_number(value))
    }
    if property == "outline-style" && value == "none" {
        ret style.with_outline(0.0_f32, style.outline().color(), style.outline().offset())
    }
    if property == "box-shadow" { ret css_box_shadow(style, value) }
    if property == "padding" { ret style.with_padding(css_insets(value)) }
    if property == "padding-top" { ret style.with_padding(inset_top(style.padding(), css_number(value))) }
    if property == "padding-right" { ret style.with_padding(inset_right(style.padding(), css_number(value))) }
    if property == "padding-bottom" { ret style.with_padding(inset_bottom(style.padding(), css_number(value))) }
    if property == "padding-left" { ret style.with_padding(inset_left(style.padding(), css_number(value))) }
    if property == "margin" { ret style.with_margin(css_insets(value)) }
    if property == "margin-top" { ret style.with_margin(inset_top(style.layout().margin(), css_number(value))) }
    if property == "margin-right" { ret style.with_margin(inset_right(style.layout().margin(), css_number(value))) }
    if property == "margin-bottom" { ret style.with_margin(inset_bottom(style.layout().margin(), css_number(value))) }
    if property == "margin-left" { ret style.with_margin(inset_left(style.layout().margin(), css_number(value))) }
    if property == "width" {
        if ends_with(value, "%") { ret style.with_width_percent(css_number(value) / 100.0_f32) }
        ret style.with_width(css_dimension(value))
    }
    if property == "height" {
        if ends_with(value, "%") { ret style.with_height_percent(css_number(value) / 100.0_f32) }
        ret style.with_height(css_dimension(value))
    }
    if property == "min-width" { ret style.with_min_width(css_number(value)) }
    if property == "min-height" { ret style.with_min_height(css_number(value)) }
    if property == "max-width" { ret style.with_max_width(css_number(value)) }
    if property == "max-height" { ret style.with_max_height(css_number(value)) }
    if property == "box-sizing" { ret style.with_content_box(value == "content-box") }
    if property == "flex-direction" {
        if value == "row" || value == "row-reverse" {
            ret style.with_flex_direction(horizontal()).with_flex_direction_reverse(value == "row-reverse")
        }
        if value == "column" || value == "column-reverse" {
            ret style.with_flex_direction(vertical()).with_flex_direction_reverse(value == "column-reverse")
        }
        ret style
    }
    if property == "flex-basis" { ret style.with_flex_basis(css_dimension(value)) }
    if property == "flex-grow" { ret style.with_flex_grow(css_number(value)) }
    if property == "flex-shrink" { ret style.with_flex_shrink(css_number(value)) }
    if property == "flex" { ret css_flex(style, value) }
    if property == "flex-wrap" {
        ret style.with_flex_wrap(value == "wrap" || value == "wrap-reverse", value == "wrap-reverse")
    }
    if property == "flex-flow" { ret css_flex_flow(style, value) }
    if property == "justify-content" {
        if value == "center" { ret style.with_justify(justify_center()) }
        if value == "flex-end" || value == "end" { ret style.with_justify(justify_end()) }
        if value == "space-between" { ret style.with_justify(justify_space_between()) }
        if value == "space-around" { ret style.with_justify(justify_space_around()) }
        if value == "space-evenly" { ret style.with_justify(justify_space_evenly()) }
        ret style.with_justify(justify_start())
    }
    if property == "align-items" {
        if value == "flex-start" || value == "start" { ret style.with_align(align_start()) }
        if value == "center" { ret style.with_align(align_center()) }
        if value == "flex-end" || value == "end" { ret style.with_align(align_end()) }
        ret style.with_align(align_stretch())
    }
    if property == "align-self" {
        if value == "auto" { ret style.with_align_self(-1_i32) }
        if value == "flex-start" || value == "start" { ret style.with_align_self(align_start() as i32) }
        if value == "center" { ret style.with_align_self(align_center() as i32) }
        if value == "flex-end" || value == "end" { ret style.with_align_self(align_end() as i32) }
        ret style.with_align_self(align_stretch() as i32)
    }
    if property == "align-content" {
        if value == "start" || value == "flex-start" { ret style.with_align_content(align_content_start()) }
        if value == "center" { ret style.with_align_content(align_content_center()) }
        if value == "end" || value == "flex-end" { ret style.with_align_content(align_content_end()) }
        if value == "space-between" { ret style.with_align_content(align_content_space_between()) }
        if value == "space-around" { ret style.with_align_content(align_content_space_around()) }
        if value == "space-evenly" { ret style.with_align_content(align_content_space_evenly()) }
        ret style.with_align_content(align_content_stretch())
    }
    if property == "order" { ret style.with_order(css_number(value) as i32) }
    if property == "display" { ret style.with_displayed(value != "none").with_grid(value == "grid" || value == "inline-grid") }
    if property == "visibility" { ret style.with_visibility(value != "hidden" && value != "collapse") }
    if property == "pointer-events" { ret style.with_pointer_events(value != "none") }
    if property == "grid-template-columns" {
        let template = normalized_grid_template(value)
        ret style.with_grid_column_template(template, grid_column_count(template))
    }
    if property == "grid-template-rows" { ret style.with_grid_row_template(normalized_grid_template(value)) }
    if property == "grid-auto-columns" { ret style.with_grid_auto_columns(normalized_grid_template(value)) }
    if property == "grid-auto-rows" { ret style.with_grid_auto_rows(normalized_grid_template(value)) }
    if property == "grid-auto-flow" {
        let input = trim(value)
        ret style.with_grid_auto_flow(starts_with(input, "column"), input == "dense" || ends_with(input, " dense"))
    }
    if property == "grid-column" { ret css_grid_placement(style, value, true) }
    if property == "grid-row" { ret css_grid_placement(style, value, false) }
    if property == "grid-column-start" { ret style.with_grid_column(grid_line(value)) }
    if property == "grid-row-start" { ret style.with_grid_row(grid_line(value)) }
    if property == "grid-column-end" { ret css_grid_end(style, value, true) }
    if property == "grid-row-end" { ret css_grid_end(style, value, false) }
    if property == "overflow" || property == "overflow-x" || property == "overflow-y" {
        ret style.with_overflow_hidden(value == "hidden" || value == "clip" || value == "scroll" || value == "auto")
    }
    if property == "position" {
        if value == "absolute" || value == "fixed" { ret style.with_relative_position(false).with_absolute(true) }
        if value == "relative" { ret style.with_absolute(false).with_relative_position(true) }
        ret style.with_absolute(false).with_relative_position(false)
    }
    if property == "top" { ret if value == "auto" { style.without_top() } else { style.with_top(css_dimension(value)) } }
    if property == "right" { ret if value == "auto" { style.without_right() } else { style.with_right(css_dimension(value)) } }
    if property == "bottom" { ret if value == "auto" { style.without_bottom() } else { style.with_bottom(css_dimension(value)) } }
    if property == "left" { ret if value == "auto" { style.without_left() } else { style.with_left(css_dimension(value)) } }
    if property == "z-index" { ret style.with_z_index(if value == "auto" { 0_i32 } else { css_number(value) as i32 }) }
    if property == "gap" {
        let parts = css_tokens(value)
        let row = css_number(token_at(parts, 0_usize))
        let column = if parts.len() > 1_usize { css_number(token_at(parts, 1_usize)) } else { row }
        ret style.with_gap(row).with_row_gap(row).with_column_gap(column)
    }
    if property == "row-gap" { ret style.with_row_gap(css_number(value)) }
    if property == "column-gap" { ret style.with_column_gap(css_number(value)) }
    if property == "font-family" { ret style.with_font_family(css_font_family(value)) }
    if property == "font-size" { ret style.with_font_size(css_number(value)) }
    if property == "font-weight" { ret style.with_font_weight(css_number(value) as u32) }
    if property == "text-align" {
        if value == "center" { ret style.with_text_align(text_center()) }
        if value == "right" || value == "end" { ret style.with_text_align(text_end()) }
        ret style.with_text_align(text_start())
    }
    if property == "text-decoration" { ret css_text_decoration(style, value) }
    if property == "text-decoration-line" { ret css_text_decoration_line(style, value) }
    if property == "text-decoration-color" {
        let decoration = style.decoration()
        ret style.with_text_decoration(decoration.underline(), decoration.overline(), decoration.line_through(),
            css_color(value), true, decoration.thickness())
    }
    if property == "text-decoration-thickness" {
        let decoration = style.decoration()
        let thickness = if value == "auto" || value == "from-font" { 1.0_f32 } else { css_number(value) }
        ret style.with_text_decoration(decoration.underline(), decoration.overline(), decoration.line_through(),
            decoration.color(), decoration.color_set(), thickness)
    }
    if property == "opacity" { ret style.with_opacity(css_number(value)) }
    ret style
}

fn css_flex(style: Style, value: str) -> Style {
    let input = trim(value)
    if input == "none" { ret style.with_flex_grow(0.0_f32).with_flex_shrink(0.0_f32).with_flex_basis(-1.0_f32) }
    if input == "auto" { ret style.with_flex_grow(1.0_f32).with_flex_shrink(1.0_f32).with_flex_basis(-1.0_f32) }
    if input == "initial" { ret style.with_flex_grow(0.0_f32).with_flex_shrink(1.0_f32).with_flex_basis(-1.0_f32) }
    let parts = css_tokens(input)
    if parts.len() == 0_usize { ret style }
    let grow = css_number(token_at(parts, 0_usize))
    if parts.len() == 1_usize {
        ret style.with_flex_grow(grow).with_flex_shrink(1.0_f32).with_flex_basis(0.0_f32)
    }
    let second = token_at(parts, 1_usize)
    if parts.len() == 2_usize && (second == "auto" || ends_with(second, "px") || ends_with(second, "%")) {
        ret style.with_flex_grow(grow).with_flex_shrink(1.0_f32).with_flex_basis(css_dimension(second))
    }
    let shrink = css_number(second)
    let basis = if parts.len() >= 3_usize { css_dimension(token_at(parts, 2_usize)) } else { 0.0_f32 }
    ret style.with_flex_grow(grow).with_flex_shrink(shrink).with_flex_basis(basis)
}

fn css_flex_flow(style: Style, value: str) -> Style {
    let parts = css_tokens(value)
    let mut result = style
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "row" || token == "row-reverse" {
            result = result.with_flex_direction(horizontal()).with_flex_direction_reverse(token == "row-reverse")
        } elif token == "column" || token == "column-reverse" {
            result = result.with_flex_direction(vertical()).with_flex_direction_reverse(token == "column-reverse")
        } elif token == "nowrap" || token == "wrap" || token == "wrap-reverse" {
            result = result.with_flex_wrap(token != "nowrap", token == "wrap-reverse")
        }
        index = index + 1_usize
    }
    ret result
}

fn css_tokens(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index <= value.char_len() {
        let current = if index < value.char_len() { value.slice(index, 1_usize) } else { "" }
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "(" { depth = depth + 1_usize }
            elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        }
        if index == value.char_len() || (whitespace(current) && depth == 0_usize && quote == "") {
            if index > start { result.push(value.slice(start, index - start)) }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn token_at(values: Vec[str], index: usize) -> str {
    match values.get(index) {
        Option[str]::Some(value) => { ret value }
        Option[str]::None => { ret "" }
    }
}

fn css_font_family(value: str) -> str {
    let mut end = value.char_len()
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == "," { end = index break }
        index = index + 1_usize
    }
    let family = trim(value.slice(0_usize, end))
    if family.char_len() >= 2_usize {
        let first = family.slice(0_usize, 1_usize)
        let last = family.slice(family.char_len() - 1_usize, 1_usize)
        if (first == "\"" && last == "\"") || (first == "'" && last == "'") {
            ret family.slice(1_usize, family.char_len() - 2_usize)
        }
    }
    ret family
}

fn css_dimension(value: str) -> f32 {
    if trim(value) == "auto" { ret -1.0_f32 }
    ret css_number(value)
}

fn css_border(style: Style, value: str) -> Style {
    if trim(value) == "none" { ret style.with_border(0.0_f32, style.border_color()) }
    let mut width = style.border_width()
    let mut color = style.border_color()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut part = 0_usize
    while index <= value.char_len() {
        if index == value.char_len() || whitespace(value.slice(index, 1_usize)) {
            if index > start {
                let token = trim(value.slice(start, index - start))
                if part == 0_usize { width = css_number(token) }
                elif token != "solid" && token != "dashed" && token != "dotted" && token != "double" { color = css_color(token) }
                part = part + 1_usize
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret style.with_border(width, color)
}

fn css_outline(style: Style, value: str) -> Style {
    if trim(value) == "none" { ret style.with_outline(0.0_f32, style.outline().color(), style.outline().offset()) }
    let mut width = style.outline().width()
    let mut color = style.outline().color()
    let parts = css_tokens(value)
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if ends_with(token, "px") || decimal_digit(token.slice(0_usize, 1_usize)) >= 0_i32 { width = css_number(token) }
        elif token != "solid" && token != "dashed" && token != "dotted" && token != "double" { color = css_color(token) }
        index = index + 1_usize
    }
    ret style.with_outline(width, color, style.outline().offset())
}

fn css_box_shadow(style: Style, value: str) -> Style {
    if trim(value) == "none" { ret style.with_shadow(0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32, transparent(), false) }
    let parts = css_tokens(value)
    let mut dimensions = Vec[f32]::new()
    let mut color = black()
    let mut inset = false
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "inset" { inset = true }
        elif css_numeric_token(token) { dimensions.push(css_number(token)) }
        else { color = css_color(token) }
        index = index + 1_usize
    }
    if dimensions.len() < 2_usize { ret style }
    ret style.with_shadow(number_at(dimensions, 0_usize), number_at(dimensions, 1_usize),
        if dimensions.len() > 2_usize { number_at(dimensions, 2_usize) } else { 0.0_f32 },
        if dimensions.len() > 3_usize { number_at(dimensions, 3_usize) } else { 0.0_f32 }, color, inset)
}

fn css_text_decoration(style: Style, value: str) -> Style {
    if trim(value) == "none" {
        ret style.with_text_decoration(false, false, false, transparent(), false, 1.0_f32)
    }
    let parts = css_tokens(value)
    let mut underline = false
    let mut overline = false
    let mut line_through = false
    let mut color = transparent()
    let mut color_set = false
    let mut thickness = 1.0_f32
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "underline" { underline = true }
        elif token == "overline" { overline = true }
        elif token == "line-through" { line_through = true }
        elif token == "solid" || token == "double" || token == "dotted" || token == "dashed" || token == "wavy" {}
        elif css_numeric_token(token) { thickness = css_number(token) }
        else { color = css_color(token) color_set = true }
        index = index + 1_usize
    }
    ret style.with_text_decoration(underline, overline, line_through, color, color_set, thickness)
}

fn css_text_decoration_line(style: Style, value: str) -> Style {
    let decoration = style.decoration()
    let parts = css_tokens(value)
    let mut underline = false
    let mut overline = false
    let mut line_through = false
    let mut index = 0_usize
    while index < parts.len() {
        let token = token_at(parts, index)
        if token == "underline" { underline = true }
        elif token == "overline" { overline = true }
        elif token == "line-through" { line_through = true }
        index = index + 1_usize
    }
    ret style.with_text_decoration(underline, overline, line_through, decoration.color(),
        decoration.color_set(), decoration.thickness())
}

fn css_numeric_token(value: str) -> bool {
    if value == "" { ret false }
    let first = value.slice(0_usize, 1_usize)
    ret decimal_digit(first) >= 0_i32 || first == "-" || first == "." || first == "+"
}

fn grid_column_count(value: str) -> usize {
    let input = trim(value)
    let mut count = 0_usize
    let mut index = 0_usize
    if input != "" { count = 1_usize }
    while index < input.char_len() {
        if input.slice(index, 1_usize) == "|" { count = count + 1_usize }
        index = index + 1_usize
    }
    ret if count > 0_usize { count } else { 1_usize }
}

fn normalized_grid_template(value: str) -> str {
    let tokens = css_tokens(trim(value))
    let mut result = ""
    let mut index = 0_usize
    while index < tokens.len() {
        let token = token_at(tokens, index)
        let expanded = if starts_with(token, "repeat(") && ends_with(token, ")") {
            expand_grid_repeat(token)
        } else { token }
        if expanded != "" {
            if result != "" { result = result + "|" }
            result = result + expanded
        }
        index = index + 1_usize
    }
    ret if result == "" { "1fr" } else { result }
}

fn css_grid_placement(style: Style, value: str, column: bool) -> Style {
    let slash = find_character(value, "/", 0_usize)
    let start = grid_line(trim(value.slice(0_usize, slash)))
    let with_start = if column { style.with_grid_column(start) } else { style.with_grid_row(start) }
    if slash == value.char_len() { ret with_start }
    ret css_grid_end(with_start, trim(value.slice(slash + 1_usize, value.char_len() - slash - 1_usize)), column)
}

fn css_grid_end(style: Style, value: str, column: bool) -> Style {
    let input = trim(value)
    if starts_with(input, "span ") {
        let span = css_number(trim(input.slice(5_usize, input.char_len() - 5_usize))) as usize
        ret if column { style.with_grid_column_span(span) } else { style.with_grid_row_span(span) }
    }
    let line = grid_line(input)
    ret if column { style.with_grid_column_end(line) } else { style.with_grid_row_end(line) }
}

fn grid_line(value: str) -> usize { ret if trim(value) == "auto" { 0_usize } else { css_number(value) as usize } }

fn expand_grid_repeat(value: str) -> str {
    let inner = value.slice(7_usize, value.char_len() - 8_usize)
    let comma = find_character(inner, ",", 0_usize)
    if comma == inner.char_len() { ret "" }
    let count = css_number(trim(inner.slice(0_usize, comma))) as usize
    let tracks = normalized_grid_template(trim(inner.slice(comma + 1_usize, inner.char_len() - comma - 1_usize)))
    let mut result = ""
    let mut index = 0_usize
    while index < count {
        if result != "" { result = result + "|" }
        result = result + tracks
        index = index + 1_usize
    }
    ret result
}

fn inset_top(value: Insets, top: f32) -> Insets { ret Insets::only(top, value.right(), value.bottom(), value.left()) }
fn inset_right(value: Insets, right: f32) -> Insets { ret Insets::only(value.top(), right, value.bottom(), value.left()) }
fn inset_bottom(value: Insets, bottom: f32) -> Insets { ret Insets::only(value.top(), value.right(), bottom, value.left()) }
fn inset_left(value: Insets, left: f32) -> Insets { ret Insets::only(value.top(), value.right(), value.bottom(), left) }

pub fn css_insets(value: str) -> Insets {
    let values = css_numbers(value)
    if values.len() == 0_usize { ret Insets::all(0.0_f32) }
    let first = number_at(values, 0_usize)
    if values.len() == 1_usize { ret Insets::all(first) }
    let second = number_at(values, 1_usize)
    if values.len() == 2_usize { ret Insets::symmetric(first, second) }
    let third = number_at(values, 2_usize)
    if values.len() == 3_usize { ret Insets::only(first, second, third, second) }
    ret Insets::only(first, second, third, number_at(values, 3_usize))
}

fn css_numbers(value: str) -> Vec[f32] {
    let mut result = Vec[f32]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= value.char_len() {
        if index == value.char_len() || whitespace(value.slice(index, 1_usize)) {
            if index > start { result.push(css_number(value.slice(start, index - start))) }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn number_at(values: Vec[f32], index: usize) -> f32 {
    match values.get(index) {
        Option[f32]::Some(value) => { ret value }
        Option[f32]::None => { ret 0.0_f32 }
    }
}

pub fn css_color(value: str) -> Color {
    let input = trim(value)
    if input == "transparent" { ret transparent() }
    if input == "white" { ret white() }
    if input == "black" { ret black() }
    if input == "red" { ret Color::rgb(255_u8, 0_u8, 0_u8) }
    if input == "green" { ret Color::rgb(0_u8, 128_u8, 0_u8) }
    if input == "blue" { ret Color::rgb(0_u8, 0_u8, 255_u8) }
    if input == "gray" || input == "grey" { ret Color::rgb(128_u8, 128_u8, 128_u8) }
    if starts_with(input, "rgb(") || starts_with(input, "rgba(") {
        let open = find_character(input, "(", 0_usize)
        let components = input.slice(open + 1_usize, input.char_len() - open - 2_usize)
        let tokens = css_component_tokens(components)
        if tokens.len() >= 3_usize {
            ret Color::rgba(css_rgb_component(token_at(tokens, 0_usize)),
                css_rgb_component(token_at(tokens, 1_usize)),
                css_rgb_component(token_at(tokens, 2_usize)),
                css_alpha_component(if tokens.len() >= 4_usize { token_at(tokens, 3_usize) } else { "1" }))
        }
    }
    if starts_with(input, "hsl(") || starts_with(input, "hsla(") {
        let open = find_character(input, "(", 0_usize)
        let components = input.slice(open + 1_usize, input.char_len() - open - 2_usize)
        let tokens = css_component_tokens(components)
        if tokens.len() >= 3_usize {
            let alpha = if tokens.len() >= 4_usize {
                let token = token_at(tokens, 3_usize)
                if ends_with(token, "%") { css_number(token) / 100.0_f32 } else { css_number(token) }
            } else { 1.0_f32 }
            ret hsl_color(css_hue(token_at(tokens, 0_usize)), css_number(token_at(tokens, 1_usize)),
                css_number(token_at(tokens, 2_usize)), alpha)
        }
    }
    if input.char_len() == 4_usize && input.slice(0_usize, 1_usize) == "#" {
        ret Color::rgb(hex_pair(input.slice(1_usize, 1_usize) + input.slice(1_usize, 1_usize)),
            hex_pair(input.slice(2_usize, 1_usize) + input.slice(2_usize, 1_usize)),
            hex_pair(input.slice(3_usize, 1_usize) + input.slice(3_usize, 1_usize)))
    }
    if input.char_len() == 5_usize && input.slice(0_usize, 1_usize) == "#" {
        ret Color::rgba(hex_pair(input.slice(1_usize, 1_usize) + input.slice(1_usize, 1_usize)),
            hex_pair(input.slice(2_usize, 1_usize) + input.slice(2_usize, 1_usize)),
            hex_pair(input.slice(3_usize, 1_usize) + input.slice(3_usize, 1_usize)),
            hex_pair(input.slice(4_usize, 1_usize) + input.slice(4_usize, 1_usize)))
    }
    if (input.char_len() == 7_usize || input.char_len() == 9_usize) && input.slice(0_usize, 1_usize) == "#" {
        let alpha = if input.char_len() == 9_usize { hex_pair(input.slice(7_usize, 2_usize)) } else { 255_u8 }
        ret Color::rgba(hex_pair(input.slice(1_usize, 2_usize)), hex_pair(input.slice(3_usize, 2_usize)),
            hex_pair(input.slice(5_usize, 2_usize)), alpha)
    }
    ret transparent()
}

fn css_component_tokens(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    while index <= value.char_len() {
        let current = if index < value.char_len() { value.slice(index, 1_usize) } else { "" }
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        let separator = depth == 0_usize && (current == "," || current == "/" || whitespace(current))
        if index == value.char_len() || separator {
            let token = trim(value.slice(start, index - start))
            if token != "" { result.push(token) }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn css_rgb_component(value: str) -> u8 {
    if ends_with(value, "%") {
        let percent = clamp_range(css_number(value), 0.0_f32, 100.0_f32)
        ret css_percent_byte(percent)
    }
    ret rounded_color_component(css_number(value))
}

fn css_alpha_component(value: str) -> u8 {
    if ends_with(value, "%") {
        let percent = clamp_range(css_number(value), 0.0_f32, 100.0_f32)
        ret css_percent_byte(percent)
    }
    let alpha = css_number(value)
    ret rounded_color_component(if alpha <= 1.0_f32 { clamp_unit(alpha) * 255.0_f32 } else { alpha })
}

fn css_percent_byte(percent: f32) -> u8 {
    if percent <= 0.0_f32 { ret 0_u8 }
    if percent >= 100.0_f32 { ret 255_u8 }
    let fixed = (percent * 1000.0_f32) as usize
    ret ((fixed * 255_usize + 50000_usize) / 100000_usize) as u8
}

fn css_hue(value: str) -> f32 {
    let number = css_number(value)
    if ends_with(value, "turn") { ret number * 360.0_f32 }
    if ends_with(value, "grad") { ret number * 0.9_f32 }
    if ends_with(value, "rad") { ret number * 57.29578_f32 }
    ret number
}

fn hsl_color(hue: f32, saturation_percent: f32, lightness_percent: f32, alpha_value: f32) -> Color {
    let mut h = hue
    while h < 0.0_f32 { h = h + 360.0_f32 }
    while h >= 360.0_f32 { h = h - 360.0_f32 }
    let s = clamp_unit(saturation_percent / 100.0_f32)
    let l = clamp_unit(lightness_percent / 100.0_f32)
    let chroma = (1.0_f32 - absolute(2.0_f32 * l - 1.0_f32)) * s
    let sector = h / 60.0_f32
    let sector_pair = sector - ((sector as usize / 2_usize) * 2_usize) as f32
    let x = chroma * (1.0_f32 - absolute(sector_pair - 1.0_f32))
    let mut red = 0.0_f32
    let mut green = 0.0_f32
    let mut blue = 0.0_f32
    if sector < 1.0_f32 { red = chroma green = x }
    elif sector < 2.0_f32 { red = x green = chroma }
    elif sector < 3.0_f32 { green = chroma blue = x }
    elif sector < 4.0_f32 { green = x blue = chroma }
    elif sector < 5.0_f32 { red = x blue = chroma }
    else { red = chroma blue = x }
    let match_value = l - chroma / 2.0_f32
    let alpha = if alpha_value <= 1.0_f32 { clamp_unit(alpha_value) * 255.0_f32 }
        else { clamp_range(alpha_value, 0.0_f32, 255.0_f32) }
    ret Color::rgba(rounded_color_component((red + match_value) * 255.0_f32),
        rounded_color_component((green + match_value) * 255.0_f32),
        rounded_color_component((blue + match_value) * 255.0_f32), rounded_color_component(alpha))
}

fn rounded_color_component(value: f32) -> u8 {
    if value <= 0.0_f32 { ret 0_u8 }
    if value >= 255.0_f32 { ret 255_u8 }
    ret (value + 0.5_f32) as u8
}

fn absolute(value: f32) -> f32 { ret if value < 0.0_f32 { -value } else { value } }
fn clamp_unit(value: f32) -> f32 { ret clamp_range(value, 0.0_f32, 1.0_f32) }
fn clamp_range(value: f32, minimum: f32, maximum: f32) -> f32 {
    if value < minimum { ret minimum }
    if value > maximum { ret maximum }
    ret value
}

pub fn css_number(value: str) -> f32 {
    let input = trim(value)
    let mut result = 0.0_f32
    let mut fraction = 0.1_f32
    let mut after_dot = false
    let mut negative = false
    let mut index = 0_usize
    while index < input.char_len() {
        let current = input.slice(index, 1_usize)
        if index == 0_usize && current == "-" { negative = true }
        elif current == "." { after_dot = true }
        else {
            let digit = decimal_digit(current)
            if digit < 0_i32 { break }
            if after_dot { result = result + (digit as f32) * fraction fraction = fraction * 0.1_f32 }
            else { result = result * 10.0_f32 + digit as f32 }
        }
        index = index + 1_usize
    }
    ret if negative { -result } else { result }
}

fn decimal_digit(value: str) -> i32 {
    if value == "0" { ret 0_i32 } if value == "1" { ret 1_i32 }
    if value == "2" { ret 2_i32 } if value == "3" { ret 3_i32 }
    if value == "4" { ret 4_i32 } if value == "5" { ret 5_i32 }
    if value == "6" { ret 6_i32 } if value == "7" { ret 7_i32 }
    if value == "8" { ret 8_i32 } if value == "9" { ret 9_i32 }
    ret -1_i32
}

fn hex_pair(value: str) -> u8 { ret (hex_digit(value.slice(0_usize, 1_usize)) * 16_usize + hex_digit(value.slice(1_usize, 1_usize))) as u8 }
fn hex_digit(value: str) -> usize {
    let digit = decimal_digit(value)
    if digit >= 0_i32 { ret digit as usize }
    if value == "a" || value == "A" { ret 10_usize }
    if value == "b" || value == "B" { ret 11_usize }
    if value == "c" || value == "C" { ret 12_usize }
    if value == "d" || value == "D" { ret 13_usize }
    if value == "e" || value == "E" { ret 14_usize }
    if value == "f" || value == "F" { ret 15_usize }
    ret 0_usize
}

fn trim(value: str) -> str {
    let mut start = 0_usize
    let mut finish = value.char_len()
    while start < finish && whitespace(value.slice(start, 1_usize)) { start = start + 1_usize }
    while finish > start && whitespace(value.slice(finish - 1_usize, 1_usize)) { finish = finish - 1_usize }
    ret value.slice(start, finish - start)
}
fn whitespace(value: str) -> bool { ret value == " " || value == "\n" || value == "\r" || value == "\t" }

fn append_selector_rules(rules: mut Vec[StyleRule], selectors: str, declarations: str) -> () {
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() { selectors.slice(index, 1_usize) } else { "" }
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        if index == selectors.char_len() || (current == "," && depth == 0_usize) {
            let selector = trim(selectors.slice(start, index - start))
            if selector != "" { rules.push(StyleRule { selector, declarations, selector_specificity(selector) }) }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret ()
}

fn collect_variables(variables: mut Vec[CssVariable], declarations: str) -> () {
    let values = css_declarations(declarations)
    let mut index = 0_usize
    while index < values.len() {
        match values.get(index) {
            Option[str]::Some(declaration) => {
                let colon = declaration_colon(declaration)
                if colon < declaration.char_len() {
                    let name = trim(declaration.slice(0_usize, colon))
                    if starts_with(name, "--") {
                        set_variable(variables, name,
                            trim(declaration.slice(colon + 1_usize, declaration.char_len() - colon - 1_usize)))
                    }
                }
            }
            Option[str]::None => {}
        }
        index = index + 1_usize
    }
    ret ()
}

fn css_declarations(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index <= value.char_len() {
        let current = if index < value.char_len() { value.slice(index, 1_usize) } else { "" }
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "(" { depth = depth + 1_usize }
            elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        }
        if index == value.char_len() || (current == ";" && quote == "" && depth == 0_usize) {
            let declaration = trim(value.slice(start, index - start))
            if declaration != "" { result.push(declaration) }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret result
}

fn declaration_colon(value: str) -> usize {
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "(" { depth = depth + 1_usize }
            elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
            elif current == ":" && depth == 0_usize { ret index }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn set_variable(variables: mut Vec[CssVariable], name: str, value: str) -> () {
    let mut index = 0_usize
    while index < variables.len() {
        match variables.get(index) {
            Option[CssVariable]::Some(variable) => {
                if variable.name == name { variables.set(index, CssVariable { name, value }) ret () }
            }
            Option[CssVariable]::None => {}
        }
        index = index + 1_usize
    }
    variables.push(CssVariable { name, value })
    ret ()
}

fn resolve_variables(declarations: str, variables: Vec[CssVariable]) -> str {
    let mut result = declarations
    let mut pass = 0_usize
    while pass < 8_usize {
        let resolved = resolve_variables_once(result, variables)
        if resolved == result { ret result }
        result = resolved
        pass = pass + 1_usize
    }
    ret result
}

fn resolve_variables_once(declarations: str, variables: Vec[CssVariable]) -> str {
    let mut result = ""
    let mut cursor = 0_usize
    while cursor < declarations.char_len() {
        let open = find_text(declarations, "var(", cursor)
        if open == declarations.char_len() {
            result = result + declarations.slice(cursor, declarations.char_len() - cursor)
            break
        }
        result = result + declarations.slice(cursor, open - cursor)
        let close = matching_parenthesis(declarations, open + 3_usize)
        if close == declarations.char_len() {
            result = result + declarations.slice(open, declarations.char_len() - open)
            break
        }
        let expression = declarations.slice(open + 4_usize, close - open - 4_usize)
        let comma = top_level_comma(expression)
        let name = trim(if comma < expression.char_len() { expression.slice(0_usize, comma) } else { expression })
        let fallback = if comma < expression.char_len() {
            trim(expression.slice(comma + 1_usize, expression.char_len() - comma - 1_usize))
        } else { "" }
        result = result + variable_value(variables, name, fallback)
        cursor = close + 1_usize
    }
    ret result
}

fn top_level_comma(value: str) -> usize {
    let mut index = 0_usize
    let mut depth = 0_usize
    let mut quote = ""
    let mut escaped = false
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "(" { depth = depth + 1_usize }
            elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
            elif current == "," && depth == 0_usize { ret index }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn variable_value(variables: Vec[CssVariable], name: str, fallback: str) -> str {
    let mut index = variables.len()
    while index > 0_usize {
        index = index - 1_usize
        match variables.get(index) {
            Option[CssVariable]::Some(variable) => { if variable.name == name { ret variable.value } }
            Option[CssVariable]::None => {}
        }
    }
    ret fallback
}

fn find_text(value: str, expected: str, start: usize) -> usize {
    let mut index = start
    while index + expected.char_len() <= value.char_len() {
        if value.slice(index, expected.char_len()) == expected { ret index }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn strip_comments(source: str) -> str {
    let mut result = ""
    let mut index = 0_usize
    let mut comment = false
    let mut quote = ""
    let mut escaped = false
    while index < source.char_len() {
        let current = source.slice(index, 1_usize)
        let next = if index + 1_usize < source.char_len() { source.slice(index + 1_usize, 1_usize) } else { "" }
        if !comment && quote == "" && current == "/" && next == "*" {
            comment = true
            result = result + " "
            index = index + 2_usize
        }
        elif comment && current == "*" && next == "/" { comment = false index = index + 2_usize }
        else {
            if !comment {
                result = result + current
                if quote != "" {
                    if escaped { escaped = false }
                    elif current == "\\" { escaped = true }
                    elif current == quote { quote = "" }
                } elif current == "\"" || current == "'" { quote = current }
            }
            index = index + 1_usize
        }
    }
    ret result
}

fn starts_with(value: str, prefix: str) -> bool {
    ret value.char_len() >= prefix.char_len() && value.slice(0_usize, prefix.char_len()) == prefix
}

fn ends_with(value: str, suffix: str) -> bool {
    ret value.char_len() >= suffix.char_len() &&
        value.slice(value.char_len() - suffix.char_len(), suffix.char_len()) == suffix
}

fn find_character(value: str, character: str, start: usize) -> usize {
    let mut index = start
    while index < value.char_len() {
        if value.slice(index, 1_usize) == character { ret index }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn selector_specificity(selector: str) -> usize {
    let mut score = 0_usize
    let mut index = 0_usize
    let mut expect_type = true
    while index < selector.char_len() {
        let current = selector.slice(index, 1_usize)
        if whitespace(current) || current == ">" || current == "+" || current == "~" {
            expect_type = true
            index = index + 1_usize
        }
        elif current == "#" {
            score = score + 100_usize
            index = selector_part_end(selector, index + 1_usize)
            expect_type = false
        }
        elif current == "." {
            score = score + 10_usize
            index = selector_part_end(selector, index + 1_usize)
            expect_type = false
        }
        elif current == "[" {
            score = score + 10_usize
            let close = matching_bracket(selector, index)
            index = if close < selector.char_len() { close + 1_usize } else { selector.char_len() }
            expect_type = false
        }
        elif current == ":" {
            let name_end = pseudo_name_end(selector, index + 1_usize)
            let name = selector.slice(index + 1_usize, name_end - index - 1_usize)
            if name_end < selector.char_len() && selector.slice(name_end, 1_usize) == "(" {
                let close = matching_parenthesis(selector, name_end)
                if close == selector.char_len() { ret score + 10_usize }
                let content = selector.slice(name_end + 1_usize, close - name_end - 1_usize)
                if name == "is" || name == "not" || name == "has" {
                    score = score + selector_list_specificity(content)
                } elif name != "where" { score = score + 10_usize }
                index = close + 1_usize
            } else {
                score = score + 10_usize
                index = name_end
            }
            expect_type = false
        }
        elif current == "*" {
            expect_type = false
            index = index + 1_usize
        }
        else {
            if expect_type { score = score + 1_usize }
            index = selector_part_end(selector, index)
            expect_type = false
        }
    }
    ret score
}

fn selector_list_specificity(selectors: str) -> usize {
    let mut maximum = 0_usize
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut index = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() { selectors.slice(index, 1_usize) } else { "" }
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        if index == selectors.char_len() || (current == "," && depth == 0_usize) {
            let specificity = selector_specificity(trim(selectors.slice(start, index - start)))
            if specificity > maximum { maximum = specificity }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret maximum
}

fn selector_matches(selector: str, widget: Widget, child_index: usize, sibling_count: usize, siblings: Vec[Widget],
    root: bool, hovered: bool, active: bool, focused: bool, focus_within: bool) -> bool {
    let input = trim(selector)
    if input == "*" { ret true }
    let mut index = 0_usize
    if input.char_len() > 0_usize {
        let first = input.slice(0_usize, 1_usize)
        if first != "." && first != "#" && first != ":" && first != "[" && first != "*" {
            let finish = selector_part_end(input, 0_usize)
            if input.slice(0_usize, finish) != widget_type(widget) { ret false }
            index = finish
        } elif first == "*" { index = 1_usize }
    }
    while index < input.char_len() {
        let marker = input.slice(index, 1_usize)
        if marker == "[" {
            let close = matching_bracket(input, index)
            if close == input.char_len() || !attribute_selector_matches(input.slice(index + 1_usize, close - index - 1_usize), widget) { ret false }
            index = close + 1_usize
        } elif marker != "." && marker != "#" && marker != ":" { ret false }
        else {
        let finish = selector_part_end(input, index + 1_usize)
        let value = input.slice(index + 1_usize, finish - index - 1_usize)
        if marker == "." && !has_class(widget.classes(), value) { ret false }
        if marker == "#" && widget.id() != value { ret false }
        if marker == ":" {
            if starts_with(value, "not(") {
                if functional_selector_matches(value, widget, child_index, sibling_count, siblings,
                    root, hovered, active, focused, focus_within) { ret false }
            }
            elif starts_with(value, "is(") || starts_with(value, "where(") {
                if !functional_selector_matches(value, widget, child_index, sibling_count, siblings,
                    root, hovered, active, focused, focus_within) { ret false }
            }
            elif starts_with(value, "has(") {
                if !has_selector_matches(value, widget) { ret false }
            }
            elif value == "hover" && !hovered { ret false }
            elif value == "active" && !active { ret false }
            elif value == "focus" && !focused && !widget.focused() { ret false }
            elif value == "checked" && !widget.checked() { ret false }
            elif value == "disabled" && !widget.disabled() { ret false }
            elif value == "enabled" && widget.disabled() { ret false }
            elif value == "focus-visible" && !focused && !widget.focused() { ret false }
            elif value == "focus-within" && !focus_within && !widget_contains_focus(widget) { ret false }
            elif value == "root" && !root { ret false }
            elif value == "required" && !widget_has_attribute(widget, "required") { ret false }
            elif value == "optional" && (!form_control(widget) || widget_has_attribute(widget, "required")) { ret false }
            elif value == "read-write" && !read_write_control(widget) { ret false }
            elif value == "read-only" && read_write_control(widget) { ret false }
            elif value == "placeholder-shown" && (!read_write_control(widget) || widget.text() != "" || !widget_has_attribute(widget, "placeholder")) { ret false }
            elif (value == "link" || value == "any-link") && widget.kind() != widget_link() { ret false }
            elif value == "first-child" && child_index != 0_usize { ret false }
            elif value == "last-child" && child_index + 1_usize != sibling_count { ret false }
            elif value == "only-child" && sibling_count != 1_usize { ret false }
            elif starts_with(value, "nth-child(") && !nth_child_matches(value, child_index + 1_usize) { ret false }
            elif starts_with(value, "nth-last-child(") && !nth_last_child_matches(value, sibling_count - child_index) { ret false }
            elif value == "first-of-type" && type_position(widget, siblings, child_index, false) != 1_usize { ret false }
            elif value == "last-of-type" && type_position(widget, siblings, child_index, true) != 1_usize { ret false }
            elif value == "only-of-type" && type_sibling_count(widget, siblings) != 1_usize { ret false }
            elif starts_with(value, "nth-of-type(") && !nth_of_type_matches(value, type_position(widget, siblings, child_index, false)) { ret false }
            elif starts_with(value, "nth-last-of-type(") && !nth_last_of_type_matches(value, type_position(widget, siblings, child_index, true)) { ret false }
            elif value == "empty" && (widget.text() != "" || widget.children().len() != 0_usize) { ret false }
            elif value != "hover" && value != "active" && value != "focus" && value != "checked" &&
                value != "disabled" && value != "enabled" && value != "focus-visible" && value != "focus-within" && value != "root" &&
                value != "required" && value != "optional" && value != "read-write" && value != "read-only" &&
                value != "placeholder-shown" && value != "link" && value != "any-link" &&
                value != "first-child" && value != "last-child" && value != "only-child" && value != "empty" &&
                !starts_with(value, "nth-child(") && !starts_with(value, "nth-last-child(") &&
                value != "first-of-type" && value != "last-of-type" && value != "only-of-type" &&
                !starts_with(value, "nth-of-type(") && !starts_with(value, "nth-last-of-type(") &&
                !starts_with(value, "not(") && !starts_with(value, "is(") && !starts_with(value, "where(") &&
                !starts_with(value, "has(") { ret false }
        }
        index = finish
        }
    }
    ret true
}

fn widget_contains_focus(widget: Widget) -> bool {
    if widget.focused() { ret true }
    let children = widget.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => { if widget_contains_focus(child) { ret true } }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret false
}

fn functional_selector_matches(value: str, widget: Widget, child_index: usize, sibling_count: usize, siblings: Vec[Widget],
    root: bool, hovered: bool, active: bool, focused: bool, focus_within: bool) -> bool {
    let open = find_character(value, "(", 0_usize)
    if open == value.char_len() || !ends_with(value, ")") { ret false }
    let selectors = value.slice(open + 1_usize, value.char_len() - open - 2_usize)
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut index = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() { selectors.slice(index, 1_usize) } else { "" }
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        if index == selectors.char_len() || (current == "," && depth == 0_usize) {
            let selector = trim(selectors.slice(start, index - start))
            if selector_matches(selector, widget, child_index, sibling_count, siblings,
                root, hovered, active, focused, focus_within) { ret true }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret false
}

fn has_selector_matches(value: str, widget: Widget) -> bool {
    let open = find_character(value, "(", 0_usize)
    if open == value.char_len() || !ends_with(value, ")") { ret false }
    let selectors = value.slice(open + 1_usize, value.char_len() - open - 2_usize)
    let mut start = 0_usize
    let mut depth = 0_usize
    let mut index = 0_usize
    while index <= selectors.char_len() {
        let current = if index < selectors.char_len() { selectors.slice(index, 1_usize) } else { "" }
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        if index == selectors.char_len() || (current == "," && depth == 0_usize) {
            let selector = trim(selectors.slice(start, index - start))
            if relative_selector_matches(selector, widget) { ret true }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret false
}

fn relative_selector_matches(selector: str, widget: Widget) -> bool {
    if selector == "" { ret false }
    let children = widget.children()
    let ancestors = append_ancestor(Vec[SelectorNode]::new(), widget, 0_usize, 1_usize, singleton_widget(widget))
    if starts_with(selector, ">") {
        let target = trim(selector.slice(1_usize, selector.char_len() - 1_usize))
        let mut index = 0_usize
        while index < children.len() {
            match children.get(index) {
                Option[Widget]::Some(child) => {
                    if selector_tree_matches(target, child, ancestors, ancestors.len(), children, index, children.len(),
                        false, false, false, false) { ret true }
                }
                Option[Widget]::None => {}
            }
            index = index + 1_usize
        }
        ret false
    }
    ret descendant_selector_matches(selector, widget, Vec[SelectorNode]::new(),
        singleton_widget(widget), 0_usize, 1_usize)
}

fn descendant_selector_matches(selector: str, widget: Widget, ancestors: Vec[SelectorNode],
    siblings: Vec[Widget], child_index: usize, sibling_count: usize) -> bool {
    let children = widget.children()
    let child_ancestors = append_ancestor(ancestors, widget, child_index, sibling_count, siblings)
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                if selector_tree_matches(selector, child, child_ancestors, child_ancestors.len(), children,
                    index, children.len(), false, false, false, false) { ret true }
                if descendant_selector_matches(selector, child, child_ancestors, children, index, children.len()) { ret true }
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret false
}

fn nth_child_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-child(") || !ends_with(pseudo, ")") { ret false }
    ret nth_expression_matches(trim(pseudo.slice(10_usize, pseudo.char_len() - 11_usize)), position)
}

fn nth_last_child_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-last-child(") || !ends_with(pseudo, ")") { ret false }
    ret nth_expression_matches(trim(pseudo.slice(15_usize, pseudo.char_len() - 16_usize)), position)
}

fn nth_of_type_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-of-type(") || !ends_with(pseudo, ")") { ret false }
    ret nth_expression_matches(trim(pseudo.slice(12_usize, pseudo.char_len() - 13_usize)), position)
}

fn nth_last_of_type_matches(pseudo: str, position: usize) -> bool {
    if !starts_with(pseudo, "nth-last-of-type(") || !ends_with(pseudo, ")") { ret false }
    ret nth_expression_matches(trim(pseudo.slice(17_usize, pseudo.char_len() - 18_usize)), position)
}

fn type_position(widget: Widget, siblings: Vec[Widget], child_index: usize, from_end: bool) -> usize {
    let expected = widget_type(widget)
    let mut position = 0_usize
    if from_end {
        let mut index = siblings.len()
        while index > child_index {
            index = index - 1_usize
            match siblings.get(index) {
                Option[Widget]::Some(sibling) => { if widget_type(sibling) == expected { position = position + 1_usize } }
                Option[Widget]::None => {}
            }
        }
    } else {
        let mut index = 0_usize
        while index <= child_index && index < siblings.len() {
            match siblings.get(index) {
                Option[Widget]::Some(sibling) => { if widget_type(sibling) == expected { position = position + 1_usize } }
                Option[Widget]::None => {}
            }
            index = index + 1_usize
        }
    }
    ret position
}

fn type_sibling_count(widget: Widget, siblings: Vec[Widget]) -> usize {
    let expected = widget_type(widget)
    let mut count = 0_usize
    let mut index = 0_usize
    while index < siblings.len() {
        match siblings.get(index) {
            Option[Widget]::Some(sibling) => { if widget_type(sibling) == expected { count = count + 1_usize } }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret count
}

fn nth_expression_matches(expression: str, position: usize) -> bool {
    if expression == "odd" { ret position % 2_usize == 1_usize }
    if expression == "even" { ret position % 2_usize == 0_usize }
    let n = find_character(expression, "n", 0_usize)
    if n == expression.char_len() { ret css_number(expression) as usize == position }
    let coefficient = trim(expression.slice(0_usize, n))
    let a = if coefficient == "" || coefficient == "+" { 1_i32 }
        elif coefficient == "-" { -1_i32 } else { css_number(coefficient) as i32 }
    let remainder = trim(expression.slice(n + 1_usize, expression.char_len() - n - 1_usize))
    let b = if remainder == "" { 0_i32 }
        elif starts_with(remainder, "+") { css_number(remainder.slice(1_usize, remainder.char_len() - 1_usize)) as i32 }
        else { css_number(remainder) as i32 }
    if a == 0_i32 { ret position as i32 == b }
    let delta = position as i32 - b
    ret delta % a == 0_i32 && delta / a >= 0_i32
}

fn selector_tree_matches(selector: str, widget: Widget, ancestors: Vec[SelectorNode], count: usize,
    siblings: Vec[Widget], child_index: usize, sibling_count: usize,
    hovered: bool, active: bool, focused: bool, focus_within: bool) -> bool {
    let input = trim(selector)
    let combinator = rightmost_combinator(input)
    if combinator.kind == 0_usize {
        ret selector_matches(input, widget, child_index, sibling_count, siblings, count == 0_usize, hovered, active, focused, focus_within)
    }
    let left = trim(input.slice(0_usize, combinator.index))
    let right = trim(input.slice(combinator.index + 1_usize, input.char_len() - combinator.index - 1_usize))
    if !selector_matches(right, widget, child_index, sibling_count, siblings, count == 0_usize, hovered, active, focused, focus_within) { ret false }
    if combinator.kind == 2_usize {
        if count == 0_usize { ret false }
        match ancestors.get(count - 1_usize) {
            Option[SelectorNode]::Some(parent) => { ret selector_tree_matches(left, parent.widget, ancestors,
                count - 1_usize, parent.siblings, parent.index, parent.count, false, false, false, false) }
            Option[SelectorNode]::None => { ret false }
        }
    }
    if combinator.kind == 1_usize {
        let mut index = count
        while index > 0_usize {
            index = index - 1_usize
            match ancestors.get(index) {
                Option[SelectorNode]::Some(parent) => {
                    if selector_tree_matches(left, parent.widget, ancestors, index, parent.siblings, parent.index, parent.count,
                        false, false, false, false) { ret true }
                }
                Option[SelectorNode]::None => {}
            }
        }
        ret false
    }
    if combinator.kind == 3_usize {
        if child_index == 0_usize { ret false }
        match siblings.get(child_index - 1_usize) {
            Option[Widget]::Some(previous) => {
                ret selector_tree_matches(left, previous, ancestors, count, siblings,
                    child_index - 1_usize, sibling_count, false, false, false, false)
            }
            Option[Widget]::None => { ret false }
        }
    }
    if combinator.kind == 4_usize {
        let mut index = child_index
        while index > 0_usize {
            index = index - 1_usize
            match siblings.get(index) {
                Option[Widget]::Some(previous) => {
                    if selector_tree_matches(left, previous, ancestors, count, siblings, index, sibling_count,
                        false, false, false, false) { ret true }
                }
                Option[Widget]::None => {}
            }
        }
    }
    ret false
}

fn rightmost_combinator(value: str) -> SelectorCombinator {
    let mut index = value.char_len()
    let mut depth = 0_usize
    let mut brackets = 0_usize
    while index > 0_usize {
        index = index - 1_usize
        let current = value.slice(index, 1_usize)
        if current == ")" { depth = depth + 1_usize }
        elif current == "(" && depth > 0_usize { depth = depth - 1_usize }
        elif current == "]" { brackets = brackets + 1_usize }
        elif current == "[" && brackets > 0_usize { brackets = brackets - 1_usize }
        elif depth == 0_usize && brackets == 0_usize {
            if current == ">" { ret SelectorCombinator { index, 2_usize } }
            if current == "+" { ret SelectorCombinator { index, 3_usize } }
            if current == "~" { ret SelectorCombinator { index, 4_usize } }
            if whitespace(current) {
                let before = trim(value.slice(0_usize, index))
                let after = trim(value.slice(index + 1_usize, value.char_len() - index - 1_usize))
                if before != "" && after != "" && !ends_in_combinator(before) && !starts_in_combinator(after) {
                    ret SelectorCombinator { index, 1_usize }
                }
            }
        }
    }
    ret SelectorCombinator { value.char_len(), 0_usize }
}

fn ends_in_combinator(value: str) -> bool {
    if value == "" { ret false }
    let last = value.slice(value.char_len() - 1_usize, 1_usize)
    ret last == ">" || last == "+" || last == "~"
}

fn starts_in_combinator(value: str) -> bool {
    if value == "" { ret false }
    let first = value.slice(0_usize, 1_usize)
    ret first == ">" || first == "+" || first == "~"
}

fn append_ancestor(ancestors: Vec[SelectorNode], widget: Widget, index_in_parent: usize,
    sibling_count: usize, siblings: Vec[Widget]) -> Vec[SelectorNode] {
    let mut result = Vec[SelectorNode]::new()
    let mut index = 0_usize
    while index < ancestors.len() {
        match ancestors.get(index) {
            Option[SelectorNode]::Some(ancestor) => { result.push(ancestor) }
            Option[SelectorNode]::None => {}
        }
        index = index + 1_usize
    }
    result.push(SelectorNode { widget, index_in_parent, sibling_count, siblings })
    ret result
}

fn singleton_widget(widget: Widget) -> Vec[Widget] {
    let mut result = Vec[Widget]::new()
    result.push(widget)
    ret result
}

fn selector_part_end(value: str, start: usize) -> usize {
    let mut index = start
    let mut depth = 0_usize
    let mut brackets = 0_usize
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" && depth > 0_usize { depth = depth - 1_usize }
        elif current == "[" {
            if depth == 0_usize && brackets == 0_usize { break }
            brackets = brackets + 1_usize
        }
        elif current == "]" && brackets > 0_usize { brackets = brackets - 1_usize }
        elif depth == 0_usize && brackets == 0_usize && (current == "." || current == "#" || current == ":" || current == "[" ||
            current == ">" || current == "+" || current == "~" || whitespace(current)) { break }
        index = index + 1_usize
    }
    ret index
}

fn pseudo_name_end(value: str, start: usize) -> usize {
    let mut index = start
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "(" || current == "." || current == "#" || current == ":" ||
            current == ">" || current == "+" || current == "~" || whitespace(current) { break }
        index = index + 1_usize
    }
    ret index
}

fn attribute_selector_matches(expression: str, widget: Widget) -> bool {
    let input = trim(expression)
    let equals = find_character(input, "=", 0_usize)
    if equals == input.char_len() { ret widget_has_attribute(widget, input) }
    let marker = if equals > 0_usize { input.slice(equals - 1_usize, 1_usize) } else { "" }
    let compound = marker == "~" || marker == "|" || marker == "^" || marker == "$" || marker == "*"
    let name_end = if compound { equals - 1_usize } else { equals }
    let name = trim(input.slice(0_usize, name_end))
    if !widget_has_attribute(widget, name) { ret false }
    let actual = widget_attribute_value(widget, name)
    let expected = unquote_css_value(trim(input.slice(equals + 1_usize, input.char_len() - equals - 1_usize)))
    if !compound { ret actual == expected }
    if marker == "~" { ret has_class(actual, expected) }
    if marker == "|" { ret actual == expected || starts_with(actual, expected + "-") }
    if marker == "^" { ret starts_with(actual, expected) }
    if marker == "$" { ret ends_with(actual, expected) }
    ret string_contains(actual, expected)
}

fn widget_has_attribute(widget: Widget, name: str) -> bool {
    if name == "id" { ret widget.id() != "" }
    if name == "class" { ret widget.classes() != "" }
    if name == "disabled" { ret widget.disabled() }
    if name == "checked" { ret widget.checked() }
    match widget.attribute(name) { Option[str]::Some(value) => { ret true } Option[str]::None => { ret false } }
}

fn form_control(widget: Widget) -> bool {
    let kind = widget.kind()
    ret kind == widget_input() || kind == widget_textarea() || kind == widget_checkbox() ||
        kind == widget_radio() || kind == widget_select() || kind == widget_slider() || kind == widget_color_picker()
}

fn read_write_control(widget: Widget) -> bool {
    let kind = widget.kind()
    ret (kind == widget_input() || kind == widget_textarea()) && !widget.disabled() && !widget_has_attribute(widget, "readonly")
}

fn widget_attribute_value(widget: Widget, name: str) -> str {
    if name == "id" { ret widget.id() }
    if name == "class" { ret widget.classes() }
    if name == "disabled" { ret if widget.disabled() { "disabled" } else { "" } }
    if name == "checked" { ret if widget.checked() { "checked" } else { "" } }
    match widget.attribute(name) { Option[str]::Some(value) => { ret value } Option[str]::None => { ret "" } }
}

fn unquote_css_value(value: str) -> str {
    if value.char_len() >= 2_usize {
        let first = value.slice(0_usize, 1_usize)
        let last = value.slice(value.char_len() - 1_usize, 1_usize)
        if (first == "\"" && last == "\"") || (first == "'" && last == "'") {
            ret value.slice(1_usize, value.char_len() - 2_usize)
        }
    }
    ret value
}

fn string_contains(value: str, expected: str) -> bool {
    if expected == "" { ret true }
    if expected.char_len() > value.char_len() { ret false }
    let mut index = 0_usize
    while index + expected.char_len() <= value.char_len() {
        if value.slice(index, expected.char_len()) == expected { ret true }
        index = index + 1_usize
    }
    ret false
}

fn matching_bracket(value: str, open: usize) -> usize {
    let mut quote = ""
    let mut escaped = false
    let mut index = open + 1_usize
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if quote != "" {
            if escaped { escaped = false }
            elif current == "\\" { escaped = true }
            elif current == quote { quote = "" }
        } else {
            if current == "\"" || current == "'" { quote = current }
            elif current == "]" { ret index }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn matching_parenthesis(value: str, open: usize) -> usize {
    let mut depth = 0_usize
    let mut index = open
    while index < value.char_len() {
        let current = value.slice(index, 1_usize)
        if current == "(" { depth = depth + 1_usize }
        elif current == ")" {
            if depth == 1_usize { ret index }
            if depth > 0_usize { depth = depth - 1_usize }
        }
        index = index + 1_usize
    }
    ret value.char_len()
}

fn has_class(classes: str, expected: str) -> bool {
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= classes.char_len() {
        if index == classes.char_len() || whitespace(classes.slice(index, 1_usize)) {
            if index > start && classes.slice(start, index - start) == expected { ret true }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret false
}

fn widget_type(widget: Widget) -> str {
    let kind = widget.kind()
    if kind == widget_panel() { ret "div" }
    if kind == widget_label() { ret "label" }
    if kind == widget_button() { ret "button" }
    if kind == widget_spacer() { ret "spacer" }
    if kind == widget_input() { ret "input" }
    if kind == widget_textarea() { ret "textarea" }
    if kind == widget_checkbox() { ret "input" }
    if kind == widget_radio() { ret "input" }
    if kind == widget_switch() { ret "switch" }
    if kind == widget_select() { ret "select" }
    if kind == widget_slider() { ret "input" }
    if kind == widget_progress() { ret "progress" }
    if kind == widget_separator() { ret "hr" }
    if kind == widget_heading() { ret "h1" }
    if kind == widget_link() { ret "a" }
    if kind == widget_color_picker() { ret "input" }
    if kind == widget_color_swatch() { ret "swatch" }
    if kind == widget_icon() { ret "svg" }
    if kind == widget_icon_button() { ret "button" }
    if kind == widget_icon_card() { ret "button" }
    ret "widget"
}
