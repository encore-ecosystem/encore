import color::Color
import geometry::Insets
import refrain::style::Style

pub struct ButtonAnimation {
    hover: f32
    press: f32
    hovered: bool
    pressed: bool
    duration_ms: u64
    easing: usize
}

pub fn easing_linear() -> usize { ret 0_usize }
pub fn easing_in() -> usize { ret 1_usize }
pub fn easing_out() -> usize { ret 2_usize }
pub fn easing_in_out() -> usize { ret 3_usize }

impl for ButtonAnimation {
    pub fn new(duration_ms: u64) -> ButtonAnimation {
        ret ButtonAnimation { 0.0_f32, 0.0_f32, false, false, duration_ms, easing_in_out() }
    }

    pub fn with_hovered(self: Self, value: bool) -> ButtonAnimation {
        ret ButtonAnimation { self.hover, self.press, value, self.pressed, self.duration_ms, self.easing }
    }

    pub fn with_pressed(self: Self, value: bool) -> ButtonAnimation {
        ret ButtonAnimation { self.hover, self.press, self.hovered, value, self.duration_ms, self.easing }
    }

    pub fn with_duration(self: Self, value: u64) -> ButtonAnimation {
        ret ButtonAnimation { self.hover, self.press, self.hovered, self.pressed, value, self.easing }
    }

    pub fn with_easing(self: Self, value: usize) -> ButtonAnimation {
        ret ButtonAnimation { self.hover, self.press, self.hovered, self.pressed, self.duration_ms, value }
    }

    pub fn advance(self: Self, elapsed_ms: u64) -> ButtonAnimation {
        let step = if self.duration_ms == 0_u64 { 1.0_f32 }
            else { elapsed_ms as f32 / self.duration_ms as f32 }
        ret ButtonAnimation {
            approach(self.hover, if self.hovered { 1.0_f32 } else { 0.0_f32 }, step),
            approach(self.press, if self.pressed { 1.0_f32 } else { 0.0_f32 }, step),
            self.hovered, self.pressed, self.duration_ms, self.easing
        }
    }

    pub fn animating(self: Self) -> bool {
        let hover_target = if self.hovered { 1.0_f32 } else { 0.0_f32 }
        let press_target = if self.pressed { 1.0_f32 } else { 0.0_f32 }
        ret self.hover != hover_target || self.press != press_target
    }

    pub fn style(self: Self, normal: Style, hovered: Style, pressed: Style) -> Style {
        let hover_style = interpolate_style(normal, hovered, apply_easing(self.hover, self.easing))
        ret interpolate_style(hover_style, pressed, apply_easing(self.press, self.easing))
    }

    pub fn hover_progress(self: Self) -> f32 { ret self.hover }
    pub fn press_progress(self: Self) -> f32 { ret self.press }
    pub fn duration_ms(self: Self) -> u64 { ret self.duration_ms }
    pub fn easing(self: Self) -> usize { ret self.easing }
}

fn approach(current: f32, target: f32, step: f32) -> f32 {
    if current < target {
        let next = current + step
        ret if next > target { target } else { next }
    }
    if current > target {
        let next = current - step
        ret if next < target { target } else { next }
    }
    ret current
}

fn apply_easing(value: f32, easing: usize) -> f32 {
    if easing == easing_linear() { ret value }
    if easing == easing_in() { ret value * value }
    if easing == easing_out() { ret 1.0_f32 - (1.0_f32 - value) * (1.0_f32 - value) }
    ret value * value * (3.0_f32 - 2.0_f32 * value)
}
fn mix_f32(from: f32, to: f32, amount: f32) -> f32 { ret from + (to - from) * amount }
fn mix_u8(from: u8, to: u8, amount: f32) -> u8 { ret mix_f32(from as f32, to as f32, amount) as u8 }

fn transition_progress(amount: f32) -> f32 {
    if amount < 0.0_f32 { ret 0.0_f32 }
    if amount > 1.0_f32 { ret 1.0_f32 }
    ret amount
}

pub fn interpolate_color(from: Color, to: Color, amount: f32) -> Color {
    let progress = transition_progress(amount)
    ret Color::rgba(
        mix_u8(from.red(), to.red(), progress), mix_u8(from.green(), to.green(), progress),
        mix_u8(from.blue(), to.blue(), progress), mix_u8(from.alpha(), to.alpha(), progress)
    )
}

pub fn interpolate_style(from: Style, to: Style, amount: f32) -> Style {
    let progress = transition_progress(amount)
    let a = from.padding()
    let b = to.padding()
    ret Style::default()
        .with_background(interpolate_color(from.background(), to.background(), progress))
        .with_foreground(interpolate_color(from.foreground(), to.foreground(), progress))
        .with_border(mix_f32(from.border_width(), to.border_width(), progress),
            interpolate_color(from.border_color(), to.border_color(), progress))
        .with_outline(mix_f32(from.outline().width(), to.outline().width(), progress),
            interpolate_color(from.outline().color(), to.outline().color(), progress),
            mix_f32(from.outline().offset(), to.outline().offset(), progress))
        .with_shadow(mix_f32(from.shadow().x(), to.shadow().x(), progress),
            mix_f32(from.shadow().y(), to.shadow().y(), progress),
            mix_f32(from.shadow().blur(), to.shadow().blur(), progress),
            mix_f32(from.shadow().spread(), to.shadow().spread(), progress),
            interpolate_color(from.shadow().color(), to.shadow().color(), progress),
            if progress < 0.5_f32 { from.shadow().inset() } else { to.shadow().inset() })
        .with_text_decoration(
            if progress < 0.5_f32 { from.decoration().underline() } else { to.decoration().underline() },
            if progress < 0.5_f32 { from.decoration().overline() } else { to.decoration().overline() },
            if progress < 0.5_f32 { from.decoration().line_through() } else { to.decoration().line_through() },
            interpolate_color(from.decoration().color(), to.decoration().color(), progress),
            if progress < 0.5_f32 { from.decoration().color_set() } else { to.decoration().color_set() },
            mix_f32(from.decoration().thickness(), to.decoration().thickness(), progress))
        .with_radius(mix_f32(from.radius(), to.radius(), progress))
        .with_padding(Insets::only(
            mix_f32(a.top(), b.top(), progress), mix_f32(a.right(), b.right(), progress),
            mix_f32(a.bottom(), b.bottom(), progress), mix_f32(a.left(), b.left(), progress)))
        .with_gap(mix_f32(from.gap(), to.gap(), progress))
        .with_font_family(if progress < 0.5_f32 { from.font_family() } else { to.font_family() })
        .with_font_size(mix_f32(from.font_size(), to.font_size(), progress))
        .with_font_weight(mix_f32(from.font_weight() as f32, to.font_weight() as f32, progress) as u32)
        .with_text_align(if progress < 0.5_f32 { from.text_align() } else { to.text_align() })
        .with_visibility(if progress < 0.5_f32 { from.visible() } else { to.visible() })
        .with_pointer_events(if progress < 0.5_f32 { from.pointer_events() } else { to.pointer_events() })
        .with_opacity(mix_f32(from.opacity(), to.opacity(), progress))
        .with_layout(from.layout())
}
