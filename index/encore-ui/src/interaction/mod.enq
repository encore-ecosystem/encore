import core::option::Option
import core::vec::Vec
import refrain::widget::{Widget, WidgetLayout, widget_button, widget_checkbox, widget_color_picker, widget_icon_button, widget_icon_card,
    widget_input, widget_link, widget_radio, widget_select, widget_slider, widget_switch, widget_textarea}

pub struct InteractionState {
    hovered: str
    active: str
    focused: str
}

pub struct TextEditor {
    value: str
    cursor: usize
    anchor: usize
}

impl for TextEditor {
    pub fn new(value: str) -> TextEditor { ret TextEditor { value, value.char_len(), value.char_len() } }
    pub fn with_selection(self: Self, anchor: usize, cursor: usize) -> TextEditor {
        ret TextEditor { self.value, clamp_index(cursor, self.value.char_len()), clamp_index(anchor, self.value.char_len()) }
    }
    pub fn with_cursor(self: Self, cursor: usize) -> TextEditor { ret self.with_selection(cursor, cursor) }
    pub fn insert(self: Self, text: str) -> TextEditor {
        let start = self.selection_start()
        let finish = self.selection_end()
        let value = self.value.slice(0_usize, start) + text +
            self.value.slice(finish, self.value.char_len() - finish)
        let cursor = start + text.char_len()
        ret TextEditor { value, cursor, cursor }
    }
    pub fn backspace(self: Self) -> TextEditor {
        if self.has_selection() { ret self.insert("") }
        if self.cursor == 0_usize { ret self }
        ret self.with_selection(self.cursor - 1_usize, self.cursor).insert("")
    }
    pub fn delete(self: Self) -> TextEditor {
        if self.has_selection() { ret self.insert("") }
        if self.cursor >= self.value.char_len() { ret self }
        ret self.with_selection(self.cursor, self.cursor + 1_usize).insert("")
    }
    pub fn move_left(self: Self, extend: bool) -> TextEditor {
        let cursor = if !extend && self.has_selection() { self.selection_start() }
            elif self.cursor > 0_usize { self.cursor - 1_usize } else { 0_usize }
        ret TextEditor { self.value, cursor, if extend { self.anchor } else { cursor } }
    }
    pub fn move_right(self: Self, extend: bool) -> TextEditor {
        let cursor = if !extend && self.has_selection() { self.selection_end() }
            elif self.cursor < self.value.char_len() { self.cursor + 1_usize } else { self.value.char_len() }
        ret TextEditor { self.value, cursor, if extend { self.anchor } else { cursor } }
    }
    pub fn move_home(self: Self, extend: bool) -> TextEditor {
        ret TextEditor { self.value, 0_usize, if extend { self.anchor } else { 0_usize } }
    }
    pub fn move_end(self: Self, extend: bool) -> TextEditor {
        let finish = self.value.char_len()
        ret TextEditor { self.value, finish, if extend { self.anchor } else { finish } }
    }
    pub fn move_line_home(self: Self, extend: bool) -> TextEditor {
        let cursor = line_start(self.value, self.cursor)
        ret TextEditor { self.value, cursor, if extend { self.anchor } else { cursor } }
    }
    pub fn move_line_end(self: Self, extend: bool) -> TextEditor {
        let cursor = line_end(self.value, self.cursor)
        ret TextEditor { self.value, cursor, if extend { self.anchor } else { cursor } }
    }
    pub fn move_up(self: Self, extend: bool) -> TextEditor {
        let current_start = line_start(self.value, self.cursor)
        if current_start == 0_usize { ret self.with_vertical_cursor(0_usize, extend) }
        let previous_end = current_start - 1_usize
        let previous_start = line_start(self.value, previous_end)
        let column = self.cursor - current_start
        let cursor = previous_start + if column < previous_end - previous_start { column } else { previous_end - previous_start }
        ret self.with_vertical_cursor(cursor, extend)
    }
    pub fn move_down(self: Self, extend: bool) -> TextEditor {
        let current_start = line_start(self.value, self.cursor)
        let current_end = line_end(self.value, self.cursor)
        if current_end >= self.value.char_len() { ret self.with_vertical_cursor(self.value.char_len(), extend) }
        let next_start = current_end + 1_usize
        let next_end = line_end(self.value, next_start)
        let column = self.cursor - current_start
        let cursor = next_start + if column < next_end - next_start { column } else { next_end - next_start }
        ret self.with_vertical_cursor(cursor, extend)
    }
    fn with_vertical_cursor(self: Self, cursor: usize, extend: bool) -> TextEditor {
        ret TextEditor { self.value, cursor, if extend { self.anchor } else { cursor } }
    }
    pub fn select_all(self: Self) -> TextEditor { ret TextEditor { self.value, self.value.char_len(), 0_usize } }
    pub fn selected_text(self: Self) -> str {
        ret self.value.slice(self.selection_start(), self.selection_end() - self.selection_start())
    }
    pub fn cut(self: Self) -> TextEditor { ret if self.has_selection() { self.insert("") } else { self } }
    pub fn paste(self: Self, value: str) -> TextEditor { ret self.insert(value) }
    pub fn value(self: Self) -> str { ret self.value }
    pub fn cursor(self: Self) -> usize { ret self.cursor }
    pub fn selection_start(self: Self) -> usize { ret if self.cursor < self.anchor { self.cursor } else { self.anchor } }
    pub fn selection_end(self: Self) -> usize { ret if self.cursor > self.anchor { self.cursor } else { self.anchor } }
    pub fn has_selection(self: Self) -> bool { ret self.cursor != self.anchor }
}

fn line_start(value: str, cursor: usize) -> usize {
    let mut index = if cursor > value.char_len() { value.char_len() } else { cursor }
    while index > 0_usize {
        if value.slice(index - 1_usize, 1_usize) == "\n" { break }
        index = index - 1_usize
    }
    ret index
}

fn line_end(value: str, cursor: usize) -> usize {
    let mut index = if cursor > value.char_len() { value.char_len() } else { cursor }
    while index < value.char_len() && value.slice(index, 1_usize) != "\n" { index = index + 1_usize }
    ret index
}

fn clamp_index(value: usize, length: usize) -> usize { ret if value > length { length } else { value } }

impl for InteractionState {
    pub fn new() -> InteractionState { ret InteractionState { "", "", "" } }
    pub fn with_focus(self: Self, id: str) -> InteractionState {
        ret InteractionState { self.hovered, self.active, id }
    }
    pub fn pointer_move(self: Self, layout: WidgetLayout, x: f32, y: f32) -> InteractionState {
        ret InteractionState { layout.hit(x, y), self.active, self.focused }
    }
    pub fn pointer_down(self: Self, layout: WidgetLayout, x: f32, y: f32) -> InteractionState {
        let target = layout.hit(x, y)
        let focused = match layout.find_widget(target) {
            Option[Widget]::Some(widget) => { if focusable(widget) { target } else { self.focused } }
            Option[Widget]::None => { self.focused }
        }
        ret InteractionState { target, target, focused }
    }
    pub fn pointer_up(self: Self, layout: WidgetLayout, x: f32, y: f32) -> InteractionState {
        ret InteractionState { layout.hit(x, y), "", self.focused }
    }
    pub fn pointer_release_target(self: Self, layout: WidgetLayout, x: f32, y: f32) -> str {
        let target = layout.hit(x, y)
        ret if target != "" && target == self.active { target } else { "" }
    }
    pub fn focused_action(self: Self, root: Widget) -> str {
        if self.focused == "" { ret "" }
        match find_widget(root, self.focused) {
            Option[Widget]::Some(widget) => { ret if actionable(widget) { self.focused } else { "" } }
            Option[Widget]::None => { ret "" }
        }
    }
    pub fn focus_next(self: Self, root: Widget) -> InteractionState {
        ret self.focus_step(root, false)
    }
    pub fn focus_previous(self: Self, root: Widget) -> InteractionState {
        ret self.focus_step(root, true)
    }
    fn focus_step(self: Self, root: Widget, reverse: bool) -> InteractionState {
        let mut order = Vec[str]::new()
        collect_focusable(root, order)
        if order.len() == 0_usize { ret self }
        let mut current = order.len()
        let mut index = 0_usize
        while index < order.len() {
            match order.get(index) {
                Option[str]::Some(id) => { if id == self.focused { current = index break } }
                Option[str]::None => {}
            }
            index = index + 1_usize
        }
        let next = if reverse {
            if current == order.len() || current == 0_usize { order.len() - 1_usize } else { current - 1_usize }
        } else {
            if current == order.len() || current + 1_usize >= order.len() { 0_usize } else { current + 1_usize }
        }
        match order.get(next) {
            Option[str]::Some(id) => { ret InteractionState { self.hovered, self.active, id } }
            Option[str]::None => { ret self }
        }
    }
    pub fn hovered(self: Self) -> str { ret self.hovered }
    pub fn active(self: Self) -> str { ret self.active }
    pub fn focused(self: Self) -> str { ret self.focused }
}

fn collect_focusable(widget: Widget, order: mut Vec[str]) -> () {
    if focusable(widget) && widget.id() != "" { order.push(widget.id()) }
    let children = widget.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => { collect_focusable(child, order) }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret ()
}

fn focusable(widget: Widget) -> bool {
    if widget.disabled() || !widget.style().layout().flex().displayed() || !widget.style().visible() { ret false }
    let kind = widget.kind()
    ret kind == widget_button() || kind == widget_input() || kind == widget_textarea() ||
        kind == widget_checkbox() || kind == widget_radio() || kind == widget_switch() ||
        kind == widget_select() || kind == widget_slider() || kind == widget_link() || kind == widget_color_picker() || kind == widget_icon_button() || kind == widget_icon_card()
}

fn actionable(widget: Widget) -> bool {
    if !focusable(widget) { ret false }
    let kind = widget.kind()
    ret kind == widget_button() || kind == widget_checkbox() || kind == widget_radio() ||
        kind == widget_switch() || kind == widget_select() || kind == widget_link() || kind == widget_color_picker() || kind == widget_icon_button() || kind == widget_icon_card()
}

fn find_widget(widget: Widget, id: str) -> Option[Widget] {
    if widget.id() == id { ret Option[Widget]::Some(widget) }
    let children = widget.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[Widget]::Some(child) => {
                match find_widget(child, id) {
                    Option[Widget]::Some(found) => { ret Option[Widget]::Some(found) }
                    Option[Widget]::None => {}
                }
            }
            Option[Widget]::None => {}
        }
        index = index + 1_usize
    }
    ret Option[Widget]::None
}
