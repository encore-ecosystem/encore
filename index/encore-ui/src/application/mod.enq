import core::option::Option
import color::{Color, white}
import geometry::Rect
import refrain::style::{text_center, text_end}
import refrain::widget::{
    Widget, WidgetLayout, inherit_widget_styles, layout_widget, widget_button, widget_checkbox, widget_heading,
    widget_color_channel, widget_color_picker, widget_color_swatch, widget_icon, widget_icon_button, widget_icon_card, widget_input, widget_label, widget_link, widget_progress, widget_radio, widget_select,
    widget_separator, widget_slider, widget_spacer, widget_switch, widget_textarea
}
import ui_native::{
    native_backend_error, native_backend_name, native_begin, native_create, native_gpu_create,
    native_circle, native_clip, native_clipboard_set, native_clipboard_text, native_destroy, native_end,
    native_event_key, native_event_modifiers, native_event_text, native_event_wheel_x,
    native_event_wheel_y, native_event_x, native_event_y, native_fill_rect,
    native_font_clear, native_font_load, native_font_register, native_font_select, native_font_style, native_line, native_open, native_poll, native_round_rect,
    native_stroke_rect, native_text, native_text_height, native_text_index, native_text_width, native_text_wrapped, native_vector_line,
    native_vector_path_begin, native_vector_path_point, native_vector_path_stroke, native_width, native_height, native_pixel_density,
    native_pixels, native_layout_cache_begin, native_layout_cache_end, native_cached_frame_begin,
    native_platform_handle, native_surface_pixels, native_surface_width, native_surface_height, native_surface_pitch
}

pub fn event_none() -> u32 { ret 0_u32 }
pub fn event_close() -> u32 { ret 1_u32 }
pub fn event_key_down() -> u32 { ret 2_u32 }
pub fn event_key_up() -> u32 { ret 3_u32 }
pub fn event_pointer_down() -> u32 { ret 4_u32 }
pub fn event_pointer_up() -> u32 { ret 5_u32 }
pub fn event_pointer_move() -> u32 { ret 6_u32 }
pub fn event_scroll() -> u32 { ret 7_u32 }
pub fn event_text_input() -> u32 { ret 8_u32 }
pub fn event_resize() -> u32 { ret 9_u32 }
pub fn key_backspace() -> u32 { ret 8_u32 }
pub fn key_tab() -> u32 { ret 9_u32 }
pub fn key_enter() -> u32 { ret 13_u32 }
pub fn key_delete() -> u32 { ret 127_u32 }
pub fn key_home() -> u32 { ret 1073741898_u32 }
pub fn key_end() -> u32 { ret 1073741901_u32 }
pub fn key_right() -> u32 { ret 1073741903_u32 }
pub fn key_left() -> u32 { ret 1073741904_u32 }
pub fn key_down() -> u32 { ret 1073741905_u32 }
pub fn key_up() -> u32 { ret 1073741906_u32 }

pub struct Event {
    kind: u32
    x: f32
    y: f32
    key: u32
    modifiers: u32
    wheel_x: f32
    wheel_y: f32
    text: str
}

impl for Event {
    pub fn none() -> Event { ret Event { event_none(), 0.0_f32, 0.0_f32, 0_u32, 0_u32, 0.0_f32, 0.0_f32, "" } }
    pub fn kind(self: Self) -> u32 { ret self.kind }
    pub fn x(self: Self) -> f32 { ret self.x }
    pub fn y(self: Self) -> f32 { ret self.y }
    pub fn key(self: Self) -> u32 { ret self.key }
    pub fn modifiers(self: Self) -> u32 { ret self.modifiers }
    pub fn shift(self: Self) -> bool { ret (self.modifiers & 3_u32) != 0_u32 }
    pub fn control(self: Self) -> bool { ret (self.modifiers & 192_u32) != 0_u32 }
    pub fn wheel_x(self: Self) -> f32 { ret self.wheel_x }
    pub fn wheel_y(self: Self) -> f32 { ret self.wheel_y }
    pub fn text(self: Self) -> str { ret self.text }
}

pub struct Window {
    handle: usize
    width: u32
    height: u32
    background: Color
}

impl for Window {
    pub fn create(title: str, width: u32, height: u32) -> Window {
        ret Window { native_create(title, width, height), width, height, white() }
    }
    pub fn create_gpu_surface(title: str, width: u32, height: u32) -> Window {
        ret Window { native_gpu_create(title, width, height), width, height, white() }
    }
    pub fn available(self: Self) -> bool { ret self.handle != 0_usize }
    pub fn is_open(self: Self) -> bool { ret self.handle != 0_usize && native_open(self.handle) }
    pub fn width(self: Self) -> u32 {
        let value = if self.handle == 0_usize { 0_u32 } else { native_width(self.handle) }
        ret if value == 0_u32 { self.width } else { value }
    }
    pub fn height(self: Self) -> u32 {
        let value = if self.handle == 0_usize { 0_u32 } else { native_height(self.handle) }
        ret if value == 0_u32 { self.height } else { value }
    }
    pub fn pixel_density(self: Self) -> f32 {
        if self.handle == 0_usize { ret 1.0_f32 }
        ret native_pixel_density(self.handle)
    }
    pub fn platform_handle(self: Self) -> usize {
        ret if self.handle == 0_usize { 0_usize } else { native_platform_handle(self.handle) }
    }
    pub fn surface_pixels(self: Self) -> usize {
        ret if self.handle == 0_usize { 0_usize } else { native_surface_pixels(self.handle) }
    }
    pub fn surface_width(self: Self) -> u32 {
        ret if self.handle == 0_usize { 0_u32 } else { native_surface_width(self.handle) }
    }
    pub fn surface_height(self: Self) -> u32 {
        ret if self.handle == 0_usize { 0_u32 } else { native_surface_height(self.handle) }
    }
    pub fn surface_pitch(self: Self) -> u32 {
        ret if self.handle == 0_usize { 0_u32 } else { native_surface_pitch(self.handle) }
    }
    pub fn with_background(self: Self, color: Color) -> Window {
        ret Window { self.handle, self.width, self.height, color }
    }
    pub fn poll(self: Self) -> Event {
        if self.handle == 0_usize { ret Event::none() }
        let kind = native_poll(self.handle)
        ret Event {
            kind,
            native_event_x(self.handle), native_event_y(self.handle),
            native_event_key(self.handle), native_event_modifiers(self.handle), native_event_wheel_x(self.handle),
            native_event_wheel_y(self.handle), native_event_text(self.handle)
        }
    }
    pub fn begin(self: Self, color: Color) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_begin(self.handle, color.packed())
    }
    pub fn clipboard_text(self: Self) -> str { ret native_clipboard_text() }
    pub fn set_clipboard(self: Self, value: str) -> bool { ret native_clipboard_set(value) }
    pub fn fill_rect(self: Self, rect: Rect, color: Color) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_fill_rect(self.handle, rect.x(), rect.y(), rect.width(), rect.height(), color.packed())
    }
    pub fn stroke_rect(self: Self, rect: Rect, color: Color) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_stroke_rect(self.handle, rect.x(), rect.y(), rect.width(), rect.height(), color.packed())
    }
    pub fn line(self: Self, x0: f32, y0: f32, x1: f32, y1: f32, color: Color) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_line(self.handle, x0, y0, x1, y1, color.packed())
    }
    pub fn svg(self: Self, bounds: Rect, document: SvgDocument, color: Color, stroke_width: f32) -> () {
        if self.handle != 0_usize { render_svg(self.handle, bounds, document, color, stroke_width) }
        ret ()
    }
    pub fn text(self: Self, x: f32, y: f32, value: str, color: Color) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_text(self.handle, x, y, value, color.packed())
    }
    #cfg(feature = "fonts")
    pub fn load_font(self: Self, path: str, size: f32) -> bool {
        ret self.load_font_with_weight(path, size, 400_u32)
    }
    #cfg(feature = "fonts")
    pub fn load_font_with_weight(self: Self, path: str, size: f32, weight: u32) -> bool {
        if self.handle == 0_usize || size <= 0.0_f32 { ret false }
        ret native_font_load(self.handle, path, size, weight)
    }
    #cfg(feature = "fonts")
    pub fn register_font(self: Self, family: str, path: str) -> bool {
        if self.handle == 0_usize || family == "" || path == "" { ret false }
        ret native_font_register(self.handle, family, path)
    }
    #cfg(feature = "fonts")
    pub fn select_font(self: Self, family: str, size: f32, weight: u32) -> bool {
        if self.handle == 0_usize || family == "" || size <= 0.0_f32 { ret false }
        ret native_font_select(self.handle, family, size, weight)
    }
    #cfg(feature = "fonts")
    pub fn clear_font(self: Self) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_font_clear(self.handle)
    }
    #cfg(feature = "fonts")
    pub fn text_width(self: Self, value: str) -> f32 {
        if self.handle == 0_usize { ret 0.0_f32 }
        ret native_text_width(self.handle, value)
    }
    pub fn text_index(self: Self, value: str, width: f32) -> usize {
        if self.handle == 0_usize { ret 0_usize }
        ret native_text_index(self.handle, value, width)
    }
    pub fn wrapped_text_index(self: Self, value: str, width: f32, x: f32, y: f32) -> usize {
        if self.handle == 0_usize { ret 0_usize }
        ret wrapped_text_index(self.handle, value, width, x, y)
    }
    #cfg(feature = "fonts")
    pub fn text_height(self: Self, value: str) -> f32 {
        if self.handle == 0_usize { ret 0.0_f32 }
        ret native_text_height(self.handle, value)
    }
    pub fn present(self: Self) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_end(self.handle)
    }
    pub fn draw(self: Self, root: Widget) -> WidgetLayout {
        let layout = self.layout(root)
        self.draw_layout(layout)
        ret layout
    }
    pub fn layout(self: Self, root: Widget) -> WidgetLayout {
        ret layout_widget(inherit_widget_styles(root),
            Rect::new(0.0_f32, 0.0_f32, self.width() as f32, self.height() as f32))
    }
    pub fn restyle_layout(self: Self, layout: WidgetLayout, root: Widget) -> WidgetLayout {
        ret layout.restyle(inherit_widget_styles(root))
    }
    pub fn draw_layout(self: Self, layout: WidgetLayout) -> bool {
        if self.handle != 0_usize && native_begin(self.handle, self.background.packed()) {
            render_layout(self.handle, layout, Option[Rect]::None)
            ret native_end(self.handle)
        }
        ret false
    }
    pub fn draw_layout_with_pixels(self: Self, layout: WidgetLayout, target: str, pixels: usize,
        source_width: u32, source_height: u32, source_pitch: u32, top_inset: f32) -> bool {
        if self.handle == 0_usize || !native_begin(self.handle, self.background.packed()) { ret false }
        render_layout(self.handle, layout, Option[Rect]::None)
        match layout.find_bounds(target) {
            Option[Rect]::Some(bounds) => {
                let height = bounds.height() - top_inset
                if pixels != 0_usize && height > 0.0_f32 {
                    native_pixels(self.handle, pixels, source_width, source_height, source_pitch,
                        bounds.x(), bounds.y() + top_inset, bounds.width(), height)
                }
            }
            Option[Rect]::None => {}
        }
        ret native_end(self.handle)
    }
    pub fn cache_layout(self: Self, layout: WidgetLayout) -> bool {
        if self.handle == 0_usize || !native_layout_cache_begin(self.handle, self.background.packed()) { ret false }
        render_layout(self.handle, layout, Option[Rect]::None)
        ret native_layout_cache_end(self.handle)
    }
    pub fn draw_cached_layout_with_pixels(self: Self, layout: WidgetLayout, target: str, pixels: usize,
        source_width: u32, source_height: u32, source_pitch: u32, top_inset: f32) -> bool {
        if self.handle == 0_usize || !native_cached_frame_begin(self.handle, self.background.packed()) { ret false }
        match layout.find_bounds(target) {
            Option[Rect]::Some(bounds) => {
                let height = bounds.height() - top_inset
                if pixels != 0_usize && height > 0.0_f32 {
                    native_pixels(self.handle, pixels, source_width, source_height, source_pitch,
                        bounds.x(), bounds.y() + top_inset, bounds.width(), height)
                }
            }
            Option[Rect]::None => {}
        }
        ret native_end(self.handle)
    }
    pub fn draw_cached_layout(self: Self) -> bool {
        if self.handle == 0_usize || !native_cached_frame_begin(self.handle, self.background.packed()) { ret false }
        ret native_end(self.handle)
    }
    pub fn draw_cached_layout_overlays(self: Self, layout: WidgetLayout, first: str, second: str) -> bool {
        if self.handle == 0_usize || !native_cached_frame_begin(self.handle, self.background.packed()) { ret false }
        if first != "" { let _first_drawn = render_layout_target(self.handle, layout, first, Option[Rect]::None) }
        if second != "" && second != first {
            let _second_drawn = render_layout_target(self.handle, layout, second, Option[Rect]::None)
        }
        ret native_end(self.handle)
    }
    pub fn destroy(self: Self) -> bool {
        if self.handle == 0_usize { ret false }
        ret native_destroy(self.handle)
    }
}

fn render_layout_target(handle: usize, layout: WidgetLayout, target: str, inherited_clip: Option[Rect]) -> bool {
    if layout.widget().id() == target {
        render_layout(handle, layout, inherited_clip)
        ret true
    }
    let bounds = layout.bounds()
    let clip = if layout.widget().style().layout().overflow_hidden() {
        clipped_bounds(inherited_clip, bounds)
    } else { inherited_clip }
    let children = layout.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[WidgetLayout]::Some(child) => {
                if render_layout_target(handle, child, target, clip) { ret true }
            }
            Option[WidgetLayout]::None => {}
        }
        index = index + 1_usize
    }
    ret false
}

fn render_layout(handle: usize, layout: WidgetLayout, inherited_clip: Option[Rect]) -> () {
    let widget = layout.widget()
    let bounds = layout.bounds()
    let style = widget.style()
    let opacity = style.opacity() * if widget.disabled() { 0.5_f32 } else { 1.0_f32 }
    let clip = if style.layout().overflow_hidden() { clipped_bounds(inherited_clip, bounds) } else { inherited_clip }
    apply_clip(handle, clip)
    let background = apply_opacity(style.background(), opacity)
    let foreground = apply_opacity(style.foreground(), opacity)
    let border_color = apply_opacity(style.border_color(), opacity)
    if !style.visible() {
        render_children(handle, layout, clip)
        apply_clip(handle, inherited_clip)
        ret ()
    }
    if style.font_family() == "" || !native_font_select(handle, style.font_family(), style.font_size(), style.font_weight()) {
        native_font_style(handle, style.font_size(), style.font_weight())
    }
    if !style.shadow().inset() { render_outer_shadow(handle, bounds, style, opacity) }
    if widget.kind() != widget_spacer() {
        if style.radius() > 0.0_f32 { native_round_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(), style.radius(), background.packed(), true) }
        else { native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(), background.packed()) }
    }
    if style.shadow().inset() {
        render_inset_shadow(handle, bounds, style, opacity)
        apply_clip(handle, clip)
    }
    if style.border_width() > 0.0_f32 {
        let mut inset = 0.0_f32
        while inset < style.border_width() {
            let stroke_inset = inset + 0.5_f32
            let width = bounds.width() - stroke_inset * 2.0_f32
            let height = bounds.height() - stroke_inset * 2.0_f32
            let remaining = style.border_width() - inset
            let coverage = if remaining > 1.0_f32 { 1.0_f32 } else { remaining }
            let layer_color = apply_opacity(border_color, coverage)
            if width > 0.0_f32 && height > 0.0_f32 {
                let radius = style.radius() - stroke_inset
                if radius > 0.0_f32 { native_round_rect(handle, bounds.x() + stroke_inset, bounds.y() + stroke_inset, width, height, radius, layer_color.packed(), false) }
                else { native_stroke_rect(handle, bounds.x() + stroke_inset, bounds.y() + stroke_inset, width, height, layer_color.packed()) }
            }
            inset = inset + 1.0_f32
        }
    }
    let outline = style.outline()
    if outline.width() > 0.0_f32 {
        let outline_color = apply_opacity(outline.color(), opacity)
        let mut layer = 0.0_f32
        while layer < outline.width() {
            let distance = outline.offset() + layer + 0.5_f32
            let x = bounds.x() - distance
            let y = bounds.y() - distance
            let width = bounds.width() + distance * 2.0_f32
            let height = bounds.height() + distance * 2.0_f32
            let remaining = outline.width() - layer
            let coverage = if remaining > 1.0_f32 { 1.0_f32 } else { remaining }
            let color = apply_opacity(outline_color, coverage)
            let radius = style.radius() + distance
            if width > 0.0_f32 && height > 0.0_f32 {
                if radius > 0.0_f32 { native_round_rect(handle, x, y, width, height, radius, color.packed(), false) }
                else { native_stroke_rect(handle, x, y, width, height, color.packed()) }
            }
            layer = layer + 1.0_f32
        }
    }
    let kind = widget.kind()
    if kind == widget_label() || kind == widget_button() || kind == widget_heading() {
        let text_y = centered_text_y(handle, bounds, widget.text())
        let text_x = aligned_text_x(handle, bounds, widget.text(), style.text_align(), 8.0_f32, 8.0_f32)
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, foreground, opacity)
    }
    elif kind == widget_icon() {
        render_svg(handle, bounds, widget.svg(), foreground, 2.0_f32)
    }
    elif kind == widget_icon_button() {
        let icon_size = if bounds.height() - 14.0_f32 < 22.0_f32 { bounds.height() - 14.0_f32 } else { 22.0_f32 }
        let icon_bounds = Rect::new(bounds.x() + 10.0_f32, bounds.y() + (bounds.height() - icon_size) / 2.0_f32, icon_size, icon_size)
        render_svg(handle, icon_bounds, widget.svg(), foreground, 2.0_f32)
        let text_x = icon_bounds.right() + 9.0_f32
        let text_y = centered_text_y(handle, bounds, widget.text())
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, foreground, opacity)
    }
    elif kind == widget_icon_card() {
        let available = bounds.height() - 34.0_f32
        let icon_size = if available < 46.0_f32 { available } else { 46.0_f32 }
        let icon_bounds = Rect::new(bounds.x() + (bounds.width() - icon_size) / 2.0_f32,
            bounds.y() + 10.0_f32, icon_size, icon_size)
        render_svg(handle, icon_bounds, widget.svg(), foreground, 2.0_f32)
        let text_x = aligned_text_x(handle, bounds, widget.text(), text_center(), 8.0_f32, 8.0_f32)
        let text_y = bounds.bottom() - native_text_height(handle, widget.text()) - 10.0_f32
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
    }
    elif kind == widget_input() || kind == widget_select() {
        let text_y = centered_text_y(handle, bounds, widget.text())
        let aligned_x = aligned_text_x(handle, bounds, widget.text(), style.text_align(), 10.0_f32,
            if kind == widget_select() { 34.0_f32 } else { 10.0_f32 })
        let text_x = if kind == widget_input() && widget.focused() {
            focused_input_text_x(handle, bounds, widget.text(), widget.cursor(), aligned_x)
        } else { aligned_x }
        let selection = widget.selection()
        if kind == widget_input() && widget.focused() && selection.end() > selection.start() {
            let before = widget.text().slice(0_usize, selection.start())
            let selected = widget.text().slice(selection.start(), selection.end() - selection.start())
            native_fill_rect(handle, text_x + native_text_width(handle, before), text_y,
                native_text_width(handle, selected), native_text_height(handle, selected),
                Color::rgba(40_u8, 120_u8, 220_u8, 100_u8).packed())
        }
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, foreground, opacity)
        if kind == widget_select() {
            let arrow_x = bounds.right() - 17.0_f32
            let arrow_y = bounds.y() + bounds.height() / 2.0_f32 - 2.0_f32
            native_line(handle, arrow_x - 4.0_f32, arrow_y, arrow_x, arrow_y + 4.0_f32, foreground.packed())
            native_line(handle, arrow_x, arrow_y + 4.0_f32, arrow_x + 4.0_f32, arrow_y, foreground.packed())
        }
        elif widget.focused() {
            let prefix = widget.text().slice(0_usize, widget.cursor())
            let caret_x = text_x + native_text_width(handle, prefix) + 1.0_f32
            let text_height = native_text_height(handle, widget.text())
            native_line(handle, caret_x, text_y, caret_x, text_y + text_height, Color::rgb(18_u8, 153_u8, 126_u8).packed())
        }
    }
    elif kind == widget_textarea() {
        render_textarea(handle, bounds, widget, style, foreground, opacity)
    }
    elif kind == widget_checkbox() || kind == widget_radio() {
        render_choice(handle, bounds, widget.text(), widget.checked(), kind == widget_radio(), style, foreground, opacity)
    }
    elif kind == widget_switch() {
        render_switch(handle, bounds, widget.text(), widget.checked(), style, foreground, opacity)
    }
    elif kind == widget_slider() { render_slider(handle, bounds, widget.value()) }
    elif kind == widget_color_channel() { render_color_channel(handle, bounds, widget) }
    elif kind == widget_progress() { render_progress(handle, bounds, widget.value()) }
    elif kind == widget_separator() {
        native_line(handle, bounds.x(), bounds.y(), bounds.right(), bounds.y(), Color::rgb(203_u8, 211_u8, 220_u8).packed())
    }
    elif kind == widget_link() {
        let link = Color::rgb(20_u8, 112_u8, 190_u8)
        let text_y = centered_text_y(handle, bounds, widget.text())
        let text_x = aligned_text_x(handle, bounds, widget.text(), style.text_align(), 4.0_f32, 4.0_f32)
        native_text(handle, text_x, text_y, widget.text(), link.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, link, opacity)
        native_line(handle, text_x, bounds.bottom() - 4.0_f32,
            text_x + native_text_width(handle, widget.text()), bounds.bottom() - 4.0_f32, link.packed())
    }
    elif kind == widget_color_picker() {
        native_fill_rect(handle, bounds.x() + 8.0_f32, bounds.y() + 8.0_f32, 22.0_f32, bounds.height() - 16.0_f32, border_color.packed())
        native_stroke_rect(handle, bounds.x() + 8.0_f32, bounds.y() + 8.0_f32, 22.0_f32, bounds.height() - 16.0_f32, Color::rgb(92_u8, 103_u8, 116_u8).packed())
        let text_x = bounds.x() + 40.0_f32
        let text_y = centered_text_y(handle, bounds, widget.text())
        native_text(handle, text_x, text_y, widget.text(), foreground.packed())
        render_text_decoration(handle, text_x, text_y, widget.text(), style, foreground, opacity)
        let arrow_x = bounds.right() - 17.0_f32
        let arrow_y = bounds.y() + bounds.height() / 2.0_f32 - 2.0_f32
        native_line(handle, arrow_x - 4.0_f32, arrow_y, arrow_x, arrow_y + 4.0_f32, foreground.packed())
        native_line(handle, arrow_x, arrow_y + 4.0_f32, arrow_x + 4.0_f32, arrow_y, foreground.packed())
    }
    elif kind == widget_color_swatch() {}
    render_children(handle, layout, clip)
    apply_clip(handle, inherited_clip)
    ret ()
}

fn render_children(handle: usize, layout: WidgetLayout, clip: Option[Rect]) -> () {
    let children = layout.children()
    let mut index = 0_usize
    while index < children.len() {
        match children.get(index) {
            Option[WidgetLayout]::Some(child) => { render_layout(handle, child, clip) }
            Option[WidgetLayout]::None => {}
        }
        index = index + 1_usize
    }
    ret ()
}

fn render_svg(handle: usize, bounds: Rect, document: SvgDocument, color: Color, stroke_width: f32) -> () {
    if !document.valid() || document.width() <= 0.0_f32 || document.height() <= 0.0_f32 { ret () }
    let render_width = if bounds.width() > 2.0_f32 { bounds.width() - 2.0_f32 } else { bounds.width() }
    let render_height = if bounds.height() > 2.0_f32 { bounds.height() - 2.0_f32 } else { bounds.height() }
    let scale_x = render_width / (document.width() + stroke_width)
    let scale_y = render_height / (document.height() + stroke_width)
    let scale = if scale_x < scale_y { scale_x } else { scale_y }
    let offset_x = bounds.x() + (bounds.width() - document.width() * scale) / 2.0_f32
    let offset_y = bounds.y() + (bounds.height() - document.height() * scale) / 2.0_f32
    let lines = document.lines()
    let thickness = stroke_width * scale
    let mut previous_x = 0.0_f32
    let mut previous_y = 0.0_f32
    let mut path_start_x = 0.0_f32
    let mut path_start_y = 0.0_f32
    let mut has_previous = false
    let mut index = 0_usize
    while index < lines.len() {
        match lines.get(index) {
            Option[SvgLine]::Some(line) => {
                let start = line.start()
                let finish = line.finish()
                let x0 = offset_x + start.x() * scale
                let y0 = offset_y + start.y() * scale
                let x1 = offset_x + finish.x() * scale
                let y1 = offset_y + finish.y() * scale
                if !has_previous || previous_x != x0 || previous_y != y0 {
                    if has_previous { native_vector_path_stroke(handle, thickness, color.packed(), false) }
                    native_vector_path_begin(handle, x0, y0)
                    path_start_x = x0
                    path_start_y = y0
                }
                native_vector_path_point(handle, x1, y1)
                previous_x = x1
                previous_y = y1
                has_previous = true
            }
            Option[SvgLine]::None => {}
        }
        index = index + 1_usize
    }
    if has_previous {
        native_vector_path_stroke(handle, thickness, color.packed(),
            previous_x == path_start_x && previous_y == path_start_y)
    }
    ret ()
}

fn render_text_decoration(handle: usize, x: f32, y: f32, text: str, style: Style,
    foreground: Color, opacity: f32) -> () {
    let decoration = style.decoration()
    if !decoration.underline() && !decoration.overline() && !decoration.line_through() { ret () }
    let color = if decoration.color_set() { apply_opacity(decoration.color(), opacity) } else { foreground }
    let width = native_text_width(handle, text)
    let height = native_text_height(handle, text)
    let mut layer = 0.0_f32
    while layer < decoration.thickness() {
        if decoration.overline() { native_line(handle, x, y + layer, x + width, y + layer, color.packed()) }
        if decoration.line_through() {
            native_line(handle, x, y + height * 0.55_f32 + layer, x + width, y + height * 0.55_f32 + layer, color.packed())
        }
        if decoration.underline() {
            native_line(handle, x, y + height - 1.0_f32 + layer, x + width, y + height - 1.0_f32 + layer, color.packed())
        }
        layer = layer + 1.0_f32
    }
    ret ()
}

struct WrappedLine {
    start: usize
    end: usize
    next: usize
    hard_break: bool
}

fn wrapped_line(handle: usize, value: str, start: usize, width: f32) -> WrappedLine {
    let mut newline = start
    while newline < value.char_len() && value.slice(newline, 1_usize) != "\n" { newline = newline + 1_usize }
    if newline == start {
        ret WrappedLine { start, start, start + 1_usize, true }
    }
    let remaining = value.slice(start, newline - start)
    let measured = native_text_index(handle, remaining, width)
    let count = if measured == 0_usize { 1_usize } else { measured }
    let end = if start + count < newline { start + count } else { newline }
    let hard_break = end == newline && newline < value.char_len()
    ret WrappedLine { start, end, if hard_break { newline + 1_usize } else { end }, hard_break }
}

fn wrapped_text_index(handle: usize, value: str, width: f32, x: f32, y: f32) -> usize {
    if value.char_len() == 0_usize || width <= 0.0_f32 { ret 0_usize }
    let height = native_text_height(handle, "Mg")
    let line_height = if height > 0.0_f32 { height + 2.0_f32 } else { 16.0_f32 }
    let target_row = (if y > 0.0_f32 { y / line_height } else { 0.0_f32 }) as usize
    let mut start = 0_usize
    let mut row = 0_usize
    while start < value.char_len() {
        let line = wrapped_line(handle, value, start, width)
        if row == target_row {
            let text = value.slice(line.start, line.end - line.start)
            let local = native_text_index(handle, text, if x > 0.0_f32 { x } else { 0.0_f32 })
            let index = line.start + local
            ret if index < line.end { index } else { line.end }
        }
        start = line.next
        row = row + 1_usize
    }
    ret value.char_len()
}

fn render_textarea(handle: usize, bounds: Rect, widget: Widget, style: Style,
    foreground: Color, opacity: f32) -> () {
    let value = widget.text()
    let x = bounds.x() + 10.0_f32
    let width = bounds.width() - 20.0_f32
    let height = native_text_height(handle, "Mg")
    let line_height = if height > 0.0_f32 { height + 2.0_f32 } else { 16.0_f32 }
    let selection = widget.selection()
    let mut start = 0_usize
    let mut row = 0_usize
    let mut finished = false
    while !finished {
        let line = if value.char_len() == 0_usize || start >= value.char_len() {
            WrappedLine { start, start, start, false }
        } else { wrapped_line(handle, value, start, width) }
        let text = value.slice(line.start, line.end - line.start)
        let y = bounds.y() + 10.0_f32 + (row as f32) * line_height
        if widget.focused() && selection.end() > selection.start() {
            let selected_start = if selection.start() > line.start { selection.start() } else { line.start }
            let selected_end = if selection.end() < line.end { selection.end() } else { line.end }
            if selected_end > selected_start {
                let before = value.slice(line.start, selected_start - line.start)
                let selected = value.slice(selected_start, selected_end - selected_start)
                native_fill_rect(handle, x + native_text_width(handle, before), y,
                    native_text_width(handle, selected), height, Color::rgba(40_u8, 120_u8, 220_u8, 100_u8).packed())
            }
        }
        native_text(handle, x, y, text, foreground.packed())
        render_text_decoration(handle, x, y, text, style, foreground, opacity)
        let cursor_on_line = widget.cursor() >= line.start &&
            (widget.cursor() < line.end || line.end == value.char_len() || (line.hard_break && widget.cursor() == line.end))
        if widget.focused() && cursor_on_line {
            let prefix = value.slice(line.start, widget.cursor() - line.start)
            let caret_x = x + native_text_width(handle, prefix) + 1.0_f32
            native_line(handle, caret_x, y, caret_x, y + height, Color::rgb(18_u8, 153_u8, 126_u8).packed())
        }
        finished = line.next >= value.char_len()
        if line.hard_break && line.next == value.char_len() {
            start = line.next
            row = row + 1_usize
            let empty_y = bounds.y() + 10.0_f32 + (row as f32) * line_height
            if widget.focused() && widget.cursor() == value.char_len() {
                native_line(handle, x + 1.0_f32, empty_y, x + 1.0_f32, empty_y + height,
                    Color::rgb(18_u8, 153_u8, 126_u8).packed())
            }
        } else {
            start = line.next
            row = row + 1_usize
        }
    }
    ret ()
}

fn shadow_layers(blur: f32) -> usize {
    let value = blur as usize + 1_usize
    ret if value > 24_usize { 24_usize } else { value }
}

fn shadow_layer_color(color: Color, opacity: f32, layers: usize) -> Color {
    let alpha = ((color.alpha() as f32) * opacity / layers as f32) as u8
    ret Color::rgba(color.red(), color.green(), color.blue(), alpha)
}

fn render_outer_shadow(handle: usize, bounds: Rect, style: Style, opacity: f32) -> () {
    let shadow = style.shadow()
    if shadow.color().alpha() == 0_u8 { ret () }
    let layers = shadow_layers(shadow.blur())
    let color = shadow_layer_color(shadow.color(), opacity, layers)
    let mut index = layers
    while index > 0_usize {
        index = index - 1_usize
        let expansion = if layers > 1_usize { shadow.blur() * index as f32 / (layers - 1_usize) as f32 } else { 0.0_f32 }
        let extent = shadow.spread() + expansion
        let x = bounds.x() + shadow.x() - extent
        let y = bounds.y() + shadow.y() - extent
        let width = bounds.width() + extent * 2.0_f32
        let height = bounds.height() + extent * 2.0_f32
        let radius = style.radius() + extent
        if width > 0.0_f32 && height > 0.0_f32 {
            if radius > 0.0_f32 { native_round_rect(handle, x, y, width, height, radius, color.packed(), true) }
            else { native_fill_rect(handle, x, y, width, height, color.packed()) }
        }
    }
    ret ()
}

fn render_inset_shadow(handle: usize, bounds: Rect, style: Style, opacity: f32) -> () {
    let shadow = style.shadow()
    if shadow.color().alpha() == 0_u8 { ret () }
    native_clip(handle, true, bounds.x(), bounds.y(), bounds.width(), bounds.height())
    let layers = shadow_layers(shadow.blur() + if shadow.spread() > 0.0_f32 { shadow.spread() } else { 0.0_f32 })
    let color = shadow_layer_color(shadow.color(), opacity, layers)
    let mut index = 0_usize
    while index < layers {
        let inset = index as f32 - shadow.spread()
        let x = bounds.x() + inset + shadow.x()
        let y = bounds.y() + inset + shadow.y()
        let width = bounds.width() - inset * 2.0_f32
        let height = bounds.height() - inset * 2.0_f32
        let radius = style.radius() - inset
        if width > 0.0_f32 && height > 0.0_f32 {
            if radius > 0.0_f32 { native_round_rect(handle, x, y, width, height, radius, color.packed(), false) }
            else { native_stroke_rect(handle, x, y, width, height, color.packed()) }
        }
        index = index + 1_usize
    }
    ret ()
}

fn aligned_text_x(handle: usize, bounds: Rect, value: str, alignment: usize, left: f32, right: f32) -> f32 {
    let minimum = bounds.x() + left
    let available = bounds.width() - left - right
    let width = native_text_width(handle, value)
    if alignment == text_center() {
        let centered = minimum + (available - width) / 2.0_f32
        ret if centered > minimum { centered } else { minimum }
    }
    if alignment == text_end() {
        let ended = bounds.right() - right - width
        ret if ended > minimum { ended } else { minimum }
    }
    ret minimum
}

fn focused_input_text_x(handle: usize, bounds: Rect, value: str, cursor: usize, aligned: f32) -> f32 {
    let caret = native_text_width(handle, value.slice(0_usize, cursor))
    let right = bounds.right() - 10.0_f32
    if aligned + caret > right { ret aligned - (aligned + caret - right) }
    ret aligned
}

fn clipped_bounds(parent: Option[Rect], bounds: Rect) -> Option[Rect] {
    match parent {
        Option[Rect]::Some(clip) => {
            let left = if clip.x() > bounds.x() { clip.x() } else { bounds.x() }
            let top = if clip.y() > bounds.y() { clip.y() } else { bounds.y() }
            let right = if clip.right() < bounds.right() { clip.right() } else { bounds.right() }
            let bottom = if clip.bottom() < bounds.bottom() { clip.bottom() } else { bounds.bottom() }
            ret Option[Rect]::Some(Rect::new(left, top,
                if right > left { right - left } else { 0.0_f32 },
                if bottom > top { bottom - top } else { 0.0_f32 }))
        }
        Option[Rect]::None => { ret Option[Rect]::Some(bounds) }
    }
}

fn apply_clip(handle: usize, clip: Option[Rect]) -> () {
    match clip {
        Option[Rect]::Some(bounds) => { native_clip(handle, true, bounds.x(), bounds.y(), bounds.width(), bounds.height()) }
        Option[Rect]::None => { native_clip(handle, false, 0.0_f32, 0.0_f32, 0.0_f32, 0.0_f32) }
    }
    ret ()
}

fn render_choice(handle: usize, bounds: Rect, text: str, checked: bool, radio: bool,
    style: Style, foreground: Color, opacity: f32) -> () {
    let size = 18.0_f32
    let x = bounds.x() + 4.0_f32
    let y = bounds.y() + (bounds.height() - size) / 2.0_f32
    let border = Color::rgb(137_u8, 149_u8, 163_u8)
    let accent = Color::rgb(18_u8, 153_u8, 126_u8)
    if radio {
        native_circle(handle, x + 9.0_f32, y + 9.0_f32, 9.0_f32,
            if checked { accent.packed() } else { Color::rgb(255_u8, 255_u8, 255_u8).packed() }, true)
        native_circle(handle, x + 9.0_f32, y + 9.0_f32, 9.0_f32, border.packed(), false)
    } else {
        native_fill_rect(handle, x, y, size, size, if checked { accent.packed() } else { Color::rgb(255_u8, 255_u8, 255_u8).packed() })
        native_stroke_rect(handle, x, y, size, size, border.packed())
    }
    if checked {
        if radio { native_circle(handle, x + 9.0_f32, y + 9.0_f32, 4.0_f32, Color::rgb(255_u8, 255_u8, 255_u8).packed(), true) }
        else {
            native_line(handle, x + 4.0_f32, y + 9.0_f32, x + 8.0_f32, y + 13.0_f32, Color::rgb(255_u8, 255_u8, 255_u8).packed())
            native_line(handle, x + 8.0_f32, y + 13.0_f32, x + 15.0_f32, y + 5.0_f32, Color::rgb(255_u8, 255_u8, 255_u8).packed())
        }
    }
    let text_x = x + 28.0_f32
    let text_y = centered_text_y(handle, bounds, text)
    native_text(handle, text_x, text_y, text, foreground.packed())
    render_text_decoration(handle, text_x, text_y, text, style, foreground, opacity)
    ret ()
}

fn render_switch(handle: usize, bounds: Rect, text: str, checked: bool,
    style: Style, foreground: Color, opacity: f32) -> () {
    let x = bounds.x() + 4.0_f32
    let y = bounds.y() + (bounds.height() - 22.0_f32) / 2.0_f32
    native_fill_rect(handle, x, y, 42.0_f32, 22.0_f32,
        if checked { Color::rgb(18_u8, 153_u8, 126_u8).packed() } else { Color::rgb(174_u8, 184_u8, 195_u8).packed() })
    let knob_x = if checked { x + 22.0_f32 } else { x + 2.0_f32 }
    native_fill_rect(handle, knob_x, y + 2.0_f32, 18.0_f32, 18.0_f32, Color::rgb(255_u8, 255_u8, 255_u8).packed())
    let text_x = x + 54.0_f32
    let text_y = centered_text_y(handle, bounds, text)
    native_text(handle, text_x, text_y, text, foreground.packed())
    render_text_decoration(handle, text_x, text_y, text, style, foreground, opacity)
    ret ()
}

fn render_slider(handle: usize, bounds: Rect, value: f32) -> () {
    let x = bounds.x() + 6.0_f32
    let width = bounds.width() - 12.0_f32
    let y = bounds.y() + bounds.height() / 2.0_f32
    native_fill_rect(handle, x, y - 2.0_f32, width, 4.0_f32, Color::rgb(211_u8, 218_u8, 226_u8).packed())
    native_fill_rect(handle, x, y - 2.0_f32, width * value, 4.0_f32, Color::rgb(18_u8, 153_u8, 126_u8).packed())
    native_fill_rect(handle, x + width * value - 7.0_f32, y - 7.0_f32, 14.0_f32, 14.0_f32, Color::rgb(255_u8, 255_u8, 255_u8).packed())
    native_stroke_rect(handle, x + width * value - 7.0_f32, y - 7.0_f32, 14.0_f32, 14.0_f32, Color::rgb(18_u8, 153_u8, 126_u8).packed())
    ret ()
}

fn render_color_channel(handle: usize, bounds: Rect, widget: Widget) -> () {
    let color = widget.style().background()
    let value = widget.value()
    let channel = widget.attribute("channel").unwrap_or("")
    let alpha = channel == "alpha"
    let x = bounds.x() + 7.0_f32
    let width = bounds.width() - 14.0_f32
    let y = bounds.y() + bounds.height() / 2.0_f32 - 6.0_f32
    let steps = 48_usize
    let step_width = width / (steps as f32)
    let mut index = 0_usize
    while index < steps {
        let amount = (index as f32) / ((steps - 1_usize) as f32)
        let step_x = x + (index as f32) * step_width
        let gradient_red = if channel == "red" { (amount * 255.0_f32) as u8 } else { color.red() }
        let gradient_green = if channel == "green" { (amount * 255.0_f32) as u8 } else { color.green() }
        let gradient_blue = if channel == "blue" { (amount * 255.0_f32) as u8 } else { color.blue() }
        if alpha {
            let checker = if index % 2_usize == 0_usize { Color::rgb(225_u8, 229_u8, 234_u8) } else { Color::rgb(255_u8, 255_u8, 255_u8) }
            native_fill_rect(handle, step_x, y, step_width + 1.0_f32, 12.0_f32, checker.packed())
            native_fill_rect(handle, step_x, y, step_width + 1.0_f32, 12.0_f32,
                Color::rgba(color.red(), color.green(), color.blue(), (amount * 255.0_f32) as u8).packed())
        } else {
            native_fill_rect(handle, step_x, y, step_width + 1.0_f32, 12.0_f32,
                Color::rgb(gradient_red, gradient_green, gradient_blue).packed())
        }
        index = index + 1_usize
    }
    native_stroke_rect(handle, x, y, width, 12.0_f32, Color::rgb(92_u8, 103_u8, 116_u8).packed())
    let thumb_x = x + width * value
    native_fill_rect(handle, thumb_x - 5.0_f32, y - 3.0_f32, 10.0_f32, 18.0_f32, Color::rgb(255_u8, 255_u8, 255_u8).packed())
    native_stroke_rect(handle, thumb_x - 5.0_f32, y - 3.0_f32, 10.0_f32, 18.0_f32, Color::rgb(31_u8, 36_u8, 43_u8).packed())
    ret ()
}

fn render_progress(handle: usize, bounds: Rect, value: f32) -> () {
    native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width(), bounds.height(), Color::rgb(221_u8, 227_u8, 233_u8).packed())
    native_fill_rect(handle, bounds.x(), bounds.y(), bounds.width() * value, bounds.height(), Color::rgb(18_u8, 153_u8, 126_u8).packed())
    ret ()
}

fn centered_text_y(handle: usize, bounds: Rect, text: str) -> f32 {
    ret bounds.y() + (bounds.height() - native_text_height(handle, text)) / 2.0_f32
}

fn apply_opacity(color: Color, opacity: f32) -> Color {
    ret Color::rgba(color.red(), color.green(), color.blue(), ((color.alpha() as f32) * opacity) as u8)
}

pub fn backend_name() -> str { ret native_backend_name() }
pub fn backend_error() -> str { ret native_backend_error() }
