import core::option::Option
import core::vec::Vec
import geometry::{Rect, Size}

pub fn horizontal() -> usize { ret 0_usize }
pub fn vertical() -> usize { ret 1_usize }

pub struct FlexItem {
    basis: f32
    grow: f32
    min_size: f32
    max_size: f32
}

impl for FlexItem {
    pub fn fixed(size: f32) -> FlexItem { ret FlexItem { size, 0.0_f32, size, size } }
    pub fn flexible(grow: f32) -> FlexItem { ret FlexItem { 0.0_f32, grow, 0.0_f32, 1000000.0_f32 } }
    pub fn constrained(basis: f32, grow: f32, min_size: f32, max_size: f32) -> FlexItem {
        ret FlexItem { basis, grow, min_size, max_size }
    }
    pub fn basis(self: Self) -> f32 { ret self.basis }
    pub fn grow(self: Self) -> f32 { ret self.grow }
    pub fn min_size(self: Self) -> f32 { ret self.min_size }
    pub fn max_size(self: Self) -> f32 { ret self.max_size }
}

fn clamp(value: f32, minimum: f32, maximum: f32) -> f32 {
    if value < minimum { ret minimum }
    if value > maximum { ret maximum }
    ret value
}

pub fn flex_layout(bounds: Rect, direction: usize, gap: f32, items: Vec[FlexItem]) -> Vec[Rect] {
    let mut result = Vec[Rect]::new()
    if items.len() == 0_usize { ret result }

    let main_size = if direction == horizontal() { bounds.width() } else { bounds.height() }
    let gaps = gap * ((items.len() - 1_usize) as f32)
    let available = if main_size > gaps { main_size - gaps } else { 0.0_f32 }
    let mut used = 0.0_f32
    let mut grow_total = 0.0_f32
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[FlexItem]::Some(item) => {
                used = used + clamp(item.basis(), item.min_size(), item.max_size())
                grow_total = grow_total + item.grow()
            }
            Option[FlexItem]::None => {}
        }
        index = index + 1_usize
    }
    let free = if available > used { available - used } else { 0.0_f32 }
    let mut cursor = if direction == horizontal() { bounds.x() } else { bounds.y() }
    index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[FlexItem]::Some(item) => {
                let extra = if grow_total > 0.0_f32 { free * item.grow() / grow_total } else { 0.0_f32 }
                let extent = clamp(item.basis() + extra, item.min_size(), item.max_size())
                if direction == horizontal() {
                    result.push(Rect::new(cursor, bounds.y(), extent, bounds.height()))
                } else {
                    result.push(Rect::new(bounds.x(), cursor, bounds.width(), extent))
                }
                cursor = cursor + extent + gap
            }
            Option[FlexItem]::None => {}
        }
        index = index + 1_usize
    }
    ret result
}

pub fn preferred_size(direction: usize, gap: f32, items: Vec[Size]) -> Size {
    let mut width = 0.0_f32
    let mut height = 0.0_f32
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[Size]::Some(item) => {
                if direction == horizontal() {
                    width = width + item.width()
                    if item.height() > height { height = item.height() }
                } else {
                    height = height + item.height()
                    if item.width() > width { width = item.width() }
                }
            }
            Option[Size]::None => {}
        }
        index = index + 1_usize
    }
    if items.len() > 1_usize {
        if direction == horizontal() { width = width + gap * ((items.len() - 1_usize) as f32) }
        else { height = height + gap * ((items.len() - 1_usize) as f32) }
    }
    ret Size::new(width, height)
}
