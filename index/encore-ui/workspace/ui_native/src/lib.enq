pub fn native_event_wheel_y(handle: usize) -> f32 { unsafe { ret encore_ui_event_wheel_y(handle) } }
pub fn native_clipboard_set(value: str) -> bool { unsafe { ret encore_ui_clipboard_set(value) } }
pub fn native_clipboard_text() -> str { unsafe { ret encore_ui_clipboard_text() } }
pub fn native_begin(handle: usize, color: u32) -> bool { unsafe { ret encore_ui_frame_begin(handle, color) } }
pub fn native_clip(handle: usize, enabled: bool, x: f32, y: f32, width: f32, height: f32) -> bool {
    unsafe { ret encore_ui_clip_rect(handle, enabled, x, y, width, height) }
}
pub fn native_fill_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, color: u32) -> bool { unsafe { ret encore_ui_fill_rect(handle, x, y, width, height, color) } }
pub fn native_stroke_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, color: u32) -> bool { unsafe { ret encore_ui_stroke_rect(handle, x, y, width, height, color) } }
pub fn native_line(handle: usize, x0: f32, y0: f32, x1: f32, y1: f32, color: u32) -> bool { unsafe { ret encore_ui_line(handle, x0, y0, x1, y1, color) } }
pub fn native_vector_line(handle: usize, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, color: u32) -> bool {
    unsafe { ret encore_ui_vector_line(handle, x0, y0, x1, y1, width, color) }
}
pub fn native_vector_path_begin(handle: usize, x: f32, y: f32) -> bool {
    unsafe { ret encore_ui_vector_path_begin(handle, x, y) }
}
pub fn native_vector_path_point(handle: usize, x: f32, y: f32) -> bool {
    unsafe { ret encore_ui_vector_path_point(handle, x, y) }
}
pub fn native_vector_path_stroke(handle: usize, width: f32, color: u32, closed: bool) -> bool {
    unsafe { ret encore_ui_vector_path_stroke(handle, width, color, closed) }
}
pub fn native_circle(handle: usize, cx: f32, cy: f32, radius: f32, color: u32, filled: bool) -> bool { unsafe { ret encore_ui_circle(handle, cx, cy, radius, color, filled) } }
pub fn native_round_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, radius: f32, color: u32, filled: bool) -> bool { unsafe { ret encore_ui_round_rect(handle, x, y, width, height, radius, color, filled) } }
pub fn native_text(handle: usize, x: f32, y: f32, value: str, color: u32) -> bool { unsafe { ret encore_ui_text(handle, x, y, value, color) } }
pub fn native_text_wrapped(handle: usize, x: f32, y: f32, value: str, color: u32, wrap_width: f32) -> bool {
    unsafe { ret encore_ui_text_wrapped(handle, x, y, value, color, wrap_width) }
}
pub fn native_font_load(handle: usize, path: str, size: f32, weight: u32) -> bool { unsafe { ret encore_ui_font_load(handle, path, size, weight) } }
pub fn native_font_register(handle: usize, family: str, path: str) -> bool { unsafe { ret encore_ui_font_register(handle, family, path) } }
pub fn native_font_select(handle: usize, family: str, size: f32, weight: u32) -> bool { unsafe { ret encore_ui_font_select(handle, family, size, weight) } }
pub fn native_font_clear(handle: usize) -> bool { unsafe { ret encore_ui_font_clear(handle) } }
pub fn native_font_style(handle: usize, size: f32, weight: u32) -> bool { unsafe { ret encore_ui_font_style(handle, size, weight) } }
pub fn native_text_width(handle: usize, value: str) -> f32 { unsafe { ret encore_ui_text_width(handle, value) } }
pub fn native_text_height(handle: usize, value: str) -> f32 { unsafe { ret encore_ui_text_height(handle, value) } }
pub fn native_text_index(handle: usize, value: str, max_width: f32) -> usize { unsafe { ret encore_ui_text_index(handle, value, max_width) } }
