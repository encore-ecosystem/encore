extern fn encore_ui_window_create(title: str, width: u32, height: u32) -> usize
extern fn encore_ui_window_destroy(handle: usize) -> bool
extern fn encore_ui_window_open(handle: usize) -> bool
extern fn encore_ui_window_poll(handle: usize) -> u32
extern fn encore_ui_event_x(handle: usize) -> f32
extern fn encore_ui_event_y(handle: usize) -> f32
extern fn encore_ui_event_key(handle: usize) -> u32
extern fn encore_ui_event_wheel_x(handle: usize) -> f32
extern fn encore_ui_event_wheel_y(handle: usize) -> f32
extern fn encore_ui_frame_begin(handle: usize, color: u32) -> bool
extern fn encore_ui_fill_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, color: u32) -> bool
extern fn encore_ui_stroke_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, color: u32) -> bool
extern fn encore_ui_line(handle: usize, x0: f32, y0: f32, x1: f32, y1: f32, color: u32) -> bool
extern fn encore_ui_text(handle: usize, x: f32, y: f32, value: str, color: u32) -> bool
extern fn encore_ui_font_load(handle: usize, path: str, size: f32) -> bool
extern fn encore_ui_font_clear(handle: usize) -> bool
extern fn encore_ui_text_width(handle: usize, value: str) -> f32
extern fn encore_ui_text_height(handle: usize, value: str) -> f32
extern fn encore_ui_frame_end(handle: usize) -> bool
extern fn encore_ui_backend_name() -> str
extern fn encore_ui_backend_error() -> str

pub fn native_create(title: str, width: u32, height: u32) -> usize { unsafe { ret encore_ui_window_create(title, width, height) } }
pub fn native_destroy(handle: usize) -> bool { unsafe { ret encore_ui_window_destroy(handle) } }
pub fn native_open(handle: usize) -> bool { unsafe { ret encore_ui_window_open(handle) } }
pub fn native_poll(handle: usize) -> u32 { unsafe { ret encore_ui_window_poll(handle) } }
pub fn native_event_x(handle: usize) -> f32 { unsafe { ret encore_ui_event_x(handle) } }
pub fn native_event_y(handle: usize) -> f32 { unsafe { ret encore_ui_event_y(handle) } }
pub fn native_event_key(handle: usize) -> u32 { unsafe { ret encore_ui_event_key(handle) } }
pub fn native_event_wheel_x(handle: usize) -> f32 { unsafe { ret encore_ui_event_wheel_x(handle) } }
pub fn native_event_wheel_y(handle: usize) -> f32 { unsafe { ret encore_ui_event_wheel_y(handle) } }
pub fn native_begin(handle: usize, color: u32) -> bool { unsafe { ret encore_ui_frame_begin(handle, color) } }
pub fn native_fill_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, color: u32) -> bool { unsafe { ret encore_ui_fill_rect(handle, x, y, width, height, color) } }
pub fn native_stroke_rect(handle: usize, x: f32, y: f32, width: f32, height: f32, color: u32) -> bool { unsafe { ret encore_ui_stroke_rect(handle, x, y, width, height, color) } }
pub fn native_line(handle: usize, x0: f32, y0: f32, x1: f32, y1: f32, color: u32) -> bool { unsafe { ret encore_ui_line(handle, x0, y0, x1, y1, color) } }
pub fn native_text(handle: usize, x: f32, y: f32, value: str, color: u32) -> bool { unsafe { ret encore_ui_text(handle, x, y, value, color) } }
pub fn native_font_load(handle: usize, path: str, size: f32) -> bool { unsafe { ret encore_ui_font_load(handle, path, size) } }
pub fn native_font_clear(handle: usize) -> bool { unsafe { ret encore_ui_font_clear(handle) } }
pub fn native_text_width(handle: usize, value: str) -> f32 { unsafe { ret encore_ui_text_width(handle, value) } }
pub fn native_text_height(handle: usize, value: str) -> f32 { unsafe { ret encore_ui_text_height(handle, value) } }
pub fn native_end(handle: usize) -> bool { unsafe { ret encore_ui_frame_end(handle) } }
pub fn native_backend_name() -> str { unsafe { ret encore_ui_backend_name() } }
pub fn native_backend_error() -> str { unsafe { ret encore_ui_backend_error() } }
