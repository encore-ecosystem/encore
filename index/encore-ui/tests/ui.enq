fn layout_child_id(layout: WidgetLayout, index: usize) -> str {
    match layout.children().get(index) {
        Some(child) => { ret child.widget().id() }
        None => { ret "" }
    }
}

fn layout_restyle_contract() -> bool {
    let mut base = Widget::panel("restyle-root").with_direction(vertical()).with_style(Style::default())
    base.push(Widget::button("restyle-first", "First").with_flex(24.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(20_u8, 20_u8, 20_u8))))
    base.push(Widget::button("restyle-second", "Second").with_flex(24.0_f32, 0.0_f32))
    let layout = layout_widget(base, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 100.0_f32))
    let original = layout.find_bounds("restyle-first")

    let mut hovered = Widget::panel("restyle-root").with_direction(vertical()).with_style(Style::default())
    hovered.push(Widget::button("restyle-first", "First").with_flex(24.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(70_u8, 80_u8, 90_u8))))
    hovered.push(Widget::button("restyle-second", "Second").with_flex(24.0_f32, 0.0_f32))
    hovered.push(Widget::label("Hint").with_id("restyle-tooltip").with_style(
        Style::default().with_absolute(true).with_left(12.0_f32).with_top(34.0_f32).with_width(80.0_f32).with_height(20.0_f32)))
    let restyled = layout.restyle(hovered)
    match original {
        Option[Rect]::Some(before) => {
            match restyled.find_bounds("restyle-first") {
                Option[Rect]::Some(after) => {
                    match restyled.find_bounds("restyle-tooltip") {
                        Option[Rect]::Some(tooltip) => {
                            match restyled.find_widget("restyle-first") {
                                Option[Widget]::Some(button) => {
                                    if before.x() != after.x() || before.y() != after.y() ||
                                        before.width() != after.width() || before.height() != after.height() {
                                        println("restyle changed flow geometry")
                                        ret false
                                    }
                                    if button.style().background().red() != 70_u8 {
                                        println("restyle did not replace paint style")
                                        ret false
                                    }
                                    if tooltip.x() != 12.0_f32 || tooltip.y() != 34.0_f32 {
                                        println("restyle positioned overlay at the wrong origin")
                                        ret false
                                    }
                                    if tooltip.width() != 80.0_f32 || tooltip.height() != 20.0_f32 {
                                        println("restyle positioned overlay at the wrong size")
                                        ret false
                                    }
                                    ret true
                                }
                                Option[Widget]::None => { ret false }
                            }
                        }
                        Option[Rect]::None => { ret false }
                    }
                }
                Option[Rect]::None => { ret false }
            }
        }
        Option[Rect]::None => { ret false }
    }
}

fn css_position_contract() -> bool {
    let mut root = Widget::panel("root").with_style(css_style("gap: 8px;"))
    root.push(Widget::label("Flow").with_classes("flow"))
    root.push(Widget::panel("popup").with_style(
        css_style("position: absolute; top: 5px; right: 10px; width: 80px; height: 30px;")))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 100.0_f32))
    let mut stack = Widget::panel("stack").with_style(Style::default())
    stack.push(Widget::button("high", "High").with_style(
        css_style("position: absolute; z-index: 5; left: 0px; top: 0px; width: 60px; height: 40px;")))
    stack.push(Widget::button("low", "Low").with_style(
        css_style("position: absolute; z-index: -2; left: 0px; top: 0px; width: 60px; height: 40px;")))
    let stacked = layout_widget(stack, Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 60.0_f32))
    let mut relative_root = Widget::panel("relative-root").with_style(Style::default())
    relative_root.push(Widget::button("relative", "Relative").with_flex(20.0_f32, 0.0_f32).with_style(
        css_style("position: relative; left: -5px; top: 7px; height: 20px;")))
    relative_root.push(Widget::button("flow-after", "After").with_flex(20.0_f32, 0.0_f32))
    let relative_layout = layout_widget(relative_root, Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 40.0_f32))
    let auto_position = css_style("position: relative; left: -4px; left: auto;").layout().position()
    match (layout.find_bounds("popup")) {
        Some(popup) => {
            match layout.children().get(0_usize) {
                Some(flow) => {
                    ret layout.children().len() == 2_usize && flow.bounds().y() == 0.0_f32 &&
                        popup.x() == 110.0_f32 && popup.y() == 5.0_f32 &&
                        popup.width() == 80.0_f32 && popup.height() == 30.0_f32 &&
                        stacked.hit(20.0_f32, 20.0_f32) == "high" &&
                        layout_child_id(stacked, 0_usize) == "low" && layout_child_id(stacked, 1_usize) == "high" &&
                        relative_layout.find_bounds("relative").unwrap_or(Rect::new(99.0_f32, 99.0_f32, 0.0_f32, 0.0_f32)).x() == -5.0_f32 &&
                        relative_layout.find_bounds("relative").unwrap_or(Rect::new(99.0_f32, 99.0_f32, 0.0_f32, 0.0_f32)).y() == 7.0_f32 &&
                        relative_layout.find_bounds("flow-after").unwrap_or(Rect::new(99.0_f32, 99.0_f32, 0.0_f32, 0.0_f32)).y() == 20.0_f32 &&
                        !auto_position.left_set()
                }
                None => { ret false }
            }
        }
        None => { ret false }
    }
}

fn overflow_hit_clip_contract() -> bool {
    let mut root = Widget::panel("clip").with_style(css_style("overflow: hidden;"))
    root.push(Widget::button("outside", "Outside").with_style(
        css_style("position: absolute; left: 80px; top: 0px; width: 40px; height: 30px;")))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 40.0_f32))
    ret layout.hit(90.0_f32, 10.0_f32) == "outside" && layout.hit(110.0_f32, 10.0_f32) == ""
}

fn scroll_layout_contract() -> bool {
    let mut root = Widget::panel("scroll").with_style(
        Style::default().with_overflow_hidden(true).with_scroll(0.0_f32, 20.0_f32))
    root.push(Widget::button("row", "Row").with_flex(40.0_f32, 0.0_f32).with_style(
        css_style("flex-shrink: 0;")))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 40.0_f32))
    match layout.find_bounds("row") {
        Some(row) => {
            ret row.y() == -20.0_f32 && row.height() == 40.0_f32 &&
                layout.hit(10.0_f32, 10.0_f32) == "row" && layout.hit(10.0_f32, -10.0_f32) == ""
        }
        None => { ret false }
    }
}

fn color_picker_contract() -> bool {
    let color = css_color("#cf4848")
    let picker = Widget::color_picker("accent", "Accent", color)
    let swatch = Widget::color_swatch("red", color, true)
    let channel = Widget::color_channel("red-channel", Color::rgb(191_u8, 20_u8, 30_u8), 0.75_f32, "red")
    ret picker.id() == "accent" && picker.style().border_color().packed() == color.packed() && swatch.checked() &&
        channel.id() == "red-channel" && channel.value() == 0.75_f32 && channel.style().background().red() == 191_u8 &&
        channel.attribute("channel").unwrap_or("") == "red"
}

fn svg_icon_contract() -> bool {
    let source = "<svg viewBox=\"0 0 24 24\"><path d=\"M2 12h20 M12 2v20\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M3 20 C6 4 18 4 21 20 Q12 12 3 20 A4 4 0 0 1 7 16\"/></svg>"
    let document = SvgDocument::parse(source)
    let icon = Widget::icon("add", document)
    let button = Widget::icon_button("save", "Save", document)
    let manager = IconManager::with_bundled("assets/icons")
    ret document.valid() && document.width() == 24.0_f32 && document.height() == 24.0_f32 &&
        document.lines().len() > 50_usize && icon.kind() == widget_icon() && button.kind() == widget_icon_button() &&
        manager.len() >= 1700_usize && manager.document("search").valid()
}

fn svg_lucide_path_regression() -> bool {
    let parentheses = SvgDocument::parse("<svg viewBox=\"0 0 24 24\"><path d=\"M8 21s-4-3-4-9 4-9 4-9\"/><path d=\"M16 3s4 3 4 9-4 9-4 9\"/></svg>")
    let brush = SvgDocument::parse("<svg viewBox=\"0 0 24 24\"><path d=\"m11 10 3 3\"/><path d=\"M6.5 21A3.5 3.5 0 1 0 3 17.5a2.62 2.62 0 0 1-.708 1.792A1 1 0 0 0 3 21z\"/><path d=\"M9.969 17.031 21.378 5.624a1 1 0 0 0-3.002-3.002L6.967 14.031\"/></svg>")
    ret parentheses.valid() && parentheses.lines().len() >= 8_usize &&
        brush.valid() && brush.lines().len() >= 12_usize
}

fn lucide_catalog_contract() -> bool {
    let manager = IconManager::with_bundled("assets/icons")
    let icons = manager.icons()
    let mut index = 0_usize
    while index < icons.len() {
        match icons.get(index) {
            Option[IconAsset]::Some(icon) => {
                let document = icon.document()
                if !document.valid() || document.lines().len() == 0_usize { println("SVG parse failed: " + icon.name()) ret false }
            }
            Option[IconAsset]::None => { ret false }
        }
        index = index + 1_usize
    }
    ret icons.len() >= 1700_usize
}

