        style.padding().top() == 4.0_f32 && style.padding().right() == 8.0_f32 &&
        style.padding().bottom() == 12.0_f32 && style.padding().left() == 16.0_f32 &&
        style.layout().margin().top() == 2.0_f32 && style.layout().margin().right() == 3.0_f32 &&
        style.layout().width() == 120.0_f32 && style.layout().min_height() == 30.0_f32 &&
        style.layout().max_height() == 60.0_f32 && style.layout().overflow_hidden() && style.gap() == 6.0_f32 &&
        style.font_size() == 18.0_f32 && style.font_weight() == 700_u32 && style.opacity() == 0.5_f32
}

