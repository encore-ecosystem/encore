    }
}

fn css_box_sizing_contract() -> bool {
    let mut root = Widget::panel("root").with_style(css_style("flex-direction: column; gap: 0px;"))
    root.push(Widget::panel("border-box").with_flex(40.0_f32, 0.0_f32).with_style(
        css_style("box-sizing: border-box; width: 80px; padding: 10px; border: 2px solid #000;")))
    root.push(Widget::panel("content-box").with_flex(40.0_f32, 0.0_f32).with_style(
        css_style("box-sizing: content-box; width: 80px; padding: 10px; border: 2px solid #000;")))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 80.0_f32))
    match layout.find_bounds("border-box") {
        Some(border_box) => {
            match layout.find_bounds("content-box") {
                Some(content_box) => { ret border_box.width() == 80.0_f32 && content_box.width() == 104.0_f32 }
                None => { ret false }
            }
        }
        None => { ret false }
    }
}

