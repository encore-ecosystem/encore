fn test_case(name: str, passed: bool) -> bool {
    if !passed { println("contract failed: " + name) }
    ret passed
}

fn file_picker_contract() -> bool {
    let picker = FilePicker::new(cwd())
    let icon = SvgDocument::empty()
    let view = picker.view(FilePickerIcons::new(icon, icon, icon, icon, icon, icon, icon))
    let invalid = picker.navigate(picker.directory() + "/__encore_ui_missing_directory__")
    ret is_directory(picker.directory()) && picker.error() == "" && view.id() == "file-picker" &&
        invalid.directory() == picker.directory() && invalid.error() == "Directory does not exist"
}

fn color_contract() -> bool {
    let color = Color::rgba(18_u8, 52_u8, 86_u8, 120_u8)
    ret color.packed() == 305419896_u32
}

fn hsl_color_contract() -> bool {
    let red = css_color("hsl(0, 100%, 50%)")
    let green = css_color("hsl(120, 100%, 50%)")
    let blue = css_color("hsl(-120, 100%, 50%)")
    let translucent = css_color("hsla(240, 100%, 50%, 0.25)")
    let percentage = css_color("rgba(100%, 0%, 50%, 25%)")
    let modern_rgb = css_color("rgb(255 0 128 / 50%)")
    let modern_hsl = css_color("hsl(0.5turn 100% 50% / 0.5)")
    let short_alpha = css_color("#f008")
    if css_number("50%") != 50.0_f32 { ret false }
    ret red.red() == 255_u8 && red.green() == 0_u8 && red.blue() == 0_u8 &&
        green.red() == 0_u8 && green.green() == 255_u8 && green.blue() == 0_u8 &&
        blue.red() == 0_u8 && blue.green() == 0_u8 && blue.blue() == 255_u8 &&
        translucent.blue() == 255_u8 && translucent.alpha() == 64_u8 &&
        percentage.red() == 255_u8 && percentage.green() == 0_u8 &&
        percentage.blue() == 128_u8 && percentage.alpha() == 64_u8 &&
        modern_rgb.red() == 255_u8 && modern_rgb.green() == 0_u8 &&
        modern_rgb.blue() == 128_u8 && modern_rgb.alpha() == 128_u8 &&
        modern_hsl.red() == 0_u8 && modern_hsl.green() == 255_u8 &&
        modern_hsl.blue() == 255_u8 && modern_hsl.alpha() == 128_u8 &&
        short_alpha.red() == 255_u8 && short_alpha.green() == 0_u8 &&
        short_alpha.blue() == 0_u8 && short_alpha.alpha() == 136_u8
}

fn geometry_contract() -> bool {
    let rect = Rect::new(10.0_f32, 20.0_f32, 100.0_f32, 80.0_f32)
    let inner = rect.inset(Insets::symmetric(10.0_f32, 5.0_f32))
    ret inner.x() == 15.0_f32 && inner.y() == 30.0_f32 &&
        inner.width() == 90.0_f32 && inner.height() == 60.0_f32 &&
        rect.right() == 110.0_f32
}

fn layout_contract() -> bool {
    let mut items = Vec[FlexItem]::new()
    items.push(FlexItem::fixed(100.0_f32))
    items.push(FlexItem::flexible(1.0_f32))
    items.push(FlexItem::flexible(2.0_f32))
    let result = flex_layout(Rect::new(0.0_f32, 0.0_f32, 330.0_f32, 40.0_f32), horizontal(), 10.0_f32, items)
    match result.get(2_usize) {
        Some(last) => { ret result.len() == 3_usize && last.x() == 190.0_f32 && last.width() == 140.0_f32 }
        None => { ret false }
    }
}

fn flex_shrink_contract() -> bool {
    let mut items = Vec[FlexItem]::new()
    items.push(FlexItem::sized(80.0_f32, 0.0_f32, 1.0_f32, 30.0_f32, 100.0_f32))
    items.push(FlexItem::sized(80.0_f32, 0.0_f32, 1.0_f32, 30.0_f32, 100.0_f32))
    let result = flex_layout(Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 20.0_f32), horizontal(), 0.0_f32, items)
    match result.get(1_usize) {
        Some(second) => { ret second.x() == 50.0_f32 && second.width() == 50.0_f32 }
        None => { ret false }
    }
}

fn flex_constraint_redistribution_contract() -> bool {
    let mut shrinking = Vec[FlexItem]::new()
    shrinking.push(FlexItem::sized(100.0_f32, 0.0_f32, 1.0_f32, 90.0_f32, 200.0_f32))
    shrinking.push(FlexItem::sized(100.0_f32, 0.0_f32, 1.0_f32, 0.0_f32, 200.0_f32))
    let shrunk = flex_layout(Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 20.0_f32), horizontal(), 0.0_f32, shrinking)
    let mut growing = Vec[FlexItem]::new()
    growing.push(FlexItem::sized(40.0_f32, 1.0_f32, 1.0_f32, 0.0_f32, 60.0_f32))
    growing.push(FlexItem::sized(40.0_f32, 1.0_f32, 1.0_f32, 0.0_f32, 120.0_f32))
    let grown = flex_layout(Rect::new(0.0_f32, 0.0_f32, 160.0_f32, 20.0_f32), horizontal(), 0.0_f32, growing)
    match shrunk.get(1_usize) {
        Some(shrunk_second) => {
            match grown.get(1_usize) {
                Some(grown_second) => {
                    ret shrunk_second.x() == 90.0_f32 && shrunk_second.width() == 10.0_f32 &&
                        grown_second.x() == 60.0_f32 && grown_second.width() == 100.0_f32
                }
                None => { ret false }
            }
        }
        None => { ret false }
    }
}

fn widget_hit_contract() -> bool {
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(Style::panel().with_gap(4.0_f32))
    root.push(Widget::button("save", "Save"))
    root.push(Widget::spacer(1.0_f32))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 120.0_f32))
    ret layout.hit(20.0_f32, 20.0_f32) == "save"
}

fn layout_accessor_reuse_contract() -> bool {
    let mut root = Widget::panel("root")
    root.push(Widget::button("run", "Run"))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 60.0_f32))
    let widget = layout.widget()
    let bounds = layout.bounds()
    let children = layout.children()
    ret widget.id() == "root" && bounds.width() == 100.0_f32 && children.len() == 1_usize
}

fn nested_style_contract() -> bool {
    let accent = Color::rgb(20_u8, 153_u8, 126_u8)
    let mut root = Widget::panel("root")
    root.push(Widget::button("run", "Run").with_style(Style::panel().with_background(accent)))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 100.0_f32))
    match layout.children().get(0_usize) {
        Some(child) => { ret child.widget().style().background().packed() == accent.packed() }
        None => { ret false }
    }
}

fn theme_contract() -> bool {
    let theme = Theme::light()
    let primary = theme.primary_button()
    let outline = theme.outline_button()
    ret primary.background().packed() == theme.primary().packed() &&
        primary.foreground().packed() != primary.background().packed() &&
        outline.background().packed() == theme.surface().packed() &&
        outline.border_width() == 1.0_f32
}

fn bundled_fonts_contract() -> bool {
    let fonts = FontManager::with_bundled("assets/fonts")
    ret fonts.faces().len() == 4_usize && fonts.default_family() == "Open Sans" &&
        fonts.find("Open Sans").is_some() && fonts.find("Inter").is_some() &&
        fonts.find("Roboto").is_some() && fonts.find("Roboto Mono").is_some()
}

fn font_directory_filter_contract() -> bool {
    let mut fonts = FontManager::new()
    let loaded = fonts.load_directory("demo/fonts")
    ret loaded == 2_usize && fonts.faces().len() == 2_usize &&
        fonts.find("README.md").is_none()
}

fn button_animation_contract() -> bool {
    let animation = ButtonAnimation::new(100_u64).with_duration(200_u64).with_easing(easing_linear()).with_hovered(true).advance(100_u64)
    let normal = Style::default().with_background(Color::rgb(0_u8, 0_u8, 0_u8))
    let hovered = Style::default().with_background(Color::rgb(200_u8, 100_u8, 50_u8))
    let result = animation.style(normal, hovered, hovered)
    ret animation.hover_progress() == 0.5_f32 && animation.duration_ms() == 200_u64 &&
        animation.easing() == easing_linear() && result.background().red() == 100_u8
}

fn border_transition_contract() -> bool {
    let from = Style::default().with_border(1.0_f32, Color::rgb(0_u8, 20_u8, 40_u8)).with_radius(4.0_f32)
        .with_outline(0.0_f32, Color::rgb(20_u8, 40_u8, 60_u8), 0.0_f32)
        .with_shadow(0.0_f32, 2.0_f32, 0.0_f32, 0.0_f32, Color::rgba(0_u8, 20_u8, 40_u8, 100_u8), false)
    let to = Style::default().with_border(5.0_f32, Color::rgb(100_u8, 120_u8, 140_u8)).with_radius(12.0_f32)
        .with_outline(4.0_f32, Color::rgb(120_u8, 140_u8, 160_u8), 2.0_f32)
        .with_shadow(8.0_f32, 10.0_f32, 12.0_f32, 4.0_f32, Color::rgba(100_u8, 120_u8, 140_u8, 200_u8), true)
    let middle = interpolate_style(from, to, 0.5_f32)
    let clamped = interpolate_style(from, to, 2.0_f32)
    ret middle.border_width() == 3.0_f32 && middle.border_color().red() == 50_u8 &&
        middle.radius() == 8.0_f32 && middle.outline().width() == 2.0_f32 &&
        middle.outline().color().red() == 70_u8 && middle.outline().offset() == 1.0_f32 &&
        middle.shadow().x() == 4.0_f32 && middle.shadow().y() == 6.0_f32 &&
        middle.shadow().blur() == 6.0_f32 && middle.shadow().spread() == 2.0_f32 &&
        middle.shadow().color().red() == 50_u8 && middle.shadow().color().alpha() == 150_u8 && middle.shadow().inset() &&
        clamped.border_width() == 5.0_f32 && clamped.radius() == 12.0_f32
}

fn standard_widgets_contract() -> bool {
    let checkbox = Widget::checkbox("terms", "Accept", true)
    let input = Widget::input("name", "Encore").with_focus(true)
    let slider = Widget::slider("volume", 1.5_f32)
    let progress = Widget::progress(-1.0_f32)
    ret checkbox.checked() && checkbox.id() == "terms" && input.focused() && !input.checked() &&
        slider.value() == 1.0_f32 && progress.value() == 0.0_f32
}

fn disabled_widget_contract() -> bool {
    let root = Widget::button("submit", "Submit").with_disabled(true)
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 100.0_f32, 40.0_f32))
    let sheet = StyleSheet::parse("button:disabled { opacity: 0.4; }")
    let styled = sheet.style(root, false, false, false)
    ret root.disabled() && layout.hit(20.0_f32, 20.0_f32) == "" && styled.opacity() == 0.4_f32
}

fn interaction_state_contract() -> bool {
    let mut root = Widget::panel("root").with_style(Style::default())
    root.push(Widget::button("first", "First").with_flex(30.0_f32, 0.0_f32))
    root.push(Widget::button("disabled", "Disabled").with_disabled(true).with_flex(30.0_f32, 0.0_f32))
    root.push(Widget::button("hidden", "Hidden").with_style(Style::default().with_visibility(false)).with_flex(30.0_f32, 0.0_f32))
    root.push(Widget::input("last", "Last").with_flex(30.0_f32, 0.0_f32))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 120.0_f32))
    let pointer = InteractionState::new().pointer_move(layout, 20.0_f32, 15.0_f32).pointer_down(layout, 20.0_f32, 15.0_f32)
    let next = pointer.focus_next(root)
    let wrapped = next.focus_next(root)
    ret pointer.hovered() == "first" && pointer.active() == "first" && pointer.focused() == "first" &&
        pointer.pointer_release_target(layout, 20.0_f32, 15.0_f32) == "first" &&
        pointer.pointer_release_target(layout, 20.0_f32, 105.0_f32) == "" && pointer.focused_action(root) == "first" &&
        next.focused() == "last" && next.focused_action(root) == "" && wrapped.focused() == "first"
}

fn text_editor_contract() -> bool {
    let editor = TextEditor::new("Encore").move_left(false).move_left(false).insert(" UI")
    let selected = editor.with_selection(0_usize, 4_usize).insert("Native")
    let erased = selected.move_end(false).backspace().delete()
    let clipboard = editor.with_selection(4_usize, 7_usize)
    let input = Widget::input("editor", selected.value()).with_selection(selected.selection_start(), selected.selection_end())
    let multiline = TextEditor::new("ab").move_left(false).insert("\n")
    let textarea = Widget::textarea("notes", multiline.value()).with_cursor(multiline.cursor())
    let lines = TextEditor::new("abcd\nxy\n12345").with_cursor(3_usize)
    let down_short = lines.move_down(false)
    let down_again = down_short.move_down(false)
    let up = down_again.move_up(false)
    let line_home = TextEditor::new("abc\ndef").with_cursor(6_usize).move_line_home(false)
    let line_end = TextEditor::new("abc\ndef").with_cursor(4_usize).move_line_end(false)
    let extended = down_again.move_up(true)
    ret editor.value() == "Enco UIre" && editor.cursor() == 7_usize &&
        selected.value() == "Native UIre" && selected.cursor() == 6_usize && erased.value() == "Native UIr"
        && input.cursor() == 6_usize && input.selection().start() == 6_usize &&
        clipboard.selected_text() == " UI" && clipboard.cut().value() == "Encore" &&
        multiline.value() == "a\nb" && multiline.cursor() == 2_usize && textarea.cursor() == 2_usize &&
        down_short.cursor() == 7_usize && down_again.cursor() == 10_usize && up.cursor() == 7_usize &&
        line_home.cursor() == 4_usize && line_end.cursor() == 7_usize &&
        extended.selection_start() == 7_usize && extended.selection_end() == 10_usize
}

