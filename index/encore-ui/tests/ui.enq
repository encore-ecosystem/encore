fn stylesheet_cascade_contract() -> bool {
    let sheet = StyleSheet::parse(
        "button { background-color: #111111; border-width: 1px; } " +
        ".primary { background-color: #222222; } " +
        "button.primary:hover { background-color: #333333; border-width: 3px; } " +
        "#save { border-color: #abcdef; }")
    let button = Widget::button("save", "Save").with_classes("primary compact")
    let normal = sheet.style(button, false, false, false)
    let hovered = sheet.style(button, true, false, false)
    ret sheet.len() == 4_usize && normal.background().packed() == css_color("#222222").packed() &&
        normal.border_color().packed() == css_color("#abcdef").packed() &&
        hovered.background().packed() == css_color("#333333").packed() && hovered.border_width() == 3.0_f32
}

fn css_parser_contract() -> bool {
    let sheet = StyleSheet::parse("/* controls */ button, .action { color: rgb(18, 52, 86); background: rgba(200, 100, 50, 0.5); } .quoted { font-family: \"A/*B*/}C\"; }")
    let button = sheet.style(Widget::button("run", "Run"), false, false, false)
    let action = sheet.style(Widget::label("Action").with_classes("action"), false, false, false)
    let styled_quoted = sheet.style(Widget::label("Quoted").with_classes("quoted"), false, false, false)
    let quoted = css_style("font-family: \"A;B:C\"; color: red;")
    ret sheet.len() == 3_usize && button.foreground().packed() == Color::rgb(18_u8, 52_u8, 86_u8).packed() &&
        action.background().red() == 200_u8 && action.background().green() == 100_u8 &&
        action.background().blue() == 50_u8 && action.background().alpha() == 128_u8 &&
        styled_quoted.font_family() == "A/*B*/}C" && quoted.font_family() == "A;B:C" &&
        quoted.foreground().packed() == css_color("red").packed()
}

fn css_variable_contract() -> bool {
    let sheet = StyleSheet::parse(
        ":root { --accent: var(--base); --base: #2878d0; } .dark { --accent: #cf4848; } button { background-color: var(--accent); color: var(--missing, rgb(255, 255, 255)); }")
    let mut root = Widget::panel("root")
    root.push(Widget::button("light", "Light"))
    let mut dark = Widget::panel("dark").with_classes("dark")
    dark.push(Widget::button("dark-button", "Dark"))
    root.push(dark)
    let styled = sheet.apply(root, "", "", "")
    match styled.children().get(0_usize) {
        Some(light) => {
            match styled.children().get(1_usize) {
                Some(dark_panel) => {
                    match dark_panel.children().get(0_usize) {
                        Some(dark_button) => {
                            ret light.style().background().packed() == css_color("#2878d0").packed() &&
                                light.style().foreground().packed() == css_color("#ffffff").packed() &&
                                dark_button.style().background().packed() == css_color("#cf4848").packed()
                        }
                        None => { ret false }
                    }
                }
                None => { ret false }
            }
        }
        None => { ret false }
    }
}

fn css_box_shorthand_contract() -> bool {
    let style = css_style(
        "border: 2px solid #336699; outline: 3px solid #cf4848; outline-offset: 2px; box-shadow: inset 4px 6px 8px 2px rgb(10 20 30 / 50%); padding: 1px 2px 3px 4px; padding-left: 9px; margin: 5px; margin-bottom: 11px;")
