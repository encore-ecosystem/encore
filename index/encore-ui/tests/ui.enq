import encore_ui::{Color, FlexItem, Insets, Rect, Style, Widget, flex_layout, horizontal, layout_widget, vertical}
import core::testing::assert
import core::vec::Vec

fn color_contract() -> bool {
    let color = Color::rgba(18_u8, 52_u8, 86_u8, 120_u8)
    ret color.packed() == 305419896_u32
}

fn geometry_contract() -> bool {
    let rect = Rect::new(10.0_f32, 20.0_f32, 100.0_f32, 80.0_f32)
    let inner = rect.inset(Insets::symmetric(10.0_f32, 5.0_f32))
    ret inner.x() == 15.0_f32 && inner.y() == 30.0_f32 &&
        inner.width() == 90.0_f32 && inner.height() == 60.0_f32 &&
        rect.right() == 110.0_f32
}

fn layout_contract() -> bool {
    let mut items = Vec[FlexItem]::new()
    items.push(FlexItem::fixed(100.0_f32))
    items.push(FlexItem::flexible(1.0_f32))
    items.push(FlexItem::flexible(2.0_f32))
    let result = flex_layout(Rect::new(0.0_f32, 0.0_f32, 330.0_f32, 40.0_f32), horizontal(), 10.0_f32, items)
    match result.get(2_usize) {
        Some(last) => { ret result.len() == 3_usize && last.x() == 190.0_f32 && last.width() == 140.0_f32 }
        None => { ret false }
    }
}

fn widget_hit_contract() -> bool {
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(Style::panel().with_gap(4.0_f32))
    root.push(Widget::button("save", "Save"))
    root.push(Widget::spacer(1.0_f32))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 120.0_f32))
    ret layout.hit(20.0_f32, 20.0_f32) == "save"
}

fn nested_style_contract() -> bool {
    let accent = Color::rgb(20_u8, 153_u8, 126_u8)
    let mut root = Widget::panel("root")
    root.push(Widget::button("run", "Run").with_style(Style::panel().with_background(accent)))
    let layout = layout_widget(root, Rect::new(0.0_f32, 0.0_f32, 200.0_f32, 100.0_f32))
    match layout.children().get(0_usize) {
        Some(child) => { ret child.widget().style().background().packed() == accent.packed() }
        None => { ret false }
    }
}

fn main() -> u32 {
    if !assert(color_contract()) { ret 1_u32 }
    if !assert(geometry_contract()) { ret 1_u32 }
    if !assert(layout_contract()) { ret 1_u32 }
    if !assert(widget_hit_contract()) { ret 1_u32 }
    if !assert(nested_style_contract()) { ret 1_u32 }
    ret 0_u32
}
