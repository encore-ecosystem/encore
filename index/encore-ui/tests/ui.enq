        style.shadow().blur() == 8.0_f32 && style.shadow().spread() == 2.0_f32 &&
        style.shadow().color().red() == 10_u8 && style.shadow().color().green() == 20_u8 &&
        style.shadow().color().blue() == 30_u8 && style.shadow().color().alpha() == 128_u8 && style.shadow().inset() &&
        style.padding().top() == 1.0_f32 && style.padding().left() == 9.0_f32 &&
        style.layout().margin().top() == 5.0_f32 && style.layout().margin().bottom() == 11.0_f32
}

fn css_text_decoration_contract() -> bool {
    let shorthand = css_style("text-decoration: underline line-through rgb(10 20 30 / 50%) 3px;")
    let longhand = css_style(
        "text-decoration-line: overline; text-decoration-color: #cf4848; text-decoration-thickness: 2px;")
    let cleared = apply_css(shorthand, "text-decoration: none;")
    let animated = interpolate_style(Style::default(), longhand, 0.75_f32)
    ret shorthand.decoration().underline() && shorthand.decoration().line_through() &&
        !shorthand.decoration().overline() && shorthand.decoration().color_set() &&
        shorthand.decoration().color().red() == 10_u8 && shorthand.decoration().color().alpha() == 128_u8 &&
        shorthand.decoration().thickness() == 3.0_f32 && longhand.decoration().overline() &&
        longhand.decoration().color().packed() == css_color("#cf4848").packed() &&
        longhand.decoration().thickness() == 2.0_f32 && !cleared.decoration().underline() &&
        !cleared.decoration().line_through() && animated.decoration().overline()
}

fn css_flex_contract() -> bool {
