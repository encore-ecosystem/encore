    root.push(Widget::button("restored", "Visible").with_flex(30.0_f32, 0.0_f32).with_style(
        css_style("visibility: visible; pointer-events: auto;")))
    let styled = StyleSheet::parse("").apply(root, "", "", "")
    let layout = layout_widget(styled, Rect::new(0.0_f32, 0.0_f32, 160.0_f32, 60.0_f32))
    match layout.children().get(0_usize) {
        Some(hidden) => {
            match layout.children().get(1_usize) {
                Some(restored) => {
                    ret layout.children().len() == 2_usize && !hidden.widget().style().visible() &&
                        restored.widget().style().visible() && restored.widget().style().pointer_events() &&
                        layout.hit(10.0_f32, 15.0_f32) == "" && layout.hit(10.0_f32, 45.0_f32) == "restored"
                }
                None => { ret false }
            }
        }
        None => { ret false }
    }
}

