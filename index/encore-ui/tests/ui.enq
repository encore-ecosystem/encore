fn css_reverse_and_empty_selector_contract() -> bool {
    let sheet = StyleSheet::parse(
        ".list > button:nth-last-child(2n + 1) { border-width: 3px; } " +
        ".list > button:nth-last-child(2) { border-radius: 13px; } " +
        ".placeholder:empty { opacity: 0.25; } .placeholder:not(:empty) { opacity: 0.75; }")
    let mut root = Widget::panel("root")
    let mut list = Widget::panel("list").with_classes("list")
    list.push(Widget::button("one", "One"))
    list.push(Widget::button("two", "Two"))
    list.push(Widget::button("three", "Three"))
    list.push(Widget::button("four", "Four"))
    root.push(list)
    root.push(Widget::panel("empty").with_classes("placeholder"))
    root.push(Widget::label("content").with_classes("placeholder"))
    let styled = sheet.apply(root, "", "", "")
    let styled_list = test_child(styled, 0_usize)
    let first = test_child(styled_list, 0_usize)
    let second = test_child(styled_list, 1_usize)
    let third = test_child(styled_list, 2_usize)
    let fourth = test_child(styled_list, 3_usize)
    let empty = test_child(styled, 1_usize)
    let content = test_child(styled, 2_usize)
    ret first.style().border_width() == 1.0_f32 && second.style().border_width() == 3.0_f32 &&
        third.style().border_width() == 1.0_f32 && fourth.style().border_width() == 3.0_f32 &&
        third.style().radius() == 13.0_f32 && empty.style().opacity() == 0.25_f32 && content.style().opacity() == 0.75_f32
}

fn test_child(widget: Widget, index: usize) -> Widget {
    match widget.children().get(index) {
        Some(value) => { ret value }
        None => { ret Widget::panel("__missing-test-child") }
    }
}

