import core::option::Option
import core::os

fn main() -> u32 {
    match os::argv(1_usize) {
        Option[str]::Some(path) => {
            let payload = "{\n  \"native\": {\n    \"libraries\": [{\"name\":\"encore_ui_native\",\"path\":\"runtime.c\"}],\n    \"search_paths\": [],\n    \"frameworks\": [],\n    \"link_args\": []\n  }\n}\n"
            if os::write_file(path, payload) != 0_i32 { ret 1_u32 }
            ret 0_u32
        }
        Option[str]::None => { ret 2_u32 }
    }
}
