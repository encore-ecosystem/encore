import core::fmt::Debug
import core::option::Option
import core::vec::Vec
import encore_ui::{Color, Rect, Window}

fn draw_font_menu(window: Window, fonts: Vec[str]) -> () {
    let menu_x = 600.0_f32
    let menu_y = 132.0_f32
    let menu_width = 272.0_f32
    let row_height = 34.0_f32
    let count = if fonts.len() > 10_usize { 10_usize } else { fonts.len() }
    window.fill_rect(Rect::new(menu_x, menu_y, menu_width, row_height * count as f32), Color::rgb(255_u8, 255_u8, 255_u8))
    let mut index = 0_usize
    while index < count {
        match fonts.get(index) {
            Option[str]::Some(name) => {
                let y = menu_y + row_height * index as f32
                window.stroke_rect(Rect::new(menu_x, y, menu_width, row_height), Color::rgb(204_u8, 212_u8, 221_u8))
                window.text(menu_x + 10.0_f32, y + 10.0_f32, name, Color::rgb(28_u8, 33_u8, 40_u8))
            }
            Option[str]::None => {}
        }
        index = index + 1_usize
    }
    ret ()
}

pub fn draw(window: Window, selected: str, load_error: str, available: Vec[str], menu_open: bool) -> () {
    let background = Color::rgb(246_u8, 248_u8, 251_u8)
    let ink = Color::rgb(28_u8, 33_u8, 40_u8)
    let muted = Color::rgb(91_u8, 102_u8, 116_u8)
    let accent = Color::rgb(18_u8, 153_u8, 126_u8)
    let sample = "Encore UI: Typography / Кириллица / 日本語"

    window.begin(background)
    window.fill_rect(Rect::new(24.0_f32, 70.0_f32, window.width() as f32 - 48.0_f32, 520.0_f32), Color::rgb(255_u8, 255_u8, 255_u8))
    window.stroke_rect(Rect::new(24.0_f32, 70.0_f32, window.width() as f32 - 48.0_f32, 520.0_f32), Color::rgb(204_u8, 212_u8, 221_u8))
    window.text(48.0_f32, 98.0_f32, "FONT PREVIEW", muted)
    window.text(48.0_f32, 142.0_f32, sample, ink)
    window.text(48.0_f32, 196.0_f32, "The quick brown fox jumps over the lazy dog.", ink)
    window.text(48.0_f32, 248.0_f32, "0123456789  !@#$%^&*()  []{}", ink)
    window.fill_rect(Rect::new(48.0_f32, 312.0_f32, window.text_width(sample), 3.0_f32), accent)
    window.text(48.0_f32, 332.0_f32, "Measured width: " + Debug::fmt(window.text_width(sample)), muted)
    window.text(48.0_f32, 370.0_f32, "Selected: " + selected, muted)
    if load_error != "" { window.text(48.0_f32, 408.0_f32, "Font error: " + load_error, Color::rgb(207_u8, 72_u8, 72_u8)) }
    window.text(48.0_f32, 452.0_f32, "Escape closes the demo", muted)
    window.fill_rect(Rect::new(600.0_f32, 88.0_f32, 272.0_f32, 38.0_f32), Color::rgb(238_u8, 242_u8, 246_u8))
    window.stroke_rect(Rect::new(600.0_f32, 88.0_f32, 272.0_f32, 38.0_f32), Color::rgb(166_u8, 177_u8, 189_u8))
    window.text(610.0_f32, 100.0_f32, if available.len() == 0_usize { "No fonts in demo/fonts" } else { "Choose font  v" }, ink)
    if menu_open { draw_font_menu(window, available) }
    ret ()
}
