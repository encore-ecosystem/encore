import core::fmt::Debug
import core::option::Option
import core::vec::Vec
import encore_ui::{Color, FontFace, Rect, Window}

fn draw_font_menu(window: Window, fonts: Vec[FontFace]) -> () {
    let menu_x = 600.0_f32
    let menu_y = 132.0_f32
    let menu_width = 272.0_f32
    let row_height = 34.0_f32
    let count = if fonts.len() > 10_usize { 10_usize } else { fonts.len() }
    window.fill_rect(Rect::new(menu_x, menu_y, menu_width, row_height * count as f32), Color::rgb(255_u8, 255_u8, 255_u8))
    let mut index = 0_usize
    while index < count {
        match fonts.get(index) {
            Option[FontFace]::Some(face) => {
                let y = menu_y + row_height * index as f32
                window.stroke_rect(Rect::new(menu_x, y, menu_width, row_height), Color::rgb(204_u8, 212_u8, 221_u8))
                let source = if face.is_bundled() { "bundled" } else { "custom" }
                window.text(menu_x + 10.0_f32, y + 8.0_f32, face.family() + "  (" + source + ")", Color::rgb(28_u8, 33_u8, 40_u8))
            }
            Option[str]::None => {}
        }
        index = index + 1_usize
    }
    ret ()
}

fn draw_stepper(window: Window, y: f32, label: str, value: str, ink: Color, muted: Color, accent: Color) -> () {
    window.text(48.0_f32, y + 9.0_f32, label, muted)
    window.fill_rect(Rect::new(180.0_f32, y, 36.0_f32, 32.0_f32), Color::rgb(238_u8, 242_u8, 246_u8))
    window.stroke_rect(Rect::new(180.0_f32, y, 36.0_f32, 32.0_f32), accent)
    window.text(194.0_f32, y + 8.0_f32, "-", ink)
    window.text(230.0_f32, y + 9.0_f32, value, ink)
    window.fill_rect(Rect::new(310.0_f32, y, 36.0_f32, 32.0_f32), Color::rgb(238_u8, 242_u8, 246_u8))
    window.stroke_rect(Rect::new(310.0_f32, y, 36.0_f32, 32.0_f32), accent)
    window.text(324.0_f32, y + 8.0_f32, "+", ink)
    ret ()
}

pub fn draw(window: Window, selected: str, load_error: str, available: Vec[FontFace], menu_open: bool, sample: str, size: f32, weight: u32) -> () {
    let background = Color::rgb(246_u8, 248_u8, 251_u8)
    let ink = Color::rgb(28_u8, 33_u8, 40_u8)
    let muted = Color::rgb(91_u8, 102_u8, 116_u8)
    let accent = Color::rgb(18_u8, 153_u8, 126_u8)
    window.begin(background)
    window.fill_rect(Rect::new(24.0_f32, 70.0_f32, window.width() as f32 - 48.0_f32, 520.0_f32), Color::rgb(255_u8, 255_u8, 255_u8))
    window.stroke_rect(Rect::new(24.0_f32, 70.0_f32, window.width() as f32 - 48.0_f32, 520.0_f32), Color::rgb(204_u8, 212_u8, 221_u8))
    window.text(48.0_f32, 98.0_f32, "FONT PREVIEW - TYPE TO EDIT", muted)
    window.fill_rect(Rect::new(44.0_f32, 126.0_f32, window.width() as f32 - 92.0_f32, 48.0_f32), Color::rgb(247_u8, 249_u8, 251_u8))
    window.stroke_rect(Rect::new(44.0_f32, 126.0_f32, window.width() as f32 - 92.0_f32, 48.0_f32), accent)
    if sample == "" { window.text(48.0_f32, 142.0_f32, "Type your text here...", muted) }
    else { window.text(48.0_f32, 142.0_f32, sample, ink) }
    window.text(48.0_f32, 210.0_f32, if sample == "" { "Your text: empty" } else { "Your text: " + sample }, ink)
    window.text(48.0_f32, 332.0_f32, "Selected: " + selected, muted)
    window.text(48.0_f32, 362.0_f32, "Measured width: " + Debug::fmt(window.text_width(sample)), muted)
    draw_stepper(window, 390.0_f32, "Size", Debug::fmt(size) + " pt", ink, muted, accent)
    draw_stepper(window, 438.0_f32, "Weight", Debug::fmt(weight), ink, muted, accent)
    if load_error != "" { window.text(48.0_f32, 494.0_f32, "Font error: " + load_error, Color::rgb(207_u8, 72_u8, 72_u8)) }
    window.text(48.0_f32, 536.0_f32, "Type in the preview field. Backspace removes a character.", muted)
    window.fill_rect(Rect::new(600.0_f32, 88.0_f32, 272.0_f32, 38.0_f32), Color::rgb(238_u8, 242_u8, 246_u8))
    window.stroke_rect(Rect::new(600.0_f32, 88.0_f32, 272.0_f32, 38.0_f32), Color::rgb(166_u8, 177_u8, 189_u8))
    window.text(610.0_f32, 100.0_f32, if available.len() == 0_usize { "No registered fonts" } else { "Choose font  v" }, ink)
    if menu_open { draw_font_menu(window, available) }
    ret ()
}
