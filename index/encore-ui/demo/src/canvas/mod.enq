import encore_ui::{Color, Rect, Window}

pub fn draw(window: Window, cursor_x: f32, cursor_y: f32) -> () {
    let background = Color::rgb(24_u8, 28_u8, 34_u8)
    let minor = Color::rgb(47_u8, 54_u8, 63_u8)
    let major = Color::rgb(72_u8, 82_u8, 94_u8)
    let axis_x = Color::rgb(215_u8, 91_u8, 86_u8)
    let axis_y = Color::rgb(72_u8, 145_u8, 226_u8)
    let cursor = Color::rgb(42_u8, 205_u8, 166_u8)

    window.begin(background)
    let mut x = 0_u32
    while x <= window.width() {
        let color = if x % 100_u32 == 0_u32 { major } else { minor }
        window.line(x as f32, 0.0_f32, x as f32, window.height() as f32, color)
        x = x + 20_u32
    }
    let mut y = 0_u32
    while y <= window.height() {
        let color = if y % 100_u32 == 0_u32 { major } else { minor }
        window.line(0.0_f32, y as f32, window.width() as f32, y as f32, color)
        y = y + 20_u32
    }
    window.line((window.width() / 2_u32) as f32, 0.0_f32, (window.width() / 2_u32) as f32, window.height() as f32, axis_y)
    window.line(0.0_f32, (window.height() / 2_u32) as f32, window.width() as f32, (window.height() / 2_u32) as f32, axis_x)
    window.stroke_rect(Rect::new(cursor_x - 6.0_f32, cursor_y - 6.0_f32, 12.0_f32, 12.0_f32), cursor)
    window.text(12.0_f32, 68.0_f32, "Encore UI canvas", Color::rgb(235_u8, 239_u8, 244_u8))
    ret ()
}
