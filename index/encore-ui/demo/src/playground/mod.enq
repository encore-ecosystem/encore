import core::fmt::Debug
import encore_ui::{Color, TextEditor, Widget, css_style, horizontal, key_delete, key_end, key_home, key_left, key_right, vertical}

pub struct PlaygroundState {
    editor: TextEditor
    focus: str
    red: f32
    green: f32
    blue: f32
    alpha: f32
    picker_open: bool
    drag: str
}

impl for PlaygroundState {
    pub fn new() -> PlaygroundState {
        ret PlaygroundState { TextEditor::new("color: #ffffff; border: 3px solid #0d745f; border-radius: 12px; padding: 24px; font-size: 22px; box-shadow: 0px 10px 24px 0px rgb(31 36 43 / 24%);"),
            "", 18.0_f32 / 255.0_f32, 153.0_f32 / 255.0_f32, 126.0_f32 / 255.0_f32, 1.0_f32, false, "" }
    }
    pub fn focus(self: Self) -> str { ret self.focus }
    pub fn css(self: Self) -> str { ret self.editor.value() }
    pub fn cursor(self: Self) -> usize { ret self.editor.cursor() }
    pub fn selection_start(self: Self) -> usize { ret self.editor.selection_start() }
    pub fn selection_end(self: Self) -> usize { ret self.editor.selection_end() }
    pub fn drag(self: Self) -> str { ret self.drag }
    pub fn picker_open(self: Self) -> bool { ret self.picker_open }
    pub fn color(self: Self) -> Color {
        ret Color::rgba((self.red * 255.0_f32) as u8, (self.green * 255.0_f32) as u8,
            (self.blue * 255.0_f32) as u8, (self.alpha * 255.0_f32) as u8)
    }
    pub fn color_css(self: Self) -> str {
        ret "rgba(" + Debug::fmt((self.red * 255.0_f32) as u32) + " " +
            Debug::fmt((self.green * 255.0_f32) as u32) + " " +
            Debug::fmt((self.blue * 255.0_f32) as u32) + " / " + Debug::fmt(self.alpha) + ")"
    }
    pub fn click(self: Self, target: str) -> PlaygroundState {
        if target == "css-editor" { ret playground(self, self.editor, "css-editor", self.red, self.green, self.blue, self.alpha, self.picker_open, self.drag) }
        if target == "playground-color" { ret playground(self, self.editor, "", self.red, self.green, self.blue, self.alpha, !self.picker_open, "") }
        if target == "css-reset" { ret PlaygroundState::new() }
        if target == "css-flat" {
            ret playground(self, TextEditor::new("color: #1f242b; border: 1px solid #a6b1bd; border-radius: 2px; padding: 18px; font-size: 18px; box-shadow: none;"),
                "", self.red, self.green, self.blue, self.alpha, self.picker_open, "")
        }
        if target == "css-pill" {
            ret playground(self, TextEditor::new("color: #ffffff; border: 2px solid #ffffff; border-radius: 28px; padding: 20px; font-size: 20px; font-weight: 700; box-shadow: 0px 8px 18px 0px rgb(31 36 43 / 28%);"),
                "", self.red, self.green, self.blue, self.alpha, self.picker_open, "")
        }
        if target == "swatch-teal" { ret with_color(self, 18_u8, 153_u8, 126_u8, 255_u8) }
        if target == "swatch-blue" { ret with_color(self, 40_u8, 120_u8, 208_u8, 255_u8) }
        if target == "swatch-violet" { ret with_color(self, 117_u8, 87_u8, 200_u8, 255_u8) }
        if target == "swatch-red" { ret with_color(self, 207_u8, 72_u8, 72_u8, 255_u8) }
        ret playground(self, self.editor, "", self.red, self.green, self.blue, self.alpha, self.picker_open, self.drag)
    }
    pub fn begin_drag(self: Self, target: str) -> PlaygroundState {
        let drag = if target == "picker-red" || target == "picker-green" || target == "picker-blue" || target == "picker-alpha" { target } else { "" }
        ret playground(self, self.editor, self.focus, self.red, self.green, self.blue, self.alpha, self.picker_open, drag)
    }
    pub fn end_drag(self: Self) -> PlaygroundState {
        ret playground(self, self.editor, self.focus, self.red, self.green, self.blue, self.alpha, self.picker_open, "")
    }
    pub fn with_channel(self: Self, target: str, value: f32) -> PlaygroundState {
        let clamped = if value < 0.0_f32 { 0.0_f32 } elif value > 1.0_f32 { 1.0_f32 } else { value }
        ret playground(self, self.editor, self.focus,
            if target == "picker-red" { clamped } else { self.red },
            if target == "picker-green" { clamped } else { self.green },
            if target == "picker-blue" { clamped } else { self.blue },
            if target == "picker-alpha" { clamped } else { self.alpha }, self.picker_open, self.drag)
    }
    pub fn input(self: Self, value: str) -> PlaygroundState {
        if self.focus != "css-editor" { ret self }
        ret playground(self, self.editor.insert(value), self.focus, self.red, self.green, self.blue, self.alpha, self.picker_open, self.drag)
    }
    pub fn backspace(self: Self) -> PlaygroundState {
        if self.focus != "css-editor" { ret self }
        ret playground(self, self.editor.backspace(), self.focus, self.red, self.green, self.blue, self.alpha, self.picker_open, self.drag)
    }
    pub fn place_cursor(self: Self, cursor: usize) -> PlaygroundState {
        ret playground(self, self.editor.with_cursor(cursor), "css-editor", self.red, self.green, self.blue, self.alpha, self.picker_open, self.drag)
    }
    pub fn navigate(self: Self, key: u32, shift: bool, control: bool) -> PlaygroundState {
        if self.focus != "css-editor" { ret self }
        let editor = if control && key == 97_u32 { self.editor.select_all() }
            elif key == key_delete() { self.editor.delete() }
            elif key == key_left() { self.editor.move_left(shift) }
            elif key == key_right() { self.editor.move_right(shift) }
            elif key == key_home() { self.editor.move_line_home(shift) }
            elif key == key_end() { self.editor.move_line_end(shift) }
            else { self.editor }
        ret playground(self, editor, self.focus, self.red, self.green, self.blue, self.alpha, self.picker_open, self.drag)
    }
}

fn playground(previous: PlaygroundState, editor: TextEditor, focus: str, red: f32, green: f32,
    blue: f32, alpha: f32, picker_open: bool, drag: str) -> PlaygroundState {
    ret PlaygroundState { editor, focus, red, green, blue, alpha, picker_open, drag }
}

fn with_color(previous: PlaygroundState, red: u8, green: u8, blue: u8, alpha: u8) -> PlaygroundState {
    ret playground(previous, previous.editor, previous.focus, red as f32 / 255.0_f32,
        green as f32 / 255.0_f32, blue as f32 / 255.0_f32, alpha as f32 / 255.0_f32, true, "")
}

fn channel(id: str, name: str, value: f32, color: Color, channel_name: str) -> Widget {
    let mut row = Widget::panel(id + "-row").with_direction(horizontal()).with_flex(30.0_f32, 0.0_f32)
        .with_style(css_style("background: transparent; gap: 8px;"))
    row.push(Widget::label(name).with_flex(42.0_f32, 0.0_f32).with_style(css_style("color: #66707d; font-size: 12px;")))
    row.push(Widget::color_channel(id, color, value, channel_name).with_flex(0.0_f32, 1.0_f32))
    row.push(Widget::label(Debug::fmt((value * 255.0_f32) as u32)).with_flex(34.0_f32, 0.0_f32).with_style(css_style("text-align: right; font-size: 12px;")))
    ret row
}

fn color_popup(model: PlaygroundState) -> Widget {
    let mut popup = Widget::panel("color-popup").with_direction(vertical()).with_flex(236.0_f32, 0.0_f32).with_style(
        css_style("background: #ffffff; border: 1px solid #a6b1bd; border-radius: 6px; padding: 12px; gap: 6px; box-shadow: 0px 10px 24px 0px rgb(31 36 43 / 24%);"))
    popup.push(Widget::panel("color-preview").with_flex(40.0_f32, 0.0_f32).with_style(
        css_style("background-color: " + model.color_css() + "; border: 1px solid #66707d; border-radius: 4px;")))
    popup.push(channel("picker-red", "Red", model.red, model.color(), "red"))
    popup.push(channel("picker-green", "Green", model.green, model.color(), "green"))
    popup.push(channel("picker-blue", "Blue", model.blue, model.color(), "blue"))
    popup.push(channel("picker-alpha", "Alpha", model.alpha, model.color(), "alpha"))
    let mut swatches = Widget::panel("picker-swatches").with_direction(horizontal()).with_flex(34.0_f32, 0.0_f32).with_style(css_style("background: transparent; gap: 8px;"))
    swatches.push(Widget::color_swatch("swatch-teal", Color::rgb(18_u8, 153_u8, 126_u8), false).with_flex(34.0_f32, 0.0_f32))
    swatches.push(Widget::color_swatch("swatch-blue", Color::rgb(40_u8, 120_u8, 208_u8), false).with_flex(34.0_f32, 0.0_f32))
    swatches.push(Widget::color_swatch("swatch-violet", Color::rgb(117_u8, 87_u8, 200_u8), false).with_flex(34.0_f32, 0.0_f32))
    swatches.push(Widget::color_swatch("swatch-red", Color::rgb(207_u8, 72_u8, 72_u8), false).with_flex(34.0_f32, 0.0_f32))
    popup.push(swatches)
    ret popup
}

pub fn view(model: PlaygroundState) -> Widget {
    let mut root = Widget::panel("playground-root").with_direction(vertical()).with_style(
        css_style("background: #eef2f6; padding: 20px; gap: 12px;"))
    root.push(Widget::heading("CSS Playground").with_flex(34.0_f32, 0.0_f32))
    let mut actions = Widget::panel("css-actions").with_direction(horizontal()).with_flex(36.0_f32, 0.0_f32).with_style(css_style("background: transparent; gap: 8px;"))
    actions.push(Widget::button("css-reset", "Reset").with_flex(74.0_f32, 0.0_f32))
    actions.push(Widget::button("css-flat", "Flat").with_flex(68.0_f32, 0.0_f32))
    actions.push(Widget::button("css-pill", "Pill").with_flex(68.0_f32, 0.0_f32))
    actions.push(Widget::color_picker("playground-color", model.color_css(), model.color()).with_flex(246.0_f32, 0.0_f32))
    actions.push(Widget::spacer(1.0_f32))
    root.push(actions)
    let mut work = Widget::panel("css-work").with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(css_style("background: transparent; gap: 14px;"))
    let mut editor = Widget::panel("css-editor-pane").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(css_style("background: #ffffff; border: 1px solid #cbd3dc; padding: 12px; gap: 8px;"))
    editor.push(Widget::label("CSS declarations").with_flex(24.0_f32, 0.0_f32).with_style(css_style("color: #66707d;")))
    editor.push(Widget::textarea("css-editor", model.css()).with_selection(model.selection_start(), model.selection_end())
        .with_focus(model.focus() == "css-editor").with_flex(0.0_f32, 1.0_f32).with_style(css_style("font-size: 14px; padding: 12px;")))
    work.push(editor)
    let mut preview = Widget::panel("css-preview-pane").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(css_style("background: #dfe5eb; border: 1px solid #cbd3dc; padding: 24px; gap: 14px;"))
    preview.push(Widget::label("Live preview").with_flex(24.0_f32, 0.0_f32).with_style(css_style("color: #66707d;")))
    preview.push(Widget::button("css-preview", "Encore UI").with_flex(120.0_f32, 0.0_f32).with_style(
        css_style(model.css() + " background-color: " + model.color_css() + ";")))
    if model.picker_open() { preview.push(color_popup(model)) }
    preview.push(Widget::spacer(1.0_f32))
    work.push(preview)
    root.push(work)
    ret root
}
