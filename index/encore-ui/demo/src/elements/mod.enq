import encore_ui::{Color, Insets, Style, TextEditor, Theme, Widget, css_style, key_delete,
    horizontal, key_down, key_end, key_home, key_left, key_right, key_up, vertical}

pub struct ElementsState {
    name: TextEditor
    notes: TextEditor
    focus: str
    checked: bool
    radio: usize
    notifications: bool
    selection: str
    select_open: bool
    slider: f32
    progress: f32
    status: str
}

impl for ElementsState {
    pub fn new() -> ElementsState {
        ret ElementsState { TextEditor::new(""), TextEditor::new(""), "", true, 0_usize, true, "Encore UI", false,
            0.68_f32, 0.74_f32, "Ready" }
    }
    pub fn click(self: Self, target: str) -> ElementsState {
        if target == "name" || target == "notes" {
            ret state(self, self.name, self.notes, target, self.checked, self.radio,
                self.notifications, self.selection, false, self.slider, self.progress, "Editing " + target)
        }
        if target == "check-on" || target == "check-off" {
            ret state(self, self.name, self.notes, "", !self.checked, self.radio,
                self.notifications, self.selection, false, self.slider, self.progress, "Checkbox changed")
        }
        if target == "radio-a" {
            ret state(self, self.name, self.notes, "", self.checked, 0_usize,
                self.notifications, self.selection, false, self.slider, self.progress, "Radio A selected")
        }
        if target == "radio-b" {
            ret state(self, self.name, self.notes, "", self.checked, 1_usize,
                self.notifications, self.selection, false, self.slider, self.progress, "Radio B selected")
        }
        if target == "switch" {
            ret state(self, self.name, self.notes, "", self.checked, self.radio,
                !self.notifications, self.selection, false, self.slider, self.progress, "Switch changed")
        }
        if target == "framework" {
            ret state(self, self.name, self.notes, "", self.checked, self.radio,
                self.notifications, self.selection, !self.select_open, self.slider, self.progress, self.status)
        }
        if target == "option-encore" { ret self.select("Encore UI") }
        if target == "option-native" { ret self.select("Native") }
        if target == "option-custom" { ret self.select("Custom renderer") }
        if target == "save-form" {
            ret state(self, self.name, self.notes, "", self.checked, self.radio,
                self.notifications, self.selection, false, self.slider, 1.0_f32, "Changes saved")
        }
        if target == "cancel-form" {
            ret state(self, self.name, self.notes, "", self.checked, self.radio,
                self.notifications, self.selection, false, self.slider, self.progress, "Changes cancelled")
        }
        if target == "delete-form" {
            ret state(self, TextEditor::new(""), TextEditor::new(""), "", self.checked, self.radio,
                self.notifications, self.selection, false, self.slider, 0.0_f32, "Form cleared")
        }
        if target == "documentation" {
            ret state(self, self.name, self.notes, "", self.checked, self.radio,
                self.notifications, self.selection, false, self.slider, self.progress, "Documentation link activated")
        }
        ret state(self, self.name, self.notes, "", self.checked, self.radio,
            self.notifications, self.selection, false, self.slider, self.progress, self.status)
    }
    pub fn input(self: Self, value: str) -> ElementsState {
        if self.focus == "name" { ret state(self, self.name.insert(value), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        if self.focus == "notes" { ret state(self, self.name, self.notes.insert(value), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        ret self
    }
    pub fn backspace(self: Self) -> ElementsState {
        if self.focus == "name" { ret state(self, self.name.backspace(), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        if self.focus == "notes" { ret state(self, self.name, self.notes.backspace(), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        ret self
    }
    pub fn navigate(self: Self, key: u32, shift: bool, control: bool) -> ElementsState {
        if self.focus == "name" {
            if control && key == 97_u32 { ret state(self, self.name.select_all(), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_delete() { ret state(self, self.name.delete(), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_left() { ret state(self, self.name.move_left(shift), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_right() { ret state(self, self.name.move_right(shift), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_home() { ret state(self, self.name.move_home(shift), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_end() { ret state(self, self.name.move_end(shift), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        }
        if self.focus == "notes" {
            if control && key == 97_u32 { ret state(self, self.name, self.notes.select_all(), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_delete() { ret state(self, self.name, self.notes.delete(), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_left() { ret state(self, self.name, self.notes.move_left(shift), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_right() { ret state(self, self.name, self.notes.move_right(shift), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_home() { ret state(self, self.name, self.notes.move_line_home(shift), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_end() { ret state(self, self.name, self.notes.move_line_end(shift), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_up() { ret state(self, self.name, self.notes.move_up(shift), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
            if key == key_down() { ret state(self, self.name, self.notes.move_down(shift), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        }
        ret self
    }
    pub fn selected_text(self: Self) -> str {
        if self.focus == "name" { ret self.name.selected_text() }
        if self.focus == "notes" { ret self.notes.selected_text() }
        ret ""
    }
    pub fn text(self: Self, target: str) -> str {
        if target == "name" { ret self.name.value() }
        if target == "notes" { ret self.notes.value() }
        ret ""
    }
    pub fn cursor(self: Self, target: str) -> usize {
        if target == "name" { ret self.name.cursor() }
        if target == "notes" { ret self.notes.cursor() }
        ret 0_usize
    }
    pub fn place_cursor(self: Self, target: str, cursor: usize) -> ElementsState {
        if target == "name" { ret state(self, self.name.with_cursor(cursor), self.notes, target, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        if target == "notes" { ret state(self, self.name, self.notes.with_cursor(cursor), target, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        ret self
    }
    pub fn cut(self: Self) -> ElementsState {
        if self.focus == "name" { ret state(self, self.name.cut(), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        if self.focus == "notes" { ret state(self, self.name, self.notes.cut(), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        ret self
    }
    pub fn paste(self: Self, value: str) -> ElementsState {
        if self.focus == "name" { ret state(self, self.name.paste(value), self.notes, self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        if self.focus == "notes" { ret state(self, self.name, self.notes.paste(value), self.focus, self.checked, self.radio, self.notifications, self.selection, self.select_open, self.slider, self.progress, self.status) }
        ret self
    }
    pub fn with_slider(self: Self, value: f32) -> ElementsState {
        let clamped = if value < 0.0_f32 { 0.0_f32 } elif value > 1.0_f32 { 1.0_f32 } else { value }
        ret state(self, self.name, self.notes, self.focus, self.checked, self.radio,
            self.notifications, self.selection, self.select_open, clamped, self.progress, "Slider changed")
    }
    pub fn focus(self: Self) -> str { ret self.focus }
    pub fn with_focus(self: Self, target: str) -> ElementsState {
        let focus = if target == "name" || target == "notes" { target } else { "" }
        ret state(self, self.name, self.notes, focus, self.checked, self.radio, self.notifications,
            self.selection, self.select_open, self.slider, self.progress, self.status)
    }
    pub fn slider(self: Self) -> f32 { ret self.slider }
    fn select(self: Self, value: str) -> ElementsState {
        ret state(self, self.name, self.notes, "", self.checked, self.radio,
            self.notifications, value, false, self.slider, self.progress, value + " selected")
    }
}

fn state(previous: ElementsState, name: TextEditor, notes: TextEditor, focus: str, checked: bool,
    radio: usize, notifications: bool, selection: str, select_open: bool,
    slider: f32, progress: f32, status: str) -> ElementsState {
    ret ElementsState { name, notes, focus, checked, radio, notifications, selection,
        select_open, slider, progress, status }
}

fn section(id: str, title: str) -> Widget {
    let theme = Theme::light()
    let mut panel = Widget::panel(id).with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(
        theme.surface_style().with_padding(Insets::all(16.0_f32)).with_gap(9.0_f32))
    panel.push(Widget::label(title).with_flex(24.0_f32, 0.0_f32).with_style(Style::default().with_foreground(theme.muted())))
    ret panel
}

fn focus_style(active: bool) -> Style {
    let theme = Theme::light()
    ret theme.surface_style().with_padding(Insets::symmetric(8.0_f32, 10.0_f32))
        .with_border(if active { 2.0_f32 } else { 1.0_f32 }, if active { theme.primary() } else { theme.line() })
}

pub fn view(model: ElementsState) -> Widget {
    let theme = Theme::light()
    let mut root = Widget::panel("elements-root").with_direction(vertical()).with_style(theme.root().with_padding(Insets::all(18.0_f32)).with_gap(10.0_f32))
    root.push(Widget::heading("Standard controls").with_flex(34.0_f32, 0.0_f32))
    let mut top = Widget::panel("elements-top").with_flex(280.0_f32, 0.0_f32).with_style(
        css_style("display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;"))
    let mut fields = section("fields", "TEXT AND SELECTION")
    fields.push(Widget::input("name", if model.name.value() == "" && model.focus != "name" { "Type a name" } else { model.name.value() })
        .with_selection(model.name.selection_start(), model.name.selection_end()).with_flex(38.0_f32, 0.0_f32)
        .with_style(focus_style(model.focus == "name")).with_focus(model.focus == "name"))
    fields.push(Widget::select("framework", model.selection).with_flex(38.0_f32, 0.0_f32))
    if model.select_open {
        let mut menu = Widget::panel("framework-menu").with_direction(vertical()).with_style(
            css_style("position: absolute; z-index: 100; top: 70px; left: 0px; right: 0px; height: 108px; background-color: #ffffff; border-color: #a6b1bd; border-width: 1px; border-radius: 4px; box-shadow: 0px 8px 18px 0px rgb(31 36 43 / 22%); padding: 4px; gap: 2px;"))
        menu.push(Widget::button("option-encore", "Encore UI").with_flex(32.0_f32, 0.0_f32).with_style(theme.ghost_button()))
        menu.push(Widget::button("option-native", "Native").with_flex(32.0_f32, 0.0_f32).with_style(theme.ghost_button()))
        menu.push(Widget::button("option-custom", "Custom renderer").with_flex(32.0_f32, 0.0_f32).with_style(theme.ghost_button()))
        fields.push(menu)
    }
    fields.push(Widget::textarea("notes", if model.notes.value() == "" && model.focus != "notes" { "Type notes" } else { model.notes.value() })
        .with_selection(model.notes.selection_start(), model.notes.selection_end()).with_flex(72.0_f32, 0.0_f32)
        .with_style(focus_style(model.focus == "notes")).with_focus(model.focus == "notes"))
    top.push(fields)
    let mut choices = section("choices", "CHOICES")
    choices.push(Widget::checkbox("check-on", "Checkbox", model.checked).with_flex(32.0_f32, 0.0_f32))
    choices.push(Widget::radio("radio-a", "Radio A", model.radio == 0_usize).with_flex(32.0_f32, 0.0_f32))
    choices.push(Widget::radio("radio-b", "Radio B", model.radio == 1_usize).with_flex(32.0_f32, 0.0_f32))
    choices.push(Widget::toggle("switch", "Notifications", model.notifications).with_flex(34.0_f32, 0.0_f32))
    top.push(choices)
    root.push(top)
    let mut bottom = Widget::panel("elements-bottom").with_flex(200.0_f32, 0.0_f32).with_style(
        css_style("display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;"))
    let mut ranges = section("ranges", "RANGES")
    ranges.push(Widget::slider("volume", model.slider).with_flex(34.0_f32, 0.0_f32))
    ranges.push(Widget::progress(model.progress).with_flex(18.0_f32, 0.0_f32))
    let mut boxes = Widget::panel("box-model").with_direction(horizontal()).with_flex(32.0_f32, 0.0_f32).with_style(
        css_style("display: flex; flex-direction: row; gap: 10px; padding: 0px; background: transparent; border: none;"))
    let mut border_box = Widget::panel("box-border").with_flex(0.0_f32, 0.0_f32).with_style(
        css_style("box-sizing: border-box; width: 80px; padding: 0px 10px; border: 2px solid #2878d0; background: #eef5fc;"))
    border_box.push(Widget::label("80 border").with_flex(24.0_f32, 0.0_f32))
    let mut content_box = Widget::panel("box-content").with_flex(0.0_f32, 0.0_f32).with_style(
        css_style("box-sizing: content-box; width: 80px; padding: 0px 10px; border: 2px solid #12997e; background: #edf9f6;"))
    content_box.push(Widget::label("80 content").with_flex(24.0_f32, 0.0_f32))
    boxes.push(border_box)
    boxes.push(content_box)
    ranges.push(boxes)
    ranges.push(Widget::link("documentation", "Documentation").with_flex(28.0_f32, 0.0_f32))
    bottom.push(ranges)
    let mut actions = section("actions", "ACTIONS - " + model.status)
    actions.push(Widget::button("save-form", "Save changes").with_flex(36.0_f32, 0.0_f32).with_style(theme.primary_button()))
    actions.push(Widget::button("cancel-form", "Cancel").with_flex(36.0_f32, 0.0_f32).with_style(theme.outline_button()))
    actions.push(Widget::button("delete-form", "Delete").with_flex(36.0_f32, 0.0_f32).with_style(theme.danger_button()))
    bottom.push(actions)
    root.push(bottom)
    root.push(Widget::spacer(1.0_f32))
    ret root
}
