import core::fmt::Debug
import core::option::Option
import encore_ui::{IconAsset, IconManager, SvgDocument, Widget, css_style, horizontal, vertical}

pub struct DemoIcons {
    gallery: SvgDocument
    counter: SvgDocument
    canvas: SvgDocument
    fonts: SvgDocument
    animations: SvgDocument
    elements: SvgDocument
    css: SvgDocument
    icons: SvgDocument
}

impl for DemoIcons {
    pub fn load(manager: IconManager) -> DemoIcons {
        ret DemoIcons { manager.document("layout-grid"), manager.document("gauge"), manager.document("mouse-pointer-2"),
            manager.document("type"), manager.document("sparkles"), manager.document("component"),
            manager.document("code-xml"), manager.document("shapes") }
    }
    pub fn gallery(self: Self) -> SvgDocument { ret self.gallery }
    pub fn counter(self: Self) -> SvgDocument { ret self.counter }
    pub fn canvas(self: Self) -> SvgDocument { ret self.canvas }
    pub fn fonts(self: Self) -> SvgDocument { ret self.fonts }
    pub fn animations(self: Self) -> SvgDocument { ret self.animations }
    pub fn elements(self: Self) -> SvgDocument { ret self.elements }
    pub fn css(self: Self) -> SvgDocument { ret self.css }
    pub fn icons(self: Self) -> SvgDocument { ret self.icons }
}

pub fn selected_name(target: str, fallback: str) -> str {
    let prefix = "icon-card-"
    if target.char_len() > prefix.char_len() && target.slice(0_usize, prefix.char_len()) == prefix {
        ret target.slice(prefix.char_len(), target.char_len() - prefix.char_len())
    }
    ret fallback
}

fn card_label(name: str) -> str {
    if name.char_len() <= 22_usize { ret name }
    ret name.slice(0_usize, 19_usize) + "..."
}

pub fn view(manager: IconManager, page: usize, selected: str) -> Widget {
    let icons = manager.icons()
    let per_page = 20_usize
    let page_count = if icons.len() == 0_usize { 1_usize } else { (icons.len() + per_page - 1_usize) / per_page }
    let safe_page = if page >= page_count { page_count - 1_usize } else { page }
    let mut root = Widget::panel("icons-root").with_direction(vertical()).with_style(
        css_style("background: #eef2f6; padding: 20px; gap: 12px;"))
    let mut header = Widget::panel("icons-header").with_direction(horizontal()).with_flex(46.0_f32, 0.0_f32).with_style(css_style("background: transparent; gap: 10px;"))
    header.push(Widget::heading("Lucide Icons").with_flex(220.0_f32, 0.0_f32))
    header.push(Widget::label(Debug::fmt(manager.len()) + " bundled SVG assets").with_flex(220.0_f32, 0.0_f32).with_style(css_style("color: #66707d;")))
    header.push(Widget::spacer(1.0_f32))
    header.push(Widget::button("icons-previous", "Previous").with_flex(92.0_f32, 0.0_f32).with_disabled(safe_page == 0_usize))
    header.push(Widget::label(Debug::fmt(safe_page + 1_usize) + " / " + Debug::fmt(page_count)).with_flex(72.0_f32, 0.0_f32).with_style(css_style("text-align: center;")))
    header.push(Widget::button("icons-next", "Next").with_flex(72.0_f32, 0.0_f32).with_disabled(safe_page + 1_usize >= page_count))
    root.push(header)
    let mut body = Widget::panel("icons-body").with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(css_style("background: transparent; gap: 14px;"))
    let mut grid = Widget::panel("icons-grid").with_flex(0.0_f32, 1.0_f32).with_style(
        css_style("display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(5, 1fr); gap: 10px; background: transparent;"))
    let start = safe_page * per_page
    let mut index = start
    while index < icons.len() && index < start + per_page {
        match icons.get(index) {
            Option[IconAsset]::Some(asset) => {
                let active = asset.name() == selected
                let style = if active {
                    css_style("background: #e1f4ef; color: #0d745f; border: 2px solid #12997e; border-radius: 5px; padding: 8px; font-size: 12px;")
                } else {
                    css_style("background: #ffffff; color: #34404d; border: 1px solid #cbd3dc; border-radius: 5px; padding: 8px; font-size: 12px;")
                }
                grid.push(Widget::icon_card("icon-card-" + asset.name(), card_label(asset.name()), asset.document()).with_style(style))
            }
            Option[IconAsset]::None => {}
        }
        index = index + 1_usize
    }
    body.push(grid)
    let chosen = manager.document(selected)
    let mut inspector = Widget::panel("icon-inspector").with_direction(vertical()).with_flex(260.0_f32, 0.0_f32).with_style(
        css_style("background: #ffffff; border: 1px solid #cbd3dc; border-radius: 6px; padding: 18px; gap: 14px;"))
    inspector.push(Widget::label("SELECTED ICON").with_flex(20.0_f32, 0.0_f32).with_style(css_style("color: #66707d; font-size: 11px; font-weight: 700;")))
    inspector.push(Widget::icon("selected-icon", chosen).with_flex(180.0_f32, 0.0_f32).with_style(css_style("color: #12997e; padding: 28px; background: #edf9f6; border-radius: 6px;")))
    inspector.push(Widget::heading(selected).with_flex(34.0_f32, 0.0_f32).with_style(css_style("font-size: 20px;")))
    inspector.push(Widget::label("Scalable, CSS-colored and rendered by Encore").with_flex(48.0_f32, 0.0_f32).with_style(css_style("color: #66707d; font-size: 13px;")))
    inspector.push(Widget::icon_button("icon-action", "Use this icon", chosen).with_flex(42.0_f32, 0.0_f32).with_style(
        css_style("background: #12997e; color: #ffffff; border: 1px solid #0d745f; border-radius: 4px; padding: 8px;")))
    inspector.push(Widget::spacer(1.0_f32))
    body.push(inspector)
    root.push(body)
    ret root
}
