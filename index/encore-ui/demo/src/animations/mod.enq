import core::fmt::Debug
import encore_ui::{ButtonAnimation, Style, StyleSheet, Widget, apply_css, css_color, css_style, easing_in, easing_in_out, easing_linear, easing_out, horizontal, vertical}

fn animation_row(id: str, property: str, text: str, style: Style) -> Widget {
    let mut row = Widget::panel(id + "-row").with_direction(horizontal()).with_flex(44.0_f32, 0.0_f32).with_style(
        css_style("background-color: transparent; gap: 20px; padding: 3px;"))
    row.push(Widget::label(property).with_flex(176.0_f32, 0.0_f32).with_style(css_style("color: #66707d; font-size: 13px;")))
    row.push(Widget::button(id, text).with_flex(232.0_f32, 0.0_f32).with_style(style))
    row.push(Widget::spacer(1.0_f32))
    ret row
}

fn swatches(selected: str) -> Widget {
    let mut row = Widget::panel("color-palette").with_direction(horizontal()).with_flex(38.0_f32, 0.0_f32).with_style(
        css_style("background-color: #f4f7f9; padding: 3px; gap: 8px;"))
    row.push(Widget::color_swatch("color-teal", css_color("#12997e"), selected == "#12997e").with_flex(34.0_f32, 0.0_f32))
    row.push(Widget::color_swatch("color-blue", css_color("#2878d0"), selected == "#2878d0").with_flex(34.0_f32, 0.0_f32))
    row.push(Widget::color_swatch("color-violet", css_color("#7557c8"), selected == "#7557c8").with_flex(34.0_f32, 0.0_f32))
    row.push(Widget::color_swatch("color-red", css_color("#cf4848"), selected == "#cf4848").with_flex(34.0_f32, 0.0_f32))
    row.push(Widget::color_swatch("color-amber", css_color("#d89524"), selected == "#d89524").with_flex(34.0_f32, 0.0_f32))
    row.push(Widget::color_swatch("color-graphite", css_color("#4a5563"), selected == "#4a5563").with_flex(34.0_f32, 0.0_f32))
    row.push(Widget::spacer(1.0_f32))
    ret row
}

fn setting(id: str, label: str, value: str, position: f32) -> Widget {
    let mut row = Widget::panel(id + "-setting").with_direction(vertical()).with_flex(38.0_f32, 0.0_f32).with_style(
        css_style("background-color: transparent; gap: 2px;"))
    row.push(Widget::label(label + "  " + value).with_flex(14.0_f32, 0.0_f32).with_style(css_style("color: #66707d; font-size: 11px;")))
    row.push(Widget::slider(id, position).with_flex(22.0_f32, 0.0_f32))
    ret row
}

fn easing_button(id: str, label: str, selected: bool) -> Widget {
    let css = if selected {
        "background-color: #12997e; color: #ffffff; border-color: #12997e; border-width: 1px; padding: 5px;"
    } else {
        "background-color: #ffffff; color: #4a5563; border-color: #a6b1bd; border-width: 1px; padding: 5px;"
    }
    ret Widget::button(id, label).with_flex(78.0_f32, 0.0_f32).with_style(css_style(css))
}

pub fn view(animation: ButtonAnimation, accent: str, picker_open: bool, radius: f32,
    border: f32, padding: f32, font_size: f32, opacity: f32, duration: u64) -> Widget {
    let transitions = StyleSheet::parse(
        "button.transition-demo { background-color: " + accent + "; color: #ffffff; border-color: " + accent + "; border-width: 1px; border-radius: 7px; padding: 9px; font-size: 14px; font-weight: 600; opacity: 1; } " +
        "button.transition-demo:hover { border-color: #0b6655; border-width: " + Debug::fmt(border) + "px; border-radius: " + Debug::fmt(radius) + "px; outline: 2px solid " + accent + "; outline-offset: 2px; box-shadow: 0px 6px 12px 0px rgb(31 36 43 / 20%); padding: " + Debug::fmt(padding) + "px; font-size: " + Debug::fmt(font_size) + "px; font-weight: 700; opacity: " + Debug::fmt(opacity) + "; } " +
        "button.transition-demo:active { background-color: #0b6756; border-color: #084d41; border-width: 2px; border-radius: 6px; outline: 0px solid #0b6756; outline-offset: 0px; box-shadow: inset 0px 2px 4px 0px rgb(4 43 36 / 35%); padding: 10px 9px 8px 9px; font-size: 14px; opacity: 0.92; }")
    let transition_target = Widget::button("transition-probe", "Transition").with_classes("transition-demo")
    let normal = transitions.style(transition_target, false, false, false)
    let hover = transitions.style(transition_target, true, false, false)
    let active = transitions.style(transition_target, true, true, false)

    let mut root = Widget::panel("animations-root").with_direction(vertical()).with_style(
        css_style("background-color: #eef2f6; color: #1f242b; padding: 12px; gap: 6px;"))
    root.push(Widget::heading("CSS style transitions").with_flex(36.0_f32, 0.0_f32).with_style(css_style("color: #1f242b; font-size: 22px;")))

    let mut picker = Widget::panel("picker-section").with_direction(vertical()).with_flex(if picker_open { 92.0_f32 } else { 46.0_f32 }, 0.0_f32).with_style(
        css_style("background-color: #ffffff; border-color: #cbd3dc; border-width: 1px; border-radius: 4px; padding: 4px; gap: 6px;"))
    picker.push(Widget::color_picker("animation-color-picker", "Accent " + accent, css_color(accent)).with_flex(38.0_f32, 0.0_f32))
    if picker_open { picker.push(swatches(accent)) }
    root.push(picker)

    let mut settings = Widget::panel("animation-settings").with_direction(horizontal()).with_flex(148.0_f32, 0.0_f32).with_style(
        css_style("background-color: #ffffff; border-color: #cbd3dc; border-width: 1px; border-radius: 6px; padding: 10px; gap: 16px;"))
    let mut left = Widget::panel("settings-left").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(css_style("background-color: transparent; gap: 4px;"))
    left.push(setting("setting-radius", "border-radius", Debug::fmt(radius) + "px", radius / 24.0_f32))
    left.push(setting("setting-border", "border-width", Debug::fmt(border) + "px", border / 8.0_f32))
    left.push(setting("setting-padding", "padding", Debug::fmt(padding) + "px", padding / 24.0_f32))
    settings.push(left)
    let mut right = Widget::panel("settings-right").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(css_style("background-color: transparent; gap: 4px;"))
    right.push(setting("setting-font", "font-size", Debug::fmt(font_size) + "px", (font_size - 10.0_f32) / 18.0_f32))
    right.push(setting("setting-opacity", "opacity", Debug::fmt(opacity), opacity))
    right.push(setting("setting-duration", "duration", Debug::fmt(duration) + "ms", (duration as f32 - 60.0_f32) / 540.0_f32))
    settings.push(right)
    root.push(settings)

    let mut easing = Widget::panel("easing-settings").with_direction(horizontal()).with_flex(34.0_f32, 0.0_f32).with_style(css_style("background-color: transparent; gap: 8px;"))
    easing.push(easing_button("easing-linear", "linear", animation.easing() == easing_linear()))
    easing.push(easing_button("easing-in", "ease-in", animation.easing() == easing_in()))
    easing.push(easing_button("easing-out", "ease-out", animation.easing() == easing_out()))
    easing.push(easing_button("easing-in-out", "ease-in-out", animation.easing() == easing_in_out()))
    easing.push(Widget::spacer(1.0_f32))
    root.push(easing)

    let mut stage = Widget::panel("animation-stage").with_direction(vertical()).with_flex(364.0_f32, 0.0_f32).with_style(
        css_style("background-color: #ffffff; color: #1f242b; border-color: #cbd3dc; border-width: 1px; border-radius: 8px; padding: 16px; gap: 4px;"))
    stage.push(animation_row("animation-all", "all properties", "Hover / press", animation.style(normal, hover, active)))
    stage.push(animation_row("animation-color", "background-color", "Color transition", animation.style(normal, apply_css(normal, "background-color: #2878d0;"), apply_css(normal, "background-color: #7557c8;"))))
    stage.push(animation_row("animation-border", "border / radius", "Shape transition", animation.style(normal, apply_css(normal, "border-width: 4px; border-radius: 10px; border-color: #2878d0;"), active)))
    stage.push(animation_row("animation-outline", "outline / offset", "Focus ring", animation.style(normal, apply_css(normal, "outline: 4px solid #2878d0; outline-offset: 3px;"), active)))
    stage.push(animation_row("animation-shadow", "box-shadow", "Elevation / inset", animation.style(normal, apply_css(normal, "box-shadow: 0px 9px 16px 1px rgb(31 36 43 / 30%);"), apply_css(normal, "box-shadow: inset 0px 4px 8px 0px rgb(31 36 43 / 45%);"))))
    stage.push(animation_row("animation-decoration", "text-decoration", "Decorated text", animation.style(normal,
        apply_css(normal, "text-decoration: underline #ffffff 2px;"),
        apply_css(normal, "text-decoration: overline line-through #ffffff 2px;"))))
    stage.push(animation_row("animation-opacity", "opacity / color", "Fade transition", animation.style(apply_css(normal, "opacity: 0.45;"), apply_css(normal, "opacity: 1; color: #ffffff;"), active)))
    root.push(stage)
    root.push(Widget::progress(animation.hover_progress()).with_flex(10.0_f32, 0.0_f32))
    root.push(Widget::spacer(1.0_f32))
    ret root
}
