import core::io::println
import core::option::Option
import core::os::read_dir
import core::time::sleep_ms
import core::vec::Vec
import encore_ui::{
    Color, Insets, Rect, Style, Widget, Window, backend_error, event_close,
    event_key_down, event_pointer_down, event_pointer_move, horizontal, vertical
}
import encore_ui_demo::canvas
import encore_ui_demo::counter
import encore_ui_demo::fonts
import encore_ui_demo::gallery

fn mode_gallery() -> usize { ret 0_usize }
fn mode_counter() -> usize { ret 1_usize }
fn mode_canvas() -> usize { ret 2_usize }
fn mode_fonts() -> usize { ret 3_usize }

fn ends_with(value: str, suffix: str) -> bool {
    let value_len = value.char_len()
    let suffix_len = suffix.char_len()
    if suffix_len > value_len { ret false }
    ret value.slice(value_len - suffix_len, suffix_len) == suffix
}

fn is_font(name: str) -> bool {
    ret ends_with(name, ".ttf") || ends_with(name, ".otf")
        || ends_with(name, ".ttc") || ends_with(name, ".woff")
        || ends_with(name, ".woff2")
}

fn available_fonts() -> Vec[str] {
    let entries = read_dir("fonts")
    let mut fonts = Vec[str]::new()
    let mut index = 0_usize
    while index < entries.len() {
        match entries.get(index) {
            Option[str]::Some(name) => {
                if is_font(name) { fonts.push(name) }
            }
            Option[str]::None => {}
        }
        index = index + 1_usize
    }
    ret fonts
}

fn tab_style(selected: bool) -> Style {
    if selected {
        ret Style::panel()
            .with_background(Color::rgb(18_u8, 153_u8, 126_u8))
            .with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
            .with_border(1.0_f32, Color::rgb(18_u8, 153_u8, 126_u8))
    }
    ret Style::panel()
        .with_background(Color::rgb(48_u8, 56_u8, 67_u8))
        .with_foreground(Color::rgb(224_u8, 230_u8, 237_u8))
        .with_border(1.0_f32, Color::rgb(78_u8, 89_u8, 102_u8))
}

fn toolbar(mode: usize) -> Widget {
    let mut bar = Widget::panel("demo-toolbar")
        .with_direction(horizontal())
        .with_flex(52.0_f32, 0.0_f32)
        .with_style(
            Style::default()
                .with_background(Color::rgb(27_u8, 32_u8, 39_u8))
                .with_padding(Insets::symmetric(7.0_f32, 10.0_f32))
                .with_gap(8.0_f32)
        )
    bar.push(Widget::label("Encore UI").with_flex(104.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(245_u8, 248_u8, 251_u8))
    ))
    bar.push(Widget::button("tab-gallery", "Gallery").with_flex(86.0_f32, 0.0_f32).with_style(tab_style(mode == mode_gallery())))
    bar.push(Widget::button("tab-counter", "Counter").with_flex(86.0_f32, 0.0_f32).with_style(tab_style(mode == mode_counter())))
    bar.push(Widget::button("tab-canvas", "Canvas").with_flex(82.0_f32, 0.0_f32).with_style(tab_style(mode == mode_canvas())))
    bar.push(Widget::button("tab-fonts", "Fonts").with_flex(76.0_f32, 0.0_f32).with_style(tab_style(mode == mode_fonts())))
    bar.push(Widget::spacer(1.0_f32))
    ret bar
}

fn retained_screen(mode: usize, content: Widget) -> Widget {
    let mut root = Widget::panel("demo-root").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(232_u8, 237_u8, 242_u8)).with_gap(0.0_f32)
    )
    root.push(toolbar(mode))
    root.push(content.with_flex(0.0_f32, 1.0_f32))
    ret root
}

fn draw_immediate_toolbar(window: Window, mode: usize) -> () {
    let dark = Color::rgb(27_u8, 32_u8, 39_u8)
    let idle = Color::rgb(48_u8, 56_u8, 67_u8)
    let active = Color::rgb(18_u8, 153_u8, 126_u8)
    let text = Color::rgb(245_u8, 248_u8, 251_u8)
    window.fill_rect(Rect::new(0.0_f32, 0.0_f32, window.width() as f32, 52.0_f32), dark)
    window.text(12.0_f32, 20.0_f32, "Encore UI", text)
    window.fill_rect(Rect::new(116.0_f32, 7.0_f32, 86.0_f32, 38.0_f32), if mode == mode_gallery() { active } else { idle })
    window.fill_rect(Rect::new(210.0_f32, 7.0_f32, 86.0_f32, 38.0_f32), if mode == mode_counter() { active } else { idle })
    window.fill_rect(Rect::new(304.0_f32, 7.0_f32, 82.0_f32, 38.0_f32), if mode == mode_canvas() { active } else { idle })
    window.fill_rect(Rect::new(394.0_f32, 7.0_f32, 76.0_f32, 38.0_f32), if mode == mode_fonts() { active } else { idle })
    window.text(130.0_f32, 20.0_f32, "Gallery", text)
    window.text(224.0_f32, 20.0_f32, "Counter", text)
    window.text(318.0_f32, 20.0_f32, "Canvas", text)
    window.text(408.0_f32, 20.0_f32, "Fonts", text)
    ret ()
}

fn toolbar_mode(x: f32, y: f32, fallback: usize) -> usize {
    if y < 0.0_f32 || y >= 52.0_f32 { ret fallback }
    if x >= 116.0_f32 && x < 202.0_f32 { ret mode_gallery() }
    if x >= 210.0_f32 && x < 296.0_f32 { ret mode_counter() }
    if x >= 304.0_f32 && x < 386.0_f32 { ret mode_canvas() }
    if x >= 394.0_f32 && x < 470.0_f32 { ret mode_fonts() }
    ret fallback
}

fn target_mode(target: str, fallback: usize) -> usize {
    if target == "tab-gallery" { ret mode_gallery() }
    if target == "tab-counter" { ret mode_counter() }
    if target == "tab-canvas" { ret mode_canvas() }
    if target == "tab-fonts" { ret mode_fonts() }
    ret fallback
}

fn font_option_at(fonts: Vec[str], x: f32, y: f32) -> Option[str] {
    if x < 600.0_f32 || x >= 872.0_f32 || y < 132.0_f32 { ret Option[str]::None }
    let index = ((y - 132.0_f32) / 34.0_f32) as usize
    if index >= fonts.len() || index >= 10_usize { ret Option[str]::None }
    ret fonts.get(index)
}

fn main() -> u32 {
    let window = Window::create("Encore UI Demo", 920_u32, 680_u32)
    if !window.available() {
        println("Unable to start Encore UI: " + backend_error())
        ret 1_u32
    }
    let font_files = available_fonts()
    let mut font_menu_open = false
    let mut selected_font = "Built-in bitmap font"
    let mut font_error = ""
    let mut mode = mode_gallery()
    let mut status = "Choose a button variant"
    let mut count = 0_u32
    let mut cursor_x = 460.0_f32
    let mut cursor_y = 340.0_f32

    while window.is_open() {
        let event = window.poll()
        if event.kind() == event_close() { break }
        if event.kind() == event_key_down() && event.key() == 27_u32 { break }

        if event.kind() == event_pointer_down() {
            let previous_mode = mode
            mode = toolbar_mode(event.x(), event.y(), mode)
            if previous_mode == mode_fonts() && mode != mode_fonts() {
                window.clear_font()
                font_menu_open = false
            }
        }
        if event.kind() == event_pointer_move() {
            cursor_x = event.x()
            cursor_y = event.y()
        }

        if mode == mode_gallery() {
            let layout = window.draw(retained_screen(mode, gallery::view(status)))
            if event.kind() == event_pointer_down() {
                let target = layout.hit(event.x(), event.y())
                mode = target_mode(target, mode)
                status = gallery::status_for(target, status)
            }
        }
        elif mode == mode_counter() {
            let layout = window.draw(retained_screen(mode, counter::view(count)))
            if event.kind() == event_pointer_down() {
                let target = layout.hit(event.x(), event.y())
                mode = target_mode(target, mode)
                if target == "increment" { count = count + 1_u32 }
                elif target == "reset" { count = 0_u32 }
            }
        }
        elif mode == mode_canvas() {
            canvas::draw(window, cursor_x, cursor_y)
            draw_immediate_toolbar(window, mode)
            window.present()
        }
        else {
            if event.kind() == event_pointer_down() {
                if event.x() >= 600.0_f32 && event.x() < 872.0_f32 && event.y() >= 88.0_f32 && event.y() < 126.0_f32 {
                    font_menu_open = !font_menu_open
                }
                elif font_menu_open {
                    match font_option_at(font_files, event.x(), event.y()) {
                        Option[str]::Some(name) => {
                            let path = "fonts/" + name
                            if window.load_font(path, 22.0_f32) {
                                selected_font = name
                                font_error = ""
                            } else {
                                font_error = backend_error()
                            }
                            font_menu_open = false
                        }
                        Option[str]::None => { font_menu_open = false }
                    }
                }
            }
            fonts::draw(window, selected_font, font_error, font_files, font_menu_open)
            draw_immediate_toolbar(window, mode)
            window.present()
        }
        sleep_ms(16_u64)
    }
    window.destroy()
    ret 0_u32
}
