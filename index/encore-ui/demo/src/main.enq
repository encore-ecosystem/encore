import core::io::println
import core::option::Option
import core::os::argv
import encore_ui_demo::canvas
import encore_ui_demo::counter
import encore_ui_demo::fonts
import encore_ui_demo::gallery

fn selected_demo() -> str {
    match argv(1_usize) {
        Option[str]::Some(value) => { ret value }
        Option[str]::None => { ret "gallery" }
    }
}

fn main() -> u32 {
    let demo = selected_demo()
    if demo == "gallery" || demo == "styles" { ret gallery::run() }
    if demo == "counter" { ret counter::run() }
    if demo == "canvas" { ret canvas::run() }
    if demo == "fonts" { ret fonts::run() }
    println("Unknown demo: " + demo)
    println("Available demos: gallery, counter, canvas, fonts")
    ret 2_u32
}
