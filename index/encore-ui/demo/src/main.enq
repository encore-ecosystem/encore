import core::io::println
import core::option::Option
import core::time::{perf_counter_ms, sleep_ms}
import core::vec::Vec
import encore_ui::{
    ButtonAnimation, Color, FontFace, FontManager, IconManager, Insets, InteractionState, Rect, Style, StyleSheet, Theme, Widget, WidgetLayout, Window,
    backend_error, event_close, event_key_down, event_pointer_down,
    easing_in, easing_in_out, easing_linear, easing_out, event_pointer_move, event_pointer_up, event_resize, event_text_input, horizontal, key_enter, key_tab, vertical
}
import encore_ui_demo::canvas
import encore_ui_demo::animations
import encore_ui_demo::counter
import encore_ui_demo::elements
import encore_ui_demo::elements::ElementsState
import encore_ui_demo::fonts
import encore_ui_demo::gallery
import encore_ui_demo::playground
import encore_ui_demo::playground::PlaygroundState
import encore_ui_demo::icons
import encore_ui_demo::icons::DemoIcons

fn mode_gallery() -> usize { ret 0_usize }
fn mode_counter() -> usize { ret 1_usize }
fn mode_canvas() -> usize { ret 2_usize }
fn mode_fonts() -> usize { ret 3_usize }
fn mode_animations() -> usize { ret 4_usize }
fn mode_elements() -> usize { ret 5_usize }
fn mode_playground() -> usize { ret 6_usize }
fn mode_icons() -> usize { ret 7_usize }

fn tab_style(selected: bool) -> Style {
    ret Theme::light().tab(selected)
}

fn toolbar(mode: usize, icons: DemoIcons) -> Widget {
    let mut bar = Widget::panel("demo-toolbar")
        .with_direction(horizontal())
        .with_flex(52.0_f32, 0.0_f32)
        .with_style(
            Style::default()
                .with_background(Color::rgb(27_u8, 32_u8, 39_u8))
                .with_padding(Insets::symmetric(7.0_f32, 10.0_f32))
                .with_gap(8.0_f32)
        )
    bar.push(Widget::label("ENCORE UI").with_flex(116.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(245_u8, 248_u8, 251_u8)).with_font_weight(700_u32)
    ))
    bar.push(Widget::icon_button("tab-gallery", "Gallery", icons.gallery()).with_flex(104.0_f32, 0.0_f32).with_style(tab_style(mode == mode_gallery())))
    bar.push(Widget::icon_button("tab-counter", "Counter", icons.counter()).with_flex(104.0_f32, 0.0_f32).with_style(tab_style(mode == mode_counter())))
    bar.push(Widget::icon_button("tab-canvas", "Canvas", icons.canvas()).with_flex(98.0_f32, 0.0_f32).with_style(tab_style(mode == mode_canvas())))
    bar.push(Widget::icon_button("tab-fonts", "Fonts", icons.fonts()).with_flex(92.0_f32, 0.0_f32).with_style(tab_style(mode == mode_fonts())))
    bar.push(Widget::icon_button("tab-animations", "Motion", icons.animations()).with_flex(100.0_f32, 0.0_f32).with_style(tab_style(mode == mode_animations())))
    bar.push(Widget::icon_button("tab-elements", "Elements", icons.elements()).with_flex(112.0_f32, 0.0_f32).with_style(tab_style(mode == mode_elements())))
    bar.push(Widget::icon_button("tab-playground", "CSS", icons.css()).with_flex(82.0_f32, 0.0_f32).with_style(tab_style(mode == mode_playground())))
    bar.push(Widget::icon_button("tab-icons", "Icons", icons.icons()).with_flex(92.0_f32, 0.0_f32).with_style(tab_style(mode == mode_icons())))
    bar.push(Widget::spacer(1.0_f32))
    ret bar
}

fn retained_screen(mode: usize, content: Widget, hovered: str, active: str, focused: str, icons: DemoIcons) -> Widget {
    let mut root = Widget::panel("demo-root").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(232_u8, 237_u8, 242_u8)).with_gap(0.0_f32)
    )
    root.push(toolbar(mode, icons))
    root.push(content.with_flex(0.0_f32, 1.0_f32))
    let stylesheet = StyleSheet::parse(
        "button:hover { border-color: #12997e; border-width: 2px; } " +
        "button:active { background-color: #0d745f; color: #ffffff; } " +
        "input:focus, textarea:focus { border-color: #12997e; border-width: 2px; }")
    ret stylesheet.apply(root, hovered, active, focused)
}

fn draw_immediate_toolbar(window: Window, mode: usize, icons: DemoIcons) -> () {
    let dark = Color::rgb(27_u8, 32_u8, 39_u8)
    let idle = Color::rgb(48_u8, 56_u8, 67_u8)
    let active = Color::rgb(18_u8, 153_u8, 126_u8)
    let text = Color::rgb(245_u8, 248_u8, 251_u8)
    window.fill_rect(Rect::new(0.0_f32, 0.0_f32, window.width() as f32, 52.0_f32), dark)
    window.text(12.0_f32, 20.0_f32, "ENCORE UI", text)
    window.fill_rect(Rect::new(134.0_f32, 7.0_f32, 104.0_f32, 38.0_f32), if mode == mode_gallery() { active } else { idle })
    window.fill_rect(Rect::new(246.0_f32, 7.0_f32, 104.0_f32, 38.0_f32), if mode == mode_counter() { active } else { idle })
    window.fill_rect(Rect::new(358.0_f32, 7.0_f32, 98.0_f32, 38.0_f32), if mode == mode_canvas() { active } else { idle })
    window.fill_rect(Rect::new(464.0_f32, 7.0_f32, 92.0_f32, 38.0_f32), if mode == mode_fonts() { active } else { idle })
    window.fill_rect(Rect::new(564.0_f32, 7.0_f32, 100.0_f32, 38.0_f32), if mode == mode_animations() { active } else { idle })
    window.fill_rect(Rect::new(672.0_f32, 7.0_f32, 112.0_f32, 38.0_f32), if mode == mode_elements() { active } else { idle })
    window.fill_rect(Rect::new(792.0_f32, 7.0_f32, 82.0_f32, 38.0_f32), if mode == mode_playground() { active } else { idle })
    window.fill_rect(Rect::new(882.0_f32, 7.0_f32, 92.0_f32, 38.0_f32), if mode == mode_icons() { active } else { idle })
    window.text(166.0_f32, 20.0_f32, "Gallery", text)
    window.text(278.0_f32, 20.0_f32, "Counter", text)
    window.text(390.0_f32, 20.0_f32, "Canvas", text)
    window.text(496.0_f32, 20.0_f32, "Fonts", text)
    window.text(596.0_f32, 20.0_f32, "Motion", text)
    window.text(704.0_f32, 20.0_f32, "Elements", text)
    window.text(824.0_f32, 20.0_f32, "CSS", text)
    window.text(914.0_f32, 20.0_f32, "Icons", text)
    window.svg(Rect::new(142.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.gallery(), text, 2.0_f32)
    window.svg(Rect::new(254.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.counter(), text, 2.0_f32)
    window.svg(Rect::new(366.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.canvas(), text, 2.0_f32)
    window.svg(Rect::new(472.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.fonts(), text, 2.0_f32)
    window.svg(Rect::new(572.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.animations(), text, 2.0_f32)
    window.svg(Rect::new(680.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.elements(), text, 2.0_f32)
    window.svg(Rect::new(800.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.css(), text, 2.0_f32)
    window.svg(Rect::new(890.0_f32, 15.0_f32, 18.0_f32, 18.0_f32), icons.icons(), text, 2.0_f32)
    ret ()
}

fn toolbar_mode(x: f32, y: f32, fallback: usize) -> usize {
    if y < 0.0_f32 || y >= 52.0_f32 { ret fallback }
    if x >= 134.0_f32 && x < 238.0_f32 { ret mode_gallery() }
    if x >= 246.0_f32 && x < 350.0_f32 { ret mode_counter() }
    if x >= 358.0_f32 && x < 456.0_f32 { ret mode_canvas() }
    if x >= 464.0_f32 && x < 556.0_f32 { ret mode_fonts() }
    if x >= 564.0_f32 && x < 664.0_f32 { ret mode_animations() }
    if x >= 672.0_f32 && x < 784.0_f32 { ret mode_elements() }
    if x >= 792.0_f32 && x < 874.0_f32 { ret mode_playground() }
    if x >= 882.0_f32 && x < 974.0_f32 { ret mode_icons() }
    ret fallback
}

fn target_mode(target: str, fallback: usize) -> usize {
    if target == "tab-gallery" { ret mode_gallery() }
    if target == "tab-counter" { ret mode_counter() }
    if target == "tab-canvas" { ret mode_canvas() }
    if target == "tab-fonts" { ret mode_fonts() }
    if target == "tab-animations" { ret mode_animations() }
    if target == "tab-elements" { ret mode_elements() }
    if target == "tab-playground" { ret mode_playground() }
    if target == "tab-icons" { ret mode_icons() }
    ret fallback
}

fn font_option_at(fonts: Vec[FontFace], x: f32, y: f32) -> Option[str] {
    if x < 600.0_f32 || x >= 872.0_f32 || y < 132.0_f32 { ret Option[str]::None }
    let index = ((y - 132.0_f32) / 34.0_f32) as usize
    if index >= fonts.len() || index >= 10_usize { ret Option[str]::None }
    match fonts.get(index) {
        Option[FontFace]::Some(face) => { ret Option[str]::Some(face.family()) }
        Option[FontFace]::None => { ret Option[str]::None }
    }
}

fn palette_color(target: str, fallback: str) -> str {
    if target == "color-teal" { ret "#12997e" }
    if target == "color-blue" { ret "#2878d0" }
    if target == "color-violet" { ret "#7557c8" }
    if target == "color-red" { ret "#cf4848" }
    if target == "color-amber" { ret "#d89524" }
    if target == "color-graphite" { ret "#4a5563" }
    ret fallback
}

fn animation_target(target: str) -> bool {
    ret target == "animation-all" || target == "animation-color"
        || target == "animation-border" || target == "animation-outline"
        || target == "animation-shadow" || target == "animation-decoration"
        || target == "animation-opacity"
}

fn animation_setting(target: str) -> bool {
    ret target == "setting-radius" || target == "setting-border" || target == "setting-padding"
        || target == "setting-font" || target == "setting-opacity" || target == "setting-duration"
}

fn slider_position(layout: WidgetLayout, id: str, x: f32) -> f32 {
    match layout.find_bounds(id) {
        Option[Rect]::Some(bounds) => {
            let value = (x - bounds.x() - 6.0_f32) / (bounds.width() - 12.0_f32)
            if value < 0.0_f32 { ret 0.0_f32 }
            if value > 1.0_f32 { ret 1.0_f32 }
            ret value
        }
        Option[Rect]::None => { ret 0.0_f32 }
    }
}

fn input_click_width(window: Window, bounds: Rect, value: str, cursor: usize, x: f32) -> f32 {
    let base = bounds.x() + 10.0_f32
    let caret = window.text_width(value.slice(0_usize, cursor))
    let right = bounds.right() - 10.0_f32
    let origin = if base + caret > right { base - (base + caret - right) } else { base }
    let width = x - origin
    ret if width > 0.0_f32 { width } else { 0.0_f32 }
}

fn main() -> u32 {
    let window = Window::create("Encore UI Showcase", 1180_u32, 760_u32)
    if !window.available() {
        println("Unable to start Encore UI: " + backend_error())
        ret 1_u32
    }
    let mut font_manager = FontManager::with_bundled("../assets/fonts")
    font_manager.load_directory("fonts")
    font_manager.register_all(window)
    font_manager = font_manager.activate_default(window, 22.0_f32, 400_u32)
    let icon_manager = IconManager::with_bundled("../assets/icons")
    let demo_icons = DemoIcons::load(icon_manager)
    let mut font_menu_open = false
    let mut preview_text = ""
    let mut mode = mode_gallery()
    let mut status = "Choose a button variant"
    let mut count = 0_u32
    let mut cursor_x = 460.0_f32
    let mut cursor_y = 340.0_f32
    let mut button_animation = ButtonAnimation::new(140_u64)
    let mut counter_animation = ButtonAnimation::new(120_u64)
    let mut counter_animation_target = ""
    let mut animation_accent = "#12997e"
    let mut color_picker_open = false
    let mut animation_radius = 8.0_f32
    let mut animation_border = 3.0_f32
    let mut animation_padding = 12.0_f32
    let mut animation_font_size = 16.0_f32
    let mut animation_opacity = 1.0_f32
    let mut animation_duration = 140_u64
    let mut animation_setting_drag = ""
    let mut elements_state = ElementsState::new()
    let mut playground_state = PlaygroundState::new()
    let mut icon_page = 0_usize
    let mut selected_icon = "activity"
    let mut interaction = InteractionState::new()
    let mut slider_dragging = false
    let mut last_frame_ms = perf_counter_ms()
    let mut retained_layout = window.layout(retained_screen(mode, gallery::view(status), "", "", "", demo_icons))
    let mut dirty = true

    while window.is_open() {
        let now_ms = perf_counter_ms()
        let elapsed_ms = now_ms - last_frame_ms
        last_frame_ms = now_ms
        let event = window.poll()
        if event.kind() == event_close() { break }
        if event.kind() == event_key_down() && event.key() == 27_u32 { break }
        if event.kind() == event_resize() { dirty = true }

        if event.kind() == event_pointer_down() {
            let previous_mode = mode
            mode = if mode == mode_canvas() || mode == mode_fonts() {
                toolbar_mode(event.x(), event.y(), mode)
            } else {
                target_mode(retained_layout.hit(event.x(), event.y()), mode)
            }
            if mode != previous_mode { dirty = true }
            if previous_mode == mode_fonts() && mode != mode_fonts() { font_menu_open = false }
        }
        if event.kind() == event_pointer_move() {
            cursor_x = event.x()
            cursor_y = event.y()
            if mode == mode_canvas() { dirty = true }
            elif mode != mode_fonts() {
                let target = retained_layout.hit(event.x(), event.y())
                if target != interaction.hovered() { interaction = interaction.pointer_move(retained_layout, event.x(), event.y()) dirty = true }
            }
        }
        if event.kind() == event_pointer_down() && mode != mode_canvas() && mode != mode_fonts() {
            interaction = interaction.pointer_down(retained_layout, event.x(), event.y())
            dirty = true
        }
        if event.kind() == event_pointer_up() && interaction.active() != "" {
            interaction = interaction.pointer_up(retained_layout, event.x(), event.y())
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_tab() && mode != mode_canvas() && mode != mode_fonts() {
            interaction = if event.shift() { interaction.focus_previous(retained_layout.widget()) }
                else { interaction.focus_next(retained_layout.widget()) }
            if mode == mode_elements() { elements_state = elements_state.with_focus(interaction.focused()) }
            dirty = true
        }
        let keyboard_target = if event.kind() == event_key_down() && (event.key() == key_enter() || event.key() == 32_u32) &&
            mode != mode_canvas() && mode != mode_fonts() {
            interaction.focused_action(retained_layout.widget())
        } else { "" }
        if keyboard_target != "" {
            let previous_mode = mode
            mode = target_mode(keyboard_target, mode)
            if mode != previous_mode { dirty = true }
        }

        if mode == mode_gallery() {
            if event.kind() == event_pointer_down() || keyboard_target != "" {
                let target = if keyboard_target != "" { keyboard_target } else { retained_layout.hit(event.x(), event.y()) }
                let previous_mode = mode
                let previous_status = status
                mode = target_mode(target, mode)
                status = gallery::status_for(target, status)
                if mode != previous_mode || status != previous_status { dirty = true }
            }
            if dirty {
                retained_layout = window.layout(retained_screen(mode, gallery::view(status), interaction.hovered(), interaction.active(), interaction.focused(), demo_icons))
                window.draw_layout(retained_layout)
                dirty = false
            }
        }
        elif mode == mode_counter() {
            if event.kind() == event_pointer_move() {
                let target = retained_layout.hit(event.x(), event.y())
                let animated = target == "increment" || target == "reset"
                let next_target = if animated { target } else { counter_animation_target }
                counter_animation = counter_animation.with_hovered(animated)
                if next_target != counter_animation_target { counter_animation_target = next_target dirty = true }
            }
            if event.kind() == event_pointer_down() || keyboard_target != "" {
                let target = if keyboard_target != "" { keyboard_target } else { retained_layout.hit(event.x(), event.y()) }
                let previous_mode = mode
                mode = target_mode(target, mode)
                if target == "increment" { count = count + 1_u32 dirty = true }
                elif target == "reset" { count = 0_u32 dirty = true }
                if target == "increment" || target == "reset" {
                    counter_animation_target = target
                    counter_animation = counter_animation.with_hovered(true).with_pressed(true)
                    dirty = true
                }
                if mode != previous_mode { dirty = true }
            }
            if event.kind() == event_pointer_up() { counter_animation = counter_animation.with_pressed(false) }
            if counter_animation.animating() { counter_animation = counter_animation.advance(elapsed_ms) dirty = true }
            if dirty {
                retained_layout = window.layout(retained_screen(mode, counter::view(count, counter_animation, counter_animation_target), interaction.hovered(), interaction.active(), interaction.focused(), demo_icons))
                window.draw_layout(retained_layout)
                dirty = false
            }
        }
        elif mode == mode_animations() {
            if event.kind() == event_pointer_move() {
                let target = retained_layout.hit(event.x(), event.y())
                button_animation = button_animation.with_hovered(animation_target(target))
            }
            if event.kind() == event_pointer_down() || keyboard_target != "" {
                let target = if keyboard_target != "" { keyboard_target } else { retained_layout.hit(event.x(), event.y()) }
                if event.kind() == event_pointer_down() { animation_setting_drag = if animation_setting(target) { target } else { "" } }
                if target == "animation-color-picker" { color_picker_open = !color_picker_open dirty = true }
                let selected = palette_color(target, animation_accent)
                if selected != animation_accent { animation_accent = selected color_picker_open = false dirty = true }
                if target == "easing-linear" { button_animation = button_animation.with_easing(easing_linear()) dirty = true }
                elif target == "easing-in" { button_animation = button_animation.with_easing(easing_in()) dirty = true }
                elif target == "easing-out" { button_animation = button_animation.with_easing(easing_out()) dirty = true }
                elif target == "easing-in-out" { button_animation = button_animation.with_easing(easing_in_out()) dirty = true }
                if event.kind() == event_pointer_down() { button_animation = button_animation.with_pressed(animation_target(target)) }
            }
            if (event.kind() == event_pointer_down() || event.kind() == event_pointer_move()) && animation_setting_drag != "" {
                let position = slider_position(retained_layout, animation_setting_drag, event.x())
                if animation_setting_drag == "setting-radius" { animation_radius = position * 24.0_f32 }
                elif animation_setting_drag == "setting-border" { animation_border = position * 8.0_f32 }
                elif animation_setting_drag == "setting-padding" { animation_padding = position * 24.0_f32 }
                elif animation_setting_drag == "setting-font" { animation_font_size = 10.0_f32 + position * 18.0_f32 }
                elif animation_setting_drag == "setting-opacity" { animation_opacity = position }
                elif animation_setting_drag == "setting-duration" {
                    animation_duration = (60.0_f32 + position * 540.0_f32) as u64
                    button_animation = button_animation.with_duration(animation_duration)
                }
                dirty = true
            }
            if event.kind() == event_pointer_up() {
                button_animation = button_animation.with_pressed(false)
                animation_setting_drag = ""
            }
            if button_animation.animating() {
                button_animation = button_animation.advance(elapsed_ms)
                dirty = true
            }
            if dirty {
                retained_layout = window.layout(retained_screen(mode, animations::view(button_animation,
                    animation_accent, color_picker_open, animation_radius, animation_border,
                    animation_padding, animation_font_size, animation_opacity, animation_duration),
                    interaction.hovered(), interaction.active(), interaction.focused(), demo_icons))
                window.draw_layout(retained_layout)
                dirty = false
            }
        }
        elif mode == mode_elements() {
            if event.kind() == event_pointer_down() {
                let target = retained_layout.hit(event.x(), event.y())
                if target == "volume" { slider_dragging = true }
                elements_state = elements_state.click(target)
                if target == "name" {
                    match retained_layout.find_bounds("name") {
                        Option[Rect]::Some(bounds) => {
                            let width = input_click_width(window, bounds, elements_state.text("name"),
                                elements_state.cursor("name"), event.x())
                            elements_state = elements_state.place_cursor("name",
                                window.text_index(elements_state.text("name"), width))
                        }
                        Option[Rect]::None => {}
                    }
                }
                if target == "notes" {
                    match retained_layout.find_bounds("notes") {
                        Option[Rect]::Some(bounds) => {
                            elements_state = elements_state.place_cursor("notes", window.wrapped_text_index(
                                elements_state.text("notes"), bounds.width() - 20.0_f32,
                                event.x() - bounds.x() - 10.0_f32, event.y() - bounds.y() - 10.0_f32))
                        }
                        Option[Rect]::None => {}
                    }
                }
                if target == "volume" {
                    match retained_layout.find_bounds("volume") {
                        Option[Rect]::Some(bounds) => {
                            elements_state = elements_state.with_slider((event.x() - bounds.x() - 6.0_f32) / (bounds.width() - 12.0_f32))
                        }
                        Option[Rect]::None => {}
                    }
                }
                dirty = true
            }
            if keyboard_target != "" {
                elements_state = elements_state.click(keyboard_target)
                dirty = true
            }
            if event.kind() == event_pointer_move() && slider_dragging {
                match retained_layout.find_bounds("volume") {
                    Option[Rect]::Some(bounds) => {
                        elements_state = elements_state.with_slider((event.x() - bounds.x() - 6.0_f32) / (bounds.width() - 12.0_f32))
                        dirty = true
                    }
                    Option[Rect]::None => {}
                }
            }
            if event.kind() == event_pointer_up() { slider_dragging = false }
            if event.kind() == event_text_input() && event.text() != "" {
                elements_state = elements_state.input(event.text())
                dirty = true
            }
            if event.kind() == event_key_down() && event.key() == 8_u32 {
                elements_state = elements_state.backspace()
                dirty = true
            }
            elif event.kind() == event_key_down() && event.key() == key_enter() && elements_state.focus() == "notes" {
                elements_state = elements_state.input("\n")
                dirty = true
            }
            elif event.kind() == event_key_down() && event.control() && event.key() == 99_u32 {
                window.set_clipboard(elements_state.selected_text())
            }
            elif event.kind() == event_key_down() && event.control() && event.key() == 120_u32 {
                window.set_clipboard(elements_state.selected_text())
                elements_state = elements_state.cut()
                dirty = true
            }
            elif event.kind() == event_key_down() && event.control() && event.key() == 118_u32 {
                elements_state = elements_state.paste(window.clipboard_text())
                dirty = true
            }
            elif event.kind() == event_key_down() {
                elements_state = elements_state.navigate(event.key(), event.shift(), event.control())
                dirty = true
            }
            if dirty {
                retained_layout = window.layout(retained_screen(mode, elements::view(elements_state),
                    interaction.hovered(), interaction.active(), interaction.focused(), demo_icons))
                window.draw_layout(retained_layout)
                dirty = false
            }
        }
        elif mode == mode_playground() {
            if event.kind() == event_pointer_down() {
                let target = retained_layout.hit(event.x(), event.y())
                playground_state = playground_state.click(target).begin_drag(target)
                if target == "css-editor" {
                    match retained_layout.find_bounds("css-editor") {
                        Option[Rect]::Some(bounds) => {
                            playground_state = playground_state.place_cursor(window.wrapped_text_index(
                                playground_state.css(), bounds.width() - 24.0_f32,
                                event.x() - bounds.x() - 12.0_f32, event.y() - bounds.y() - 12.0_f32))
                        }
                        Option[Rect]::None => {}
                    }
                }
                if playground_state.drag() != "" {
                    playground_state = playground_state.with_channel(playground_state.drag(),
                        slider_position(retained_layout, playground_state.drag(), event.x()))
                }
                dirty = true
            }
            if keyboard_target != "" {
                playground_state = playground_state.click(keyboard_target)
                dirty = true
            }
            if event.kind() == event_pointer_move() && playground_state.drag() != "" {
                playground_state = playground_state.with_channel(playground_state.drag(),
                    slider_position(retained_layout, playground_state.drag(), event.x()))
                dirty = true
            }
            if event.kind() == event_pointer_up() { playground_state = playground_state.end_drag() }
            if event.kind() == event_text_input() && event.text() != "" {
                playground_state = playground_state.input(event.text())
                dirty = true
            }
            if event.kind() == event_key_down() && event.key() == 8_u32 {
                playground_state = playground_state.backspace()
                dirty = true
            }
            elif event.kind() == event_key_down() && event.key() == key_enter() && playground_state.focus() == "css-editor" {
                playground_state = playground_state.input("\n")
                dirty = true
            }
            elif event.kind() == event_key_down() {
                playground_state = playground_state.navigate(event.key(), event.shift(), event.control())
                dirty = true
            }
            if dirty {
                retained_layout = window.layout(retained_screen(mode, playground::view(playground_state),
                    interaction.hovered(), interaction.active(), interaction.focused(), demo_icons))
                window.draw_layout(retained_layout)
                dirty = false
            }
        }
        elif mode == mode_icons() {
            if event.kind() == event_pointer_down() || keyboard_target != "" {
                let target = if keyboard_target != "" { keyboard_target } else { retained_layout.hit(event.x(), event.y()) }
                if target == "icons-previous" && icon_page > 0_usize { icon_page = icon_page - 1_usize dirty = true }
                elif target == "icons-next" && (icon_page + 1_usize) * 20_usize < icon_manager.len() { icon_page = icon_page + 1_usize dirty = true }
                let selection = icons::selected_name(target, selected_icon)
                if selection != selected_icon { selected_icon = selection dirty = true }
            }
            if dirty {
                retained_layout = window.layout(retained_screen(mode, icons::view(icon_manager, icon_page, selected_icon),
                    interaction.hovered(), interaction.active(), interaction.focused(), demo_icons))
                window.draw_layout(retained_layout)
                dirty = false
            }
        }
        elif mode == mode_canvas() {
            if dirty {
                canvas::draw(window, cursor_x, cursor_y)
                draw_immediate_toolbar(window, mode, demo_icons)
                window.present()
                dirty = false
            }
        }
        elif mode == mode_fonts() {
            if event.kind() == event_text_input() && event.text() != "" {
                preview_text = preview_text + event.text()
                dirty = true
            }
            if event.kind() == event_key_down() && event.key() == 8_u32 && preview_text.char_len() > 0_usize {
                preview_text = preview_text.slice(0_usize, preview_text.char_len() - 1_usize)
                dirty = true
            }
            if event.kind() == event_pointer_down() {
                if event.x() >= 600.0_f32 && event.x() < 872.0_f32 && event.y() >= 88.0_f32 && event.y() < 126.0_f32 {
                    font_menu_open = !font_menu_open
                    dirty = true
                }
                elif font_menu_open {
                    match font_option_at(font_manager.faces(), event.x(), event.y()) {
                        Option[str]::Some(family) => {
                            font_manager = font_manager.activate(window, family,
                                font_manager.active_size(), font_manager.active_weight())
                            font_menu_open = false
                            dirty = true
                        }
                        Option[str]::None => { font_menu_open = false dirty = true }
                    }
                }
                elif event.y() >= 390.0_f32 && event.y() < 422.0_f32 {
                    let mut size = font_manager.active_size()
                    if event.x() >= 180.0_f32 && event.x() < 216.0_f32 && size > 8.0_f32 { size = size - 2.0_f32 }
                    elif event.x() >= 310.0_f32 && event.x() < 346.0_f32 && size < 72.0_f32 { size = size + 2.0_f32 }
                    if size != font_manager.active_size() {
                        font_manager = font_manager.activate(window, font_manager.active_family(), size, font_manager.active_weight())
                        dirty = true
                    }
                }
                elif event.y() >= 438.0_f32 && event.y() < 470.0_f32 {
                    let mut weight = font_manager.active_weight()
                    if event.x() >= 180.0_f32 && event.x() < 216.0_f32 && weight > 100_u32 { weight = weight - 100_u32 }
                    elif event.x() >= 310.0_f32 && event.x() < 346.0_f32 && weight < 900_u32 { weight = weight + 100_u32 }
                    if weight != font_manager.active_weight() {
                        font_manager = font_manager.activate(window, font_manager.active_family(), font_manager.active_size(), weight)
                        dirty = true
                    }
                }
            }
            if dirty {
                fonts::draw(window, font_manager.active_family(), font_manager.error(),
                    font_manager.faces(), font_menu_open, preview_text,
                    font_manager.active_size(), font_manager.active_weight())
                draw_immediate_toolbar(window, mode, demo_icons)
                window.present()
                dirty = false
            }
        }
        sleep_ms(16_u64)
    }
    window.destroy()
    ret 0_u32
}
