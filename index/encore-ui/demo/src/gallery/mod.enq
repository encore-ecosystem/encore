import core::io::println
import core::time::sleep_ms
import encore_ui::{
    Color, Insets, Style, Widget, Window, backend_error, event_close,
    event_key_down, event_pointer_down, horizontal, vertical
}

fn canvas_color() -> Color { ret Color::rgb(238_u8, 242_u8, 246_u8) }
fn surface_color() -> Color { ret Color::rgb(255_u8, 255_u8, 255_u8) }
fn ink_color() -> Color { ret Color::rgb(31_u8, 36_u8, 43_u8) }
fn muted_color() -> Color { ret Color::rgb(102_u8, 112_u8, 125_u8) }
fn line_color() -> Color { ret Color::rgb(203_u8, 211_u8, 220_u8) }
fn primary_color() -> Color { ret Color::rgb(18_u8, 153_u8, 126_u8) }
fn danger_color() -> Color { ret Color::rgb(207_u8, 72_u8, 72_u8) }
fn warning_color() -> Color { ret Color::rgb(224_u8, 157_u8, 49_u8) }

fn root_style() -> Style {
    ret Style::default()
        .with_background(canvas_color())
        .with_padding(Insets::all(18.0_f32))
        .with_gap(12.0_f32)
}

fn section_style() -> Style {
    ret Style::panel()
        .with_background(surface_color())
        .with_foreground(ink_color())
        .with_border(1.0_f32, line_color())
        .with_padding(Insets::all(12.0_f32))
        .with_gap(8.0_f32)
}

fn toolbar_style() -> Style {
    ret Style::default()
        .with_background(ink_color())
        .with_foreground(Color::rgb(248_u8, 250_u8, 252_u8))
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
        .with_gap(8.0_f32)
}

fn primary_button() -> Style {
    ret Style::panel()
        .with_background(primary_color())
        .with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
        .with_border(1.0_f32, primary_color())
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}

fn secondary_button() -> Style {
    ret Style::panel()
        .with_background(Color::rgb(74_u8, 85_u8, 99_u8))
        .with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
        .with_border(1.0_f32, Color::rgb(74_u8, 85_u8, 99_u8))
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}

fn danger_button() -> Style {
    ret Style::panel()
        .with_background(danger_color())
        .with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
        .with_border(1.0_f32, danger_color())
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}

fn outline_button() -> Style {
    ret Style::panel()
        .with_background(surface_color())
        .with_foreground(ink_color())
        .with_border(1.0_f32, Color::rgb(116_u8, 128_u8, 142_u8))
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}

fn ghost_button() -> Style {
    ret Style::default()
        .with_background(Color::rgb(245_u8, 247_u8, 250_u8))
        .with_foreground(ink_color())
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}

fn badge_style(background: Color, foreground: Color) -> Style {
    ret Style::default()
        .with_background(background)
        .with_foreground(foreground)
        .with_padding(Insets::symmetric(4.0_f32, 8.0_f32))
}

fn button_row() -> Widget {
    let mut row = Widget::panel("button-row")
        .with_direction(horizontal())
        .with_flex(42.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(8.0_f32))
    row.push(Widget::button("primary", "Primary").with_flex(104.0_f32, 0.0_f32).with_style(primary_button()))
    row.push(Widget::button("secondary", "Secondary").with_flex(112.0_f32, 0.0_f32).with_style(secondary_button()))
    row.push(Widget::button("outline", "Outline").with_flex(96.0_f32, 0.0_f32).with_style(outline_button()))
    row.push(Widget::button("danger", "Danger").with_flex(92.0_f32, 0.0_f32).with_style(danger_button()))
    row.push(Widget::button("ghost", "Ghost").with_flex(84.0_f32, 0.0_f32).with_style(ghost_button()))
    row.push(Widget::spacer(1.0_f32))
    ret row
}

fn size_row() -> Widget {
    let mut row = Widget::panel("size-row")
        .with_direction(horizontal())
        .with_flex(52.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(8.0_f32))
    row.push(Widget::button("compact", "Compact").with_flex(92.0_f32, 0.0_f32).with_style(primary_button().with_padding(Insets::symmetric(4.0_f32, 8.0_f32))))
    row.push(Widget::button("regular", "Regular").with_flex(104.0_f32, 0.0_f32).with_style(primary_button()))
    row.push(Widget::button("large", "Large action").with_flex(136.0_f32, 0.0_f32).with_style(primary_button().with_padding(Insets::symmetric(12.0_f32, 16.0_f32))))
    row.push(Widget::spacer(1.0_f32))
    ret row
}

fn badges_row() -> Widget {
    let mut row = Widget::panel("badges")
        .with_direction(horizontal())
        .with_flex(30.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(8.0_f32))
    row.push(Widget::label("READY").with_flex(72.0_f32, 0.0_f32).with_style(
        badge_style(Color::rgb(214_u8, 244_u8, 235_u8), Color::rgb(14_u8, 112_u8, 89_u8))
    ))
    row.push(Widget::label("WARNING").with_flex(88.0_f32, 0.0_f32).with_style(
        badge_style(Color::rgb(255_u8, 239_u8, 205_u8), Color::rgb(137_u8, 88_u8, 14_u8))
    ))
    row.push(Widget::label("FAILED").with_flex(76.0_f32, 0.0_f32).with_style(
        badge_style(Color::rgb(252_u8, 222_u8, 222_u8), Color::rgb(157_u8, 46_u8, 46_u8))
    ))
    row.push(Widget::spacer(1.0_f32))
    ret row
}

fn metric_card(id: str, title: str, value: str, accent: Color) -> Widget {
    let mut card = Widget::panel(id).with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(
        section_style().with_border(2.0_f32, accent).with_padding(Insets::all(10.0_f32)).with_gap(5.0_f32)
    )
    card.push(Widget::label(title).with_flex(22.0_f32, 0.0_f32).with_style(Style::default().with_foreground(muted_color())))
    card.push(Widget::label(value).with_flex(28.0_f32, 0.0_f32).with_style(Style::default().with_foreground(ink_color())))
    card.push(Widget::spacer(1.0_f32))
    ret card
}

fn metrics_row() -> Widget {
    let mut row = Widget::panel("metrics")
        .with_direction(horizontal())
        .with_flex(92.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(10.0_f32))
    row.push(metric_card("builds", "BUILDS", "128 successful", primary_color()))
    row.push(metric_card("warnings", "WARNINGS", "3 require review", warning_color()))
    row.push(metric_card("failures", "FAILURES", "0 blocking", danger_color()))
    ret row
}

fn app_view(status: str) -> Widget {
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(root_style())

    let mut toolbar = Widget::panel("toolbar").with_direction(horizontal()).with_flex(48.0_f32, 0.0_f32).with_style(toolbar_style())
    toolbar.push(Widget::label("Encore UI / Style Gallery").with_flex(224.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(248_u8, 250_u8, 252_u8))
    ))
    toolbar.push(Widget::spacer(1.0_f32))
    toolbar.push(Widget::label("SDL3").with_flex(56.0_f32, 0.0_f32).with_style(
        badge_style(Color::rgb(48_u8, 57_u8, 68_u8), Color::rgb(207_u8, 218_u8, 230_u8))
    ))
    root.push(toolbar)

    let mut buttons = Widget::panel("buttons-section").with_direction(vertical()).with_flex(146.0_f32, 0.0_f32).with_style(section_style())
    buttons.push(Widget::label("BUTTON VARIANTS").with_flex(22.0_f32, 0.0_f32).with_style(Style::default().with_foreground(muted_color())))
    buttons.push(button_row())
    buttons.push(size_row())
    root.push(buttons)

    let mut elements = Widget::panel("elements-section").with_direction(vertical()).with_flex(170.0_f32, 0.0_f32).with_style(section_style())
    elements.push(Widget::label("INTERFACE ELEMENTS").with_flex(22.0_f32, 0.0_f32).with_style(Style::default().with_foreground(muted_color())))
    elements.push(badges_row())
    elements.push(metrics_row())
    root.push(elements)

    root.push(Widget::spacer(1.0_f32))

    let mut status_bar = Widget::panel("status-bar").with_direction(horizontal()).with_flex(38.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(225_u8, 231_u8, 237_u8)).with_padding(Insets::symmetric(7.0_f32, 10.0_f32)).with_gap(8.0_f32)
    )
    status_bar.push(Widget::label("STATUS").with_flex(64.0_f32, 0.0_f32).with_style(Style::default().with_foreground(muted_color())))
    status_bar.push(Widget::label(status).with_flex(260.0_f32, 0.0_f32).with_style(Style::default().with_foreground(ink_color())))
    status_bar.push(Widget::spacer(1.0_f32))
    status_bar.push(Widget::label("ESC to close").with_flex(96.0_f32, 0.0_f32).with_style(Style::default().with_foreground(muted_color())))
    root.push(status_bar)
    ret root
}

fn status_for(target: str, fallback: str) -> str {
    if target == "primary" { ret "Primary action selected" }
    if target == "secondary" { ret "Secondary action selected" }
    if target == "outline" { ret "Outline action selected" }
    if target == "danger" { ret "Danger action selected" }
    if target == "ghost" { ret "Ghost action selected" }
    if target == "compact" { ret "Compact button selected" }
    if target == "regular" { ret "Regular button selected" }
    if target == "large" { ret "Large button selected" }
    ret fallback
}

pub fn run() -> u32 {
    let window = Window::create("Encore UI Style Gallery", 920_u32, 620_u32)
    if !window.available() {
        println("Unable to start Encore UI: " + backend_error())
        ret 1_u32
    }
    let mut status = "Choose a button variant"
    while window.is_open() {
        let event = window.poll()
        let layout = window.draw(app_view(status))
        if event.kind() == event_close() { break }
        if event.kind() == event_key_down() && event.key() == 27_u32 { break }
        if event.kind() == event_pointer_down() {
            status = status_for(layout.hit(event.x(), event.y()), status)
        }
        sleep_ms(16_u64)
    }
    window.destroy()
    ret 0_u32
}
