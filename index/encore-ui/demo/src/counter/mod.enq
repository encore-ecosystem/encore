import core::fmt::Debug
import encore_ui::{
    Color, Insets, Style, Widget, horizontal, vertical
}

fn button_style(color: Color) -> Style {
    ret Style::panel()
        .with_background(color)
        .with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
        .with_padding(Insets::symmetric(8.0_f32, 12.0_f32))
}

pub fn view(count: u32) -> Widget {
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(
        Style::panel()
            .with_background(Color::rgb(242_u8, 245_u8, 248_u8))
            .with_padding(Insets::all(24.0_f32))
            .with_gap(14.0_f32)
    )
    root.push(Widget::label("Counter").with_flex(30.0_f32, 0.0_f32))
    root.push(Widget::label(Debug::fmt(count)).with_flex(40.0_f32, 0.0_f32))

    let mut actions = Widget::panel("actions")
        .with_direction(horizontal())
        .with_flex(44.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(10.0_f32))
    actions.push(Widget::button("increment", "Increment").with_flex(120.0_f32, 0.0_f32).with_style(
        button_style(Color::rgb(20_u8, 153_u8, 126_u8))
    ))
    actions.push(Widget::button("reset", "Reset").with_flex(88.0_f32, 0.0_f32).with_style(
        button_style(Color::rgb(74_u8, 84_u8, 98_u8))
    ))
    actions.push(Widget::spacer(1.0_f32))
    root.push(actions)
    root.push(Widget::spacer(1.0_f32))
    ret root
}
