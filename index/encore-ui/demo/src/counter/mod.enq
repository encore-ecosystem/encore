import core::fmt::Debug
import encore_ui::{
    ButtonAnimation, Color, Insets, Style, Theme, Widget, apply_css, horizontal, vertical
}

fn animated_button(id: str, text: str, base: Style, animation: ButtonAnimation, target: str) -> Widget {
    let hover = apply_css(base, "background-color: #0f806a; border-color: #0f806a; box-shadow: 0px 6px 14px 0px rgb(18 153 126 / 24%);")
    let pressed = apply_css(base, "background-color: #0b6756; border-color: #0b6756; box-shadow: inset 0px 2px 4px 0px rgb(5 45 38 / 35%); padding: 11px 12px 9px 12px;")
    let style = if target == id { animation.style(base, hover, pressed) } else { base }
    ret Widget::button(id, text).with_flex(132.0_f32, 0.0_f32).with_style(style)
}

pub fn view(count: u32, animation: ButtonAnimation, target: str) -> Widget {
    let theme = Theme::light()
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(
        theme.root().with_padding(Insets::all(32.0_f32)).with_gap(18.0_f32)
    )
    root.push(Widget::heading("Counter").with_flex(34.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(31_u8, 42_u8, 54_u8)).with_font_size(24.0_f32).with_font_weight(700_u32)))
    root.push(Widget::label("A compact state and interaction example").with_flex(24.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(100_u8, 113_u8, 128_u8))))

    let mut display = Widget::panel("counter-display").with_direction(vertical()).with_flex(210.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(255_u8, 255_u8, 255_u8)).with_border(1.0_f32, Color::rgb(211_u8, 219_u8, 227_u8))
            .with_radius(8.0_f32).with_padding(Insets::all(24.0_f32)).with_gap(8.0_f32))
    display.push(Widget::label("CURRENT VALUE").with_flex(20.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(100_u8, 113_u8, 128_u8)).with_font_size(12.0_f32).with_font_weight(700_u32)))
    display.push(Widget::label(Debug::fmt(count)).with_flex(92.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(18_u8, 153_u8, 126_u8)).with_font_size(54.0_f32).with_font_weight(700_u32)))
    display.push(Widget::progress(if count > 20_u32 { 1.0_f32 } else { count as f32 / 20.0_f32 }).with_flex(10.0_f32, 0.0_f32))
    root.push(display)

    let mut actions = Widget::panel("actions")
        .with_direction(horizontal())
        .with_flex(48.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(10.0_f32))
    actions.push(animated_button("increment", "+  Increment", theme.primary_button(), animation, target))
    let reset_base = theme.secondary_button()
    let reset_hover = apply_css(reset_base, "background-color: #eef2f6; border-color: #8693a1; box-shadow: 0px 4px 10px 0px rgb(31 42 54 / 12%);")
    let reset_pressed = apply_css(reset_base, "background-color: #dde4eb; border-color: #667483; box-shadow: inset 0px 2px 3px 0px rgb(31 42 54 / 18%); padding: 11px 12px 9px 12px;")
    actions.push(Widget::button("reset", "Reset").with_flex(104.0_f32, 0.0_f32).with_style(
        if target == "reset" { animation.style(reset_base, reset_hover, reset_pressed) } else { reset_base }))
    actions.push(Widget::spacer(1.0_f32))
    root.push(actions)
    root.push(Widget::spacer(1.0_f32))
    ret root
}
