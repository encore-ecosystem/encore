import core::io::println
import core::time::sleep_ms
import graphene::{
    app::{App, AppConfig},
    color::Color,
    geometry::Rect,
    window::backend_name
}

fn main() -> u32 {
    let config = AppConfig::new("Graphene native window", 800_u32, 480_u32)
        .with_clear_color(Color::rgb(18_u32, 24_u32, 32_u32))
    let mut app = App::open(config)
    if !app.is_ready() {
        println("Unable to open native GUI window. Check DISPLAY/XWayland availability.")
        ret 1_u32
    }
    println("Graphene backend: " + backend_name())

    let mut frame = 0_i32
    let mut x = 24_i32
    let mut y = 64_i32
    let mut dx = 5_i32
    let mut dy = 3_i32

    loop {
        if !app.begin_frame() {
            break
        }

        app.draw_rect(Rect::new(24_i32, 24_i32, 752_u32, 432_u32), Color::rgb(36_u32, 45_u32, 56_u32))
        app.draw_rect(Rect::new(x, y, 140_u32, 84_u32), Color::rgb(84_u32, 204_u32, 196_u32))
        app.draw_rect(Rect::new(800_i32 - x - 170_i32, 480_i32 - y - 110_i32, 110_u32, 110_u32), Color::rgb(245_u32, 172_u32, 75_u32))
        app.end_frame()

        x = x + dx
        y = y + dy
        if x <= 24_i32 || x >= 636_i32 {
            dx = 0_i32 - dx
        }
        if y <= 32_i32 || y >= 348_i32 {
            dy = 0_i32 - dy
        }

        frame = frame + 1_i32
        sleep_ms(16_u64)
    }

    app.close()
    ret 0_u32
}
