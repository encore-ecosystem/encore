import core::os
import core::option::Option

fn meta_path() -> Option[str] {
    ret os::argv(1_usize)
}

fn linux_payload() -> str {
    ret "{\n  \"native\": {\n    \"libraries\": [{\"name\":\"X11\",\"cfg\":\"linux\"}],\n    \"search_paths\": [],\n    \"frameworks\": [],\n    \"link_args\": []\n  }\n}\n"
}

fn windows_payload() -> str {
    ret "{\n  \"native\": {\n    \"libraries\": [{\"name\":\"user32\",\"cfg\":\"windows\"},{\"name\":\"gdi32\",\"cfg\":\"windows\"}],\n    \"search_paths\": [],\n    \"frameworks\": [],\n    \"link_args\": []\n  }\n}\n"
}

fn macos_payload() -> str {
    ret "{\n  \"native\": {\n    \"libraries\": [{\"name\":\"Cocoa\",\"kind\":\"framework\",\"cfg\":\"macos\"}],\n    \"search_paths\": [],\n    \"frameworks\": [],\n    \"link_args\": []\n  }\n}\n"
}

fn payload() -> str {
    let name = os::os_name()
    if name == "linux" {
        ret linux_payload()
    }
    if name == "windows" {
        ret windows_payload()
    }
    if name == "macos" {
        ret macos_payload()
    }
    ret "{\n  \"native\": {\n    \"libraries\": [],\n    \"search_paths\": [],\n    \"frameworks\": [],\n    \"link_args\": []\n  }\n}\n"
}

fn main() -> u32 {
    match meta_path() {
        Option[str]::Some(path) => {
            if os::write_file(path, payload()) != 0_i32 {
                ret 1_u32
            }
            ret 0_u32
        }
        Option[str]::None => {
            ret 2_u32
        }
    }
}
