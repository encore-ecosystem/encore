pub struct Color {
    r: u32
    g: u32
    b: u32
    a: u32
}

impl for Color {
    pub fn rgb(r: u32, g: u32, b: u32) -> Color {
        ret Color { r, g, b, 255_u32 }
    }

    pub fn rgba(r: u32, g: u32, b: u32, a: u32) -> Color {
        ret Color { r, g, b, a }
    }

    pub fn black() -> Color {
        ret Color::rgb(0_u32, 0_u32, 0_u32)
    }

    pub fn white() -> Color {
        ret Color::rgb(255_u32, 255_u32, 255_u32)
    }

    pub fn to_rgb_u32(self: Self) -> u32 {
        ret self.r * 65536_u32 + self.g * 256_u32 + self.b
    }
}
