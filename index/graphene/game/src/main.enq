struct PlayerController {
    speed: f32
}

impl for PlayerController {
    pub fn new(speed: f32) -> Self {
        ret Self { speed }
    }

    pub fn update(self: Self, delta: f32) -> f32 {
        ret self.speed * delta
    }
}

fn main() -> u32 {
    let controller = PlayerController::new(5.0_f32)
    let distance = controller.update(0.016_f32)
    ret if distance > 0.0_f32 { 0_u32 } else { 1_u32 }
}
