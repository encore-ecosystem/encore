import core::option::Option
import graphene::{Scene, SceneActor, SceneAsset, Transform}
import linalg::Vec3

fn main() -> u32 {
    let legacy_source = "{\"format\":\"graphene-scene\",\"version\":1,\"actors\":[{\"name\":\"Root\",\"kind\":\"cube\",\"transform\":{\"position\":[0,0,0],\"rotation\":[0,0,0],\"scale\":[1,1,1]}},{\"name\":\"Child\",\"kind\":\"cube\",\"transform\":{\"position\":[1,0,0],\"rotation\":[0,0,0],\"scale\":[1,1,1]}}]}"
    let mut migrated = SceneAsset::new()
    let mut migrated_ok = false
    match SceneAsset::parse(legacy_source) {
        Option::Some(asset) => { migrated = asset migrated_ok = true }
        Option::None => {}
    }
    if !migrated_ok { ret 1_u32 }
    if migrated.version() != 2_u32 || migrated.len() != 2_usize { ret 2_u32 }
    match migrated.actor(0_usize) { Option::Some(actor) => { if actor.id() != 1_u64 { ret 3_u32 } } Option::None => { ret 4_u32 } }

    let mut asset = SceneAsset::new()
    asset.add(SceneActor::new("Root", "cube", Transform::identity()).with_identity(17_u64))
    asset.add(SceneActor::new("Child", "cube", Transform::identity()).with_identity(42_u64).with_parent(Option[u64]::Some(17_u64)))
    let mut decoded = SceneAsset::new()
    let mut decoded_ok = false
    match SceneAsset::parse(asset.stringify()) {
        Option::Some(found) => { decoded = found decoded_ok = true }
        Option::None => {}
    }
    if !decoded_ok { ret 5_u32 }
    if !decoded.valid_hierarchy() { ret 6_u32 }
    match decoded.actor_by_id(42_u64) {
        Option::Some(actor) => { if actor.parent() != Option[u64]::Some(17_u64) { ret 7_u32 } }
        Option::None => { ret 8_u32 }
    }

    let mut scene = Scene::new()
    if !scene.create_entity_with_id(17_u64, "Root", Transform::identity()) { ret 9_u32 }
    if !scene.create_entity_with_id(42_u64, "Child", Transform::identity()) { ret 10_u32 }
    if !scene.set_parent(42_u64, Option[u64]::Some(17_u64)) { ret 11_u32 }
    if scene.create_entity_with_id(42_u64, "Duplicate", Transform::identity()) { ret 12_u32 }
    let generated = scene.create_entity("Generated", Transform::identity())
    if generated <= 42_u64 { ret 13_u32 }
    let mut hierarchy = Scene::new()
    let parent = hierarchy.create_entity("Parent", Transform::identity().with_position(Vec3::new(2.0_f32, 0.0_f32, 0.0_f32))
        .with_scale(Vec3::new(2.0_f32, 2.0_f32, 2.0_f32)))
    let child = hierarchy.create_entity("Child", Transform::identity().with_position(Vec3::new(6.0_f32, 0.0_f32, 0.0_f32)))
    if !hierarchy.set_parent_keep_world(child, Option[u64]::Some(parent)) { ret 14_u32 }
    match hierarchy.get(child) {
        Option::Some(entity) => {
            if entity.parent() != Option[u64]::Some(parent) || entity.transform().position().x() < 1.99_f32 ||
                entity.transform().position().x() > 2.01_f32 { ret 15_u32 }
        }
        Option::None => { ret 16_u32 }
    }
    match hierarchy.world_position(child) {
        Option::Some(position) => { if position.x() < 5.99_f32 || position.x() > 6.01_f32 { ret 17_u32 } }
        Option::None => { ret 18_u32 }
    }
    if !hierarchy.set_parent_keep_world(child, Option[u64]::None) { ret 19_u32 }
    match hierarchy.get(child) {
        Option::Some(entity) => {
            if entity.parent().is_some() || entity.transform().position().x() < 5.99_f32 || entity.transform().position().x() > 6.01_f32 { ret 20_u32 }
        }
        Option::None => { ret 21_u32 }
    }
    let shear_parent = hierarchy.create_entity("Shear Parent", Transform::identity().with_rotation(Vec3::new(0.0_f32, 0.7_f32, 0.0_f32))
        .with_scale(Vec3::new(2.0_f32, 1.0_f32, 0.5_f32)))
    if hierarchy.set_parent_keep_world(child, Option[u64]::Some(shear_parent)) { ret 22_u32 }
    match hierarchy.get(child) {
        Option::Some(entity) => { if entity.parent().is_some() { ret 23_u32 } }
        Option::None => { ret 24_u32 }
    }
    ret 0_u32
}
