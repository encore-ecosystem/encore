import graphene::{content_asset_matches, outliner_actor_matches, search_matches}

fn main() -> u32 {
    if !content_asset_matches("", "Cube", "Static Mesh") { ret 1_u32 }
    if !content_asset_matches("cube", "Cube", "Static Mesh") { ret 2_u32 }
    if !content_asset_matches("STATIC", "Cube", "Static Mesh") { ret 3_u32 }
    if !content_asset_matches("script", "Player", "Encore Script") { ret 4_u32 }
    if !content_asset_matches("my mesh", "My Mesh.obj", "Imported OBJ") { ret 5_u32 }
    if content_asset_matches("material", "Player", "Encore Script") { ret 6_u32 }
    if !search_matches("directional", "Directional Light") { ret 7_u32 }
    if !outliner_actor_matches("mesh", "My Mesh", false, true) { ret 8_u32 }
    if outliner_actor_matches("mesh", "My Mesh", false, false) { ret 9_u32 }
    if outliner_actor_matches("camera", "Directional Light", true, true) { ret 10_u32 }
    ret 0_u32
}
