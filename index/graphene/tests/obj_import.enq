import core::result::Result
import graphene::parse_obj

fn main() -> u32 {
    let quad = "# quad\nv -1 0 -1\nv 1 0 -1\nv 1 0 1\nv -1 0 1\nf 1 2 3 4\n"
    match parse_obj(quad) {
        Result::Ok(mesh) => {
            if mesh.vertex_count() != 6_usize { ret 1_u32 }
            if mesh.index_count() != 6_usize { ret 2_u32 }
            if mesh.stride() != 36_u32 { ret 3_u32 }
        }
        Result::Err(_) => { ret 4_u32 }
    }
    let negative = "v 0 0 0\nv 1 0 0\nv 0 1 0\nf -3/-1 -2/-1 -1/-1\n"
    match parse_obj(negative) {
        Result::Ok(mesh) => { if mesh.index_count() != 3_usize { ret 5_u32 } }
        Result::Err(_) => { ret 6_u32 }
    }
    match parse_obj("v 0 0 0\nf 1 2 3\n") {
        Result::Ok(_) => { ret 7_u32 }
        Result::Err(_) => {}
    }
    ret 0_u32
}
