import core::os::{file_exists, write_file}
import core::result::Result
import core::time::perf_counter_ms
import graphene::{add_actor_mesh_name, discover_obj_assets, import_obj_asset, project_mesh_directory}

fn main() -> u32 {
    let suffix = perf_counter_ms().fmt()
    let root = "/tmp/graphene-asset-import-" + suffix
    let source = "/tmp/graphene-source-" + suffix + ".obj"
    let content = "v 0 0 0\nv 1 0 0\nv 0 1 0\nf 1 2 3\n"
    if write_file(source, content) != 0_i32 { ret 1_u32 }
    match import_obj_asset(root, source) {
        Result::Ok(asset) => {
            if asset.name() != "graphene-source-" + suffix + ".obj" { ret 2_u32 }
            if !file_exists(asset.project_path()) { ret 3_u32 }
            if asset.mesh().index_count() != 3_usize { ret 4_u32 }
        }
        Result::Err(_) => { ret 5_u32 }
    }
    let discovered = discover_obj_assets(root)
    if discovered.len() != 1_usize { ret 6_u32 }
    match discovered.get(0_usize) {
        Some(asset) => {
            if asset.mesh().vertex_count() != 3_usize { ret 7_u32 }
            if asset.project_path() != project_mesh_directory(root) + "/" + asset.name() { ret 8_u32 }
        }
        None => { ret 9_u32 }
    }
    match add_actor_mesh_name("add-actor-cube", discovered) {
        Some(name) => { if name != "" { ret 10_u32 } }
        None => { ret 11_u32 }
    }
    match add_actor_mesh_name("add-actor-imported-0", discovered) {
        Some(name) => { if name != "graphene-source-" + suffix + ".obj" { ret 12_u32 } }
        None => { ret 13_u32 }
    }
    if add_actor_mesh_name("add-actor-imported-99", discovered).is_some() { ret 14_u32 }
    ret 0_u32
}
