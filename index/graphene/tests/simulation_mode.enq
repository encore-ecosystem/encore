import graphene::{normalize_simulation_mode, simulation_mode_active, simulation_mode_is_play, simulation_mode_label, simulation_world_message}

fn main() -> u32 {
    if normalize_simulation_mode("invalid") != "" { ret 1_u32 }
    if !simulation_mode_active("play") || !simulation_mode_active("simulate") { ret 2_u32 }
    if simulation_mode_active("") { ret 3_u32 }
    if !simulation_mode_is_play("play") || simulation_mode_is_play("simulate") { ret 4_u32 }
    if simulation_mode_label("play") != "PLAYING" { ret 5_u32 }
    if simulation_mode_label("simulate") != "SIMULATING" { ret 6_u32 }
    if simulation_mode_label("") != "EDITOR" { ret 7_u32 }
    if simulation_world_message("play") != "Play in editor running" { ret 8_u32 }
    if simulation_world_message("simulate") != "Editor simulation running" { ret 9_u32 }
    ret 0_u32
}
