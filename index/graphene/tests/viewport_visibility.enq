import core::option::Option
import graphene::{StandardMaterial, ViewportRenderer}
import linalg::Vec3

fn main() -> u32 {
    match ViewportRenderer::create(320_u32, 240_u32) {
        Option::Some(created) => {
            let mut renderer = created
            renderer.sync_cubes(2_u32)
            if !renderer.cube_is_visible(1_u32) || !renderer.cube_is_visible(2_u32) { ret 1_u32 }
            if !renderer.set_cube_visible(2_u32, false) || renderer.cube_is_visible(2_u32) { ret 2_u32 }
            if !renderer.set_cube_visible(2_u32, true) || !renderer.cube_is_visible(2_u32) { ret 3_u32 }
            let material = StandardMaterial::new(Vec3::new(0.72_f32, 0.18_f32, 0.11_f32), 0.6_f32, 0.25_f32).with_unlit()
            if !renderer.set_default_material(material) { ret 4_u32 }
            let stored = renderer.default_material()
            if stored.base_color().x() < 0.719_f32 || stored.metallic() < 0.599_f32 || !stored.unlit() { ret 5_u32 }
            ret 0_u32
        }
        Option::None => { ret 6_u32 }
    }
}
