import graphene::{cube_mesh, plane_mesh, sphere_mesh}

fn main() -> u32 {
    let cube = cube_mesh(1.0_f32)
    if cube.vertex_count() != 24_usize || cube.index_count() != 36_usize { ret 1_u32 }
    let plane = plane_mesh(2.0_f32)
    if plane.vertex_count() != 4_usize || plane.index_count() != 12_usize { ret 2_u32 }
    let sphere = sphere_mesh(1.0_f32, 8_u32, 12_u32)
    if sphere.vertex_count() != 117_usize { ret 3_u32 }
    if sphere.index_count() != 504_usize { ret 4_u32 }
    ret 0_u32
}
