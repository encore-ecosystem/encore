import core::vec::Vec
import core::option::Option
import graphene::{ActorRecord, EditorActors, EditorEdit, ParentEdit, RenameEdit, TransformEdit, VisibilityEdit}
import linalg::Vec3

fn main() -> u32 {
    let transform = TransformEdit::new(2_u32, Vec3::zero(), Vec3::zero(), Vec3::new(1.0_f32, 1.0_f32, 1.0_f32),
        Vec3::new(3.0_f32, 0.0_f32, 0.0_f32), Vec3::zero(), Vec3::new(2.0_f32, 2.0_f32, 2.0_f32))
    if transform.actor() != 2_u32 || transform.position(false).x() != 0.0_f32 || transform.position(true).x() != 3.0_f32 { ret 1_u32 }
    let actor = ActorRecord::new(1_u32, 27_u64, Option[u64]::None, Vec[u64]::new(), "Sphere", "@sphere", false,
        Vec3::zero(), Vec3::zero(), Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    if actor.id() != 27_u64 || actor.parent().is_some() || actor.name() != "Sphere" || actor.mesh_name() != "@sphere" || actor.visible() { ret 2_u32 }
    let rename = RenameEdit::new(1_u32, "Before", "After")
    if rename.value(false) != "Before" || rename.value(true) != "After" { ret 3_u32 }
    let visibility = VisibilityEdit::new(1_u32, true, false)
    if !visibility.value(false) || visibility.value(true) { ret 4_u32 }
    let parent = ParentEdit::new(27_u64, Option[u64]::Some(11_u64), Option[u64]::None)
    if parent.actor_id() != 27_u64 || parent.value(false) != Option[u64]::Some(11_u64) || parent.value(true).is_some() { ret 23_u32 }
    let edit = EditorEdit::Add(actor)
    match edit { EditorEdit::Add(value) => { if value.index() != 1_u32 { ret 5_u32 } } _ => { ret 6_u32 } }
    let mut names = Vec[str]::new() names.push("Cube") names.push("Plane")
    let mut ids = Vec[u64]::new() ids.push(11_u64) ids.push(33_u64)
    let mut parents = Vec[Option[u64]]::new() parents.push(Option[u64]::None) parents.push(Option[u64]::Some(11_u64))
    let mut meshes = Vec[str]::new() meshes.push("") meshes.push("@plane")
    let mut visible = Vec[bool]::new() visible.push(true) visible.push(true)
    let mut positions = Vec[Vec3]::new() positions.push(Vec3::zero()) positions.push(Vec3::new(2.0_f32, 0.0_f32, 0.0_f32))
    let mut rotations = Vec[Vec3]::new() rotations.push(Vec3::zero()) rotations.push(Vec3::zero())
    let mut scales = Vec[Vec3]::new() scales.push(Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)) scales.push(Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    let middle = ActorRecord::new(2_u32, 27_u64, Option[u64]::Some(11_u64), Vec[u64]::new(), "Sphere", "@sphere", true, Vec3::new(1.0_f32, 0.0_f32, 0.0_f32),
        Vec3::zero(), Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    let inserted = EditorActors::new(ids, parents, names, meshes, visible, positions, rotations, scales).apply(middle, true)
    if inserted.len() != 3_usize { ret 7_u32 }
    match inserted.names().get(1_usize) { Some(name) => { if name != "Sphere" { ret 8_u32 } } None => { ret 9_u32 } }
    match inserted.mesh_names().get(2_usize) { Some(name) => { if name != "@plane" { ret 10_u32 } } None => { ret 11_u32 } }
    match inserted.ids().get(1_usize) { Some(id) => { if id != 27_u64 { ret 15_u32 } } None => { ret 16_u32 } }
    match inserted.parents().get(1_usize) { Some(parent) => { if parent != Option[u64]::Some(11_u64) { ret 17_u32 } } None => { ret 18_u32 } }
    let removed = inserted.apply(middle, false)
    if removed.len() != 2_usize { ret 12_u32 }
    match removed.names().get(1_usize) { Some(name) => { if name != "Plane" { ret 13_u32 } } None => { ret 14_u32 } }
    let mut root_children = Vec[u64]::new() root_children.push(33_u64)
    let root = ActorRecord::new(1_u32, 11_u64, Option[u64]::None, root_children, "Cube", "", true,
        Vec3::zero(), Vec3::zero(), Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    let detached = removed.apply(root, false)
    match detached.parents().get(0_usize) {
        Some(parent) => { if parent.is_some() { ret 19_u32 } }
        None => { ret 20_u32 }
    }
    let restored_parent = detached.apply(root, true)
    match restored_parent.parents().get(1_usize) {
        Some(parent) => { if parent != Option[u64]::Some(11_u64) { ret 21_u32 } }
        None => { ret 22_u32 }
    }
    ret 0_u32
}
