import graphene::{action_needs_confirmation, guard_editor_action, guarded_action}

fn main() -> u32 {
    if guard_editor_action("exit", false) != "exit" { ret 1_u32 }
    let guarded = guard_editor_action("open", true)
    if guarded != "confirm:open" || !action_needs_confirmation(guarded) { ret 2_u32 }
    if guarded_action(guarded) != "open" { ret 3_u32 }
    if action_needs_confirmation("new") || guarded_action("exit") != "exit" { ret 4_u32 }
    ret 0_u32
}
