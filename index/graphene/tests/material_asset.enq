import core::option::Option
import graphene::{StandardMaterial, edit_default_material, material_asset_parse, material_asset_stringify}
import linalg::Vec3

fn main() -> u32 {
    let source = StandardMaterial::new(Vec3::new(0.12_f32, 0.48_f32, 0.91_f32), 0.7_f32, 0.25_f32).with_unlit()
    match material_asset_parse(material_asset_stringify(source)) {
        Option::Some(decoded) => {
            if decoded.base_color().x() < 0.119_f32 || decoded.base_color().x() > 0.121_f32 ||
                decoded.base_color().y() < 0.479_f32 || decoded.base_color().y() > 0.481_f32 ||
                decoded.base_color().z() < 0.909_f32 || decoded.base_color().z() > 0.911_f32 ||
                decoded.metallic() < 0.699_f32 || decoded.metallic() > 0.701_f32 ||
                decoded.roughness() < 0.249_f32 || decoded.roughness() > 0.251_f32 || !decoded.unlit() { ret 1_u32 }
        }
        Option::None => { ret 2_u32 }
    }
    if material_asset_parse("{\"format\":\"other\",\"version\":1}").is_some() { ret 3_u32 }
    if material_asset_parse("{\"format\":\"graphene-material\",\"version\":1,\"base_color\":[1,2],\"metallic\":0,\"roughness\":1}").is_some() { ret 4_u32 }
    let edited = edit_default_material(edit_default_material(source, "material-metallic-plus"), "material-color-gold")
    if edited.metallic() < 0.799_f32 || edited.metallic() > 0.801_f32 || edited.base_color().x() != 0.78_f32 { ret 5_u32 }
    let reset = edit_default_material(edited, "material-reset")
    if reset.metallic() != 0.08_f32 || reset.roughness() != 0.48_f32 || reset.unlit() { ret 6_u32 }
    ret 0_u32
}
