import core::io::println
import core::option::Option
import core::vec::Vec
import graphene::{GpuBuffer, GraphicsInstance, VertexAttribute, VertexBufferLayout, buffer_index, buffer_vertex,
    depth_fragment_spirv, depth_vertex_spirv, shader_stage_fragment, shader_stage_vertex,
    vertex_format_float32x3}

fn write_vertex(buffer: GpuBuffer, offset: u64, x: f32, y: f32, z: f32,
    red: f32, green: f32, blue: f32) -> bool {
    ret buffer.write_f32(offset, x) && buffer.write_f32(offset + 4_u64, y) &&
        buffer.write_f32(offset + 8_u64, z) && buffer.write_f32(offset + 12_u64, red) &&
        buffer.write_f32(offset + 16_u64, green) && buffer.write_f32(offset + 20_u64, blue)
}

fn main() -> u32 {
    let instance = GraphicsInstance::with_window_support(true)
    if !instance.available() { println(instance.error()) ret 1_u32 }
    let window = instance.create_window("Graphene Depth Test", 960_u32, 540_u32)
    if !window.available() { println(window.error()) window.destroy() instance.destroy() ret 2_u32 }
    match instance.preferred_adapter() {
        Option::Some(adapter) => {
            let device = instance.create_present_device(adapter, window)
            let swapchain = device.create_swapchain(window)
            let vertex_shader = device.create_shader_module(depth_vertex_spirv(), shader_stage_vertex())
            let fragment_shader = device.create_shader_module(depth_fragment_spirv(), shader_stage_fragment())
            let mut attributes = Vec[VertexAttribute]::new()
            attributes.push(VertexAttribute::new(0_u32, vertex_format_float32x3(), 0_u32))
            attributes.push(VertexAttribute::new(1_u32, vertex_format_float32x3(), 12_u32))
            let pipeline = device.create_depth_render_pipeline(swapchain, vertex_shader, fragment_shader,
                VertexBufferLayout::new(24_u32, attributes))
            let vertices = device.create_buffer(144_u64, buffer_vertex(), true)
            let indices = device.create_buffer(24_u64, buffer_index(), true)
            let ready = device.available() && swapchain.available() && pipeline.available() &&
                write_vertex(vertices, 0_u64, -0.62_f32, -0.58_f32, 0.2_f32, 0.1_f32, 0.9_f32, 0.35_f32) &&
                write_vertex(vertices, 24_u64, 0.62_f32, -0.58_f32, 0.2_f32, 0.1_f32, 0.9_f32, 0.35_f32) &&
                write_vertex(vertices, 48_u64, 0.0_f32, 0.62_f32, 0.2_f32, 0.1_f32, 0.9_f32, 0.35_f32) &&
                write_vertex(vertices, 72_u64, -0.62_f32, -0.58_f32, 0.7_f32, 0.95_f32, 0.18_f32, 0.12_f32) &&
                write_vertex(vertices, 96_u64, 0.62_f32, -0.58_f32, 0.7_f32, 0.95_f32, 0.18_f32, 0.12_f32) &&
                write_vertex(vertices, 120_u64, 0.0_f32, 0.62_f32, 0.7_f32, 0.95_f32, 0.18_f32, 0.12_f32) &&
                indices.write_u32(0_u64, 0_u32) && indices.write_u32(4_u64, 1_u32) &&
                indices.write_u32(8_u64, 2_u32) && indices.write_u32(12_u64, 3_u32) &&
                indices.write_u32(16_u64, 4_u32) && indices.write_u32(20_u64, 5_u32)
            if ready {
                println("Near green triangle must occlude the far red triangle")
                while window.poll() {
                    let frame = swapchain.acquire_frame()
                    let pass = frame.begin_render_pass(pipeline, 0.035_f32, 0.05_f32, 0.07_f32, 1.0_f32)
                    let recorded = pass.available() && pass.bind_vertex_buffer(vertices) &&
                        pass.bind_index_buffer(indices) && pass.draw_indexed(6_u32) && pass.end()
                    if !recorded || !frame.present() { println(frame.error()) frame.destroy() break }
                    frame.destroy()
                }
            } else { println("Depth probe initialization failed") }
            swapchain.destroy()
            pipeline.destroy()
            vertices.destroy()
            indices.destroy()
            vertex_shader.destroy()
            fragment_shader.destroy()
            device.destroy()
        }
        Option::None => { println("No Vulkan adapter found") }
    }
    window.destroy()
    instance.destroy()
    ret 0_u32
}
