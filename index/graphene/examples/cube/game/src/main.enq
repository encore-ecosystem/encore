import core::io::println
import core::option::Option
import core::time::perf_counter_ms
import core::vec::Vec
import graphene::{BindGroupLayoutEntry, DirectionalLight, GraphicsInstance, MaterialAssets, MeshAssets,
    PerspectiveCamera, Renderable, Scene, SceneRenderer, StandardMaterial, Transform,
    RenderPipelineOptions, VertexAttribute, VertexBufferLayout, cube_fragment_spirv, cube_mesh,
    cube_vertex_spirv, key_a, key_d, key_escape, key_s, key_w, mouse_right,
    shader_stage_fragment, shader_stage_vertex, vertex_format_float32x3}
import linalg::Vec3

fn main() -> u32 {
    let instance = GraphicsInstance::with_window_support(true)
    let window = instance.create_window("Graphene 3D", 960_u32, 540_u32)
    if !instance.available() || !window.available() { println(instance.error() + window.error()) ret 1_u32 }
    match instance.preferred_adapter() {
        Option::Some(adapter) => {
            let device = instance.create_present_device(adapter, window)
            let swapchain = device.create_swapchain(window)
            let vertex_shader = device.create_shader_module(cube_vertex_spirv(), shader_stage_vertex())
            let fragment_shader = device.create_shader_module(cube_fragment_spirv(), shader_stage_fragment())
            let mut attributes = Vec[VertexAttribute]::new()
            attributes.push(VertexAttribute::new(0_u32, vertex_format_float32x3(), 0_u32))
            attributes.push(VertexAttribute::new(1_u32, vertex_format_float32x3(), 12_u32))
            attributes.push(VertexAttribute::new(2_u32, vertex_format_float32x3(), 24_u32))
            let mut entries = Vec[BindGroupLayoutEntry]::new()
            entries.push(BindGroupLayoutEntry::uniform(0_u32, shader_stage_vertex() | shader_stage_fragment()))
            let layout = device.create_bind_group_layout(entries)
            let pipeline = device.create_render_pipeline_with_options(swapchain, vertex_shader, fragment_shader,
                VertexBufferLayout::new(36_u32, attributes), layout,
                RenderPipelineOptions::depth().with_backface_culling())
            let cube = cube_mesh(1.4_f32)
            let mut meshes = MeshAssets::new()
            let mesh_id = meshes.upload(device, cube)
            let mut materials = MaterialAssets::new()
            let root_material = materials.add(StandardMaterial::new(Vec3::new(0.92_f32, 0.96_f32, 1.0_f32),
                0.0_f32, 0.35_f32))
            let child_material = materials.add(StandardMaterial::new(Vec3::new(1.0_f32, 0.48_f32, 0.24_f32),
                0.15_f32, 0.7_f32))
            let mut renderer = SceneRenderer::create(device, layout, swapchain.frames_in_flight())
            if device.available() && swapchain.available() && swapchain.frames_in_flight() == 2_u32 && pipeline.available() &&
                renderer.available() && meshes.contains(mesh_id) &&
                materials.get(root_material).is_some() && materials.get(child_material).is_some() {
                let target = Vec3::zero()
                let light = DirectionalLight::new(Vec3::new(-0.45_f32, -0.8_f32, -0.35_f32),
                    Vec3::new(1.0_f32, 0.96_f32, 0.88_f32), 0.95_f32)
                let mut scene = Scene::new()
                let root = scene.create_entity("Root cube", Transform::identity())
                let child = scene.create_entity("Child cube", Transform::new(Vec3::new(1.7_f32, 0.0_f32, 0.0_f32),
                    Vec3::zero(), Vec3::new(0.55_f32, 0.55_f32, 0.55_f32)))
                scene.set_parent(child, Option[u64]::Some(root))
                scene.set_renderable(root,
                    Option[Renderable]::Some(Renderable::new(mesh_id, root_material)))
                scene.set_renderable(child,
                    Option[Renderable]::Some(Renderable::new(mesh_id, child_material)))
                let mut yaw = 0.0_f32
                let mut pitch = 0.32_f32
                let mut distance = 4.2_f32
                let started = perf_counter_ms()
                let mut previous = started
                while window.poll() {
                    let now = perf_counter_ms()
                    let delta = ((now - previous) as f32) * 0.001_f32
                    previous = now
                    if window.key_down(key_escape()) { break }
                    if window.key_down(key_a()) { yaw = yaw - delta * 1.5_f32 }
                    if window.key_down(key_d()) { yaw = yaw + delta * 1.5_f32 }
                    if window.key_down(key_w()) { distance = distance - delta * 2.0_f32 }
                    if window.key_down(key_s()) { distance = distance + delta * 2.0_f32 }
                    if window.mouse_down(mouse_right()) {
                        yaw = yaw + window.mouse_dx() * 0.006_f32
                        pitch = pitch + window.mouse_dy() * 0.006_f32
                    }
                    if pitch > 1.35_f32 { pitch = 1.35_f32 }
                    if pitch < -1.35_f32 { pitch = -1.35_f32 }
                    if distance < 1.8_f32 { distance = 1.8_f32 }
                    if distance > 12.0_f32 { distance = 12.0_f32 }
                    let camera = PerspectiveCamera::new(target.add(Vec3::from_spherical(yaw, pitch).scale(distance)),
                        target, 1.0471976_f32, 0.1_f32, 100.0_f32)
                    let frame = swapchain.acquire_frame()
                    if !frame.available() { println(frame.error()) frame.destroy() break }
                    let seconds = ((perf_counter_ms() - started) as f32) * 0.001_f32
                    scene.set_transform(root, Transform::identity()
                        .with_position(Vec3::new(-0.55_f32, 0.0_f32, 0.0_f32))
                        .with_rotation(Vec3::new(seconds * 0.35_f32, seconds, 0.0_f32)))
                    let aspect = (swapchain.width() as f32) / (swapchain.height() as f32)
                    let pass = frame.begin_render_pass(pipeline, 0.025_f32, 0.04_f32, 0.06_f32, 1.0_f32)
                    let recorded = renderer.render_scene(scene, camera, light, meshes, materials,
                        pass, frame.slot(), aspect) && pass.end()
                    if !recorded || !frame.present() { println(frame.error()) frame.destroy() break }
                    frame.destroy()
                }
            } else { println("Cube initialization failed") }
            swapchain.destroy() pipeline.destroy() renderer.destroy() layout.destroy()
            meshes.destroy()
            vertex_shader.destroy() fragment_shader.destroy() device.destroy()
        }
        Option::None => { println("No Vulkan adapter found") }
    }
    window.destroy() instance.destroy()
    ret 0_u32
}
