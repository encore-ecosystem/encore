import core::io::println
import core::option::Option
import core::vec::Vec
import graphene::{BindGroupLayoutEntry, GraphicsInstance, RenderPipelineOptions, VertexAttribute, VertexBufferLayout,
    buffer_index, buffer_transfer_source, buffer_uniform, buffer_vertex, format_rgba8_unorm,
    shader_stage_fragment, shader_stage_vertex, triangle_fragment_spirv, triangle_vertex_spirv,
    texture_layout_shader_read, texture_layout_transfer_destination, texture_sampled,
    texture_transfer_destination, vertex_format_float32x2, vertex_format_float32x3}

fn main() -> u32 {
    let instance = GraphicsInstance::with_window_support(true)
    if !instance.available() {
        println("Graphene RHI unavailable: " + instance.error())
        instance.destroy()
        ret 1_u32
    }
    let window = instance.create_window("Graphene Vulkan", 960_u32, 540_u32)
    if !window.available() {
        println("Window error: " + window.error())
        window.destroy()
        instance.destroy()
        ret 2_u32
    }
    window.poll()
    match instance.preferred_adapter() {
        Option::Some(adapter) => {
            let device = instance.create_present_device(adapter, window)
            if !device.available() {
                println("Device error: " + device.error())
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 3_u32
            }
            let vertex_shader = device.create_shader_module(triangle_vertex_spirv(), shader_stage_vertex())
            let fragment_shader = device.create_shader_module(triangle_fragment_spirv(), shader_stage_fragment())
            if !vertex_shader.available() || !fragment_shader.available() {
                println("Shader error: " + if !vertex_shader.available() { vertex_shader.error() } else { fragment_shader.error() })
                vertex_shader.destroy()
                fragment_shader.destroy()
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 5_u32
            }
            let swapchain = device.create_swapchain(window)
            if !swapchain.available() {
                println("Swapchain error: " + swapchain.error())
                swapchain.destroy()
                vertex_shader.destroy()
                fragment_shader.destroy()
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 4_u32
            }
            let mut attributes = Vec[VertexAttribute]::new()
            attributes.push(VertexAttribute::new(0_u32, vertex_format_float32x2(), 0_u32))
            attributes.push(VertexAttribute::new(1_u32, vertex_format_float32x3(), 8_u32))
            let mut bindings = Vec[BindGroupLayoutEntry]::new()
            bindings.push(BindGroupLayoutEntry::uniform(0_u32, shader_stage_vertex()))
            bindings.push(BindGroupLayoutEntry::texture_sampler(1_u32, shader_stage_fragment()))
            let bind_group_layout = device.create_bind_group_layout(bindings)
            let pipeline = device.create_render_pipeline_with_options(swapchain, vertex_shader, fragment_shader,
                VertexBufferLayout::new(20_u32, attributes), bind_group_layout,
                RenderPipelineOptions::opaque().with_alpha_blending())
            if !bind_group_layout.available() || !pipeline.available() {
                println("Pipeline error: " + if !bind_group_layout.available() { bind_group_layout.error() } else { pipeline.error() })
                swapchain.destroy()
                pipeline.destroy()
                bind_group_layout.destroy()
                vertex_shader.destroy()
                fragment_shader.destroy()
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 6_u32
            }
            let vertices = device.create_buffer(60_u64, buffer_vertex(), true)
            let indices = device.create_buffer(12_u64, buffer_index(), true)
            let transform = device.create_buffer(16_u64, buffer_uniform(), true)
            let uploaded = vertices.available() && indices.available() && transform.available() &&
                vertices.write_f32(0_u64, 0.0_f32) && vertices.write_f32(4_u64, -0.62_f32) &&
                vertices.write_f32(8_u64, 0.15_f32) && vertices.write_f32(12_u64, 0.78_f32) && vertices.write_f32(16_u64, 1.0_f32) &&
                vertices.write_f32(20_u64, 0.62_f32) && vertices.write_f32(24_u64, 0.48_f32) &&
                vertices.write_f32(28_u64, 0.98_f32) && vertices.write_f32(32_u64, 0.33_f32) && vertices.write_f32(36_u64, 0.47_f32) &&
                vertices.write_f32(40_u64, -0.62_f32) && vertices.write_f32(44_u64, 0.48_f32) &&
                vertices.write_f32(48_u64, 0.42_f32) && vertices.write_f32(52_u64, 0.93_f32) && vertices.write_f32(56_u64, 0.55_f32) &&
                indices.write_u32(0_u64, 0_u32) && indices.write_u32(4_u64, 1_u32) && indices.write_u32(8_u64, 2_u32) &&
                transform.write_f32(0_u64, 0.8660254_f32) && transform.write_f32(4_u64, 0.5_f32) &&
                transform.write_f32(8_u64, 0.08_f32) && transform.write_f32(12_u64, -0.03_f32)
            if !uploaded {
                println("Unable to upload triangle geometry")
                swapchain.destroy()
                pipeline.destroy()
                bind_group_layout.destroy()
                vertices.destroy()
                indices.destroy()
                transform.destroy()
                vertex_shader.destroy()
                fragment_shader.destroy()
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 7_u32
            }
            let staging = device.create_buffer(16_u64, buffer_transfer_source(), true)
            let texture = device.create_texture_2d(2_u32, 2_u32, 1_u32, format_rgba8_unorm(),
                texture_sampled() | texture_transfer_destination())
            let sampler = device.create_sampler()
            let texture_upload = device.create_encoder()
            let texture_ready = staging.available() && texture.available() && sampler.available() &&
                staging.write_u32(0_u64, 4282409215_u32) && staging.write_u32(4_u64, 1090466047_u32) &&
                staging.write_u32(8_u64, 1078001663_u32) && staging.write_u32(12_u64, 4294967295_u32) &&
                texture_upload.transition_texture(texture, texture_layout_transfer_destination()) &&
                texture_upload.copy_buffer_to_texture(staging, texture, 2_u32, 2_u32, 0_u32) &&
                texture_upload.transition_texture(texture, texture_layout_shader_read()) &&
                texture_upload.submit_and_wait()
            texture_upload.destroy()
            staging.destroy()
            if !texture_ready {
                println("Unable to upload material texture")
                swapchain.destroy()
                pipeline.destroy()
                bind_group_layout.destroy()
                sampler.destroy()
                texture.destroy()
                vertices.destroy()
                indices.destroy()
                transform.destroy()
                vertex_shader.destroy()
                fragment_shader.destroy()
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 8_u32
            }
            let bind_group = device.create_material_bind_group(bind_group_layout, 0_u32, transform,
                0_u64, 16_u64, 1_u32, texture, sampler)
            if !bind_group.available() {
                println("Bind group error: " + bind_group.error())
                swapchain.destroy()
                pipeline.destroy()
                bind_group.destroy()
                bind_group_layout.destroy()
                sampler.destroy()
                texture.destroy()
                vertices.destroy()
                indices.destroy()
                transform.destroy()
                vertex_shader.destroy()
                fragment_shader.destroy()
                device.destroy()
                window.destroy()
                instance.destroy()
                ret 9_u32
            }
            println("Presenting " + adapter.name())
            while window.poll() {
                let frame = swapchain.acquire_frame()
                if !frame.available() {
                    println("Frame acquire error: " + frame.error())
                    frame.destroy()
                    break
                }
                let pass = frame.begin_render_pass(pipeline, 0.035_f32, 0.055_f32, 0.075_f32, 1.0_f32)
                let recorded = pass.available() && pass.bind_group(bind_group) &&
                    pass.bind_vertex_buffer(vertices) && pass.bind_index_buffer(indices) &&
                    pass.draw_indexed(3_u32) && pass.end()
                if !recorded || !frame.present() {
                    println("Frame error: " + frame.error())
                    frame.destroy()
                    break
                }
                frame.destroy()
            }
            swapchain.destroy()
            pipeline.destroy()
            bind_group.destroy()
            bind_group_layout.destroy()
            sampler.destroy()
            texture.destroy()
            vertices.destroy()
            indices.destroy()
            transform.destroy()
            vertex_shader.destroy()
            fragment_shader.destroy()
            device.destroy()
        }
        Option::None => { println("No Vulkan adapter found") }
    }
    window.destroy()
    instance.destroy()
    ret 0_u32
}
