import core::fmt::Debug
import core::io::println
import core::option::Option
import graphene::GraphicsInstance

fn main() -> u32 {
    let instance = GraphicsInstance::with_debug(true)
    if !instance.available() {
        println("Graphene RHI unavailable: " + instance.error())
        instance.destroy()
        ret 1_u32
    }
    let api = instance.api_version()
    println("Vulkan loader " + api.major().fmt() + "." + api.minor().fmt() + "." + api.patch().fmt())
    match instance.preferred_adapter() {
        Option::Some(adapter) => {
            let version = adapter.api_version()
            let capabilities = adapter.capabilities()
            println("Adapter: " + adapter.name())
            println("API: " + version.major().fmt() + "." + version.minor().fmt() + "." + version.patch().fmt())
            println("Graphene tier: " + capabilities.tier().fmt())
            println("Ray query: " + capabilities.ray_query().fmt())
            println("Ray pipeline: " + capabilities.ray_pipeline().fmt())
            println("Mesh shader: " + capabilities.mesh_shader().fmt())
            let device = instance.create_device(adapter)
            if !device.available() {
                println("Device error: " + device.error())
                device.destroy()
                instance.destroy()
                ret 3_u32
            }
            println("Graphics queue family: " + device.queue_family().fmt())
            println("Compute on graphics queue: " + device.compute().fmt())
            let encoder = device.create_encoder()
            if !encoder.available() || !encoder.submit_and_wait() {
                println("Command submission error: " + encoder.error())
                encoder.destroy()
                device.destroy()
                instance.destroy()
                ret 4_u32
            }
            println("Empty command buffer submitted successfully")
            encoder.destroy()
            device.destroy()
        }
        Option::None => {
            println("No Vulkan adapter found")
            instance.destroy()
            ret 2_u32
        }
    }
    instance.destroy()
    ret 0_u32
}
