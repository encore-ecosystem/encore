import core::option::Option
import core::os::{file_exists, mkdir_all, read_dir, read_file, write_file}
import core::result::Result
import core::vec::Vec
import mod::scene::obj::parse_obj
import mod::scene::primitive::MeshData

pub struct ImportedMeshAsset { name: str source_path: str project_path: str mesh: MeshData }

impl for ImportedMeshAsset {
    pub fn name(self: Self) -> str { ret self.name }
    pub fn source_path(self: Self) -> str { ret self.source_path }
    pub fn project_path(self: Self) -> str { ret self.project_path }
    pub fn mesh(self: Self) -> MeshData { ret self.mesh }
}

fn asset_file_name(path: str) -> str {
    let mut index = path.byte_len()
    while index > 0_usize {
        let byte = path.byte_at(index - 1_usize)
        if byte == 47_u8 || byte == 92_u8 { ret path.slice(index, path.byte_len() - index) }
        index = index - 1_usize
    }
    ret path
}

fn asset_is_obj(path: str) -> bool {
    if path.byte_len() < 4_usize { ret false }
    let extension = path.slice(path.byte_len() - 4_usize, 4_usize)
    ret extension == ".obj" || extension == ".OBJ"
}

pub fn project_mesh_directory(project_root: str) -> str { ret project_root + "/Content/Meshes" }

pub fn load_obj_asset(path: str) -> Result[ImportedMeshAsset, str] {
    if !file_exists(path) { ret Result[ImportedMeshAsset, str]::Err("Mesh file does not exist: " + path) }
    if !asset_is_obj(path) { ret Result[ImportedMeshAsset, str]::Err("Only .obj mesh files are supported") }
    match parse_obj(read_file(path)) {
        Result::Ok(mesh) => { ret Result[ImportedMeshAsset, str]::Ok(ImportedMeshAsset { asset_file_name(path), path, path, mesh }) }
        Result::Err(message) => { ret Result[ImportedMeshAsset, str]::Err("Unable to import " + path + ": " + message) }
    }
}

pub fn import_obj_asset(project_root: str, source_path: str) -> Result[ImportedMeshAsset, str] {
    match load_obj_asset(source_path) {
        Result::Ok(asset) => {
            let directory = project_mesh_directory(project_root)
            if mkdir_all(directory) != 0_i32 { ret Result[ImportedMeshAsset, str]::Err("Unable to create " + directory) }
            let destination = directory + "/" + asset.name()
            if write_file(destination, read_file(source_path)) != 0_i32 {
                ret Result[ImportedMeshAsset, str]::Err("Unable to write imported mesh: " + destination)
            }
            ret Result[ImportedMeshAsset, str]::Ok(ImportedMeshAsset { asset.name(), source_path, destination, asset.mesh() })
        }
        Result::Err(message) => { ret Result[ImportedMeshAsset, str]::Err(message) }
    }
}

pub fn discover_obj_assets(project_root: str) -> Vec[ImportedMeshAsset] {
    let mut out = Vec[ImportedMeshAsset]::new()
    let directory = project_mesh_directory(project_root)
    for name in read_dir(directory) {
        let path = directory + "/" + name
        if asset_is_obj(path) {
            match load_obj_asset(path) {
                Result::Ok(asset) => { out.push(asset) }
                Result::Err(_) => {}
            }
        }
    }
    ret out
}

pub fn add_actor_mesh_name(target: str, assets: Vec[ImportedMeshAsset]) -> Option[str] {
    if target == "add-actor-cube" { ret Option[str]::Some("") }
    if target == "add-actor-plane" { ret Option[str]::Some("@plane") }
    if target == "add-actor-sphere" { ret Option[str]::Some("@sphere") }
    let mut index = 0_usize
    while index < assets.len() {
        if target == "add-actor-imported-" + index.fmt() {
            match assets.get(index) {
                Option::Some(asset) => { ret Option[str]::Some(asset.name()) }
                Option::None => {}
            }
        }
        index = index + 1_usize
    }
    ret Option[str]::None
}
