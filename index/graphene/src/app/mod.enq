import gui_core::color::Color
import gui_core::geometry::Rect
import gui_core::window::WindowDesc
import gui_native::window::Window

pub struct AppConfig {
    title: str
    width: u32
    height: u32
    clear_color: Color
}

pub struct App {
    window: Window
    clear_color: Color
    frame: usize
}

impl for AppConfig {
    pub fn new(title: str, width: u32, height: u32) -> AppConfig {
        ret AppConfig { title, width, height, Color::rgb(18_u32, 24_u32, 32_u32) }
    }

    pub fn with_clear_color(self: mut Self, color: Color) -> Self {
        self.clear_color = color
        ret self
    }
}

impl for App {
    pub fn open(config: AppConfig) -> App {
        let desc = WindowDesc::new(config.title, config.width, config.height)
        ret App { Window::open(desc), config.clear_color, 0_usize }
    }

    pub fn is_ready(self: Self) -> bool {
        ret self.window.is_valid()
    }

    pub fn frame(self: Self) -> usize {
        ret self.frame
    }

    pub fn begin_frame(self: mut Self) -> bool {
        if !self.window.poll() {
            ret false
        }
        ret self.window.clear(self.clear_color)
    }

    pub fn draw_rect(self: Self, rect: Rect, color: Color) -> bool {
        ret self.window.fill_rect(rect, color)
    }

    pub fn end_frame(self: mut Self) -> bool {
        if !self.window.present() {
            ret false
        }
        self.frame = self.frame + 1_usize
        ret true
    }

    pub fn close(self: mut Self) -> bool {
        ret self.window.close()
    }
}
