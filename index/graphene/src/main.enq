fn viewport_toggle_readout(id: str, text: str, icon: SvgDocument, width: f32, active: bool, hovered: bool) -> Widget {
    let background = if active { Color::rgb(27_u8, 67_u8, 92_u8) } else { interactive_background(hovered) }
    let border = if active { Color::rgb(37_u8, 114_u8, 162_u8) } else { interactive_border(hovered) }
    let mut readout = Widget::panel(id).with_direction(horizontal()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(background).with_border(1.0_f32, border).with_radius(2.0_f32)
            .with_padding(Insets::symmetric(3.0_f32, 5.0_f32)).with_gap(3.0_f32))
    readout.push(Widget::icon("", icon).with_flex(15.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(if active { Color::rgb(113_u8, 190_u8, 231_u8) } else { Color::rgb(139_u8, 142_u8, 149_u8) })
            .with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    readout.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(204_u8, 207_u8, 212_u8)).with_font_family("Roboto Mono")
            .with_font_size(9.0_f32).with_pointer_events(false)))
    ret readout
}

