    width: f32, height: f32) -> Widget {
    let mut root = Widget::panel("project-browser").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(13_u8, 14_u8, 17_u8)).with_foreground(Color::rgb(220_u8, 222_u8, 226_u8))
            .with_font_family("Roboto").with_padding(Insets::all(24.0_f32)).with_gap(14.0_f32))
    let mut brand = Widget::panel("project-browser-brand").with_direction(horizontal()).with_flex(72.0_f32, 0.0_f32).with_style(Style::default().with_gap(12.0_f32))
    brand.push(Widget::icon("", icons.brand).with_flex(52.0_f32, 0.0_f32).with_style(Style::default().with_foreground(theme_accent()).with_pointer_events(false)))
    brand.push(Widget::heading("GRAPHENE").with_flex(190.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(239_u8, 240_u8, 243_u8)).with_font_size(25.0_f32).with_font_weight(700_u32).with_pointer_events(false)))
    brand.push(Widget::spacer(1.0_f32))
    if mode != "home" { brand.push(Widget::button("browser-back", "Back to Projects").with_flex(130.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(34_u8, 36_u8, 41_u8)).with_foreground(Color::rgb(218_u8, 221_u8, 226_u8))
            .with_border(1.0_f32, Color::rgb(60_u8, 63_u8, 70_u8)).with_radius(4.0_f32))) }
    root.push(brand)
    if mode == "home" {
        let mut hero = Widget::panel("browser-hero").with_direction(vertical()).with_flex(160.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(19_u8, 20_u8, 24_u8)).with_border(1.0_f32, Color::rgb(43_u8, 45_u8, 51_u8))
                .with_radius(5.0_f32).with_padding(Insets::all(20.0_f32)).with_gap(9.0_f32))
        hero.push(Widget::icon("", icons.brand).with_flex(66.0_f32, 0.0_f32).with_style(Style::default().with_foreground(theme_accent()).with_pointer_events(false)))
        hero.push(Widget::label("Build worlds with Graphene").with_flex(28.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(235_u8, 236_u8, 239_u8)).with_font_size(17.0_f32).with_font_weight(600_u32).with_pointer_events(false)))
        let mut actions = Widget::panel("browser-actions").with_direction(horizontal()).with_flex(38.0_f32, 0.0_f32).with_style(Style::default().with_gap(8.0_f32))
        actions.push(Widget::icon_button("browser-new", "New Project", icons.add).with_flex(132.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(24_u8, 119_u8, 177_u8)).with_foreground(Color::rgb(246_u8, 248_u8, 250_u8))
                .with_border(1.0_f32, Color::rgb(52_u8, 151_u8, 208_u8)).with_radius(4.0_f32)))
        actions.push(Widget::icon_button("browser-open", "Open Project", icons.folder).with_flex(132.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(35_u8, 37_u8, 42_u8)).with_foreground(Color::rgb(224_u8, 226_u8, 230_u8))
                .with_border(1.0_f32, Color::rgb(64_u8, 67_u8, 74_u8)).with_radius(4.0_f32)))
        hero.push(actions)
        root.push(hero)
        root.push(Widget::label("RECENT PROJECTS").with_flex(24.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(137_u8, 140_u8, 148_u8)).with_font_size(9.0_f32).with_font_weight(700_u32)))
        let mut cards = Widget::panel("recent-projects").with_direction(horizontal()).with_flex(190.0_f32, 0.0_f32).with_style(
            Style::default().with_gap(10.0_f32).with_align(align_start()).with_overflow_hidden(true))
        let recent = recent_projects()
        let mut index = 0_usize
        while index < recent.len() {
            match recent.get(index) { Option::Some(path) => { cards.push(project_card("recent-project-" + index.fmt(), path, hovered, icons)) } Option::None => {} }
            index = index + 1_usize
        }
        if recent.len() == 0_usize { cards.push(Widget::label("No recent projects").with_style(Style::default().with_foreground(Color::rgb(112_u8, 115_u8, 123_u8)))) }
        root.push(cards)
    } else {
        root.push(Widget::label(if mode == "new" { "CREATE PROJECT" } else { "OPEN PROJECT" }).with_flex(25.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(225_u8, 227_u8, 231_u8)).with_font_size(12.0_f32).with_font_weight(700_u32)))
        if mode == "new" {
            let mut templates = Widget::panel("project-templates").with_direction(horizontal()).with_flex(70.0_f32, 0.0_f32).with_style(
                Style::default().with_gap(8.0_f32).with_align(align_start()))
            templates.push(project_template_card("template-empty", "Empty", "Blank scene with camera and light", icons.file, template == "empty", hovered))
            templates.push(project_template_card("template-starter", "Starter Scene", "A ready-to-edit cube scene", icons.mesh, template == "starter", hovered))
            root.push(templates)
            root.push(Widget::input("browser-project-name", name.value()).with_flex(38.0_f32, 0.0_f32).with_focus(true).with_style(
                Style::default().with_background(Color::rgb(14_u8, 15_u8, 18_u8)).with_foreground(Color::rgb(225_u8, 228_u8, 232_u8))
                    .with_border(1.0_f32, Color::rgb(55_u8, 58_u8, 65_u8)).with_radius(4.0_f32)))
        }
        root.push(picker.view(file_picker_icons(icons)))
        let mut footer = Widget::panel("browser-footer").with_direction(horizontal()).with_flex(38.0_f32, 0.0_f32).with_style(Style::default().with_gap(8.0_f32))
        footer.push(Widget::label(error).with_flex(0.0_f32, 1.0_f32).with_style(Style::default().with_foreground(Color::rgb(220_u8, 102_u8, 94_u8)).with_font_size(10.0_f32)))
        footer.push(Widget::button("browser-confirm", if mode == "new" { "Create Project" } else { "Open Project" }).with_flex(118.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(24_u8, 119_u8, 177_u8)).with_foreground(Color::rgb(246_u8, 248_u8, 250_u8))
                .with_border(1.0_f32, Color::rgb(52_u8, 151_u8, 208_u8)).with_radius(4.0_f32)))
        root.push(footer)
    }
    ret root
}

fn browse_for_project(window: Window, icons: EditorIcons) -> Option[str] {
    let mut mode = match env("GRAPHENE_BROWSER_MODE") {
        Option::Some(value) => { if value == "new" || value == "open" { value } else { "home" } }
        Option::None => { "home" }
    }
    let mut picker = FilePicker::new(home_dir())
    let mut name = TextEditor::new("GrapheneProject")
    let mut template = "empty"
    let mut focus = "name"
    let mut hovered = ""
    let mut error = ""
    let mut layout = window.layout(project_browser_view(mode, picker, name, template, hovered, error, icons,
        window.surface_width() as f32, window.surface_height() as f32))
    window.draw_layout(layout)
    while window.is_open() {
        let event = window.poll()
        if event.kind() == event_close() { ret Option[str]::None }
        let mut dirty = event.kind() == event_resize()
        if event.kind() == event_pointer_move() {
            let next_hovered = layout.hit(event.x(), event.y())
            if next_hovered != hovered { hovered = next_hovered dirty = true }
        }
        if event.kind() == event_pointer_down() {
            let target = layout.hit(event.x(), event.y())
            if target == "browser-new" { mode = "new" picker = FilePicker::new(home_dir()) template = "empty" focus = "name" error = "" }
            elif target == "browser-open" { mode = "open" picker = FilePicker::new(home_dir()) focus = "picker" error = "" }
            elif target == "browser-back" { mode = "home" error = "" }
            elif target == "template-empty" { template = "empty" }
            elif target == "template-starter" { template = "starter" }
            elif target == "browser-project-name" { focus = "name" }
            elif target == "file-picker-create-folder" { picker = picker.create_folder() focus = "picker" }
            elif target == "browser-confirm" {
                let path = if mode == "new" { picker.directory() + "/" + name.value() } else { picker.directory() }
                let ready = if mode == "new" { create_project_with_template(path, template) } else { project_valid(project_paths(path)) }
                if ready { remember_project(path) ret Option[str]::Some(path) }
                error = if mode == "new" { "Unable to create project at this location" } else { "This folder is not a Graphene project" }
            } else {
                let mut recent_index = 0_usize
                let recent = recent_projects()
                while recent_index < recent.len() {
                    if target == "recent-project-" + recent_index.fmt() {
                        match recent.get(recent_index) { Option::Some(path) => { remember_project(path) ret Option[str]::Some(path) } Option::None => {} }
                    }
                    recent_index = recent_index + 1_usize
                }
                picker = picker.click(target)
                focus = "picker"
            }
            dirty = true
        }
        if event.kind() == event_text_input() && event.text() != "" {
            if mode == "new" && focus == "name" { name = name.insert(event.text()) } else { picker = picker.input(event.text()) }
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_backspace() {
            if mode == "new" && focus == "name" { name = name.backspace() } else { picker = picker.backspace() }
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_enter() {
            if picker.creating_folder() && focus == "picker" { picker = picker.create_folder() }
            elif focus == "picker" { picker = picker.confirm_path() }
            dirty = true
        }
        if event.kind() == event_scroll() && mode != "home" { picker = picker.scroll_by(0.0_f32 - event.wheel_y() * 24.0_f32) dirty = true }
        if dirty {
            layout = window.layout(project_browser_view(mode, picker, name, template, hovered, error, icons,
                window.surface_width() as f32, window.surface_height() as f32))
            window.draw_layout(layout)
        }
        if event.kind() == event_none() { sleep_ms(2_u64) }
    }
    ret Option[str]::None
}

fn launch_project_browser() -> Option[str] {
    let window = Window::create("Graphene Project Browser", 1180_u32, 760_u32)
        .with_background(Color::rgb(13_u8, 13_u8, 15_u8))
    if !window.available() {
        println("Graphene: unable to create project browser: " + backend_error())
        ret Option[str]::None
    }
    let mut font_manager = FontManager::with_bundled("../encore-ui/assets/fonts")
    font_manager.register_all(window)
    font_manager = font_manager.activate(window, "Roboto", 12.0_f32, 400_u32)
    if font_manager.error() != "" {
        println("Graphene: unable to activate Roboto: " + font_manager.error())
    }
    let icons = EditorIcons::load(IconManager::with_bundled("../encore-ui/assets/icons"))
    let project = browse_for_project(window, icons)
    window.destroy()
    ret project
}

fn dock_tab(id: str, text: str, active: bool) -> Widget {
    let background = if active { Color::rgb(35_u8, 36_u8, 40_u8) } else { Color::rgb(22_u8, 22_u8, 25_u8) }
    let mut tab = Widget::panel(id + "-surface").with_direction(vertical()).with_flex(128.0_f32, 0.0_f32).with_style(
        Style::default().with_background(background).with_border(1.0_f32, Color::rgb(48_u8, 49_u8, 54_u8))
            .with_radius(1.0_f32).with_gap(0.0_f32))
    tab.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
        Style::default().with_background(if active { Color::rgb(32_u8, 143_u8, 207_u8) } else { background })
            .with_pointer_events(false)))
    tab.push(Widget::button(id, text).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(background).with_foreground(Color::rgb(218_u8, 219_u8, 223_u8))
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
            .with_padding(Insets::symmetric(3.0_f32, 8.0_f32)).with_font_size(10.0_f32)
            .with_font_weight(if active { 600_u32 } else { 400_u32 })))
    ret tab
}

fn active_icon_tab(id: str, text: str, icon: SvgDocument, width: f32) -> Widget {
    let mut tab = Widget::panel(id + "-surface").with_direction(vertical()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(35_u8, 36_u8, 40_u8))
            .with_border(1.0_f32, Color::rgb(48_u8, 49_u8, 54_u8)).with_radius(1.0_f32).with_gap(0.0_f32))
    tab.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(32_u8, 143_u8, 207_u8)).with_pointer_events(false)))
    tab.push(Widget::icon_button(id, text, icon).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(35_u8, 36_u8, 40_u8)).with_foreground(Color::rgb(220_u8, 222_u8, 226_u8))
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
            .with_padding(Insets::symmetric(3.0_f32, 8.0_f32)).with_font_size(10.0_f32).with_font_weight(600_u32)))
    ret tab
}

fn property_value(text: str, axis: str) -> Widget {
    let axis_color = if axis == "X" { Color::rgb(178_u8, 58_u8, 63_u8) } else {
        if axis == "Y" { Color::rgb(67_u8, 148_u8, 82_u8) } else { Color::rgb(54_u8, 112_u8, 180_u8) }
    }
    let mut field = Widget::panel("property-" + axis + "-" + text).with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(14_u8, 14_u8, 16_u8)).with_border(1.0_f32, Color::rgb(48_u8, 49_u8, 54_u8))
            .with_radius(2.0_f32).with_padding(Insets::symmetric(2.0_f32, 4.0_f32)).with_gap(4.0_f32))
    field.push(Widget::label(axis).with_flex(15.0_f32, 0.0_f32).with_style(
        Style::default().with_background(axis_color).with_foreground(Color::rgb(248_u8, 248_u8, 249_u8))
            .with_radius(2.0_f32).with_font_size(9.0_f32).with_font_weight(700_u32)))
    field.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(211_u8, 212_u8, 216_u8))
            .with_font_family("Roboto Mono").with_font_size(9.0_f32)))
    ret field
}

fn transform_scalar(value: f32) -> str {
    let negative = value < 0.0_f32
    let magnitude = if negative { -value } else { value }
    let scaled = (magnitude * 1000.0_f32 + 0.5_f32) as u32
    let whole = scaled / 1000_u32
    let fraction = scaled % 1000_u32
    let padding = if fraction < 10_u32 { "00" } else { if fraction < 100_u32 { "0" } else { "" } }
    let sign = if negative { "-" } else { "" }
    ret sign + Debug::fmt(whole) + "." + padding + Debug::fmt(fraction)
}

fn snap_scalar(value: f32, step: f32) -> f32 {
    if step <= 0.0_f32 { ret value }
    let scaled = value / step
    let rounded = if scaled < 0.0_f32 { (scaled - 0.5_f32) as i32 } else { (scaled + 0.5_f32) as i32 }
    ret (rounded as f32) * step
}

fn transform_property(name: str, value: Vec3) -> Widget {
    let display = if name == "Rotation" { value.scale(57.29578_f32) } else { value }
    let mut row = Widget::panel("transform-" + name).with_direction(horizontal()).with_flex(30.0_f32, 0.0_f32).with_style(
        Style::default().with_gap(4.0_f32).with_padding(Insets::symmetric(2.0_f32, 0.0_f32)))
    row.push(Widget::label(name).with_flex(58.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(181_u8, 183_u8, 188_u8)).with_font_size(10.0_f32)))
    row.push(property_value(transform_scalar(display.x()), "X"))
    row.push(property_value(transform_scalar(display.y()), "Y"))
    row.push(property_value(transform_scalar(display.z()), "Z"))
    ret row
}

fn interactive_background(hovered: bool) -> Color {
    ret if hovered { theme_control_hover() } else { theme_control() }
}

fn interactive_border(hovered: bool) -> Color {
    ret if hovered { theme_border_hover() } else { theme_border() }
}

fn control_style(active: bool, hovered: bool) -> Style {
    let background = if active { Color::rgb(0_u8, 112_u8, 184_u8) } else {
        interactive_background(hovered)
    }
    let border = if active { Color::rgb(22_u8, 136_u8, 212_u8) } else { interactive_border(hovered) }
    ret Style::default().with_background(background).with_foreground(Color::rgb(232_u8, 233_u8, 236_u8))
        .with_border(1.0_f32, border).with_radius(2.0_f32)
        .with_padding(Insets::symmetric(5.0_f32, 9.0_f32)).with_font_size(11.0_f32)
}

fn compact_icon_style(hovered: bool) -> Style {
    ret Style::default().with_background(interactive_background(hovered))
        .with_foreground(Color::rgb(191_u8, 194_u8, 200_u8)).with_border(1.0_f32, interactive_border(hovered))
        .with_radius(2.0_f32).with_padding(Insets::all(5.0_f32))
}

fn segmented_icon_style(active: bool, hovered: bool) -> Style {
    let background = if active { Color::rgb(0_u8, 112_u8, 184_u8) } else { interactive_background(hovered) }
    ret Style::default().with_background(background).with_foreground(Color::rgb(222_u8, 224_u8, 228_u8))
        .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32).with_padding(Insets::all(5.0_f32))
}

fn segmented_group() -> Widget {
    ret Widget::panel("").with_direction(horizontal()).with_flex(124.0_f32, 0.0_f32).with_style(
        Style::default().with_background(theme_control()).with_border(1.0_f32, theme_border()).with_radius(2.0_f32)
            .with_padding(Insets::all(1.0_f32)).with_gap(1.0_f32).with_overflow_hidden(true))
}

fn toolbar_action_group(width: f32) -> Widget {
    ret Widget::panel("").with_direction(horizontal()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(theme_control()).with_border(1.0_f32, theme_border()).with_radius(2.0_f32)
            .with_padding(Insets::all(1.0_f32)).with_gap(1.0_f32).with_overflow_hidden(true))
}

fn selector_control(id: str, text: str, icon: SvgDocument, chevron: SvgDocument, width: f32, hovered: bool) -> Widget {
    let mut control = Widget::panel(id).with_direction(horizontal()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(interactive_background(hovered)).with_border(1.0_f32, interactive_border(hovered))
            .with_radius(2.0_f32).with_padding(Insets::symmetric(4.0_f32, 6.0_f32)).with_gap(4.0_f32))
    control.push(Widget::icon("", icon).with_flex(15.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(190_u8, 193_u8, 199_u8)).with_padding(Insets::all(2.0_f32))
            .with_pointer_events(false)))
    control.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(224_u8, 226_u8, 230_u8)).with_font_size(10.0_f32)
            .with_pointer_events(false)))
    control.push(Widget::icon("", chevron).with_flex(12.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(124_u8, 127_u8, 134_u8)).with_padding(Insets::all(2.0_f32))
            .with_pointer_events(false)))
    ret control
}

fn camera_mode_name(mode: str) -> str {
    if mode == "top" { ret "Top" }
    if mode == "front" { ret "Front" }
    if mode == "right" { ret "Right" }
    ret "Perspective"
}

fn shading_mode_name(mode: str) -> str { ret if mode == "unlit" { "Unlit" } else { "Lit" } }

fn camera_speed_name(mode: str) -> str {
    if mode == "0.25" { ret "0.25x" }
    if mode == "0.5" { ret "0.5x" }
    if mode == "2" { ret "2.0x" }
    if mode == "4" { ret "4.0x" }
    ret "1.0x"
}

fn camera_speed_value(mode: str) -> f32 {
    if mode == "0.25" { ret 0.25_f32 }
    if mode == "0.5" { ret 0.5_f32 }
    if mode == "2" { ret 2.0_f32 }
    if mode == "4" { ret 4.0_f32 }
    ret 1.0_f32
}

fn camera_option(id: str, text: str, mode: str, active_mode: str, hovered: str, icons: EditorIcons) -> Widget {
    ret Widget::icon_button(id, text, icons.view).with_flex(if mode == "perspective" { 108.0_f32 } else { 72.0_f32 }, 0.0_f32)
        .with_style(control_style(mode == active_mode, hovered == id))
}

fn viewport_camera_strip(mode: str, hovered: str, icons: EditorIcons) -> Widget {
    let mut strip = Widget::panel("viewport-camera-menu").with_direction(horizontal()).with_flex(34.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(17_u8, 18_u8, 21_u8)).with_border(1.0_f32, theme_border())
            .with_padding(Insets::symmetric(3.0_f32, 6.0_f32)).with_gap(4.0_f32))
    strip.push(Widget::label("CAMERA").with_flex(54.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(112_u8, 115_u8, 122_u8)).with_font_size(8.0_f32)
            .with_font_weight(700_u32).with_pointer_events(false)))
    strip.push(camera_option("camera-perspective", "Perspective", "perspective", mode, hovered, icons))
    strip.push(camera_option("camera-top", "Top", "top", mode, hovered, icons))
    strip.push(camera_option("camera-front", "Front", "front", mode, hovered, icons))
    strip.push(camera_option("camera-right", "Right", "right", mode, hovered, icons))
    strip.push(Widget::spacer(1.0_f32))
    ret strip
}

