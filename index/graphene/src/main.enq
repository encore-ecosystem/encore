struct TransformEdit {
    cube: u32
    before_position: Vec3
    before_rotation: Vec3
    before_scale: Vec3
    after_position: Vec3
    after_rotation: Vec3
    after_scale: Vec3
}

struct ProjectPaths {
    root: str
    marker: str
    scene: str
    script: str
    manifest: str
    build_log: str
    build_completion: str
}

struct ProjectContents {
    positions: Vec[Vec3]
    rotations: Vec[Vec3]
    scales: Vec[Vec3]
    actor_names: Vec[str]
    mesh_names: Vec[str]
    code: str
}

fn actor_mesh_name(kind: str) -> Option[str] {
    if kind == "cube" { ret Option[str]::Some("") }
    if kind.byte_len() > 5_usize && kind.slice(0_usize, 5_usize) == "mesh:" {
        ret Option[str]::Some(kind.slice(5_usize, kind.byte_len() - 5_usize))
    }
    ret Option[str]::None
}

fn trim_trailing_separator(path: str) -> str {
    let mut length = path.char_len()
    while length > 1_usize && (path.slice(length - 1_usize, 1_usize) == "/" || path.slice(length - 1_usize, 1_usize) == "\\") {
        length = length - 1_usize
    }
    ret path.slice(0_usize, length)
}

fn project_paths(root: str) -> ProjectPaths {
    let base = trim_trailing_separator(root)
    ret ProjectPaths { base, base + "/graphene.project", base + "/scene.graphene.json",
        base + "/game/src/main.enq", base + "/game/encore.toml", base + "/game/.graphene-build.log",
        base + "/game/.graphene-build-complete" }
}

fn project_valid(paths: ProjectPaths) -> bool {
    ret file_exists(paths.marker) && file_exists(paths.scene) && file_exists(paths.manifest) && file_exists(paths.script)
}

fn create_project_with_template(root: str, template: str) -> bool {
    let paths = project_paths(root)
    if file_exists(paths.marker) || file_exists(paths.scene) || file_exists(paths.manifest) || file_exists(paths.script) { ret false }
    if mkdir_all(paths.root + "/game/src") != 0_i32 { ret false }
    if mkdir_all(paths.root + "/Content/Meshes") != 0_i32 { ret false }
    let mut positions = Vec[Vec3]::new()
    let mut rotations = Vec[Vec3]::new()
    let mut scales = Vec[Vec3]::new()
    if template == "starter" {
        positions.push(Vec3::zero())
        rotations.push(Vec3::zero())
        scales.push(Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    }
    if write_file(paths.scene, scene_asset(positions, rotations, scales).stringify() + "\n") != 0_i32 { ret false }
    if write_file(paths.manifest, "[project]\nname = \"graphene_game\"\nversion = \"0.1.0\"\ndependencies = []\n") != 0_i32 { ret false }
    if write_file(paths.script, "fn main() -> u32 {\n    ret 0_u32\n}\n") != 0_i32 { ret false }
    ret write_file(paths.marker, "[project]\nformat = 1\nscene = \"scene.graphene.json\"\ngame = \"game/encore.toml\"\n") == 0_i32
}

fn create_project(root: str) -> bool { ret create_project_with_template(root, "empty") }

fn load_project(paths: ProjectPaths) -> Option[ProjectContents] {
    if !project_valid(paths) { ret Option[ProjectContents]::None }
    match SceneAsset::parse(read_file(paths.scene)) {
        Option::Some(asset) => {
            let mut positions = Vec[Vec3]::new()
            let mut rotations = Vec[Vec3]::new()
            let mut scales = Vec[Vec3]::new()
            let mut actor_names = Vec[str]::new()
            let mut mesh_names = Vec[str]::new()
            let mut index = 0_usize
            while index < asset.len() {
                match asset.actor(index) {
                    Option::Some(actor) => {
                        match actor_mesh_name(actor.kind()) {
                            Option::Some(mesh_name) => {
                                positions.push(actor.transform().position())
                                rotations.push(actor.transform().rotation())
                                scales.push(actor.transform().scale())
                                actor_names.push(actor.name())
                                mesh_names.push(mesh_name)
                            }
                            Option::None => {}
                        }
                    }
                    Option::None => {}
                }
                index = index + 1_usize
            }
            ret Option[ProjectContents]::Some(ProjectContents { positions, rotations, scales, actor_names, mesh_names, read_file(paths.script) })
        }
        Option::None => { ret Option[ProjectContents]::None }
    }
}

fn vec3_differs(lhs: Vec3, rhs: Vec3) -> bool {
    ret lhs.x() != rhs.x() || lhs.y() != rhs.y() || lhs.z() != rhs.z()
}

fn compile_game(compiler: str, manifest: str, log_path: str, completion_path: str) -> i32 {
    let mut args = Vec[str]::new()
    args.push("build")
    args.push("--manifest-path")
    args.push(manifest)
    let code = run_args_capture(compiler, args, log_path)
    write_file(completion_path, Debug::fmt(code))
    ret code
}

fn apply_transform_edit(positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3],
    edit: TransformEdit, use_after: bool) -> (Vec[Vec3], Vec[Vec3], Vec[Vec3]) {
    let position = if use_after { edit.after_position } else { edit.before_position }
    let rotation = if use_after { edit.after_rotation } else { edit.before_rotation }
    let scale = if use_after { edit.after_scale } else { edit.before_scale }
    ret (set_position(positions, edit.cube, position), set_rotation(rotations, edit.cube, rotation),
        set_scale(scales, edit.cube, scale))
}

fn theme_surface() -> Color { ret Color::rgb(24_u8, 24_u8, 27_u8) }
fn theme_surface_raised() -> Color { ret Color::rgb(31_u8, 32_u8, 36_u8) }
fn theme_control() -> Color { ret Color::rgb(28_u8, 29_u8, 33_u8) }
fn theme_control_hover() -> Color { ret Color::rgb(46_u8, 47_u8, 52_u8) }
fn theme_border() -> Color { ret Color::rgb(43_u8, 44_u8, 49_u8) }
fn theme_border_hover() -> Color { ret Color::rgb(70_u8, 72_u8, 79_u8) }
fn theme_accent() -> Color { ret Color::rgb(32_u8, 143_u8, 207_u8) }

fn panel_style() -> Style {
    ret Style::default().with_background(theme_surface())
        .with_foreground(Color::rgb(202_u8, 204_u8, 209_u8))
        .with_border(1.0_f32, theme_border())
        .with_radius(0.0_f32).with_padding(Insets::all(6.0_f32)).with_gap(4.0_f32)
}

fn label(text: str) -> Widget {
    ret Widget::label(text).with_flex(24.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(188_u8, 190_u8, 196_u8)).with_font_size(11.0_f32))
}

fn section_title(text: str) -> Widget {
    let mut title = Widget::panel("section-" + text).with_direction(horizontal()).with_flex(24.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(31_u8, 31_u8, 35_u8))
            .with_border(1.0_f32, Color::rgb(47_u8, 48_u8, 53_u8)).with_radius(0.0_f32).with_gap(0.0_f32))
    title.push(Widget::panel("").with_flex(3.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(31_u8, 132_u8, 194_u8)).with_pointer_events(false)))
    title.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(224_u8, 225_u8, 228_u8))
            .with_padding(Insets::symmetric(4.0_f32, 7.0_f32)).with_font_size(10.0_f32).with_font_weight(600_u32)
            .with_pointer_events(false)))
    ret title
}

fn dock_badge(text: str, width: f32) -> Widget {
    ret Widget::label(text).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(27_u8, 28_u8, 32_u8)).with_foreground(Color::rgb(139_u8, 142_u8, 149_u8))
            .with_border(1.0_f32, theme_border()).with_radius(2.0_f32).with_padding(Insets::symmetric(2.0_f32, 5.0_f32))
            .with_font_size(8.0_f32).with_font_weight(600_u32).with_pointer_events(false))
}

fn dock_header(text: str, context: str, context_width: f32) -> Widget {
    let mut header = Widget::panel("dock-header-" + text).with_direction(vertical()).with_flex(26.0_f32, 0.0_f32).with_style(
        Style::default().with_background(theme_surface_raised())
            .with_border(1.0_f32, theme_border()).with_radius(1.0_f32).with_gap(0.0_f32))
    header.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
        Style::default().with_background(theme_accent()).with_pointer_events(false)))
    let mut row = Widget::panel("").with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_padding(Insets::symmetric(2.0_f32, 7.0_f32)).with_gap(5.0_f32).with_pointer_events(false))
    row.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(220_u8, 222_u8, 226_u8))
            .with_font_size(10.0_f32).with_font_weight(600_u32)
            .with_pointer_events(false)))
    if context != "" { row.push(dock_badge(context, context_width)) }
    header.push(row)
    ret header
}

fn menu_item(id: str, text: str, hovered: str) -> Widget {
    ret Widget::button(id, text).with_flex(if text == "Window" { 52.0_f32 } else { 40.0_f32 }, 0.0_f32).with_style(
        Style::default().with_background(if hovered == id { Color::rgb(43_u8, 44_u8, 49_u8) } else { Color::rgb(15_u8, 15_u8, 17_u8) })
            .with_foreground(Color::rgb(188_u8, 190_u8, 196_u8)).with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8))
            .with_radius(2.0_f32).with_padding(Insets::symmetric(3.0_f32, 6.0_f32)).with_font_size(10.0_f32))
}

fn popup_action(id: str, text: str, icon: SvgDocument, hovered: str, disabled: bool, active: bool) -> Widget {
    ret Widget::icon_button(id, text, icon).with_flex(21.0_f32, 0.0_f32).with_disabled(disabled).with_style(
        Style::default().with_background(if active { Color::rgb(30_u8, 66_u8, 89_u8) } else {
            if hovered == id { Color::rgb(48_u8, 49_u8, 54_u8) } else { Color::rgb(25_u8, 25_u8, 28_u8) }
        }).with_foreground(Color::rgb(218_u8, 220_u8, 224_u8)).with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8))
            .with_radius(1.0_f32).with_padding(Insets::symmetric(2.0_f32, 7.0_f32)).with_font_size(9.0_f32))
}

fn menu_popup(menu: str, hovered: str, project_loaded: bool, project_dirty: bool, can_undo: bool, can_redo: bool, selected_cube: u32,
    simulating: bool, building: bool, show_outliner: bool, show_details: bool, show_content: bool, icons: EditorIcons) -> Widget {
    let left = if menu == "menu-file" { 112.0_f32 } else { if menu == "menu-edit" { 154.0_f32 } else {
        if menu == "menu-window" { 196.0_f32 } else { if menu == "menu-tools" { 250.0_f32 } else { 292.0_f32 } }
    } }
    let height = if menu == "menu-edit" { 100.0_f32 } else { if menu == "menu-file" { 122.0_f32 } else {
        if menu == "menu-window" { 76.0_f32 } else { 29.0_f32 }
    } }
    let mut popup = Widget::panel("menu-popup").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(25_u8, 25_u8, 28_u8)).with_border(1.0_f32, Color::rgb(65_u8, 66_u8, 72_u8))
            .with_radius(2.0_f32).with_padding(Insets::all(4.0_f32)).with_gap(2.0_f32).with_width(192.0_f32).with_height(height)
            .with_absolute(true).with_left(left).with_top(24.0_f32).with_z_index(90_i32)
            .with_shadow(0.0_f32, 5.0_f32, 14.0_f32, 0.0_f32, Color::rgba(0_u8, 0_u8, 0_u8, 170_u8), false))
    if menu == "menu-file" {
        popup.push(popup_action("menu-new-project-action", "New Project", icons.add, hovered, building || simulating, false))
        popup.push(popup_action("menu-open-project-action", "Open Project", icons.folder, hovered, building || simulating, false))
        popup.push(popup_action("menu-save-action", "Save Level", icons.save, hovered, !project_loaded || !project_dirty || simulating, false))
        popup.push(popup_action("menu-build-action", "Build Project", icons.build, hovered, !project_loaded || building || simulating, false))
        popup.push(popup_action("menu-exit-action", "Exit Graphene", icons.exit, hovered, false, false))
    }
    elif menu == "menu-edit" {
        popup.push(popup_action("menu-undo-action", "Undo", icons.undo, hovered, !can_undo, false))
        popup.push(popup_action("menu-redo-action", "Redo", icons.redo, hovered, !can_redo, false))
        popup.push(popup_action("menu-duplicate-action", "Duplicate Actor", icons.duplicate, hovered, selected_cube == 0_u32 || simulating, false))
        popup.push(popup_action("menu-delete-action", "Delete Actor", icons.delete, hovered, selected_cube == 0_u32 || simulating, false))
    }
    elif menu == "menu-window" {
        popup.push(popup_action("menu-outliner-action", "World Outliner", icons.panels, hovered, false, show_outliner))
        popup.push(popup_action("menu-details-action", "Details", icons.panels, hovered, false, show_details))
        popup.push(popup_action("menu-content-action", "Content Browser", icons.panels, hovered, false, show_content))
    }
    elif menu == "menu-tools" {
        popup.push(popup_action("menu-tools-build-action", "Build Project", icons.build, hovered, !project_loaded || building || simulating, false))
    }
    else { popup.push(popup_action("menu-about-action", "About Graphene", icons.info, hovered, false, false)) }
    ret popup
}

fn project_dialog(mode: str, path_editor: TextEditor, focused: bool, error: str, view_width: f32, view_height: f32) -> Widget {
    let mut shade = Widget::panel("project-dialog-shade").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgba(0_u8, 0_u8, 0_u8, 176_u8)).with_absolute(true)
            .with_left(0.0_f32).with_top(0.0_f32).with_width(view_width).with_height(view_height).with_z_index(140_i32))
    let width = 520.0_f32
    let height = 224.0_f32
    let mut dialog = Widget::panel("project-dialog").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(28_u8, 29_u8, 33_u8)).with_border(1.0_f32, Color::rgb(74_u8, 76_u8, 83_u8))
            .with_radius(4.0_f32).with_padding(Insets::all(16.0_f32)).with_gap(10.0_f32)
            .with_width(width).with_height(height).with_absolute(true).with_left((view_width - width) * 0.5_f32)
            .with_top((view_height - height) * 0.5_f32).with_z_index(141_i32)
            .with_shadow(0.0_f32, 12.0_f32, 32.0_f32, 0.0_f32, Color::rgba(0_u8, 0_u8, 0_u8, 210_u8), false))
    dialog.push(Widget::label(if mode == "new" { "Create Graphene Project" } else { "Open Graphene Project" })
        .with_flex(28.0_f32, 0.0_f32).with_style(Style::default().with_foreground(Color::rgb(235_u8, 236_u8, 239_u8))
            .with_font_size(16.0_f32).with_font_weight(600_u32)))
    dialog.push(Widget::label(if mode == "new" { "Choose the new project directory." } else { "Choose a directory containing graphene.project." })
        .with_flex(20.0_f32, 0.0_f32).with_style(Style::default().with_foreground(Color::rgb(157_u8, 160_u8, 167_u8)).with_font_size(10.0_f32)))
    dialog.push(Widget::input("project-path", path_editor.value()).with_flex(38.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(17_u8, 18_u8, 21_u8)).with_foreground(Color::rgb(226_u8, 228_u8, 232_u8))
            .with_border(1.0_f32, if focused { theme_accent() } else { theme_border_hover() }).with_radius(3.0_f32)
            .with_padding(Insets::symmetric(7.0_f32, 9.0_f32)).with_font_size(11.0_f32)))
    dialog.push(Widget::label(error).with_flex(20.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(218_u8, 103_u8, 94_u8)).with_font_size(10.0_f32)))
    dialog.push(Widget::spacer(1.0_f32))
    let mut actions = Widget::panel("project-dialog-actions").with_direction(horizontal()).with_flex(32.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(8.0_f32))
    actions.push(Widget::spacer(1.0_f32))
    actions.push(Widget::button("project-cancel", "Cancel").with_flex(88.0_f32, 0.0_f32).with_style(
        Style::default().with_background(theme_control()).with_foreground(Color::rgb(210_u8, 212_u8, 217_u8))
            .with_border(1.0_f32, theme_border_hover()).with_radius(3.0_f32).with_font_size(10.0_f32)))
    actions.push(Widget::button("project-confirm", if mode == "new" { "Create" } else { "Open" }).with_flex(96.0_f32, 0.0_f32)
        .with_style(Style::default().with_background(theme_accent()).with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
            .with_border(1.0_f32, Color::rgb(55_u8, 166_u8, 226_u8)).with_radius(3.0_f32).with_font_size(10.0_f32).with_font_weight(600_u32)))
    dialog.push(actions)
    shade.push(dialog)
    ret shade
}

fn asset_import_dialog(picker: FilePicker, error: str, view_width: f32, view_height: f32, icons: EditorIcons) -> Widget {
    let mut shade = Widget::panel("asset-import-shade").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgba(0_u8, 0_u8, 0_u8, 176_u8)).with_absolute(true)
            .with_left(0.0_f32).with_top(0.0_f32).with_width(view_width).with_height(view_height).with_z_index(140_i32))
    let width = if view_width < 820.0_f32 { view_width - 32.0_f32 } else { 780.0_f32 }
    let height = if view_height < 680.0_f32 { view_height - 32.0_f32 } else { 620.0_f32 }
    let mut dialog = Widget::panel("asset-import-dialog").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(28_u8, 29_u8, 33_u8)).with_border(1.0_f32, Color::rgb(74_u8, 76_u8, 83_u8))
            .with_radius(4.0_f32).with_padding(Insets::all(12.0_f32)).with_gap(8.0_f32)
            .with_width(width).with_height(height).with_absolute(true).with_left((view_width - width) * 0.5_f32)
            .with_top((view_height - height) * 0.5_f32).with_z_index(141_i32)
            .with_shadow(0.0_f32, 12.0_f32, 32.0_f32, 0.0_f32, Color::rgba(0_u8, 0_u8, 0_u8, 210_u8), false))
    dialog.push(Widget::label("Import Static Mesh").with_flex(28.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(235_u8, 236_u8, 239_u8)).with_font_size(16.0_f32).with_font_weight(600_u32)))
    dialog.push(Widget::label("Select a Wavefront OBJ file. The validated source will be copied to Content/Meshes.")
        .with_flex(20.0_f32, 0.0_f32).with_style(Style::default().with_foreground(Color::rgb(157_u8, 160_u8, 167_u8)).with_font_size(10.0_f32)))
    dialog.push(picker.view(file_picker_icons(icons)))
    let mut actions = Widget::panel("asset-import-actions").with_direction(horizontal()).with_flex(34.0_f32, 0.0_f32)
        .with_style(Style::default().with_gap(8.0_f32))
    let message = if error != "" { error } else { if picker.error() != "" { picker.error() } else {
        if picker.selected() == "" { "Select an .obj file" } else { picker.selected() }
    } }
    actions.push(Widget::label(message).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_foreground(if error != "" || picker.error() != "" { Color::rgb(220_u8, 102_u8, 94_u8) }
            else { Color::rgb(145_u8, 148_u8, 155_u8) }).with_font_size(9.0_f32)))
    actions.push(Widget::button("project-cancel", "Cancel").with_flex(88.0_f32, 0.0_f32).with_style(
        Style::default().with_background(theme_control()).with_foreground(Color::rgb(210_u8, 212_u8, 217_u8))
            .with_border(1.0_f32, theme_border_hover()).with_radius(3.0_f32)))
    actions.push(Widget::button("asset-import-confirm", "Import").with_flex(96.0_f32, 0.0_f32).with_disabled(picker.selected() == "").with_style(
        Style::default().with_background(theme_accent()).with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))
            .with_border(1.0_f32, Color::rgb(55_u8, 166_u8, 226_u8)).with_radius(3.0_f32).with_font_weight(600_u32)))
    dialog.push(actions)
    shade.push(dialog)
    ret shade
}

fn split_lines(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == "\n" {
            if index > start { result.push(value.slice(start, index - start)) }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    if start < value.char_len() { result.push(value.slice(start, value.char_len() - start)) }
    ret result
}

fn project_name(path: str) -> str {
    let trimmed = trim_trailing_separator(path)
    let mut index = trimmed.char_len()
    while index > 0_usize {
        let token = trimmed.slice(index - 1_usize, 1_usize)
        if token == "/" || token == "\\" { ret trimmed.slice(index, trimmed.char_len() - index) }
        index = index - 1_usize
    }
    ret trimmed
}

fn recent_projects_path() -> str { ret home_dir() + "/.graphene/recent-projects" }

fn recent_projects() -> Vec[str] {
    let mut result = Vec[str]::new()
    if !file_exists(recent_projects_path()) { ret result }
    for path in split_lines(read_file(recent_projects_path())) {
        if project_valid(project_paths(path)) { result.push(path) }
    }
    ret result
}

fn remember_project(path: str) -> () {
    mkdir_all(home_dir() + "/.graphene")
    let mut output = path + "\n"
    let mut count = 1_usize
    for recent in recent_projects() {
        if recent != path && count < 8_usize { output = output + recent + "\n" count = count + 1_usize }
    }
    write_file(recent_projects_path(), output)
    ret ()
}

fn requested_project_path() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "open" {
                match argv(2_usize) { Option::Some(path) => { ret trim_trailing_separator(path) } Option::None => {} }
            }
            if command == "new" { ret "" }
        }
        Option::None => {}
    }
    let mut index = 1_usize
    while index < argc() {
        match argv(index) {
            Option::Some(value) => {
                if value == "--project" && index + 1_usize < argc() {
                    match argv(index + 1_usize) { Option::Some(path) => { ret trim_trailing_separator(path) } Option::None => {} }
                }
                elif value.char_len() > 0_usize && value.slice(0_usize, 1_usize) != "-" { ret trim_trailing_separator(value) }
            }
            Option::None => {}
        }
        index = index + 1_usize
    }
    match env("GRAPHENE_PROJECT") { Option::Some(path) => { ret trim_trailing_separator(path) } Option::None => {} }
    ret ""
}

fn requested_new_project_path() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "new" {
                match argv(2_usize) { Option::Some(path) => { ret trim_trailing_separator(path) } Option::None => {} }
            }
        }
        Option::None => {}
    }
    ret ""
}

fn requested_project_template() -> str {
    let mut index = 3_usize
    while index < argc() {
        match argv(index) {
            Option::Some(value) => {
                if value == "--template" && index + 1_usize < argc() {
                    match argv(index + 1_usize) {
                        Option::Some(template) => { if template == "starter" { ret "starter" } }
                        Option::None => {}
                    }
                }
            }
            Option::None => {}
        }
        index = index + 1_usize
    }
    ret "empty"
}

fn requested_import_project() -> str {
    match argv(1_usize) {
        Option::Some(command) => { if command == "import" { match argv(2_usize) {
            Option::Some(path) => { ret trim_trailing_separator(path) } Option::None => {}
        } } }
        Option::None => {}
    }
    ret ""
}

fn requested_import_source() -> str {
    match argv(1_usize) {
        Option::Some(command) => { if command == "import" { match argv(3_usize) {
            Option::Some(path) => { ret path } Option::None => {}
        } } }
        Option::None => {}
    }
    ret ""
}

fn project_actor_count(path: str) -> usize {
    let scene_path = project_paths(path).scene
    if !file_exists(scene_path) { ret 0_usize }
    match SceneAsset::parse(read_file(scene_path)) {
        Option::Some(asset) => { ret asset.len() }
        Option::None => {}
    }
    ret 0_usize
}

fn project_card(id: str, path: str, hovered: str, icons: EditorIcons) -> Widget {
    let active = hovered == id
    let mut card = Widget::panel(id).with_direction(vertical()).with_flex(176.0_f32, 0.0_f32).with_style(
        Style::default().with_background(if active { Color::rgb(34_u8, 37_u8, 43_u8) } else { Color::rgb(27_u8, 28_u8, 32_u8) })
            .with_border(1.0_f32, if active { theme_accent() } else { Color::rgb(53_u8, 55_u8, 61_u8) })
            .with_radius(5.0_f32).with_padding(Insets::all(7.0_f32)).with_gap(5.0_f32).with_height(176.0_f32))
    let mut preview = Widget::panel(id).with_direction(vertical()).with_flex(96.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(17_u8, 22_u8, 27_u8)).with_radius(3.0_f32).with_padding(Insets::all(25.0_f32)))
    preview.push(Widget::icon(id, icons.level).with_flex(46.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(45_u8, 146_u8, 205_u8)).with_pointer_events(false)))
    card.push(preview)
    card.push(Widget::label(project_name(path)).with_flex(22.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(231_u8, 232_u8, 235_u8)).with_font_size(11.0_f32).with_font_weight(600_u32).with_pointer_events(false)))
    card.push(Widget::label(Debug::fmt(project_actor_count(path)) + " scene objects").with_flex(16.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(157_u8, 160_u8, 168_u8)).with_font_size(8.0_f32).with_pointer_events(false)))
    card.push(Widget::label(path).with_flex(20.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(126_u8, 129_u8, 137_u8)).with_font_size(8.0_f32).with_pointer_events(false)))
    ret card
}

