        Style::default().with_foreground(Color::rgb(112_u8, 115_u8, 122_u8))
            .with_padding(Insets::all(1.0_f32)).with_pointer_events(false)))
    field.push(Widget::input(id, placeholder).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8)).with_foreground(Color::rgb(205_u8, 207_u8, 212_u8))
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
            .with_padding(Insets::symmetric(2.0_f32, 0.0_f32)).with_font_size(10.0_f32)))
    ret field
}

