pub fn guard_editor_action(action: str, dirty: bool) -> str {
    ret if dirty { "confirm:" + action } else { action }
}

pub fn guarded_action(value: str) -> str {
    if value.byte_len() > 8_usize && value.slice(0_usize, 8_usize) == "confirm:" {
        ret value.slice(8_usize, value.byte_len() - 8_usize)
    }
    ret value
}

pub fn action_needs_confirmation(value: str) -> bool {
    ret value.byte_len() > 8_usize && value.slice(0_usize, 8_usize) == "confirm:"
}
