pub import gui_core::window::*
pub import gui_native::window::*

#cfg(linux)
pub fn backend_name() -> str {
    ret "x11"
}

#cfg(windows)
pub fn backend_name() -> str {
    ret "win32"
}

#cfg(macos)
pub fn backend_name() -> str {
    ret "cocoa"
}

#cfg(all(posix, not(linux), not(macos)))
pub fn backend_name() -> str {
    ret "posix"
}
