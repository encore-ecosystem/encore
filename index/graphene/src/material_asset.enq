import core::fmt::Debug
import core::option::Option
import core::result::Result
import core::vec::Vec
import json::{Json, field, parse, stringify}
import linalg::Vec3
import mod::assets::StandardMaterial

fn parse_decimal(source: str) -> Option[f32] {
    if source.char_len() == 0_usize { ret Option[f32]::None }
    let mut index = 0_usize
    let mut negative = false
    if source.slice(0_usize, 1_usize) == "-" { negative = true index = 1_usize }
    let mut value = 0.0_f32
    let mut fraction = 0.0_f32
    let mut place = 0.1_f32
    let mut decimal = false
    let mut digits = 0_usize
    while index < source.char_len() {
        let token = source.slice(index, 1_usize)
        if token == "." && !decimal { decimal = true }
        else {
            let digits_text = "0123456789"
            let mut digit = 0_usize
            let mut found = false
            while digit < 10_usize {
                if token == digits_text.slice(digit, 1_usize) { found = true break }
                digit = digit + 1_usize
            }
            if !found { ret Option[f32]::None }
            if decimal { fraction = fraction + (digit as f32) * place place = place * 0.1_f32 }
            else { value = value * 10.0_f32 + digit as f32 }
            digits = digits + 1_usize
        }
        index = index + 1_usize
    }
    if digits == 0_usize { ret Option[f32]::None }
    value = value + fraction
    ret Option[f32]::Some(if negative { 0.0_f32 - value } else { value })
}

fn json_f32(value: Json) -> Option[f32] {
    match value.as_number() {
        Option::Some(source) => { ret parse_decimal(source) }
        Option::None => {}
    }
    ret Option[f32]::None
}

fn number(value: f32) -> Json { ret Json::Number(Debug::fmt(value)) }

pub fn material_preset_color(action: str) -> Vec3 {
    if action == "material-color-ruby" { ret Vec3::new(0.62_f32, 0.08_f32, 0.10_f32) }
    if action == "material-color-jade" { ret Vec3::new(0.08_f32, 0.48_f32, 0.24_f32) }
    if action == "material-color-cobalt" { ret Vec3::new(0.08_f32, 0.25_f32, 0.72_f32) }
    if action == "material-color-gold" { ret Vec3::new(0.78_f32, 0.48_f32, 0.08_f32) }
    ret StandardMaterial::editor_default().base_color()
}

pub fn material_edit_action(action: str) -> bool {
    ret action == "material-reset" || action == "material-color-slate" || action == "material-color-ruby" ||
        action == "material-color-jade" || action == "material-color-cobalt" || action == "material-color-gold" ||
        action == "material-metallic-minus" || action == "material-metallic-plus" ||
        action == "material-roughness-minus" || action == "material-roughness-plus" || action == "material-unlit"
}

pub fn edit_default_material(material: StandardMaterial, action: str) -> StandardMaterial {
    if action == "material-reset" { ret StandardMaterial::editor_default() }
    if action == "material-color-slate" || action == "material-color-ruby" || action == "material-color-jade" ||
        action == "material-color-cobalt" || action == "material-color-gold" {
        ret material.with_base_color(material_preset_color(action))
    }
    if action == "material-metallic-minus" { ret material.with_metallic(material.metallic() - 0.1_f32) }
    if action == "material-metallic-plus" { ret material.with_metallic(material.metallic() + 0.1_f32) }
    if action == "material-roughness-minus" { ret material.with_roughness(material.roughness() - 0.1_f32) }
    if action == "material-roughness-plus" { ret material.with_roughness(material.roughness() + 0.1_f32) }
    if action == "material-unlit" { ret material.with_unlit_value(!material.unlit()) }
    ret material
}

pub fn material_asset_stringify(material: StandardMaterial) -> str {
    let color = material.base_color()
    let mut color_values = Vec[Json]::new()
    color_values.push(number(color.x())) color_values.push(number(color.y())) color_values.push(number(color.z()))
    let mut fields = Vec[(str, Json)]::new()
    fields.push(field("format", Json::String("graphene-material")))
    fields.push(field("version", Json::Number("1")))
    fields.push(field("base_color", Json::Array(color_values)))
    fields.push(field("metallic", number(material.metallic())))
    fields.push(field("roughness", number(material.roughness())))
    fields.push(field("unlit", Json::Bool(material.unlit())))
    ret stringify(Json::Object(fields))
}

pub fn material_asset_parse(source: str) -> Option[StandardMaterial] {
    match parse(source) {
        Result::Ok(root) => {
            let valid_format = match root.get("format") {
                Option::Some(value) => { match value.as_str() { Option::Some(text) => { text == "graphene-material" } Option::None => { false } } }
                Option::None => { false }
            }
            let valid_version = match root.get("version") {
                Option::Some(value) => { match value.as_number() { Option::Some(text) => { text == "1" } Option::None => { false } } }
                Option::None => { false }
            }
            if !valid_format || !valid_version { ret Option[StandardMaterial]::None }
            let mut color = Vec3::zero()
            let mut valid_color = false
            match root.get("base_color") {
                Option::Some(value) => { match value.as_array() {
                    Option::Some(values) => {
                        if values.len() == 3_usize {
                            let x = match values.get(0_usize) { Option::Some(item) => json_f32(item) Option::None => Option[f32]::None }
                            let y = match values.get(1_usize) { Option::Some(item) => json_f32(item) Option::None => Option[f32]::None }
                            let z = match values.get(2_usize) { Option::Some(item) => json_f32(item) Option::None => Option[f32]::None }
                            match x { Option::Some(red) => { match y { Option::Some(green) => { match z {
                                Option::Some(blue) => { color = Vec3::new(red, green, blue) valid_color = true }
                                Option::None => {}
                            } } Option::None => {} } } Option::None => {} }
                        }
                    }
                    Option::None => {}
                } }
                Option::None => {}
            }
            let metallic = match root.get("metallic") { Option::Some(value) => json_f32(value) Option::None => Option[f32]::None }
            let roughness = match root.get("roughness") { Option::Some(value) => json_f32(value) Option::None => Option[f32]::None }
            let unlit = match root.get("unlit") {
                Option::Some(value) => { match value.as_bool() { Option::Some(flag) => flag Option::None => false } }
                Option::None => false
            }
            if valid_color { match metallic { Option::Some(metal) => { match roughness {
                Option::Some(rough) => { ret Option[StandardMaterial]::Some(StandardMaterial::new(color, metal, rough).with_unlit_value(unlit)) }
                Option::None => {}
            } } Option::None => {} } }
        }
        Result::Err(_) => {}
    }
    ret Option[StandardMaterial]::None
}
