pub fn adapter_other() -> u32 { ret 0_u32 }
pub fn adapter_integrated() -> u32 { ret 1_u32 }
pub fn adapter_discrete() -> u32 { ret 2_u32 }
pub fn adapter_virtual() -> u32 { ret 3_u32 }
pub fn adapter_cpu() -> u32 { ret 4_u32 }
