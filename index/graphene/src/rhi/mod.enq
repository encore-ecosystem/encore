pub struct ApiVersion { value: u32 }

impl for ApiVersion {
    pub fn from_raw(value: u32) -> ApiVersion { ret ApiVersion { value } }
    pub fn raw(self: Self) -> u32 { ret self.value }
    pub fn major(self: Self) -> u32 { ret self.value >> 22_u32 }
    pub fn minor(self: Self) -> u32 { ret (self.value >> 12_u32) & 1023_u32 }
    pub fn patch(self: Self) -> u32 { ret self.value & 4095_u32 }
    pub fn at_least(self: Self, major: u32, minor: u32) -> bool {
        ret self.major() > major || (self.major() == major && self.minor() >= minor)
    }
}

pub struct RenderCapabilities {
    tier: u32
    ray_query: bool
    ray_pipeline: bool
    mesh_shader: bool
}

impl for RenderCapabilities {
    pub fn tier(self: Self) -> u32 { ret self.tier }
    pub fn ray_query(self: Self) -> bool { ret self.ray_query }
    pub fn ray_pipeline(self: Self) -> bool { ret self.ray_pipeline }
    pub fn mesh_shader(self: Self) -> bool { ret self.mesh_shader }
    pub fn hardware_ray_tracing(self: Self) -> bool { ret self.ray_query || self.ray_pipeline }
}

pub struct AdapterInfo {
    index: usize
    name: str
    vendor_id: u32
    device_id: u32
    kind: u32
    api_version: ApiVersion
    capabilities: RenderCapabilities
}

impl for AdapterInfo {
    pub fn index(self: Self) -> usize { ret self.index }
    pub fn name(self: Self) -> str { ret self.name }
    pub fn vendor_id(self: Self) -> u32 { ret self.vendor_id }
    pub fn device_id(self: Self) -> u32 { ret self.device_id }
    pub fn kind(self: Self) -> u32 { ret self.kind }
    pub fn discrete(self: Self) -> bool { ret self.kind == adapter_discrete() }
    pub fn api_version(self: Self) -> ApiVersion { ret self.api_version }
    pub fn capabilities(self: Self) -> RenderCapabilities { ret self.capabilities }
}

pub struct GraphicsInstance { handle: usize debug: bool window_support: bool }
pub struct GrapheneWindow { handle: usize width: u32 height: u32 }

impl for GrapheneWindow {
    pub fn available(self: Self) -> bool { ret self.handle != 0_usize && native_window_available(self.handle) }
    pub fn error(self: Self) -> str {
        ret if self.handle == 0_usize { "Unable to allocate Graphene window" } else { native_window_error(self.handle) }
    }
    pub fn open(self: Self) -> bool { ret self.handle != 0_usize && native_window_open(self.handle) }
    pub fn poll(self: Self) -> bool { ret self.handle != 0_usize && native_window_poll(self.handle) }
    pub fn width(self: Self) -> u32 { ret if self.handle == 0_usize { self.width } else { native_window_width(self.handle) } }
    pub fn height(self: Self) -> u32 { ret if self.handle == 0_usize { self.height } else { native_window_height(self.handle) } }
    pub fn key_down(self: Self, scancode: u32) -> bool {
        ret self.handle != 0_usize && native_window_key_down(self.handle, scancode)
    }
    pub fn mouse_x(self: Self) -> f32 { ret if self.handle == 0_usize { 0.0_f32 } else { native_window_mouse_x(self.handle) } }
    pub fn mouse_y(self: Self) -> f32 { ret if self.handle == 0_usize { 0.0_f32 } else { native_window_mouse_y(self.handle) } }
    pub fn mouse_dx(self: Self) -> f32 { ret if self.handle == 0_usize { 0.0_f32 } else { native_window_mouse_dx(self.handle) } }
    pub fn mouse_dy(self: Self) -> f32 { ret if self.handle == 0_usize { 0.0_f32 } else { native_window_mouse_dy(self.handle) } }
    pub fn mouse_down(self: Self, button: u32) -> bool {
        ret self.handle != 0_usize && native_window_mouse_down(self.handle, button)
    }
    pub fn destroy(self: Self) -> bool { ret self.handle != 0_usize && native_window_destroy(self.handle) }
}

