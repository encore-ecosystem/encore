pub fn buffer_storage() -> u32 { ret 32_u32 }
pub fn buffer_index() -> u32 { ret 64_u32 }
pub fn buffer_vertex() -> u32 { ret 128_u32 }
pub fn texture_transfer_source() -> u32 { ret 1_u32 }
pub fn texture_transfer_destination() -> u32 { ret 2_u32 }
pub fn texture_sampled() -> u32 { ret 4_u32 }
pub fn texture_storage() -> u32 { ret 8_u32 }
pub fn texture_color_attachment() -> u32 { ret 16_u32 }
pub fn texture_depth_attachment() -> u32 { ret 32_u32 }
pub fn format_rgba8_unorm() -> u32 { ret 37_u32 }
pub fn format_bgra8_unorm() -> u32 { ret 44_u32 }
pub fn format_d32_float() -> u32 { ret 126_u32 }
