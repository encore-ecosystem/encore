impl for GpuBuffer {
    pub fn available(self: Self) -> bool { ret self.handle != 0_usize && native_buffer_available(self.handle) }
    pub fn error(self: Self) -> str {
        ret if self.handle == 0_usize { "Unable to allocate GPU buffer" } else { native_buffer_error(self.handle) }
    }
    pub fn size(self: Self) -> u64 {
        ret if self.handle == 0_usize { self.size } else { native_buffer_size(self.handle) }
    }
    pub fn host_visible(self: Self) -> bool {
        ret self.handle != 0_usize && self.host_visible && native_buffer_host_visible(self.handle)
    }
    pub fn write_u32(self: Self, offset: u64, value: u32) -> bool {
        ret self.handle != 0_usize && native_buffer_write_u32(self.handle, offset, value)
    }
    pub fn write_u32s(self: Self, offset: u64, values: Vec[u32]) -> bool {
        let mut current = offset
        for value in values {
            if !self.write_u32(current, value) { ret false }
            current = current + 4_u64
        }
        ret true
    }
    pub fn write_f32(self: Self, offset: u64, value: f32) -> bool {
        ret self.handle != 0_usize && native_buffer_write_f32(self.handle, offset, value)
    }
    pub fn write_f32s(self: Self, offset: u64, values: Vec[f32]) -> bool {
        let mut current = offset
        for value in values {
            if !self.write_f32(current, value) { ret false }
            current = current + 4_u64
        }
        ret true
    }
    pub fn read_u32(self: Self, offset: u64) -> u32 {
        ret if self.handle == 0_usize { 0_u32 } else { native_buffer_read_u32(self.handle, offset) }
    }
    pub fn destroy(self: Self) -> bool { ret self.handle != 0_usize && native_buffer_destroy(self.handle) }
}

impl for GpuMesh {
    pub fn available(self: Self) -> bool {
        ret self.uploaded && self.index_count > 0_u32 && self.vertex.available() && self.index.available()
    }
    pub fn index_count(self: Self) -> u32 { ret self.index_count }
    pub fn vertex_buffer(self: Self) -> GpuBuffer { ret self.vertex }
    pub fn index_buffer(self: Self) -> GpuBuffer { ret self.index }
    pub fn destroy(self: Self) -> bool {
        let vertex_destroyed = self.vertex.destroy()
        let index_destroyed = self.index.destroy()
        ret vertex_destroyed && index_destroyed
    }
}

