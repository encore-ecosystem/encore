pub struct RenderPipelineOptions { depth_test: bool cull_mode: u32 alpha_blend: bool }

impl for RenderPipelineOptions {
    pub fn opaque() -> RenderPipelineOptions { ret RenderPipelineOptions { false, 0_u32, false } }
    pub fn depth() -> RenderPipelineOptions { ret RenderPipelineOptions { true, 0_u32, false } }
    pub fn with_depth(self: Self, enabled: bool) -> RenderPipelineOptions {
        ret RenderPipelineOptions { enabled, self.cull_mode, self.alpha_blend }
    }
    pub fn with_backface_culling(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions { self.depth_test, 2_u32, self.alpha_blend }
    }
    pub fn with_frontface_culling(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions { self.depth_test, 1_u32, self.alpha_blend }
    }
    pub fn with_alpha_blending(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions { self.depth_test, self.cull_mode, true }
    }
    pub fn depth_test(self: Self) -> bool { ret self.depth_test }
    pub fn cull_mode(self: Self) -> u32 { ret self.cull_mode }
    pub fn alpha_blend(self: Self) -> bool { ret self.alpha_blend }
}

impl for VertexAttribute {
    pub fn new(location: u32, format: u32, offset: u32) -> VertexAttribute {
        ret VertexAttribute { location, format, offset }
    }
}

impl for VertexBufferLayout {
    pub fn new(stride: u32, attributes: Vec[VertexAttribute]) -> VertexBufferLayout {
        ret VertexBufferLayout { stride, attributes }
    }
    pub fn empty() -> VertexBufferLayout { ret VertexBufferLayout { 0_u32, Vec[VertexAttribute]::new() } }
}

