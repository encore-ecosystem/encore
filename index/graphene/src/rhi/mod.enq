pub struct CommandEncoder { handle: usize }
pub struct GpuBuffer { handle: usize size: u64 host_visible: bool }
pub struct GpuMesh { vertex: GpuBuffer index: GpuBuffer index_count: u32 uploaded: bool }
pub struct GpuSubmission { handle: usize }
pub struct GpuTexture { handle: usize width: u32 height: u32 mip_levels: u32 format: u32 }
pub struct Swapchain { handle: usize }
pub struct RenderFrame { handle: usize }
pub struct RenderPassEncoder { handle: usize begun: bool }

impl for RenderPassEncoder {
    pub fn available(self: Self) -> bool { ret self.begun && self.handle != 0_usize && native_frame_available(self.handle) }
    pub fn bind_group(self: Self, group: BindGroup) -> bool {
        ret self.available() && native_frame_bind_group(self.handle, group.handle)
    }
    pub fn bind_vertex_buffer(self: Self, buffer: GpuBuffer) -> bool {
        ret self.available() && native_frame_bind_vertex_buffer(self.handle, buffer.handle)
    }
    pub fn bind_index_buffer(self: Self, buffer: GpuBuffer) -> bool {
        ret self.available() && native_frame_bind_index_buffer(self.handle, buffer.handle)
    }
    pub fn draw_indexed(self: Self, index_count: u32) -> bool {
        ret self.available() && native_frame_draw_indexed(self.handle, index_count, 1_u32, 0_u32, 0_i32, 0_u32)
    }
    pub fn draw_mesh(self: Self, mesh: GpuMesh) -> bool {
        ret mesh.available() && self.bind_vertex_buffer(mesh.vertex) && self.bind_index_buffer(mesh.index) &&
            self.draw_indexed(mesh.index_count)
    }
    pub fn draw_indexed_instanced(self: Self, index_count: u32, instance_count: u32,
        first_index: u32, vertex_offset: i32, first_instance: u32) -> bool {
        ret self.available() && native_frame_draw_indexed(self.handle, index_count, instance_count,
            first_index, vertex_offset, first_instance)
    }
    pub fn end(self: Self) -> bool { ret self.available() && native_frame_end_render_pass(self.handle) }
}

impl for RenderFrame {
    pub fn available(self: Self) -> bool { ret self.handle != 0_usize && native_frame_available(self.handle) }
    pub fn slot(self: Self) -> u32 { ret if self.handle == 0_usize { 0_u32 } else { native_frame_slot(self.handle) } }
    pub fn error(self: Self) -> str { ret if self.handle == 0_usize { "Unable to acquire render frame" } else { native_frame_error(self.handle) } }
    pub fn begin_render_pass(self: Self, pipeline: RenderPipeline,
        red: f32, green: f32, blue: f32, alpha: f32) -> RenderPassEncoder {
        let begun = self.handle != 0_usize && native_frame_begin_render_pass(self.handle, pipeline.handle,
            red, green, blue, alpha)
        ret RenderPassEncoder { self.handle, begun }
    }
    pub fn set_viewport(self: Self, x: u32, y: u32, width: u32, height: u32) -> bool {
        ret self.handle != 0_usize && native_frame_set_viewport(self.handle, x, y, width, height)
    }
    pub fn upload_ui(self: Self, pixels: usize, width: u32, height: u32, pitch: u32,
        hole_x: u32, hole_y: u32, hole_width: u32, hole_height: u32) -> bool {
        ret self.handle != 0_usize && native_frame_upload_ui(self.handle, pixels, width, height, pitch,
            hole_x, hole_y, hole_width, hole_height)
    }
    pub fn present(self: Self) -> bool { ret self.handle != 0_usize && native_frame_present(self.handle) }
    pub fn destroy(self: Self) -> bool { ret self.handle != 0_usize && native_frame_destroy(self.handle) }
}

impl for Swapchain {
    pub fn available(self: Self) -> bool { ret self.handle != 0_usize && native_swapchain_available(self.handle) }
    pub fn error(self: Self) -> str { ret if self.handle == 0_usize { "Unable to allocate swapchain" } else { native_swapchain_error(self.handle) } }
    pub fn width(self: Self) -> u32 { ret if self.handle == 0_usize { 0_u32 } else { native_swapchain_width(self.handle) } }
    pub fn height(self: Self) -> u32 { ret if self.handle == 0_usize { 0_u32 } else { native_swapchain_height(self.handle) } }
    pub fn frames_in_flight(self: Self) -> u32 {
        ret if self.handle == 0_usize { 0_u32 } else { native_swapchain_frames_in_flight(self.handle) }
    }
    pub fn pixels(self: Self) -> usize { ret if self.handle == 0_usize { 0_usize } else { native_swapchain_pixels(self.handle) } }
    pub fn pitch(self: Self) -> u32 { ret if self.handle == 0_usize { 0_u32 } else { native_swapchain_pitch(self.handle) } }
    pub fn clear(self: Self, red: f32, green: f32, blue: f32, alpha: f32) -> bool {
        ret self.handle != 0_usize && native_swapchain_clear(self.handle, red, green, blue, alpha)
    }
    pub fn acquire_frame(self: Self) -> RenderFrame {
        ret RenderFrame { native_frame_acquire(self.handle) }
    }
    pub fn draw(self: Self, pipeline: RenderPipeline, red: f32, green: f32, blue: f32, alpha: f32) -> bool {
        ret self.handle != 0_usize && native_swapchain_draw_pipeline(self.handle, pipeline.handle,
            red, green, blue, alpha)
    }
    pub fn draw_indexed(self: Self, pipeline: RenderPipeline, vertex: GpuBuffer, index: GpuBuffer,
        index_count: u32, red: f32, green: f32, blue: f32, alpha: f32) -> bool {
        ret self.handle != 0_usize && native_swapchain_draw_indexed(self.handle, pipeline.handle,
            vertex.handle, index.handle, index_count, red, green, blue, alpha)
    }
    pub fn draw_indexed_bound(self: Self, pipeline: RenderPipeline, vertex: GpuBuffer, index: GpuBuffer,
        bind_group: BindGroup, index_count: u32, red: f32, green: f32, blue: f32, alpha: f32) -> bool {
        ret self.handle != 0_usize && native_swapchain_draw_indexed_bound(self.handle, pipeline.handle,
            vertex.handle, index.handle, bind_group.handle, index_count, red, green, blue, alpha)
    }
    pub fn destroy(self: Self) -> bool { ret self.handle != 0_usize && native_swapchain_destroy(self.handle) }
}

