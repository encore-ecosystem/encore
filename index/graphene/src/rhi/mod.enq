pub fn texture_layout_color_attachment() -> u32 { ret 2_u32 }
pub fn texture_layout_depth_attachment() -> u32 { ret 3_u32 }
pub fn texture_layout_shader_read() -> u32 { ret 5_u32 }
pub fn texture_layout_transfer_source() -> u32 { ret 6_u32 }
pub fn texture_layout_transfer_destination() -> u32 { ret 7_u32 }
