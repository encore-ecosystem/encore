fn ascii_lower(value: str) -> str {
    let uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lowercase = "abcdefghijklmnopqrstuvwxyz"
    let mut result = ""
    let mut index = 0_usize
    while index < value.char_len() {
        let character = value.slice(index, 1_usize)
        let mut mapped = character
        let mut letter = 0_usize
        while letter < uppercase.char_len() {
            if character == uppercase.slice(letter, 1_usize) {
                mapped = lowercase.slice(letter, 1_usize)
                break
            }
            letter = letter + 1_usize
        }
        result = result + mapped
        index = index + 1_usize
    }
    ret result
}

pub fn search_matches(query: str, value: str) -> bool {
    if query == "" { ret true }
    ret ascii_lower(value).contains(ascii_lower(query))
}

pub fn content_asset_matches(query: str, name: str, kind: str) -> bool {
    ret search_matches(query, name) || search_matches(query, kind)
}

pub fn outliner_actor_matches(query: str, name: str, visible: bool, show_hidden: bool) -> bool {
    ret (visible || show_hidden) && search_matches(query, name)
}
