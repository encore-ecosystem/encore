import linalg::Vec3
import core::option::Option
import core::vec::Vec

pub struct TransformEdit {
    actor: u32
    before_position: Vec3
    before_rotation: Vec3
    before_scale: Vec3
    after_position: Vec3
    after_rotation: Vec3
    after_scale: Vec3
}

pub struct ActorRecord {
    index: u32
    id: u64
    parent: Option[u64]
    children: Vec[u64]
    name: str
    mesh_name: str
    visible: bool
    position: Vec3
    rotation: Vec3
    scale: Vec3
}

pub struct RenameEdit { actor: u32 before: str after: str }
pub struct VisibilityEdit { actor: u32 before: bool after: bool }
pub struct ParentEdit { actor_id: u64 before: Option[u64] after: Option[u64] }
pub struct EditorActors {
    ids: Vec[u64]
    parents: Vec[Option[u64]]
    names: Vec[str]
    mesh_names: Vec[str]
    visibilities: Vec[bool]
    positions: Vec[Vec3]
    rotations: Vec[Vec3]
    scales: Vec[Vec3]
}

pub enum EditorEdit {
    Transform(TransformEdit)
    Add(ActorRecord)
    Delete(ActorRecord)
    Rename(RenameEdit)
    Visibility(VisibilityEdit)
    Parent(ParentEdit)
}

impl for TransformEdit {
    pub fn new(actor: u32, before_position: Vec3, before_rotation: Vec3, before_scale: Vec3,
        after_position: Vec3, after_rotation: Vec3, after_scale: Vec3) -> TransformEdit {
        ret TransformEdit { actor, before_position, before_rotation, before_scale,
            after_position, after_rotation, after_scale }
    }
    pub fn actor(self: Self) -> u32 { ret self.actor }
    pub fn position(self: Self, redo: bool) -> Vec3 { ret if redo { self.after_position } else { self.before_position } }
    pub fn rotation(self: Self, redo: bool) -> Vec3 { ret if redo { self.after_rotation } else { self.before_rotation } }
    pub fn scale(self: Self, redo: bool) -> Vec3 { ret if redo { self.after_scale } else { self.before_scale } }
}

impl for ActorRecord {
    pub fn new(index: u32, id: u64, parent: Option[u64], children: Vec[u64], name: str, mesh_name: str, visible: bool, position: Vec3,
        rotation: Vec3, scale: Vec3) -> ActorRecord {
        ret ActorRecord { index, id, parent, children, name, mesh_name, visible, position, rotation, scale }
    }
    pub fn index(self: Self) -> u32 { ret self.index }
    pub fn id(self: Self) -> u64 { ret self.id }
    pub fn parent(self: Self) -> Option[u64] { ret self.parent }
    pub fn children(self: Self) -> Vec[u64] { ret self.children }
    pub fn name(self: Self) -> str { ret self.name }
    pub fn mesh_name(self: Self) -> str { ret self.mesh_name }
    pub fn visible(self: Self) -> bool { ret self.visible }
    pub fn position(self: Self) -> Vec3 { ret self.position }
    pub fn rotation(self: Self) -> Vec3 { ret self.rotation }
    pub fn scale(self: Self) -> Vec3 { ret self.scale }
}

impl for RenameEdit {
    pub fn new(actor: u32, before: str, after: str) -> RenameEdit { ret RenameEdit { actor, before, after } }
    pub fn actor(self: Self) -> u32 { ret self.actor }
    pub fn value(self: Self, redo: bool) -> str { ret if redo { self.after } else { self.before } }
}

impl for VisibilityEdit {
    pub fn new(actor: u32, before: bool, after: bool) -> VisibilityEdit { ret VisibilityEdit { actor, before, after } }
    pub fn actor(self: Self) -> u32 { ret self.actor }
    pub fn value(self: Self, redo: bool) -> bool { ret if redo { self.after } else { self.before } }
}

impl for ParentEdit {
    pub fn new(actor_id: u64, before: Option[u64], after: Option[u64]) -> ParentEdit { ret ParentEdit { actor_id, before, after } }
    pub fn actor_id(self: Self) -> u64 { ret self.actor_id }
    pub fn value(self: Self, redo: bool) -> Option[u64] { ret if redo { self.after } else { self.before } }
}

fn edit_vec3(values: Vec[Vec3], index: usize, inserted: Vec3, add: bool) -> Vec[Vec3] {
    let mut result = Vec[Vec3]::new()
    let mut current = 0_usize
    for value in values {
        if add && current == index { result.push(inserted) }
        if add || current != index { result.push(value) }
        current = current + 1_usize
    }
    if add && index >= current { result.push(inserted) }
    ret result
}

fn edit_str(values: Vec[str], index: usize, inserted: str, add: bool) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut current = 0_usize
    for value in values {
        if add && current == index { result.push(inserted) }
        if add || current != index { result.push(value) }
        current = current + 1_usize
    }
    if add && index >= current { result.push(inserted) }
    ret result
}

fn edit_bool(values: Vec[bool], index: usize, inserted: bool, add: bool) -> Vec[bool] {
    let mut result = Vec[bool]::new()
    let mut current = 0_usize
    for value in values {
        if add && current == index { result.push(inserted) }
        if add || current != index { result.push(value) }
        current = current + 1_usize
    }
    if add && index >= current { result.push(inserted) }
    ret result
}

fn edit_u64(values: Vec[u64], index: usize, inserted: u64, add: bool) -> Vec[u64] {
    let mut result = Vec[u64]::new()
    let mut current = 0_usize
    for value in values {
        if add && current == index { result.push(inserted) }
        if add || current != index { result.push(value) }
        current = current + 1_usize
    }
    if add && index >= current { result.push(inserted) }
    ret result
}

fn edit_parent(values: Vec[Option[u64]], index: usize, inserted: Option[u64], add: bool) -> Vec[Option[u64]] {
    let mut result = Vec[Option[u64]]::new()
    let mut current = 0_usize
    for value in values {
        if add && current == index { result.push(inserted) }
        if add || current != index { result.push(value) }
        current = current + 1_usize
    }
    if add && index >= current { result.push(inserted) }
    ret result
}

fn contains_id(values: Vec[u64], expected: u64) -> bool {
    for value in values { if value == expected { ret true } }
    ret false
}

fn restore_parent_links(ids: Vec[u64], parents: Vec[Option[u64]], actor: ActorRecord, inserted: bool) -> Vec[Option[u64]] {
    let mut result = parents
    let mut index = 0_usize
    while index < ids.len() && index < result.len() {
        match ids.get(index) {
            Option::Some(id) => {
                if inserted && contains_id(actor.children(), id) { result.set(index, Option[u64]::Some(actor.id())) }
                elif !inserted { match result.get(index) {
                    Option::Some(parent) => { if parent == Option[u64]::Some(actor.id()) { result.set(index, Option[u64]::None) } }
                    Option::None => {}
                } }
            }
            Option::None => {}
        }
        index = index + 1_usize
    }
    ret result
}

impl for EditorActors {
    pub fn new(ids: Vec[u64], parents: Vec[Option[u64]], names: Vec[str], mesh_names: Vec[str], visibilities: Vec[bool], positions: Vec[Vec3],
        rotations: Vec[Vec3], scales: Vec[Vec3]) -> EditorActors {
        ret EditorActors { ids, parents, names, mesh_names, visibilities, positions, rotations, scales }
    }
    pub fn apply(self: Self, actor: ActorRecord, insert: bool) -> EditorActors {
        let index = (actor.index() - 1_u32) as usize
        let ids = edit_u64(self.ids, index, actor.id(), insert)
        let parents = restore_parent_links(ids, edit_parent(self.parents, index, actor.parent(), insert), actor, insert)
        ret EditorActors {
            ids,
            parents,
            edit_str(self.names, index, actor.name(), insert),
            edit_str(self.mesh_names, index, actor.mesh_name(), insert),
            edit_bool(self.visibilities, index, actor.visible(), insert),
            edit_vec3(self.positions, index, actor.position(), insert),
            edit_vec3(self.rotations, index, actor.rotation(), insert),
            edit_vec3(self.scales, index, actor.scale(), insert)
        }
    }
    pub fn len(self: Self) -> usize { ret self.positions.len() }
    pub fn ids(self: Self) -> Vec[u64] { ret self.ids }
    pub fn parents(self: Self) -> Vec[Option[u64]] { ret self.parents }
    pub fn names(self: Self) -> Vec[str] { ret self.names }
    pub fn mesh_names(self: Self) -> Vec[str] { ret self.mesh_names }
    pub fn visibilities(self: Self) -> Vec[bool] { ret self.visibilities }
    pub fn positions(self: Self) -> Vec[Vec3] { ret self.positions }
    pub fn rotations(self: Self) -> Vec[Vec3] { ret self.rotations }
    pub fn scales(self: Self) -> Vec[Vec3] { ret self.scales }
}
