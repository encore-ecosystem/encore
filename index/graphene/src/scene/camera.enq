import linalg::{Mat4, Vec3}

pub struct PerspectiveCamera {
    position: Vec3
    target: Vec3
    up: Vec3
    fov_y: f32
    near: f32
    far: f32
}

impl for PerspectiveCamera {
    pub fn new(position: Vec3, target: Vec3, fov_y: f32, near: f32, far: f32) -> PerspectiveCamera {
        ret PerspectiveCamera { position, target, Vec3::new(0.0_f32, 1.0_f32, 0.0_f32), fov_y, near, far }
    }
    pub fn position(self: Self) -> Vec3 { ret self.position }
    pub fn target(self: Self) -> Vec3 { ret self.target }
    pub fn view(self: Self) -> Mat4 { ret Mat4::look_at(self.position, self.target, self.up) }
    pub fn projection(self: Self, aspect: f32) -> Mat4 {
        ret Mat4::perspective(self.fov_y, aspect, self.near, self.far)
    }
    pub fn view_projection(self: Self, aspect: f32) -> Mat4 {
        ret self.projection(aspect).mul(self.view())
    }
    pub fn model_view_projection(self: Self, model: Mat4, aspect: f32) -> Mat4 {
        ret self.view_projection(aspect).mul(model)
    }
}
