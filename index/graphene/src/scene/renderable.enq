import linalg::Mat4

pub struct MeshId { value: u64 }
pub struct MaterialId { value: u64 }
pub struct Renderable { mesh: MeshId material: MaterialId }
pub struct RenderItem { entity: u64 mesh: MeshId material: MaterialId world: Mat4 }

impl for MeshId {
    pub fn new(value: u64) -> MeshId { ret MeshId { value } }
    pub fn value(self: Self) -> u64 { ret self.value }
    pub fn valid(self: Self) -> bool { ret self.value != 0_u64 }
}

impl for MaterialId {
    pub fn new(value: u64) -> MaterialId { ret MaterialId { value } }
    pub fn value(self: Self) -> u64 { ret self.value }
    pub fn valid(self: Self) -> bool { ret self.value != 0_u64 }
}

impl for Renderable {
    pub fn new(mesh: MeshId, material: MaterialId) -> Renderable { ret Renderable { mesh, material } }
    pub fn mesh(self: Self) -> MeshId { ret self.mesh }
    pub fn material(self: Self) -> MaterialId { ret self.material }
    pub fn valid(self: Self) -> bool { ret self.mesh.valid() && self.material.valid() }
}

impl for RenderItem {
    pub fn new(entity: u64, renderable: Renderable, world: Mat4) -> RenderItem {
        ret RenderItem { entity, renderable.mesh(), renderable.material(), world }
    }
    pub fn entity(self: Self) -> u64 { ret self.entity }
    pub fn mesh(self: Self) -> MeshId { ret self.mesh }
    pub fn material(self: Self) -> MaterialId { ret self.material }
    pub fn world(self: Self) -> Mat4 { ret self.world }
}
