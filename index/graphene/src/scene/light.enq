import core::vec::Vec
import linalg::Vec3

pub struct DirectionalLight { direction: Vec3 color: Vec3 intensity: f32 }

impl for DirectionalLight {
    pub fn new(direction: Vec3, color: Vec3, intensity: f32) -> DirectionalLight {
        ret DirectionalLight { direction.normalized(), color, intensity }
    }
    pub fn direction(self: Self) -> Vec3 { ret self.direction }
    pub fn color(self: Self) -> Vec3 { ret self.color }
    pub fn intensity(self: Self) -> f32 { ret self.intensity }
    pub fn uniform_values(self: Self) -> Vec[f32] {
        let mut values = Vec[f32]::new()
        values.push(self.direction.x()) values.push(self.direction.y()) values.push(self.direction.z()) values.push(0.0_f32)
        values.push(self.color.x()) values.push(self.color.y()) values.push(self.color.z()) values.push(self.intensity)
        ret values
    }
}
