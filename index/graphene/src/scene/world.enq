import core::option::Option
import core::vec::Vec
import linalg::Mat4
import mod::renderable::{RenderItem, Renderable}
import mod::transform::Transform

pub struct Entity {
    id: u64 name: str transform: Transform parent: Option[u64] visible: bool renderable: Option[Renderable]
}
pub struct Scene { entities: Vec[Entity] next_id: u64 }

impl for Entity {
    pub fn id(self: Self) -> u64 { ret self.id }
    pub fn name(self: Self) -> str { ret self.name }
    pub fn transform(self: Self) -> Transform { ret self.transform }
    pub fn parent(self: Self) -> Option[u64] { ret self.parent }
    pub fn visible(self: Self) -> bool { ret self.visible }
    pub fn renderable(self: Self) -> Option[Renderable] { ret self.renderable }
}

impl for Scene {
    pub fn new() -> Scene { ret Scene { Vec[Entity]::new(), 1_u64 } }
    pub fn len(self: Self) -> usize { ret self.entities.len() }
    pub fn entities(self: Self) -> Vec[Entity] { ret self.entities }
    pub fn create_entity(self: mut Self, name: str, transform: Transform) -> u64 {
        let id = self.next_id
        self.create_entity_with_id(id, name, transform)
        ret id
    }
    pub fn create_entity_with_id(self: mut Self, id: u64, name: str, transform: Transform) -> bool {
        if id == 0_u64 || self.get(id).is_some() { ret false }
        self.entities.push(Entity { id, name, transform, Option[u64]::None, true, Option[Renderable]::None })
        if id >= self.next_id { self.next_id = id + 1_u64 }
        ret true
    }
    pub fn get(self: Self, id: u64) -> Option[Entity] {
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => { if entity.id == id { ret Option[Entity]::Some(entity) } }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret Option[Entity]::None
    }
    pub fn remove(self: mut Self, id: u64) -> bool {
        let mut found = false
        let mut remaining = Vec[Entity]::new()
        for entity in self.entities {
            if entity.id == id {
                found = true
            } else {
                let parent = match entity.parent {
                    Option::Some(parent_id) => {
                        if parent_id == id { Option[u64]::None } else { entity.parent }
                    }
                    Option::None => { Option[u64]::None }
                }
                remaining.push(Entity { entity.id, entity.name, entity.transform, parent,
                    entity.visible, entity.renderable })
            }
        }
        if found { self.entities = remaining }
        ret found
    }
    pub fn set_transform(self: mut Self, id: u64, transform: Transform) -> bool {
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                            entity.id, entity.name, transform, entity.parent, entity.visible, entity.renderable
                        })
                        ret true
                    }
                }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn rename(self: mut Self, id: u64, name: str) -> bool {
        if name == "" { ret false }
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                            entity.id, name, entity.transform, entity.parent, entity.visible, entity.renderable
                        })
                        ret true
                    }
                }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn set_visible(self: mut Self, id: u64, visible: bool) -> bool {
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                            entity.id, entity.name, entity.transform, entity.parent, visible, entity.renderable
                        })
                        ret true
                    }
                }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn set_parent(self: mut Self, id: u64, parent: Option[u64]) -> bool {
        if id == 0_u64 { ret false }
        match self.get(id) {
            Option::None => { ret false }
            Option::Some(_) => {}
        }
        match parent {
            Option::Some(parent_id) => {
                if parent_id == id { ret false }
                match self.get(parent_id) {
                    Option::None => { ret false }
                    Option::Some(_) => {}
                }
                let mut cursor = Option[u64]::Some(parent_id)
                let mut steps = 0_usize
                while steps < self.entities.len() {
                    match cursor {
                        Option::Some(cursor_id) => {
                            if cursor_id == id { ret false }
                            match self.get(cursor_id) {
                                Option::Some(entity) => { cursor = entity.parent }
                                Option::None => { ret false }
                            }
                        }
                        Option::None => { steps = self.entities.len() }
                    }
                    steps = steps + 1_usize
                }
                match cursor { Option::Some(_) => { ret false } Option::None => {} }
            }
            Option::None => {}
        }
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                            entity.id, entity.name, entity.transform, parent, entity.visible, entity.renderable
                        })
                        ret true
                    }
                }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn world_matrix(self: Self, id: u64) -> Option[Mat4] {
        let mut chain = Vec[Mat4]::new()
        let mut cursor = Option[u64]::Some(id)
        let mut steps = 0_usize
        while steps < self.entities.len() {
            match cursor {
                Option::Some(cursor_id) => {
                    match self.get(cursor_id) {
                        Option::Some(entity) => { chain.push(entity.transform.matrix()) cursor = entity.parent }
                        Option::None => { ret Option[Mat4]::None }
                    }
                }
                Option::None => { steps = self.entities.len() }
            }
            steps = steps + 1_usize
        }
        match cursor { Option::Some(_) => { ret Option[Mat4]::None } Option::None => {} }
        let mut result = Mat4::identity()
        let mut remaining = chain.len()
        while remaining > 0_usize {
            remaining = remaining - 1_usize
            match chain.get(remaining) {
                Option::Some(matrix) => { result = result.mul(matrix) }
                Option::None => {}
            }
        }
        ret Option[Mat4]::Some(result)
    }
    pub fn world_visible(self: Self, id: u64) -> bool {
        let mut cursor = Option[u64]::Some(id)
        let mut steps = 0_usize
        while steps < self.entities.len() {
            match cursor {
                Option::Some(cursor_id) => {
                    match self.get(cursor_id) {
                        Option::Some(entity) => {
                            if !entity.visible { ret false }
                            cursor = entity.parent
                        }
                        Option::None => { ret false }
                    }
                }
                Option::None => { ret true }
            }
            steps = steps + 1_usize
        }
        ret cursor.is_none()
    }
    pub fn set_renderable(self: mut Self, id: u64, renderable: Option[Renderable]) -> bool {
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                            entity.id, entity.name, entity.transform, entity.parent, entity.visible, renderable
                        })
                        ret true
                    }
                }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn visible_render_items(self: Self) -> Vec[RenderItem] {
        let mut items = Vec[RenderItem]::new()
        for entity in self.entities {
            if self.world_visible(entity.id) {
                match entity.renderable {
                    Option::Some(renderable) => {
                        if renderable.valid() {
                            match self.world_matrix(entity.id) {
                                Option::Some(world) => { items.push(RenderItem::new(entity.id, renderable, world)) }
                                Option::None => {}
                            }
                        }
                    }
                    Option::None => {}
                }
            }
        }
        ret items
    }
}
