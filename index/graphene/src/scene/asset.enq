import core::fmt::Debug
import core::option::Option
import core::result::Result
import core::vec::Vec
import json::{Json, field, parse, stringify}
import linalg::Vec3
import mod::transform::Transform

pub struct SceneActor { id: u64 parent: Option[u64] name: str kind: str transform: Transform visible: bool }
pub struct SceneAsset { version: u32 actors: Vec[SceneActor] }

fn parse_u64(source: str) -> Option[u64] {
    if source.byte_len() == 0_usize { ret Option[u64]::None }
    let mut value = 0_u64
    let mut index = 0_usize
    while index < source.byte_len() {
        let byte = source.byte_at(index)
        if byte < 48_u8 || byte > 57_u8 { ret Option[u64]::None }
        let digit = (byte - 48_u8) as u64
        let next = value * 10_u64 + digit
        if next < value { ret Option[u64]::None }
        value = next
        index = index + 1_usize
    }
    ret Option[u64]::Some(value)
}

fn parse_number(source: str) -> Option[f32] {
    if source.byte_len() == 0_usize { ret Option[f32]::None }
    let mut index = 0_usize
    let mut sign = 1.0_f32
    if source.byte_at(index) == 45_u8 { sign = -1.0_f32 index = index + 1_usize }
    let mut value = 0.0_f32
    let mut digits = 0_usize
    while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
        value = value * 10.0_f32 + ((source.byte_at(index) - 48_u8) as f32)
        digits = digits + 1_usize index = index + 1_usize
    }
    if index < source.byte_len() && source.byte_at(index) == 46_u8 {
        index = index + 1_usize
        let mut place = 0.1_f32
        while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
            value = value + ((source.byte_at(index) - 48_u8) as f32) * place
            place = place * 0.1_f32 digits = digits + 1_usize index = index + 1_usize
        }
    }
    if digits == 0_usize { ret Option[f32]::None }
    if index < source.byte_len() && (source.byte_at(index) == 101_u8 || source.byte_at(index) == 69_u8) {
        index = index + 1_usize
        let mut exponent_sign = 1_i32
        if index < source.byte_len() && source.byte_at(index) == 45_u8 { exponent_sign = -1_i32 index = index + 1_usize }
        elif index < source.byte_len() && source.byte_at(index) == 43_u8 { index = index + 1_usize }
        let mut exponent = 0_i32
        let mut exponent_digits = 0_usize
        while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
            exponent = exponent * 10_i32 + ((source.byte_at(index) - 48_u8) as i32)
            exponent_digits = exponent_digits + 1_usize index = index + 1_usize
        }
        if exponent_digits == 0_usize { ret Option[f32]::None }
        exponent = exponent * exponent_sign
        while exponent > 0_i32 { value = value * 10.0_f32 exponent = exponent - 1_i32 }
        while exponent < 0_i32 { value = value * 0.1_f32 exponent = exponent + 1_i32 }
    }
    if index != source.byte_len() { ret Option[f32]::None }
    ret Option[f32]::Some(value * sign)
}

fn json_number(value: f32) -> Json { ret Json::Number(Debug::fmt(value)) }

fn vec3_json(value: Vec3) -> Json {
    let mut values = Vec[Json]::new()
    values.push(json_number(value.x())) values.push(json_number(value.y())) values.push(json_number(value.z()))
    ret Json::Array(values)
}

fn json_f32(value: Json) -> Option[f32] {
    match value.as_number() {
        Option::Some(number) => { ret parse_number(number) }
        Option::None => { ret Option[f32]::None }
    }
}

fn json_vec3(value: Json) -> Option[Vec3] {
    match value.as_array() {
        Option::Some(values) => {
            if values.len() != 3_usize { ret Option[Vec3]::None }
            let mut x = 0.0_f32 let mut y = 0.0_f32 let mut z = 0.0_f32
            let mut valid_x = false let mut valid_y = false let mut valid_z = false
            match values.get(0_usize) {
                Option::Some(item) => { match json_f32(item) { Option::Some(number) => { x = number valid_x = true } Option::None => {} } }
                Option::None => {}
            }
            match values.get(1_usize) {
                Option::Some(item) => { match json_f32(item) { Option::Some(number) => { y = number valid_y = true } Option::None => {} } }
                Option::None => {}
            }
            match values.get(2_usize) {
                Option::Some(item) => { match json_f32(item) { Option::Some(number) => { z = number valid_z = true } Option::None => {} } }
                Option::None => {}
            }
            if valid_x && valid_y && valid_z { ret Option[Vec3]::Some(Vec3::new(x, y, z)) }
        }
        Option::None => {}
    }
    ret Option[Vec3]::None
}

impl for SceneActor {
    pub fn new(name: str, kind: str, transform: Transform) -> SceneActor {
        ret SceneActor { 0_u64, Option[u64]::None, name, kind, transform, true }
    }
    pub fn with_identity(self: Self, id: u64) -> SceneActor { ret SceneActor { id, self.parent, self.name, self.kind, self.transform, self.visible } }
    pub fn with_parent(self: Self, parent: Option[u64]) -> SceneActor { ret SceneActor { self.id, parent, self.name, self.kind, self.transform, self.visible } }
    pub fn with_visible(self: Self, visible: bool) -> SceneActor { ret SceneActor { self.id, self.parent, self.name, self.kind, self.transform, visible } }
    pub fn id(self: Self) -> u64 { ret self.id }
    pub fn parent(self: Self) -> Option[u64] { ret self.parent }
    pub fn name(self: Self) -> str { ret self.name }
    pub fn kind(self: Self) -> str { ret self.kind }
    pub fn transform(self: Self) -> Transform { ret self.transform }
    pub fn visible(self: Self) -> bool { ret self.visible }
    pub fn to_json(self: Self) -> Json {
        let mut transform_fields = Vec[(str, Json)]::new()
        transform_fields.push(field("position", vec3_json(self.transform.position())))
        transform_fields.push(field("rotation", vec3_json(self.transform.rotation())))
        transform_fields.push(field("scale", vec3_json(self.transform.scale())))
        let mut fields = Vec[(str, Json)]::new()
        fields.push(field("id", Json::Number(Debug::fmt(self.id))))
        fields.push(field("parent", match self.parent { Option::Some(id) => Json::Number(Debug::fmt(id)) Option::None => Json::Null }))
        fields.push(field("name", Json::String(self.name)))
        fields.push(field("kind", Json::String(self.kind)))
        fields.push(field("visible", Json::Bool(self.visible)))
        fields.push(field("transform", Json::Object(transform_fields)))
        ret Json::Object(fields)
    }
    pub fn from_json(value: Json) -> Option[SceneActor] { ret SceneActor::from_json_version(value, 1_u32, 1_u64) }
    pub fn from_json_version(value: Json, version: u32, legacy_id: u64) -> Option[SceneActor] {
        let mut id = legacy_id
        let mut parent = Option[u64]::None
        let mut valid_identity = version == 1_u32 && legacy_id > 0_u64
        if version == 2_u32 {
            match value.get("id") {
                Option::Some(item) => { match item.as_number() { Option::Some(number) => { match parse_u64(number) {
                    Option::Some(found) => { id = found valid_identity = found > 0_u64 }
                    Option::None => {}
                } } Option::None => {} } }
                Option::None => {}
            }
            match value.get("parent") {
                Option::Some(item) => {
                    if item.is_null() { parent = Option[u64]::None }
                    else { match item.as_number() { Option::Some(number) => { match parse_u64(number) {
                        Option::Some(found) => { if found > 0_u64 { parent = Option[u64]::Some(found) } else { valid_identity = false } }
                        Option::None => { valid_identity = false }
                    } } Option::None => { valid_identity = false } } }
                }
                Option::None => { valid_identity = false }
            }
        }
        let mut name = "" let mut kind = ""
        let mut position = Vec3::zero() let mut rotation = Vec3::zero()
        let mut scale = Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
        let mut visible = true
        let mut valid_name = false let mut valid_kind = false
        let mut valid_position = false let mut valid_rotation = false let mut valid_scale = false
        match value.get("name") {
            Option::Some(item) => { match item.as_str() { Option::Some(text) => { name = text valid_name = true } Option::None => {} } }
            Option::None => {}
        }
        match value.get("kind") {
            Option::Some(item) => { match item.as_str() { Option::Some(text) => { kind = text valid_kind = true } Option::None => {} } }
            Option::None => {}
        }
        match value.get("visible") {
            Option::Some(item) => { match item.as_bool() { Option::Some(flag) => { visible = flag } Option::None => {} } }
            Option::None => {}
        }
        match value.get("transform") {
            Option::Some(transform_value) => {
                match transform_value.get("position") {
                    Option::Some(item) => { match json_vec3(item) { Option::Some(vector) => { position = vector valid_position = true } Option::None => {} } }
                    Option::None => {}
                }
                match transform_value.get("rotation") {
                    Option::Some(item) => { match json_vec3(item) { Option::Some(vector) => { rotation = vector valid_rotation = true } Option::None => {} } }
                    Option::None => {}
                }
                match transform_value.get("scale") {
                    Option::Some(item) => { match json_vec3(item) { Option::Some(vector) => { scale = vector valid_scale = true } Option::None => {} } }
                    Option::None => {}
                }
            }
            Option::None => {}
        }
        if valid_identity && valid_name && valid_kind && valid_position && valid_rotation && valid_scale {
            ret Option[SceneActor]::Some(SceneActor::new(name, kind, Transform::new(position, rotation, scale))
                .with_identity(id).with_parent(parent).with_visible(visible))
        }
        ret Option[SceneActor]::None
    }
}

impl for SceneAsset {
    pub fn new() -> SceneAsset { ret SceneAsset { 2_u32, Vec[SceneActor]::new() } }
    pub fn version(self: Self) -> u32 { ret self.version }
    pub fn actor(self: Self, index: usize) -> Option[SceneActor] { ret self.actors.get(index) }
    pub fn len(self: Self) -> usize { ret self.actors.len() }
    pub fn add(self: mut Self, actor: SceneActor) -> () {
        let mut stored = actor
        if stored.id == 0_u64 { stored = stored.with_identity(self.next_actor_id()) }
        self.actors.push(stored)
        ret ()
    }
    pub fn next_actor_id(self: Self) -> u64 {
        let mut next = 1_u64
        for actor in self.actors { if actor.id >= next { next = actor.id + 1_u64 } }
        ret next
    }
    pub fn actor_by_id(self: Self, id: u64) -> Option[SceneActor] {
        for actor in self.actors { if actor.id == id { ret Option[SceneActor]::Some(actor) } }
        ret Option[SceneActor]::None
    }
    pub fn valid_hierarchy(self: Self) -> bool {
        let mut seen_ids = Vec[u64]::new()
        for actor in self.actors {
            if actor.id == 0_u64 { ret false }
            for seen in seen_ids { if seen == actor.id { ret false } }
            seen_ids.push(actor.id)
        }
        for actor in self.actors {
            let mut cursor = actor.parent
            let mut steps = 0_usize
            while steps <= self.actors.len() {
                match cursor {
                    Option::Some(parent_id) => {
                        if parent_id == actor.id { ret false }
                        match self.actor_by_id(parent_id) {
                            Option::Some(parent_actor) => { cursor = parent_actor.parent }
                            Option::None => { ret false }
                        }
                    }
                    Option::None => { steps = self.actors.len() + 1_usize }
                }
                steps = steps + 1_usize
            }
            if cursor.is_some() { ret false }
        }
        ret true
    }
    pub fn to_json(self: Self) -> Json {
        let mut actors = Vec[Json]::new()
        for actor in self.actors { actors.push(actor.to_json()) }
        let mut fields = Vec[(str, Json)]::new()
        fields.push(field("format", Json::String("graphene-scene")))
        fields.push(field("version", Json::Number(Debug::fmt(self.version))))
        fields.push(field("actors", Json::Array(actors)))
        ret Json::Object(fields)
    }
    pub fn stringify(self: Self) -> str { ret stringify(self.to_json()) }
    pub fn parse(source: str) -> Option[SceneAsset] {
        match parse(source) {
            Result::Ok(root) => {
                let mut valid_format = false let mut version = 0_u32
                match root.get("format") {
                    Option::Some(item) => { match item.as_str() { Option::Some(value) => { valid_format = value == "graphene-scene" } Option::None => {} } }
                    Option::None => {}
                }
                match root.get("version") {
                    Option::Some(item) => { match item.as_number() { Option::Some(value) => {
                        if value == "1" { version = 1_u32 } elif value == "2" { version = 2_u32 }
                    } Option::None => {} } }
                    Option::None => {}
                }
                if !valid_format || version == 0_u32 { ret Option[SceneAsset]::None }
                match root.get("actors") {
                    Option::Some(actors_value) => {
                        match actors_value.as_array() {
                            Option::Some(actor_values) => {
                                let mut asset = SceneAsset::new()
                                asset.version = version
                                let mut actor_index = 0_usize
                                for actor_value in actor_values {
                                    match SceneActor::from_json_version(actor_value, version, actor_index as u64 + 1_u64) {
                                        Option::Some(actor) => { asset.add(actor) }
                                        Option::None => { ret Option[SceneAsset]::None }
                                    }
                                    actor_index = actor_index + 1_usize
                                }
                                if !asset.valid_hierarchy() { ret Option[SceneAsset]::None }
                                // Parsed v1 scenes are upgraded in memory and serialize as v2.
                                asset.version = 2_u32
                                ret Option[SceneAsset]::Some(asset)
                            }
                            Option::None => {}
                        }
                    }
                    Option::None => {}
                }
            }
            Result::Err(_) => {}
        }
        ret Option[SceneAsset]::None
    }
}
