import core::vec::Vec

fn ring_angle(value: f32) -> f32 {
    let mut angle = value
    while angle > 3.1415927_f32 { angle = angle - 6.2831855_f32 }
    while angle < -3.1415927_f32 { angle = angle + 6.2831855_f32 }
    ret angle
}

fn ring_sin(value: f32) -> f32 {
    let x = ring_angle(value)
    let x2 = x * x
    let x3 = x * x2 let x5 = x3 * x2 let x7 = x5 * x2
    let x9 = x7 * x2 let x11 = x9 * x2
    ret x - x3 / 6.0_f32 + x5 / 120.0_f32 - x7 / 5040.0_f32 + x9 / 362880.0_f32 - x11 / 39916800.0_f32
}

fn ring_cos(value: f32) -> f32 {
    let x = ring_angle(value)
    let x2 = x * x let x4 = x2 * x2 let x6 = x4 * x2
    let x8 = x6 * x2 let x10 = x8 * x2
    ret 1.0_f32 - x2 / 2.0_f32 + x4 / 24.0_f32 - x6 / 720.0_f32 + x8 / 40320.0_f32 - x10 / 3628800.0_f32
}

pub struct MeshData { vertices: Vec[f32] indices: Vec[u32] stride: u32 }

fn append_vertex(values: Vec[f32], x: f32, y: f32, z: f32,
    nx: f32, ny: f32, nz: f32, red: f32, green: f32, blue: f32) -> Vec[f32] {
    let mut out = values
    out.push(x) out.push(y) out.push(z)
    out.push(nx) out.push(ny) out.push(nz)
    out.push(red) out.push(green) out.push(blue)
    ret out
}

fn append_face(indices: Vec[u32], base: u32) -> Vec[u32] {
    let mut out = indices
    out.push(base) out.push(base + 1_u32) out.push(base + 2_u32)
    out.push(base + 2_u32) out.push(base + 3_u32) out.push(base)
    ret out
}

fn append_triangle(indices: Vec[u32], base: u32) -> Vec[u32] {
    let mut out = indices
    out.push(base) out.push(base + 1_u32) out.push(base + 2_u32)
    ret out
}

fn append_double_sided_face(indices: Vec[u32], base: u32) -> Vec[u32] {
    let mut out = append_face(indices, base)
    out.push(base + 2_u32) out.push(base + 1_u32) out.push(base)
    out.push(base) out.push(base + 3_u32) out.push(base + 2_u32)
    ret out
}

fn append_grid_vertex(values: Vec[f32], x: f32, y: f32, z: f32,
    red: f32, green: f32, blue: f32) -> Vec[f32] {
    ret append_vertex(values, x, y, z, 0.0_f32, 1.0_f32, 0.0_f32, red, green, blue)
}

fn append_grid_line(vertices: Vec[f32], indices: Vec[u32], coordinate: f32, extent: f32,
    half_width: f32, parallel_z: bool, red: f32, green: f32, blue: f32) -> (Vec[f32], Vec[u32]) {
    let mut out_vertices = vertices
    let base = (out_vertices.len() / 9_usize) as u32
    if parallel_z {
        out_vertices = append_grid_vertex(out_vertices, coordinate - half_width, 0.0_f32, -extent, red, green, blue)
        out_vertices = append_grid_vertex(out_vertices, coordinate - half_width, 0.0_f32, extent, red, green, blue)
        out_vertices = append_grid_vertex(out_vertices, coordinate + half_width, 0.0_f32, extent, red, green, blue)
        out_vertices = append_grid_vertex(out_vertices, coordinate + half_width, 0.0_f32, -extent, red, green, blue)
    } else {
        out_vertices = append_grid_vertex(out_vertices, -extent, 0.0_f32, coordinate - half_width, red, green, blue)
        out_vertices = append_grid_vertex(out_vertices, -extent, 0.0_f32, coordinate + half_width, red, green, blue)
        out_vertices = append_grid_vertex(out_vertices, extent, 0.0_f32, coordinate + half_width, red, green, blue)
        out_vertices = append_grid_vertex(out_vertices, extent, 0.0_f32, coordinate - half_width, red, green, blue)
    }
    ret (out_vertices, append_double_sided_face(indices, base))
}

impl for MeshData {
    pub fn new(vertices: Vec[f32], indices: Vec[u32], stride: u32) -> MeshData {
        ret MeshData { vertices, indices, stride }
    }
    pub fn vertices(self: Self) -> Vec[f32] { ret self.vertices }
    pub fn indices(self: Self) -> Vec[u32] { ret self.indices }
    pub fn stride(self: Self) -> u32 { ret self.stride }
    pub fn vertex_count(self: Self) -> usize {
        ret if self.stride == 0_u32 { 0_usize } else { self.vertices.len() / ((self.stride / 4_u32) as usize) }
    }
    pub fn index_count(self: Self) -> usize { ret self.indices.len() }
}

pub fn cube_mesh(size: f32) -> MeshData {
    let h = size * 0.5_f32
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    vertices = append_vertex(vertices, -h,-h, h, 0.0_f32,0.0_f32,1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h,-h, h, 0.0_f32,0.0_f32,1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h, h, h, 0.0_f32,0.0_f32,1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h, h, h, 0.0_f32,0.0_f32,1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 0_u32)
    vertices = append_vertex(vertices,  h,-h,-h, 0.0_f32,0.0_f32,-1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h,-h,-h, 0.0_f32,0.0_f32,-1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h, h,-h, 0.0_f32,0.0_f32,-1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h, h,-h, 0.0_f32,0.0_f32,-1.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 4_u32)
    vertices = append_vertex(vertices, h,-h, h, 1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, h,-h,-h, 1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, h, h,-h, 1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, h, h, h, 1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 8_u32)
    vertices = append_vertex(vertices, -h,-h,-h, -1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h,-h, h, -1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h, h, h, -1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h, h,-h, -1.0_f32,0.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 12_u32)
    vertices = append_vertex(vertices, -h,h, h, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h,h, h, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h,h,-h, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h,h,-h, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 16_u32)
    vertices = append_vertex(vertices, -h,-h,-h, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h,-h,-h, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  h,-h, h, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, -h,-h, h, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 20_u32)
    ret MeshData::new(vertices, indices, 36_u32)
}

pub fn plane_mesh(size: f32) -> MeshData {
    let h = if size > 0.0_f32 { size * 0.5_f32 } else { 0.5_f32 }
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    vertices = append_vertex(vertices, -h,0.0_f32,-h, 0.0_f32,1.0_f32,0.0_f32, 0.72_f32,0.74_f32,0.78_f32)
    vertices = append_vertex(vertices, -h,0.0_f32, h, 0.0_f32,1.0_f32,0.0_f32, 0.72_f32,0.74_f32,0.78_f32)
    vertices = append_vertex(vertices,  h,0.0_f32, h, 0.0_f32,1.0_f32,0.0_f32, 0.72_f32,0.74_f32,0.78_f32)
    vertices = append_vertex(vertices,  h,0.0_f32,-h, 0.0_f32,1.0_f32,0.0_f32, 0.72_f32,0.74_f32,0.78_f32)
    indices = append_double_sided_face(indices, 0_u32)
    ret MeshData::new(vertices, indices, 36_u32)
}

pub fn sphere_mesh(radius: f32, rings: u32, segments: u32) -> MeshData {
    let safe_radius = if radius > 0.0_f32 { radius } else { 0.5_f32 }
    let ring_count = if rings >= 3_u32 { rings } else { 16_u32 }
    let segment_count = if segments >= 3_u32 { segments } else { 24_u32 }
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    let mut ring = 0_u32
    while ring <= ring_count {
        let vertical = (ring as f32) / (ring_count as f32)
        let phi = vertical * 3.1415927_f32
        let y = ring_cos(phi)
        let horizontal_radius = ring_sin(phi)
        let mut segment = 0_u32
        while segment <= segment_count {
            let horizontal = (segment as f32) / (segment_count as f32)
            let theta = horizontal * 6.2831855_f32
            let x = horizontal_radius * ring_cos(theta)
            let z = horizontal_radius * ring_sin(theta)
            vertices = append_vertex(vertices, x * safe_radius, y * safe_radius, z * safe_radius,
                x, y, z, 0.82_f32,0.84_f32,0.88_f32)
            segment = segment + 1_u32
        }
        ring = ring + 1_u32
    }
    ring = 0_u32
    let row = segment_count + 1_u32
    while ring < ring_count {
        let mut segment = 0_u32
        while segment < segment_count {
            let first = ring * row + segment
            let second = first + row
            if ring > 0_u32 {
                indices.push(first) indices.push(second) indices.push(first + 1_u32)
            }
            if ring + 1_u32 < ring_count {
                indices.push(first + 1_u32) indices.push(second) indices.push(second + 1_u32)
            }
            segment = segment + 1_u32
        }
        ring = ring + 1_u32
    }
    ret MeshData::new(vertices, indices, 36_u32)
}

pub fn gizmo_tip_mesh(size: f32, height: f32) -> MeshData {
    let radius = if size > 0.0_f32 { size * 0.5_f32 } else { 0.14_f32 }
    let tip_height = if height > 0.0_f32 { height } else { 0.36_f32 }
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    vertices = append_vertex(vertices, -radius,0.0_f32, radius, 0.0_f32,0.45_f32,0.89_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,  radius,0.0_f32, radius, 0.0_f32,0.45_f32,0.89_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, 0.0_f32,tip_height,0.0_f32, 0.0_f32,0.45_f32,0.89_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_triangle(indices, 0_u32)
    vertices = append_vertex(vertices, radius,0.0_f32, radius, 0.89_f32,0.45_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, radius,0.0_f32,-radius, 0.89_f32,0.45_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, 0.0_f32,tip_height,0.0_f32, 0.89_f32,0.45_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_triangle(indices, 3_u32)
    vertices = append_vertex(vertices, radius,0.0_f32,-radius, 0.0_f32,0.45_f32,-0.89_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,-radius,0.0_f32,-radius, 0.0_f32,0.45_f32,-0.89_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, 0.0_f32,tip_height,0.0_f32, 0.0_f32,0.45_f32,-0.89_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_triangle(indices, 6_u32)
    vertices = append_vertex(vertices,-radius,0.0_f32,-radius,-0.89_f32,0.45_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,-radius,0.0_f32, radius,-0.89_f32,0.45_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, 0.0_f32,tip_height,0.0_f32,-0.89_f32,0.45_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_triangle(indices, 9_u32)
    vertices = append_vertex(vertices,-radius,0.0_f32,-radius, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, radius,0.0_f32,-radius, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices, radius,0.0_f32, radius, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    vertices = append_vertex(vertices,-radius,0.0_f32, radius, 0.0_f32,-1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
    indices = append_face(indices, 12_u32)
    ret MeshData::new(vertices, indices, 36_u32)
}

pub fn gizmo_ring_mesh(radius: f32, thickness: f32, segments: u32) -> MeshData {
    let outer = if radius > 0.0_f32 { radius } else { 1.6_f32 }
    let width = if thickness > 0.0_f32 && thickness < outer { thickness } else { 0.045_f32 }
    let inner = outer - width
    let count = if segments >= 8_u32 { segments } else { 48_u32 }
    let step = 6.2831855_f32 / (count as f32)
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    let mut segment = 0_u32
    while segment < count {
        let angle0 = (segment as f32) * step
        let angle1 = ((segment + 1_u32) as f32) * step
        let x0 = ring_cos(angle0) let z0 = ring_sin(angle0)
        let x1 = ring_cos(angle1) let z1 = ring_sin(angle1)
        let base = (vertices.len() / 9_usize) as u32
        vertices = append_vertex(vertices, x0 * inner,0.0_f32,z0 * inner, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
        vertices = append_vertex(vertices, x0 * outer,0.0_f32,z0 * outer, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
        vertices = append_vertex(vertices, x1 * outer,0.0_f32,z1 * outer, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
        vertices = append_vertex(vertices, x1 * inner,0.0_f32,z1 * inner, 0.0_f32,1.0_f32,0.0_f32, 1.0_f32,1.0_f32,1.0_f32)
        indices = append_double_sided_face(indices, base)
        segment = segment + 1_u32
    }
    ret MeshData::new(vertices, indices, 36_u32)
}

pub fn editor_grid_mesh(extent: f32, divisions: u32) -> MeshData {
    let safe_extent = if extent > 0.0_f32 { extent } else { 10.0_f32 }
    let safe_divisions = if divisions > 0_u32 { divisions } else { 10_u32 }
    let spacing = safe_extent / (safe_divisions as f32)
    let line_count = safe_divisions * 2_u32
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    let mut line = 0_u32
    while line <= line_count {
        let coordinate = ((line as f32) - (safe_divisions as f32)) * spacing
        let center = line == safe_divisions
        let major = line % 5_u32 == 0_u32
        let intensity = if major { 0.18_f32 } else { 0.06_f32 }
        let half_width = spacing * if center { 0.018_f32 } else { if major { 0.012_f32 } else { 0.007_f32 } }
        let x_color = if center { 0.62_f32 } else { intensity }
        let x_green = if center { 0.08_f32 } else { intensity }
        let x_blue = if center { 0.06_f32 } else { intensity }
        let x_line = append_grid_line(vertices, indices, coordinate, safe_extent, half_width,
            false, x_color, x_green, x_blue)
        vertices = x_line.0
        indices = x_line.1
        let z_red = if center { 0.06_f32 } else { intensity }
        let z_green = if center { 0.20_f32 } else { intensity }
        let z_blue = if center { 0.66_f32 } else { intensity }
        let z_line = append_grid_line(vertices, indices, coordinate, safe_extent, half_width,
            true, z_red, z_green, z_blue)
        vertices = z_line.0
        indices = z_line.1
        line = line + 1_u32
    }
    ret MeshData::new(vertices, indices, 36_u32)
}
