import core::option::Option
import core::result::Result
import core::vec::Vec
import linalg::Vec3
import mod::primitive::MeshData

fn obj_space(byte: u8) -> bool { ret byte == 32_u8 || byte == 9_u8 || byte == 13_u8 }

fn obj_trim(value: str) -> str {
    let mut start = 0_usize
    let mut end = value.byte_len()
    while start < end && obj_space(value.byte_at(start)) { start = start + 1_usize }
    while end > start && obj_space(value.byte_at(end - 1_usize)) { end = end - 1_usize }
    ret value.slice(start, end - start)
}

fn obj_lines(source: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index < source.byte_len() {
        if source.byte_at(index) == 10_u8 { out.push(obj_trim(source.slice(start, index - start))) start = index + 1_usize }
        index = index + 1_usize
    }
    if start < source.byte_len() { out.push(obj_trim(source.slice(start, source.byte_len() - start))) }
    ret out
}

fn obj_words(line: str) -> Vec[str] {
    let mut out = Vec[str]::new()
    let mut index = 0_usize
    while index < line.byte_len() {
        while index < line.byte_len() && obj_space(line.byte_at(index)) { index = index + 1_usize }
        let start = index
        while index < line.byte_len() && !obj_space(line.byte_at(index)) { index = index + 1_usize }
        if index > start { out.push(line.slice(start, index - start)) }
    }
    ret out
}

fn obj_f32(source: str) -> Option[f32] {
    if source.byte_len() == 0_usize { ret Option[f32]::None }
    let mut index = 0_usize
    let mut sign = 1.0_f32
    if source.byte_at(index) == 45_u8 { sign = -1.0_f32 index = index + 1_usize }
    elif source.byte_at(index) == 43_u8 { index = index + 1_usize }
    let mut value = 0.0_f32
    let mut digits = 0_usize
    while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
        value = value * 10.0_f32 + ((source.byte_at(index) - 48_u8) as f32)
        digits = digits + 1_usize index = index + 1_usize
    }
    if index < source.byte_len() && source.byte_at(index) == 46_u8 {
        index = index + 1_usize
        let mut place = 0.1_f32
        while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
            value = value + ((source.byte_at(index) - 48_u8) as f32) * place
            place = place * 0.1_f32 digits = digits + 1_usize index = index + 1_usize
        }
    }
    if digits == 0_usize { ret Option[f32]::None }
    if index < source.byte_len() && (source.byte_at(index) == 101_u8 || source.byte_at(index) == 69_u8) {
        index = index + 1_usize
        let mut exponent_sign = 1_i32
        if index < source.byte_len() && source.byte_at(index) == 45_u8 { exponent_sign = -1_i32 index = index + 1_usize }
        elif index < source.byte_len() && source.byte_at(index) == 43_u8 { index = index + 1_usize }
        let mut exponent = 0_i32
        let mut exponent_digits = 0_usize
        while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
            exponent = exponent * 10_i32 + ((source.byte_at(index) - 48_u8) as i32)
            exponent_digits = exponent_digits + 1_usize index = index + 1_usize
        }
        if exponent_digits == 0_usize { ret Option[f32]::None }
        exponent = exponent * exponent_sign
        while exponent > 0_i32 { value = value * 10.0_f32 exponent = exponent - 1_i32 }
        while exponent < 0_i32 { value = value * 0.1_f32 exponent = exponent + 1_i32 }
    }
    if index != source.byte_len() { ret Option[f32]::None }
    ret Option[f32]::Some(value * sign)
}

fn obj_i32(source: str) -> Option[i32] {
    if source.byte_len() == 0_usize { ret Option[i32]::None }
    let mut index = 0_usize
    let mut sign = 1_i32
    if source.byte_at(index) == 45_u8 { sign = -1_i32 index = index + 1_usize }
    elif source.byte_at(index) == 43_u8 { index = index + 1_usize }
    if index >= source.byte_len() { ret Option[i32]::None }
    let mut value = 0_i32
    while index < source.byte_len() {
        let byte = source.byte_at(index)
        if byte < 48_u8 || byte > 57_u8 { ret Option[i32]::None }
        value = value * 10_i32 + ((byte - 48_u8) as i32)
        index = index + 1_usize
    }
    ret Option[i32]::Some(value * sign)
}

fn obj_vertex_index(reference: str, count: usize) -> Option[usize] {
    let mut end = 0_usize
    while end < reference.byte_len() && reference.byte_at(end) != 47_u8 { end = end + 1_usize }
    match obj_i32(reference.slice(0_usize, end)) {
        Option::Some(raw) => {
            if raw > 0_i32 && raw as usize <= count { ret Option[usize]::Some(raw as usize - 1_usize) }
            if raw < 0_i32 && (0_i32 - raw) as usize <= count { ret Option[usize]::Some(count - ((0_i32 - raw) as usize)) }
        }
        Option::None => {}
    }
    ret Option[usize]::None
}

fn obj_push_vertex(values: Vec[f32], position: Vec3, normal: Vec3) -> Vec[f32] {
    let mut out = values
    out.push(position.x()) out.push(position.y()) out.push(position.z())
    out.push(normal.x()) out.push(normal.y()) out.push(normal.z())
    out.push(1.0_f32) out.push(1.0_f32) out.push(1.0_f32)
    ret out
}

fn obj_position(positions: Vec[Vec3], index: usize) -> Vec3 {
    match positions.get(index) { Option::Some(value) => { ret value } Option::None => {} }
    ret Vec3::zero()
}

pub fn parse_obj(source: str) -> Result[MeshData, str] {
    let mut positions = Vec[Vec3]::new()
    let mut vertices = Vec[f32]::new()
    let mut indices = Vec[u32]::new()
    let mut line_number = 0_usize
    for line in obj_lines(source) {
        line_number = line_number + 1_usize
        if line.byte_len() == 0_usize || line.byte_at(0_usize) == 35_u8 { continue }
        let words = obj_words(line)
        if words.len() == 0_usize { continue }
        let mut kind = ""
        match words.get(0_usize) { Option::Some(value) => { kind = value } Option::None => {} }
        if kind == "v" {
            if words.len() < 4_usize { ret Result[MeshData, str]::Err("line " + line_number.fmt() + ": vertex needs three coordinates") }
            let mut parsed = Vec[f32]::new()
            let mut coordinate = 1_usize
            while coordinate < 4_usize {
                match words.get(coordinate) {
                    Option::Some(value) => { match obj_f32(value) {
                        Option::Some(number) => { parsed.push(number) }
                        Option::None => { ret Result[MeshData, str]::Err("line " + line_number.fmt() + ": invalid vertex coordinate") }
                    } }
                    Option::None => { ret Result[MeshData, str]::Err("line " + line_number.fmt() + ": missing vertex coordinate") }
                }
                coordinate = coordinate + 1_usize
            }
            let mut x = 0.0_f32 let mut y = 0.0_f32 let mut z = 0.0_f32
            match parsed.get(0_usize) { Option::Some(value) => { x = value } Option::None => {} }
            match parsed.get(1_usize) { Option::Some(value) => { y = value } Option::None => {} }
            match parsed.get(2_usize) { Option::Some(value) => { z = value } Option::None => {} }
            positions.push(Vec3::new(x, y, z))
        } elif kind == "f" {
            if words.len() < 4_usize { ret Result[MeshData, str]::Err("line " + line_number.fmt() + ": face needs at least three vertices") }
            let mut face = Vec[usize]::new()
            let mut item = 1_usize
            while item < words.len() {
                match words.get(item) {
                    Option::Some(reference) => { match obj_vertex_index(reference, positions.len()) {
                        Option::Some(index) => { face.push(index) }
                        Option::None => { ret Result[MeshData, str]::Err("line " + line_number.fmt() + ": invalid face index") }
                    } }
                    Option::None => {}
                }
                item = item + 1_usize
            }
            let mut triangle = 1_usize
            while triangle + 1_usize < face.len() {
                let mut a_index = 0_usize let mut b_index = 0_usize let mut c_index = 0_usize
                match face.get(0_usize) { Option::Some(value) => { a_index = value } Option::None => {} }
                match face.get(triangle) { Option::Some(value) => { b_index = value } Option::None => {} }
                match face.get(triangle + 1_usize) { Option::Some(value) => { c_index = value } Option::None => {} }
                let a = obj_position(positions, a_index)
                let b = obj_position(positions, b_index)
                let c = obj_position(positions, c_index)
                let normal = b.sub(a).cross(c.sub(a)).normalized()
                let base = (vertices.len() / 9_usize) as u32
                vertices = obj_push_vertex(vertices, a, normal)
                vertices = obj_push_vertex(vertices, b, normal)
                vertices = obj_push_vertex(vertices, c, normal)
                indices.push(base) indices.push(base + 1_u32) indices.push(base + 2_u32)
                triangle = triangle + 1_usize
            }
        }
    }
    if positions.len() == 0_usize { ret Result[MeshData, str]::Err("OBJ contains no vertices") }
    if indices.len() == 0_usize { ret Result[MeshData, str]::Err("OBJ contains no faces") }
    ret Result[MeshData, str]::Ok(MeshData::new(vertices, indices, 36_u32))
}
