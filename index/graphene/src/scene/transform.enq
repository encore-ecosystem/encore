import linalg::{Mat4, Vec3}

pub struct Transform { position: Vec3 rotation: Vec3 scale: Vec3 }

impl for Transform {
    pub fn identity() -> Transform {
        ret Transform { Vec3::zero(), Vec3::zero(), Vec3::new(1.0_f32, 1.0_f32, 1.0_f32) }
    }
    pub fn new(position: Vec3, rotation: Vec3, scale: Vec3) -> Transform {
        ret Transform { position, rotation, scale }
    }
    pub fn position(self: Self) -> Vec3 { ret self.position }
    pub fn rotation(self: Self) -> Vec3 { ret self.rotation }
    pub fn scale(self: Self) -> Vec3 { ret self.scale }
    pub fn matrix(self: Self) -> Mat4 { ret Mat4::trs(self.position, self.rotation, self.scale) }
    pub fn with_position(self: Self, value: Vec3) -> Transform { ret Transform { value, self.rotation, self.scale } }
    pub fn with_rotation(self: Self, value: Vec3) -> Transform { ret Transform { self.position, value, self.scale } }
    pub fn with_scale(self: Self, value: Vec3) -> Transform { ret Transform { self.position, self.rotation, value } }
}
