import core::option::Option
import core::vec::Vec
import linalg::Mat4
import mod::assets::{MaterialAssets, MeshAssets, StandardMaterial}
import mod::rhi::*
import mod::scene::camera::PerspectiveCamera
import mod::scene::light::DirectionalLight
import mod::scene::world::Scene

pub struct ObjectUniforms { buffers: Vec[GpuBuffer] groups: Vec[BindGroup] frame_count: u32 available: bool }
struct SceneObjectResources { entity: u64 uniforms: ObjectUniforms }
pub struct SceneRenderer {
    device: GraphicsDevice layout: BindGroupLayout frame_count: u32 objects: Vec[SceneObjectResources] available: bool
}

impl for ObjectUniforms {
    pub fn create(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32) -> ObjectUniforms {
        let mut buffers = Vec[GpuBuffer]::new()
        let mut groups = Vec[BindGroup]::new()
        let mut available = frame_count > 0_u32
        let mut slot = 0_u32
        while slot < frame_count {
            let buffer = device.create_buffer(192_u64, buffer_uniform(), true)
            let group = device.create_uniform_bind_group(layout, buffer, 0_u64, 192_u64)
            if !buffer.available() || !group.available() { available = false }
            buffers.push(buffer)
            groups.push(group)
            slot = slot + 1_u32
        }
        ret ObjectUniforms { buffers, groups, frame_count, available }
    }
    pub fn available(self: Self) -> bool { ret self.available }
    pub fn frame_count(self: Self) -> u32 { ret self.frame_count }
    pub fn update(self: Self, slot: u32, camera: PerspectiveCamera, model: Mat4,
        aspect: f32, light: DirectionalLight, material: StandardMaterial) -> bool {
        if !self.available || slot >= self.frame_count { ret false }
        match self.buffers.get(slot as usize) {
            Option::Some(buffer) => {
                ret buffer.write_f32s(0_u64, camera.model_view_projection(model, aspect).values()) &&
                    buffer.write_f32s(64_u64, model.values()) &&
                    buffer.write_f32s(128_u64, light.uniform_values()) &&
                    buffer.write_f32s(160_u64, material.uniform_values())
            }
            Option::None => { ret false }
        }
    }
    pub fn bind(self: Self, pass: RenderPassEncoder, slot: u32) -> bool {
        if !self.available || slot >= self.frame_count { ret false }
        match self.groups.get(slot as usize) {
            Option::Some(group) => { ret pass.bind_group(group) }
            Option::None => { ret false }
        }
    }
    pub fn destroy(self: Self) -> bool {
        let mut destroyed = true
        for group in self.groups { if !group.destroy() { destroyed = false } }
        for buffer in self.buffers { if !buffer.destroy() { destroyed = false } }
        ret destroyed
    }
}

impl for SceneRenderer {
    pub fn create(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32) -> SceneRenderer {
        ret SceneRenderer { device, layout, frame_count, Vec[SceneObjectResources]::new(),
            device.available() && layout.available() && frame_count > 0_u32 }
    }
    pub fn available(self: Self) -> bool { ret self.available }
    pub fn object_count(self: Self) -> usize { ret self.objects.len() }
    fn object_index(self: Self, entity: u64) -> Option[usize] {
        let mut index = 0_usize
        while index < self.objects.len() {
            match self.objects.get(index) {
                Option::Some(resources) => { if resources.entity == entity { ret Option[usize]::Some(index) } }
                Option::None => {}
            }
            index = index + 1_usize
        }
        ret Option[usize]::None
    }
    fn ensure_object(self: mut Self, entity: u64) -> Option[usize] {
        match self.object_index(entity) {
            Option::Some(index) => { ret Option[usize]::Some(index) }
            Option::None => {}
        }
        let uniforms = ObjectUniforms::create(self.device, self.layout, self.frame_count)
        if !uniforms.available() { uniforms.destroy() ret Option[usize]::None }
        let index = self.objects.len()
        self.objects.push(SceneObjectResources { entity, uniforms })
        ret Option[usize]::Some(index)
    }
    pub fn render_scene(self: mut Self, scene: Scene, camera: PerspectiveCamera, light: DirectionalLight,
        meshes: MeshAssets, materials: MaterialAssets, pass: RenderPassEncoder,
        frame_slot: u32, aspect: f32) -> bool {
        if !self.available || !pass.available() || frame_slot >= self.frame_count { ret false }
        let items = scene.visible_render_items()
        for item in items {
            let mut material = StandardMaterial::default()
            let mut material_found = false
            match materials.get(item.material()) {
                Option::Some(value) => { material = value material_found = true }
                Option::None => {}
            }
            if !material_found { ret false }
            let mut object_index = 0_usize
            let mut object_found = false
            match self.ensure_object(item.entity()) {
                Option::Some(value) => { object_index = value object_found = true }
                Option::None => {}
            }
            if !object_found { ret false }
            match self.objects.get(object_index) {
                Option::Some(resources) => {
                    if !resources.uniforms.update(frame_slot, camera, item.world(), aspect, light, material) ||
                        !resources.uniforms.bind(pass, frame_slot) || !meshes.draw(pass, item.mesh()) { ret false }
                }
                Option::None => { ret false }
            }
        }
        ret true
    }
    pub fn destroy(self: Self) -> bool {
        let mut destroyed = true
        for resources in self.objects { if !resources.uniforms.destroy() { destroyed = false } }
        ret destroyed
    }
}
