import core::option::Option
import core::vec::Vec
import linalg::Vec3
import mod::rhi::{GpuMesh, GraphicsDevice, RenderPassEncoder}
import mod::scene::primitive::MeshData
import mod::scene::renderable::{MaterialId, MeshId}

struct MeshAssetEntry { id: MeshId mesh: GpuMesh }
struct MaterialAssetEntry { id: MaterialId material: StandardMaterial }

pub struct MeshAssets { entries: Vec[MeshAssetEntry] next_id: u64 }
pub struct MaterialAssets { entries: Vec[MaterialAssetEntry] next_id: u64 }
pub struct StandardMaterial { base_color: Vec3 metallic: f32 roughness: f32 unlit: bool }

fn saturate(value: f32) -> f32 {
    ret if value < 0.0_f32 { 0.0_f32 } else { if value > 1.0_f32 { 1.0_f32 } else { value } }
}

impl for StandardMaterial {
    pub fn new(base_color: Vec3, metallic: f32, roughness: f32) -> StandardMaterial {
        ret StandardMaterial { base_color, saturate(metallic), saturate(roughness), false }
    }
    pub fn default() -> StandardMaterial {
        ret StandardMaterial::new(Vec3::new(1.0_f32, 1.0_f32, 1.0_f32), 0.0_f32, 0.5_f32)
    }
    pub fn base_color(self: Self) -> Vec3 { ret self.base_color }
    pub fn metallic(self: Self) -> f32 { ret self.metallic }
    pub fn roughness(self: Self) -> f32 { ret self.roughness }
    pub fn unlit(self: Self) -> bool { ret self.unlit }
    pub fn with_unlit(self: Self) -> StandardMaterial {
        ret StandardMaterial { self.base_color, self.metallic, self.roughness, true }
    }
    pub fn uniform_values(self: Self) -> Vec[f32] {
        let mut values = Vec[f32]::new()
        values.push(self.base_color.x()) values.push(self.base_color.y()) values.push(self.base_color.z()) values.push(1.0_f32)
        values.push(self.metallic) values.push(self.roughness)
        values.push(if self.unlit { 1.0_f32 } else { 0.0_f32 }) values.push(0.0_f32)
        ret values
    }
}

impl for MeshAssets {
    pub fn new() -> MeshAssets { ret MeshAssets { Vec[MeshAssetEntry]::new(), 1_u64 } }
    pub fn len(self: Self) -> usize { ret self.entries.len() }
    pub fn upload(self: mut Self, device: GraphicsDevice, data: MeshData) -> MeshId {
        let mesh = device.create_mesh(data.vertices(), data.indices())
        if !mesh.available() { ret MeshId::new(0_u64) }
        let id = MeshId::new(self.next_id)
        self.next_id = self.next_id + 1_u64
        self.entries.push(MeshAssetEntry { id, mesh })
        ret id
    }
    pub fn contains(self: Self, id: MeshId) -> bool {
        if !id.valid() { ret false }
        for entry in self.entries { if entry.id.value() == id.value() { ret entry.mesh.available() } }
        ret false
    }
    pub fn draw(self: Self, pass: RenderPassEncoder, id: MeshId) -> bool {
        for entry in self.entries {
            if entry.id.value() == id.value() { ret pass.draw_mesh(entry.mesh) }
        }
        ret false
    }
    pub fn destroy(self: Self) -> bool {
        let mut destroyed = true
        for entry in self.entries { if !entry.mesh.destroy() { destroyed = false } }
        ret destroyed
    }
}

impl for MaterialAssets {
    pub fn new() -> MaterialAssets { ret MaterialAssets { Vec[MaterialAssetEntry]::new(), 1_u64 } }
    pub fn len(self: Self) -> usize { ret self.entries.len() }
    pub fn add(self: mut Self, material: StandardMaterial) -> MaterialId {
        let id = MaterialId::new(self.next_id)
        self.next_id = self.next_id + 1_u64
        self.entries.push(MaterialAssetEntry { id, material })
        ret id
    }
    pub fn get(self: Self, id: MaterialId) -> Option[StandardMaterial] {
        if !id.valid() { ret Option[StandardMaterial]::None }
        for entry in self.entries {
            if entry.id.value() == id.value() { ret Option[StandardMaterial]::Some(entry.material) }
        }
        ret Option[StandardMaterial]::None
    }
}
