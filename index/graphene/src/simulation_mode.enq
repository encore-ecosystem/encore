pub fn normalize_simulation_mode(value: str) -> str {
    if value == "play" || value == "simulate" { ret value }
    ret ""
}

pub fn simulation_mode_active(mode: str) -> bool {
    ret normalize_simulation_mode(mode) != ""
}

pub fn simulation_mode_is_play(mode: str) -> bool {
    ret normalize_simulation_mode(mode) == "play"
}

pub fn simulation_mode_label(mode: str) -> str {
    if simulation_mode_is_play(mode) { ret "PLAYING" }
    if normalize_simulation_mode(mode) == "simulate" { ret "SIMULATING" }
    ret "EDITOR"
}

pub fn simulation_world_message(mode: str) -> str {
    if simulation_mode_is_play(mode) { ret "Play in editor running" }
    if normalize_simulation_mode(mode) == "simulate" { ret "Editor simulation running" }
    ret "Editor world ready"
}
