import core::option::Option
import linalg::Vec3

pub struct EditorTransform { position: Vec3 rotation: Vec3 scale: Vec3 }

impl for EditorTransform {
    pub fn position(self: Self) -> Vec3 { ret self.position }
    pub fn rotation(self: Self) -> Vec3 { ret self.rotation }
    pub fn scale(self: Self) -> Vec3 { ret self.scale }
}

pub fn parse_editor_scalar(source: str) -> Option[f32] {
    if source.byte_len() == 0_usize { ret Option[f32]::None }
    let mut index = 0_usize
    let mut sign = 1.0_f32
    if source.byte_at(index) == 45_u8 { sign = -1.0_f32 index = index + 1_usize }
    elif source.byte_at(index) == 43_u8 { index = index + 1_usize }
    let mut value = 0.0_f32
    let mut digits = 0_usize
    while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
        value = value * 10.0_f32 + ((source.byte_at(index) - 48_u8) as f32)
        digits = digits + 1_usize
        index = index + 1_usize
    }
    if index < source.byte_len() && source.byte_at(index) == 46_u8 {
        index = index + 1_usize
        let mut place = 0.1_f32
        while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8 {
            value = value + ((source.byte_at(index) - 48_u8) as f32) * place
            place = place * 0.1_f32
            digits = digits + 1_usize
            index = index + 1_usize
        }
    }
    if digits == 0_usize || index != source.byte_len() { ret Option[f32]::None }
    ret Option[f32]::Some(value * sign)
}

fn replace_axis(value: Vec3, axis: str, scalar: f32) -> Option[Vec3] {
    if axis == "x" { ret Option[Vec3]::Some(Vec3::new(scalar, value.y(), value.z())) }
    if axis == "y" { ret Option[Vec3]::Some(Vec3::new(value.x(), scalar, value.z())) }
    if axis == "z" { ret Option[Vec3]::Some(Vec3::new(value.x(), value.y(), scalar)) }
    ret Option[Vec3]::None
}

pub fn apply_editor_transform(field: str, source: str, position: Vec3, rotation: Vec3, scale: Vec3) -> Option[EditorTransform] {
    let mut scalar = 0.0_f32
    let mut valid = false
    match parse_editor_scalar(source) {
        Option::Some(value) => { scalar = value valid = true }
        Option::None => {}
    }
    if !valid { ret Option[EditorTransform]::None }
    if field == "transform-location-x" || field == "transform-location-y" || field == "transform-location-z" {
        match replace_axis(position, field.slice(field.byte_len() - 1_usize, 1_usize), scalar) {
            Option::Some(next) => { ret Option[EditorTransform]::Some(EditorTransform{next, rotation, scale}) }
            Option::None => {}
        }
    }
    if field == "transform-rotation-x" || field == "transform-rotation-y" || field == "transform-rotation-z" {
        match replace_axis(rotation, field.slice(field.byte_len() - 1_usize, 1_usize), scalar * 0.017453292_f32) {
            Option::Some(next) => { ret Option[EditorTransform]::Some(EditorTransform{position, next, scale}) }
            Option::None => {}
        }
    }
    if field == "transform-scale-x" || field == "transform-scale-y" || field == "transform-scale-z" {
        if scalar <= 0.0_f32 { ret Option[EditorTransform]::None }
        match replace_axis(scale, field.slice(field.byte_len() - 1_usize, 1_usize), scalar) {
            Option::Some(next) => { ret Option[EditorTransform]::Some(EditorTransform{position, rotation, next}) }
            Option::None => {}
        }
    }
    ret Option[EditorTransform]::None
}
