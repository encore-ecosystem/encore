import core::testing::*

trait Score {
    fn score(self: Self) -> usize
}

struct Fixed {
    value: usize
}

struct Bonus {
    base: usize
    extra: usize
}

impl Score for Fixed {
    fn score(self: Fixed) -> usize {
        ret self.value
    }
}

impl Score for Bonus {
    fn score(self: Bonus) -> usize {
        ret self.base + self.extra
    }
}

fn consume(value: dyn Score) -> usize {
    ret value.score()
}

fn main() -> u32 {
    let fixed = Fixed{11_usize}
    let bonus = Bonus{20_usize, 9_usize}

    let fixed_score = fixed as dyn Score
    let bonus_score = bonus as dyn Score
    let total = consume(fixed_score) + consume(bonus_score)

    if !assert(total == 40_usize) {
        ret 1_u32
    }
    ret 0_u32
}
