import core::testing::*

fn main() -> u32 {
    let x = 0_usize
    let y = 0_usize
    let r = 1_i32

    let mut count = 0_u32
    let mut sum_x = 0_i32
    let mut sum_y = 0_i32

    let mut dx = -r
    while dx <= r {
        let mut dy = -r
        while dy <= r {
            if !(dx == 0_i32 && dy == 0_i32) {
                let n_x = (x as i32) + dx
                let n_y = (y as i32) + dy
                sum_x = sum_x + n_x
                sum_y = sum_y + n_y
                count = count + 1_u32
            }
            dy += 1
        }
        dx += 1
    }

    if !assert(count == 8_u32) {
        ret 1_u32
    }
    if !assert(sum_x == 0_i32) {
        ret 1_u32
    }
    if !assert(sum_y == 0_i32) {
        ret 1_u32
    }
    ret 0_u32
}
