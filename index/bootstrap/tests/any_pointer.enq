import core::testing::*

struct Node {
    value: u32
}

fn get(node: &Node) -> u32 {
    ret node.value
}


fn main() -> u32 {
    let heap_node = Node<H>{5_u32}
    let stack_node = Node<S>{10_u32}
    let sum: u32 = get(heap_node) + get(stack_node)

    if !assert(sum == 15_u32) {
        ret 1_u32
    }
    ret 0_u32
}
