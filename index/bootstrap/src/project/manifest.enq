import core::option::Option
import core::panic::panic
import std::os::file_exists
import std::os::read_file
import std::path::Path
import std::vec::Vec

import toml::{TomlDocument, toml_get_string, toml_get_string_array, toml_parse_document}


pub struct ProjectManifest {
    name: str
    version: str
    description: str
    readme: str
    licence: str
    dependencies: Vec[str]
    build: Option[str]
}

pub fn read_project_manifest(root: Path) -> ProjectManifest {
    let manifest_path = root.join("encore.toml")
    if !file_exists(native_path(manifest_path.as_str())) {
        panic_missing_manifest(manifest_path)
    }

    let source = read_file(native_path(manifest_path.as_str()))
    let doc = toml_parse_document(source)
    let name = required_project_string(doc, "name", manifest_path)
    let version = project_string_or(doc, "version", "0.0.0")
    let description = project_string_or(doc, "description", "")
    let readme = project_string_or(doc, "readme", "README.md")
    let licence = project_string_or(doc, "licence", "MIT")
    let build = toml_get_string(doc, "project", "build")

    let mut dependencies = Vec[str]::new()
    match toml_get_string_array(doc, "project", "dependencies") {
        Option[Vec[str]]::Some(items) => {
            dependencies = items
        }
        Option[Vec[str]]::None => {
        }
    }

    if name != "core" && !contains_string(dependencies, "sys@core") {
        dependencies.push("sys@core")
    }

    ret ProjectManifest{name, version, description, readme, licence, dependencies, build}
}

fn required_project_string(doc: TomlDocument, key: str, manifest_path: Path) -> str {
    match toml_get_string(doc, "project", key) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            panic("Manifest " + manifest_path.as_str() + " is missing [project]." + key)
            ret ""
        }
    }
}

fn project_string_or(doc: TomlDocument, key: str, fallback: str) -> str {
    match toml_get_string(doc, "project", key) {
        Option[str]::Some(value) => {
            ret value
        }
        Option[str]::None => {
            ret fallback
        }
    }
}

fn contains_string(items: Vec[str], target: str) -> bool {
    let mut index = 0_usize
    while index < items.len() {
        match items.get(index) {
            Option[str]::Some(value) => {
                if value == target {
                    ret true
                }
            }
            Option[str]::None => {
            }
        }
        index = index + 1_usize
    }
    ret false
}

fn panic_missing_manifest(manifest_path: Path) -> () {
    panic("Unable to find encore.toml at " + manifest_path.as_str())
    ret ()
}

fn native_path(value: str) -> str {
    ret replace_backslashes(value)
}

fn replace_backslashes(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "/"
        }
        else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out
}
