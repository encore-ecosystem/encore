import core::io::print
import core::io::println
import colorterm::bold
import colorterm::cyan
import colorterm::dim
import colorterm::green
import colorterm::red
import colorterm::underline
import colorterm::yellow

pub struct Console {}
pub struct Spinner {
    style: str
}

impl for Console {
    pub fn new() -> Console {
        ret Console {}
    }

    pub fn print(self, message: str) -> () {
        print(message)
        ret ()
    }

    pub fn println(self, message: str) -> () {
        println(message)
        ret ()
    }

    pub fn text(self, message: str, style: str) -> () {
        println(apply_style(message, style))
        ret ()
    }

    pub fn info(self, message: str) -> () {
        println(cyan("[info] ") + message)
        ret ()
    }

    pub fn success(self, message: str) -> () {
        println(green("[ok] ") + message)
        ret ()
    }

    pub fn warn(self, message: str) -> () {
        println(yellow("[warn] ") + message)
        ret ()
    }

    pub fn error(self, message: str) -> () {
        println(red("[error] ") + message)
        ret ()
    }

    pub fn rule(self, title: str) -> () {
        println(dim("----- ") + bold(title) + dim(" -----"))
        ret ()
    }

    pub fn status(self, spinner: Spinner, frame_index: usize, message: str) -> () {
        println(cyan(spinner.frame(frame_index) + " ") + message)
        ret ()
    }

    pub fn status_ok(self, message: str) -> () {
        println(green("✔ ") + message)
        ret ()
    }

    pub fn status_fail(self, message: str) -> () {
        println(red("✖ ") + message)
        ret ()
    }
}

impl for Spinner {
    pub fn dots() -> Spinner {
        ret Spinner{"dots"}
    }

    pub fn line() -> Spinner {
        ret Spinner{"line"}
    }

    pub fn arc() -> Spinner {
        ret Spinner{"arc"}
    }

    pub fn frame(self, index: usize) -> str {
        let i = index % 4_usize
        if self.style == "line" {
            if i == 0_usize { ret "-" }
            if i == 1_usize { ret "\\" }
            if i == 2_usize { ret "|" }
            ret "/"
        }

        if self.style == "arc" {
            if i == 0_usize { ret "." }
            if i == 1_usize { ret "o" }
            if i == 2_usize { ret "O" }
            ret "o"
        }

        if i == 0_usize { ret "." }
        if i == 1_usize { ret "o" }
        if i == 2_usize { ret "O" }
        ret "o"
    }
}

pub fn apply_style(message: str, style: str) -> str {
    if style == "bold" { ret bold(message) }
    if style == "dim" { ret dim(message) }
    if style == "underline" { ret underline(message) }
    if style == "cyan" { ret cyan(message) }
    if style == "green" { ret green(message) }
    if style == "yellow" { ret yellow(message) }
    if style == "red" { ret red(message) }
    ret message
}

pub fn status(spinner: Spinner, frame_index: usize, message: str) -> str {
    ret cyan(spinner.frame(frame_index) + " ") + message
}

pub fn status_ok(message: str) -> str {
    ret green("[ok] ") + message
}

pub fn status_fail(message: str) -> str {
    ret red("[err] ") + message
}
