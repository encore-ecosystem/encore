import core::io::print
import core::io::println

import colorterm::{styled, Color, Style}

pub struct Console {}

impl for Console {
    pub fn new() -> Console {
        ret Console {}
    }

    pub fn print(self, message: str) -> () {
        print(message)
        ret ()
    }

    pub fn println(self, message: str) -> () {
        println(message)
        ret ()
    }

    pub fn info(self, message: str) -> () {
        ret self.println(styled("[info] ", Color::Cyan, Style::Normal) + message)
    }

    pub fn success(self, message: str) -> () {
        ret self.println(styled("[ok] ", Color::Green, Style::Normal) + message)
    }

    pub fn warn(self, message: str) -> () {
        ret self.println(styled("[warn] ", Color::Yellow, Style::Normal) + message)
    }

    pub fn error(self, message: str) -> () {
        ret self.println(styled("[error] ", Color::Red, Style::Normal) + message)
    }
}

pub enum SpinnerStyle {
    Dots,
    Line,
    Arc,
}

pub struct Spinner {
    style: SpinnerStyle
}

impl for Spinner {
    pub fn with_style(style: SpinnerStyle) -> Self {
        ret Self {style}
    }

    pub fn dots() -> Self {
        ret Self::with_style(SpinnerStyle::Dots)
    }

    pub fn line() -> Self {
        ret Self::with_style(SpinnerStyle::Line)
    }

    pub fn arc() -> Self {
        ret Self::with_style(SpinnerStyle::Arc)
    }

    pub fn frame(self, index: usize) -> str {
        let i = index % 4_usize
        match self.style {
            SpinnerStyle::Line => {
                if i == 0_usize { ret "-" }
                if i == 1_usize { ret "\\" }
                if i == 2_usize { ret "|" }
                ret "/"
            }
            SpinnerStyle::Arc => {
                if i == 0_usize { ret "." }
                if i == 1_usize { ret "o" }
                if i == 2_usize { ret "O" }
                ret "o"
            }
            SpinnerStyle::Dots => {
                if i == 0_usize { ret "." }
                if i == 1_usize { ret "o" }
                if i == 2_usize { ret "O" }
                ret "o"
            }
        }
    }
}

pub fn status(spinner: Spinner, index: usize, message: str) -> str {
    ret styled(spinner.frame(index), Color::Cyan, Style::Normal) + " " + message
}

pub fn status_ok(message: str) -> str {
    ret styled("[ok] ", Color::Green, Style::Normal) + message
}

pub fn status_fail(message: str) -> str {
    ret styled("[error] ", Color::Red, Style::Normal) + message
}
