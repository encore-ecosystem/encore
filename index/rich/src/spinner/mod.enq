pub enum SpinnerStyle {
    Dots,
    Line,
    Arc,
}

pub struct Spinner {
    style: SpinnerStyle
}

impl for Spinner {
    pub fn with_style(style: SpinnerStyle) -> Self {
        ret Self {style}
    }

    pub fn dots() -> Self {
        ret Self::with_style(SpinnerStyle::Dots)
    }

    pub fn line() -> Self {
        ret Self::with_style(SpinnerStyle::Line)
    }

    pub fn arc() -> Self {
        ret Self::with_style(SpinnerStyle::Arc)
    }

    pub fn frame(self, index: usize) -> str {
        let i = index % 4_usize
        match self.style {
            SpinnerStyle::Line => {
                if i == 0_usize { ret "-" }
                if i == 1_usize { ret "\\" }
                if i == 2_usize { ret "|" }
                ret "/"
            }
            SpinnerStyle::Arc => {
                if i == 0_usize { ret "." }
                if i == 1_usize { ret "o" }
                if i == 2_usize { ret "O" }
                ret "o"
            }
            SpinnerStyle::Dots => {
                if i == 0_usize { ret "." }
                if i == 1_usize { ret "o" }
                if i == 2_usize { ret "O" }
                ret "o"
            }
        }
    }
}
