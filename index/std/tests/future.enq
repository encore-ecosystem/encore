import core::future::{Future, Poll}
import std::future::block_on

struct Once {
    pending: bool
    value: u32
}

impl Future[u32] for Once {
    fn poll(self: Once) -> Poll[Once, u32] {
        if self.pending {
            ret Poll[Once, u32]::Pending(Once{false, self.value})
        }
        ret Poll[Once, u32]::Ready(self.value)
    }
}

fn main() -> u32 {
    let value = block_on[u32, Once](Once{true, 42_u32})
    if value == 42_u32 { ret 0_u32 }
    ret 1_u32
}
