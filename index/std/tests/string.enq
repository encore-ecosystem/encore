import std::string::String
import std::option::Option


fn main() -> u32 {
    let a = String::from_str("aabaacba").split_char("b")

    match a.get(0) {
        Option[String]::Some(value) => {
            if value.as_str() != "aa" {
                ret 1_u32
            }
        }
        Option[String]::None => {
            ret 1_u32
        }
    }

    match a.get(1) {
        Option[String]::Some(value) => {
            if value.as_str() != "aac" {
                ret 1_u32
            }
        }
        Option[String]::None => {
            ret 1_u32
        }
    }

    match a.get(2) {
        Option[String]::Some(value) => {
            if value.as_str() != "a" {
                ret 1_u32
            }
        }
        Option[String]::None => {
            ret 1_u32
        }
    }

    ret 0_u32
}
