pub struct Random {
    state: u64
}

impl for Random {
    pub fn new(seed: u64) -> Self {
        ret Random{seed}
    }

    pub fn seed(self: Self) -> u64 {
        ret self.state
    }

    pub fn next_u64(self: Self) -> (Random, u64) {
        let next = self.state * 6364136223846793005_u64 + 1442695040888963407_u64
        ret (Random{next}, next)
    }

    pub fn next_range(self: Self, upper: u64) -> (Random, u64) {
        let pair = self.next_u64()
        if upper == 0_u64 {
            ret (pair.0, 0_u64)
        }
        ret (pair.0, pair.1 % upper)
    }
}
