import core::os::file_exists
import core::os::mkdir
import core::os::read_dir as os_read_dir
import core::os::read_file
import core::os::remove_file as os_remove_file
import core::os::write_file
import std::string::String
import std::vec::Vec

pub fn exists(path: str) -> bool {
    ret file_exists(path)
}

pub fn read_to_string(path: str) -> String {
    ret String::from_str(read_file(path))
}

pub fn read_to_str(path: str) -> str {
    ret read_file(path)
}

pub fn write(path: str, contents: str) -> i32 {
    ret write_file(path, contents)
}

pub fn remove_file(path: str) -> i32 {
    ret os_remove_file(path)
}

pub fn create_dir(path: str) -> i32 {
    ret mkdir(path)
}

pub fn read_dir(path: str) -> Vec[str] {
    ret os_read_dir(path)
}
