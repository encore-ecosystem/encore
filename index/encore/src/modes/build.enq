import core::fmt::Debug
import core::option::Option
import std::io::println
import std::os::write_file
import std::path::Path
import std::vec::Vec

import refrain::frontend::sema::run_semantic_checks
import refrain::frontend::translator::translate_to_ehir
import refrain::project::load_binary_workspace
import refrain::project::WorkspaceModule
import refrain::project::WorkspaceRefrain
import refrain::project::workspace_root_refrain

import rich::{Spinner, status, status_ok, status_fail}

pub fn run_frontend_build() -> u32 {
    ret compile_project(Path::new(".").resolve())
}

fn compile_project(root: Path) -> u32 {
    let workspace = load_binary_workspace(root)
    let ast = workspace.flat_ast

    println(status(Spinner::dots(), 0_usize, "Bootstrap workspace"))
    println("refrains: " + Debug::fmt(workspace.refrains.len()))
    println("modules: " + Debug::fmt(workspace.modules.len()))
    println("ast nodes: " + Debug::fmt(ast.len()))

    match workspace_root_refrain(workspace) {
        Option[WorkspaceRefrain]::Some(root_refrain) => {
            println("root: " + root_refrain.name)
        }
        Option[WorkspaceRefrain]::None => {
            println(status_fail("Workspace loaded without root refrain"))
            ret 1_u32
        }
    }

    println(status(Spinner::dots(), 1_usize, "Bootstrap semantic checks"))
    if !run_workspace_semantic_checks(workspace.modules) {
        println(status_fail("Semantic checks failed"))
        ret 1_u32
    }

    println(status(Spinner::dots(), 2_usize, "Bootstrap EHIR translation"))
    let ehir_text = translate_to_ehir(ast)
    let out_path = root.join("target.bootstrap.ehir")
    let write_code = write_file(native_path(out_path.as_str()), ehir_text)
    if write_code != 0_i32 {
        println(status_fail("Failed to write translated EHIR"))
        ret 1_u32
    }
    println("ehir out: " + out_path.as_str())

    println(status_ok("Build frontend pipeline complete"))
    ret 0_u32
}

fn native_path(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "/"
        }
        else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out
}

fn run_workspace_semantic_checks(modules: Vec[WorkspaceModule]) -> bool {
    let mut index = 0_usize
    while index < modules.len() {
        match modules.get(index) {
            Option[WorkspaceModule]::Some(module) => {
                if !run_semantic_checks(module.ast) {
                    println("module: " + native_path(module.module_path.as_str()))
                    ret false
                }
            }
            Option[WorkspaceModule]::None => {
            }
        }
        index = index + 1_usize
    }
    ret true
}
