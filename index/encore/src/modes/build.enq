import core::fmt::Debug
import core::option::Option
import std::io::println
import std::os::write_file
import std::os::core_dir
import std::os::remove_file
import std::os::argc
import std::os::argv
import std::os::file_exists
import std::path::Path
import std::process::run
import std::vec::Vec

import ehirlib::parse_module_text
import ehir_llvm_backend::codegen::emit_ir

import refrain::frontend::sema::run_semantic_checks
import refrain::frontend::translator::translate_to_ehir
import refrain::frontend::parser::statements::Statement
import refrain::project::load_binary_workspace
import refrain::project::WorkspaceModule
import refrain::project::WorkspaceRefrain
import refrain::project::workspace_root_refrain

import rich::{Spinner, status, status_ok, status_fail}

pub fn run_frontend_build() -> u32 {
    ret compile_project(Path::new(".").resolve())
}

pub fn compile_project(root: Path) -> u32 {
    ret compile_project_with_profile(root, requested_profile("debug"))
}

pub fn compile_project_with_profile(root: Path, requested: str) -> u32 {
    let profile = normalize_profile(requested)
    if profile == "" {
        println(status_fail("Unknown optimization profile: " + requested))
        ret 1_u32
    }
    let workspace = load_binary_workspace(root)
    let ast = workspace.flat_ast

    println(status(Spinner::dots(), 0_usize, "Bootstrap workspace"))
    println("refrains: " + Debug::fmt(workspace.refrains.len()))
    println("modules: " + Debug::fmt(workspace.modules.len()))
    println("ast nodes: " + Debug::fmt(ast.len()))

    let mut project_name = "program"
    match workspace_root_refrain(workspace) {
        Option[WorkspaceRefrain]::Some(root_refrain) => {
            project_name = root_refrain.name
            println("root: " + root_refrain.name)
        }
        Option[WorkspaceRefrain]::None => {
            println(status_fail("Workspace loaded without root refrain"))
            ret 1_u32
        }
    }

    let target_dir = root.join("target")
    let profile_dir = target_dir.join(profile)
    if run("mkdir -p " + shell_quote(native_path(profile_dir.as_str()))) != 0_i32 {
        println(status_fail("Failed to create target directory"))
        ret 1_u32
    }
    remove_file(native_path(root.join("target.bootstrap.ehir").as_str()))
    remove_file(native_path(root.join("target.bootstrap.ll").as_str()))

    println(status(Spinner::dots(), 1_usize, "Bootstrap semantic checks"))
    if !run_workspace_semantic_checks(workspace.modules) {
        println(status_fail("Semantic checks failed"))
        ret 1_u32
    }

    println(status(Spinner::dots(), 2_usize, "Bootstrap EHIR translation"))
    let ehir_text = translate_to_ehir(ast)
    let out_path = profile_dir.join(project_name + ".ehir")
    let write_code = write_file(native_path(out_path.as_str()), ehir_text)
    if write_code != 0_i32 {
        println(status_fail("Failed to write translated EHIR"))
        ret 1_u32
    }
    println("ehir out: " + out_path.as_str())

    println(status(Spinner::dots(), 3_usize, "Bootstrap LLVM lowering"))
    let ehir_module = parse_module_text("encore_bootstrap", ehir_text)
    let llvm_text = emit_ir(ehir_module)
    let llvm_path = profile_dir.join(project_name + ".ll")
    let llvm_write_code = write_file(native_path(llvm_path.as_str()), llvm_text)
    if llvm_write_code != 0_i32 {
        println(status_fail("Failed to write translated LLVM IR"))
        ret 1_u32
    }
    println("llvm out: " + llvm_path.as_str())

    println(status(Spinner::dots(), 4_usize, "Bootstrap native link"))
    let binary_path = profile_dir.join(project_name)
    let runtime_path = Path::new(core_dir()).join("runtime.c").resolve()
    let mut native_sources = " " + shell_quote(native_path(runtime_path.as_str()))
    for refrain in workspace.refrains {
        let candidate = refrain.root.join("runtime.c").resolve()
        if candidate.as_str() != runtime_path.as_str() && file_exists(native_path(candidate.as_str())) {
            native_sources = native_sources + " " + shell_quote(native_path(candidate.as_str()))
        }
    }
    let clang_command = "clang " + clang_profile_flags(profile) + " " + shell_quote(native_path(llvm_path.as_str())) + native_sources + " -o " + shell_quote(native_path(binary_path.as_str()))
    let clang_code = run(clang_command)
    remove_file(native_path(out_path.as_str()))
    remove_file(native_path(llvm_path.as_str()))
    if clang_code != 0_i32 {
        println(status_fail("LLVM assembly or native link failed"))
        ret 1_u32
    }
    println("binary out: " + binary_path.as_str())

    println(status_ok("Self-hosted frontend and LLVM pipeline complete"))
    ret 0_u32
}

pub fn requested_profile(fallback: str) -> str {
    let mut profile = fallback
    let mut index = 2_usize
    while index < argc() {
        match argv(index) {
            Some(arg) => {
                if arg == "--" { ret profile }
                if arg == "--release" { profile = "release" }
                elif arg == "--debug" { profile = "debug" }
                elif (arg == "--profile" || arg == "--opt-profile") && index + 1_usize < argc() {
                    match argv(index + 1_usize) { Some(value) => { profile = value } None => {} }
                    index = index + 1_usize
                }
            }
            None => {}
        }
        index = index + 1_usize
    }
    ret profile
}

fn normalize_profile(profile: str) -> str {
    if profile == "debug" || profile == "release" || profile == "extreme" { ret profile }
    ret ""
}

fn clang_profile_flags(profile: str) -> str {
    if profile == "debug" { ret "-O0 -g" }
    if profile == "release" { ret "-O2" }
    ret "-O3"
}

pub fn compile_test_ast(root: Path, ast: Vec[Statement], binary_name: str) -> u32 {
    let ehir_text = translate_to_ehir(ast)
    let tests_dir = root.join("target").join("tests")
    if run("mkdir -p " + shell_quote(native_path(tests_dir.as_str()))) != 0_i32 { ret 1_u32 }
    let ehir_path = tests_dir.join(binary_name + ".ehir")
    let llvm_path = tests_dir.join(binary_name + ".ll")
    let binary_path = tests_dir.join(binary_name)
    if write_file(native_path(ehir_path.as_str()), ehir_text) != 0_i32 { ret 1_u32 }
    let llvm_text = emit_ir(parse_module_text("encore_test", ehir_text))
    if write_file(native_path(llvm_path.as_str()), llvm_text) != 0_i32 { ret 1_u32 }
    let runtime_path = Path::new(core_dir()).join("runtime.c").resolve()
    let command = "clang -O3 " + shell_quote(native_path(llvm_path.as_str())) + " " + shell_quote(native_path(runtime_path.as_str())) + " -o " + shell_quote(native_path(binary_path.as_str()))
    let clang_code = run(command)
    remove_file(native_path(ehir_path.as_str()))
    remove_file(native_path(llvm_path.as_str()))
    if clang_code != 0_i32 { ret 1_u32 }
    ret 0_u32
}

fn shell_quote(value: str) -> str {
    if value.len() == 0_usize { ret "''" }
    let mut out = "'"
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "'" { out = out + "'\\''" }
        else { out = out + ch }
        index = index + 1_usize
    }
    ret out + "'"
}

fn native_path(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch == "\\" {
            out = out + "/"
        }
        else {
            out = out + ch
        }
        index = index + 1_usize
    }
    ret out
}

fn run_workspace_semantic_checks(modules: Vec[WorkspaceModule]) -> bool {
    let mut index = 0_usize
    while index < modules.len() {
        match modules.get(index) {
            Option[WorkspaceModule]::Some(module) => {
                if !run_semantic_checks(module.ast) {
                    println("module: " + native_path(module.module_path.as_str()))
                    ret false
                }
            }
            Option[WorkspaceModule]::None => {
            }
        }
        index = index + 1_usize
    }
    ret true
}
