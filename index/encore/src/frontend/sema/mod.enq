import refrain::frontend::parser::statements::Statement
import refrain::frontend::parser::statements::FunctionItem
import core::option::Option
import std::vec::Vec
import std::io::println

pub fn run_semantic_checks(ast: Vec[Statement]) -> bool {
    let names = collect_function_names(ast)
    if has_duplicates(names) {
        println("Semantic error: duplicate function declarations")
        ret false
    }
    ret true
}

fn collect_function_names(ast: Vec[Statement]) -> Vec[str] {
    let mut out = Vec[str]::new()
    for stmt in ast {
        match stmt {
            Statement::Function(item) => {
                if function_is_active(item) {
                    out.push(function_name(item))
                }
            }
            _ => {}
        }
    }
    ret out
}

fn function_name(item: FunctionItem) -> str {
    ret item.name
}

fn function_is_active(item: FunctionItem) -> bool {
    for attr in item.attrs {
        if contains_substring(attr, "test") {
            ret false
        }
        if starts_with(attr, "cfg:") {
            let expr = attr.slice(4_usize, attr.len() - 4_usize)
            if !cfg_expr_active(expr) {
                ret false
            }
        }
    }
    ret true
}

fn cfg_expr_active(expr: str) -> bool {
    if expr == "macos" {
        ret true
    }
    if expr == "unix" {
        ret true
    }
    if expr == "linux" {
        ret false
    }
    if expr == "windows" {
        ret false
    }
    if starts_with(expr, "all(") {
        if contains_substring(expr, "not(any(linux,macos))") {
            ret false
        }
        ret contains_substring(expr, "unix")
    }
    if starts_with(expr, "any(") {
        ret contains_substring(expr, "macos") || contains_substring(expr, "unix")
    }
    ret true
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() {
        ret false
    }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn contains_substring(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut start = 0_usize
    while start + needle.len() <= value.len() {
        if value.slice(start, needle.len()) == needle {
            ret true
        }
        start = start + 1_usize
    }
    ret false
}

fn has_duplicates(items: Vec[str]) -> bool {
    let mut seen = Vec[str]::new()
    for lhs in items {
        let mut i = 0_usize
        loop {
            match seen.get(i) {
                Option[str]::Some(rhs) => {
                    if lhs == rhs {
                        ret true
                    }
                    i = i + 1_usize
                }
                Option[str]::None => { break }
            }
        }
        seen.push(lhs)
    }
    ret false
}
