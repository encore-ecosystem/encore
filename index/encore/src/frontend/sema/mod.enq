import refrain::frontend::parser::statements::Statement
import refrain::frontend::parser::statements::FunctionItem
import core::option::Option
import std::vec::Vec
import std::io::println
import refrain::target::{TargetSpec, cfg_active, host_target}

pub fn run_semantic_checks(ast: Vec[Statement]) -> bool {
    match semantic_check_error(ast) {
        Option[str]::Some(message) => {
            println("Semantic error: " + message)
            ret false
        }
        Option[str]::None => {}
    }
    ret true
}

pub fn semantic_check_error(ast: Vec[Statement]) -> Option[str] {
    ret semantic_check_error_for_target(ast, host_target())
}

pub fn semantic_check_error_for_target(ast: Vec[Statement], target: TargetSpec) -> Option[str] {
    let names = collect_function_names(ast, target)
    if has_duplicates(names) {
        ret Option[str]::Some("duplicate function declarations")
    }
    ret Option[str]::None
}

fn collect_function_names(ast: Vec[Statement], target: TargetSpec) -> Vec[str] {
    let mut out = Vec[str]::new()
    for stmt in ast {
        match stmt {
            Statement::Function(item) => {
                if function_is_active(item, target) {
                    out.push(function_name(item))
                }
            }
            _ => {}
        }
    }
    ret out
}

fn function_name(item: FunctionItem) -> str {
    ret item.name
}

fn function_is_active(item: FunctionItem, target: TargetSpec) -> bool {
    for attr in item.attrs {
        if contains_substring(attr, "test") {
            ret false
        }
        if starts_with(attr, "cfg:") {
            let expr = attr.slice(4_usize, attr.len() - 4_usize)
            if !cfg_active(target, expr) {
                ret false
            }
        }
    }
    ret true
}

fn starts_with(value: str, prefix: str) -> bool {
    if prefix.len() > value.len() {
        ret false
    }
    ret value.slice(0_usize, prefix.len()) == prefix
}

fn contains_substring(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut start = 0_usize
    while start + needle.len() <= value.len() {
        if value.slice(start, needle.len()) == needle {
            ret true
        }
        start = start + 1_usize
    }
    ret false
}

fn has_duplicates(items: Vec[str]) -> bool {
    let mut seen = Vec[str]::new()
    for lhs in items {
        let mut i = 0_usize
        loop {
            match seen.get(i) {
                Option[str]::Some(rhs) => {
                    if lhs == rhs {
                        ret true
                    }
                    i = i + 1_usize
                }
                Option[str]::None => { break }
            }
        }
        seen.push(lhs)
    }
    ret false
}
