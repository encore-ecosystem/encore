import core::option::Option
import std::os::{arch_name, env, os_name}
import std::vec::Vec

pub struct TargetSpec {
    triple: str
    arch: str
    vendor: str
    os: str
    environment: str
    family: str
    pointer_width: usize
    executable_suffix: str
    freestanding: bool
}

pub struct Toolchain {
    compiler: str
    linker: str
    archiver: str
    sysroot: str
    cpu: str
    features: str
    compile_args: Vec[str]
    link_args: Vec[str]
    runtime_sources: Vec[str]
    linker_script: str
    hosted_runtime: bool
}

pub fn host_target() -> TargetSpec {
    ret parse_target(host_triple())
}

pub fn host_triple() -> str {
    let arch = canonical_arch(arch_name())
    let os = os_name()
    if os == "windows" { ret arch + "-pc-windows-msvc" }
    if os == "macos" { ret arch + "-apple-darwin" }
    if os == "linux" { ret arch + "-unknown-linux-gnu" }
    ret arch + "-unknown-" + os
}

pub fn parse_target(raw: str) -> TargetSpec {
    let triple = if raw == "" || raw == "auto" || raw == "host" || raw == "native" { host_triple() } else { raw }
    let arch = canonical_arch(segment(triple, 0_usize))
    let vendor = segment(triple, 1_usize)
    let os = target_os(triple)
    let environment = target_environment(triple, os)
    let family = if os == "windows" { "windows" } elif os == "none" || os == "unknown" { "none" } else { "unix" }
    let pointer_width = if arch == "x86_64" || arch == "aarch64" || arch == "riscv64" || arch == "wasm64" { 64_usize } else { 32_usize }
    let executable_suffix = if os == "windows" { ".exe" } else { "" }
    let freestanding = os == "none" || os == "unknown" || environment == "eabi" || environment == "eabihf"
    ret TargetSpec{triple, arch, vendor, os, environment, family, pointer_width, executable_suffix, freestanding}
}

pub fn default_toolchain(target: TargetSpec) -> Toolchain {
    let compiler = env_or("ENCORE_CC", "clang")
    let linker = env_or("ENCORE_LINKER", compiler)
    let archiver = env_or("ENCORE_AR", "llvm-ar")
    let sysroot = env_or("ENCORE_SYSROOT", "")
    let cpu = env_or("ENCORE_TARGET_CPU", "")
    let features = env_or("ENCORE_TARGET_FEATURES", "")
    ret Toolchain{compiler, linker, archiver, sysroot, cpu, features, Vec[str]::new(), Vec[str]::new(), Vec[str]::new(), "", !target.freestanding}
}

pub fn target_is_host(target: TargetSpec) -> bool { ret target.triple == host_triple() }
pub fn target_executable_name(target: TargetSpec, name: str) -> str { ret name + target.executable_suffix }

pub fn cfg_active(target: TargetSpec, expr: str) -> bool {
    let value = compact(expr)
    if starts_with(value, "not(") && ends_with(value, ")") {
        ret !cfg_active(target, value.slice(4_usize, value.len() - 5_usize))
    }
    if starts_with(value, "all(") && ends_with(value, ")") {
        ret cfg_list(target, value.slice(4_usize, value.len() - 5_usize), true)
    }
    if starts_with(value, "any(") && ends_with(value, ")") {
        ret cfg_list(target, value.slice(4_usize, value.len() - 5_usize), false)
    }
    if starts_with(value, "target_os=") { ret strip_quotes(value.slice(10_usize, value.len() - 10_usize)) == target.os }
    if starts_with(value, "target_arch=") { ret strip_quotes(value.slice(12_usize, value.len() - 12_usize)) == target.arch }
    if starts_with(value, "target_env=") { ret strip_quotes(value.slice(11_usize, value.len() - 11_usize)) == target.environment }
    if starts_with(value, "target_family=") { ret strip_quotes(value.slice(14_usize, value.len() - 14_usize)) == target.family }
    if value == "unix" || value == "windows" || value == "none" { ret value == target.family }
    if value == "linux" || value == "macos" || value == "windows" { ret value == target.os }
    ret false
}

fn cfg_list(target: TargetSpec, body: str, require_all: bool) -> bool {
    let mut start = 0_usize
    let mut index = 0_usize
    let mut depth = 0_usize
    while index <= body.len() {
        let at_end = index == body.len()
        let ch = if at_end { "," } else { body.slice(index, 1_usize) }
        if ch == "(" { depth = depth + 1_usize }
        elif ch == ")" { depth = depth - 1_usize }
        if ch == "," && depth == 0_usize {
            let active = cfg_active(target, body.slice(start, index - start))
            if require_all && !active { ret false }
            if !require_all && active { ret true }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret require_all
}

fn target_os(triple: str) -> str {
    if contains(triple, "windows") { ret "windows" }
    if contains(triple, "darwin") || contains(triple, "apple") { ret "macos" }
    if contains(triple, "linux") { ret "linux" }
    if contains(triple, "freebsd") { ret "freebsd" }
    if contains(triple, "android") { ret "android" }
    if contains(triple, "wasi") { ret "wasi" }
    if contains(triple, "none") { ret "none" }
    ret "unknown"
}

fn target_environment(triple: str, os: str) -> str {
    if contains(triple, "msvc") { ret "msvc" }
    if contains(triple, "musl") { ret "musl" }
    if contains(triple, "gnueabihf") { ret "gnueabihf" }
    if contains(triple, "gnu") { ret "gnu" }
    if contains(triple, "eabihf") { ret "eabihf" }
    if contains(triple, "eabi") { ret "eabi" }
    if os == "wasi" { ret "wasi" }
    ret ""
}

fn canonical_arch(value: str) -> str {
    if value == "amd64" { ret "x86_64" }
    if value == "arm64" { ret "aarch64" }
    if starts_with(value, "i") && ends_with(value, "86") { ret "i686" }
    ret value
}

fn env_or(name: str, fallback: str) -> str {
    match env(name) { Option[str]::Some(value) => { ret value } Option[str]::None => { ret fallback } }
}

fn segment(value: str, wanted: usize) -> str {
    let mut current = 0_usize
    let mut start = 0_usize
    let mut index = 0_usize
    while index <= value.len() {
        if index == value.len() || value.slice(index, 1_usize) == "-" {
            if current == wanted { ret value.slice(start, index - start) }
            current = current + 1_usize
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    ret "unknown"
}

fn compact(value: str) -> str {
    let mut out = ""
    let mut index = 0_usize
    while index < value.len() {
        let ch = value.slice(index, 1_usize)
        if ch != " " && ch != "\t" && ch != "\n" { out = out + ch }
        index = index + 1_usize
    }
    ret out
}
fn strip_quotes(value: str) -> str {
    if value.len() >= 2_usize && value.slice(0_usize, 1_usize) == "\"" && value.slice(value.len() - 1_usize, 1_usize) == "\"" { ret value.slice(1_usize, value.len() - 2_usize) }
    ret value
}
fn starts_with(value: str, prefix: str) -> bool { ret prefix.len() <= value.len() && value.slice(0_usize, prefix.len()) == prefix }
fn ends_with(value: str, suffix: str) -> bool { ret suffix.len() <= value.len() && value.slice(value.len() - suffix.len(), suffix.len()) == suffix }
fn contains(value: str, needle: str) -> bool {
    let mut index = 0_usize
    while index + needle.len() <= value.len() { if value.slice(index, needle.len()) == needle { ret true } index = index + 1_usize }
    ret false
}

#attr(test)
fn target_linux_contract() -> bool {
    let target = parse_target("aarch64-unknown-linux-gnu")
    ret target.arch == "aarch64" && target.os == "linux" && target.environment == "gnu" && target.family == "unix" && target.pointer_width == 64_usize && !target.freestanding
}

#attr(test)
fn target_windows_contract() -> bool {
    let target = parse_target("x86_64-pc-windows-msvc")
    ret target.os == "windows" && target.environment == "msvc" && target.executable_suffix == ".exe" && cfg_active(target, "all(windows, target_arch = \"x86_64\")")
}

#attr(test)
fn target_bare_metal_contract() -> bool {
    let target = parse_target("thumbv7em-none-eabihf")
    ret target.arch == "thumbv7em" && target.os == "none" && target.family == "none" && target.freestanding && cfg_active(target, "not(unix)")
}
