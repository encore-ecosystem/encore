import core::testing::*

fn main() -> u32 {
    let a = 7_u16
    let b = a as u32
    let c = b as usize
    let d = c as i32
    let e = 3_u64 as f32
    let f = -2_i32 as f32
    let g = 4.75_f32 as i32

    if !assert(b == 7_u32) {
        ret 1_u32
    }
    if !assert(c == 7_usize) {
        ret 1_u32
    }
    if !assert(d == 7_i32) {
        ret 1_u32
    }
    if !assert(e > 2.9_f32 && e < 3.1_f32) {
        ret 1_u32
    }
    if !assert(f > -2.1_f32 && f < -1.9_f32) {
        ret 1_u32
    }
    if !assert(g == 4_i32) {
        ret 1_u32
    }
    ret 0_u32
}
