import core::testing::*
import core::option::Option as Opt

fn main() -> u32 {
    let value = Opt[u32]::Some(3_u32)
    match value {
        Opt[u32]::Some(v) => {
            if !assert(v == 3_u32) {
                ret 1_u32
            }
        }
        Opt[u32]::None => {
            ret 1_u32
        }
    }
    ret 0_u32
}
