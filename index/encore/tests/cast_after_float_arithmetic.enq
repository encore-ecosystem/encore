import core::testing::*

struct Camera {
    d: f32
    angle: f32
}

impl for Camera {
    pub fn get_screen_width(self: Self) -> i32 {
        let result = (2 * self.d * self.angle) as i32
        ret result
    }

    pub fn get_screen_height(self: Self) -> i32 {
        ret (2 * self.d * self.angle) as i32
    }
}

fn main() -> u32 {
    let camera = Camera { 3.0_f32, 2.0_f32 }
    if !assert(camera.get_screen_width() == 12_i32) {
        ret 1_u32
    }
    if !assert(camera.get_screen_height() == 12_i32) {
        ret 1_u32
    }
    ret 0_u32
}
