import core::testing::*

trait Metrics {
    fn id(self: Self) -> usize
    fn level(self: Self) -> usize
    fn is_hot(self: Self) -> usize
}

struct Sensor {
    ident: usize
    heat: usize
}

struct Holder {
    item: dyn Metrics
    tag: usize
}

impl Metrics for Sensor {
    fn id(self: Sensor) -> usize {
        ret self.ident
    }

    fn level(self: Sensor) -> usize {
        ret self.heat
    }

    fn is_hot(self: Sensor) -> usize {
        if self.heat > 10_usize {
            ret 1_usize
        }
        ret 0_usize
    }
}

fn forward(value: dyn Metrics) -> dyn Metrics {
    ret value
}

fn score(holder: Holder) -> usize {
    let item = holder.item
    ret item.id() + item.level() + item.is_hot() + holder.tag
}

fn main() -> u32 {
    let sensor = Sensor{7_usize, 15_usize}
    let holder = Holder{forward(sensor as dyn Metrics), 5_usize}

    if !assert(score(holder) == 28_usize) {
        ret 1_u32
    }
    ret 0_u32
}
