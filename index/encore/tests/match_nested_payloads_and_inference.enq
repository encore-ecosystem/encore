import core::option::Option
import core::result::Result
import core::testing::*

enum Cell {
    Empty
    Number(u32)
    Text(str)
    Wrapped(Result[Option[u32], str])
}

fn score(cell: Cell) -> u32 {
    match cell {
        Cell::Empty => {
            ret 0_u32
        }
        Cell::Number(value) => {
            ret value
        }
        Cell::Text(text) => {
            if text == "hot" {
                ret 7_u32
            }
            ret 1_u32
        }
        Cell::Wrapped(result) => {
            match result {
                Result::Ok(maybe) => {
                    match maybe {
                        Option::Some(value) => {
                            ret value
                        }
                        Option::None => {
                            ret 3_u32
                        }
                    }
                }
                Result::Err(message) => {
                    if message == "missing" {
                        ret 5_u32
                    }
                    ret 2_u32
                }
            }
        }
    }
}

fn main() -> u32 {
    let a = score(Cell::Empty)
    let b = score(Cell::Number(11_u32))
    let c = score(Cell::Text("hot"))
    let d = score(Cell::Wrapped(Result[Option[u32], str]::Ok(Option[u32]::Some(13_u32))))
    let e = score(Cell::Wrapped(Result[Option[u32], str]::Ok(Option[u32]::None)))
    let f = score(Cell::Wrapped(Result[Option[u32], str]::Err("missing")))

    if !assert(a + b + c + d + e + f == 39_u32) {
        ret 1_u32
    }
    ret 0_u32
}
