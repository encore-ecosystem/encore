import core::testing::*
import core::option::Option
import colorterm::{styled, Color, Style}

fn main() -> u32 {
    let colored = styled("x", Color::Red, Style::Normal)

    match colored.get_byte(0_usize) {
        Option::Some(b) => {
            if !assert(b == 27_u8) {
                ret 1_u32
            }
        }
        Option::None => {
            ret 1_u32
        }
    }

    let emoji = "\u{1F680}"
    if !assert(emoji.len() == 4_usize) {
        ret 1_u32
    }
    if !assert(emoji.char_len() == 1_usize) {
        ret 1_u32
    }

    ret 0_u32
}
