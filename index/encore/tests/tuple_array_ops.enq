import core::testing::*

fn main() -> u32 {
    let t: (u32, u32, u32) = (2_u32, 4_u32, 6_u32)
    let a: [u32; 4] = [3_u32, 5_u32, 7_u32, 9_u32]
    let b: [u32; 3] = [11_u32; 3]

    let total = t.0 + t.1 + t.2 + a[2_u32] + b[1_u32]
    if !assert(total == 30_u32) {
        ret 1_u32
    }
    ret 0_u32
}
