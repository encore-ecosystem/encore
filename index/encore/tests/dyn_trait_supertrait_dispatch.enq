import core::testing::*

trait Parent {
    fn base(self: Self) -> usize
}

trait Child < Parent {
    fn child(self: Self) -> usize
}

struct Counter {
    value: usize
}

impl Child for Counter {
    fn base(self: Counter) -> usize {
        ret self.value
    }

    fn child(self: Counter) -> usize {
        ret self.value + 1_usize
    }
}

fn use_parent_method(value: dyn Child) -> usize {
    ret value.base()
}

fn use_child_method(value: dyn Child) -> usize {
    ret value.child()
}

fn main() -> u32 {
    let counter = Counter{41_usize}
    let value = counter as dyn Child

    let parent_result = use_parent_method(value)
    let child_result = use_child_method(value)

    if !assert(parent_result == 41_usize) {
        ret 1_u32
    }
    if !assert(child_result == 42_usize) {
        ret 1_u32
    }
    ret 0_u32
}
