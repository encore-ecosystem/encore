import core::option::Option
import core::result::Result
import core::testing::*
import core::vec::Vec

struct Record {
    name: str
    tags: Vec[str]
}

fn make_record(prefix: str, index: usize) -> Record {
    let mut tags = Vec[str]::new()
    tags.push(prefix + "-tag")
    tags.push(f"{prefix}-{index}")
    ret Record { prefix + "-record", tags }
}

fn build_records(count: usize) -> Vec[Record] {
    let mut records = Vec[Record]::new()
    for index in 0..count {
        records.push(make_record("item", index))
    }
    ret records
}

fn check_nested_vec_replace_and_pop() -> bool {
    let mut nested = Vec[Vec[str]]::new()

    let mut first = Vec[str]::new()
    first.push("a" + "b")
    first.push("c" + "d")
    nested.push(first)

    let alias = nested.get(0_usize)

    let mut replacement = Vec[str]::new()
    replacement.push("replacement")
    nested.set(0_usize, replacement)

    match alias {
        Option::Some(values) => {
            if !assert(values.len() == 2_usize) {
                ret false
            }
        }
        Option::None => {
            ret false
        }
    }

    let popped = nested.pop()
    match popped {
        Option::Some(values) => {
            if !assert(values.len() == 1_usize) {
                ret false
            }
        }
        Option::None => {
            ret false
        }
    }

    nested.clear()
    ret nested.is_empty()
}

fn check_result_payload_drop() -> bool {
    let result: Result[Vec[str], str] = Result::Ok(Vec[str]::singleton("ok" + "!"))
    match result {
        Result::Ok(values) => {
            ret values.len() == 1_usize
        }
        Result::Err(_) => {
            ret false
        }
    }
}

fn main() -> u32 {
    let mut records = build_records(8_usize)
    if !assert(records.len() == 8_usize) {
        ret 1_u32
    }

    let held = records.get(2_usize)
    records.set(2_usize, make_record("replacement", 22_usize))

    match held {
        Option::Some(record) => {
            if !assert(record.name == "item-record") {
                ret 1_u32
            }
            if !assert(record.tags.len() == 2_usize) {
                ret 1_u32
            }
        }
        Option::None => {
            ret 1_u32
        }
    }

    let removed = records.pop()
    match removed {
        Option::Some(record) => {
            if !assert(record.tags.len() == 2_usize) {
                ret 1_u32
            }
        }
        Option::None => {
            ret 1_u32
        }
    }

    records.clear()
    if !assert(records.is_empty()) {
        ret 1_u32
    }

    if !assert(check_nested_vec_replace_and_pop()) {
        ret 1_u32
    }

    if !assert(check_result_payload_drop()) {
        ret 1_u32
    }

    ret 0_u32
}
