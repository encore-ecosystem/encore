import core::testing::assert
import core::vec::Vec

struct Bag {
    label: str
    values: Vec[str]
}

impl for Bag {
    fn add(self: mut Self, value: str) -> () {
        self.values.push(value)
        ret ()
    }
}

fn main() -> u32 {
    let mut bag = Bag { "active", Vec[str]::new() }
    bag.add("first")
    bag.add("second")
    if !assert(bag.label == "active") { ret 1_u32 }
    if !assert(bag.values.len() == 2_usize) { ret 1_u32 }
    if !assert(bag.values.get(1_usize).unwrap_or("") == "second") { ret 1_u32 }
    ret 0_u32
}
