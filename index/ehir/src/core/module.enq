import std::vec::Vec

import refrain::core::directives::Directive

pub struct EhirImport {
    module_id: str
}

pub struct Module {
    name: str
    imports: Vec[EhirImport]
    directives: Vec[Directive]
}

pub struct ModuleBundle {
    entry_module: str
    modules: Vec[Module]
}

pub fn ehir_import(module_id: str) -> EhirImport {
    ret EhirImport{module_id}
}

pub fn make_module(name: str, directives: Vec[Directive]) -> Module {
    ret Module{name, Vec[EhirImport]::new(), directives}
}

pub fn make_module_with_imports(name: str, imports: Vec[EhirImport], directives: Vec[Directive]) -> Module {
    ret Module{name, imports, directives}
}

pub fn make_module_bundle(entry_module: str, modules: Vec[Module]) -> ModuleBundle {
    ret ModuleBundle{entry_module, modules}
}

pub fn flatten_module_bundle(name: str, bundle: ModuleBundle) -> Module {
    let mut directives = Vec[Directive]::new()
    for module in bundle.modules { directives.extend(module.directives) }
    ret make_module(name, directives)
}
