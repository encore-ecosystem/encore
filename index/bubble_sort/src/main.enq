import std::{
    vec::Vec,
    fmt::Debug,
    io::println,
    option::Option,
}

fn bubble_sort(values: Vec[i32]) -> Vec[i32] {
    let mut out = values
    let n = out.len()
    if n < 2_usize {
        ret out
    }

    let mut i = 0_usize
    while i < n {
        let mut j = 0_usize
        while j + 1_usize < n - i {
            let mut a = 0_i32
            match out.get(j) {
                Option::Some(v) => {
                    a = v
                }
                Option::None => {}
            }
            let mut b = 0_i32
            match out.get(j + 1_usize) {
                Option::Some(v) => {
                    b = v
                }
                Option::None => {}
            }

            if a > b {
                out = out.set(j, b)
                out = out.set(j + 1_usize, a)
            }
            j = j + 1_usize
        }
        i = i + 1_usize
    }
    ret out
}

fn main() -> u32 {
    let data = Vec[i32]::new()
        .push(8_i32)
        .push(1_i32)
        .push(6_i32)
        .push(2_i32)
        .push(9_i32)
        .push(4_i32)

    println("Before: " + Debug::fmt(data))
    let sorted = bubble_sort(data)
    println("After : " + Debug::fmt(sorted))
    ret 0_u32
}
