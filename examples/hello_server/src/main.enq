import core::result::Result

import std::io::{eprintln, println}

import network::{ListenOptions, Listener}
fn main() -> u32 {
    println("Listening on 127.0.0.1:8080")
    let listener = match Listener::bind(ListenOptions::tcp("127.0.0.1", 8080_usize)) {
        Result::Ok(value) => value
        Result::Err(error) => {
            eprintln(error.message) ret 1_u32
        }
    }
    with listener as listener {
        let stream = match listener.accept() {
            Result::Ok(value) => value
            Result::Err(error) => {
                eprintln(error.message) ret 1_u32
            }
        }
        with stream as stream {
            if stream.write_all("Hello, World!\n").is_err() {
                ret 1_u32
            }
        }
    }
    ret 0_u32
}
