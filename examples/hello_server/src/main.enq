import std::io::eprintln
import std::io::println
import std::net::TcpListener
import std::net::TcpStream
import std::net::socket_addr
import core::result::Result

fn main() -> u32 {
    let addr = socket_addr("127.0.0.1", 8080_usize)
    println("Listening on " + addr)

    let listener_result = TcpListener::bind(addr)
    match listener_result {
        Result[TcpListener, str]::Ok(listener) => {
            match listener.accept() {
                Result[TcpStream, str]::Ok(stream) => {
                    let _written = stream.write("Hello, World!\n")
                    let _stream_closed = stream.close()
                    let _listener_closed = listener.close()
                    ret 0_u32
                }
                Result[TcpStream, str]::Err(err) => {
                    eprintln("accept failed: " + err)
                    let _listener_closed_on_error = listener.close()
                    ret 1_u32
                }
            }
        }
        Result[TcpListener, str]::Err(err) => {
            eprintln("bind failed: " + err)
            ret 1_u32
        }
    }
}
