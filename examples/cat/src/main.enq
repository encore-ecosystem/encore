import std::io::eprintln
import std::io::print
import std::os::argv
import std::os::read_file
import core::option::Option

fn main() -> u32 {
    match argv(1_usize) {
        Option[str]::Some(path) => {
            print(read_file(path))
            ret 0_u32
        }
        Option[str]::None => {
            eprintln("usage: cat <file>")
            ret 1_u32
        }
    }
}
