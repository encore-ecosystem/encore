import core::{
    vec::Vec,
    fmt::Debug,
    io::println,
    option::Option,
}

struct Edge {
    from: usize
    ch: str
    to: usize
}

struct Hit {
    pattern: str
    start: usize
    end: usize
}

struct Machine {
    edges: Vec[Edge]
    fail: Vec[usize]
    patterns: Vec[str]
    terminal: Vec[usize]
}

fn find_edge(edges: Vec[Edge], from: usize, ch: str) -> Option[usize] {
    let mut i = 0_usize
    loop {
        match edges.get(i) {
            Option[Edge]::Some(edge) => {
                if edge.from == from && edge.ch == ch {
                    ret Option[usize]::Some(edge.to)
                }
                i = i + 1_usize
            }
            Option[Edge]::None => {
                break
            }
        }
    }
    ret Option[usize]::None
}

fn build_machine(patterns: Vec[str]) -> Machine {
    let mut edges = Vec[Edge]::new()
    let mut fail = Vec[usize]::new()
    fail.push(0_usize)
    let mut terminal = Vec[usize]::new()

    let mut pidx = 0_usize
    loop {
        match patterns.get(pidx) {
            Option[str]::Some(pat) => {
                let mut state = 0_usize
                let mut i = 0_usize
                loop {
                    if i >= pat.len() {
                        break
                    }
                    match pat.get(i) {
                        Option[str]::Some(ch) => {
                            match find_edge(edges, state, ch) {
                                Option[usize]::Some(to) => {
                                    state = to
                                }
                                Option[usize]::None => {
                                    let new_state = fail.len()
                                    edges.push(Edge{state, ch, new_state})
                                    fail.push(0_usize)
                                    state = new_state
                                }
                            }
                        }
                        Option[str]::None => {
                            break
                        }
                    }
                    i = i + 1_usize
                }
                terminal.push(state)
                pidx = pidx + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }

    let mut q = Vec[usize]::new()
    let mut i = 0_usize
    loop {
        match edges.get(i) {
            Option[Edge]::Some(edge) => {
                if edge.from == 0_usize {
                    q.push(edge.to)
                }
                i = i + 1_usize
            }
            Option[Edge]::None => {
                break
            }
        }
    }

    let mut head = 0_usize
    while head < q.len() {
        let mut current = 0_usize
        match q.get(head) {
            Option[usize]::Some(v) => {
                current = v
            }
            Option[usize]::None => {}
        }
        head = head + 1_usize

        let mut eidx = 0_usize
        loop {
            match edges.get(eidx) {
                Option[Edge]::Some(edge) => {
                    if edge.from == current {
                        let mut fallback = 0_usize
                        match fail.get(current) {
                            Option[usize]::Some(v) => {
                                fallback = v
                            }
                            Option[usize]::None => {}
                        }

                        loop {
                            match find_edge(edges, fallback, edge.ch) {
                                Option[usize]::Some(to_state) => {
                                    fail.set(edge.to, to_state)
                                    break
                                }
                                Option[usize]::None => {
                                    if fallback == 0_usize {
                                        fail.set(edge.to, 0_usize)
                                        break
                                    }
                                    match fail.get(fallback) {
                                        Option[usize]::Some(v) => {
                                            fallback = v
                                        }
                                        Option[usize]::None => {
                                            fallback = 0_usize
                                        }
                                    }
                                }
                            }
                        }
                        q.push(edge.to)
                    }
                    eidx = eidx + 1_usize
                }
                Option[Edge]::None => {
                    break
                }
            }
        }
    }

    ret Machine{edges, fail, patterns, terminal}
}

fn collect_hits(machine: Machine, state: usize, index: usize, hits: Vec[Hit]) -> Vec[Hit] {
    let mut out = hits
    let mut check_state = state
    loop {
        let mut pidx = 0_usize
        loop {
            match machine.terminal.get(pidx) {
                Option[usize]::Some(term_state) => {
                    if term_state == check_state {
                        match machine.patterns.get(pidx) {
                            Option[str]::Some(pat) => {
                                let plen = pat.len()
                                if index + 1_usize >= plen {
                                    out.push(Hit{
                                        pat,
                                        index + 1_usize - plen,
                                        index + 1_usize
                                    })
                                }
                            }
                            Option[str]::None => {}
                        }
                    }
                    pidx = pidx + 1_usize
                }
                Option[usize]::None => {
                    break
                }
            }
        }

        if check_state == 0_usize {
            break
        }
        match machine.fail.get(check_state) {
            Option[usize]::Some(v) => {
                check_state = v
            }
            Option[usize]::None => {
                break
            }
        }
    }
    ret out
}

fn search(text: str, patterns: Vec[str]) -> Vec[Hit] {
    let machine = build_machine(patterns)
    let mut hits = Vec[Hit]::new()
    let mut state = 0_usize
    let mut i = 0_usize
    loop {
        if i >= text.len() {
            break
        }
        match text.get(i) {
            Option[str]::Some(ch) => {
                loop {
                    match find_edge(machine.edges, state, ch) {
                        Option[usize]::Some(next_state) => {
                            state = next_state
                            break
                        }
                        Option[usize]::None => {
                            if state == 0_usize {
                                break
                            }
                            match machine.fail.get(state) {
                                Option[usize]::Some(v) => {
                                    state = v
                                }
                                Option[usize]::None => {
                                    state = 0_usize
                                }
                            }
                        }
                    }
                }
                hits = collect_hits(machine, state, i, hits)
            }
            Option[str]::None => {
                break
            }
        }
        i = i + 1_usize
    }
    ret hits
}

fn main() -> u32 {
    let mut patterns = Vec[str]::new()
    patterns.push("he")
    patterns.push("she")
    patterns.push("his")
    patterns.push("hers")

    let text = "ushers and his history"
    let hits = search(text, patterns)

    println("Text: " + text)
    println("Matches count: " + Debug::fmt(hits.len()))
    for hit in hits {
        println(
            "pattern=" + hit.pattern
            + " start=" + Debug::fmt(hit.start)
            + " end=" + Debug::fmt(hit.end)
        )
    }
    ret 0_u32
}
