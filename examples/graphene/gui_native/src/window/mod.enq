import gui_core::color::Color
import gui_core::geometry::Rect
import gui_core::window::WindowDesc

extern fn __ehir_rt_gui_window_create(title: str, width: u32, height: u32) -> usize
extern fn __ehir_rt_gui_window_is_open(handle: usize) -> bool
extern fn __ehir_rt_gui_window_poll(handle: usize) -> bool
extern fn __ehir_rt_gui_window_clear(handle: usize, color_rgb: u32) -> bool
extern fn __ehir_rt_gui_window_fill_rect(handle: usize, x: i32, y: i32, width: u32, height: u32, color_rgb: u32) -> bool
extern fn __ehir_rt_gui_window_present(handle: usize) -> bool
extern fn __ehir_rt_gui_window_destroy(handle: usize) -> bool

pub struct Window {
    handle: usize
    open: bool
    width: u32
    height: u32
}

impl for Window {
    pub fn open(desc: WindowDesc) -> Window {
        let handle = unsafe {
            __ehir_rt_gui_window_create(desc.title, desc.width, desc.height)
        }
        ret Window { handle, handle != 0_usize, desc.width, desc.height }
    }

    pub fn is_valid(self: Self) -> bool {
        ret self.handle != 0_usize
    }

    pub fn is_open(self: Self) -> bool {
        if self.handle == 0_usize || !self.open {
            ret false
        }
        unsafe {
            ret __ehir_rt_gui_window_is_open(self.handle)
        }
    }

    pub fn poll(self: mut Self) -> bool {
        if self.handle == 0_usize || !self.open {
            self.open = false
            ret false
        }

        let alive = unsafe {
            __ehir_rt_gui_window_poll(self.handle)
        }
        self.open = alive
        ret alive
    }

    pub fn clear(self: Self, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret __ehir_rt_gui_window_clear(self.handle, color.to_rgb_u32())
        }
    }

    pub fn fill_rect(self: Self, rect: Rect, color: Color) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret __ehir_rt_gui_window_fill_rect(self.handle, rect.x, rect.y, rect.width, rect.height, color.to_rgb_u32())
        }
    }

    pub fn present(self: Self) -> bool {
        if self.handle == 0_usize {
            ret false
        }
        unsafe {
            ret __ehir_rt_gui_window_present(self.handle)
        }
    }

    pub fn close(self: mut Self) -> bool {
        if self.handle == 0_usize {
            self.open = false
            ret false
        }

        let ok = unsafe {
            __ehir_rt_gui_window_destroy(self.handle)
        }
        self.handle = 0_usize
        self.open = false
        ret ok
    }
}
