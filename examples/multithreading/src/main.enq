import core::fmt::Debug
import core::io::println
import core::thread::available_parallelism
import core::time::perf_counter_ms

fn sum_range(first: u64, last: u64) -> u64 {
    let mut total = 0_u64
    let mut value = first
    while value <= last {
        total += value
        value += 1_u64
    }
    ret total
}

fn main() -> u32 {
    println("logical CPUs available: " + Debug::fmt(available_parallelism()))
    println("spawning two native worker threads")

    let started = perf_counter_ms()
    let left = spawn sum_range(1_u64, 10000000_u64)
    let right = spawn sum_range(10000001_u64, 20000000_u64)

    // Both workers execute concurrently. join() moves each typed result back
    // to this thread and consumes its JoinHandle.
    let total = left.join() + right.join()
    let elapsed = perf_counter_ms() - started

    println("sum(1..20,000,000) = " + Debug::fmt(total))
    println("parallel section: " + Debug::fmt(elapsed) + " ms")
    ret 0_u32
}
