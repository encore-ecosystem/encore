import core::fmt::Debug
import std::io::println
import std::thread::available_parallelism
import std::time::{perf_counter_ms, sleep_ms}

fn sleeping_worker(name: str, started: u64, sleep_for: u64) -> str {
    let before_sleep = perf_counter_ms() - started
    println(name + ": sleeping at +" + Debug::fmt(before_sleep) + " ms")
    sleep_ms(sleep_for)
    let after_sleep = perf_counter_ms() - started
    println(name + ": awake at +" + Debug::fmt(after_sleep) + " ms")
    ret name
}

fn sum_range(first: u64, last: u64) -> u64 {
    let mut total = 0_u64
    let mut value = first
    while value <= last {
        total += value
        value += 1_u64
    }
    ret total
}

fn main() -> u32 {
    println("logical CPUs available: " + Debug::fmt(available_parallelism()))
    println("")
    println("sleep demo: two workers sleep for 1000 ms concurrently")

    let sleep_started = perf_counter_ms()
    let sleeper_a = spawn sleeping_worker("worker A", sleep_started, 1000)
    let sleeper_b = spawn sleeping_worker("worker B", sleep_started, 2000)
    let name_a = sleeper_a.join()
    let name_b = sleeper_b.join()
    let sleep_elapsed = perf_counter_ms() - sleep_started

    println("joined " + name_a + " and " + name_b)
    println("total sleep phase: " + Debug::fmt(sleep_elapsed) + " ms (not 2000 ms)")
    println("")
    println("CPU demo: spawning two range-sum workers")

    let started = perf_counter_ms()
    let left = spawn sum_range(1_u64, 10000000_u64)
    let right = spawn sum_range(10000001_u64, 20000000_u64)

    // Both workers execute concurrently. join() moves each typed result back
    // to this thread and consumes its JoinHandle.
    let total = left.join() + right.join()
    let elapsed = perf_counter_ms() - started

    println("sum(1..20,000,000) = " + Debug::fmt(total))
    println("CPU parallel section: " + Debug::fmt(elapsed) + " ms")
    ret 0_u32
}
