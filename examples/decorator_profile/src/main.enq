import profile::ProfileManager

static RENDER_PROFILE = ProfileManager::new("render")

@RENDER_PROFILE.profile("draw_frame")
fn draw_frame(frame: u64) -> u64 {
    ret frame + 1_u64
}

fn main() -> u32 {
    RENDER_PROFILE.reset()
    if draw_frame(41_u64) != 42_u64 { ret 1_u32 }
    if RENDER_PROFILE.sample_count() != 1_u64 { ret 2_u32 }
    RENDER_PROFILE.report()
    ret 0_u32
}
