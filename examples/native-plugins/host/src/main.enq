import core::result::Result

import std::io::{eprintln, println}
import std::os::env
import std::plugin::{Plugin, PluginError}

import formatter_api::Formatter

fn demonstrate() -> Result[(), PluginError] {
    let mut plugin = unsafe {
        Plugin::load(env("PLUGIN_V1").unwrap_or(""))
    }
    ?
    {
        let formatter = plugin.bind[dyn Formatter]("formatter")?
        let before = formatter.format("hello")?
        if before != "v1: hello" {
            ret Result::Err(PluginError {
                    7_u32, "wrong initial result: " + before
                }
            )
        }
        unsafe {
            plugin.reload(env("PLUGIN_V2").unwrap_or(""))
        }
        ?
        let after = formatter.format("hello")?
        if after != "v2: hello" {
            ret Result::Err(PluginError {
                    7_u32, "binding did not switch generations: " + after
                }
            )
        }
        println(before) println(after)
    }
    plugin.close()?
    ret Result::Ok(())
}
fn main() -> i32 {
    match demonstrate() {
        Ok(_) => {
            ret 0_i32
        }
        Err(error) => {
            eprintln(error.message) ret 1_i32
        }
    }
}
