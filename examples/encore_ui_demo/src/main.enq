import core::io::println
import core::time::sleep_ms
import encore_ui::{Color, Insets, Style, Widget, Window, backend_error, event_close, event_key_down, event_pointer_down, horizontal, vertical}

fn app_view(status: str) -> Widget {
    let ink = Color::rgb(30_u8, 34_u8, 40_u8)
    let accent = Color::rgb(20_u8, 153_u8, 126_u8)
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(
        Style::panel().with_background(Color::rgb(242_u8, 245_u8, 248_u8)).with_padding(Insets::all(16.0_f32)).with_gap(10.0_f32)
    )
    let mut toolbar = Widget::panel("toolbar").with_direction(horizontal()).with_flex(48.0_f32, 0.0_f32).with_style(
        Style::default().with_background(ink).with_foreground(Color::rgb(245_u8, 247_u8, 250_u8)).with_padding(Insets::all(7.0_f32)).with_gap(8.0_f32)
    )
    toolbar.push(Widget::label("Encore UI").with_flex(120.0_f32, 0.0_f32).with_style(Style::default().with_foreground(Color::rgb(245_u8, 247_u8, 250_u8))))
    toolbar.push(Widget::spacer(1.0_f32))
    toolbar.push(Widget::button("run", "Run").with_flex(72.0_f32, 0.0_f32).with_style(Style::panel().with_background(accent).with_foreground(Color::rgb(255_u8, 255_u8, 255_u8))))
    root.push(toolbar)
    root.push(Widget::label("Retained layout, styling, hit testing and SDL3 rendering.").with_flex(28.0_f32, 0.0_f32))
    root.push(Widget::spacer(1.0_f32))
    root.push(Widget::label(status).with_flex(24.0_f32, 0.0_f32))
    ret root
}

fn main() -> u32 {
    let window = Window::create("Encore UI", 840_u32, 520_u32)
    if !window.available() {
        println("Unable to start Encore UI: " + backend_error())
        ret 1_u32
    }
    let mut status = "Ready"
    while window.is_open() {
        let event = window.poll()
        let layout = window.draw(app_view(status))
        if event.kind() == event_close() { break }
        if event.kind() == event_key_down() && event.key() == 27_u32 { break }
        if event.kind() == event_pointer_down() {
            let target = layout.hit(event.x(), event.y())
            if target == "run" { status = "Run clicked" }
        }
        sleep_ms(16_u64)
    }
    window.destroy()
    ret 0_u32
}
