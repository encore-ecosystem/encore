import cad_io::summary
import cad_kernel::Box3
import cad_kernel::Circle2
import cad_kernel::Cylinder3
import cad_kernel::Line2
import cad_kernel::Model
import cad_kernel::Point2
import cad_kernel::Sketch
import cad_ui::Theme
import cad_ui::Window
import cad_ui::{
    event_key,
    event_mouse_down,
    event_mouse_move,
    rgb,
    theme_blueprint,
    theme_dark,
    theme_light
}
import std::io::println
import core::fmt::Debug
import core::option::Option
import std::time::sleep_ms

let APP_W: u32 = 1280
let APP_H: u32 = 760
let TOOLBAR_H: i32 = 58
let LEFT_W: i32 = 245
let RIGHT_W: i32 = 285
let STATUS_H: i32 = 34
let VIEW_X: i32 = 245
let VIEW_Y: i32 = 58
let VIEW_W: u32 = 750
let VIEW_H: u32 = 668
let CENTER_X: i32 = 620
let CENTER_Y: i32 = 380

fn tool_line() -> usize { ret 0_usize }
fn tool_rect() -> usize { ret 1_usize }
fn tool_circle() -> usize { ret 2_usize }
fn tool_box() -> usize { ret 3_usize }

fn abs_i32(value: i32) -> i32 {
    if value < 0_i32 {
        ret -value
    }
    ret value
}

fn min_i32(lhs: i32, rhs: i32) -> i32 {
    if lhs < rhs {
        ret lhs
    }
    ret rhs
}

fn max_i32(lhs: i32, rhs: i32) -> i32 {
    if lhs > rhs {
        ret lhs
    }
    ret rhs
}

fn viewport_contains(x: i32, y: i32) -> bool {
    if x < VIEW_X {
        ret false
    }
    if y < VIEW_Y {
        ret false
    }
    if x >= VIEW_X + (VIEW_W as i32) {
        ret false
    }
    if y >= VIEW_Y + (VIEW_H as i32) {
        ret false
    }
    ret true
}

fn inside_rect(x: i32, y: i32, rx: i32, ry: i32, rw: i32, rh: i32) -> bool {
    if x < rx {
        ret false
    }
    if y < ry {
        ret false
    }
    if x >= rx + rw {
        ret false
    }
    if y >= ry + rh {
        ret false
    }
    ret true
}

fn model_x(screen_x: i32) -> i32 {
    ret screen_x - CENTER_X
}

fn model_y(screen_y: i32) -> i32 {
    ret CENTER_Y - screen_y
}

fn sx(x: i32) -> i32 {
    ret CENTER_X + x
}

fn sy(y: i32) -> i32 {
    ret CENTER_Y - y
}

fn sx3(x: i32, y: i32, z: i32) -> i32 {
    ret CENTER_X + x + (z / 2_i32)
}

fn sy3(x: i32, y: i32, z: i32) -> i32 {
    ret CENTER_Y - y - (z / 3_i32)
}

fn theme_for(index: usize) -> Theme {
    if index == 1_usize {
        ret theme_dark()
    }
    if index == 2_usize {
        ret theme_blueprint()
    }
    ret theme_light()
}

fn font_for(index: usize) -> str {
    if index == 1_usize {
        ret "9x15"
    }
    if index == 2_usize {
        ret "10x20"
    }
    ret "fixed"
}

struct AppState {
    model: Model
    theme_index: usize
    font_index: usize
    tool_index: usize
    pending: bool
    anchor_x: i32
    anchor_y: i32
    cursor_x: i32
    cursor_y: i32
    created: usize
}

impl for AppState {
    fn new(model: Model) -> AppState {
        ret AppState {
            model,
            0_usize,
            0_usize,
            tool_rect(),
            false,
            0_i32,
            0_i32,
            0_i32,
            0_i32,
            0_usize
        }
    }

    #cfg(windows)
    fn theme(self: Self) -> Theme {
        ret theme_for(self.theme_index)
    }

    #cfg(windows)
    fn font(self: Self) -> str {
        ret font_for(self.font_index)
    }

    #cfg(windows)
    fn tool_name(self: Self) -> str {
        if self.tool_index == tool_line() {
            ret "line"
        }
        if self.tool_index == tool_circle() {
            ret "circle"
        }
        if self.tool_index == tool_box() {
            ret "box"
        }
        ret "rectangle"
    }

    #cfg(windows)
    fn set_theme(self: mut Self, index: usize) -> () {
        self.theme_index = index
        ret ()
    }

    #cfg(windows)
    fn set_font(self: mut Self, window: Window, index: usize) -> () {
        self.font_index = index
        window.set_font(font_for(self.font_index))
        ret ()
    }

    #cfg(windows)
    fn set_tool(self: mut Self, index: usize) -> () {
        self.tool_index = index
        self.pending = false
        ret ()
    }

    #cfg(windows)
    fn cycle_font(self: mut Self, window: Window) -> () {
        self.font_index = self.font_index + 1_usize
        if self.font_index >= 3_usize {
            self.font_index = 0_usize
        }
        window.set_font(font_for(self.font_index))
        ret ()
    }

    #cfg(windows)
    fn handle_key(self: mut Self, window: Window, key: u32) -> () {
        if key == 49_u32 {
            self.set_theme(0_usize)
            ret ()
        }
        if key == 50_u32 {
            self.set_theme(1_usize)
            ret ()
        }
        if key == 51_u32 {
            self.set_theme(2_usize)
            ret ()
        }
        if key == 102_u32 {
            self.cycle_font(window)
            ret ()
        }
        if key == 70_u32 {
            self.cycle_font(window)
            ret ()
        }
        if key == 108_u32 {
            self.set_tool(tool_line())
            ret ()
        }
        if key == 76_u32 {
            self.set_tool(tool_line())
            ret ()
        }
        if key == 114_u32 {
            self.set_tool(tool_rect())
            ret ()
        }
        if key == 82_u32 {
            self.set_tool(tool_rect())
            ret ()
        }
        if key == 99_u32 {
            self.set_tool(tool_circle())
            ret ()
        }
        if key == 67_u32 {
            self.set_tool(tool_circle())
            ret ()
        }
        if key == 98_u32 {
            self.set_tool(tool_box())
            ret ()
        }
        if key == 66_u32 {
            self.set_tool(tool_box())
            ret ()
        }
        ret ()
    }

    #cfg(windows)
    fn handle_toolbar_click(self: mut Self, window: Window, x: i32, y: i32) -> bool {
        if y < 0_i32 {
            ret false
        }
        if y >= TOOLBAR_H {
            ret false
        }

        if inside_rect(x, y, 250_i32, 14_i32, 86_i32, 30_i32) {
            self.set_tool(tool_line())
            ret true
        }
        if inside_rect(x, y, 342_i32, 14_i32, 86_i32, 30_i32) {
            self.set_tool(tool_rect())
            ret true
        }
        if inside_rect(x, y, 434_i32, 14_i32, 86_i32, 30_i32) {
            self.set_tool(tool_circle())
            ret true
        }
        if inside_rect(x, y, 526_i32, 14_i32, 86_i32, 30_i32) {
            self.set_tool(tool_box())
            ret true
        }

        if inside_rect(x, y, 670_i32, 14_i32, 82_i32, 30_i32) {
            self.set_theme(0_usize)
            ret true
        }
        if inside_rect(x, y, 758_i32, 14_i32, 82_i32, 30_i32) {
            self.set_theme(1_usize)
            ret true
        }
        if inside_rect(x, y, 846_i32, 14_i32, 98_i32, 30_i32) {
            self.set_theme(2_usize)
            ret true
        }

        if inside_rect(x, y, 1010_i32, 14_i32, 62_i32, 30_i32) {
            self.set_font(window, 0_usize)
            ret true
        }
        if inside_rect(x, y, 1078_i32, 14_i32, 62_i32, 30_i32) {
            self.set_font(window, 1_usize)
            ret true
        }
        if inside_rect(x, y, 1146_i32, 14_i32, 70_i32, 30_i32) {
            self.set_font(window, 2_usize)
            ret true
        }

        ret true
    }

    #cfg(windows)
    fn place_at(self: mut Self, screen_x: i32, screen_y: i32) -> () {
        if !viewport_contains(screen_x, screen_y) {
            ret ()
        }

        let x = model_x(screen_x)
        let y = model_y(screen_y)
        self.cursor_x = x
        self.cursor_y = y

        if !self.pending {
            self.anchor_x = x
            self.anchor_y = y
            self.pending = true
            ret ()
        }

        let mut model = self.model
        if self.tool_index == tool_line() {
            model.add_line_to_sketch(0_usize, Point2::new(self.anchor_x, self.anchor_y), Point2::new(x, y))
        }
        if self.tool_index == tool_rect() {
            let left = min_i32(self.anchor_x, x)
            let right = max_i32(self.anchor_x, x)
            let bottom = min_i32(self.anchor_y, y)
            let top = max_i32(self.anchor_y, y)
            model.add_rectangle_to_sketch(0_usize, Point2::new(left, bottom), right - left, top - bottom)
        }
        if self.tool_index == tool_box() {
            let left = min_i32(self.anchor_x, x)
            let right = max_i32(self.anchor_x, x)
            let bottom = min_i32(self.anchor_y, y)
            let top = max_i32(self.anchor_y, y)
            model.add_rectangle_to_sketch(0_usize, Point2::new(left, bottom), right - left, top - bottom)
        }
        if self.tool_index == tool_circle() {
            let radius = max_i32(abs_i32(x - self.anchor_x), abs_i32(y - self.anchor_y))
            model.add_circle_to_sketch(0_usize, Point2::new(self.anchor_x, self.anchor_y), radius)
        }
        self.model = model
        self.pending = false
        self.created += 1_usize
        ret ()
    }

    #cfg(windows)
    fn move_cursor(self: mut Self, screen_x: i32, screen_y: i32) -> () {
        if viewport_contains(screen_x, screen_y) {
            self.cursor_x = model_x(screen_x)
            self.cursor_y = model_y(screen_y)
        }
        ret ()
    }

    #cfg(windows)
    fn handle_event(self: mut Self, window: Window) -> () {
        let kind = window.event_kind()
        if kind == event_key() {
            self.handle_key(window, window.event_key())
            ret ()
        }
        if kind == event_mouse_down() {
            if self.handle_toolbar_click(window, window.event_x(), window.event_y()) {
                ret ()
            }
            self.place_at(window.event_x(), window.event_y())
            ret ()
        }
        if kind == event_mouse_move() {
            self.move_cursor(window.event_x(), window.event_y())
            ret ()
        }
        ret ()
    }
}

fn app_model(state: AppState) -> Model { ret state.model }

fn draw_grid(window: Window, theme: Theme) -> () {
    window.rect(VIEW_X, VIEW_Y, VIEW_W, VIEW_H, theme.viewport())

    let mut x = VIEW_X
    while x < VIEW_X + (VIEW_W as i32) {
        let offset = abs_i32(x - CENTER_X)
        if offset % 100_i32 == 0_i32 {
            window.line(x, VIEW_Y, x, VIEW_Y + (VIEW_H as i32), theme.grid_major())
        } else {
            window.line(x, VIEW_Y, x, VIEW_Y + (VIEW_H as i32), theme.grid_minor())
        }
        x += 25_i32
    }

    let mut y = VIEW_Y
    while y < VIEW_Y + (VIEW_H as i32) {
        let offset = abs_i32(y - CENTER_Y)
        if offset % 100_i32 == 0_i32 {
            window.line(VIEW_X, y, VIEW_X + (VIEW_W as i32), y, theme.grid_major())
        } else {
            window.line(VIEW_X, y, VIEW_X + (VIEW_W as i32), y, theme.grid_minor())
        }
        y += 25_i32
    }

    window.line(VIEW_X, CENTER_Y, VIEW_X + (VIEW_W as i32), CENTER_Y, theme.axis_x())
    window.line(CENTER_X, VIEW_Y, CENTER_X, VIEW_Y + (VIEW_H as i32), theme.axis_y())
    ret ()
}

fn draw_line(window: Window, line: Line2, color: u32) -> () {
    window.line(sx(line.start_x()), sy(line.start_y()), sx(line.end_x()), sy(line.end_y()), color)
    ret ()
}

fn draw_3d_line(window: Window, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, color: u32) -> () {
    window.line(sx3(x0, y0, z0), sy3(x0, y0, z0), sx3(x1, y1, z1), sy3(x1, y1, z1), color)
    ret ()
}

fn sin_step(index: i32) -> i32 {
    if index == 0_i32 { ret 0_i32 }
    if index == 1_i32 { ret 156_i32 }
    if index == 2_i32 { ret 309_i32 }
    if index == 3_i32 { ret 454_i32 }
    if index == 4_i32 { ret 588_i32 }
    if index == 5_i32 { ret 707_i32 }
    if index == 6_i32 { ret 809_i32 }
    if index == 7_i32 { ret 891_i32 }
    if index == 8_i32 { ret 951_i32 }
    if index == 9_i32 { ret 988_i32 }
    if index == 10_i32 { ret 1000_i32 }
    if index == 11_i32 { ret 988_i32 }
    if index == 12_i32 { ret 951_i32 }
    if index == 13_i32 { ret 891_i32 }
    if index == 14_i32 { ret 809_i32 }
    if index == 15_i32 { ret 707_i32 }
    if index == 16_i32 { ret 588_i32 }
    if index == 17_i32 { ret 454_i32 }
    if index == 18_i32 { ret 309_i32 }
    if index == 19_i32 { ret 156_i32 }
    if index == 20_i32 { ret 0_i32 }
    if index == 21_i32 { ret -156_i32 }
    if index == 22_i32 { ret -309_i32 }
    if index == 23_i32 { ret -454_i32 }
    if index == 24_i32 { ret -588_i32 }
    if index == 25_i32 { ret -707_i32 }
    if index == 26_i32 { ret -809_i32 }
    if index == 27_i32 { ret -891_i32 }
    if index == 28_i32 { ret -951_i32 }
    if index == 29_i32 { ret -988_i32 }
    if index == 30_i32 { ret -1000_i32 }
    if index == 31_i32 { ret -988_i32 }
    if index == 32_i32 { ret -951_i32 }
    if index == 33_i32 { ret -891_i32 }
    if index == 34_i32 { ret -809_i32 }
    if index == 35_i32 { ret -707_i32 }
    if index == 36_i32 { ret -588_i32 }
    if index == 37_i32 { ret -454_i32 }
    if index == 38_i32 { ret -309_i32 }
    if index == 39_i32 { ret -156_i32 }
    ret 0_i32
}

fn cos_step(index: i32) -> i32 {
    let normalized = index + 10_i32
    if normalized < 40_i32 {
        ret sin_step(normalized)
    }
    ret sin_step(normalized - 40_i32)
}

fn draw_circle(window: Window, circle: Circle2, color: u32) -> () {
    let steps = 40_i32
    let mut i = 0_i32
    let mut px = circle.center_x() + circle.radius()
    let mut py = circle.center_y()
    while i <= steps {
        let qx = circle.center_x() + (circle.radius() * cos_step(i)) / 1000_i32
        let qy = circle.center_y() + (circle.radius() * sin_step(i)) / 1000_i32
        window.line(sx(px), sy(py), sx(qx), sy(qy), color)
        px = qx
        py = qy
        i += 1_i32
    }
    ret ()
}

fn draw_circle3(window: Window, center_x: i32, center_y: i32, center_z: i32, radius: i32, color: u32) -> () {
    let steps = 40_i32
    let mut i = 0_i32
    let mut px = center_x + radius
    let mut py = center_y
    while i <= steps {
        let qx = center_x + (radius * cos_step(i)) / 1000_i32
        let qy = center_y + (radius * sin_step(i)) / 1000_i32
        draw_3d_line(window, px, py, center_z, qx, qy, center_z, color)
        px = qx
        py = qy
        i += 1_i32
    }
    ret ()
}

fn draw_box3(window: Window, body: Box3, theme: Theme) -> () {
    let x0 = body.x()
    let y0 = body.y()
    let z0 = body.z()
    let x1 = x0 + body.width()
    let y1 = y0 + body.height()
    let z1 = z0 + body.depth()
    let main = theme.accent_dark()
    let rear = theme.grid_major()

    draw_3d_line(window, x0, y0, z0, x1, y0, z0, main)
    draw_3d_line(window, x1, y0, z0, x1, y1, z0, main)
    draw_3d_line(window, x1, y1, z0, x0, y1, z0, main)
    draw_3d_line(window, x0, y1, z0, x0, y0, z0, main)

    draw_3d_line(window, x0, y0, z1, x1, y0, z1, rear)
    draw_3d_line(window, x1, y0, z1, x1, y1, z1, rear)
    draw_3d_line(window, x1, y1, z1, x0, y1, z1, rear)
    draw_3d_line(window, x0, y1, z1, x0, y0, z1, rear)

    draw_3d_line(window, x0, y0, z0, x0, y0, z1, main)
    draw_3d_line(window, x1, y0, z0, x1, y0, z1, main)
    draw_3d_line(window, x1, y1, z0, x1, y1, z1, main)
    draw_3d_line(window, x0, y1, z0, x0, y1, z1, main)
    ret ()
}

fn draw_cylinder3(window: Window, body: Cylinder3, theme: Theme) -> () {
    let z0 = body.z()
    let z1 = body.z() + body.depth()
    draw_circle3(window, body.x(), body.y(), z0, body.radius(), theme.warning())
    draw_circle3(window, body.x(), body.y(), z1, body.radius(), theme.accent())
    draw_3d_line(window, body.x() - body.radius(), body.y(), z0, body.x() - body.radius(), body.y(), z1, theme.warning())
    draw_3d_line(window, body.x() + body.radius(), body.y(), z0, body.x() + body.radius(), body.y(), z1, theme.warning())
    draw_3d_line(window, body.x(), body.y() - body.radius(), z0, body.x(), body.y() - body.radius(), z1, theme.warning())
    draw_3d_line(window, body.x(), body.y() + body.radius(), z0, body.x(), body.y() + body.radius(), z1, theme.warning())
    ret ()
}

fn draw_bodies(window: Window, model: Model, theme: Theme) -> () {
    let mut box_index = 0_usize
    while box_index < model.box_count() {
        match model.box_at(box_index) {
            Option::Some(body) => {
                draw_box3(window, body, theme)
            }
            Option::None => {}
        }
        box_index += 1_usize
    }

    let mut cylinder_index = 0_usize
    while cylinder_index < model.cylinder_count() {
        match model.cylinder_at(cylinder_index) {
            Option::Some(body) => {
                draw_cylinder3(window, body, theme)
            }
            Option::None => {}
        }
        cylinder_index += 1_usize
    }
    ret ()
}

fn draw_sketch(window: Window, sketch: Sketch, theme: Theme) -> () {
    let mut i = 0_usize
    while i < sketch.line_count() {
        match sketch.line_at(i) {
            Option::Some(line) => {
                draw_line(window, line, theme.accent_dark())
            }
            Option::None => {}
        }
        i += 1_usize
    }

    let mut circle_index = 0_usize
    while circle_index < sketch.circle_count() {
        match sketch.circle_at(circle_index) {
            Option::Some(circle) => {
                draw_circle(window, circle, theme.warning())
                window.rect(sx(circle.center_x()) - 2_i32, sy(circle.center_y()) - 2_i32, 5_u32, 5_u32, theme.warning())
            }
            Option::None => {}
        }
        circle_index += 1_usize
    }
    ret ()
}

#cfg(windows)
fn draw_pending(window: Window, state: AppState, theme: Theme) -> () {
    if !state.pending {
        ret ()
    }
    if state.tool_index == tool_line() {
        window.line(sx(state.anchor_x), sy(state.anchor_y), sx(state.cursor_x), sy(state.cursor_y), theme.accent())
    }
    if state.tool_index == tool_rect() {
        let left = min_i32(state.anchor_x, state.cursor_x)
        let right = max_i32(state.anchor_x, state.cursor_x)
        let bottom = min_i32(state.anchor_y, state.cursor_y)
        let top = max_i32(state.anchor_y, state.cursor_y)
        window.line(sx(left), sy(bottom), sx(right), sy(bottom), theme.accent())
        window.line(sx(right), sy(bottom), sx(right), sy(top), theme.accent())
        window.line(sx(right), sy(top), sx(left), sy(top), theme.accent())
        window.line(sx(left), sy(top), sx(left), sy(bottom), theme.accent())
    }
    if state.tool_index == tool_box() {
        let left = min_i32(state.anchor_x, state.cursor_x)
        let right = max_i32(state.anchor_x, state.cursor_x)
        let bottom = min_i32(state.anchor_y, state.cursor_y)
        let top = max_i32(state.anchor_y, state.cursor_y)
        draw_3d_line(window, left, bottom, 0_i32, right, bottom, 0_i32, theme.accent())
        draw_3d_line(window, right, bottom, 0_i32, right, top, 0_i32, theme.accent())
        draw_3d_line(window, right, top, 0_i32, left, top, 0_i32, theme.accent())
        draw_3d_line(window, left, top, 0_i32, left, bottom, 0_i32, theme.accent())
        draw_3d_line(window, left, bottom, 80_i32, right, bottom, 80_i32, theme.warning())
        draw_3d_line(window, right, bottom, 80_i32, right, top, 80_i32, theme.warning())
        draw_3d_line(window, right, top, 80_i32, left, top, 80_i32, theme.warning())
        draw_3d_line(window, left, top, 80_i32, left, bottom, 80_i32, theme.warning())
        draw_3d_line(window, left, bottom, 0_i32, left, bottom, 80_i32, theme.accent())
        draw_3d_line(window, right, bottom, 0_i32, right, bottom, 80_i32, theme.accent())
        draw_3d_line(window, right, top, 0_i32, right, top, 80_i32, theme.accent())
        draw_3d_line(window, left, top, 0_i32, left, top, 80_i32, theme.accent())
    }
    if state.tool_index == tool_circle() {
        let radius = max_i32(abs_i32(state.cursor_x - state.anchor_x), abs_i32(state.cursor_y - state.anchor_y))
        draw_circle(window, Circle2::new(Point2::new(state.anchor_x, state.anchor_y), radius), theme.accent())
    }
    window.rect(sx(state.anchor_x) - 3_i32, sy(state.anchor_y) - 3_i32, 7_u32, 7_u32, theme.accent())
    ret ()
}

fn draw_tool_button(window: Window, theme: Theme, x: i32, text: str, active: bool) -> () {
    if active {
        window.rect(x, 14_i32, 86_u32, 30_u32, theme.accent_dark())
        window.text(x + 14_i32, 34_i32, text, theme.text_on_toolbar())
        ret ()
    }
    window.rect(x, 14_i32, 86_u32, 30_u32, rgb(58_u32, 64_u32, 74_u32))
    window.text(x + 14_i32, 34_i32, text, theme.text_on_toolbar())
    ret ()
}

fn draw_select_button(window: Window, theme: Theme, x: i32, width: u32, text: str, active: bool) -> () {
    if active {
        window.rect(x, 14_i32, width, 30_u32, theme.accent_dark())
        window.text(x + 10_i32, 34_i32, text, theme.text_on_toolbar())
        ret ()
    }
    window.rect(x, 14_i32, width, 30_u32, rgb(58_u32, 64_u32, 74_u32))
    window.text(x + 10_i32, 34_i32, text, theme.text_on_toolbar())
    ret ()
}

#cfg(windows)
fn draw_shell(window: Window, state: AppState, theme: Theme) -> () {
    window.clear(theme.background())
    window.rect(0_i32, 0_i32, APP_W, TOOLBAR_H as u32, theme.toolbar())
    window.rect(0_i32, TOOLBAR_H, LEFT_W as u32, (APP_H as i32 - TOOLBAR_H) as u32, theme.panel())
    window.rect((APP_W as i32) - RIGHT_W, TOOLBAR_H, RIGHT_W as u32, (APP_H as i32 - TOOLBAR_H) as u32, theme.panel())
    window.rect(0_i32, (APP_H as i32) - STATUS_H, APP_W, STATUS_H as u32, theme.status())

    window.line(LEFT_W, TOOLBAR_H, LEFT_W, (APP_H as i32) - STATUS_H, theme.panel_line())
    window.line((APP_W as i32) - RIGHT_W, TOOLBAR_H, (APP_W as i32) - RIGHT_W, (APP_H as i32) - STATUS_H, theme.panel_line())
    window.line(0_i32, TOOLBAR_H, APP_W as i32, TOOLBAR_H, theme.panel_line())
    window.line(0_i32, (APP_H as i32) - STATUS_H, APP_W as i32, (APP_H as i32) - STATUS_H, theme.panel_line())

    window.text(20_i32, 36_i32, "Encore CAD Workbench", theme.text_on_toolbar())
    draw_tool_button(window, theme, 250_i32, "line", state.tool_index == tool_line())
    draw_tool_button(window, theme, 342_i32, "rect", state.tool_index == tool_rect())
    draw_tool_button(window, theme, 434_i32, "circle", state.tool_index == tool_circle())
    draw_tool_button(window, theme, 526_i32, "box", state.tool_index == tool_box())

    draw_select_button(window, theme, 670_i32, 82_u32, "light", state.theme_index == 0_usize)
    draw_select_button(window, theme, 758_i32, 82_u32, "dark", state.theme_index == 1_usize)
    draw_select_button(window, theme, 846_i32, 98_u32, "blueprint", state.theme_index == 2_usize)

    draw_select_button(window, theme, 1010_i32, 62_u32, "fixed", state.font_index == 0_usize)
    draw_select_button(window, theme, 1078_i32, 62_u32, "9x15", state.font_index == 1_usize)
    draw_select_button(window, theme, 1146_i32, 70_u32, "10x20", state.font_index == 2_usize)
    window.text(20_i32, 84_i32, "MODEL TREE", theme.muted())
    window.text(1020_i32, 84_i32, "INSPECTOR", theme.muted())
    ret ()
}

fn draw_model_tree(window: Window, model: Model, theme: Theme) -> () {
    window.text(20_i32, 118_i32, "project: " + model.title(), theme.ink())
    window.text(34_i32, 150_i32, "sketches: " + Debug::fmt(model.sketch_count()), theme.ink())
    window.text(34_i32, 178_i32, "  front plate", theme.accent_dark())
    window.text(34_i32, 212_i32, "features: " + Debug::fmt(model.feature_count()), theme.ink())
    window.text(34_i32, 240_i32, "  base extrusion", theme.accent_dark())
    window.text(34_i32, 274_i32, "3D bodies: " + Debug::fmt(model.body_count()), theme.ink())
    window.text(48_i32, 302_i32, "boxes: " + Debug::fmt(model.box_count()), theme.ink())
    window.text(48_i32, 330_i32, "cylinders: " + Debug::fmt(model.cylinder_count()), theme.ink())
    window.text(20_i32, 395_i32, "CONSTRAINTS", theme.muted())
    window.text(34_i32, 428_i32, "horizontal / vertical", theme.ink())
    window.text(34_i32, 456_i32, "equal length", theme.ink())
    window.text(34_i32, 484_i32, "concentric holes", theme.ink())
    ret ()
}

fn draw_inspector(window: Window, model: Model, theme: Theme) -> () {
    window.text(1020_i32, 118_i32, "Selection", theme.muted())
    window.text(1020_i32, 150_i32, "model: " + model.title(), theme.ink())
    window.text(1020_i32, 178_i32, "bodies: " + Debug::fmt(model.body_count()), theme.ink())
    window.text(1020_i32, 226_i32, "Parameters", theme.muted())
    window.text(1020_i32, 260_i32, "width       360 mm", theme.ink())
    window.text(1020_i32, 288_i32, "height      180 mm", theme.ink())
    window.text(1020_i32, 316_i32, "thickness    42 mm", theme.ink())
    window.text(1020_i32, 344_i32, "hole radius  34 mm", theme.ink())
    window.text(1020_i32, 418_i32, "Session", theme.muted())
    window.text(1020_i32, 452_i32, "features: " + Debug::fmt(model.feature_count()), theme.ink())
    window.text(1020_i32, 508_i32, "theme: " + theme.name(), theme.ink())
    window.text(1020_i32, 536_i32, "CAD model", theme.ink())
    window.text(1020_i32, 480_i32, "bodies: " + Debug::fmt(model.body_count()), theme.ink())
    window.rect(1020_i32, 552_i32, 205_u32, 86_u32, rgb(232_u32, 242_u32, 239_u32))
    window.rect(1042_i32, 575_i32, 64_u32, 42_u32, theme.accent())
    window.rect(1138_i32, 575_i32, 64_u32, 42_u32, theme.accent_dark())
    ret ()
}

fn draw_status(window: Window, model: Model, theme: Theme) -> () {
    window.text(18_i32, 745_i32, "ready  |  " + model.title() + "  |  theme " + theme.name(), theme.muted())
    ret ()
}

fn draw_scene(window: Window, model: Model, theme: Theme) -> () {
    draw_grid(window, theme)
    draw_bodies(window, model, theme)
    match model.sketch_at(0_usize) {
        Option::Some(sketch) => {
            draw_sketch(window, sketch, theme)
        }
        Option::None => {}
    }
    draw_model_tree(window, model, theme)
    draw_inspector(window, model, theme)
    draw_status(window, model, theme)
    window.present()
    ret ()
}

fn main() -> u32 {
    let model = Model::demo_bracket()
    let window = Window::create("Encore CAD Workbench", APP_W, APP_H)
    if !window.available() {
        println(summary(model))
        ret 0_u32
    }
    let theme = theme_dark()
    window.set_font(font_for(0_usize))
    draw_scene(window, model, theme)
    window.destroy()
    println(summary(model))
    ret 0_u32
}
