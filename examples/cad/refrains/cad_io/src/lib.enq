import cad_kernel::Model
import core::option::Option

pub fn summary(model: Model) -> str {
    let mut out = f"{model}" + "\n"

    let mut i = 0_usize
    while i < model.sketch_count() {
        match model.sketch_at(i) {
            Option::Some(sketch) => {
                out += f"- sketch[{i}]: {sketch}" + "\n"
                let mut line_index = 0_usize
                while line_index < sketch.line_count() {
                    match sketch.line_at(line_index) {
                        Option::Some(line) => {
                            out += f"  line[{line_index}]: {line}" + "\n"
                        }
                        Option::None => {}
                    }
                    line_index += 1_usize
                }
                let mut circle_index = 0_usize
                while circle_index < sketch.circle_count() {
                    match sketch.circle_at(circle_index) {
                        Option::Some(circle) => {
                            out += f"  circle[{circle_index}]: {circle}" + "\n"
                        }
                        Option::None => {}
                    }
                    circle_index += 1_usize
                }
            }
            Option::None => {}
        }
        i += 1_usize
    }

    let mut feature_index = 0_usize
    while feature_index < model.feature_count() {
        match model.extrude_at(feature_index) {
            Option::Some(feature) => {
                out += f"- feature[{feature_index}]: {feature}" + "\n"
            }
            Option::None => {}
        }
        feature_index += 1_usize
    }

    let mut box_index = 0_usize
    while box_index < model.box_count() {
        match model.box_at(box_index) {
            Option::Some(body) => {
                out += f"- box[{box_index}]: {body}" + "\n"
            }
            Option::None => {}
        }
        box_index += 1_usize
    }

    let mut cylinder_index = 0_usize
    while cylinder_index < model.cylinder_count() {
        match model.cylinder_at(cylinder_index) {
            Option::Some(body) => {
                out += f"- cylinder[{cylinder_index}]: {body}" + "\n"
            }
            Option::None => {}
        }
        cylinder_index += 1_usize
    }

    ret out
}
