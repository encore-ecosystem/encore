import core::fmt::Debug
import core::option::Option
import core::vec::Vec

pub struct Point2 {
    x: i32
    y: i32
}

pub struct Point3 {
    x: i32
    y: i32
    z: i32
}

pub struct Line2 {
    start: Point2
    end: Point2
}

pub struct Circle2 {
    center: Point2
    radius: i32
}

pub enum ConstraintKind {
    Horizontal,
    Vertical,
    EqualLength,
    Fixed,
    Concentric
}

pub struct Constraint {
    kind: ConstraintKind
    first: usize
    second: usize
}

pub struct Dimension {
    name: str
    value: i32
}

pub struct Sketch {
    name: str
    lines: Vec[Line2]
    circles: Vec[Circle2]
    constraints: Vec[Constraint]
    dimensions: Vec[Dimension]
}

pub struct Extrude {
    name: str
    sketch_index: usize
    depth: i32
}

pub struct Box3 {
    name: str
    origin: Point3
    width: i32
    height: i32
    depth: i32
}

pub struct Cylinder3 {
    name: str
    center: Point3
    radius: i32
    depth: i32
}

pub struct Model {
    name: str
    sketches: Vec[Sketch]
    extrudes: Vec[Extrude]
    boxes: Vec[Box3]
    cylinders: Vec[Cylinder3]
}

impl for Point2 {
    pub fn new(x: i32, y: i32) -> Point2 {
        ret Point2 { x, y }
    }

    pub fn translate(self: Point2, dx: i32, dy: i32) -> Point2 {
        ret Point2 { self.x + dx, self.y + dy }
    }

    pub fn x(self: Point2) -> i32 {
        ret self.x
    }

    pub fn y(self: Point2) -> i32 {
        ret self.y
    }
}

impl Debug for Point2 {
    pub fn fmt(self: Point2) -> str {
        ret "(" + Debug::fmt(self.x) + ", " + Debug::fmt(self.y) + ")"
    }
}

impl for Point3 {
    pub fn new(x: i32, y: i32, z: i32) -> Point3 {
        ret Point3 { x, y, z }
    }

    pub fn x(self: Point3) -> i32 {
        ret self.x
    }

    pub fn y(self: Point3) -> i32 {
        ret self.y
    }

    pub fn z(self: Point3) -> i32 {
        ret self.z
    }
}

impl Debug for Point3 {
    pub fn fmt(self: Point3) -> str {
        ret "(" + Debug::fmt(self.x) + ", " + Debug::fmt(self.y) + ", " + Debug::fmt(self.z) + ")"
    }
}

impl for Line2 {
    pub fn new(start: Point2, end: Point2) -> Line2 {
        ret Line2 { start, end }
    }

    pub fn dx(self: Line2) -> i32 {
        ret self.end.x - self.start.x
    }

    pub fn dy(self: Line2) -> i32 {
        ret self.end.y - self.start.y
    }

    pub fn length_sq(self: Line2) -> i32 {
        let dx = self.dx()
        let dy = self.dy()
        ret dx * dx + dy * dy
    }

    pub fn is_horizontal(self: Line2) -> bool {
        ret self.start.y == self.end.y
    }

    pub fn is_vertical(self: Line2) -> bool {
        ret self.start.x == self.end.x
    }

    pub fn start_x(self: Line2) -> i32 {
        ret self.start.x
    }

    pub fn start_y(self: Line2) -> i32 {
        ret self.start.y
    }

    pub fn end_x(self: Line2) -> i32 {
        ret self.end.x
    }

    pub fn end_y(self: Line2) -> i32 {
        ret self.end.y
    }
}

impl Debug for Line2 {
    pub fn fmt(self: Line2) -> str {
        ret Debug::fmt(self.start) + " -> " + Debug::fmt(self.end)
    }
}

impl for Circle2 {
    pub fn new(center: Point2, radius: i32) -> Circle2 {
        ret Circle2 { center, radius }
    }

    pub fn center_x(self: Circle2) -> i32 {
        ret self.center.x
    }

    pub fn center_y(self: Circle2) -> i32 {
        ret self.center.y
    }

    pub fn radius(self: Circle2) -> i32 {
        ret self.radius
    }
}

impl Debug for Circle2 {
    pub fn fmt(self: Circle2) -> str {
        ret "circle(center=" + Debug::fmt(self.center) + ", r=" + Debug::fmt(self.radius) + ")"
    }
}

impl for Constraint {
    pub fn new(kind: ConstraintKind, first: usize, second: usize) -> Constraint {
        ret Constraint { kind, first, second }
    }
}

impl for Dimension {
    pub fn new(name: str, value: i32) -> Dimension {
        ret Dimension { name, value }
    }
}

impl for Sketch {
    pub fn new(name: str) -> Sketch {
        ret Sketch {
            name,
            Vec[Line2]::new(),
            Vec[Circle2]::new(),
            Vec[Constraint]::new(),
            Vec[Dimension]::new()
        }
    }

    pub fn add_line(self: mut Self, start: Point2, end: Point2) -> usize {
        let index = self.lines.len()
        self.lines.push(Line2::new(start, end))
        ret index
    }

    pub fn add_circle(self: mut Self, center: Point2, radius: i32) -> usize {
        let index = self.circles.len()
        self.circles.push(Circle2::new(center, radius))
        ret index
    }

    pub fn add_constraint(self: mut Self, kind: ConstraintKind, first: usize, second: usize) -> usize {
        let index = self.constraints.len()
        self.constraints.push(Constraint::new(kind, first, second))
        ret index
    }

    pub fn add_dimension(self: mut Self, name: str, value: i32) -> usize {
        let index = self.dimensions.len()
        self.dimensions.push(Dimension::new(name, value))
        ret index
    }

    pub fn add_rectangle(self: mut Self, origin: Point2, width: i32, height: i32) -> Self {
        let p0 = origin
        let p1 = origin.translate(width, 0)
        let p2 = origin.translate(width, height)
        let p3 = origin.translate(0, height)

        let l0 = self.add_line(p0, p1)
        let l1 = self.add_line(p1, p2)
        let l2 = self.add_line(p2, p3)
        let l3 = self.add_line(p3, p0)

        self.add_constraint(ConstraintKind::Horizontal, l0, l0)
        self.add_constraint(ConstraintKind::Vertical, l1, l1)
        self.add_constraint(ConstraintKind::Horizontal, l2, l2)
        self.add_constraint(ConstraintKind::Vertical, l3, l3)
        self.add_dimension("width", width)
        self.add_dimension("height", height)
        ret self
    }

    pub fn add_centered_rectangle(self: mut Self, center: Point2, width: i32, height: i32) -> Self {
        let half_w = width / 2_i32
        let half_h = height / 2_i32
        ret self.add_rectangle(Point2::new(center.x - half_w, center.y - half_h), width, height)
    }

    pub fn line_at(self: Sketch, index: usize) -> Option[Line2] {
        ret self.lines.get(index)
    }

    pub fn circle_at(self: Sketch, index: usize) -> Option[Circle2] {
        ret self.circles.get(index)
    }

    pub fn line_count(self: Sketch) -> usize {
        ret self.lines.len()
    }

    pub fn circle_count(self: Sketch) -> usize {
        ret self.circles.len()
    }

    pub fn constraint_count(self: Sketch) -> usize {
        ret self.constraints.len()
    }

    pub fn dimension_count(self: Sketch) -> usize {
        ret self.dimensions.len()
    }

    pub fn title(self: Sketch) -> str {
        ret self.name
    }
}

impl Debug for Sketch {
    pub fn fmt(self: Sketch) -> str {
        ret "Sketch(" + self.name + ", lines=" + Debug::fmt(self.lines.len()) + ", circles=" + Debug::fmt(self.circles.len()) + ", constraints=" + Debug::fmt(self.constraints.len()) + ")"
    }
}

impl for Extrude {
    pub fn new(name: str, sketch_index: usize, depth: i32) -> Extrude {
        ret Extrude { name, sketch_index, depth }
    }
}

impl Debug for Extrude {
    pub fn fmt(self: Extrude) -> str {
        ret "Extrude(" + self.name + ", sketch=" + Debug::fmt(self.sketch_index) + ", depth=" + Debug::fmt(self.depth) + ")"
    }
}

impl for Box3 {
    pub fn new(name: str, origin: Point3, width: i32, height: i32, depth: i32) -> Box3 {
        ret Box3 { name, origin, width, height, depth }
    }

    pub fn title(self: Box3) -> str {
        ret self.name
    }

    pub fn x(self: Box3) -> i32 {
        ret self.origin.x
    }

    pub fn y(self: Box3) -> i32 {
        ret self.origin.y
    }

    pub fn z(self: Box3) -> i32 {
        ret self.origin.z
    }

    pub fn width(self: Box3) -> i32 {
        ret self.width
    }

    pub fn height(self: Box3) -> i32 {
        ret self.height
    }

    pub fn depth(self: Box3) -> i32 {
        ret self.depth
    }
}

impl Debug for Box3 {
    pub fn fmt(self: Box3) -> str {
        ret "Box3(" + self.name + ", origin=" + Debug::fmt(self.origin) + ", size=" + Debug::fmt(self.width) + "x" + Debug::fmt(self.height) + "x" + Debug::fmt(self.depth) + ")"
    }
}

impl for Cylinder3 {
    pub fn new(name: str, center: Point3, radius: i32, depth: i32) -> Cylinder3 {
        ret Cylinder3 { name, center, radius, depth }
    }

    pub fn title(self: Cylinder3) -> str {
        ret self.name
    }

    pub fn x(self: Cylinder3) -> i32 {
        ret self.center.x
    }

    pub fn y(self: Cylinder3) -> i32 {
        ret self.center.y
    }

    pub fn z(self: Cylinder3) -> i32 {
        ret self.center.z
    }

    pub fn radius(self: Cylinder3) -> i32 {
        ret self.radius
    }

    pub fn depth(self: Cylinder3) -> i32 {
        ret self.depth
    }
}

impl Debug for Cylinder3 {
    pub fn fmt(self: Cylinder3) -> str {
        ret "Cylinder3(" + self.name + ", center=" + Debug::fmt(self.center) + ", r=" + Debug::fmt(self.radius) + ", depth=" + Debug::fmt(self.depth) + ")"
    }
}

impl for Model {
    pub fn new(name: str) -> Model {
        ret Model {
            name,
            Vec[Sketch]::new(),
            Vec[Extrude]::new(),
            Vec[Box3]::new(),
            Vec[Cylinder3]::new()
        }
    }

    pub fn add_sketch(self: mut Self, sketch: Sketch) -> usize {
        let index = self.sketches.len()
        self.sketches.push(sketch)
        ret index
    }

    pub fn add_extrude(self: mut Self, name: str, sketch_index: usize, depth: i32) -> usize {
        let index = self.extrudes.len()
        self.extrudes.push(Extrude::new(name, sketch_index, depth))
        ret index
    }

    pub fn add_box(self: mut Self, name: str, origin: Point3, width: i32, height: i32, depth: i32) -> usize {
        let index = self.boxes.len()
        self.boxes.push(Box3::new(name, origin, width, height, depth))
        ret index
    }

    pub fn add_cylinder(self: mut Self, name: str, center: Point3, radius: i32, depth: i32) -> usize {
        let index = self.cylinders.len()
        self.cylinders.push(Cylinder3::new(name, center, radius, depth))
        ret index
    }

    pub fn sketch_at(self: Model, index: usize) -> Option[Sketch] {
        ret self.sketches.get(index)
    }

    pub fn extrude_at(self: Model, index: usize) -> Option[Extrude] {
        ret self.extrudes.get(index)
    }

    pub fn box_at(self: Model, index: usize) -> Option[Box3] {
        ret self.boxes.get(index)
    }

    pub fn cylinder_at(self: Model, index: usize) -> Option[Cylinder3] {
        ret self.cylinders.get(index)
    }

    pub fn set_sketch(self: mut Self, index: usize, sketch: Sketch) -> bool {
        if index >= self.sketches.len() {
            ret false
        }
        self.sketches.set(index, sketch)
        ret true
    }

    pub fn add_line_to_sketch(self: mut Self, sketch_index: usize, start: Point2, end: Point2) -> bool {
        match self.sketch_at(sketch_index) {
            Option::Some(sketch) => {
                let mut editable = sketch
                editable.add_line(start, end)
                ret self.set_sketch(sketch_index, editable)
            }
            Option::None => {
                ret false
            }
        }
    }

    pub fn add_circle_to_sketch(self: mut Self, sketch_index: usize, center: Point2, radius: i32) -> bool {
        if radius <= 0_i32 {
            ret false
        }
        match self.sketch_at(sketch_index) {
            Option::Some(sketch) => {
                let mut editable = sketch
                editable.add_circle(center, radius)
                let ok = self.set_sketch(sketch_index, editable)
                if ok {
                    self.add_cylinder("interactive cylinder", Point3::new(center.x, center.y, 0_i32), radius, 80_i32)
                }
                ret ok
            }
            Option::None => {
                ret false
            }
        }
    }

    pub fn add_rectangle_to_sketch(self: mut Self, sketch_index: usize, origin: Point2, width: i32, height: i32) -> bool {
        if width <= 0_i32 || height <= 0_i32 {
            ret false
        }
        match self.sketch_at(sketch_index) {
            Option::Some(sketch) => {
                let mut editable = sketch
                editable = editable.add_rectangle(origin, width, height)
                let ok = self.set_sketch(sketch_index, editable)
                if ok {
                    self.add_box("interactive box", Point3::new(origin.x, origin.y, 0_i32), width, height, 80_i32)
                }
                ret ok
            }
            Option::None => {
                ret false
            }
        }
    }

    pub fn title(self: Model) -> str {
        ret self.name
    }

    pub fn sketch_count(self: Model) -> usize {
        ret self.sketches.len()
    }

    pub fn feature_count(self: Model) -> usize {
        ret self.extrudes.len()
    }

    pub fn box_count(self: Model) -> usize {
        ret self.boxes.len()
    }

    pub fn cylinder_count(self: Model) -> usize {
        ret self.cylinders.len()
    }

    pub fn body_count(self: Model) -> usize {
        ret self.box_count() + self.cylinder_count()
    }

    pub fn demo_bracket() -> Model {
        let mut sketch = Sketch::new("front plate")
        sketch = sketch.add_rectangle(Point2::new(-180, -90), 360, 180)
        sketch.add_circle(Point2::new(-110, 0), 34)
        sketch.add_circle(Point2::new(110, 0), 34)
        sketch.add_circle(Point2::new(0, 0), 24)
        sketch.add_constraint(ConstraintKind::EqualLength, 0_usize, 2_usize)
        sketch.add_constraint(ConstraintKind::Concentric, 1_usize, 2_usize)
        sketch.add_dimension("thickness", 42)
        sketch.add_dimension("mount pitch", 220)

        let mut model = Model::new("Parametric mounting bracket")
        let sketch_index = model.add_sketch(sketch)
        model.add_extrude("base extrusion", sketch_index, 42)
        model.add_box("base plate", Point3::new(-180_i32, -90_i32, 0_i32), 360_i32, 180_i32, 42_i32)
        model.add_cylinder("left mounting boss", Point3::new(-110_i32, 0_i32, 0_i32), 34_i32, 64_i32)
        model.add_cylinder("right mounting boss", Point3::new(110_i32, 0_i32, 0_i32), 34_i32, 64_i32)
        ret model
    }
}

impl Debug for Model {
    pub fn fmt(self: Model) -> str {
        ret "Model(" + self.name + ", sketches=" + Debug::fmt(self.sketches.len()) + ", features=" + Debug::fmt(self.extrudes.len()) + ", bodies=" + Debug::fmt(self.body_count()) + ")"
    }
}
