import std::{
    vec::Vec,
    fmt::Debug,
    io::println,
    option::Option,
}

fn merge(left: Vec[i32], right: Vec[i32]) -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut i = 0_usize
    let mut j = 0_usize

    loop {
        let l = left.get(i)
        let r = right.get(j)

        match l {
            Option[i32]::Some(lv) => {
                match r {
                    Option[i32]::Some(rv) => {
                        if lv <= rv {
                            out = out.push(lv)
                            i = i + 1_usize
                        }
                        else {
                            out = out.push(rv)
                            j = j + 1_usize
                        }
                    }
                    Option[i32]::None => {
                        out = out.push(lv)
                        i = i + 1_usize
                    }
                }
            }
            Option[i32]::None => {
                match r {
                    Option[i32]::Some(rv) => {
                        out = out.push(rv)
                        j = j + 1_usize
                    }
                    Option[i32]::None => {
                        break
                    }
                }
            }
        }
    }
    ret out
}

fn slice(values: Vec[i32], start: usize, stop: usize) -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut i = start
    while i < stop {
        match values.get(i) {
            Option[i32]::Some(v) => {
                out = out.push(v)
            }
            Option[i32]::None => {
                break
            }
        }
        i = i + 1_usize
    }
    ret out
}

fn merge_sort(values: Vec[i32]) -> Vec[i32] {
    let n = values.len()
    if n < 2_usize {
        ret values
    }

    let mid = n / 2_usize
    let left = merge_sort(slice(values, 0_usize, mid))
    let right = merge_sort(slice(values, mid, n))
    ret merge(left, right)
}

fn main() -> u32 {
    let data = Vec[i32]::new()
        .push(12_i32)
        .push(4_i32)
        .push(7_i32)
        .push(1_i32)
        .push(15_i32)
        .push(3_i32)
        .push(9_i32)

    println("Before: " + Debug::fmt(data))
    let sorted = merge_sort(data)
    println("After : " + Debug::fmt(sorted))
    ret 0_u32
}
