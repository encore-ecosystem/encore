import std::fmt::Debug
import std::io::println
import std::option::Option
import std::vec::Vec

fn fmt_vec_i32(values: Vec[i32]) -> str {
    let mut out = "["
    let mut i = 0_usize
    while i < values.len() {
        if i > 0_usize {
            out = out + ", "
        }
        match values.get(i) {
            Option::Some(v) => {
                out = out + Debug::fmt(v)
            }
            Option::None => {}
        }
        i = i + 1_usize
    }
    ret out + "]"
}

fn merge(left: Vec[i32], right: Vec[i32]) -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut i = 0_usize
    let mut j = 0_usize

    loop {
        let l = left.get(i)
        let r = right.get(j)

        match l {
            Option[i32]::Some(lv) => {
                match r {
                    Option[i32]::Some(rv) => {
                        if lv <= rv {
                            out.push(lv)
                            i = i + 1_usize
                        }
                        else {
                            out.push(rv)
                            j = j + 1_usize
                        }
                    }
                    Option[i32]::None => {
                        out.push(lv)
                        i = i + 1_usize
                    }
                }
            }
            Option[i32]::None => {
                match r {
                    Option[i32]::Some(rv) => {
                        out.push(rv)
                        j = j + 1_usize
                    }
                    Option[i32]::None => {
                        break
                    }
                }
            }
        }
    }
    ret out
}

fn slice(values: Vec[i32], start: usize, stop: usize) -> Vec[i32] {
    let mut out = Vec[i32]::new()
    let mut i = start
    while i < stop {
        match values.get(i) {
            Option[i32]::Some(v) => {
                out.push(v)
            }
            Option[i32]::None => {
                break
            }
        }
        i = i + 1_usize
    }
    ret out
}

fn merge_sort(values: Vec[i32]) -> Vec[i32] {
    let n = values.len()
    if n < 2_usize {
        ret values
    }

    let mid = n / 2_usize
    let left = merge_sort(slice(values, 0_usize, mid))
    let right = merge_sort(slice(values, mid, n))
    ret merge(left, right)
}

fn main() -> u32 {
    let mut data = Vec[i32]::new()
    data.push(12_i32)
    data.push(4_i32)
    data.push(7_i32)
    data.push(1_i32)
    data.push(15_i32)
    data.push(3_i32)
    data.push(9_i32)

    println("Before: " + fmt_vec_i32(data))
    let sorted = merge_sort(data)
    println("After : " + fmt_vec_i32(sorted))
    ret 0_u32
}
