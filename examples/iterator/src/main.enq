import std::io::println

fn fibonacci_iterator(max_iters: usize) -> usize {
    let mut last: usize = 0
    let mut curr: usize = 1
    for _ in 0..max_iters {
        let mut result = last + curr
        yield result
        last = curr
        curr = result
    }
}

fn main() -> usize {
    for fib in fibonacci_iterator(5) {
        println(f"{fib}")
    }
    ret 0
}
