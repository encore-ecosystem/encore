import core::future::{Context, Future, Poll}
import std::io::println
import core::fmt::Debug
import std::future::block_on

struct YieldOnce {
    label: str
    value: u32
    yielded: bool
}

impl Future[u32] for YieldOnce {
    fn poll(self: YieldOnce, context: Context) -> Poll[YieldOnce, u32] {
        if !self.yielded {
            println("  " + self.label + ": Pending (wake executor)")
            context.waker.wake()
            ret Poll[YieldOnce, u32]::Pending(YieldOnce{self.label, self.value, true})
        }
        println("  " + self.label + ": Ready(" + Debug::fmt(self.value) + ")")
        ret Poll[YieldOnce, u32]::Ready(self.value)
    }
}

async fn pipeline() -> u32 {
    println("pipeline: started on first poll")
    let left = await YieldOnce{"load-left", 20_u32, false}
    println("pipeline: first await completed")
    let right = await YieldOnce{"load-right", 22_u32, false}
    println("pipeline: second await completed")
    ret left + right
}

fn main() -> u32 {
    println("main: creating future (the body is still lazy)")
    let pending = pipeline()
    println("main: entering block_on")
    let result = block_on[u32, __encore_future_pipeline](pending)
    println("main: result = " + Debug::fmt(result))
    ret 0_u32
}
