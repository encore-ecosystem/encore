import core::result::Result

fn div(a: u32, b: u32) -> Result[u32, u32] {
    if b == 0_u32 {
        ret Result[u32, u32]::Err(1_u32)
    }
    ret Result[u32, u32]::Ok(a / b)
}

fn calc() -> Result[u32, u32] {
    let x = div(10_u32, 2_u32)?
    ret Result[u32, u32]::Ok(x + 1_u32)
}

fn main() -> u32 {
    let res: Result[u32, u32] = calc()
    ret 0_u32
}
