import std::io::println

extern fn __ehir_rt_fmt_usize(value: usize) -> str

fn fmt_usize(value: usize) -> str {
    unsafe {
        ret __ehir_rt_fmt_usize(value)
    }
}

fn factorial(n: usize) -> usize {
    if n < 2 {
        ret 1
    }
    ret n * factorial(n - 1)
}

fn main() -> u32 {
    println("Factorial(1) = " + fmt_usize(factorial(1)))
    println("Factorial(2) = " + fmt_usize(factorial(2)))
    println("Factorial(3) = " + fmt_usize(factorial(3)))
    println("Factorial(4) = " + fmt_usize(factorial(4)))
    println("Factorial(5) = " + fmt_usize(factorial(5)))
    println("Factorial(6) = " + fmt_usize(factorial(6)))
    println("Factorial(7) = " + fmt_usize(factorial(7)))
    println("Factorial(8) = " + fmt_usize(factorial(8)))
    println("Factorial(9) = " + fmt_usize(factorial(9)))
    ret 0_u32
}
