import std::io::println
import std::fmt::Debug


fn factorial(n: usize) -> usize {
    if n < 2 {
        ret 1
    }
    ret n * factorial(n - 1)
}

fn main() -> u32 {
    println("Factorial(1) = " + Debug::fmt(factorial(1)))
    println("Factorial(2) = " + Debug::fmt(factorial(2)))
    println("Factorial(3) = " + Debug::fmt(factorial(3)))
    println("Factorial(4) = " + Debug::fmt(factorial(4)))
    println("Factorial(5) = " + Debug::fmt(factorial(5)))
    println("Factorial(6) = " + Debug::fmt(factorial(6)))
    println("Factorial(7) = " + Debug::fmt(factorial(7)))
    println("Factorial(8) = " + Debug::fmt(factorial(8)))
    println("Factorial(9) = " + Debug::fmt(factorial(9)))
    ret 0_u32
}
