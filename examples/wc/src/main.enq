import core::io::eprintln
import core::io::println
import core::option::Option
import core::os::argv
import core::os::read_file
import std::fmt::Debug


fn is_sep(ch: str) -> bool {
    if ch == " " {
        ret true
    }
    if ch == "\n" {
        ret true
    }
    ret false
}

fn count_lines(content: str) -> usize {
    let mut lines = 0_usize
    let mut i = 0_usize

    loop {
        match content.get(i) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    lines = lines + 1_usize
                }
                i = i + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }

    ret lines
}

fn count_words(content: str) -> usize {
    let mut words = 0_usize
    let mut in_word = false
    let mut i = 0_usize

    loop {
        match content.get(i) {
            Option[str]::Some(ch) => {
                if is_sep(ch) {
                    if in_word {
                        words = words + 1_usize
                        in_word = false
                    }
                } else {
                    in_word = true
                }
                i = i + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }

    if in_word {
        words = words + 1_usize
    }

    ret words
}

fn main() -> u32 {
    match argv(1_usize) {
        Option[str]::Some(path) => {
            let content = read_file(path)
            let lines = count_lines(content)
            let words = count_words(content)
            let bytes = content.len()
            let out = Debug::fmt(lines) + " " + Debug::fmt(words) + " " + Debug::fmt(bytes) + " " + path
            println(out)
            ret 0_u32
        }
        Option[str]::None => {
            eprintln("usage: wc <file>")
            ret 1_u32
        }
    }
}
