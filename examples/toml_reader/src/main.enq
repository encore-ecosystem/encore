import std::io::println
import core::option::Option
import std::os::read_file
import core::vec::Vec
import toml::toml_parse_document
import toml::toml_get_string
import toml::toml_get_string_array

fn main() -> u32 {
    let source = read_file("sample.toml")
    let doc = toml_parse_document(source)

    match toml_get_string(doc, "project", "name") {
        Some(name) => {
            println(name)
        }
        None => {
        }
    }

    match toml_get_string_array(doc, "project", "dependencies") {
        Some(deps) => {
            match deps.get(0_usize) {
                Some(first) => {
                    println(first)
                }
                None => {
                }
            }
        }
        None => {
        }
    }

    ret 0_u32
}
