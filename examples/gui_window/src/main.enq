import core::io::println
import core::time::sleep_ms
import gui_core::color::Color
import gui_core::geometry::Rect
import gui_core::window::WindowDesc
import gui_native::window::Window

fn main() -> u32 {
    let desc = WindowDesc::new("Encore GUI window", 800_u32, 480_u32)
    let mut window = Window::open(desc)
    if !window.is_valid() {
        println("Unable to open native GUI window. Check DISPLAY/XWayland availability.")
        ret 1_u32
    }

    let mut frame = 0_i32
    let mut x = 24_i32
    let mut y = 64_i32
    let mut dx = 5_i32
    let mut dy = 3_i32

    loop {
        if frame >= 900_i32 {
            break
        }
        if !window.poll() {
            break
        }

        window.clear(Color::rgb(18_u32, 24_u32, 32_u32))
        window.fill_rect(Rect::new(24_i32, 24_i32, 752_u32, 432_u32), Color::rgb(36_u32, 45_u32, 56_u32))
        window.fill_rect(Rect::new(x, y, 140_u32, 84_u32), Color::rgb(84_u32, 204_u32, 196_u32))
        window.fill_rect(Rect::new(800_i32 - x - 170_i32, 480_i32 - y - 110_i32, 110_u32, 110_u32), Color::rgb(245_u32, 172_u32, 75_u32))
        window.present()

        x = x + dx
        y = y + dy
        if x <= 24_i32 || x >= 636_i32 {
            dx = 0_i32 - dx
        }
        if y <= 32_i32 || y >= 348_i32 {
            dy = 0_i32 - dy
        }

        frame = frame + 1_i32
        sleep_ms(16_u64)
    }

    window.close()
    ret 0_u32
}
