import core::fmt::Debug
import core::io::println
import core::option::Option
import core::os::argv
import core::time::sleep_ms
import encore_ui::{
    Color, Rect, Window, backend_error, event_close, event_key_down
}

fn font_path() -> str {
    match argv(1_usize) {
        Option[str]::Some(path) => { ret path }
        Option[str]::None => { ret "" }
    }
}

fn draw(window: Window, path: str) -> () {
    let background = Color::rgb(246_u8, 248_u8, 251_u8)
    let ink = Color::rgb(28_u8, 33_u8, 40_u8)
    let muted = Color::rgb(91_u8, 102_u8, 116_u8)
    let accent = Color::rgb(18_u8, 153_u8, 126_u8)
    let sample = "Encore UI: Typography / Кириллица / 日本語"

    window.begin(background)
    window.fill_rect(Rect::new(24.0_f32, 24.0_f32, 752.0_f32, 412.0_f32), Color::rgb(255_u8, 255_u8, 255_u8))
    window.stroke_rect(Rect::new(24.0_f32, 24.0_f32, 752.0_f32, 412.0_f32), Color::rgb(204_u8, 212_u8, 221_u8))
    window.text(48.0_f32, 52.0_f32, "FONT PREVIEW", muted)
    window.text(48.0_f32, 96.0_f32, sample, ink)
    window.text(48.0_f32, 150.0_f32, "The quick brown fox jumps over the lazy dog.", ink)
    window.text(48.0_f32, 202.0_f32, "0123456789  !@#$%^&*()  []{}", ink)
    window.fill_rect(Rect::new(48.0_f32, 266.0_f32, window.text_width(sample), 3.0_f32), accent)
    window.text(48.0_f32, 286.0_f32, "Measured width: " + Debug::fmt(window.text_width(sample)), muted)
    window.text(48.0_f32, 324.0_f32, "Source: " + path, muted)
    window.text(48.0_f32, 382.0_f32, "Escape closes the preview", muted)
    window.present()
    ret ()
}

fn main() -> u32 {
    let path = font_path()
    if path == "" {
        println("Usage: encore run -- <font.ttf|font.otf|font.ttc|...>")
        ret 2_u32
    }
    let window = Window::create("Encore UI Fonts", 800_u32, 460_u32)
    if !window.available() {
        println("Unable to start Encore UI: " + backend_error())
        ret 1_u32
    }
    if !window.load_font(path, 22.0_f32) {
        println("Unable to load font: " + backend_error())
        window.destroy()
        ret 1_u32
    }
    while window.is_open() {
        let event = window.poll()
        if event.kind() == event_close() { break }
        if event.kind() == event_key_down() && event.key() == 27_u32 { break }
        draw(window, path)
        sleep_ms(16_u64)
    }
    window.destroy()
    ret 0_u32
}
