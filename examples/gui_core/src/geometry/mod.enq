pub struct Vec2i {
    x: i32
    y: i32
}

pub struct Size {
    width: u32
    height: u32
}

pub struct Rect {
    x: i32
    y: i32
    width: u32
    height: u32
}

impl for Vec2i {
    pub fn new(x: i32, y: i32) -> Vec2i {
        ret Vec2i { x, y }
    }
}

impl for Size {
    pub fn new(width: u32, height: u32) -> Size {
        ret Size { width, height }
    }
}

impl for Rect {
    pub fn new(x: i32, y: i32, width: u32, height: u32) -> Rect {
        ret Rect { x, y, width, height }
    }
}
