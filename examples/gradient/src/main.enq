import std::{
    io::{
        println,
        eprintln,
    },
    fmt::Debug,
}

fn abs_f32(v: f32) -> f32 {
    if v < 0_f32 {
        ret 0_f32 - v
    }
    ret v
}

fn main() -> u32 {
    let a: f32 = 1_f32
    let b: f32 = 0_f32 - 1_f32

    // Minimize f(x) = a*x^2 + b*x
    // df/dx = 2*a*x + b
    let steps: usize = 5000_usize
    let lr: f32 = 0.01_f32
    let log_every: usize = 500_usize

    let mut x: f32 = 0_f32

    for i in 1..=steps {
        let dx: f32 = 2_f32 * a * x + b

        x = x - lr * dx
        if i % log_every == 0_usize {
            let fx: f32 = a * x * x + b * x
            println("step=" + Debug::fmt(i) + " x=" + Debug::fmt(x) + " f(x)=" + Debug::fmt(fx) + " dx=" + Debug::fmt(dx))
        }
    }

    let expected: f32 = 0.5_f32
    let err: f32 = abs_f32(x - expected)
    let fx: f32 = a * x * x + b * x
    println("result x = " + Debug::fmt(x))
    println("result f(x) = " + Debug::fmt(fx))
    println("error    = " + Debug::fmt(err))

    if err > 0.01_f32 {
        eprintln("gradient did not converge enough")
        ret 1_u32
    }

    ret 0_u32
}
