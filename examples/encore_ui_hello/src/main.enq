import core::io::println
import core::time::sleep_ms
import encore_ui::{
    Color, Insets, Style, Widget, Window, backend_error, event_close,
    event_key_down, vertical
}

fn view() -> Widget {
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(
        Style::panel()
            .with_background(Color::rgb(245_u8, 247_u8, 250_u8))
            .with_padding(Insets::all(24.0_f32))
            .with_gap(12.0_f32)
    )
    root.push(Widget::label("Hello from Encore UI").with_flex(32.0_f32, 0.0_f32))
    root.push(Widget::label("A retained native interface rendered with SDL3.").with_flex(24.0_f32, 0.0_f32))
    root.push(Widget::spacer(1.0_f32))
    ret root
}

fn main() -> u32 {
    let window = Window::create("Encore UI Hello", 640_u32, 360_u32)
    if !window.available() {
        println("Unable to start Encore UI: " + backend_error())
        ret 1_u32
    }
    while window.is_open() {
        let event = window.poll()
        window.draw(view())
        if event.kind() == event_close() { break }
        if event.kind() == event_key_down() && event.key() == 27_u32 { break }
        sleep_ms(16_u64)
    }
    window.destroy()
    ret 0_u32
}
