import std::io::println
import std::option::Option
import std::vec::Vec

struct Slot {
    state: u8
    key: str
    value: u32
}

struct Dict {
    slots: Vec[Slot]
    len: usize
}

fn state_empty() -> u8 { ret 0_u8 }
fn state_tomb() -> u8 { ret 1_u8 }
fn state_occ() -> u8 { ret 2_u8 }

fn make_empty() -> Slot {
    ret Slot { state_empty(), "", 0_u32 }
}

fn make_tomb() -> Slot {
    ret Slot { state_tomb(), "", 0_u32 }
}

fn make_occ(key: str, value: u32) -> Slot {
    ret Slot { state_occ(), key, value }
}

fn u8_to_u64(value: u8) -> u64 {
    unsafe ehir {
        out: u64 = pcast value: u8, u64
    }
    ret out
}

fn u64_to_usize(value: u64) -> usize {
    unsafe ehir {
        out: usize = pcast value: u64, usize
    }
    ret out
}

fn hash_str(value: str) -> u64 {
    let mut h = 1469598103934665603_u64
    let prime = 1099511628211_u64
    for i in 0..value.len() {
        match value.get_byte(i) {
            Option::Some(b) => {
                h = h ^ u8_to_u64(b)
                h = h * prime
            }
            Option::None => {
                break
            }
        }
    }
    ret h
}

impl for Dict {
    pub fn new() -> Dict {
        ret Dict::with_capacity(32_usize)
    }

    pub fn with_capacity(capacity: usize) -> Dict {
        let mut slots = Vec[Slot]::with_capacity(capacity)
        let mut i = 0_usize
        while i < capacity {
            slots = slots.push(make_empty())
            i = i + 1_usize
        }
        ret Dict { slots, 0_usize }
    }

    pub fn len(self: Dict) -> usize {
        ret self.len
    }

    pub fn is_empty(self: Dict) -> bool {
        ret self.len == 0_usize
    }

    pub fn capacity(self: Dict) -> usize {
        ret self.slots.len()
    }

    fn index_for(self: Dict, key: str) -> usize {
        let cap = self.capacity()
        if cap == 0_usize {
            ret 0_usize
        }
        ret u64_to_usize(hash_str(key)) % cap
    }

    pub fn get(self: Dict, key: str) -> Option[u32] {
        let cap = self.capacity()
        if cap == 0_usize {
            ret Option[u32]::None
        }
        let start = self.index_for(key)
        let mut step = 0_usize
        while step < cap {
            let idx = (start + step) % cap
            match self.slots.get(idx) {
                Option::Some(slot) => {
                    if slot.state == state_empty() {
                        ret Option[u32]::None
                    }
                    if slot.state == state_occ() && slot.key == key {
                        ret Option[u32]::Some(slot.value)
                    }
                }
                Option::None => {
                    ret Option[u32]::None
                }
            }
            step = step + 1_usize
        }
        ret Option[u32]::None
    }

    pub fn contains_key(self: Dict, key: str) -> bool {
        ret self.get(key).is_some()
    }

    pub fn insert(self: Dict, key: str, value: u32) -> Dict {
        let cap = self.capacity()
        if cap == 0_usize {
            ret self
        }
        let start = self.index_for(key)
        let mut step = 0_usize
        let mut first_tomb = cap
        while step < cap {
            let idx = (start + step) % cap
            match self.slots.get(idx) {
                Option::Some(slot) => {
                    if slot.state == state_empty() {
                        let place = if first_tomb < cap { first_tomb } else { idx }
                        let next_slots = self.slots.set(place, make_occ(key, value))
                        ret Dict { next_slots, self.len + 1_usize }
                    }
                    if slot.state == state_tomb() && first_tomb == cap {
                        first_tomb = idx
                    }
                    if slot.state == state_occ() && slot.key == key {
                        let next_slots = self.slots.set(idx, make_occ(key, value))
                        ret Dict { next_slots, self.len }
                    }
                }
                Option::None => {
                    ret self
                }
            }
            step = step + 1_usize
        }
        if first_tomb < cap {
            let next_slots = self.slots.set(first_tomb, make_occ(key, value))
            ret Dict { next_slots, self.len + 1_usize }
        }
        ret self
    }

    pub fn remove(self: Dict, key: str) -> (Dict, Option[u32]) {
        let cap = self.capacity()
        if cap == 0_usize {
            ret (self, Option[u32]::None)
        }
        let start = self.index_for(key)
        let mut step = 0_usize
        while step < cap {
            let idx = (start + step) % cap
            match self.slots.get(idx) {
                Option::Some(slot) => {
                    if slot.state == state_empty() {
                        ret (self, Option[u32]::None)
                    }
                    if slot.state == state_occ() && slot.key == key {
                        let next_slots = self.slots.set(idx, make_tomb())
                        ret (Dict { next_slots, self.len - 1_usize }, Option[u32]::Some(slot.value))
                    }
                }
                Option::None => {
                    ret (self, Option[u32]::None)
                }
            }
            step = step + 1_usize
        }
        ret (self, Option[u32]::None)
    }
}

fn main() -> u32 {
    let mut dict = Dict::new()
    if !dict.is_empty() {
        println("is_empty() failed on new dict")
        ret 1_u32
    }
    dict = dict.insert("alpha", 1_u32)
    dict = dict.insert("beta", 2_u32)
    dict = dict.insert("gamma", 3_u32)
    dict = dict.insert("alpha", 10_u32)
    if dict.len() != 3_usize {
        println("len check failed")
        ret 1_u32
    }
    match dict.get("alpha") {
        Option::Some(v) => {
            if v != 10_u32 {
                println("get(alpha) mismatch")
                ret 1_u32
            }
        }
        Option::None => {
            println("get(alpha) none")
            ret 1_u32
        }
    }
    let removed = dict.remove("beta")
    dict = removed.0
    if dict.contains_key("beta") {
        println("remove(beta) failed")
        ret 1_u32
    }
    println("hashmap example: ok")
    ret 0_u32
}
