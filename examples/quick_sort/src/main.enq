import std::{
    vec::Vec,
    fmt::Debug,
    io::println,
    option::Option,
}

fn quick_sort(values: Vec[i32]) -> Vec[i32] {
    if values.len() < 2_usize {
        ret values
    }

    let mut pivot = 0_i32
    match values.get(values.len() - 1_usize) {
        Option[i32]::Some(v) => {
            pivot = v
        }
        Option[i32]::None => {}
    }

    let mut less = Vec[i32]::new()
    let mut equal = Vec[i32]::new()
    let mut greater = Vec[i32]::new()

    for item in values {
        if item < pivot {
            less = less.push(item)
        }
        else {
            if item > pivot {
                greater = greater.push(item)
            }
            else {
                equal = equal.push(item)
            }
        }
    }

    ret quick_sort(less).extend(equal).extend(quick_sort(greater))
}

fn main() -> u32 {
    let data = Vec[i32]::new()
        .push(9_i32)
        .push(4_i32)
        .push(7_i32)
        .push(3_i32)
        .push(10_i32)
        .push(5_i32)
        .push(2_i32)

    println("Before: " + Debug::fmt(data))
    let sorted = quick_sort(data)
    println("After : " + Debug::fmt(sorted))
    ret 0_u32
}
