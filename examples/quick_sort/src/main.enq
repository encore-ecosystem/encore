import std::{
    vec::Vec,
    fmt::Debug,
    io::println,
    option::Option,
}

fn fmt_vec_i32(values: Vec[i32]) -> str {
    let mut out = "["
    let mut i = 0_usize
    while i < values.len() {
        if i > 0_usize {
            out = out + ", "
        }
        match values.get(i) {
            Option::Some(v) => {
                out = out + Debug::fmt(v)
            }
            Option::None => {}
        }
        i = i + 1_usize
    }
    ret out + "]"
}

fn quick_sort(values: Vec[i32]) -> Vec[i32] {
    if values.len() < 2_usize {
        ret values
    }

    let mut pivot = 0_i32
    match values.get(values.len() - 1_usize) {
        Option[i32]::Some(v) => {
            pivot = v
        }
        Option[i32]::None => {}
    }

    let mut less = Vec[i32]::new()
    let mut equal = Vec[i32]::new()
    let mut greater = Vec[i32]::new()

    for item in values {
        if item < pivot {
            less.push(item)
        }
        else {
            if item > pivot {
                greater.push(item)
            }
            else {
                equal.push(item)
            }
        }
    }

    let mut out = quick_sort(less)
    out.extend(equal)
    out.extend(quick_sort(greater))
    ret out
}

fn main() -> u32 {
    let mut data = Vec[i32]::new()
    data.push(9_i32)
    data.push(4_i32)
    data.push(7_i32)
    data.push(3_i32)
    data.push(10_i32)
    data.push(5_i32)
    data.push(2_i32)

    println("Before: " + fmt_vec_i32(data))
    let sorted = quick_sort(data)
    println("After : " + fmt_vec_i32(sorted))
    ret 0_u32
}
