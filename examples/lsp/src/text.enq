import core::option::Option

pub fn line_text_at(text: str, target_line: usize) -> Option[str] {
    let mut line = 0_usize
    let mut start = 0_usize
    let mut index = 0_usize
    while index < text.len() {
        match text.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    if line == target_line {
                        ret Option[str]::Some(text.slice(start, index - start))
                    }
                    line += 1_usize
                    start = index + 1_usize
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    if line == target_line {
        ret Option[str]::Some(text.slice(start, text.len() - start))
    }
    ret Option[str]::None
}

pub fn find_in_line_at_or_after(line: str, needle: str, start: usize) -> usize {
    if needle.len() == 0_usize {
        ret start
    }
    if needle.len() > line.len() {
        ret start
    }
    let mut index = start
    while index + needle.len() <= line.len() {
        if starts_at(line, needle, index) {
            ret index
        }
        index += 1_usize
    }
    ret start
}

pub fn contains_substring(value: str, needle: str) -> bool {
    if needle.len() == 0_usize {
        ret true
    }
    if needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index + needle.len() <= value.len() {
        if starts_at(value, needle, index) {
            ret true
        }
        index += 1_usize
    }
    ret false
}

pub fn document_last_line(text: str) -> usize {
    let mut line = 0_usize
    let mut index = 0_usize
    while index < text.len() {
        match text.get(index) {
            Option[str]::Some(ch) => {
                if ch == "\n" {
                    line += 1_usize
                }
            }
            Option[str]::None => {}
        }
        index += 1_usize
    }
    ret line
}

pub fn trim_trailing_index(text: str) -> usize {
    let mut end = text.len()
    while end > 0_usize {
        match text.get_byte_at(end - 1_usize) {
            Option[u8]::Some(byte) => {
                if byte == 32_u8 || byte == 9_u8 {
                    end -= 1_usize
                }
                else {
                    ret end
                }
            }
            Option[u8]::None => {
                ret end
            }
        }
    }
    ret end
}

pub fn parse_usize(value_text: str) -> usize {
    let mut value = 0_usize
    let mut index = 0_usize
    while index < value_text.len() {
        match value_text.get_byte_at(index) {
            Option[u8]::Some(byte) => {
                if byte >= 48_u8 && byte <= 57_u8 {
                    value = value * 10_usize + ((byte - 48_u8) as usize)
                }
                else {
                    ret value
                }
            }
            Option[u8]::None => {
                ret value
            }
        }
        index += 1_usize
    }
    ret value
}

pub fn min_usize(left: usize, right: usize) -> usize {
    if left < right {
        ret left
    }
    ret right
}

pub fn is_identifier_name(value: str) -> bool {
    if value.len() == 0_usize {
        ret false
    }
    match value.get_byte_at(0_usize) {
        Option[u8]::Some(first) => {
            if !is_identifier_start_byte(first) {
                ret false
            }
        }
        Option[u8]::None => {
            ret false
        }
    }

    let mut index = 1_usize
    while index < value.len() {
        match value.get_byte_at(index) {
            Option[u8]::Some(byte) => {
                if !is_identifier_continue_byte(byte) {
                    ret false
                }
            }
            Option[u8]::None => {
                ret false
            }
        }
        index += 1_usize
    }
    ret true
}

fn is_identifier_start_byte(byte: u8) -> bool {
    if byte >= 65_u8 && byte <= 90_u8 {
        ret true
    }
    if byte >= 97_u8 && byte <= 122_u8 {
        ret true
    }
    ret byte == 95_u8
}

fn is_identifier_continue_byte(byte: u8) -> bool {
    if is_identifier_start_byte(byte) {
        ret true
    }
    ret byte >= 48_u8 && byte <= 57_u8
}

fn starts_at(value: str, needle: str, offset: usize) -> bool {
    if offset + needle.len() > value.len() {
        ret false
    }
    let mut index = 0_usize
    while index < needle.len() {
        if value.get(offset + index).unwrap_or("") != needle.get(index).unwrap_or("") {
            ret false
        }
        index += 1_usize
    }
    ret true
}
