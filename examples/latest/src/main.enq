import std::{
    io::println,
    fmt::Debug,
    ops::{Add, Sub, Mul, Div},
    vec::Vec,
}

impl[T] Add[T] for Vec[T] {
    fn op(self: Self, other: T) -> Self {
        ret self.push(other)
    }
}

fn main() -> u32 {
    let mut my_vec = Vec[u32]::new()
    println("default for u32: " + Debug::fmt(my_vec + 0_u32))
    ret 0
}
