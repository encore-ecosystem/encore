import std::os::argv
import std::io::print
import std::io::println
import core::option::Option
import std::string::String
import refrain::modes
import rich::Console

fn main() -> u32 {
    let console = Console::new()

    let mut mode = ""
    match argv(1_usize) {
        Option::Some(m) => {
            mode = m
        }
        Option::None => {
            console.error("Please, provide mode!")
            ret 1
        }
    }

    match mode {
        "run" => {
            ret modes::run_run()
        }
        "build" => {
            ret modes::run_build()
        }
        "add" => {
            ret modes::run_add()
        }
        "sync" => {
            ret modes::run_sync()
        }
        "update" => {
            ret modes::run_update()
        }
        "test" => {
            ret modes::run_test()
        }
        "init" => {
            ret modes::run_init()
        }
        "install" => {
            ret modes::run_install()
        }
        _ => {
            console.error("Unknown mode: " + mode)
        }
    }
    ret 1
}
