import core::testing::*
import core::vec::Vec

struct Bag {
    values: Vec[u32]
}

impl for Bag {
    pub fn new() -> Self {
        let values = Vec[u32]::new()
        ret Self { values }
    }

    pub fn push(self: mut Self, value: u32) -> () {
        self.values.push(value)
        ret ()
    }

    pub fn len(self: Self) -> usize {
        ret self.values.len()
    }
}

fn main() -> u32 {
    let mut first = Bag::new()
    let mut second = first

    second.push(10_u32)
    second.push(20_u32)

    if !assert(first.len() == 2_usize) {
        ret 1_u32
    }
    if !assert(second.len() == 2_usize) {
        ret 1_u32
    }

    ret 0_u32
}
