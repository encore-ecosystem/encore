import core::testing::*

enum Neighborhood {
    Mure(u32)
    Neumann(u32)
}

fn scan(nb: Neighborhood) -> u32 {
    let mut count = 0_u32
    match nb {
        Neighborhood::Mure(radius) => {
            let r = radius as i32
            let mut dx = -r
            while dx < r {
                let mut dy = -r
                while dy < r {
                    count += 1_u32
                    dy += 1
                }
                dx += 1
            }
        }
        Neighborhood::Neumann(radius) => {
            let r = radius as i32
            if r == 0_i32 {
                count += 100_u32
            }
        }
    }
    ret count
}

fn main() -> u32 {
    let mure_count = scan(Neighborhood::Mure(1_u32))
    if !assert(mure_count == 4_u32) {
        ret 1_u32
    }

    let neumann_count = scan(Neighborhood::Neumann(0_u32))
    if !assert(neumann_count == 100_u32) {
        ret 1_u32
    }

    ret 0_u32
}
