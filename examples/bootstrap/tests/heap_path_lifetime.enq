import core::testing::*
import std::path::Path

fn check_path(value: str, expected: str) -> bool {
    let path = Path::new(value)
    ret path.as_str() == expected
}

fn check_normalize(value: str, expected: str) -> bool {
    let path = Path::new(value).normalize()
    ret path.as_str() == expected
}

fn main() -> u32 {
    if !assert(check_path("alpha/beta/gamma", "alpha/beta/gamma")) {
        ret 1_u32
    }
    if !assert(check_path("/tmp/example.txt", "/tmp/example.txt")) {
        ret 1_u32
    }
    if !assert(check_normalize("alpha/./beta/../gamma", "alpha/gamma")) {
        ret 1_u32
    }
    ret 0_u32
}
