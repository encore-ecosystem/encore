import core::testing::*
import core::ops::Pow

struct Meter {
    value: u32
}

impl Pow[u32] for Meter {
    fn op(self: Meter, other: u32) -> Meter {
        ret Meter { self.value ** other }
    }
}

fn power_generic[T: Pow[T]](base: T, exp: T) -> T {
    ret base ** exp
}

fn main() -> u32 {
    let plain = 2_u32 ** 3_u32
    let precedence = 2_u32 * 3_u32 ** 2_u32
    let right_assoc = 2_u32 ** 3_u32 ** 2_u32
    let generic = power_generic(2_u32, 4_u32)
    let custom = (Meter { 3_u32 } ** 2_u32).value
    let mut assigned = 3_u32
    assigned **= 3_u32

    if !assert(plain == 8_u32) {
        ret 1_u32
    }
    if !assert(precedence == 18_u32) {
        ret 1_u32
    }
    if !assert(right_assoc == 512_u32) {
        ret 1_u32
    }
    if !assert(generic == 16_u32) {
        ret 1_u32
    }
    if !assert(custom == 9_u32) {
        ret 1_u32
    }
    if !assert(assigned == 27_u32) {
        ret 1_u32
    }
    ret 0_u32
}
