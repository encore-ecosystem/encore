import std::fmt::Debug
import std::io::println
import std::option::Option
import std::vec::Vec

fn fmt_vec_i32(values: Vec[i32]) -> str {
    let mut out = "["
    let mut i = 0_usize
    while i < values.len() {
        if i > 0_usize {
            out = out + ", "
        }
        match values.get(i) {
            Option::Some(v) => {
                out = out + Debug::fmt(v)
            }
            Option::None => {}
        }
        i = i + 1_usize
    }
    ret out + "]"
}

fn bubble_sort(values: mut Vec[i32]) -> () {
    let n = values.len()
    if n < 2_usize {
        ret ()
    }

    let mut i = 0_usize
    while i < n {
        let mut j = 0_usize
        while j + 1_usize < n - i {
            let mut a = 0_i32
            match values.get(j) {
                Option::Some(v) => {
                    a = v
                }
                Option::None => {}
            }
            let mut b = 0_i32
            match values.get(j + 1_usize) {
                Option::Some(v) => {
                    b = v
                }
                Option::None => {}
            }

            if a > b {
                values.set(j, b)
                values.set(j + 1_usize, a)
            }
            j = j + 1_usize
        }
        i = i + 1_usize
    }
    ret ()
}

fn main() -> u32 {
    let mut data = Vec[i32]::new()
    data.push(8_i32)
    data.push(1_i32)
    data.push(6_i32)
    data.push(2_i32)
    data.push(9_i32)
    data.push(4_i32)

    println("Before: " + fmt_vec_i32(data))
    bubble_sort(data)
    println("After : " + fmt_vec_i32(data))
    ret 0_u32
}
