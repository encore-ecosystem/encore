import core::io::print
import core::io::println
import core::os::argv
import core::option::Option

fn main() -> u32 {
    let mut index = 1_usize
    let mut first = true

    loop {
        match argv(index) {
            Option[str]::Some(value) => {
                if !first {
                    print(" ")
                }
                print(value)
                first = false
                index = index + 1_usize
            }
            Option[str]::None => {
                break
            }
        }
    }

    println("")
    ret 0_u32
}
