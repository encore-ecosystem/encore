enum Option[T] {
    Some(T)
    None
}

struct Player {
    health: u16
    opponent: Option[Player<H>]
}

fn main() -> u16 {
    let p1 = Player<H>{10, Option[Player<H>]::None}
    let p2 = Player<H>{15, Option[Player<H>]::Some(p1)}
    p1.opponent = Option[Player<H>]::Some(p2)
    ret p1.health + p2.health
}
