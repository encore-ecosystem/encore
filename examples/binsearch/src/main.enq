import std::fmt::Debug
import std::io::{eprintln, println}
import std::option::Option
import std::vec::Vec

fn main() -> u32 {
    let mut data = Vec[usize]::new()
    for i in 0..100 {
        data.push(2 * i)
    }

    let target = 16_usize
    let mut l = 0_usize
    let mut r = data.len()
    while l < r {
        let m = (l + r) / 2
        match data.get(m) {
            Option[usize]::Some(v) => {
                if v < target {
                    l = m + 1_usize
                }
                else {
                    if v > target {
                        r = m
                    }
                    else {
                        println("Index is: " + Debug::fmt(m))
                        ret 0_u32
                    }
                }
            }
            Option[usize]::None => {
                eprintln("Unexpected None from Vec::get")
                ret 1_u32
            }
        }
    }

    eprintln("Target is not found")
    ret 1_u32
}
