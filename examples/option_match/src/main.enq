enum Maybe[T] {
    Some(T)
    None
}

fn increment(opt: Maybe[u32]) -> Maybe[u32] {
    match opt {
        Some(value) => {
            ret Maybe[u32]::Some(value + 1_u32)
        }
        None => {
            ret Maybe[u32]::None
        }
    }
}

fn unwrap_or_zero(opt: Maybe[u32]) -> u32 {
    match opt {
        Some(value) => {
            ret value
        }
        None => {
            ret 0_u32
        }
    }
}

fn main() -> u32 {
    let some = Maybe[u32]::Some(41_u32)
    let none = Maybe[u32]::None

    let lhs = unwrap_or_zero(increment(some))
    let rhs = unwrap_or_zero(increment(none))

    ret lhs + rhs
}
